<?xml version="1.0" encoding="utf-8"?>
<!-- IIS physical path MUST be this www directory, never server or private. -->
<configuration>
  <system.webServer>
    <!-- Preserve Flask JSON errors (401/403/409); never replace with IIS HTML. -->
    <httpErrors existingResponse="PassThrough"/>
    <defaultDocument><files><clear/><add value="login.html"/></files></defaultDocument>
    <directoryBrowse enabled="false"/>
    <security><requestFiltering>
      <requestLimits maxAllowedContentLength="33554432"/>
      <!-- Defence in depth: private files must sit outside www, and IIS also
           refuses them if a future deployment puts one here by mistake. -->
      <fileExtensions allowUnlisted="true">
        <add fileExtension=".py" allowed="false"/><add fileExtension=".pyc" allowed="false"/>
        <add fileExtension=".ps1" allowed="false"/><add fileExtension=".psm1" allowed="false"/>
        <add fileExtension=".env" allowed="false"/><add fileExtension=".ini" allowed="false"/>
        <add fileExtension=".sqlite" allowed="false"/><add fileExtension=".sqlite3" allowed="false"/><add fileExtension=".db" allowed="false"/>
        <add fileExtension=".xls" allowed="false"/><add fileExtension=".xlsx" allowed="false"/><add fileExtension=".xlsm" allowed="false"/>
        <add fileExtension=".bak" allowed="false"/><add fileExtension=".log" allowed="false"/>
        <add fileExtension=".zip" allowed="false"/><add fileExtension=".7z" allowed="false"/>
      </fileExtensions>
      <hiddenSegments><add segment="private_ui"/><add segment="windows"/><add segment="__pycache__"/></hiddenSegments>
    </requestFiltering></security>
    <!-- Every page load must revalidate FAM content. This prevents workstation
         caches from retaining an authenticated screen or stale client shell. -->
    <staticContent><clientCache cacheControlMode="DisableCache"/></staticContent>
    <httpProtocol><customHeaders>
      <remove name="X-Powered-By"/>
      <remove name="Cache-Control"/><remove name="Pragma"/><remove name="Expires"/>
      <add name="Cache-Control" value="no-store, no-cache, must-revalidate, max-age=0"/>
      <add name="Pragma" value="no-cache"/><add name="Expires" value="0"/>
      <add name="X-Content-Type-Options" value="nosniff"/><add name="Referrer-Policy" value="same-origin"/>
      <add name="X-Frame-Options" value="SAMEORIGIN"/>
      <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'"/>
      <add name="Strict-Transport-Security" value="max-age=31536000"/>
    </customHeaders></httpProtocol>
    <rewrite><rules>
      <rule name="HTTPS only" stopProcessing="true">
        <match url="(.*)"/><conditions><add input="{HTTPS}" pattern="off" ignoreCase="true"/></conditions>
        <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent"/>
      </rule>
      <!-- Full application UI lives outside IIS www and is served only after
           Flask verifies the HttpOnly FAM session. -->
      <rule name="Protected FAM application to loopback service" stopProcessing="true">
        <match url="^(?:app|FAM\.html)$"/>
        <action type="Rewrite" url="http://127.0.0.1:8765/{R:0}" appendQueryString="true"/>
      </rule>
      <!-- The Network Operations page is served by Flask, not as an IIS static
           file. Its data calls remain behind the normal FAM session/CSRF guard. -->
      <rule name="Network Operations control page to loopback service" stopProcessing="true">
        <match url="^network-operations$"/>
        <action type="Rewrite" url="http://127.0.0.1:8765/network-operations" appendQueryString="true"/>
      </rule>
      <rule name="FAM API to loopback service" stopProcessing="true">
        <match url="^api/(.*)$"/>
        <action type="Rewrite" url="http://127.0.0.1:8765/api/{R:1}" appendQueryString="true"/>
      </rule>
    </rules></rewrite>
  </system.webServer>
</configuration>
