<?xml version="1.0" encoding="utf-8"?>
<!-- IIS physical path MUST be this www directory, never server or private. -->
<configuration>
  <system.webServer>
    <!-- Preserve Flask JSON errors (401/403/409); never replace with IIS HTML. -->
    <httpErrors existingResponse="PassThrough"/>
    <defaultDocument><files><clear/><add value="FAM.html"/></files></defaultDocument>
    <directoryBrowse enabled="false"/>
    <security><requestFiltering><requestLimits maxAllowedContentLength="33554432"/></requestFiltering></security>
    <staticContent><clientCache cacheControlMode="DisableCache"/></staticContent>
    <httpProtocol><customHeaders>
      <remove name="X-Powered-By"/>
      <add name="X-Content-Type-Options" value="nosniff"/>
      <add name="Referrer-Policy" value="same-origin"/>
      <add name="X-Frame-Options" value="SAMEORIGIN"/>
      <add name="Content-Security-Policy" value="frame-ancestors 'self'; object-src 'none'; base-uri 'self'"/>
      <add name="Strict-Transport-Security" value="max-age=86400"/>
    </customHeaders></httpProtocol>
    <rewrite><rules>
      <rule name="HTTPS only" stopProcessing="true">
        <match url="(.*)"/>
        <conditions><add input="{HTTPS}" pattern="off" ignoreCase="true"/></conditions>
        <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent"/>
      </rule>
      <rule name="FAM API to loopback service" stopProcessing="true">
        <match url="^api/(.*)$"/>
        <action type="Rewrite" url="http://127.0.0.1:8765/api/{R:1}" appendQueryString="true"/>
      </rule>
    </rules></rewrite>
  </system.webServer>
</configuration>
