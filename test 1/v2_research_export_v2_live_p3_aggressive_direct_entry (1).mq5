//========================================================
//  RESEARCH FRAMEWORK — Phase 1
//  Constants, Enums, Structs, Metadata, GetFeatureValue
//========================================================
// ==================== RESEARCH CONSTANTS ====================
#define RSCH_MIN_GROUP_SHOW         15
#define RSCH_MIN_SAMPLE_STRONG      30
#define RSCH_MIN_SAMPLE_MODERATE    20
#define RSCH_WEIGHT_EFFECT          0.35
#define RSCH_WEIGHT_TRADEOFF        0.35
#define RSCH_WEIGHT_STABILITY       0.15
#define RSCH_WEIGHT_COVERAGE        0.15
#define RSCH_MIN_COVERAGE_STRONG    35.0
#define RSCH_MIN_COVERAGE_MODERATE  30.0
#define RSCH_MIN_TRADEOFF_STRONG    15.0
#define RSCH_MIN_TRADEOFF_MODERATE   8.0
#define RSCH_TRADEOFF_W_STOP        1.0
#define RSCH_TRADEOFF_W_STEP4PLUS   1.5
#define RSCH_TRADEOFF_W_STEP3       0.5
#define RSCH_MAX_THRESHOLD_TESTS    20
#define RSCH_MIN_COVERAGE_FILTER    30.0
#define RSCH_COMBO_TOP_N            5
#define RSCH_COMBO_MIN_COVERAGE     20.0
#define RSCH_COMBO_MIN_STOP_REMOVED 10.0
#define RSCH_COMBO_SCORE_TRIGGER    20.0
#define RSCH_MAX_FINAL_RESULTS      200
#define RSCH_MAX_COMBO_RESULTS      30
#define RSCH_MAX_PAIRWISE           10
#define RSCH_MAX_PAIR_RESULTS       1000
// ==================== RESEARCH GROUP ENUM ====================
enum ENUM_RSCH_GROUP
{
   RSCH_G_STEP5 = 0,
   RSCH_G_STOP,
   RSCH_G_MAXSTEP2,
   RSCH_G_MAXSTEP3,
   RSCH_G_MAXSTEP4,
   RSCH_G_STEP4PLUS,
   RSCH_G_DEEP_STOP,
   RSCH_G_DEEP_TARGET,
   RSCH_G_SAFE_TARGET,
   RSCH_G_MAXSTEP1,
   RSCH_G_COUNT
};
string RschGroupName(ENUM_RSCH_GROUP g)
{
   switch(g)
   {
      case RSCH_G_STEP5:       return "STEP5";
      case RSCH_G_STOP:        return "STOP";
      case RSCH_G_MAXSTEP2:    return "MAXSTEP2";
      case RSCH_G_MAXSTEP3:    return "MAXSTEP3";
      case RSCH_G_MAXSTEP4:    return "MAXSTEP4";
      case RSCH_G_STEP4PLUS:   return "STEP4PLUS";
      case RSCH_G_DEEP_STOP:   return "DEEP_STOP";
      case RSCH_G_DEEP_TARGET: return "DEEP_TARGET";
      case RSCH_G_SAFE_TARGET: return "SAFE_TARGET";
      case RSCH_G_MAXSTEP1:    return "MAXSTEP1";
   }
   return "UNKNOWN";
}
enum ENUM_RSCH_FEATURE
{
   // per-TF entry features
   RSCH_F_RSI = 0,
   RSCH_F_ADX,
   RSCH_F_CCI,
   RSCH_F_ATR,
   RSCH_F_ATR_REGIME,
   RSCH_F_ADX_SLOPE,
   RSCH_F_EMA_COMPRESSION,
   RSCH_F_EMA200_DIST,
   RSCH_F_DI_GAP,
   // global entry features
   RSCH_F_STABILITY,
   RSCH_F_DI_AGREEMENT,
   RSCH_F_EMA_BULLISH_COUNT,
   RSCH_F_PIVOT1_DIST,
   RSCH_F_PIVOT2_DIST,
   RSCH_F_PIVOT_GAP_MIN,
   RSCH_F_PIVOT_GAP_MAX,
   RSCH_F_OB_DIST_PCT,
   RSCH_F_OB_AGE_BARS,
   RSCH_F_OB_WIDTH_ATR,
   RSCH_F_SIGNAL_CLV,
   RSCH_F_SIGNAL_BODY_RATIO,
   // Divergence Quality Features (NEW)
   RSCH_F_PRICE_DIV_STRENGTH,
   RSCH_F_RSI_DIV_STRENGTH,
   RSCH_F_DIV_PRICE_SLOPE,
   RSCH_F_DIV_RSI_SLOPE,
   RSCH_F_DIV_SPAN_BARS,
   RSCH_F_PIVOT_SYMMETRY,
   RSCH_F_TIME_SINCE_P3,
   RSCH_F_PIVOT_RSI_P1,
   RSCH_F_PIVOT_RSI_P2,
   RSCH_F_PIVOT_RSI_P3,
   RSCH_F_PRICE_LEG_RATIO,
   RSCH_F_RSI_ACCELERATION,
   RSCH_F_DIVERGENCE_ANGLE,
   // outcome-only (not for ranking / tradeoff)
   RSCH_F_MFE_MONEY,
   RSCH_F_MAE_MONEY,
   RSCH_F_MAXDD_MONEY,
   RSCH_F_PROFIT,
   RSCH_F_COUNT   // ← این خودکار آپدیت می‌شود
};
// ==================== FEATURE METADATA ====================
struct SRschFeatureMeta
{
   ENUM_RSCH_FEATURE feature;
   string            name;
   bool              per_tf;
   bool              entry_feature;
};
void RschInitFeatureMeta(SRschFeatureMeta &meta[])
{
   ArrayResize(meta, RSCH_F_COUNT);
   for(int i = 0; i < RSCH_F_COUNT; i++)
   {
      meta[i].feature       = (ENUM_RSCH_FEATURE)i;
      meta[i].name          = "";
      meta[i].per_tf        = false;
      meta[i].entry_feature = true;
   }
   // per-TF entry features
   meta[RSCH_F_RSI].name             = "RSI";             meta[RSCH_F_RSI].per_tf = true;
   meta[RSCH_F_ADX].name             = "ADX";             meta[RSCH_F_ADX].per_tf = true;
   meta[RSCH_F_CCI].name             = "CCI";             meta[RSCH_F_CCI].per_tf = true;
   meta[RSCH_F_ATR].name             = "ATR";             meta[RSCH_F_ATR].per_tf = true;
   meta[RSCH_F_ATR_REGIME].name      = "ATR_Regime";      meta[RSCH_F_ATR_REGIME].per_tf = true;
   meta[RSCH_F_ADX_SLOPE].name       = "ADX_Slope";       meta[RSCH_F_ADX_SLOPE].per_tf = true;
   meta[RSCH_F_EMA_COMPRESSION].name = "EMA_Compression"; meta[RSCH_F_EMA_COMPRESSION].per_tf = true;
   meta[RSCH_F_EMA200_DIST].name     = "EMA200_Dist";     meta[RSCH_F_EMA200_DIST].per_tf = true;
   meta[RSCH_F_DI_GAP].name          = "DI_Gap";          meta[RSCH_F_DI_GAP].per_tf = true;
   // global entry features
   meta[RSCH_F_STABILITY].name         = "Stability";
   meta[RSCH_F_DI_AGREEMENT].name      = "DI_Agreement";
   meta[RSCH_F_EMA_BULLISH_COUNT].name = "EMA_Bullish_Count";
   meta[RSCH_F_PIVOT1_DIST].name       = "Pivot1Dist";
   meta[RSCH_F_PIVOT2_DIST].name       = "Pivot2Dist";
   meta[RSCH_F_PIVOT_GAP_MIN].name     = "PivotGapMin";
   meta[RSCH_F_PIVOT_GAP_MAX].name     = "PivotGapMax";
   meta[RSCH_F_OB_DIST_PCT].name       = "OB_DistPct";
   meta[RSCH_F_OB_AGE_BARS].name       = "OB_AgeBars";
   meta[RSCH_F_OB_WIDTH_ATR].name      = "OB_Width_ATR";
   meta[RSCH_F_SIGNAL_CLV].name        = "Signal_CLV";
   meta[RSCH_F_SIGNAL_BODY_RATIO].name = "Signal_BodyRatio";
   // Divergence Quality Features (NEW) — global, entry features
   meta[RSCH_F_PRICE_DIV_STRENGTH].name  = "Price_Div_Strength";
   meta[RSCH_F_RSI_DIV_STRENGTH].name    = "RSI_Div_Strength";
   meta[RSCH_F_DIV_PRICE_SLOPE].name     = "Div_Price_Slope";
   meta[RSCH_F_DIV_RSI_SLOPE].name       = "Div_RSI_Slope";
   meta[RSCH_F_DIV_SPAN_BARS].name       = "Div_Span_Bars";
   meta[RSCH_F_PIVOT_SYMMETRY].name      = "Pivot_Symmetry";
   meta[RSCH_F_TIME_SINCE_P3].name       = "Time_Since_P3";
   meta[RSCH_F_PIVOT_RSI_P1].name        = "Pivot_RSI_P1";
   meta[RSCH_F_PIVOT_RSI_P2].name        = "Pivot_RSI_P2";
   meta[RSCH_F_PIVOT_RSI_P3].name        = "Pivot_RSI_P3";
   meta[RSCH_F_PRICE_LEG_RATIO].name     = "Price_Leg_Ratio";
   meta[RSCH_F_RSI_ACCELERATION].name    = "RSI_Acceleration";
   meta[RSCH_F_DIVERGENCE_ANGLE].name = "Divergence_Angle";
   // outcome-only
   meta[RSCH_F_MFE_MONEY].name    = "MFE_Money";    meta[RSCH_F_MFE_MONEY].entry_feature    = false;
   meta[RSCH_F_MAE_MONEY].name    = "MAE_Money";    meta[RSCH_F_MAE_MONEY].entry_feature    = false;
   meta[RSCH_F_MAXDD_MONEY].name  = "MaxDD_Money";  meta[RSCH_F_MAXDD_MONEY].entry_feature  = false;
   meta[RSCH_F_PROFIT].name       = "Profit";       meta[RSCH_F_PROFIT].entry_feature       = false;
}
struct SRschGroupBucket
{
   ENUM_RSCH_GROUP group_id;
   int    indices[];
   int    n;
   // outcome summaries (pre-calculated for Group Profile)
   int    win_count;
   double sum_profit;
   double sum_mfe;
   double sum_mae;
   double sum_maxdd;
   void Reset()
   {
      group_id = RSCH_G_STEP5;
      ArrayFree(indices);
      n = 0;
      win_count = 0;
      sum_profit = 0.0;
      sum_mfe = 0.0;
      sum_mae = 0.0;
      sum_maxdd = 0.0;
   }
};
//--- Descriptive stats for one feature in one group
struct SRschFeatureStat
{
   int    n;
   double mean;
   double median;
   double std;
   double q25;
   double q75;
   double min_val;
   double max_val;
   void Reset()
   {
      n = 0;
      mean = median = std = q25 = q75 = 0.0;
      min_val = 0.0;
      max_val = 0.0;
   }
};
//--- Pairwise comparison result
struct SRschPairwiseResult
{
   ENUM_RSCH_FEATURE feature;
   int               tf_index;       // -1 for global
   ENUM_RSCH_GROUP   group_a;
   ENUM_RSCH_GROUP   group_b;
   SRschFeatureStat  stat_a;
   SRschFeatureStat  stat_b;
   double            mean_diff;
   double            median_diff;
   double            cohens_d;
   double            cliffs_delta;
   bool              cliffs_computed;
   string            effect_label;   // Large / Medium / Small / Negligible
   string            direction_text; // "lower RSI → better outcome"
   void Reset()
   {
      feature = RSCH_F_RSI;
      tf_index = -1;
      group_a = RSCH_G_STEP5;
      group_b = RSCH_G_STOP;
      stat_a.Reset();
      stat_b.Reset();
      mean_diff = median_diff = cohens_d = cliffs_delta = 0.0;
      cliffs_computed = false;
      effect_label = "Negligible";
      direction_text = "";
   }
};
//--- Threshold trade-off result
struct SRschTradeoffResult
{
   double threshold;
   bool   less_equal;   // true = feature <= T passes
   double stop_removed_pct;
   double step4plus_lost_pct;
   double step5_lost_pct;
   double step3_lost_pct;
   double coverage_pct;
   int    occurrence;
   double score;
   bool   valid;
   void Reset()
   {
      threshold = 0.0;
      less_equal = true;
      stop_removed_pct = step4plus_lost_pct = step5_lost_pct = step3_lost_pct = 0.0;
      coverage_pct = 0.0;
      occurrence = 0;
      score = -999999.0;
      valid = false;
   }
};
//--- Combo result (2 or 3 features combined)
struct SRschComboResult
{
   int               feature_count;       // 2 or 3
   ENUM_RSCH_FEATURE features[3];
   int               tf_indices[3];
   double            thresholds[3];
   bool              less_equal[3];
   double            stop_removed_pct;
   double            step4plus_lost_pct;
   double            step5_lost_pct;
   double            step3_lost_pct;
   double            coverage_pct;
   int               occurrence;
   double            combo_score;
   bool              valid;
   void Reset()
   {
      feature_count = 0;
      for(int i = 0; i < 3; i++)
      {
         features[i] = RSCH_F_RSI;
         tf_indices[i] = -1;
         thresholds[i] = 0.0;
         less_equal[i] = true;
      }
      stop_removed_pct = step4plus_lost_pct = step5_lost_pct = step3_lost_pct = 0.0;
      coverage_pct = 0.0;
      occurrence = 0;
      combo_score = -999999.0;
      valid = false;
   }
};
//--- Final result for one feature (for ranking)
struct SRschFinalResult
{
   ENUM_RSCH_FEATURE feature;
   int               tf_index;
   string            feature_full_name;  // e.g. "RSI_H1"
   // best pairwise comparison
   ENUM_RSCH_GROUP   best_pair_a;
   ENUM_RSCH_GROUP   best_pair_b;
   double            best_cohens_d;
   double            best_cliffs_delta;
   bool              cliffs_computed;
   string            effect_label;
   string            direction_text;
   // stats from best comparison
   SRschFeatureStat  stat_positive;  // STEP4PLUS or STEP5
   SRschFeatureStat  stat_negative;  // STOP
   // best tradeoff
   SRschTradeoffResult tradeoff;
   // Research Score components
   double            effect_score;
   double            tradeoff_score_norm;
   double            stability_score;
   double            coverage_score;
   double            research_score;
   // output labels
   string            reliability;
   string            verdict;
   string            conclusion;
   void Reset()
   {
      feature = RSCH_F_RSI;
      tf_index = -1;
      feature_full_name = "";
      best_pair_a = RSCH_G_STEP4PLUS;
      best_pair_b = RSCH_G_STOP;
      best_cohens_d = 0.0;
      best_cliffs_delta = 0.0;
      cliffs_computed = false;
      effect_label = "Negligible";
      direction_text = "";
      stat_positive.Reset();
      stat_negative.Reset();
      tradeoff.Reset();
      effect_score = tradeoff_score_norm = stability_score = coverage_score = 0.0;
      research_score = 0.0;
      reliability = "Unknown";
      verdict = "NOISE";
      conclusion = "";
   }
};
//========================================================
// RESEARCH OOS VALIDATION — Phase 5
//========================================================
struct SOOSGroupStats
{
   int    n;
   int    n_stop;
   int    n_step4plus;
   int    n_step5;
   int    n_safe;
   double stop_rate;
   double step4plus_rate;
   double step5_rate;
   double mean_feature;
   double median_feature;
   double std_feature;
   void Reset()
   {
      n = n_stop = n_step4plus = n_step5 = n_safe = 0;
      stop_rate = step4plus_rate = step5_rate = 0.0;
      mean_feature = median_feature = std_feature = 0.0;
   }
   void Finalize()
   {
      if(n <= 0) return;
      stop_rate      = (double)n_stop      * 100.0 / n;
      step4plus_rate = (double)n_step4plus * 100.0 / n;
      step5_rate     = (double)n_step5     * 100.0 / n;
   }
};
struct SOOSRuleResult
{
   string  feature_name;
   int     tf_index;
   string  tf_name;
   double  threshold;
   bool    reject_above;           // true = reject if feature > threshold
   // DEV results
   int     dev_total;
   int     dev_accepted;
   int     dev_rejected;
   double  dev_coverage;
   int     dev_stop_total;
   int     dev_stop_removed;
   double  dev_stop_removed_pct;
   int     dev_step4plus_total;
   int     dev_step4plus_lost;
   double  dev_step4plus_lost_pct;
   int     dev_step5_total;
   int     dev_step5_lost;
   double  dev_step5_lost_pct;
   double  dev_tradeoff_score;
   double  dev_cohens_d;
   // OOS results (same threshold, no re-optimization)
   int     oos_total;
   int     oos_accepted;
   int     oos_rejected;
   double  oos_coverage;
   int     oos_stop_total;
   int     oos_stop_removed;
   double  oos_stop_removed_pct;
   int     oos_step4plus_total;
   int     oos_step4plus_lost;
   double  oos_step4plus_lost_pct;
   int     oos_step5_total;
   int     oos_step5_lost;
   double  oos_step5_lost_pct;
   double  oos_tradeoff_score;
   double  oos_cohens_d;
   // Stability assessment
   string  stability_label;        // STABLE / MILD_DEGRADATION / UNSTABLE
   double  degradation_stop;       // dev_stop_removed - oos_stop_removed
   double  degradation_tradeoff;
   void Reset()
   {
      feature_name = "";
      tf_index = -1;
      tf_name = "";
      threshold = 0.0;
      reject_above = true;
      dev_total = dev_accepted = dev_rejected = 0;
      dev_coverage = 0.0;
      dev_stop_total = dev_stop_removed = 0;
      dev_stop_removed_pct = 0.0;
      dev_step4plus_total = dev_step4plus_lost = 0;
      dev_step4plus_lost_pct = 0.0;
      dev_step5_total = dev_step5_lost = 0;
      dev_step5_lost_pct = 0.0;
      dev_tradeoff_score = 0.0;
      dev_cohens_d = 0.0;
      oos_total = oos_accepted = oos_rejected = 0;
      oos_coverage = 0.0;
      oos_stop_total = oos_stop_removed = 0;
      oos_stop_removed_pct = 0.0;
      oos_step4plus_total = oos_step4plus_lost = 0;
      oos_step4plus_lost_pct = 0.0;
      oos_step5_total = oos_step5_lost = 0;
      oos_step5_lost_pct = 0.0;
      oos_tradeoff_score = 0.0;
      oos_cohens_d = 0.0;
      stability_label = "UNKNOWN";
      degradation_stop = 0.0;
      degradation_tradeoff = 0.0;
   }
};
#define RSCH_MAX_OOS_RESULTS 200
SOOSRuleResult g_oos_results[];
int            g_oos_result_count = 0;
datetime       g_oos_cutoff = 0;
// ==================== GLOBAL RESEARCH VARIABLES ====================
SRschFeatureMeta   g_rsch_meta[];
SRschGroupBucket   g_rsch_groups[];
SRschFinalResult   g_rsch_results[];
int                g_rsch_result_count = 0;
SRschComboResult   g_rsch_combos[];
int                g_rsch_combo_count = 0;
SRschPairwiseResult g_rsch_pairs[];
int                 g_rsch_pair_count = 0;
// ==================== GET FEATURE VALUE ====================
double RschGetFeatureValue(const SEntrySnapshot &s,
                           ENUM_RSCH_FEATURE feature,
                           int tf_idx,
                           bool &ok)
{
   ok = false;
   switch(feature)
   {
      // ===== per-TF entry features =====
      case RSCH_F_RSI:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.rsi[tf_idx] > 0.0 && s.rsi[tf_idx] <= 100.0);
         return s.rsi[tf_idx];
      case RSCH_F_ADX:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.adx[tf_idx] > 0.0);
         return s.adx[tf_idx];
      case RSCH_F_CCI:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = MathIsValidNumber(s.cci[tf_idx]);
         return s.cci[tf_idx];
      case RSCH_F_ATR:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.atr[tf_idx] > 0.0);
         return s.atr[tf_idx];
      case RSCH_F_ATR_REGIME:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.atr_regime[tf_idx] > 0.0);
         return s.atr_regime[tf_idx];
      case RSCH_F_ADX_SLOPE:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = MathIsValidNumber(s.adx_slope[tf_idx]);
         return s.adx_slope[tf_idx];
      case RSCH_F_EMA_COMPRESSION:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.ema_compression[tf_idx] > 0.0);
         return s.ema_compression[tf_idx];
      case RSCH_F_EMA200_DIST:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.ema200_dist[tf_idx] > 0.0);
         return s.ema200_dist[tf_idx];
      case RSCH_F_DI_GAP:
         if(tf_idx < 0 || tf_idx >= TF_COUNT) return 0.0;
         ok = (s.di_gap[tf_idx] >= 0.0);
         return s.di_gap[tf_idx];
      // ===== global entry features =====
      case RSCH_F_STABILITY:
         ok = (s.stability_score >= 0);
         return (double)s.stability_score;
      case RSCH_F_DI_AGREEMENT:
         ok = (s.di_agreement_count >= 0);
         return (double)s.di_agreement_count;
      case RSCH_F_EMA_BULLISH_COUNT:
         ok = (s.ema_bullish_count >= 0);
         return (double)s.ema_bullish_count;
      case RSCH_F_PIVOT1_DIST:
         ok = (s.pivot1_dist > 0);
         return (double)s.pivot1_dist;
      case RSCH_F_PIVOT2_DIST:
         ok = (s.pivot2_dist > 0);
         return (double)s.pivot2_dist;
      case RSCH_F_PIVOT_GAP_MIN:
         ok = (s.piv_gap_min > 0);
         return (double)s.piv_gap_min;
      case RSCH_F_PIVOT_GAP_MAX:
         ok = (s.piv_gap_max > 0);
         return (double)s.piv_gap_max;
      case RSCH_F_OB_DIST_PCT:
         ok = (s.ob_dist_pct >= 0.0);
         return s.ob_dist_pct;
      case RSCH_F_OB_AGE_BARS:
         ok = (s.ob_age_bars >= 0);
         return (double)s.ob_age_bars;
      case RSCH_F_OB_WIDTH_ATR:
         ok = (s.ob_width_atr > 0.0);
         return s.ob_width_atr;
      case RSCH_F_SIGNAL_CLV:
         ok = (s.signal_clv >= 0.0 && s.signal_clv <= 1.0);
         return s.signal_clv;
      case RSCH_F_SIGNAL_BODY_RATIO:
         ok = (s.signal_body_ratio >= 0.0 && s.signal_body_ratio <= 1.0);
         return s.signal_body_ratio;
      // ===== Divergence Quality Features (NEW) =====
      case RSCH_F_PRICE_DIV_STRENGTH:
         ok = MathIsValidNumber(s.price_div_strength);
         return s.price_div_strength;
      case RSCH_F_RSI_DIV_STRENGTH:
         ok = MathIsValidNumber(s.rsi_div_strength);
         return s.rsi_div_strength;
      case RSCH_F_DIV_PRICE_SLOPE:
         ok = MathIsValidNumber(s.div_price_slope);
         return s.div_price_slope;
      case RSCH_F_DIV_RSI_SLOPE:
         ok = MathIsValidNumber(s.div_rsi_slope);
         return s.div_rsi_slope;
      case RSCH_F_DIV_SPAN_BARS:
         ok = (s.div_span_bars > 0);
         return (double)s.div_span_bars;
      case RSCH_F_PIVOT_SYMMETRY:
         ok = (s.pivot_symmetry >= 0.0 && s.pivot_symmetry <= 1.0);
         return s.pivot_symmetry;
      case RSCH_F_TIME_SINCE_P3:
         ok = (s.time_since_p3 >= 0);
         return (double)s.time_since_p3;
      case RSCH_F_PIVOT_RSI_P1:
         ok = (s.pivot_rsi_p1 > 0.0 && s.pivot_rsi_p1 <= 100.0);
         return s.pivot_rsi_p1;
      case RSCH_F_PIVOT_RSI_P2:
         ok = (s.pivot_rsi_p2 > 0.0 && s.pivot_rsi_p2 <= 100.0);
         return s.pivot_rsi_p2;
      case RSCH_F_PIVOT_RSI_P3:
         ok = (s.pivot_rsi_p3 > 0.0 && s.pivot_rsi_p3 <= 100.0);
         return s.pivot_rsi_p3;
      case RSCH_F_PRICE_LEG_RATIO:
         ok = (s.price_leg_ratio >= 0.0);
         return s.price_leg_ratio;
      case RSCH_F_RSI_ACCELERATION:
         ok = MathIsValidNumber(s.rsi_acceleration);
         return s.rsi_acceleration;
      case RSCH_F_DIVERGENCE_ANGLE:
         ok = MathIsValidNumber(s.divergence_angle);
         return s.divergence_angle;
      // ===== outcome metrics =====
      case RSCH_F_MFE_MONEY:
         ok = true;
         return s.mfe_money;
      case RSCH_F_MAE_MONEY:
         ok = true;
         return s.mae_money;
      case RSCH_F_MAXDD_MONEY:
         ok = true;
         return s.max_dd_money;
      case RSCH_F_PROFIT:
         ok = true;
         return s.final_profit;
      default:
         return 0.0;
   }
}
// ==================== FEATURE FULL NAME ====================
string RschFeatureFullName(ENUM_RSCH_FEATURE feature, int tf_index)
{
   if((int)feature < 0 || (int)feature >= ArraySize(g_rsch_meta))
      return "UNKNOWN";
   string name = g_rsch_meta[(int)feature].name;
   if(g_rsch_meta[(int)feature].per_tf && tf_index >= 0 && tf_index < TF_COUNT)
      return name + "_" + g_tf[tf_index].name;
   return name;
}
// ==================== GROUP MATCHING ====================
bool RschSnapshotMatchesGroup(const SEntrySnapshot &sn, ENUM_RSCH_GROUP g)
{
   string ft = OS_GetFinalToken(sn.close_event);
   bool is_stop   = OS_IsStopToken(ft);
   bool is_target = OS_IsTargetToken(ft);
   int  ms        = sn.actual_max_step;
   switch(g)
   {
      case RSCH_G_STEP5:       return (ms == 5);
      case RSCH_G_STOP:        return is_stop;
      case RSCH_G_MAXSTEP2:    return (ms == 2);
      case RSCH_G_MAXSTEP3:    return (ms == 3);
      case RSCH_G_MAXSTEP4:    return (ms == 4);
      case RSCH_G_STEP4PLUS:   return (ms >= 4);
      case RSCH_G_DEEP_STOP:   return (ms >= 4 && is_stop);
      case RSCH_G_DEEP_TARGET: return (ms >= 4 && is_target);
      case RSCH_G_SAFE_TARGET: return (ms <= 2 && is_target);
      case RSCH_G_MAXSTEP1:    return (ms == 1);
   }
   return false;
}
// ==================== BUILD ALL GROUPS ====================
void RschBuildGroups()
{
   if(g_oos_cutoff == 0)
      g_oos_cutoff = RschCalcOOSCutoff();
   ArrayResize(g_rsch_groups, RSCH_G_COUNT);
   for(int g = 0; g < RSCH_G_COUNT; g++)
   {
      g_rsch_groups[g].Reset();
      g_rsch_groups[g].group_id = (ENUM_RSCH_GROUP)g;
      ArrayResize(g_rsch_groups[g].indices, g_snapshot_count);
   }
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!RschIsDevTime(g_snapshots[i].entry_time))
         continue;
      if(g_snapshots[i].actual_max_step < 1 || g_snapshots[i].actual_max_step > 5)
         continue;
      for(int g = 0; g < RSCH_G_COUNT; g++)
      {
         if(RschSnapshotMatchesGroup(g_snapshots[i], (ENUM_RSCH_GROUP)g))
         {
            int idx = g_rsch_groups[g].n;
            g_rsch_groups[g].indices[idx] = i;
            g_rsch_groups[g].n++;
            if(g_snapshots[i].final_profit > 0)
               g_rsch_groups[g].win_count++;
            g_rsch_groups[g].sum_profit += g_snapshots[i].final_profit;
            g_rsch_groups[g].sum_mfe    += g_snapshots[i].mfe_money;
            g_rsch_groups[g].sum_mae    += g_snapshots[i].mae_money;
            g_rsch_groups[g].sum_maxdd  += g_snapshots[i].max_dd_money;
         }
      }
   }
   for(int g = 0; g < RSCH_G_COUNT; g++)
      ArrayResize(g_rsch_groups[g].indices, g_rsch_groups[g].n);
   Print("=== Research Groups Built (DEV only) ===");
   for(int g = 0; g < RSCH_G_COUNT; g++)
   {
      if(g_rsch_groups[g].n > 0)
      {
         double wr = (g_rsch_groups[g].n > 0)
            ? (g_rsch_groups[g].win_count * 100.0 / g_rsch_groups[g].n) : 0.0;
         Print("  ", RschGroupName((ENUM_RSCH_GROUP)g),
               ": N=", g_rsch_groups[g].n,
               " | WR=", DoubleToString(wr, 1), "%",
               " | AvgProfit=$", DoubleToString(g_rsch_groups[g].sum_profit / g_rsch_groups[g].n, 2));
      }
   }
}
bool RschCollectGroupFeatureValues(ENUM_RSCH_GROUP group_id,
                                   ENUM_RSCH_FEATURE feature,
                                   int tf_idx,
                                   double &vals[])
{
   ArrayResize(vals, 0);
   int gi = (int)group_id;
   if(gi < 0 || gi >= ArraySize(g_rsch_groups))
      return false;
   for(int i = 0; i < g_rsch_groups[gi].n; i++)
   {
      int snap_idx = g_rsch_groups[gi].indices[i];
      if(snap_idx < 0 || snap_idx >= g_snapshot_count)
         continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[snap_idx], feature, tf_idx, ok);
      if(!ok) continue;
      if(!MathIsValidNumber(v)) continue;
      int n = ArraySize(vals);
      ArrayResize(vals, n + 1);
      vals[n] = v;
   }
   return (ArraySize(vals) > 0);
}
double RschQuantileFromSorted(double &vals[], double q)
{
   int n = ArraySize(vals);
   if(n <= 0) return 0.0;
   if(n == 1) return vals[0];
   if(q < 0.0) q = 0.0;
   if(q > 1.0) q = 1.0;
   double pos = (n - 1) * q;
   int lo = (int)MathFloor(pos);
   int hi = (int)MathCeil(pos);
   if(lo < 0) lo = 0;
   if(hi >= n) hi = n - 1;
   if(lo == hi)
      return vals[lo];
   double frac = pos - lo;
   return vals[lo] + (vals[hi] - vals[lo]) * frac;
}
bool RschCalcDescriptiveStats(double &vals[], SRschFeatureStat &out_stat)
{
   out_stat.Reset();
   int n = ArraySize(vals);
   if(n <= 0)
      return false;
   ArraySort(vals);
   out_stat.n = n;
   out_stat.min_val = vals[0];
   out_stat.max_val = vals[n - 1];
   double sum = 0.0;
   for(int i = 0; i < n; i++)
      sum += vals[i];
   out_stat.mean = sum / n;
   if((n % 2) == 1)
      out_stat.median = vals[n / 2];
   else
      out_stat.median = (vals[n / 2 - 1] + vals[n / 2]) / 2.0;
   out_stat.q25 = RschQuantileFromSorted(vals, 0.25);
   out_stat.q75 = RschQuantileFromSorted(vals, 0.75);
   if(n > 1)
   {
      double var = 0.0;
      for(int i = 0; i < n; i++)
      {
         double d = vals[i] - out_stat.mean;
         var += d * d;
      }
      out_stat.std = MathSqrt(var / (n - 1));
   }
   else
   {
      out_stat.std = 0.0;
   }
   return true;
}
double RschCalcCohensD(SRschFeatureStat &a, SRschFeatureStat &b)
{
   if(a.n < 2 || b.n < 2)
      return 0.0;
   double pooled_var =
      (((a.n - 1) * a.std * a.std) + ((b.n - 1) * b.std * b.std)) /
      (double)(a.n + b.n - 2);
   if(pooled_var <= 0.0)
      return 0.0;
   double sp = MathSqrt(pooled_var);
   if(sp <= 0.0000001)
      return 0.0;
   return (a.mean - b.mean) / sp;
}
double RschCalcCliffsDelta(double &vals_a[], double &vals_b[])
{
   int na = ArraySize(vals_a);
   int nb = ArraySize(vals_b);
   if(na <= 0 || nb <= 0)
      return 0.0;
   long gt = 0;
   long lt = 0;
   for(int i = 0; i < na; i++)
   {
      for(int j = 0; j < nb; j++)
      {
         if(vals_a[i] > vals_b[j]) gt++;
         else if(vals_a[i] < vals_b[j]) lt++;
      }
   }
   double denom = (double)na * (double)nb;
   if(denom <= 0.0)
      return 0.0;
   return ((double)gt - (double)lt) / denom;
}
string RschEffectLabel(double d)
{
   double ad = MathAbs(d);
   if(ad >= 0.80) return "Large";
   if(ad >= 0.50) return "Medium";
   if(ad >= 0.20) return "Small";
   return "Negligible";
}
string RschBuildDirectionText(ENUM_RSCH_FEATURE feature,
                              int tf_idx,
                              ENUM_RSCH_GROUP group_a,
                              ENUM_RSCH_GROUP group_b,
                              double mean_a,
                              double mean_b)
{
   string fname = RschFeatureFullName(feature, tf_idx);
   string ga = RschGroupName(group_a);
   string gb = RschGroupName(group_b);
   if(MathAbs(mean_a - mean_b) < 0.0000001)
      return fname + ": no clear directional difference between " + ga + " and " + gb;
   if(mean_a > mean_b)
      return "Higher " + fname + " in " + ga + " than " + gb;
   return "Lower " + fname + " in " + ga + " than " + gb;
}
bool RschBuildPairwiseResult(ENUM_RSCH_GROUP group_a,
                             ENUM_RSCH_GROUP group_b,
                             ENUM_RSCH_FEATURE feature,
                             int tf_idx,
                             SRschPairwiseResult &out_res)
{
   out_res.Reset();
   double vals_a[];
   double vals_b[];
   if(!RschCollectGroupFeatureValues(group_a, feature, tf_idx, vals_a))
      return false;
   if(!RschCollectGroupFeatureValues(group_b, feature, tf_idx, vals_b))
   {
      ArrayFree(vals_a);
      return false;
   }
   if(ArraySize(vals_a) < RSCH_MIN_GROUP_SHOW || ArraySize(vals_b) < RSCH_MIN_GROUP_SHOW)
   {
      ArrayFree(vals_a);
      ArrayFree(vals_b);
      return false;
   }
   SRschFeatureStat sa, sb;
   if(!RschCalcDescriptiveStats(vals_a, sa))
   {
      ArrayFree(vals_a);
      ArrayFree(vals_b);
      return false;
   }
   if(!RschCalcDescriptiveStats(vals_b, sb))
   {
      ArrayFree(vals_a);
      ArrayFree(vals_b);
      return false;
   }
   out_res.feature   = feature;
   out_res.tf_index  = tf_idx;
   out_res.group_a   = group_a;
   out_res.group_b   = group_b;
   out_res.stat_a    = sa;
   out_res.stat_b    = sb;
   out_res.mean_diff   = sa.mean - sb.mean;
   out_res.median_diff = sa.median - sb.median;
   out_res.cohens_d    = RschCalcCohensD(sa, sb);
   out_res.effect_label = RschEffectLabel(out_res.cohens_d);
   out_res.direction_text = RschBuildDirectionText(feature, tf_idx, group_a, group_b, sa.mean, sb.mean);
   // Cliff's Delta only if |d| >= 0.5 and computation is still reasonable
   long pair_ops = (long)ArraySize(vals_a) * (long)ArraySize(vals_b);
   if(MathAbs(out_res.cohens_d) >= 0.50 && pair_ops <= 2000000)
   {
      out_res.cliffs_delta = RschCalcCliffsDelta(vals_a, vals_b);
      out_res.cliffs_computed = true;
   }
   else
   {
      out_res.cliffs_delta = 0.0;
      out_res.cliffs_computed = false;
   }
   ArrayFree(vals_a);
   ArrayFree(vals_b);
   return true;
}
void RschStorePairwiseResult(SRschPairwiseResult &res)
{
   if(g_rsch_pair_count >= ArraySize(g_rsch_pairs))
      ArrayResize(g_rsch_pairs, g_rsch_pair_count + 100);
   g_rsch_pairs[g_rsch_pair_count] = res;
   g_rsch_pair_count++;
}
void RschSortPairwiseByAbsD()
{
   if(g_rsch_pair_count <= 1) return;
   int gap = g_rsch_pair_count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < g_rsch_pair_count; i++)
      {
         SRschPairwiseResult temp = g_rsch_pairs[i];
         double temp_score = MathAbs(temp.cohens_d);
         int j = i;
         while(j >= gap && MathAbs(g_rsch_pairs[j - gap].cohens_d) < temp_score)
         {
            g_rsch_pairs[j] = g_rsch_pairs[j - gap];
            j -= gap;
         }
         g_rsch_pairs[j] = temp;
      }
      gap /= 2;
   }
}
void RschRunPairwiseAnalysis()
{
   g_rsch_pair_count = 0;
   for(int i = 0; i < ArraySize(g_rsch_pairs); i++)
      g_rsch_pairs[i].Reset();
   // Pair definitions
   ENUM_RSCH_GROUP pair_a[RSCH_MAX_PAIRWISE];
   ENUM_RSCH_GROUP pair_b[RSCH_MAX_PAIRWISE];
   int pair_count = 0;
   pair_a[pair_count] = RSCH_G_STEP4PLUS;   pair_b[pair_count] = RSCH_G_STOP;        pair_count++;
   pair_a[pair_count] = RSCH_G_STEP5;       pair_b[pair_count] = RSCH_G_STOP;        pair_count++;
   pair_a[pair_count] = RSCH_G_STEP4PLUS;   pair_b[pair_count] = RSCH_G_MAXSTEP2;    pair_count++;
   pair_a[pair_count] = RSCH_G_STEP4PLUS;   pair_b[pair_count] = RSCH_G_MAXSTEP3;    pair_count++;
   pair_a[pair_count] = RSCH_G_STEP5;       pair_b[pair_count] = RSCH_G_MAXSTEP2;    pair_count++;
   pair_a[pair_count] = RSCH_G_STOP;        pair_b[pair_count] = RSCH_G_MAXSTEP2;    pair_count++;
   pair_a[pair_count] = RSCH_G_DEEP_STOP;   pair_b[pair_count] = RSCH_G_DEEP_TARGET; pair_count++;
   pair_a[pair_count] = RSCH_G_DEEP_STOP;   pair_b[pair_count] = RSCH_G_SAFE_TARGET; pair_count++;
   for(int f = 0; f < RSCH_F_COUNT; f++)
   {
      ENUM_RSCH_FEATURE feat = (ENUM_RSCH_FEATURE)f;
      // pairwise فقط روی Entry Features
      if(!g_rsch_meta[f].entry_feature)
         continue;
      if(g_rsch_meta[f].per_tf)
      {
         for(int tf = 0; tf < TF_COUNT; tf++)
         {
            for(int p = 0; p < pair_count; p++)
            {
               SRschPairwiseResult res;
               if(RschBuildPairwiseResult(pair_a[p], pair_b[p], feat, tf, res))
                  RschStorePairwiseResult(res);
            }
         }
      }
      else
      {
         for(int p = 0; p < pair_count; p++)
         {
            SRschPairwiseResult res;
            if(RschBuildPairwiseResult(pair_a[p], pair_b[p], feat, -1, res))
               RschStorePairwiseResult(res);
         }
      }
   }
   RschSortPairwiseByAbsD();
   Print("=== RESEARCH PAIRWISE ANALYSIS ===");
   Print("  Total pairwise results: ", g_rsch_pair_count);
   int preview = MathMin(g_rsch_pair_count, 12);
   for(int i = 0; i < preview; i++)
   {
      string fname = RschFeatureFullName(g_rsch_pairs[i].feature, g_rsch_pairs[i].tf_index);
      Print("  #", i + 1,
            " | ", fname,
            " | ", RschGroupName(g_rsch_pairs[i].group_a),
            " vs ", RschGroupName(g_rsch_pairs[i].group_b),
            " | d=", DoubleToString(g_rsch_pairs[i].cohens_d, 3),
            " | ", g_rsch_pairs[i].effect_label,
            " | N=", g_rsch_pairs[i].stat_a.n, "/", g_rsch_pairs[i].stat_b.n);
   }
}
bool RschCollectAllFeatureValues(ENUM_RSCH_FEATURE feature,
                                 int tf_idx,
                                 double &vals[])
{
   ArrayResize(vals, 0);
   if(g_oos_cutoff == 0)
      g_oos_cutoff = RschCalcOOSCutoff();
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!RschIsDevTime(g_snapshots[i].entry_time))
         continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok) continue;
      if(!MathIsValidNumber(v)) continue;
      int n = ArraySize(vals);
      ArrayResize(vals, n + 1);
      vals[n] = v;
   }
   return (ArraySize(vals) > 0);
}
double RschThresholdEps(double v)
{
   double a = MathAbs(v);
   if(a >= 1000.0) return 0.1;
   if(a >= 100.0)  return 0.05;
   if(a >= 10.0)   return 0.01;
   if(a >= 1.0)    return 0.001;
   return 0.0001;
}
void RschAddThresholdUnique(double &thrs[], int &count, double thr)
{
   if(!MathIsValidNumber(thr)) return;
   double eps = RschThresholdEps(thr);
   for(int i = 0; i < count; i++)
   {
      if(MathAbs(thrs[i] - thr) <= eps)
         return;
   }
   int n = ArraySize(thrs);
   if(count >= n)
      ArrayResize(thrs, n + 32);
   thrs[count++] = thr;
}
bool RschBuildThresholdCandidates(ENUM_RSCH_FEATURE feature,
                                  int tf_idx,
                                  double &thrs[],
                                  int &thr_count)
{
   thr_count = 0;
   ArrayResize(thrs, 32);
   double vals[];
   if(!RschCollectAllFeatureValues(feature, tf_idx, vals))
      return false;
   if(ArraySize(vals) < RSCH_MIN_SAMPLE_STRONG)
   {
      ArrayFree(vals);
      return false;
   }
   SRschFeatureStat all_stat;
   if(!RschCalcDescriptiveStats(vals, all_stat))
   {
      ArrayFree(vals);
      return false;
   }
   // Quantile points
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.10));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.20));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.25));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.30));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.33));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.40));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.50));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.60));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.67));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.70));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.75));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.80));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.90));
   // Mean and Std based
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean);
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean - all_stat.std);
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean + all_stat.std);
   // Midpoint between STOP and STEP4PLUS
   double vals_stop[], vals_s4[];
   if(RschCollectGroupFeatureValues(RSCH_G_STOP, feature, tf_idx, vals_stop) &&
      RschCollectGroupFeatureValues(RSCH_G_STEP4PLUS, feature, tf_idx, vals_s4))
   {
      SRschFeatureStat st_stop, st_s4;
      if(RschCalcDescriptiveStats(vals_stop, st_stop) &&
         RschCalcDescriptiveStats(vals_s4, st_s4))
      {
         double midpoint = (st_stop.mean + st_s4.mean) / 2.0;
         RschAddThresholdUnique(thrs, thr_count, midpoint);
      }
   }
   ArrayFree(vals_stop);
   ArrayFree(vals_s4);
   ArrayFree(vals);
   if(thr_count > 1)
      ArraySort(thrs);
   return (thr_count > 0);
}
bool RschEvaluateThreshold(ENUM_RSCH_FEATURE feature,
                           int tf_idx,
                           bool less_equal,
                           double threshold,
                           SRschTradeoffResult &out_res)
{
   out_res.Reset();
   if(g_oos_cutoff == 0)
      g_oos_cutoff = RschCalcOOSCutoff();
   int total_valid = 0;
   int pass_cnt = 0;
   int stop_total = 0, stop_pass = 0;
   int step4_total = 0, step4_pass = 0;
   int step5_total = 0, step5_pass = 0;
   int step3_total = 0, step3_pass = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!RschIsDevTime(g_snapshots[i].entry_time))
         continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok) continue;
      if(!MathIsValidNumber(v)) continue;
      total_valid++;
      string ft = OS_GetFinalToken(g_snapshots[i].close_event);
      bool is_stop = OS_IsStopToken(ft);
      bool is_step4plus = (g_snapshots[i].actual_max_step >= 4);
      bool is_step5     = (g_snapshots[i].actual_max_step == 5);
      bool is_step3     = (g_snapshots[i].actual_max_step == 3);
      if(is_stop)      stop_total++;
      if(is_step4plus) step4_total++;
      if(is_step5)     step5_total++;
      if(is_step3)     step3_total++;
      bool pass = less_equal ? (v <= threshold) : (v >= threshold);
      if(pass)
      {
        pass_cnt++;
        if(is_stop)      stop_pass++;
        if(is_step4plus) step4_pass++;
        if(is_step5)     step5_pass++;
        if(is_step3)     step3_pass++;
      }
   }
   if(total_valid < RSCH_MIN_SAMPLE_STRONG || pass_cnt < RSCH_MIN_GROUP_SHOW)
      return false;
   double coverage_pct = (double)pass_cnt * 100.0 / total_valid;
   if(coverage_pct < RSCH_MIN_COVERAGE_FILTER)
      return false;
   out_res.threshold     = threshold;
   out_res.less_equal    = less_equal;
   out_res.coverage_pct  = coverage_pct;
   out_res.occurrence    = pass_cnt;
   out_res.stop_removed_pct   = (stop_total > 0)   ? ((double)(stop_total - stop_pass) * 100.0 / stop_total)   : 0.0;
   out_res.step4plus_lost_pct = (step4_total > 0)  ? ((double)(step4_total - step4_pass) * 100.0 / step4_total) : 0.0;
   out_res.step5_lost_pct     = (step5_total > 0)  ? ((double)(step5_total - step5_pass) * 100.0 / step5_total) : 0.0;
   out_res.step3_lost_pct     = (step3_total > 0)  ? ((double)(step3_total - step3_pass) * 100.0 / step3_total) : 0.0;
   out_res.score =
      (RSCH_TRADEOFF_W_STOP        * out_res.stop_removed_pct)
      - (RSCH_TRADEOFF_W_STEP4PLUS * out_res.step4plus_lost_pct)
      - (RSCH_TRADEOFF_W_STEP3     * out_res.step3_lost_pct);
   out_res.valid = true;
   return true;
}
bool RschEvaluateThresholdSide(ENUM_RSCH_FEATURE feature,
                               int tf_idx,
                               bool less_equal,
                               double threshold,
                               bool is_buy,
                               double &score_out)
{
   score_out = 0.0;
   if(g_oos_cutoff == 0)
      g_oos_cutoff = RschCalcOOSCutoff();
   int total_valid = 0;
   int pass_cnt = 0;
   int stop_total = 0;
   int stop_pass = 0;
   int step4_total = 0;
   int step4_pass = 0;
   int step3_total = 0;
   int step3_pass = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!RschIsDevTime(g_snapshots[i].entry_time))
         continue;
      if(g_snapshots[i].is_bullish != is_buy)
         continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok) continue;
      if(!MathIsValidNumber(v)) continue;
      total_valid++;
      string ft = OS_GetFinalToken(g_snapshots[i].close_event);
      bool is_stop = OS_IsStopToken(ft);
      bool is_step4plus = (g_snapshots[i].actual_max_step >= 4);
      bool is_step3     = (g_snapshots[i].actual_max_step == 3);
      if(is_stop)      stop_total++;
      if(is_step4plus) step4_total++;
      if(is_step3)     step3_total++;
      bool pass = less_equal ? (v <= threshold) : (v >= threshold);
      if(pass)
      {
         pass_cnt++;
         if(is_stop)      stop_pass++;
         if(is_step4plus) step4_pass++;
         if(is_step3)     step3_pass++;
      }
   }
   if(total_valid < RSCH_MIN_SAMPLE_MODERATE)
      return false;
   if(pass_cnt < RSCH_MIN_GROUP_SHOW)
      return false;
   double coverage_pct = (double)pass_cnt * 100.0 / total_valid;
   if(coverage_pct < 20.0)
      return false;
   double stop_removed =
      (stop_total > 0) ? ((double)(stop_total - stop_pass) * 100.0 / stop_total) : 0.0;
   double step4_lost =
      (step4_total > 0) ? ((double)(step4_total - step4_pass) * 100.0 / step4_total) : 0.0;
   double step3_lost =
      (step3_total > 0) ? ((double)(step3_total - step3_pass) * 100.0 / step3_total) : 0.0;
   score_out =
      (RSCH_TRADEOFF_W_STOP * stop_removed)
      - (RSCH_TRADEOFF_W_STEP4PLUS * step4_lost)
      - (RSCH_TRADEOFF_W_STEP3 * step3_lost);
   return true;
}
double RschCalcStabilityScore(ENUM_RSCH_FEATURE feature,
                              int tf_idx,
                              SRschTradeoffResult &best_tr)
{
   double buy_score = 0.0;
   double sell_score = 0.0;
   bool buy_ok  = RschEvaluateThresholdSide(feature, tf_idx, best_tr.less_equal, best_tr.threshold, true,  buy_score);
   bool sell_ok = RschEvaluateThresholdSide(feature, tf_idx, best_tr.less_equal, best_tr.threshold, false, sell_score);
   if(buy_ok && sell_ok)
   {
      if(buy_score > 0.0 && sell_score > 0.0)
         return 100.0;
      if((buy_score > 0.0 && sell_score > -5.0) || (sell_score > 0.0 && buy_score > -5.0))
         return 70.0;
      return 25.0;
   }
   if(buy_ok || sell_ok)
   {
      double one_score = buy_ok ? buy_score : sell_score;
      return (one_score > 0.0) ? 50.0 : 20.0;
   }
   return 0.0;
}
double RschEffectScore(double d)
{
   double ad = MathAbs(d);
   if(ad >= 0.80) return 100.0;
   if(ad >= 0.50) return 70.0;
   if(ad >= 0.20) return 40.0;
   return 10.0;
}
double RschTradeoffScoreNorm(double raw)
{
   double v = raw * 2.0;
   if(v < 0.0) v = 0.0;
   if(v > 100.0) v = 100.0;
   return v;
}
double RschCoverageScore(double cov)
{
   if(cov >= 60.0) return 100.0;
   if(cov >= 45.0) return 80.0;
   if(cov >= 30.0) return 55.0;
   return 20.0;
}
string RschReliabilityLabel(int n_a, int n_b, double d_abs)
{
   int min_n = MathMin(n_a, n_b);
   if(min_n >= 100 && d_abs >= 0.50) return "High";
   if(min_n >= 50  && d_abs >= 0.20) return "Medium";
   if(min_n >= 30)                    return "Low";
   return "Low Sample";
}
string RschVerdict(double rs, double d_abs, double tradeoff, double coverage, int n_a, int n_b)
{
   if(n_a < RSCH_MIN_GROUP_SHOW || n_b < RSCH_MIN_GROUP_SHOW)
      return "LOW_SAMPLE";
   if(rs >= 70.0 &&
      d_abs >= 0.50 &&
      tradeoff >= RSCH_MIN_TRADEOFF_STRONG &&
      coverage >= RSCH_MIN_COVERAGE_STRONG &&
      n_a >= RSCH_MIN_SAMPLE_STRONG &&
      n_b >= RSCH_MIN_SAMPLE_STRONG)
      return "STRONG";
   if(rs >= 45.0 &&
      d_abs >= 0.20 &&
      tradeoff >= RSCH_MIN_TRADEOFF_MODERATE &&
      coverage >= RSCH_MIN_COVERAGE_MODERATE &&
      n_a >= RSCH_MIN_SAMPLE_MODERATE &&
      n_b >= RSCH_MIN_SAMPLE_MODERATE)
      return "MODERATE";
   if(rs >= 25.0)
      return "WEAK";
   return "NOISE";
}
string RschGetVerdictDetails(SRschFinalResult &fr)
{
   double d_abs    = MathAbs(fr.best_cohens_d);
   int    n_a      = fr.stat_positive.n;
   int    n_b      = fr.stat_negative.n;
   double rs       = fr.research_score;
   double tradeoff = fr.tradeoff.score;
   double coverage = fr.tradeoff.coverage_pct;
   string lines = "";
   // Research Score
   if(rs >= 70.0)
      lines += "✓ Research Score = " + DoubleToString(rs, 1) + " >= 70\n";
   else
      lines += "✗ Research Score = " + DoubleToString(rs, 1) + " < 70\n";
   // Effect Size
   if(d_abs >= 0.50)
      lines += "✓ |d| = " + DoubleToString(d_abs, 3) + " >= 0.50 (" + fr.effect_label + ")\n";
   else if(d_abs >= 0.20)
      lines += "~ |d| = " + DoubleToString(d_abs, 3) + " >= 0.20 (Small)\n";
   else
      lines += "✗ |d| = " + DoubleToString(d_abs, 3) + " < 0.20 (Negligible)\n";
   // Tradeoff
   if(tradeoff >= RSCH_MIN_TRADEOFF_STRONG)
      lines += "✓ Tradeoff = " + DoubleToString(tradeoff, 1) + " >= " + DoubleToString(RSCH_MIN_TRADEOFF_STRONG, 0) + "\n";
   else if(tradeoff >= RSCH_MIN_TRADEOFF_MODERATE)
      lines += "~ Tradeoff = " + DoubleToString(tradeoff, 1) + " >= " + DoubleToString(RSCH_MIN_TRADEOFF_MODERATE, 0) + "\n";
   else
      lines += "✗ Tradeoff = " + DoubleToString(tradeoff, 1) + " < " + DoubleToString(RSCH_MIN_TRADEOFF_MODERATE, 0) + "\n";
   // Coverage
   if(coverage >= RSCH_MIN_COVERAGE_STRONG)
      lines += "✓ Coverage = " + DoubleToString(coverage, 1) + "% >= " + DoubleToString(RSCH_MIN_COVERAGE_STRONG, 0) + "%\n";
   else if(coverage >= RSCH_MIN_COVERAGE_MODERATE)
      lines += "~ Coverage = " + DoubleToString(coverage, 1) + "% >= " + DoubleToString(RSCH_MIN_COVERAGE_MODERATE, 0) + "%\n";
   else
      lines += "✗ Coverage = " + DoubleToString(coverage, 1) + "% < " + DoubleToString(RSCH_MIN_COVERAGE_MODERATE, 0) + "%\n";
   // Sample size
   int min_n = MathMin(n_a, n_b);
   if(min_n >= RSCH_MIN_SAMPLE_STRONG)
      lines += "✓ Sample (min) = " + IntegerToString(min_n) + " >= " + IntegerToString(RSCH_MIN_SAMPLE_STRONG) + "\n";
   else if(min_n >= RSCH_MIN_SAMPLE_MODERATE)
      lines += "~ Sample (min) = " + IntegerToString(min_n) + " >= " + IntegerToString(RSCH_MIN_SAMPLE_MODERATE) + "\n";
   else
      lines += "✗ Sample (min) = " + IntegerToString(min_n) + " < " + IntegerToString(RSCH_MIN_SAMPLE_MODERATE) + "\n";
   lines += "Reliability: " + fr.reliability;
   return lines;
}
void ExportResearchTopFeaturesCSV()
{
   if(g_rsch_result_count == 0)
   {
      Print("ExportResearchTopFeaturesCSV: No results.");
      return;
   }
   string fn = "Research_TopFeatures_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ|FILE_WRITE|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   FileSeek(h, 0, SEEK_END);
   // HEADER
   string hdr =
      "Rank,Feature,TF,Feature_Type,"
      "PairA,PairB,"
      "N_A,N_B,"
      "Mean_A,Mean_B,Median_A,Median_B,"
      "Cohens_D,Cliffs_Delta,Cliffs_Computed,"
      "Effect_Label,Direction_Text,"
      "Best_Threshold,Best_Direction,"
      "Stop_Removed_Pct,Step4Plus_Lost_Pct,Step5_Lost_Pct,Step3_Lost_Pct,"
      "Coverage_Pct,Occurrence,"
      "Tradeoff_Score,Effect_Score,TradeoffNorm_Score,Stability_Score,Coverage_Score,"
      "Research_Score,Reliability,Verdict,"
      "Verdict_Detail,"
      "Conclusion";
   FileWriteString(h, hdr + "\r\n");
   for(int i = 0; i < g_rsch_result_count; i++)
   {
      SRschFinalResult fr = g_rsch_results[i];
      string feat_type = g_rsch_meta[(int)fr.feature].entry_feature ? "ENTRY" : "OUTCOME";
      string tf_name   = (fr.tf_index >= 0 && fr.tf_index < TF_COUNT) ? g_tf[fr.tf_index].name : "GLOBAL";
      string cond      = fr.tradeoff.less_equal ? "<=" : ">=";
      string verdict_detail = RschGetVerdictDetails(fr);
      StringReplace(verdict_detail, "\n", " | ");
      string row = "";
      row += IntegerToString(i + 1) + ",";
      row += EscapeCSV(g_rsch_meta[(int)fr.feature].name) + ",";
      row += tf_name + ",";
      row += feat_type + ",";
      row += RschGroupName(fr.best_pair_a) + ",";
      row += RschGroupName(fr.best_pair_b) + ",";
      row += IntegerToString(fr.stat_positive.n) + ",";
      row += IntegerToString(fr.stat_negative.n) + ",";
      row += DoubleToString(fr.stat_positive.mean, 4) + ",";
      row += DoubleToString(fr.stat_negative.mean, 4) + ",";
      row += DoubleToString(fr.stat_positive.median, 4) + ",";
      row += DoubleToString(fr.stat_negative.median, 4) + ",";
      row += DoubleToString(fr.best_cohens_d, 4) + ",";
      row += (fr.cliffs_computed ? DoubleToString(fr.best_cliffs_delta, 4) : "") + ",";
      row += (fr.cliffs_computed ? "YES" : "NO") + ",";
      row += EscapeCSV(fr.effect_label) + ",";
      row += EscapeCSV(fr.direction_text) + ",";
      row += DoubleToString(fr.tradeoff.threshold, 6) + ",";
      row += cond + ",";
      row += DoubleToString(fr.tradeoff.stop_removed_pct, 2) + ",";
      row += DoubleToString(fr.tradeoff.step4plus_lost_pct, 2) + ",";
      row += DoubleToString(fr.tradeoff.step5_lost_pct, 2) + ",";
      row += DoubleToString(fr.tradeoff.step3_lost_pct, 2) + ",";
      row += DoubleToString(fr.tradeoff.coverage_pct, 2) + ",";
      row += IntegerToString(fr.tradeoff.occurrence) + ",";
      row += DoubleToString(fr.tradeoff.score, 2) + ",";
      row += DoubleToString(fr.effect_score, 1) + ",";
      row += DoubleToString(fr.tradeoff_score_norm, 1) + ",";
      row += DoubleToString(fr.stability_score, 1) + ",";
      row += DoubleToString(fr.coverage_score, 1) + ",";
      row += DoubleToString(fr.research_score, 2) + ",";
      row += EscapeCSV(fr.reliability) + ",";
      row += EscapeCSV(fr.verdict) + ",";
      row += EscapeCSV(verdict_detail) + ",";
      row += EscapeCSV(fr.conclusion);
      FileWriteString(h, row + "\r\n");
   }
   FileFlush(h);
   FileClose(h);
   Print("Research_TopFeatures exported: ", fn,
         " | Features=", g_rsch_result_count);
}
void ExportResearchReportHTML()
{
   if(g_rsch_result_count == 0)
   {
      Print("ExportResearchReportHTML: No results.");
      return;
   }
   string fn = "Research_Report_" + _Symbol + ".html";
   int h = SafeOpenHTML(fn);
   if(h == INVALID_HANDLE) return;
   string dir = inp_use_persian_language ? "rtl" : "ltr";
   // ===== HTML HEAD =====
   string html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">\r\n";
   html += "<title>Research Report - " + _Symbol + "</title>\r\n";
   html += "<style>\r\n";
   html += "body{font-family:Tahoma,Arial;background:#1a1a2e;color:#fff;padding:24px;direction:" + dir + ";}\r\n";
   html += "h1{color:#00d4ff;text-align:center;margin:0 0 6px 0;font-size:26px;}\r\n";
   html += "h2{color:#00d4ff;margin:30px 0 10px 0;border-bottom:2px solid #00d4ff;padding-bottom:8px;font-size:18px;}\r\n";
   html += "h3{color:#ffd700;margin:20px 0 8px 0;font-size:15px;}\r\n";
   html += "h4{color:#aaa;margin:14px 0 6px 0;font-size:13px;}\r\n";
   html += "table{width:100%;border-collapse:collapse;font-size:11px;margin:10px 0;}\r\n";
   html += "th{background:#2a2a4a;color:#00d4ff;padding:9px 6px;border:1px solid #333;white-space:nowrap;}\r\n";
   html += "td{padding:7px 6px;border:1px solid #333;text-align:center;}\r\n";
   html += ".section{background:rgba(0,0,0,0.25);border:1px solid #333;border-radius:10px;padding:18px;margin:18px 0;}\r\n";
   html += ".verdict-STRONG{color:#00ff88;font-weight:bold;}\r\n";
   html += ".verdict-MODERATE{color:#ffff00;}\r\n";
   html += ".verdict-WEAK{color:#ffa500;}\r\n";
   html += ".verdict-NOISE{color:#888;font-style:italic;}\r\n";
   html += ".verdict-LOW_SAMPLE{color:#ff6666;font-style:italic;}\r\n";
   html += ".effect-Large{color:#00ff88;font-weight:bold;}\r\n";
   html += ".effect-Medium{color:#ffff00;}\r\n";
   html += ".effect-Small{color:#ffa500;}\r\n";
   html += ".effect-Negligible{color:#888;}\r\n";
   html += ".positive{color:#00ff88;}\r\n";
   html += ".negative{color:#ff4444;}\r\n";
   html += ".warn-box{background:rgba(255,165,0,0.12);border:1px solid #ffa500;border-radius:8px;padding:14px;margin:12px 0;font-size:12px;color:#ffa500;}\r\n";
   html += ".info-box{background:rgba(0,212,255,0.08);border:1px solid #00d4ff;border-radius:8px;padding:12px;margin:10px 0;font-size:12px;color:#aaa;line-height:1.8;}\r\n";
   html += ".verdict-detail{font-family:Consolas,monospace;font-size:10px;color:#888;white-space:pre-wrap;}\r\n";
   html += ".conclusion-box{background:rgba(0,0,0,0.3);border-left:3px solid #00d4ff;padding:10px;margin:8px 0;font-size:11px;color:#ccc;line-height:1.7;}\r\n";
   html += ".mono{font-family:Consolas,monospace;}\r\n";
   html += "</style></head><body>\r\n";
   html += "<h1>📊 Research Report — " + _Symbol + "</h1>\r\n";
   html += "<p style=\"text-align:center;color:#888;margin:0 0 20px 0;\">Generated: " +
           TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "</p>\r\n";
   FileWriteString(h, html);
   // ===== SECTION 1: VALIDATION SUMMARY =====
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<h2>✅ Research Validation Summary</h2>\r\n");
   FileWriteString(h, "<table>\r\n");
   FileWriteString(h, "<tr><th>Metric</th><th>Value</th><th>Notes</th></tr>\r\n");
   int n_s4plus = g_rsch_groups[RSCH_G_STEP4PLUS].n;
   int n_stop   = g_rsch_groups[RSCH_G_STOP].n;
   int n_s5     = g_rsch_groups[RSCH_G_STEP5].n;
   int n_s2     = g_rsch_groups[RSCH_G_MAXSTEP2].n;
   int n_s3     = g_rsch_groups[RSCH_G_MAXSTEP3].n;
   int n_strong = 0, n_moderate = 0, n_weak = 0, n_noise = 0;
   for(int i = 0; i < g_rsch_result_count; i++)
   {
      string v = g_rsch_results[i].verdict;
      if(v == "STRONG")        n_strong++;
      else if(v == "MODERATE") n_moderate++;
      else if(v == "WEAK")     n_weak++;
      else                     n_noise++;
   }
   FileWriteString(h, "<tr><td>Total Snapshots</td><td>" + IntegerToString(g_snapshot_count) + "</td><td>All included</td></tr>\r\n");
   FileWriteString(h, "<tr><td>STEP4PLUS group (N)</td><td>" + IntegerToString(n_s4plus) + "</td><td>Primary positive class</td></tr>\r\n");
   FileWriteString(h, "<tr><td>STEP5 group (N)</td><td>" + IntegerToString(n_s5) + "</td><td>Supplementary</td></tr>\r\n");
   FileWriteString(h, "<tr><td>STOP group (N)</td><td>" + IntegerToString(n_stop) + "</td><td>Primary negative class</td></tr>\r\n");
   FileWriteString(h, "<tr><td>MAXSTEP2 group (N)</td><td>" + IntegerToString(n_s2) + "</td><td>Safe baseline</td></tr>\r\n");
   FileWriteString(h, "<tr><td>MAXSTEP3 group (N)</td><td>" + IntegerToString(n_s3) + "</td><td>Moderate</td></tr>\r\n");
   FileWriteString(h, "<tr><td>Pairwise Comparisons</td><td>" + IntegerToString(g_rsch_pair_count) + "</td><td></td></tr>\r\n");
   FileWriteString(h, "<tr><td>Ranked Features</td><td>" + IntegerToString(g_rsch_result_count) + "</td><td></td></tr>\r\n");
   FileWriteString(h, "<tr><td>Verdict — STRONG</td><td class=\"verdict-STRONG\">" + IntegerToString(n_strong) + "</td><td>Ready for threshold testing</td></tr>\r\n");
   FileWriteString(h, "<tr><td>Verdict — MODERATE</td><td class=\"verdict-MODERATE\">" + IntegerToString(n_moderate) + "</td><td>Promising, needs OOS confirmation</td></tr>\r\n");
   FileWriteString(h, "<tr><td>Verdict — WEAK</td><td class=\"verdict-WEAK\">" + IntegerToString(n_weak) + "</td><td>Low discriminative power</td></tr>\r\n");
   FileWriteString(h, "<tr><td>Verdict — NOISE</td><td class=\"verdict-NOISE\">" + IntegerToString(n_noise) + "</td><td>Not useful</td></tr>\r\n");
   FileWriteString(h, "</table>\r\n");
   FileWriteString(h,
      "<div class=\"warn-box\">⚠ All results are In-Sample. "
      "No finding should be applied live without Out-of-Sample or Walk-Forward validation. "
      "DEV/OOS split available in RiskLab_Raw_" + _Symbol + ".csv</div>\r\n");
   FileWriteString(h, "</div>\r\n");
   // ===== SECTION 2: GROUP PROFILES =====
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<h2>📊 Group Profiles</h2>\r\n");
   FileWriteString(h, "<table>\r\n");
   FileWriteString(h, "<tr><th>Group</th><th>N</th><th>WinRate%</th><th>AvgProfit</th><th>AvgMFE</th><th>AvgMAE</th><th>AvgMaxDD</th><th>MFE>0%</th></tr>\r\n");
   for(int g = 0; g < RSCH_G_COUNT; g++)
   {
      if(g_rsch_groups[g].n < RSCH_MIN_GROUP_SHOW) continue;
      int nn = g_rsch_groups[g].n;
      double wr  = g_rsch_groups[g].win_count * 100.0 / nn;
      double avp = g_rsch_groups[g].sum_profit / nn;
      double avm = g_rsch_groups[g].sum_mfe / nn;
      double ama = g_rsch_groups[g].sum_mae / nn;
      double add = g_rsch_groups[g].sum_maxdd / nn;
      int mfe_pos = 0;
      for(int i = 0; i < g_rsch_groups[g].n; i++)
      {
         int si = g_rsch_groups[g].indices[i];
         if(g_snapshots[si].mfe_money > 0.0) mfe_pos++;
      }
      double mfe_pct = (double)mfe_pos * 100.0 / nn;
      string pc = (avp >= 0) ? "positive" : "negative";
      FileWriteString(h, "<tr>");
      FileWriteString(h, "<td><b>" + RschGroupName((ENUM_RSCH_GROUP)g) + "</b></td>");
      FileWriteString(h, "<td>" + IntegerToString(nn) + "</td>");
      FileWriteString(h, "<td>" + DoubleToString(wr, 1) + "%</td>");
      FileWriteString(h, "<td class=\"" + pc + "\">$" + DoubleToString(avp, 2) + "</td>");
      FileWriteString(h, "<td>$" + DoubleToString(avm, 2) + "</td>");
      FileWriteString(h, "<td>$" + DoubleToString(ama, 2) + "</td>");
      FileWriteString(h, "<td>$" + DoubleToString(add, 2) + "</td>");
      FileWriteString(h, "<td>" + DoubleToString(mfe_pct, 1) + "%</td>");
      FileWriteString(h, "</tr>\r\n");
   }
   FileWriteString(h, "</table>\r\n");
   FileWriteString(h, "</div>\r\n");
   // ===== SECTION 3: TOP DISCRIMINATORS =====
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<h2>🏆 Top Discriminators (Ranked Features)</h2>\r\n");
   FileWriteString(h,
      "<div class=\"info-box\">How to read: "
      "Each row is one Feature/TF combination. "
      "Stop_Removed% shows how much the STOP rate drops if you apply the threshold as a filter. "
      "Step4Plus_Lost% shows how much of the positive group you'd lose. "
      "Coverage% = how many signals remain after filter.</div>\r\n");
   FileWriteString(h, "<table>\r\n");
   FileWriteString(h,
      "<tr><th>#</th><th>Feature</th><th>TF</th>"
      "<th>Comparison</th><th>N_A / N_B</th>"
      "<th>Mean_A</th><th>Mean_B</th>"
      "<th>|d|</th><th>Effect</th>"
      "<th>Threshold</th><th>Cond</th>"
      "<th>Stop_Removed%</th><th>Step4+_Lost%</th>"
      "<th>Coverage%</th><th>Occ</th>"
      "<th>Tradeoff</th><th>RS</th>"
      "<th>Reliability</th><th>Verdict</th></tr>\r\n");
   for(int i = 0; i < g_rsch_result_count; i++)
   {
      SRschFinalResult fr = g_rsch_results[i];
      string tf_name = (fr.tf_index >= 0 && fr.tf_index < TF_COUNT) ? g_tf[fr.tf_index].name : "GLOBAL";
      string cond = fr.tradeoff.less_equal ? "&le;" : "&ge;";
      string vclass = "verdict-" + fr.verdict;
      string eclass = "effect-" + fr.effect_label;
      FileWriteString(h, "<tr>");
      FileWriteString(h, "<td>" + IntegerToString(i + 1) + "</td>");
      FileWriteString(h, "<td class=\"mono\"><b>" + g_rsch_meta[(int)fr.feature].name + "</b></td>");
      FileWriteString(h, "<td>" + tf_name + "</td>");
      FileWriteString(h, "<td style=\"font-size:10px;\">" + RschGroupName(fr.best_pair_a) + " vs " + RschGroupName(fr.best_pair_b) + "</td>");
      FileWriteString(h, "<td>" + IntegerToString(fr.stat_positive.n) + "/" + IntegerToString(fr.stat_negative.n) + "</td>");
      FileWriteString(h, "<td>" + DoubleToString(fr.stat_positive.mean, 4) + "</td>");
      FileWriteString(h, "<td>" + DoubleToString(fr.stat_negative.mean, 4) + "</td>");
      FileWriteString(h, "<td class=\"" + eclass + "\">" + DoubleToString(MathAbs(fr.best_cohens_d), 3) + "</td>");
      FileWriteString(h, "<td class=\"" + eclass + "\">" + fr.effect_label + "</td>");
      FileWriteString(h, "<td class=\"mono\">" + DoubleToString(fr.tradeoff.threshold, 4) + "</td>");
      FileWriteString(h, "<td>" + cond + "</td>");
      FileWriteString(h, "<td style=\"color:#00ff88;font-weight:bold;\">" + DoubleToString(fr.tradeoff.stop_removed_pct, 1) + "%</td>");
      FileWriteString(h, "<td style=\"color:#ff9999;\">" + DoubleToString(fr.tradeoff.step4plus_lost_pct, 1) + "%</td>");
      FileWriteString(h, "<td>" + DoubleToString(fr.tradeoff.coverage_pct, 1) + "%</td>");
      FileWriteString(h, "<td>" + IntegerToString(fr.tradeoff.occurrence) + "</td>");
      FileWriteString(h, "<td>" + DoubleToString(fr.tradeoff.score, 1) + "</td>");
      FileWriteString(h, "<td style=\"font-weight:bold;\">" + DoubleToString(fr.research_score, 1) + "</td>");
      FileWriteString(h, "<td>" + fr.reliability + "</td>");
      FileWriteString(h, "<td class=\"" + vclass + "\">" + fr.verdict + "</td>");
      FileWriteString(h, "</tr>\r\n");
      if(fr.verdict == "STRONG" || fr.verdict == "MODERATE")
      {
         string det = RschGetVerdictDetails(fr);
         StringReplace(det, "\n", "<br>");
         FileWriteString(h,
            "<tr><td colspan=\"19\" style=\"text-align:left;padding:6px 12px;\">"
            "<div class=\"verdict-detail\">" + det + "</div>"
            "<div class=\"conclusion-box\">" + fr.conclusion + "</div>"
            "</td></tr>\r\n");
      }
   }
   FileWriteString(h, "</table>\r\n");
   FileWriteString(h, "</div>\r\n");
   // ===== SECTION 4: LIMITATIONS =====
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<h2>⚠ Limitations</h2>\r\n");
   FileWriteString(h,
      "<div class=\"warn-box\">"
      "1. This report covers only signals accepted by the current strategy logic. "
      "Signals generated during an active open setup are not captured.<br><br>"
      "2. All findings are In-Sample (trained on the full dataset). "
      "No result should be used for live filtering without Out-of-Sample or Walk-Forward validation.<br><br>"
      "3. Sample sizes for STOP and STEP5 groups are relatively modest. "
      "Statistical conclusions should be interpreted with caution.<br><br>"
      "4. Threshold values were selected by maximizing Tradeoff Score on In-Sample data. "
      "The optimal threshold may differ on future data.<br><br>"
      "5. MFE/MAE/MaxDD are Outcome Metrics and should not be used as entry filters."
      "</div>\r\n");
   FileWriteString(h, "</div>\r\n");
   // ===== FOOTER =====
   FileWriteString(h,
      "<p style=\"text-align:center;color:#555;margin-top:30px;font-size:11px;\">"
      "Research Report — Divergence EA | " + _Symbol + " | " +
      TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) +
      "</p>\r\n</body></html>");
   FileFlush(h);
   FileClose(h);
   Print("Research_Report exported: ", fn);
}
//========================================================
// OOS VALIDATION ENGINE
//========================================================
// Determine cutoff date: first 70% of snapshots by time = DEV
datetime RschCalcOOSCutoff()
{
   if(g_snapshot_count < 10)
      return 0;
   datetime fixed_cut = StringToTime("2023.01.01");
   bool has_pre = false;
   bool has_post = false;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_snapshots[i].entry_time < fixed_cut)  has_pre = true;
      if(g_snapshots[i].entry_time >= fixed_cut) has_post = true;
   }
   if(has_pre && has_post)
      return fixed_cut;
   // fallback for datasets that do not span 2023
   datetime times[];
   ArrayResize(times, g_snapshot_count);
   for(int i = 0; i < g_snapshot_count; i++)
      times[i] = g_snapshots[i].entry_time;
   ArraySort(times);
   int dev_count = (int)MathFloor(g_snapshot_count * 0.70);
   if(dev_count < 5) dev_count = 5;
   if(dev_count >= g_snapshot_count) dev_count = g_snapshot_count - 1;
   datetime cutoff = times[dev_count];
   ArrayFree(times);
   return cutoff;
}
// Classify snapshot outcome
bool OOS_IsStop(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsStopToken(ft);
}
bool OOS_IsStep4Plus(SEntrySnapshot &sn)
{
   return (sn.actual_max_step >= 4);
}
bool OOS_IsStep5(SEntrySnapshot &sn)
{
   return (sn.actual_max_step == 5);
}
// Apply threshold rule to one snapshot
bool OOS_ApplyRule(SEntrySnapshot &sn, ENUM_RSCH_FEATURE feature, int tf_idx, bool reject_above, double threshold)
{
   bool ok = false;
   double v = RschGetFeatureValue(sn, feature, tf_idx, ok);
   if(!ok) return true;  // if missing, accept (conservative)
   if(reject_above)
      return (v <= threshold);  // accept only if <= threshold
   else
      return (v >= threshold);  // accept only if >= threshold
}
// Evaluate one rule on a subset of snapshots
void OOS_EvaluateRule(ENUM_RSCH_FEATURE feature,
                      int tf_idx,
                      bool less_equal_threshold,
                      double threshold,
                      bool use_oos,
                      SOOSRuleResult &res,
                      bool fill_dev)
{
   int total      = 0;
   int accepted   = 0;
   int rejected   = 0;
   int stop_total = 0;
   int stop_pass  = 0;
   int s4_total   = 0;
   int s4_pass    = 0;
   int s5_total   = 0;
   int s5_pass    = 0;
   double feat_accepted[];
   double feat_rejected[];
   int fa_cnt = 0, fr_cnt = 0;
   ArrayResize(feat_accepted, g_snapshot_count);
   ArrayResize(feat_rejected, g_snapshot_count);
   for(int i = 0; i < g_snapshot_count; i++)
   {
      bool is_oos_snap = (g_snapshots[i].entry_time >= g_oos_cutoff && g_oos_cutoff > 0);
      if(use_oos  &&  !is_oos_snap) continue;
      if(!use_oos &&   is_oos_snap) continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok) continue;
      total++;
      string ft   = OS_GetFinalToken(g_snapshots[i].close_event);
      bool is_stop = OS_IsStopToken(ft);
      bool is_s4p  = (g_snapshots[i].actual_max_step >= 4);
      bool is_s5   = (g_snapshots[i].actual_max_step == 5);
      if(is_stop) stop_total++;
      if(is_s4p)  s4_total++;
      if(is_s5)   s5_total++;
      // FIX: less_equal_threshold = true means accept if v <= threshold
      bool accept_trade = less_equal_threshold ? (v <= threshold) : (v >= threshold);
      if(accept_trade)
      {
         accepted++;
         if(is_stop) stop_pass++;
         if(is_s4p)  s4_pass++;
         if(is_s5)   s5_pass++;
         feat_accepted[fa_cnt++] = v;
      }
      else
      {
         rejected++;
         feat_rejected[fr_cnt++] = v;
      }
   }
   // Cohen's d between accepted and rejected
   double d = 0.0;
   if(fa_cnt >= 2 && fr_cnt >= 2)
   {
      double tmp_a[], tmp_b[];
      ArrayResize(tmp_a, fa_cnt);
      ArrayResize(tmp_b, fr_cnt);
      for(int j = 0; j < fa_cnt; j++) tmp_a[j] = feat_accepted[j];
      for(int j = 0; j < fr_cnt; j++) tmp_b[j] = feat_rejected[j];
      SRschFeatureStat sa, sb;
      RschCalcDescriptiveStats(tmp_a, sa);
      RschCalcDescriptiveStats(tmp_b, sb);
      d = RschCalcCohensD(sa, sb);
      ArrayFree(tmp_a);
      ArrayFree(tmp_b);
   }
   ArrayFree(feat_accepted);
   ArrayFree(feat_rejected);
   double coverage     = (total > 0) ? (accepted * 100.0 / total) : 0.0;
   double stop_removed = (stop_total > 0) ? ((stop_total - stop_pass) * 100.0 / stop_total) : 0.0;
   double s4_lost      = (s4_total  > 0) ? ((s4_total  - s4_pass ) * 100.0 / s4_total ) : 0.0;
   double s5_lost      = (s5_total  > 0) ? ((s5_total  - s5_pass ) * 100.0 / s5_total ) : 0.0;
   double tradeoff     = RSCH_TRADEOFF_W_STOP * stop_removed
                        - RSCH_TRADEOFF_W_STEP4PLUS * s4_lost
                        - RSCH_TRADEOFF_W_STEP3 * s5_lost;
   if(fill_dev)
   {
      res.dev_total              = total;
      res.dev_accepted           = accepted;
      res.dev_rejected           = rejected;
      res.dev_coverage           = coverage;
      res.dev_stop_total         = stop_total;
      res.dev_stop_removed       = stop_total - stop_pass;
      res.dev_stop_removed_pct   = stop_removed;
      res.dev_step4plus_total    = s4_total;
      res.dev_step4plus_lost     = s4_total - s4_pass;
      res.dev_step4plus_lost_pct = s4_lost;
      res.dev_step5_total        = s5_total;
      res.dev_step5_lost         = s5_total - s5_pass;
      res.dev_step5_lost_pct     = s5_lost;
      res.dev_tradeoff_score     = tradeoff;
      res.dev_cohens_d           = d;
   }
   else
   {
      res.oos_total              = total;
      res.oos_accepted           = accepted;
      res.oos_rejected           = rejected;
      res.oos_coverage           = coverage;
      res.oos_stop_total         = stop_total;
      res.oos_stop_removed       = stop_total - stop_pass;
      res.oos_stop_removed_pct   = stop_removed;
      res.oos_step4plus_total    = s4_total;
      res.oos_step4plus_lost     = s4_total - s4_pass;
      res.oos_step4plus_lost_pct = s4_lost;
      res.oos_step5_total        = s5_total;
      res.oos_step5_lost         = s5_total - s5_pass;
      res.oos_step5_lost_pct     = s5_lost;
      res.oos_tradeoff_score     = tradeoff;
      res.oos_cohens_d           = d;
   }
}
// Stability label
string OOS_StabilityLabel(double dev_stop, double oos_stop, double dev_tradeoff, double oos_tradeoff)
{
   if(oos_stop <= 0.0) return "FAILED";
   double ratio_stop     = oos_stop / MathMax(dev_stop, 0.0001);
   double ratio_tradeoff = oos_tradeoff / MathMax(dev_tradeoff, 0.0001);
   if(ratio_stop >= 0.80 && ratio_tradeoff >= 0.70)
      return "STABLE";
   if(ratio_stop >= 0.60 && ratio_tradeoff >= 0.50)
      return "MILD_DEGRADATION";
   return "UNSTABLE";
}
// Main OOS runner
bool RschFindBestThresholdOnDEV(ENUM_RSCH_FEATURE feature,
                                 int tf_idx,
                                 SRschTradeoffResult &best_res)
{
   best_res.Reset();
   // ===== Collect DEV feature values =====
   double vals[];
   ArrayResize(vals, g_snapshot_count);
   int vcnt = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_oos_cutoff > 0 && g_snapshots[i].entry_time >= g_oos_cutoff) continue;
      // ← این چک وجود دارد — پس DEV-only است ✅
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok || !MathIsValidNumber(v)) continue;
      vals[vcnt++] = v;
   }
   if(vcnt < RSCH_MIN_SAMPLE_STRONG)
   {
      ArrayFree(vals);
      return false;
   }
   ArrayResize(vals, vcnt);
   SRschFeatureStat all_stat;
   if(!RschCalcDescriptiveStats(vals, all_stat))
   {
      ArrayFree(vals);
      return false;
   }
   // ===== Build threshold candidates from DEV =====
   double thrs[];
   int thr_count = 0;
   ArrayResize(thrs, 32);
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.10));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.20));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.25));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.33));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.40));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.50));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.60));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.67));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.75));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.80));
   RschAddThresholdUnique(thrs, thr_count, RschQuantileFromSorted(vals, 0.90));
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean);
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean - all_stat.std);
   RschAddThresholdUnique(thrs, thr_count, all_stat.mean + all_stat.std);
   // Midpoint from DEV STOP and STEP4+ groups
   double dev_stop_vals[], dev_s4_vals[];
   ArrayResize(dev_stop_vals, g_snapshot_count);
   ArrayResize(dev_s4_vals, g_snapshot_count);
   int ds_cnt = 0, d4_cnt = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_oos_cutoff > 0 && g_snapshots[i].entry_time >= g_oos_cutoff) continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[i], feature, tf_idx, ok);
      if(!ok) continue;
      string ft = OS_GetFinalToken(g_snapshots[i].close_event);
      if(OS_IsStopToken(ft) && ds_cnt < g_snapshot_count)
         dev_stop_vals[ds_cnt++] = v;
      if(g_snapshots[i].actual_max_step >= 4 && d4_cnt < g_snapshot_count)
         dev_s4_vals[d4_cnt++] = v;
   }
   if(ds_cnt >= 5 && d4_cnt >= 5)
   {
      ArrayResize(dev_stop_vals, ds_cnt);
      ArrayResize(dev_s4_vals, d4_cnt);
      SRschFeatureStat st_stop, st_s4;
      if(RschCalcDescriptiveStats(dev_stop_vals, st_stop) &&
         RschCalcDescriptiveStats(dev_s4_vals, st_s4))
      {
         RschAddThresholdUnique(thrs, thr_count, (st_stop.mean + st_s4.mean) / 2.0);
      }
   }
   ArrayFree(dev_stop_vals);
   ArrayFree(dev_s4_vals);
   if(thr_count > 1)
      ArraySort(thrs);
   // ===== Pre-compute DEV group totals =====
   int total   = 0;
   int stop_t  = 0;
   int s4_t    = 0;
   int s3_t    = 0;
   for(int j = 0; j < g_snapshot_count; j++)
   {
      if(g_oos_cutoff > 0 && g_snapshots[j].entry_time >= g_oos_cutoff) continue;
      bool ok = false;
      double v = RschGetFeatureValue(g_snapshots[j], feature, tf_idx, ok);
      if(!ok) continue;
      total++;
      string ft = OS_GetFinalToken(g_snapshots[j].close_event);
      if(OS_IsStopToken(ft)) stop_t++;
      if(g_snapshots[j].actual_max_step >= 4) s4_t++;
      if(g_snapshots[j].actual_max_step == 3) s3_t++;
   }
   if(total < RSCH_MIN_SAMPLE_STRONG)
   {
      ArrayFree(vals);
      ArrayFree(thrs);
      return false;
   }
   // ===== Search best threshold — both LE and GE directions =====
   bool found = false;
   double best_score = -999999.0;
   for(int i = 0; i < thr_count; i++)
   {
      double thr = thrs[i];
      // --- Test both directions ---
      for(int dir = 0; dir < 2; dir++)
      {
         bool le = (dir == 0);  // dir=0 => <=threshold ; dir=1 => >=threshold
         int pass    = 0;
         int stop_p  = 0;
         int s4_p    = 0;
         int s3_p    = 0;
         for(int j = 0; j < g_snapshot_count; j++)
         {
            if(g_oos_cutoff > 0 && g_snapshots[j].entry_time >= g_oos_cutoff) continue;
            bool ok = false;
            double v = RschGetFeatureValue(g_snapshots[j], feature, tf_idx, ok);
            if(!ok) continue;
            bool accept = le ? (v <= thr) : (v >= thr);
            if(!accept) continue;
            pass++;
            string ft = OS_GetFinalToken(g_snapshots[j].close_event);
            if(OS_IsStopToken(ft)) stop_p++;
            if(g_snapshots[j].actual_max_step >= 4) s4_p++;
            if(g_snapshots[j].actual_max_step == 3) s3_p++;
         }
         if(pass < RSCH_MIN_GROUP_SHOW) continue;
         double cov  = (double)pass * 100.0 / total;
         if(cov < RSCH_MIN_COVERAGE_FILTER) continue;
         double sr   = (stop_t > 0) ? ((double)(stop_t - stop_p) * 100.0 / stop_t)  : 0.0;
         double s4l  = (s4_t  > 0) ? ((double)(s4_t  - s4_p ) * 100.0 / s4_t )  : 0.0;
         double s3l  = (s3_t  > 0) ? ((double)(s3_t  - s3_p ) * 100.0 / s3_t )  : 0.0;
         double sc   = RSCH_TRADEOFF_W_STOP * sr
                      - RSCH_TRADEOFF_W_STEP4PLUS * s4l
                      - RSCH_TRADEOFF_W_STEP3 * s3l;
         if(sc > best_score)
         {
            best_score = sc;
            best_res.threshold         = thr;
            best_res.less_equal        = le;
            best_res.stop_removed_pct  = sr;
            best_res.step4plus_lost_pct = s4l;
            best_res.step3_lost_pct    = s3l;
            best_res.coverage_pct      = cov;
            best_res.occurrence        = pass;
            best_res.score             = sc;
            best_res.valid             = true;
            found = true;
         }
      }
   }
   ArrayFree(vals);
   ArrayFree(thrs);
   return found;
}
void RschRunOOSValidation()
{
   g_oos_result_count = 0;
   for(int i = 0; i < RSCH_MAX_OOS_RESULTS; i++)
      g_oos_results[i].Reset();
   g_oos_cutoff = RschCalcOOSCutoff();
   if(g_oos_cutoff == 0)
   {
      Print("OOS Validation: Cannot determine cutoff date.");
      return;
   }
   int dev_cnt = 0, oos_cnt = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_snapshots[i].entry_time >= g_oos_cutoff) oos_cnt++;
      else dev_cnt++;
   }
   Print("=== OOS VALIDATION ===");
   Print("  Cutoff: ", TimeToString(g_oos_cutoff, TIME_DATE));
   Print("  DEV: ", dev_cnt, " | OOS: ", oos_cnt);
   if(oos_cnt < MIN_OOS_SAMPLES_FOR_VALIDATION)
   {
      Print("OOS Validation: Not enough OOS samples (need >=20, have ", oos_cnt, ")");
      return;
   }
   int top_n = MathMin(g_rsch_result_count, 20);
   for(int ri = 0; ri < top_n && g_oos_result_count < RSCH_MAX_OOS_RESULTS; ri++)
   {
      SRschFinalResult fr = g_rsch_results[ri];
      if(!g_rsch_meta[(int)fr.feature].entry_feature)
         continue;
      // =====================================================================
      // FIX: Threshold MUST be found exclusively on DEV data
      // This prevents OOS leakage from full-dataset threshold selection
      // =====================================================================
      SRschTradeoffResult dev_only_threshold;
      dev_only_threshold.Reset();
      bool found = RschFindBestThresholdOnDEV(fr.feature, fr.tf_index, dev_only_threshold);
      if(!found || !dev_only_threshold.valid)
         continue;
      if(dev_only_threshold.threshold == 0.0)
         continue;
      SOOSRuleResult res;
      res.Reset();
      res.feature_name = fr.feature_full_name;
      res.tf_index     = fr.tf_index;
      res.tf_name      = (fr.tf_index >= 0 && fr.tf_index < TF_COUNT)
                         ? g_tf[fr.tf_index].name : "GLOBAL";
      // Use DEV-only threshold — not the full-dataset threshold
      res.threshold    = dev_only_threshold.threshold;
      res.reject_above = dev_only_threshold.less_equal;
      // Evaluate on DEV subset (same data used for threshold finding)
      OOS_EvaluateRule(fr.feature, fr.tf_index,
                       dev_only_threshold.less_equal,
                       dev_only_threshold.threshold,
                       false, res, true);
      // Evaluate on OOS subset (held-out, threshold frozen from DEV)
      OOS_EvaluateRule(fr.feature, fr.tf_index,
                       dev_only_threshold.less_equal,
                       dev_only_threshold.threshold,
                       true, res, false);
      res.degradation_stop     = res.dev_stop_removed_pct - res.oos_stop_removed_pct;
      res.degradation_tradeoff = res.dev_tradeoff_score   - res.oos_tradeoff_score;
      res.stability_label      = OOS_StabilityLabel(res.dev_stop_removed_pct,
                                                    res.oos_stop_removed_pct,
                                                    res.dev_tradeoff_score,
                                                    res.oos_tradeoff_score);
      g_oos_results[g_oos_result_count++] = res;
   }
   Print("  Results: ", g_oos_result_count);
   int preview = MathMin(g_oos_result_count, 10);
   for(int i = 0; i < preview; i++)
   {
      SOOSRuleResult r = g_oos_results[i];
      Print("  ", r.feature_name,
            " | DEV_Thr=", DoubleToString(r.threshold, 4),
            " | DEV: Stop=", DoubleToString(r.dev_stop_removed_pct, 1), "%",
            " S4+Lost=", DoubleToString(r.dev_step4plus_lost_pct, 1), "%",
            " | OOS: Stop=", DoubleToString(r.oos_stop_removed_pct, 1), "%",
            " S4+Lost=", DoubleToString(r.oos_step4plus_lost_pct, 1), "%",
            " | ", r.stability_label);
   }
}
// Export OOS Validation CSV
void ExportOOSValidationCSV()
{
   if(g_oos_result_count == 0)
   {
      Print("ExportOOSValidationCSV: No results.");
      return;
   }
   string fn = "Research_OOSValidation_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ExportOOSValidationCSV: Cannot create file.");
      return;
   }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE)
   {
      Print("ExportOOSValidationCSV: Cannot reopen file.");
      return;
   }
   FileSeek(h, 0, SEEK_END);
   string hdr =
      "Feature,TF,Threshold,Reject_If,"
      "DEV_Total,DEV_Accepted,DEV_Rejected,DEV_Coverage%,"
      "DEV_Stop_Total,DEV_Stop_Removed,DEV_Stop_Removed%,"
      "DEV_Step4Plus_Total,DEV_Step4Plus_Lost,DEV_Step4Plus_Lost%,"
      "DEV_Step5_Total,DEV_Step5_Lost,DEV_Step5_Lost%,"
      "DEV_Tradeoff,DEV_CohensD,"
      "OOS_Total,OOS_Accepted,OOS_Rejected,OOS_Coverage%,"
      "OOS_Stop_Total,OOS_Stop_Removed,OOS_Stop_Removed%,"
      "OOS_Step4Plus_Total,OOS_Step4Plus_Lost,OOS_Step4Plus_Lost%,"
      "OOS_Step5_Total,OOS_Step5_Lost,OOS_Step5_Lost%,"
      "OOS_Tradeoff,OOS_CohensD,"
      "Degradation_Stop%,Degradation_Tradeoff,"
      "Stability_Label,OOS_Cutoff";
   FileWriteString(h, hdr + "\r\n");
   for(int i = 0; i < g_oos_result_count; i++)
   {
      SOOSRuleResult r = g_oos_results[i];
            // reject_above=true means less_equal filter was applied: accept if feature <= threshold
      string cond = r.reject_above ? "LE (accept <=)" : "GE (accept >=)";
      string row = "";
      row += EscapeCSV(r.feature_name) + ",";
      row += EscapeCSV(r.tf_name) + ",";
      row += DoubleToString(r.threshold, 6) + ",";
      row += cond + ",";
      row += IntegerToString(r.dev_total) + ",";
      row += IntegerToString(r.dev_accepted) + ",";
      row += IntegerToString(r.dev_rejected) + ",";
      row += DoubleToString(r.dev_coverage, 2) + ",";
      row += IntegerToString(r.dev_stop_total) + ",";
      row += IntegerToString(r.dev_stop_removed) + ",";
      row += DoubleToString(r.dev_stop_removed_pct, 2) + ",";
      row += IntegerToString(r.dev_step4plus_total) + ",";
      row += IntegerToString(r.dev_step4plus_lost) + ",";
      row += DoubleToString(r.dev_step4plus_lost_pct, 2) + ",";
      row += IntegerToString(r.dev_step5_total) + ",";
      row += IntegerToString(r.dev_step5_lost) + ",";
      row += DoubleToString(r.dev_step5_lost_pct, 2) + ",";
      row += DoubleToString(r.dev_tradeoff_score, 2) + ",";
      row += DoubleToString(r.dev_cohens_d, 4) + ",";
      row += IntegerToString(r.oos_total) + ",";
      row += IntegerToString(r.oos_accepted) + ",";
      row += IntegerToString(r.oos_rejected) + ",";
      row += DoubleToString(r.oos_coverage, 2) + ",";
      row += IntegerToString(r.oos_stop_total) + ",";
      row += IntegerToString(r.oos_stop_removed) + ",";
      row += DoubleToString(r.oos_stop_removed_pct, 2) + ",";
      row += IntegerToString(r.oos_step4plus_total) + ",";
      row += IntegerToString(r.oos_step4plus_lost) + ",";
      row += DoubleToString(r.oos_step4plus_lost_pct, 2) + ",";
      row += IntegerToString(r.oos_step5_total) + ",";
      row += IntegerToString(r.oos_step5_lost) + ",";
      row += DoubleToString(r.oos_step5_lost_pct, 2) + ",";
      row += DoubleToString(r.oos_tradeoff_score, 2) + ",";
      row += DoubleToString(r.oos_cohens_d, 4) + ",";
      row += DoubleToString(r.degradation_stop, 2) + ",";
      row += DoubleToString(r.degradation_tradeoff, 2) + ",";
      row += EscapeCSV(r.stability_label) + ",";
      row += TimeToString(g_oos_cutoff, TIME_DATE);
      FileWriteString(h, row + "\r\n");
   }
   FileFlush(h);
   FileClose(h);
   Print("Research_OOSValidation exported: ", fn, " | Rules=", g_oos_result_count);
}
// Combined runner + export
string RschGenerateConclusion(string feature_name,
                              string direction_text,
                              double d,
                              string effect_label,
                              SRschTradeoffResult &tr,
                              string verdict)
{
   string cond = tr.less_equal ? "<=" : ">=";
   string s = feature_name + ": " + direction_text + ". ";
   s += "Effect=" + effect_label + " (d=" + DoubleToString(d, 3) + "). ";
   s += "Best threshold: " + feature_name + " " + cond + " " + DoubleToString(tr.threshold, 4) + ". ";
   s += "StopRemoved=" + DoubleToString(tr.stop_removed_pct, 1) + "%, ";
   s += "Step4+Lost=" + DoubleToString(tr.step4plus_lost_pct, 1) + "%, ";
   s += "Step5Lost=" + DoubleToString(tr.step5_lost_pct, 1) + "%, ";
   s += "Coverage=" + DoubleToString(tr.coverage_pct, 1) + "% (" + IntegerToString(tr.occurrence) + "). ";
   s += "Verdict=" + verdict + ". ";
   s += "⚠ Needs OOS validation before live use.";
   return s;
}
bool RschFindExactPair(ENUM_RSCH_FEATURE feature,
                       int tf_idx,
                       ENUM_RSCH_GROUP ga,
                       ENUM_RSCH_GROUP gb,
                       SRschPairwiseResult &out_res)
{
   for(int i = 0; i < g_rsch_pair_count; i++)
   {
      if(g_rsch_pairs[i].feature  != feature) continue;
      if(g_rsch_pairs[i].tf_index != tf_idx)  continue;
      if(g_rsch_pairs[i].group_a  != ga)      continue;
      if(g_rsch_pairs[i].group_b  != gb)      continue;
      out_res = g_rsch_pairs[i];
      return true;
   }
   return false;
}
bool RschFindBestPairAny(ENUM_RSCH_FEATURE feature,
                         int tf_idx,
                         SRschPairwiseResult &out_res)
{
   bool found = false;
   double best_abs_d = -1.0;
   for(int i = 0; i < g_rsch_pair_count; i++)
   {
      if(g_rsch_pairs[i].feature  != feature) continue;
      if(g_rsch_pairs[i].tf_index != tf_idx)  continue;
      double ad = MathAbs(g_rsch_pairs[i].cohens_d);
      if(ad > best_abs_d)
      {
         best_abs_d = ad;
         out_res = g_rsch_pairs[i];
         found = true;
      }
   }
   return found;
}
bool RschFindBestThresholdForFeature(ENUM_RSCH_FEATURE feature,
                                     int tf_idx,
                                     SRschTradeoffResult &best_res)
{
   best_res.Reset();
   double thrs[];
   int thr_count = 0;
   if(!RschBuildThresholdCandidates(feature, tf_idx, thrs, thr_count))
      return false;
   bool found = false;
   double best_score = -999999.0;
   for(int i = 0; i < thr_count; i++)
   {
      // <= threshold
      SRschTradeoffResult tr_le;
      if(RschEvaluateThreshold(feature, tf_idx, true, thrs[i], tr_le))
      {
         if(tr_le.score > best_score)
         {
            best_score = tr_le.score;
            best_res = tr_le;
            found = true;
         }
      }
      // >= threshold
      SRschTradeoffResult tr_ge;
      if(RschEvaluateThreshold(feature, tf_idx, false, thrs[i], tr_ge))
      {
         if(tr_ge.score > best_score)
         {
            best_score = tr_ge.score;
            best_res = tr_ge;
            found = true;
         }
      }
   }
   ArrayFree(thrs);
   return found;
}
void RschStoreFinalResult(SRschFinalResult &res)
{
   if(g_rsch_result_count >= ArraySize(g_rsch_results))
      ArrayResize(g_rsch_results, g_rsch_result_count + 100);
   g_rsch_results[g_rsch_result_count] = res;
   g_rsch_result_count++;
}
void RschSortFinalResults()
{
   if(g_rsch_result_count <= 1) return;
   int gap = g_rsch_result_count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < g_rsch_result_count; i++)
      {
         SRschFinalResult temp = g_rsch_results[i];
         double temp_score = temp.research_score;
         int j = i;
         while(j >= gap && g_rsch_results[j - gap].research_score < temp_score)
         {
            g_rsch_results[j] = g_rsch_results[j - gap];
            j -= gap;
         }
         g_rsch_results[j] = temp;
      }
      gap /= 2;
   }
}
void RschBuildFinalResults()
{
   g_rsch_result_count = 0;
   for(int i = 0; i < ArraySize(g_rsch_results); i++)
      g_rsch_results[i].Reset();
   int skipped_low_sample = 0;
   int skipped_invalid    = 0;
   int skipped_no_thresh  = 0;
   for(int f = 0; f < RSCH_F_COUNT; f++)
   {
      if(!g_rsch_meta[f].entry_feature)
         continue;
      ENUM_RSCH_FEATURE feat = (ENUM_RSCH_FEATURE)f;
      int tf_from = g_rsch_meta[f].per_tf ? 0     : -1;
      int tf_to   = g_rsch_meta[f].per_tf ? (TF_COUNT - 1) : -1;
      for(int tf = tf_from; tf <= tf_to; tf++)
      {
         SRschPairwiseResult primary_pair;
         bool has_primary = RschFindExactPair(feat, tf, RSCH_G_STEP4PLUS, RSCH_G_STOP, primary_pair);
         SRschPairwiseResult best_pair;
         bool has_best = false;
         if(has_primary)
         {
            best_pair = primary_pair;
            has_best  = true;
         }
         else
         {
            has_best = RschFindBestPairAny(feat, tf, best_pair);
         }
         if(!has_best)
         {
            skipped_low_sample++;
            continue;
         }
         if(best_pair.stat_a.n < RSCH_MIN_GROUP_SHOW ||
            best_pair.stat_b.n < RSCH_MIN_GROUP_SHOW)
         {
            skipped_low_sample++;
            continue;
         }
         SRschTradeoffResult best_tr;
         if(!RschFindBestThresholdForFeature(feat, tf, best_tr))
         {
            skipped_no_thresh++;
            continue;
         }
         SRschFinalResult fr;
         fr.Reset();
         fr.feature            = feat;
         fr.tf_index           = tf;
         fr.feature_full_name  = RschFeatureFullName(feat, tf);
         fr.best_pair_a        = best_pair.group_a;
         fr.best_pair_b        = best_pair.group_b;
         fr.best_cohens_d      = best_pair.cohens_d;
         fr.best_cliffs_delta  = best_pair.cliffs_delta;
         fr.cliffs_computed    = best_pair.cliffs_computed;
         fr.effect_label       = best_pair.effect_label;
         fr.direction_text     = best_pair.direction_text;
         fr.stat_positive      = best_pair.stat_a;
         fr.stat_negative      = best_pair.stat_b;
         fr.tradeoff           = best_tr;
         fr.effect_score       = RschEffectScore(best_pair.cohens_d);
         fr.tradeoff_score_norm= RschTradeoffScoreNorm(best_tr.score);
         fr.stability_score    = RschCalcStabilityScore(feat, tf, best_tr);
         fr.coverage_score     = RschCoverageScore(best_tr.coverage_pct);
         fr.research_score =
            RSCH_WEIGHT_EFFECT    * fr.effect_score
            + RSCH_WEIGHT_TRADEOFF  * fr.tradeoff_score_norm
            + RSCH_WEIGHT_STABILITY * fr.stability_score
            + RSCH_WEIGHT_COVERAGE  * fr.coverage_score;
         double d_abs      = MathAbs(best_pair.cohens_d);
         fr.reliability    = RschReliabilityLabel(best_pair.stat_a.n, best_pair.stat_b.n, d_abs);
         fr.verdict        = RschVerdict(fr.research_score, d_abs,
                                         best_tr.score, best_tr.coverage_pct,
                                         best_pair.stat_a.n, best_pair.stat_b.n);
         fr.conclusion     = RschGenerateConclusion(fr.feature_full_name,
                                                    fr.direction_text,
                                                    fr.best_cohens_d,
                                                    fr.effect_label,
                                                    fr.tradeoff,
                                                    fr.verdict);
         RschStoreFinalResult(fr);
      }
   }
   RschSortFinalResults();
   // ===== VALIDATION SUMMARY =====
   int n_strong   = 0, n_moderate = 0, n_weak = 0, n_noise = 0, n_low_s = 0;
   for(int i = 0; i < g_rsch_result_count; i++)
   {
      string v = g_rsch_results[i].verdict;
      if(v == "STRONG")      n_strong++;
      else if(v == "MODERATE") n_moderate++;
      else if(v == "WEAK")     n_weak++;
      else if(v == "NOISE")    n_noise++;
      else if(v == "LOW_SAMPLE") n_low_s++;
   }
   int n_s4plus = g_rsch_groups[RSCH_G_STEP4PLUS].n;
   int n_stop   = g_rsch_groups[RSCH_G_STOP].n;
   int n_s5     = g_rsch_groups[RSCH_G_STEP5].n;
   Print("=== RESEARCH VALIDATION SUMMARY ===");
   Print("  Total snapshots:         ", g_snapshot_count);
   Print("  Eligible samples:        ", g_snapshot_count);
   Print("  STEP4PLUS group:         ", n_s4plus);
   Print("  STEP5 group:             ", n_s5);
   Print("  STOP group:              ", n_stop);
   Print("  Pairwise comparisons:    ", g_rsch_pair_count);
   Print("  Ranked features:         ", g_rsch_result_count);
   Print("  Skipped (low sample):    ", skipped_low_sample);
   Print("  Skipped (no threshold):  ", skipped_no_thresh);
   Print("  Verdict — STRONG:        ", n_strong);
   Print("  Verdict — MODERATE:      ", n_moderate);
   Print("  Verdict — WEAK:          ", n_weak);
   Print("  Verdict — NOISE:         ", n_noise);
   Print("  Verdict — LOW_SAMPLE:    ", n_low_s);
   Print("===================================");
   // ===== LOG PREVIEW =====
   Print("=== RESEARCH FINAL RESULTS ===");
   Print("  Total ranked features: ", g_rsch_result_count);
   int preview = MathMin(g_rsch_result_count, 15);
   for(int i = 0; i < preview; i++)
   {
      Print("  #", i + 1,
            " | ", g_rsch_results[i].feature_full_name,
            " | RS=", DoubleToString(g_rsch_results[i].research_score, 1),
            " | d=", DoubleToString(g_rsch_results[i].best_cohens_d, 3),
            " | TO=", DoubleToString(g_rsch_results[i].tradeoff.score, 2),
            " | Cov=", DoubleToString(g_rsch_results[i].tradeoff.coverage_pct, 1), "%",
            " | ", g_rsch_results[i].verdict);
   }
}
void RschRunThresholdResearch()
{
   RschBuildFinalResults();
}
void RschSanityCheck()
{
   Print("=== RESEARCH SANITY CHECK ===");
   // ===== بخش ۱: بررسی SignalRegistry data (از g_snapshots) =====
   Print("--- SignalRegistry Data (g_snapshots) ---");
   Print("  Total snapshots: ", g_snapshot_count);
   int sr_stop = 0, sr_target = 0;
   int sr_step[6] = {0, 0, 0, 0, 0, 0};  // index 0 unused, 1..5
   int sr_path_deep_stop = 0, sr_path_deep_target = 0;
   int sr_path_safe_target = 0, sr_path_unknown = 0;
   int sr_has_piv_gap_min = 0, sr_has_piv_gap_max = 0;
   int sr_has_ob_dist = 0;
   int sr_has_atr_regime = 0, sr_has_adx_slope = 0, sr_has_ema_comp = 0;
   int sr_has_signal_clv = 0, sr_has_signal_body = 0;
   int sr_has_mfe = 0, sr_has_mae = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      string ft = OS_GetFinalToken(g_snapshots[i].close_event);
      if(OS_IsStopToken(ft))   sr_stop++;
      if(OS_IsTargetToken(ft)) sr_target++;
      int ms = g_snapshots[i].actual_max_step;
      if(ms >= 1 && ms <= 5) sr_step[ms]++;
      switch(g_snapshots[i].path_class)
      {
         case PATH_DEEP_STOP:   sr_path_deep_stop++;   break;
         case PATH_DEEP_TARGET: sr_path_deep_target++;  break;
         case PATH_SAFE_TARGET: sr_path_safe_target++;  break;
         case PATH_UNKNOWN:     sr_path_unknown++;       break;
         default: break;
      }
      if(g_snapshots[i].piv_gap_min > 0)                    sr_has_piv_gap_min++;
      if(g_snapshots[i].piv_gap_max > 0)                    sr_has_piv_gap_max++;
      if(g_snapshots[i].ob_dist_pct >= 0.0)                 sr_has_ob_dist++;
      if(g_snapshots[i].atr_regime[TF_IDX_MAIN] > 0.0)      sr_has_atr_regime++;
      if(MathIsValidNumber(g_snapshots[i].adx_slope[TF_IDX_MAIN])) sr_has_adx_slope++;
      if(g_snapshots[i].ema_compression[TF_IDX_MAIN] > 0.0) sr_has_ema_comp++;
      if(g_snapshots[i].signal_clv >= 0.0)                   sr_has_signal_clv++;
      if(g_snapshots[i].signal_body_ratio >= 0.0)            sr_has_signal_body++;
      if(g_snapshots[i].mfe_money > 0.0)                     sr_has_mfe++;
      if(g_snapshots[i].mae_money > 0.0)                     sr_has_mae++;
   }
   Print("  StopFlag count:  ", sr_stop);
   Print("  TargetFlag count: ", sr_target);
   Print("  MaxStep1: ", sr_step[1],
         " | MaxStep2: ", sr_step[2],
         " | MaxStep3: ", sr_step[3],
         " | MaxStep4: ", sr_step[4],
         " | MaxStep5: ", sr_step[5]);
   Print("  PathClass — DEEP_STOP: ", sr_path_deep_stop,
         " | DEEP_TARGET: ", sr_path_deep_target,
         " | SAFE_TARGET: ", sr_path_safe_target,
         " | UNKNOWN: ", sr_path_unknown);
   double pct_pgm = (g_snapshot_count > 0) ? (sr_has_piv_gap_min * 100.0 / g_snapshot_count) : 0;
   double pct_ob  = (g_snapshot_count > 0) ? (sr_has_ob_dist * 100.0 / g_snapshot_count) : 0;
   double pct_atr = (g_snapshot_count > 0) ? (sr_has_atr_regime * 100.0 / g_snapshot_count) : 0;
   double pct_adx = (g_snapshot_count > 0) ? (sr_has_adx_slope * 100.0 / g_snapshot_count) : 0;
   double pct_ema = (g_snapshot_count > 0) ? (sr_has_ema_comp * 100.0 / g_snapshot_count) : 0;
   double pct_clv = (g_snapshot_count > 0) ? (sr_has_signal_clv * 100.0 / g_snapshot_count) : 0;
   double pct_bod = (g_snapshot_count > 0) ? (sr_has_signal_body * 100.0 / g_snapshot_count) : 0;
   double pct_mfe = (g_snapshot_count > 0) ? (sr_has_mfe * 100.0 / g_snapshot_count) : 0;
   double pct_mae = (g_snapshot_count > 0) ? (sr_has_mae * 100.0 / g_snapshot_count) : 0;
   Print("  Feature Coverage:");
   Print("    PivotGapMin:    ", sr_has_piv_gap_min, " (", DoubleToString(pct_pgm, 1), "%)");
   Print("    PivotGapMax:    ", sr_has_piv_gap_max, " (", DoubleToString((g_snapshot_count > 0 ? sr_has_piv_gap_max * 100.0 / g_snapshot_count : 0), 1), "%)");
   Print("    OB_DistPct:     ", sr_has_ob_dist, " (", DoubleToString(pct_ob, 1), "%)");
   Print("    ATR_Regime_M1:  ", sr_has_atr_regime, " (", DoubleToString(pct_atr, 1), "%)");
   Print("    ADX_Slope_M1:   ", sr_has_adx_slope, " (", DoubleToString(pct_adx, 1), "%)");
   Print("    EMA_Comp_M1:    ", sr_has_ema_comp, " (", DoubleToString(pct_ema, 1), "%)");
   Print("    Signal_CLV:     ", sr_has_signal_clv, " (", DoubleToString(pct_clv, 1), "%)");
   Print("    Signal_Body:    ", sr_has_signal_body, " (", DoubleToString(pct_bod, 1), "%)");
   Print("    MFE_Money>0:    ", sr_has_mfe, " (", DoubleToString(pct_mfe, 1), "%)");
   Print("    MAE_Money>0:    ", sr_has_mae, " (", DoubleToString(pct_mae, 1), "%)");
   // ===== بخش ۲: بررسی RiskLab data (از g_risklab_records) =====
   Print("--- RiskLab Data (g_risklab_records) ---");
   Print("  Total records: ", g_risklab_count);
   int rl_stop = 0, rl_target = 0;
   int rl_step3p = 0, rl_step4p = 0;
   int rl_safe = 0, rl_warn = 0, rl_danger = 0;
   int rl_dev = 0, rl_oos = 0;
   int rl_has_rsi_m1 = 0, rl_has_adx_h1 = 0, rl_has_atr_regime_m1 = 0;
   int rl_has_ema_comp_m1 = 0;
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].stop_flag)      rl_stop++;
      if(g_risklab_records[i].target_flag)    rl_target++;
      if(g_risklab_records[i].hit_step3_plus) rl_step3p++;
      if(g_risklab_records[i].hit_step4_plus) rl_step4p++;
      if(g_risklab_records[i].group3 == "SAFE")    rl_safe++;
      if(g_risklab_records[i].group3 == "WARNING") rl_warn++;
      if(g_risklab_records[i].group3 == "DANGER")  rl_danger++;
      if(g_risklab_records[i].is_oos) rl_oos++;
      else                            rl_dev++;
      if(g_risklab_records[i].rsi[TF_IDX_MAIN] > 0)             rl_has_rsi_m1++;
      if(g_risklab_records[i].adx[TF_IDX_H1] > 0)               rl_has_adx_h1++;
      if(g_risklab_records[i].atr_regime[TF_IDX_MAIN] > 0)      rl_has_atr_regime_m1++;
      if(g_risklab_records[i].ema_compression[TF_IDX_MAIN] > 0)  rl_has_ema_comp_m1++;
   }
   Print("  StopFlag:    ", rl_stop);
   Print("  TargetFlag:  ", rl_target);
   Print("  HitStep3+:   ", rl_step3p);
   Print("  HitStep4+:   ", rl_step4p);
   Print("  Group3 — SAFE: ", rl_safe, " | WARNING: ", rl_warn, " | DANGER: ", rl_danger);
   Print("  DEV: ", rl_dev, " | OOS: ", rl_oos);
   Print("  Feature Coverage:");
   Print("    RSI_M1:          ", rl_has_rsi_m1, " (", DoubleToString(g_risklab_count > 0 ? rl_has_rsi_m1 * 100.0 / g_risklab_count : 0, 1), "%)");
   Print("    ADX_H1:          ", rl_has_adx_h1, " (", DoubleToString(g_risklab_count > 0 ? rl_has_adx_h1 * 100.0 / g_risklab_count : 0, 1), "%)");
   Print("    ATR_Regime_M1:   ", rl_has_atr_regime_m1, " (", DoubleToString(g_risklab_count > 0 ? rl_has_atr_regime_m1 * 100.0 / g_risklab_count : 0, 1), "%)");
   Print("    EMA_Comp_M1:     ", rl_has_ema_comp_m1, " (", DoubleToString(g_risklab_count > 0 ? rl_has_ema_comp_m1 * 100.0 / g_risklab_count : 0, 1), "%)");
   // ===== بخش ۳: Cross-check =====
   Print("--- Cross-Check ---");
   bool match_total = (g_snapshot_count == g_risklab_count);
   bool match_stop  = (sr_stop == rl_stop);
   Print("  Snapshot count == RiskLab count: ", (match_total ? "✅ YES" : "❌ NO"),
         " (", g_snapshot_count, " vs ", g_risklab_count, ")");
   Print("  Stop count match:                ", (match_stop ? "✅ YES" : "❌ NO"),
         " (", sr_stop, " vs ", rl_stop, ")");
   // ===== بخش ۴: Research Group vs Snapshot cross-check =====
   Print("--- Research Groups vs Snapshot ---");
   int grp_step5     = g_rsch_groups[RSCH_G_STEP5].n;
   int grp_stop      = g_rsch_groups[RSCH_G_STOP].n;
   int grp_step4plus = g_rsch_groups[RSCH_G_STEP4PLUS].n;
   Print("  STEP5 group N:    ", grp_step5, " vs MaxStep5 count: ", sr_step[5],
         (grp_step5 == sr_step[5] ? " ✅" : " ❌"));
   Print("  STOP group N:     ", grp_stop, " vs StopFlag count: ", sr_stop,
         (grp_stop == sr_stop ? " ✅" : " ❌"));
   Print("  STEP4PLUS group N:", grp_step4plus, " vs (Step4+Step5): ", sr_step[4] + sr_step[5],
         (grp_step4plus == sr_step[4] + sr_step[5] ? " ✅" : " ❌"));
   // ===== بخش ۵: Warnings =====
   Print("--- Warnings ---");
   if(sr_stop == 0)
      Print("  ⚠ WARNING: No STOP trades found! Check dollar stop / close logic.");
   if(sr_path_unknown > g_snapshot_count * 0.1)
      Print("  ⚠ WARNING: ", sr_path_unknown, " trades have PathClass=UNKNOWN (",
            DoubleToString(sr_path_unknown * 100.0 / g_snapshot_count, 1), "%)");
   if(pct_atr < 80.0)
      Print("  ⚠ WARNING: ATR_Regime coverage is low: ", DoubleToString(pct_atr, 1), "%");
   if(pct_mfe < 50.0)
      Print("  ⚠ WARNING: MFE coverage is low: ", DoubleToString(pct_mfe, 1), "% — lifecycle tracking may be incomplete");
   if(pct_mae < 50.0)
      Print("  ⚠ WARNING: MAE coverage is low: ", DoubleToString(pct_mae, 1), "% — lifecycle tracking may be incomplete");
   if(!match_total)
      Print("  ❌ CRITICAL: Snapshot and RiskLab counts don't match! Data integrity issue.");
   if(sr_stop > 0 && !match_stop)
      Print("  ❌ CRITICAL: Stop counts don't match between Snapshot and RiskLab!");
   Print("=== SANITY CHECK DONE ===");
}
// ==================== INIT RESEARCH ====================
void RschInit()
{
   RschInitFeatureMeta(g_rsch_meta);
   ArrayResize(g_rsch_results, RSCH_MAX_FINAL_RESULTS);
   g_rsch_result_count = 0;
   ArrayResize(g_rsch_combos, RSCH_MAX_COMBO_RESULTS);
   g_rsch_combo_count = 0;
   ArrayResize(g_rsch_pairs, RSCH_MAX_PAIR_RESULTS);
   g_rsch_pair_count = 0;
   // OOS Validation arrays
   ArrayResize(g_oos_results, RSCH_MAX_OOS_RESULTS);
   g_oos_result_count = 0;
   g_oos_cutoff = 0;
   for(int i = 0; i < RSCH_MAX_FINAL_RESULTS; i++)
      g_rsch_results[i].Reset();
   for(int i = 0; i < RSCH_MAX_COMBO_RESULTS; i++)
      g_rsch_combos[i].Reset();
   for(int i = 0; i < RSCH_MAX_PAIR_RESULTS; i++)
      g_rsch_pairs[i].Reset();
   for(int i = 0; i < RSCH_MAX_OOS_RESULTS; i++)
      g_oos_results[i].Reset();
}
SEntrySnapshot   g_snapshots[];
int              g_snapshot_count = 0;
int g_snap_map_ids[];
int g_snap_map_idx[];
int g_snap_map_count = 0;
bool g_snap_map_dirty = true;
// ================================================================
// Local LCG Random Generator — independent of MQL5 global MathRand()
// Used exclusively for Bootstrap CI to avoid contaminating other
// code that relies on the global random state.
// ================================================================
uint g_lcg_state = 0;
void LCG_Seed(uint seed)
{
   g_lcg_state = (seed == 0) ? 1 : seed;
}
uint LCG_Next()
{
   // Parameters from Numerical Recipes (Knuth)
   g_lcg_state = g_lcg_state * 1664525u + 1013904223u;
   return g_lcg_state;
}
int LCG_RandInt(int n)
{
   if(n <= 1) return 0;
   return (int)((LCG_Next() >> 1) % (uint)n);
}
void SnapMap_Rebuild()
{
   g_snap_map_count = 0;
   int n = g_snapshot_count;
   if(n <= 0) return;
   ArrayResize(g_snap_map_ids, n);
   ArrayResize(g_snap_map_idx, n);
   for(int i = 0; i < n; i++)
   {
      g_snap_map_ids[i] = g_snapshots[i].setup_id;
      g_snap_map_idx[i] = i;
   }
   // Shell Sort by setup_id ascending
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp_id  = g_snap_map_ids[i];
         int tmp_idx = g_snap_map_idx[i];
         int j = i;
         while(j >= gap && g_snap_map_ids[j - gap] > tmp_id)
         {
            g_snap_map_ids[j] = g_snap_map_ids[j - gap];
            g_snap_map_idx[j] = g_snap_map_idx[j - gap];
            j -= gap;
         }
         g_snap_map_ids[j] = tmp_id;
         g_snap_map_idx[j] = tmp_idx;
      }
      gap /= 2;
   }
   g_snap_map_count = n;
}
// Binary search — O(log N)
int SnapMap_Find(int setup_id)
{
   if(g_snap_map_count <= 0) return -1;
   int lo = 0, hi = g_snap_map_count - 1;
   while(lo <= hi)
   {
      int mid = (lo + hi) / 2;
      if(g_snap_map_ids[mid] == setup_id) return g_snap_map_idx[mid];
      if(g_snap_map_ids[mid] < setup_id)  lo = mid + 1;
      else                                hi = mid - 1;
   }
   return -1;
}
int RL_FindSnapshotBySetupId_ForRL(int setup_id)
{
   int out_idx = -1;
   if(RL_GetSnapshotBySetupIdUnique(setup_id, out_idx))
      return out_idx;
   return -1;
}
