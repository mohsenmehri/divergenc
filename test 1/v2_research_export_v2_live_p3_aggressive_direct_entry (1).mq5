void LoadStats()
{
   string fn = "Stats_" + g_symbol_name + ".txt";
   //✅ این درسته - FILE_TXT استفاده کرده
   int h = FileOpen(fn, FILE_READ| FILE_TXT| FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      int eq = StringFind(line, "=");
      if(eq < 0) continue;
      string key = StringSubstr(line, 0, eq);
      string val = StringSubstr(line, eq + 1);
      StringTrimRight(val);
      if(key == "RowCount")
         g_row_cnt = (int)StringToInteger(val);
      else if(key == "HTMLRowCount")
         g_html_row_cnt = (int)StringToInteger(val);
      else if(key == "NextSetupID")
         g_next_setup_id = (int)StringToInteger(val);
      else if(StringFind(key, "Stat") == 0)
      {
         int idx = (int)StringToInteger(StringSubstr(key, 4));
         if(idx >= 0 && idx < 7)
            g_stats[idx] = (int)StringToInteger(val);
      }
   }
   FileClose(h);
   Print("Stats loaded: Row=", g_row_cnt, "| Opened=", g_stats[0]);
}
void LoadStatsFromCSV()
{
   string fn = inp_export_file_name + "_" + g_symbol_name + ".csv";
   int h = FileOpen(fn, FILE_READ| FILE_TXT| FILE_SHARE_READ| FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("No existing CSV. Starting fresh."); return; }
   int last_row = 0, total_opened = 0;
   int step_counts[5] = {0, 0, 0, 0, 0};
   if(!FileIsEnding(h)) FileReadString(h);
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(StringLen(line) < 5|| StringFind(line, "---") >= 0) continue;
      string parts[];
      int cnt = StringSplit(line, ',', parts);
      if(cnt < 14) continue;
      int rn = (int)StringToInteger(parts[0]);
      if(rn > last_row) last_row = rn;
      int op = (int)StringToInteger(parts[1]);
      if(op > total_opened) total_opened = op;
      string evt = parts[10];
      if(StringFind(evt, "CLOSE") < 0 && StringFind(evt, "STOP") < 0 &&
         StringFind(evt, "CL_") < 0 && StringFind(evt, "SL") < 0) continue;
      string tf_name = parts[13];
      StringTrimLeft(tf_name); StringTrimRight(tf_name);
      if(tf_name != g_tf[0].name) continue;
      int step = (int)StringToInteger(parts[9]);
      if(step != 1) continue;
      int mg_step = (int)StringToInteger(parts[8]);
      if(mg_step >= 1 && mg_step <= 5) step_counts[mg_step - 1]++;
   }
   FileClose(h);
   if(last_row > g_row_cnt) g_row_cnt = last_row;
   if(total_opened > g_stats[0]) g_stats[0] = total_opened;
   int csv_closed = 0;
   for(int i = 0; i < 5; i++) {
      csv_closed += step_counts[i];
      g_stats[i + 2] = MathMax(g_stats[i + 2], step_counts[i]);
   }
   if(csv_closed > g_stats[1]) g_stats[1] = csv_closed;
   Print("CSV loaded: Row=", g_row_cnt, "| Opened=", g_stats[0], "| Closed=", g_stats[1]);
}
void LoadHTMLRowCounter()
{
   string fn = inp_export_file_name + "_" + g_symbol_name + ".html";
   if(!FileIsExist(fn, FILE_COMMON)) { g_html_row_cnt = 0; return; }
   int h = FileOpen(fn, FILE_READ| FILE_TXT| FILE_SHARE_READ| FILE_COMMON);
   if(h == INVALID_HANDLE) { g_html_row_cnt = 0; return; }
   int max_row = 0;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      int pos = StringFind(line, "<tr><td>");
      if(pos >= 0) {
         int start = pos + 8;
         int end = StringFind(line, "</td>", start);
         if(end > start) {
            int rn = (int)StringToInteger(StringSubstr(line, start, end - start));
            if(rn > max_row) max_row = rn;
         }
      }
   }
   FileClose(h);
   g_html_row_cnt = max_row;
   Print("HTML Row Counter: ", g_html_row_cnt);
}
int BinarySearchInt(int &arr[], int count, int value)
{
   int lo = 0, hi = count - 1;
   while(lo <= hi)
   {
      int mid = (lo + hi) / 2;
      if(arr[mid] == value) return mid;
      if(arr[mid] < value) lo = mid + 1;
      else hi = mid - 1;
   }
   return -(lo + 1); // Not found, return insertion point (negative)
}
void InsertSortedInt(int &arr[], int &count, int value, int max_size)
{
   if(count >= max_size) return;
   // پیدا کردن جای درج
   int pos = 0;
   while(pos < count && arr[pos] < value) pos++;
   // شیفت دادن
   for(int i = count; i > pos; i--)
      arr[i] = arr[i-1];
   arr[pos] = value;
   count++;
}
//|Load Analysis From CSV - OPTIMIZED|
void LoadAnalysisFromCSV()
{
   string fn = inp_export_file_name + "_" + g_symbol_name + ".csv";
   int h = FileOpen(fn, FILE_READ|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("No CSV file found.");
      return;
   }
   Print("Loading analysis from CSV...");
   if(!FileIsEnding(h))
      FileReadString(h); // skip header
   int processed_ids[];
   ArrayResize(processed_ids, 1000);
   int processed_count = 0;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(StringLen(line) < 20) continue;
      if(StringFind(line, "---") >= 0) continue;
      string parts[];
      int cnt = StringSplit(line, ',', parts);
      if(cnt < 25) continue;
      int setup_id = (int)StringToInteger(parts[1]);
      int max_step = (int)StringToInteger(parts[8]);
      double profit = StringToDouble(parts[24]);
      string evt = parts[10];
      string sig = parts[11];
      bool is_bull = (sig == "BUY");
      // Binary Search dedup
      int search_result = BinarySearchInt(processed_ids, processed_count, setup_id);
      if(search_result >= 0)
         continue;
      // Insert sorted
      if(processed_count >= ArraySize(processed_ids))
         ArrayResize(processed_ids, processed_count + 500);
      InsertSortedInt(processed_ids, processed_count, setup_id, ArraySize(processed_ids));
      int si = max_step - 1;
      if(si >= 0 && si < 5)
      {
         g_step_close_count[si]++;
         g_step_close_profit[si] += profit;
         if(profit > 0) g_step_close_wins[si]++;
      }
   }
   FileClose(h);
   ArrayFree(processed_ids);
   Print("CSV analysis loaded.");
}
void FillAndStoreMTFPattern(
   SMTFAnalysisStats &mtf_stats,    // g_mtf_buy یا g_mtf_sell
   int setup_id,
   datetime entry_time,
   datetime exit_time,
   bool is_bullish,
   int max_step,
   double profit,
   string close_evt,
   int piv1, int piv2,
   // Per-TF data arrays:
   double &rsi[], double &adx[], double &cci[], double &atr[],
   string &di[], string &ema[], string &pos[],
   bool &valid[])
{
   if(setup_id <= 0 || max_step < 1 || max_step > 5) return;
   // Check at least one valid TF
   bool has_valid = false;
   for(int i = 0; i < TF_COUNT; i++)
      if(valid[i]) { has_valid = true; break; }
   if(!has_valid) return;
   // Capacity management
   if(mtf_stats.pattern_count >= MAX_MTF_PATTERNS)
   {
      for(int i = 0; i < MAX_MTF_PATTERNS - 1; i++)
         mtf_stats.patterns[i] = mtf_stats.patterns[i + 1];
      mtf_stats.pattern_count = MAX_MTF_PATTERNS - 1;
   }
   int idx = mtf_stats.pattern_count;
   if(idx < 0) idx = 0;
   if(idx >= MAX_MTF_PATTERNS) return;
   mtf_stats.patterns[idx].Reset();
   mtf_stats.patterns[idx].pattern_id       = setup_id;
   mtf_stats.patterns[idx].entry_time       = entry_time;
   mtf_stats.patterns[idx].exit_time        = exit_time;
   mtf_stats.patterns[idx].is_bullish       = is_bullish;
   mtf_stats.patterns[idx].max_step_reached = max_step;
   mtf_stats.patterns[idx].profit           = profit;
   mtf_stats.patterns[idx].is_win           = (profit > 0);
   mtf_stats.patterns[idx].close_event      = NormalizeEventString(close_evt);
   mtf_stats.patterns[idx].pivot1_dist      = piv1;
   mtf_stats.patterns[idx].pivot2_dist      = piv2;
   // Fill TF data
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      if(!valid[tf]) continue;
      if(rsi[tf] >= 0 && rsi[tf] <= 100)
         mtf_stats.patterns[idx].rsi_range[tf] = ((int)MathFloor(rsi[tf] / 5.0)) * 5;
      else
         mtf_stats.patterns[idx].rsi_range[tf] = -1;
      if(adx[tf] >= 0 && adx[tf] <= 100)
         mtf_stats.patterns[idx].adx_range[tf] = ((int)MathFloor(adx[tf] / 5.0)) * 5;
      else
         mtf_stats.patterns[idx].adx_range[tf] = -1;
      mtf_stats.patterns[idx].cci_range[tf]       = ((int)MathFloor(cci[tf] / 25.0)) * 25;
      mtf_stats.patterns[idx].atr_value[tf]       = atr[tf];
      mtf_stats.patterns[idx].di_status[tf]       = di[tf];
      mtf_stats.patterns[idx].ema_order[tf]       = ema[tf];
      mtf_stats.patterns[idx].position_status[tf] = pos[tf];
   }
   // Build signatures & stability
   mtf_stats.patterns[idx].BuildRSISignature();
   mtf_stats.patterns[idx].BuildDISignature();
   mtf_stats.patterns[idx].BuildCompositeSignature();
   mtf_stats.patterns[idx].stability = CalculateEnhancedStability(mtf_stats.patterns[idx]);
   // Update stability distribution
   int stab_idx = mtf_stats.patterns[idx].stability.GetTotal() / 10;
   stab_idx = MathMax(0, MathMin(10, stab_idx));
   mtf_stats.stability_distribution[stab_idx]++;
   mtf_stats.stability_profits[stab_idx] += profit;
   if(profit > 0) mtf_stats.stability_wins[stab_idx]++;
   mtf_stats.stability_step_sum[stab_idx] += max_step;
   // Aggregate signatures
   AggregateMTFSignature(mtf_stats.rsi_signatures, mtf_stats.rsi_sig_count,
      mtf_stats.patterns[idx].rsi_signature, max_step, profit, profit > 0);
   AggregateMTFSignature(mtf_stats.di_signatures, mtf_stats.di_sig_count,
      mtf_stats.patterns[idx].di_signature, max_step, profit, profit > 0);
   AggregateMTFSignature(mtf_stats.composite_signatures, mtf_stats.composite_sig_count,
      mtf_stats.patterns[idx].composite_signature, max_step, profit, profit > 0);
   mtf_stats.pattern_count++;
   mtf_stats.pattern_count = MathMin(mtf_stats.pattern_count, MAX_MTF_PATTERNS);
}
//| RecordMTFPattern - SIMPLIFIED (uses shared logic)                |
void RecordMTFPattern(int setup_id, int max_step, bool is_bull,
                      double profit, string close_evt)
{
   if(g_step[0].step_time == 0) return;
   if(max_step < 1 || max_step > 5) return;
   double rsi[TF_COUNT], adx[TF_COUNT], cci[TF_COUNT], atr[TF_COUNT];
   string di[TF_COUNT], ema[TF_COUNT], pos[TF_COUNT];
   bool valid[TF_COUNT];
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      valid[tf] = g_step[0].is_valid[tf];
      if(!valid[tf]) continue;
      rsi[tf] = g_step[0].rsi_value[tf];
      adx[tf] = g_step[0].adx_value[tf];
      cci[tf] = g_step[0].cci_value[tf];
      atr[tf] = g_step[0].atr_value[tf];
      di[tf]  = g_step[0].di_status[tf];
      ema[tf] = g_step[0].ema_order[tf];
      pos[tf] = g_step[0].position_status[tf];
   }
   if(is_bull)
   {
      FillAndStoreMTFPattern(
         g_mtf_buy,
         setup_id,
         g_pos_open_time,
         TimeCurrent(),
         true,
         max_step,
         profit,
         close_evt,
         g_piv1_dist,
         g_piv2_dist,
         rsi, adx, cci, atr, di, ema, pos, valid
      );
   }
   else
   {
      FillAndStoreMTFPattern(
         g_mtf_sell,
         setup_id,
         g_pos_open_time,
         TimeCurrent(),
         false,
         max_step,
         profit,
         close_evt,
         g_piv1_dist,
         g_piv2_dist,
         rsi, adx, cci, atr, di, ema, pos, valid
      );
   }
}
void BuildMTFPatternFromCSV(int setup_id, int max_step, bool is_bull,
                            double profit, string evt,
                            int piv1, int piv2,
                            double &rsi[], double &adx[], double &cci[], double &atr[],
                            string &di[], string &ema[], string &pos[], bool &valid[])
{
   if(is_bull)
   {
      FillAndStoreMTFPattern(
         g_mtf_buy,
         setup_id,
         0,
         0,
         true,
         max_step,
         profit,
         evt,
         piv1,
         piv2,
         rsi, adx, cci, atr, di, ema, pos, valid
      );
   }
   else
   {
      FillAndStoreMTFPattern(
         g_mtf_sell,
         setup_id,
         0,
         0,
         false,
         max_step,
         profit,
         evt,
         piv1,
         piv2,
         rsi, adx, cci, atr, di, ema, pos, valid
      );
   }
}
