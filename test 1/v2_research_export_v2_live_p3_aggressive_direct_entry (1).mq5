         ema200_dist_atr[tf] = 0.0;
         di_status[tf] = "";
         ema_order[tf] = "";
         position_status[tf] = "";
         trend_regime[tf] = "";
         price_above_ema200[tf] = false;
         macd_main[tf] = macd_signal[tf] = macd_hist[tf] = 0.0;
