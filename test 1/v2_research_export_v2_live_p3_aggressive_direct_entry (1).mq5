// StopFlag D2024 independent Phase B — three-fold OOF threshold
// ================================================================
bool g_s2b_stop_d2024_pre_guard=false,g_s2b_stop_d2024_post_guard=false,g_s2b_stop_d2024_context_lock=false,g_s2b_stop_d2024_threshold_executed=false;
string g_s2b_stop_d2024_mismatches="",g_s2b_stop_d2024_actual_candidate_hash="",g_s2b_stop_d2024_actual_feature_list="";
int g_s2b_stop_d2024_actual_feature_count=0,g_s2b_stop_d2024_actual_oof_n=0,g_s2b_stop_d2024_actual_oof_stop_n=0,g_s2b_stop_d2024_actual_fold_count=0;
void S2B_StopD2024_AddMismatch(string x){if(StringLen(g_s2b_stop_d2024_mismatches)>0)g_s2b_stop_d2024_mismatches+="|";g_s2b_stop_d2024_mismatches+=x;}
string S2B_StopD2024_Match(bool x){return x?"MATCH":"MISMATCH";}
bool S2B_StopD2024_PreOOFGuard()
{
 g_s2b_stop_d2024_pre_guard=false;g_s2b_stop_d2024_context_lock=false;g_s2b_stop_d2024_mismatches="";int fi[];g_s2b_stop_d2024_actual_feature_count=S2B_ResolveLockedStopFeatures(fi);g_s2b_stop_d2024_actual_candidate_hash=S2B_BuildFeatureHash(fi,g_s2b_stop_d2024_actual_feature_count);g_s2b_stop_d2024_actual_feature_list=S2B_BuildFeatureListString(fi,g_s2b_stop_d2024_actual_feature_count);ArrayFree(fi);
 if(g_s2b_stop_d2024_protocol.dataset_hash!=S2B_STOP_D2024_EXPECT_DATASET_HASH)S2B_StopD2024_AddMismatch("DatasetHash");
 if(g_s2b_stop_d2024_protocol.feature_matrix_hash!=S2B_STOP_D2024_EXPECT_FEATURE_HASH)S2B_StopD2024_AddMismatch("FeatureMatrixHash");
 if(g_s2b_stop_d2024_protocol.row_mask_hash!=S2B_STOP_D2024_EXPECT_ROWMASK_HASH)S2B_StopD2024_AddMismatch("RowMaskHash");
 if(g_s2b_stop_d2024_protocol.fold_hash!=S2B_STOP_D2024_EXPECT_FOLD_HASH)S2B_StopD2024_AddMismatch("FoldHash");
 if(g_s2b_stop_d2024_protocol.protocol_hash!=S2B_STOP_D2024_EXPECT_PROTOCOL_HASH)S2B_StopD2024_AddMismatch("ProtocolHash");
 if(g_s2b_stop_d2024_context.evaluation_context_hash!=S2B_STOP_D2024_EXPECT_CONTEXT_HASH)S2B_StopD2024_AddMismatch("ContextHash");
 if(g_s2b_stop_d2024_context.eligible_count!=S2B_STOP_D2024_EXPECT_ELIGIBLE)S2B_StopD2024_AddMismatch("EligibleCount");
 if(g_s2b_stop_d2024_context.positive_count!=S2B_STOP_D2024_EXPECT_STOP_POS)S2B_StopD2024_AddMismatch("StopPositives");
 if(g_s2b_stop_d2024_actual_candidate_hash!=S2B_STOP_D2024_EXPECT_CANDIDATE_HASH)S2B_StopD2024_AddMismatch("CandidateHash");
 if(g_s2b_stop_d2024_actual_feature_count!=S2B_STOP_D2024_EXPECT_FEATURE_COUNT)S2B_StopD2024_AddMismatch("CandidateFeatureCount");
 if(g_s2b_stop_d2024_actual_feature_list!=S2B_STOP_D2024_EXPECT_FEATURE_LIST)S2B_StopD2024_AddMismatch("CandidateFeatureList");
 g_s2b_stop_d2024_pre_guard=(StringLen(g_s2b_stop_d2024_mismatches)==0);g_s2b_stop_d2024_context_lock=g_s2b_stop_d2024_pre_guard;
 Print("STOP_D2024_PHASEB_CONTEXT_GUARD_PRE|",(g_s2b_stop_d2024_pre_guard?"PASS":"FAIL"),"|Mismatches=",g_s2b_stop_d2024_mismatches);return g_s2b_stop_d2024_pre_guard;
}
bool S2B_StopD2024_PostOOFGuard()
{
 g_s2b_stop_d2024_actual_oof_n=g_s2b_stop_oof_count;g_s2b_stop_d2024_actual_oof_stop_n=0;for(int i=0;i<g_s2b_stop_oof_count;i++)if(g_s2b_stop_oof[i].stop_label==1)g_s2b_stop_d2024_actual_oof_stop_n++;g_s2b_stop_d2024_actual_fold_count=g_s2b_stop_oof_fold_count;
 if(g_s2b_stop_d2024_actual_oof_n!=S2B_STOP_D2024_EXPECT_OOF_N)S2B_StopD2024_AddMismatch("OOF_N");if(g_s2b_stop_d2024_actual_oof_stop_n!=S2B_STOP_D2024_EXPECT_OOF_STOP_N)S2B_StopD2024_AddMismatch("OOF_Stop_N");if(g_s2b_stop_d2024_actual_fold_count!=S2B_STOP_D2024_EXPECT_FOLD_COUNT)S2B_StopD2024_AddMismatch("FoldCount");
 g_s2b_stop_d2024_post_guard=(StringLen(g_s2b_stop_d2024_mismatches)==0);g_s2b_stop_d2024_context_lock=(g_s2b_stop_d2024_pre_guard&&g_s2b_stop_d2024_post_guard);Print("STOP_D2024_PHASEB_CONTEXT_GUARD_POST|",(g_s2b_stop_d2024_post_guard?"PASS":"FAIL"),"|OOF_N=",g_s2b_stop_d2024_actual_oof_n,"|OOF_Stop_N=",g_s2b_stop_d2024_actual_oof_stop_n,"|FoldCount=",g_s2b_stop_d2024_actual_fold_count,"|ThresholdEngineExecuted=NO|Mismatches=",g_s2b_stop_d2024_mismatches);return g_s2b_stop_d2024_post_guard;
}
bool S2B_StopD2024_BuildOOF()
{
   g_s2b_stop_oof_valid = false;
   g_s2b_stop_oof_block_reason = "";
   g_s2b_stop_oof_count = 0;
   g_s2b_stop_oof_fold_count = 0;
   ArrayResize(g_s2b_stop_oof, 0);
   if(!g_s2b_stop_d2024_context.valid)
   {
      g_s2b_stop_oof_block_reason = "STOP_CONTEXT_INVALID";
      return false;
   }
   if(g_s2b_stop_d2024_fold_count != S2B_STOP_D2024_EXPECT_FOLD_COUNT)
   {
      g_s2b_stop_oof_block_reason = "FOLD_COUNT_LT_2";
      return false;
   }
   int feat_idx[];
   int n_feat = S2B_ResolveLockedStopFeatures(feat_idx);
   string fhash = S2B_BuildFeatureHash(feat_idx, n_feat);
   if(fhash != S2B_STOP_LOCKED_FEATURE_HASH)
   {
      g_s2b_stop_oof_block_reason = "LOCKED_FEATURE_HASH_MISMATCH|computed=" + fhash +
                                    "|expected=" + S2B_STOP_LOCKED_FEATURE_HASH;
      return false;
   }
   datetime dev_hard_limit = StringToTime("2024.01.01");
   for(int f = 0; f < g_s2b_stop_d2024_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(!g_s2b_stop_d2024_folds[f].is_primary)
         continue;
      if(g_s2b_stop_d2024_folds[f].train_to > dev_hard_limit || g_s2b_stop_d2024_folds[f].val_to > dev_hard_limit)
      {
         g_s2b_stop_oof_block_reason = "FOLD_WINDOW_EXCEEDS_DEV|" + g_s2b_stop_d2024_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      int train_rows[];
      int val_rows[];
      int n_tr = S2B_StopD2024_CollectMaskedRows(g_s2b_stop_d2024_folds[f].train_from, g_s2b_stop_d2024_folds[f].train_to, train_rows);
      int n_va = S2B_StopD2024_CollectMaskedRows(g_s2b_stop_d2024_folds[f].val_from,   g_s2b_stop_d2024_folds[f].val_to,   val_rows);
      if(n_tr < 50 || n_va < 20)
      {
         g_s2b_stop_oof_block_reason = StringFormat("FOLD_ROWCOUNT_TOO_SMALL|%s|train=%d|val=%d",
                                                    g_s2b_stop_d2024_folds[f].name, n_tr, n_va);
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      SStage2B_ModelParams mdl;
      if(!S2B_StopD2024_TrainValidated(feat_idx, n_feat, train_rows, n_tr, mdl))
      {
         g_s2b_stop_oof_block_reason = "FOLD_TRAIN_FAILED|" + g_s2b_stop_d2024_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      string row_guard_reason = "";
      if(!S2B_StopD2024_ValidateRowSetDevelopmentOnly(train_rows,n_tr,g_s2b_stop_d2024_folds[f].train_from,g_s2b_stop_d2024_folds[f].train_to,"PHASEB_FOLD_TRAIN",row_guard_reason) ||
         !S2B_StopD2024_ValidateRowSetDevelopmentOnly(val_rows,n_va,g_s2b_stop_d2024_folds[f].val_from,g_s2b_stop_d2024_folds[f].val_to,"PHASEB_FOLD_VALIDATION",row_guard_reason))
      {
         g_s2b_stop_oof_block_reason = row_guard_reason;
         ArrayResize(g_s2b_stop_oof,0); g_s2b_stop_oof_count=0;
         return false;
      }
      double probs[];
      int recs[];
      int n_scored = 0;
      if(!S2B_ScoreModel_OnRows_Stop(mdl, val_rows, n_va, probs, recs, n_scored))
      {
         g_s2b_stop_oof_block_reason = "FOLD_SCORE_FAILED|" + g_s2b_stop_d2024_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      int base = g_s2b_stop_oof_count;
      ArrayResize(g_s2b_stop_oof, base + n_scored);
      for(int i = 0; i < n_scored; i++)
      {
         int rec_idx = recs[i];
         SS2BStopOOFRow r;
         r.Reset();
         r.rec_idx    = rec_idx;
         r.fold_idx   = f;
         r.entry_time = g_risklab_records[rec_idx].entry_time;
         r.prob       = probs[i];
         r.stop_label = S2B_GetStopTargetAligned(rec_idx);
         r.step4plus  = (g_risklab_records[rec_idx].hit_step4_plus ? 1 : 0);
         r.target_flag= (g_risklab_records[rec_idx].target_flag ? 1 : 0);
         r.neutral_outcome = ((r.stop_label == 0 && r.target_flag == 0) ? 1 : 0);
         r.pnl        = g_risklab_records[rec_idx].pnl;
         g_s2b_stop_oof[base + i] = r;
      }
      g_s2b_stop_oof_count = base + n_scored;
      g_s2b_stop_oof_fold_count++;
   }
   if(g_s2b_stop_oof_count < 100 || g_s2b_stop_oof_fold_count != S2B_STOP_D2024_EXPECT_FOLD_COUNT)
   {
      g_s2b_stop_oof_block_reason = StringFormat("OOF_TOO_SMALL|rows=%d|folds=%d",
                                                 g_s2b_stop_oof_count, g_s2b_stop_oof_fold_count);
      return false;
   }
   // Invariant 1: OOF disjointness - a record may be scored at most once.
   for(int a = 0; a < g_s2b_stop_oof_count; a++)
   {
      for(int b = a + 1; b < g_s2b_stop_oof_count; b++)
      {
         if(g_s2b_stop_oof[a].rec_idx == g_s2b_stop_oof[b].rec_idx)
         {
            g_s2b_stop_oof_block_reason = StringFormat("OOF_OVERLAP_VIOLATION|rec=%d",
                                                       g_s2b_stop_oof[a].rec_idx);
            return false;
         }
      }
   }
   // Invariant 2: no OOF row may fall on or after 2024.01.01.
   for(int c = 0; c < g_s2b_stop_oof_count; c++)
   {
      if(g_s2b_stop_oof[c].entry_time >= dev_hard_limit)
      {
         g_s2b_stop_oof_block_reason = StringFormat("OOF_WINDOW_VIOLATION|rec=%d|time=%s",
                                                    g_s2b_stop_oof[c].rec_idx,
                                                    TimeToString(g_s2b_stop_oof[c].entry_time, TIME_DATE));
         return false;
      }
   }
   // Per-fold percentile ranks (PRIMARY basis for Gate + Selection).
   for(int f2 = 0; f2 < S2B_MAX_FOLDS; f2++)
   {
      int fidx[];
      int fn = 0;
      ArrayResize(fidx, g_s2b_stop_oof_count);
      for(int i = 0; i < g_s2b_stop_oof_count; i++)
      {
         if(g_s2b_stop_oof[i].fold_idx == f2)
         {
            fidx[fn] = i;
            fn++;
         }
      }
      if(fn <= 0) continue;
      ArrayResize(fidx, fn);
      S2B_PhaseBSortIdxByProbThenRec(fidx, fn);
      for(int p = 0; p < fn; p++)
         g_s2b_stop_oof[fidx[p]].pct_rank = (double)(p + 1) / (double)fn;
   }
   // Pooled ranks (INFORMATIONAL only).
   int pidx[];
   ArrayResize(pidx, g_s2b_stop_oof_count);
   for(int i2 = 0; i2 < g_s2b_stop_oof_count; i2++)
      pidx[i2] = i2;
   S2B_PhaseBSortIdxByProbThenRec(pidx, g_s2b_stop_oof_count);
   for(int p2 = 0; p2 < g_s2b_stop_oof_count; p2++)
      g_s2b_stop_oof[pidx[p2]].pooled_rank = (double)(p2 + 1) / (double)g_s2b_stop_oof_count;
   g_s2b_stop_oof_valid = true;
   int tot_stop = 0, tot_s4 = 0, tot_tg = 0, tot_neu = 0;
   for(int i3 = 0; i3 < g_s2b_stop_oof_count; i3++)
   {
      if(g_s2b_stop_oof[i3].stop_label == 1) tot_stop++;
      if(g_s2b_stop_oof[i3].step4plus == 1) tot_s4++;
      if(g_s2b_stop_oof[i3].target_flag == 1) tot_tg++;
      if(g_s2b_stop_oof[i3].neutral_outcome == 1) tot_neu++;
   }
   Print("STOP_PHASEB_OOF|PASS",
         "|FeatureHash=", fhash,
         "|Folds=", g_s2b_stop_oof_fold_count,
         "|OOF_N=", g_s2b_stop_oof_count,
         "|StopN=", tot_stop,
         "|Step4PlusN=", tot_s4,
         "|TargetN=", tot_tg,
         "|NeutralN=", tot_neu,
         "|WindowMax=2023.12.31");
   return true;
}
void S2B_StopD2024_ExportThresholdTradeoff()
{
   string fn = "Stage2B_Stop_D2024_PhaseB_ThresholdTradeoff_" + _Symbol + ".csv";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("STOP_PHASEB_EXPORT|FAIL|File=", fn); return; }
   string header = "PhaseBVersion,CandidateLockVersion,GateVersion,FeatureHash,CurrentCycleStatus,CurrentResultStatus,ScaleBasis,TargetRejectionPct,PercentileCut,";
   header += "OOF_N,OOF_Stop_N,OOF_Prevalence,Rejected_N,Accepted_N,RejectionRatePct,CoveragePct,";
   header += "StopCaptured_N,StopCapturedPct,StopRemaining_N,StopRemainingRatePct,";
   header += "Step4Total_N,Step4Rejected_N,Step4LostPct,TargetTotal_N,TargetRejected_N,TargetLostPct,NeutralOutcomeN,";
   header += "Precision,Recall,MCC,F1,F2,PnLBefore,PnLAfter,ExpectancyBefore,ExpectancyAfter,ExpectancyDelta,";
   header += "PFBefore,PFBeforeDefined,PFAfter,PFAfterDefined,LowPositiveSample,GatePass,GateFailReason,PolicyRank,";
   header += "PooledCutProbability_InfoOnly,PooledRejected_N,PooledRejectionRatePct,PooledStopCaptured_N,PooledStopCapturedPct,";
   header += "CIValid,CIIterations,CI_StopCapture_Lo,CI_StopCapture_Hi,CI_Step4Lost_Lo,CI_Step4Lost_Hi,";
   header += "CI_TargetLost_Lo,CI_TargetLost_Hi,CI_Rejection_Lo,CI_Rejection_Hi,CI_ExpectancyAfter_Lo,CI_ExpectancyAfter_Hi,";
   header += "Fold1CutProb,Fold1N,Fold1StopN,Fold1RejectedN,Fold1RejectionPct,Fold1StopCapturedN,Fold1StopCapturedPct,Fold1Step4Total,Fold1Step4Rejected,Fold1TargetTotal,Fold1TargetRejected,Fold1ExpBefore,Fold1ExpAfter,";
   header += "Fold2CutProb,Fold2N,Fold2StopN,Fold2RejectedN,Fold2RejectionPct,Fold2StopCapturedN,Fold2StopCapturedPct,Fold2Step4Total,Fold2Step4Rejected,Fold2TargetTotal,Fold2TargetRejected,Fold2ExpBefore,Fold2ExpAfter,";
   header += "Fold3CutProb,Fold3N,Fold3StopN,Fold3RejectedN,Fold3RejectionPct,Fold3StopCapturedN,Fold3StopCapturedPct,Fold3Step4Total,Fold3Step4Rejected,Fold3TargetTotal,Fold3TargetRejected,Fold3ExpBefore,Fold3ExpAfter\n";
   FileWriteString(h, header);
   for(int i = 0; i < g_s2b_stop_thr_row_count; i++)
   {
      SS2BStopThresholdRow r = g_s2b_stop_thr_rows[i];
      string s = S2B_STOP_D2024_PHASEB_VERSION + "," + S2B_STOP_D2024_LOCK_VERSION + "," +
                 S2B_STOP_THRESHOLD_GATE_VERSION + "," + S2B_STOP_D2024_EXPECT_CANDIDATE_HASH +
                 ",STOPFLAG_DEV2018_2023_HOLDOUT2024_2026_v1,PROVISIONAL_DEVELOPMENT_AWARE,PER_FOLD_PERCENTILE_PRIMARY,";
      s += S2B_PhaseBCsvDouble(r.target_rejection_pct,2) + "," + S2B_PhaseBCsvDouble(100.0-r.target_rejection_pct,2) + ",";
      s += IntegerToString(r.oof_n)+","+IntegerToString(r.oof_stop_n)+","+S2B_PhaseBCsvDouble(r.oof_prevalence,8)+","+IntegerToString(r.rejected_n)+","+IntegerToString(r.accepted_n)+","+S2B_PhaseBCsvDouble(r.rejection_rate_pct,6)+","+S2B_PhaseBCsvDouble(r.coverage_pct,6)+",";
      s += IntegerToString(r.stop_captured_n)+","+S2B_PhaseBCsvDouble(r.stop_captured_pct,6)+","+IntegerToString(r.stop_remaining_n)+","+S2B_PhaseBCsvDouble(r.stop_remaining_rate_pct,6)+",";
      s += IntegerToString(r.step4_total_n)+","+IntegerToString(r.step4_rejected_n)+","+S2B_PhaseBCsvDouble(r.step4_lost_pct,6)+","+IntegerToString(r.target_total_n)+","+IntegerToString(r.target_rejected_n)+","+S2B_PhaseBCsvDouble(r.target_lost_pct,6)+","+IntegerToString(r.neutral_outcome_n)+",";
      s += S2B_PhaseBCsvDouble(r.precision,8)+","+S2B_PhaseBCsvDouble(r.recall,8)+","+S2B_PhaseBCsvDouble(r.mcc,8)+","+S2B_PhaseBCsvDouble(r.f1,8)+","+S2B_PhaseBCsvDouble(r.f2,8)+",";
      s += S2B_PhaseBCsvDouble(r.pnl_before,8)+","+S2B_PhaseBCsvDouble(r.pnl_after,8)+","+S2B_PhaseBCsvDouble(r.expectancy_before,8)+","+S2B_PhaseBCsvDouble(r.expectancy_after,8)+","+S2B_PhaseBCsvDouble(r.expectancy_delta,8)+",";
      s += S2B_PhaseBCsvDouble(r.pf_before,8)+","+IntegerToString(r.pf_before_defined)+","+S2B_PhaseBCsvDouble(r.pf_after,8)+","+IntegerToString(r.pf_after_defined)+","+(r.low_positive_sample==1?"YES":"NO")+","+(r.gate_pass==1?"PASS":"FAIL")+","+r.gate_fail_reason+","+IntegerToString(r.policy_rank)+",";
      s += S2B_PhaseBCsvDouble(r.pooled_cut_prob,10)+","+IntegerToString(r.pooled_rejected_n)+","+S2B_PhaseBCsvDouble(r.pooled_rejection_rate_pct,6)+","+IntegerToString(r.pooled_stop_captured_n)+","+S2B_PhaseBCsvDouble(r.pooled_stop_captured_pct,6)+",";
      s += IntegerToString(r.ci_valid)+","+IntegerToString(r.ci_iterations)+","+S2B_PhaseBCsvDouble(r.ci_stop_capture_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_stop_capture_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_step4_lost_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_step4_lost_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_target_lost_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_target_lost_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_rejection_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_rejection_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_expectancy_after_lo,8)+","+S2B_PhaseBCsvDouble(r.ci_expectancy_after_hi,8)+",";
      for(int f = 0; f < 3; f++)
      {
         s += S2B_PhaseBCsvDouble(r.fold_cut_prob[f],10)+","+IntegerToString(r.fold_oof_n[f])+","+IntegerToString(r.fold_stop_n[f])+","+IntegerToString(r.fold_rejected_n[f])+","+S2B_PhaseBCsvDouble(r.fold_rejection_rate_pct[f],6)+","+IntegerToString(r.fold_stop_captured_n[f])+","+S2B_PhaseBCsvDouble(r.fold_stop_captured_pct[f],6)+","+IntegerToString(r.fold_step4_total_n[f])+","+IntegerToString(r.fold_step4_rejected_n[f])+","+IntegerToString(r.fold_target_total_n[f])+","+IntegerToString(r.fold_target_rejected_n[f])+","+S2B_PhaseBCsvDouble(r.fold_expectancy_before[f],8)+","+S2B_PhaseBCsvDouble(r.fold_expectancy_after[f],8);
         if(f < 2) s += ",";
      }
      FileWriteString(h, s + "\n");
   }
   FileFlush(h); FileClose(h);
   Print("STOP_PHASEB_TRADEOFF_REPORT|", fn);
}
void S2B_StopD2024_ExportThresholdLock()
{
 string fn="Stage2B_Stop_D2024_PhaseB_ThresholdLock_"+_Symbol+".txt";int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE)return;
 FileWriteString(h,"STOPFLAG D2024 PHASE B THREE-FOLD THRESHOLD LOCK\nCycleId="+S2B_STOP_D2024_CYCLE_ID+"\nPhaseBVersion="+S2B_STOP_D2024_PHASEB_VERSION+"\nCandidateLockVersion="+S2B_STOP_D2024_LOCK_VERSION+"\nGateVersion="+S2B_STOP_THRESHOLD_GATE_VERSION+"\n");
 FileWriteString(h,"PreOOFGuardPass="+string(g_s2b_stop_d2024_pre_guard?"YES":"NO")+"\nPostOOFGuardPass="+string(g_s2b_stop_d2024_post_guard?"YES":"NO")+"\nContextLockPass="+string(g_s2b_stop_d2024_context_lock?"YES":"NO")+"\nMismatchFields="+g_s2b_stop_d2024_mismatches+"\n");
 FileWriteString(h,"DatasetHash Expected="+S2B_STOP_D2024_EXPECT_DATASET_HASH+"|Actual="+g_s2b_stop_d2024_protocol.dataset_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_protocol.dataset_hash==S2B_STOP_D2024_EXPECT_DATASET_HASH)+"\nFeatureMatrixHash Expected="+S2B_STOP_D2024_EXPECT_FEATURE_HASH+"|Actual="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_protocol.feature_matrix_hash==S2B_STOP_D2024_EXPECT_FEATURE_HASH)+"\nRowMaskHash Expected="+S2B_STOP_D2024_EXPECT_ROWMASK_HASH+"|Actual="+g_s2b_stop_d2024_protocol.row_mask_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_protocol.row_mask_hash==S2B_STOP_D2024_EXPECT_ROWMASK_HASH)+"\nFoldHash Expected="+S2B_STOP_D2024_EXPECT_FOLD_HASH+"|Actual="+g_s2b_stop_d2024_protocol.fold_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_protocol.fold_hash==S2B_STOP_D2024_EXPECT_FOLD_HASH)+"\nProtocolHash Expected="+S2B_STOP_D2024_EXPECT_PROTOCOL_HASH+"|Actual="+g_s2b_stop_d2024_protocol.protocol_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_protocol.protocol_hash==S2B_STOP_D2024_EXPECT_PROTOCOL_HASH)+"\nContextHash Expected="+S2B_STOP_D2024_EXPECT_CONTEXT_HASH+"|Actual="+g_s2b_stop_d2024_context.evaluation_context_hash+"|"+S2B_StopD2024_Match(g_s2b_stop_d2024_context.evaluation_context_hash==S2B_STOP_D2024_EXPECT_CONTEXT_HASH)+"\n");
 FileWriteString(h,"Eligible Expected="+IntegerToString(S2B_STOP_D2024_EXPECT_ELIGIBLE)+"|Actual="+IntegerToString(g_s2b_stop_d2024_context.eligible_count)+"\nStopPositives Expected="+IntegerToString(S2B_STOP_D2024_EXPECT_STOP_POS)+"|Actual="+IntegerToString(g_s2b_stop_d2024_context.positive_count)+"\nCandidateHash Expected="+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"|Actual="+g_s2b_stop_d2024_actual_candidate_hash+"\nCandidateFeatureCount Expected=5|Actual="+IntegerToString(g_s2b_stop_d2024_actual_feature_count)+"\nCandidateFeatureList Expected="+S2B_STOP_D2024_EXPECT_FEATURE_LIST+"\nCandidateFeatureList Actual="+g_s2b_stop_d2024_actual_feature_list+"\nOOF_N Expected=2579|Actual="+IntegerToString(g_s2b_stop_d2024_actual_oof_n)+"\nOOF_Stop_N Expected=32|Actual="+IntegerToString(g_s2b_stop_d2024_actual_oof_stop_n)+"\nFoldCount Expected=3|Actual="+IntegerToString(g_s2b_stop_d2024_actual_fold_count)+"\n");
 FileWriteString(h,"Quantiles=5|10|15|20|25|30\nScalePrimary=PER_FOLD_PERCENTILE_RANK\nPooledProbability=INFO_ONLY\nBootstrap=STRATIFIED_PER_FOLD_STOP_NONSTOP\nSeed=20260808\nIterations=1000\nPhaseBVerdict="+g_s2b_stop_phaseb_verdict+"\nThresholdEngineExecuted="+string(g_s2b_stop_d2024_threshold_executed?"YES":"NO")+"\nOperationalThresholdSelected="+string(g_s2b_stop_operational_threshold_selected?"YES":"NO")+"\n");
 for(int i=0;i<g_s2b_stop_thr_row_count;i++){SS2BStopThresholdRow r=g_s2b_stop_thr_rows[i];FileWriteString(h,StringFormat("Reject=%.0f|ActualReject=%.4f|Coverage=%.4f|StopCaptured=%d/%d(%.4f)|Step4Lost=%.4f|TargetLost=%.4f|ExpDelta=%.8f|PF=%.6f->%.6f|Gate=%s|Reason=%s\n",r.target_rejection_pct,r.rejection_rate_pct,r.coverage_pct,r.stop_captured_n,r.oof_stop_n,r.stop_captured_pct,r.step4_lost_pct,r.target_lost_pct,r.expectancy_delta,r.pf_before,r.pf_after,(r.gate_pass?"PASS":"FAIL"),r.gate_fail_reason));}
 if(g_s2b_stop_operational_threshold_selected&&g_s2b_stop_thr_selected_index>=0)FileWriteString(h,"LockedRejectionRateTarget="+DoubleToString(g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index].target_rejection_pct,2)+"%\n");else FileWriteString(h,"LockedRejectionRateTarget=NONE\n");
 FileWriteString(h,"2023=DEVELOPMENT_VALIDATION\n2024_2026=RESERVED_UNTOUCHED_HOLDOUT\nHistoricalConfirmation=BLOCKED\nWinnerConfirmation=BLOCKED\nFrozenExport=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n");FileClose(h);Print("STOP_D2024_PHASEB_LOCK_REPORT|",fn);
}
void S2B_StopD2024_RunPhaseB()
{
 Print("STOP_D2024_PHASEB_RUN_MODE|ISOLATED_THREE_FOLD_OOF");Print("STOP_D2024_PHASEB_RUN_GUARD|RUN_PHASE7=SKIPPED|OLD_STOP_PIPELINE=SKIPPED|2023=DEVELOPMENT_VALIDATION|2024_2026=UNTOUCHED");S2B_StopD2024_ResetCycleState();g_s2b_stop_d2024_threshold_executed=false;g_s2b_stop_thr_row_count=0;g_s2b_stop_thr_selected_index=-1;g_s2b_stop_operational_threshold_selected=false;g_s2b_stop_phaseb_verdict="RUNNING";string why="";
 if(!S2B_StopD2024_ValidateRunBoundary(why)||!S2B_StopD2024_InitProtocol(why)){g_s2b_stop_phaseb_verdict="CONTEXT_MISMATCH";S2B_StopD2024_ExportThresholdLock();return;}
 if(!S2B_StopD2024_PreOOFGuard()){g_s2b_stop_phaseb_verdict="CONTEXT_MISMATCH";S2B_StopD2024_ExportThresholdTradeoff();S2B_StopD2024_ExportThresholdLock();return;}
 if(!S2B_StopD2024_BuildOOF()){g_s2b_stop_phaseb_verdict="BLOCKED_OOF_BUILD_FAILED";S2B_StopD2024_ExportThresholdTradeoff();S2B_StopD2024_ExportThresholdLock();return;}
 if(!S2B_StopD2024_PostOOFGuard()){g_s2b_stop_phaseb_verdict="CONTEXT_MISMATCH";S2B_StopD2024_ExportThresholdTradeoff();S2B_StopD2024_ExportThresholdLock();return;}
 g_s2b_stop_d2024_threshold_executed=true;double q[6]={0.05,0.10,0.15,0.20,0.25,0.30};g_s2b_stop_thr_row_count=6;int pass_count=0;for(int i=0;i<6;i++){g_s2b_stop_thr_rows[i].Reset();S2B_EvaluateStopThresholdRow(q[i],g_s2b_stop_thr_rows[i]);S2B_PhaseBBootstrap(g_s2b_stop_thr_rows[i]);string gr="NONE";bool pass=S2B_PhaseBApplyGate(g_s2b_stop_thr_rows[i],gr);g_s2b_stop_thr_rows[i].gate_pass=pass?1:0;g_s2b_stop_thr_rows[i].gate_fail_reason=gr;if(pass){pass_count++;if(g_s2b_stop_thr_selected_index<0||S2B_PhaseBThresholdBetter(g_s2b_stop_thr_rows[i],g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index]))g_s2b_stop_thr_selected_index=i;}}
 if(pass_count==0){g_s2b_stop_phaseb_verdict="NO_VIABLE_THRESHOLD";g_s2b_stop_operational_threshold_selected=false;}else{g_s2b_stop_phaseb_verdict="VIABLE_REJECTION_RATE_LOCKED";g_s2b_stop_operational_threshold_selected=true;g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index].policy_rank=1;}
 S2B_StopD2024_ExportThresholdTradeoff();S2B_StopD2024_ExportThresholdLock();Print("STOP_D2024_PHASEB_SUMMARY|Version=",S2B_STOP_D2024_PHASEB_VERSION,"|CandidateHash=",S2B_STOP_D2024_EXPECT_CANDIDATE_HASH,"|Verdict=",g_s2b_stop_phaseb_verdict,"|ContextLock=PASS|ThresholdEngineExecuted=YES|GatePassCount=",pass_count,"|OperationalThresholdSelected=",(g_s2b_stop_operational_threshold_selected?"YES":"NO"),"|HistoricalConfirmation=BLOCKED|Holdout=UNTOUCHED");
}
// ================================================================
// D2024 full-DEV numeric probability cutoff translation
// ================================================================
string S2B_StopD2024_NormalizationHash(SStage2B_ModelParams &m)
{
 string k="NORM|"+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"|";for(int i=0;i<m.n_features;i++)k+=S2B_FeatureName(m.feature_idx[i])+"@"+DoubleToString(m.feat_mean[i],12)+"@"+DoubleToString(m.feat_std[i],12)+"|";return S2B_HashToString(S2B_HashString32(k));
}
string S2B_StopD2024_ModelHash(SStage2B_ModelParams &m,string nh)
{
 string k="MODEL|"+S2B_STOP_D2024_NUMERIC_VERSION+"|CAND="+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"|CTX="+S2B_STOP_D2024_EXPECT_CONTEXT_HASH+"|NORM="+nh+"|INT="+DoubleToString(m.intercept,12)+"|";for(int i=0;i<m.n_features;i++)k+=S2B_FeatureName(m.feature_idx[i])+"@"+DoubleToString(m.weights[i],12)+"|";return S2B_HashToString(S2B_HashString32(k));
}
void S2B_StopD2024_ExportNumericLock(SStage2B_ModelParams &m,string nh,string mh,double cutoff,int rejected,int total)
{
 string fn="Stage2B_Stop_D2024_NumericCutoffLock_"+_Symbol+".txt";int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE)return;
 FileWriteString(h,"STOPFLAG D2024 NUMERIC PROBABILITY CUTOFF LOCK\nVersion="+S2B_STOP_D2024_NUMERIC_VERSION+"\nCycleId="+S2B_STOP_D2024_CYCLE_ID+"\nCandidateHash="+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"\nCandidateFeatureList="+S2B_STOP_D2024_EXPECT_FEATURE_LIST+"\nContextHash="+g_s2b_stop_d2024_context.evaluation_context_hash+"\nProtocolHash="+g_s2b_stop_d2024_protocol.protocol_hash+"\nDatasetHash="+g_s2b_stop_d2024_protocol.dataset_hash+"\nFeatureMatrixHash="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"\nRowMaskHash="+g_s2b_stop_d2024_protocol.row_mask_hash+"\nFoldHash="+g_s2b_stop_d2024_protocol.fold_hash+"\nTrainingWindow=[2018.01.01,2024.01.01)\nTrainingRows="+IntegerToString(total)+"\nEpochs=5000\nLearningRate=0.05\nLambda=0.01\nNormalizationHash="+nh+"\nModelHash="+mh+"\nIntercept="+DoubleToString(m.intercept,12)+"\n");
 for(int i=0;i<m.n_features;i++)FileWriteString(h,"Feature"+IntegerToString(i+1)+"="+S2B_FeatureName(m.feature_idx[i])+"|Mean="+DoubleToString(m.feat_mean[i],12)+"|Std="+DoubleToString(m.feat_std[i],12)+"|Coefficient="+DoubleToString(m.weights[i],12)+"\n");
 FileWriteString(h,"LockedRejectionRate=10.00%\nPercentile=90.00\nNumericProbabilityCutoff="+DoubleToString(cutoff,12)+"\nTiePolicy=REJECT_IF_PROBABILITY_GREATER_THAN_OR_EQUAL_TO_CUTOFF\nExpectedDEVRejectedN="+IntegerToString(rejected)+"\nExpectedDEVAcceptedN="+IntegerToString(total-rejected)+"\nExpectedDEVRejectionRatePct="+DoubleToString(total>0?100.0*rejected/total:0.0,8)+"\nHoldout2024_2026=BLOCKED_UNTOUCHED\nHistoricalConfirmation=BLOCKED\nWinnerConfirmation=BLOCKED\nFrozenExport=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n");FileClose(h);Print("STOP_D2024_NUMERIC_LOCK_REPORT|",fn);
 string fc="Stage2B_Stop_D2024_FinalModel_"+_Symbol+".csv";int c=FileOpen(fc,FILE_WRITE|FILE_CSV|FILE_COMMON,',');if(c!=INVALID_HANDLE){FileWrite(c,"FeatureOrder","Feature","Mean","Std","Coefficient","Intercept","NormalizationHash","ModelHash","NumericCutoff");for(int i=0;i<m.n_features;i++)FileWrite(c,i+1,S2B_FeatureName(m.feature_idx[i]),DoubleToString(m.feat_mean[i],12),DoubleToString(m.feat_std[i],12),DoubleToString(m.weights[i],12),DoubleToString(m.intercept,12),nh,mh,DoubleToString(cutoff,12));FileClose(c);}
}
void S2B_StopD2024_RunNumericCutoff()
{
 Print("STOP_D2024_NUMERIC_RUN_MODE|ISOLATED_FULL_DEV_TRANSLATION");Print("STOP_D2024_NUMERIC_GUARD|2024_2026=UNTOUCHED|HISTORICAL_CONFIRMATION=BLOCKED|FROZEN=BLOCKED|STAGE2C=BLOCKED|STAGE2D=BLOCKED");S2B_StopD2024_ResetCycleState();string why="";if(!S2B_StopD2024_ValidateRunBoundary(why)||!S2B_StopD2024_InitProtocol(why)){Print("STOP_D2024_NUMERIC|BLOCKED|Reason=",why);return;}if(!S2B_StopD2024_PreOOFGuard()){Print("STOP_D2024_NUMERIC|CONTEXT_MISMATCH|Mismatches=",g_s2b_stop_d2024_mismatches);return;}
 int fi[];int nf=S2B_ResolveLockedStopFeatures(fi);int rows[];int n=S2B_StopD2024_CollectMaskedRows(StringToTime("2018.01.01"),StringToTime("2024.01.01"),rows);if(n!=S2B_STOP_D2024_EXPECT_ELIGIBLE||!S2B_StopD2024_ValidateRowSetDevelopmentOnly(rows,n,StringToTime("2018.01.01"),StringToTime("2024.01.01"),"NUMERIC_FULL_DEV",why)){Print("STOP_D2024_NUMERIC|BLOCKED|Reason=",why);return;}
 SStage2B_ModelParams m;if(!S2B_StopD2024_TrainValidated(fi,nf,rows,n,m,5000,0.05,0.01)){Print("STOP_D2024_NUMERIC|BLOCKED|Reason=FINAL_DEV_TRAIN_FAILED");return;}double p[];int rec[];int ns=0;if(!S2B_ScoreModel_OnRows_Stop(m,rows,n,p,rec,ns)||ns!=n){Print("STOP_D2024_NUMERIC|BLOCKED|Reason=FINAL_DEV_SCORE_FAILED");return;}double sorted[];ArrayResize(sorted,n);ArrayCopy(sorted,p);S2B_PhaseBSortAsc(sorted,n);double cutoff=S2B_PhaseBPercentile(sorted,n,S2B_STOP_D2024_NUMERIC_PERCENTILE);int rej=0;for(int i=0;i<n;i++)if(p[i]>=cutoff)rej++;string nh=S2B_StopD2024_NormalizationHash(m);string mh=S2B_StopD2024_ModelHash(m,nh);S2B_StopD2024_ExportNumericLock(m,nh,mh,cutoff,rej,n);Print("STOP_D2024_NUMERIC_SUMMARY|Version=",S2B_STOP_D2024_NUMERIC_VERSION,"|CandidateHash=",S2B_STOP_D2024_EXPECT_CANDIDATE_HASH,"|TrainingRows=",n,"|Cutoff=",DoubleToString(cutoff,12),"|ExpectedRejected=",rej,"|ExpectedRejectionPct=",DoubleToString(100.0*rej/n,8),"|NormalizationHash=",nh,"|ModelHash=",mh,"|Holdout=UNTOUCHED");
}
// ================================================================
// D2024 pre-holdout freeze manifest and one-shot holdout evaluator
// ================================================================
string S2B_StopD2024_FreezeFile(){return "Stage2B_Stop_D2024_FreezeManifest_"+_Symbol+".txt";}
string S2B_StopD2024_HoldoutMarkerFile(){return "Stage2B_Stop_D2024_HoldoutConsumed_"+_Symbol+".lock";}
string S2B_StopD2024_ReadCommonText(string fn)
{
   int h=FileOpen(fn,FILE_READ|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE)return "";string x="";while(!FileIsEnding(h))x+=FileReadString(h)+"\n";FileClose(h);return x;
}
void S2B_StopD2024_LoadFrozenModel(SStage2B_ModelParams &m)
{
   m.Reset();int fi[];int nf=S2B_ResolveLockedStopFeatures(fi);m.n_features=nf;for(int i=0;i<nf;i++)m.feature_idx[i]=fi[i];
   m.intercept=-1.631366325187;
   m.feat_mean[0]=1.304557995495;m.feat_std[0]=1.056920317365;m.weights[0]=0.352601247254;
   m.feat_mean[1]=7.695629859071;m.feat_std[1]=9.702729212560;m.weights[1]=0.231609753744;
   m.feat_mean[2]=0.000647310818;m.feat_std[2]=0.000767785507;m.weights[2]=-0.094823277753;
   m.feat_mean[3]=0.184906763891;m.feat_std[3]=1.557000172650;m.weights[3]=0.310049430837;
   m.feat_mean[4]=0.215277777778;m.feat_std[4]=0.411014909915;m.weights[4]=0.192985943613;
   m.model_name="STOP_D2024_FINAL_DEV_LOCKED";m.target_name="StopFlag";m.best_threshold=S2B_STOP_D2024_LOCKED_CUTOFF;m.n_dev=S2B_STOP_D2024_TRAINING_ROWS;m.trained=true;ArrayFree(fi);
}
bool S2B_StopD2024_FrozenModelGuard(SStage2B_ModelParams &m,string &why)
{
   why="";string nh=S2B_StopD2024_NormalizationHash(m),mh=S2B_StopD2024_ModelHash(m,nh);int fi[];int nf=S2B_ResolveLockedStopFeatures(fi);string ch=S2B_BuildFeatureHash(fi,nf),fl=S2B_BuildFeatureListString(fi,nf);ArrayFree(fi);
   if(nh!=S2B_STOP_D2024_LOCKED_NORM_HASH)why+="NormalizationHash|";
   if(mh!=S2B_STOP_D2024_LOCKED_MODEL_HASH)why+="ModelHash|";
   if(ch!=S2B_STOP_D2024_EXPECT_CANDIDATE_HASH)why+="CandidateHash|";
   if(fl!=S2B_STOP_D2024_EXPECT_FEATURE_LIST)why+="FeatureList|";
   if(MathAbs(m.best_threshold-S2B_STOP_D2024_LOCKED_CUTOFF)>1e-15)why+="NumericCutoff|";
   return StringLen(why)==0;
}
string S2B_StopD2024_BuildFreezeBody(SStage2B_ModelParams &m)
{
   string x="STOPFLAG D2024 PRE-HOLDOUT FREEZE MANIFEST\n";
   x+="FreezeVersion="+S2B_STOP_D2024_FREEZE_VERSION+"\nCycleId="+S2B_STOP_D2024_CYCLE_ID+"\nCandidateHash="+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"\nFeatureList="+S2B_STOP_D2024_EXPECT_FEATURE_LIST+"\n";
   x+="NormalizationHash="+S2B_STOP_D2024_LOCKED_NORM_HASH+"\nModelHash="+S2B_STOP_D2024_LOCKED_MODEL_HASH+"\nNumericCutoff="+DoubleToString(S2B_STOP_D2024_LOCKED_CUTOFF,12)+"\nTiePolicy="+S2B_STOP_D2024_TIE_POLICY+"\n";
   x+="ContextHash="+S2B_STOP_D2024_EXPECT_CONTEXT_HASH+"\nProtocolHash="+S2B_STOP_D2024_EXPECT_PROTOCOL_HASH+"\nDatasetHash="+S2B_STOP_D2024_EXPECT_DATASET_HASH+"\nFeatureMatrixHash="+S2B_STOP_D2024_EXPECT_FEATURE_HASH+"\nRowMaskHash="+S2B_STOP_D2024_EXPECT_ROWMASK_HASH+"\nFoldHash="+S2B_STOP_D2024_EXPECT_FOLD_HASH+"\n";
   x+="TrainingWindow=[2018.01.01,2024.01.01)\nTrainingRows=5328\nEpochs=5000\nLearningRate=0.05\nLambda=0.01\nIntercept="+DoubleToString(m.intercept,12)+"\n";
   for(int i=0;i<m.n_features;i++)x+="Feature"+IntegerToString(i+1)+"="+S2B_FeatureName(m.feature_idx[i])+"|Mean="+DoubleToString(m.feat_mean[i],12)+"|Std="+DoubleToString(m.feat_std[i],12)+"|Coefficient="+DoubleToString(m.weights[i],12)+"\n";
   x+="FreezeStatus=LOCKED_BEFORE_HOLDOUT\nHoldoutWindow=[2024.01.01,2027.01.01)\nHoldoutExecutionPolicy=ONE_SHOT_EVALUATION_ONLY\nModelRefit=FORBIDDEN\nThresholdChange=FORBIDDEN\nTiePolicyChange=FORBIDDEN\nWinnerConfirmation=BLOCKED\nDeploymentFrozenExport=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n";return x;
}
string S2B_StopD2024_FreezeManifestHash(string body){return S2B_HashToString(S2B_HashString32("FREEZE_MANIFEST|"+body));}
bool S2B_StopD2024_VerifyFreezeManifest(SStage2B_ModelParams &m,string &manifest_hash,string &why)
{
   why="";string body=S2B_StopD2024_BuildFreezeBody(m);manifest_hash=S2B_StopD2024_FreezeManifestHash(body);string expected=body+"ManifestHash="+manifest_hash+"\n";string actual=S2B_StopD2024_ReadCommonText(S2B_StopD2024_FreezeFile());if(actual==""){why="FREEZE_MANIFEST_MISSING";return false;}if(actual!=expected){why="FREEZE_MANIFEST_CONTENT_MISMATCH";return false;}return true;
}
void S2B_StopD2024_RunFreezeManifest()
{
   Print("STOP_D2024_FREEZE_RUN_MODE|PRE_HOLDOUT_MANIFEST_ONLY");S2B_StopD2024_ResetCycleState();string why="";if(!S2B_StopD2024_ValidateRunBoundary(why)||!S2B_StopD2024_InitProtocol(why)){Print("STOP_D2024_FREEZE|BLOCKED|Reason=",why);return;}if(!S2B_StopD2024_PreOOFGuard()){Print("STOP_D2024_FREEZE|BLOCKED|Reason=CONTEXT_MISMATCH|Fields=",g_s2b_stop_d2024_mismatches);return;}SStage2B_ModelParams m;S2B_StopD2024_LoadFrozenModel(m);if(!S2B_StopD2024_FrozenModelGuard(m,why)){Print("STOP_D2024_FREEZE|BLOCKED|Reason=FROZEN_MODEL_MISMATCH|Fields=",why);return;}
   string body=S2B_StopD2024_BuildFreezeBody(m),fh=S2B_StopD2024_FreezeManifestHash(body),expected=body+"ManifestHash="+fh+"\n",fn=S2B_StopD2024_FreezeFile();if(FileIsExist(fn,FILE_COMMON)){string old=S2B_StopD2024_ReadCommonText(fn);if(old!=expected){Print("STOP_D2024_FREEZE|BLOCKED|Reason=EXISTING_MANIFEST_MISMATCH");return;}Print("STOP_D2024_FREEZE|PASS|Status=ALREADY_IDENTICAL");}else{int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE){Print("STOP_D2024_FREEZE|BLOCKED|Reason=MANIFEST_WRITE_FAILED");return;}FileWriteString(h,expected);FileClose(h);}
   Print("STOP_D2024_FREEZE_MANIFEST|",fn,"|ManifestHash=",fh);Print("STOP_D2024_FREEZE_SUMMARY|Status=LOCKED_BEFORE_HOLDOUT|ModelHash=",S2B_STOP_D2024_LOCKED_MODEL_HASH,"|NormalizationHash=",S2B_STOP_D2024_LOCKED_NORM_HASH,"|Cutoff=",DoubleToString(S2B_STOP_D2024_LOCKED_CUTOFF,12),"|Holdout=NOT_ACCESSED");
}
bool S2B_StopD2024_HoldoutPF(double gp,double gl,double &pf,int &pf_defined)
{
   if(gl<=0.0){pf_defined=0;pf=(gp>0.0?99.0:0.0);return false;}pf_defined=1;pf=gp/gl;return true;
}
void S2B_StopD2024_RunHoldoutOnce()
{
   Print("STOP_D2024_HOLDOUT_RUN_MODE|ONE_SHOT_EVALUATION_ONLY");Print("STOP_D2024_HOLDOUT_LOCK|NO_REFIT|NO_NORMALIZATION_CHANGE|NO_THRESHOLD_CHANGE|NO_TIE_CHANGE");string why="",manifest_hash="";SStage2B_ModelParams m;S2B_StopD2024_LoadFrozenModel(m);if(!S2B_StopD2024_FrozenModelGuard(m,why)){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=FROZEN_MODEL_MISMATCH|Fields=",why);return;}if(!S2B_StopD2024_VerifyFreezeManifest(m,manifest_hash,why)){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=",why);return;}string marker=S2B_StopD2024_HoldoutMarkerFile();if(FileIsExist(marker,FILE_COMMON)){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=ONE_SHOT_ALREADY_CONSUMED|Marker=",marker);return;}if(g_s2b_stop_d2024_holdout_guard.tripped){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=HOLDOUT_WINDOW_GUARD_TRIPPED");return;}
   datetime h0=StringToTime("2024.01.01"),h1=StringToTime("2027.01.01");int rows[];ArrayResize(rows,g_risklab_count);int n=0,y24=0,y25=0,y26=0;for(int i=0;i<g_risklab_count;i++){SRiskLabRecord r=g_risklab_records[i];if(r.entry_time<h0||r.entry_time>=h1){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=ROW_OUTSIDE_HOLDOUT|Time=",TimeToString(r.entry_time,TIME_DATE));return;}bool ok=(r.max_step_reached>=1&&r.max_step_reached<=5&&StringLen(r.final_event)>0);for(int k=0;k<m.n_features&&ok;k++){double v=0.0;if(!S2B_GetFeatureValue(i,m.feature_idx[k],v))ok=false;}if(!ok)continue;rows[n++]=i;MqlDateTime dt;TimeToStruct(r.entry_time,dt);if(dt.year==2024)y24++;else if(dt.year==2025)y25++;else if(dt.year==2026)y26++;}ArrayResize(rows,n);if(n<=0||y24<=0||y25<=0||y26<=0){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=INCOMPLETE_2024_2026_COVERAGE|N=",n,"|Y2024=",y24,"|Y2025=",y25,"|Y2026=",y26);return;}
   int mk=FileOpen(marker,FILE_WRITE|FILE_TXT|FILE_COMMON);if(mk==INVALID_HANDLE){Print("STOP_D2024_HOLDOUT|BLOCKED|Reason=ONE_SHOT_MARKER_CREATE_FAILED");return;}FileWriteString(mk,"State=STARTED\nManifestHash="+manifest_hash+"\nModelHash="+S2B_STOP_D2024_LOCKED_MODEL_HASH+"\n");FileClose(mk);
   int stops=0,rejected=0,stop_cap=0,s4=0,s4_lost=0,tg=0,tg_lost=0,accepted=0;double pnl_before=0.0,pnl_after=0.0,gp_b=0.0,gl_b=0.0,gp_a=0.0,gl_a=0.0;
   for(int j=0;j<n;j++){int ri=rows[j];SRiskLabRecord rr=g_risklab_records[ri];double z=m.intercept;for(int k=0;k<m.n_features;k++){double v=0.0;S2B_GetFeatureValue(ri,m.feature_idx[k],v);z+=m.weights[k]*((v-m.feat_mean[k])/m.feat_std[k]);}double score=S2B_Sigmoid(z);bool reject=(score>=S2B_STOP_D2024_LOCKED_CUTOFF);pnl_before+=rr.pnl;if(rr.pnl>0)gp_b+=rr.pnl;else if(rr.pnl<0)gl_b+=-rr.pnl;if(rr.stop_flag)stops++;if(rr.hit_step4_plus)s4++;if(rr.target_flag)tg++;if(reject){rejected++;if(rr.stop_flag)stop_cap++;if(rr.hit_step4_plus)s4_lost++;if(rr.target_flag)tg_lost++;}else{accepted++;pnl_after+=rr.pnl;if(rr.pnl>0)gp_a+=rr.pnl;else if(rr.pnl<0)gl_a+=-rr.pnl;}}
   double stop_pct=stops>0?100.0*stop_cap/stops:0.0,s4_pct=s4>0?100.0*s4_lost/s4:0.0,tg_pct=tg>0?100.0*tg_lost/tg:0.0,exp_b=n>0?pnl_before/n:0.0,exp_a=accepted>0?pnl_after/accepted:0.0,pf_b=0.0,pf_a=0.0;int pfd_b=0,pfd_a=0;S2B_StopD2024_HoldoutPF(gp_b,gl_b,pf_b,pfd_b);S2B_StopD2024_HoldoutPF(gp_a,gl_a,pf_a,pfd_a);
   string fn="Stage2B_Stop_D2024_HoldoutResult_"+_Symbol+".txt";string out="STOPFLAG D2024 ONE-SHOT HOLDOUT RESULT\nHoldoutVersion="+S2B_STOP_D2024_HOLDOUT_VERSION+"\nManifestHash="+manifest_hash+"\nCycleId="+S2B_STOP_D2024_CYCLE_ID+"\nCandidateHash="+S2B_STOP_D2024_EXPECT_CANDIDATE_HASH+"\nNormalizationHash="+S2B_STOP_D2024_LOCKED_NORM_HASH+"\nModelHash="+S2B_STOP_D2024_LOCKED_MODEL_HASH+"\nNumericCutoff="+DoubleToString(S2B_STOP_D2024_LOCKED_CUTOFF,12)+"\nTiePolicy="+S2B_STOP_D2024_TIE_POLICY+"\nWindow=[2024.01.01,2027.01.01)\nTrades="+IntegerToString(n)+"\nStops="+IntegerToString(stops)+"\nRejected="+IntegerToString(rejected)+"\nAccepted="+IntegerToString(accepted)+"\nRejectionRatePct="+DoubleToString(100.0*rejected/n,8)+"\nStopCapturedN="+IntegerToString(stop_cap)+"\nStopCapturePct="+DoubleToString(stop_pct,8)+"\nStep4PlusTotal="+IntegerToString(s4)+"\nStep4PlusLostN="+IntegerToString(s4_lost)+"\nStep4PlusLostPct="+DoubleToString(s4_pct,8)+"\nTargetTotal="+IntegerToString(tg)+"\nTargetLostN="+IntegerToString(tg_lost)+"\nTargetLostPct="+DoubleToString(tg_pct,8)+"\nPnLBefore="+DoubleToString(pnl_before,8)+"\nPnLAfter="+DoubleToString(pnl_after,8)+"\nExpectancyBefore="+DoubleToString(exp_b,8)+"\nExpectancyAfter="+DoubleToString(exp_a,8)+"\nPFBefore="+DoubleToString(pf_b,8)+"\nPFBeforeDefined="+IntegerToString(pfd_b)+"\nPFAfter="+DoubleToString(pf_a,8)+"\nPFAfterDefined="+IntegerToString(pfd_a)+"\nEvaluationOnly=YES\nModelChanged=NO\nThresholdChanged=NO\nTiePolicyChanged=NO\nWinnerConfirmation=BLOCKED\nDeploymentFrozenExport=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n";string rh=S2B_HashToString(S2B_HashString32("HOLDOUT_RESULT|"+out));out+="HoldoutResultHash="+rh+"\n";int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE){Print("STOP_D2024_HOLDOUT|FAIL|Reason=RESULT_WRITE_FAILED|ONE_SHOT_CONSUMED=YES");return;}FileWriteString(h,out);FileClose(h);mk=FileOpen(marker,FILE_WRITE|FILE_TXT|FILE_COMMON);if(mk!=INVALID_HANDLE){FileWriteString(mk,"State=COMPLETED\nManifestHash="+manifest_hash+"\nHoldoutResultHash="+rh+"\n");FileClose(mk);}Print("STOP_D2024_HOLDOUT_REPORT|",fn,"|ResultHash=",rh);Print("STOP_D2024_HOLDOUT_SUMMARY|Trades=",n,"|Stops=",stops,"|Rejected=",rejected,"|StopCapturePct=",DoubleToString(stop_pct,8),"|Step4LostPct=",DoubleToString(s4_pct,8),"|TargetLostPct=",DoubleToString(tg_pct,8),"|ExpBefore=",DoubleToString(exp_b,8),"|ExpAfter=",DoubleToString(exp_a,8),"|PFBefore=",DoubleToString(pf_b,8),"|PFAfter=",DoubleToString(pf_a,8),"|OneShot=CONSUMED");
}
