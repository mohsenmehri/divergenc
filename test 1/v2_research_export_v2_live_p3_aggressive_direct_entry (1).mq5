// Global array برای Stage 2A
SFeatureImportanceRow g_feature_importance[];
int                   g_feature_importance_count = 0;
#define FI_MAX_ROWS 2000
// === Stage 2A v1.3 — Realistic thresholds ===
#define FI_MIN_POSITIVE_FOR_AUC      8
#define FI_MIN_POSITIVE_FOR_CI      15
#define FI_MIN_TOTAL_FOR_AUC        30
#define FI_AUC_STRONG      0.62
#define FI_AUC_MODERATE    0.56
#define FI_AUC_WEAK        0.52
#define FI_COHEN_STRONG    0.40
#define FI_COHEN_MODERATE  0.15
// absolute AUC difference thresholds
#define FI_DECAY_STABLE          0.03
#define FI_DECAY_MILD            0.08
#define FI_DECAY_IMPROVING_MIN   0.02
SRLLinearModel g_rl_models[];
int            g_rl_model_count = 0;
#define RL_MAX_MODELS 200
// نتایج همه Feature‌ها
SRLFeatureStat g_rl_feature_stats[];
int            g_rl_feature_stat_count = 0;
// Feature list برای export
#define RL_FA_MAX_FEATURES 2000
#ifndef DS_VERSION
#define DS_VERSION "v2.5"
#endif
#ifndef DS_EA_VERSION
#define DS_EA_VERSION "EA_v8.2"
#endif
#ifndef DS_FEATURE_SET
#define DS_FEATURE_SET "FS_v2.5"
#endif
//================================================================
// FI_GetFeatureGroup
// تعیین خانواده feature از روی اسم آن
//================================================================
string FI_GetFeatureGroup(string feat_name)
{
   string f = feat_name;
   // Divergence family
   if(StringFind(f, "Div")        >= 0) return "DIVERGENCE";
   if(StringFind(f, "Pivot_RSI")  >= 0) return "DIVERGENCE";
   if(StringFind(f, "Price_Leg")  >= 0) return "DIVERGENCE";
   if(StringFind(f, "RSI_Accel")  >= 0) return "DIVERGENCE";
   if(StringFind(f, "Div_Span")   >= 0) return "DIVERGENCE";
   if(StringFind(f, "Symmetry")   >= 0) return "DIVERGENCE";
   if(StringFind(f, "Time_Since") >= 0) return "DIVERGENCE";
   if(StringFind(f, "Divergence_Angle") >= 0) return "DIVERGENCE";
   // Order Block family
   if(StringFind(f, "OB_")        >= 0) return "OB";
   if(StringFind(f, "ob_")        >= 0) return "OB";
   // Pivot family
   if(StringFind(f, "Pivot")      >= 0) return "PIVOT";
   if(StringFind(f, "Piv")        >= 0) return "PIVOT";
   // Trend (EMA-based)
   if(StringFind(f, "EMA")        >= 0) return "TREND";
   if(StringFind(f, "Slope")      >= 0) return "TREND";
   if(StringFind(f, "Compress")   >= 0) return "TREND";
   // Strength (ADX/DI-based)
   if(StringFind(f, "ADX")        >= 0) return "STRENGTH";
   if(StringFind(f, "DI")         >= 0) return "STRENGTH";
   if(StringFind(f, "Stability")  >= 0) return "STRENGTH";
   if(StringFind(f, "Consensus")  >= 0) return "STRENGTH";
   // Momentum (RSI/CCI/MACD/Stoch)
   if(StringFind(f, "RSI")        >= 0) return "MOMENTUM";
   if(StringFind(f, "CCI")        >= 0) return "MOMENTUM";
   if(StringFind(f, "MACD")       >= 0) return "MOMENTUM";
   if(StringFind(f, "Stoch")      >= 0) return "MOMENTUM";
   if(StringFind(f, "Williams")   >= 0) return "MOMENTUM";
   // Volatility (ATR/BB)
   if(StringFind(f, "ATR")        >= 0) return "VOLATILITY";
   if(StringFind(f, "BB")         >= 0) return "VOLATILITY";
   if(StringFind(f, "Squeeze")    >= 0) return "VOLATILITY";
   // MTF / Signal
   if(StringFind(f, "MTF")        >= 0) return "MTF";
   if(StringFind(f, "Signal")     >= 0) return "MTF";
   return "OTHER";
}
//================================================================
// FI_GetTargetStatus
// تعیین کیفیت یک target بر اساس تعداد نمونه‌های مثبت
//================================================================
string FI_GetTargetStatus(int positive_n)
{
   if(positive_n < FI_MIN_POSITIVE_FOR_AUC) return "INSUFFICIENT";
   if(positive_n < 20)                      return "LOW_SAMPLE";
   if(positive_n < 50)                      return "LOW_CONFIDENCE";
   return "OK";
}
//================================================================
// FI_GetDecayLabel
// تبدیل decay درصد به label
//================================================================
string FI_GetDecayLabel(double decay_abs)
{
   // decay_abs = DEV_AUC - OOS_AUC
   // positive = OOS worse
   // negative = OOS better
   if(decay_abs < -FI_DECAY_IMPROVING_MIN)
      return "IMPROVING";
   if(MathAbs(decay_abs) <= FI_DECAY_STABLE)
      return "STABLE";
   if(MathAbs(decay_abs) <= FI_DECAY_MILD)
      return "MILD_DEGRADATION";
   return "UNSTABLE";
}
//================================================================
// FI_CalcDecayAbs — decay مطلق (نه normalize شده)
// مثبت = DEV بهتر بود, منفی = OOS بهتر بود
//================================================================
double FI_CalcDecayAbs(double dev_auc, double oos_auc)
{
   if(dev_auc <= 0.0 || oos_auc <= 0.0)
      return 0.0;
   return (dev_auc - oos_auc);
}
//================================================================
// FI_LookupStat
// پیدا کردن یک SRLFeatureStat از g_rl_feature_stats[]
// بر اساس (feature_name, tf_name, side, target_name, split)
//================================================================
int FI_LookupStat(string feat, string tf, string side,
                  string target, string split)
{
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      if(g_rl_feature_stats[i].feature_name != feat)   continue;
      if(g_rl_feature_stats[i].tf_name      != tf)     continue;
      if(g_rl_feature_stats[i].side         != side)   continue;
      if(g_rl_feature_stats[i].target_name  != target) continue;
      if(g_rl_feature_stats[i].split        != split)  continue;
      return i;
   }
   return -1;
}
