      {
         cnt = g_adx_sell[tf][step].adx_ranges[i].count;
         wins = g_adx_sell[tf][step].adx_ranges[i].win_count;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= coverage_threshold)
      {
         sum_count += cnt;
         sum_wins += wins;
      }
   }
   coverage = (sum_count > 0) ? (sum_count * 100.0 / total) : 0;
   win_rate = (sum_count > 0) ? (sum_wins * 100.0 / sum_count) : 0;
   actual_sample = sum_count;
}
string BuildTopEMAPatterns(int step, bool is_buy, int tf, int top_n)
{
   int total = 0;
   int pattern_count = 0;
   if(is_buy)
   {
      total = g_ema_buy[tf][step].total_trades;
      pattern_count = g_ema_buy[tf][step].pattern_count;
   }
   else
   {
      total = g_ema_sell[tf][step].total_trades;
      pattern_count = g_ema_sell[tf][step].pattern_count;
   }
   if(total == 0|| pattern_count == 0) return "";
   string result = "";
   int added = 0;
   for(int i = 0; i < pattern_count && added < top_n; i++)
   {
      string pat = "";
      int cnt = 0;
      if(is_buy)
      {
         pat = g_ema_buy[tf][step].patterns[i].pattern;
         cnt = g_ema_buy[tf][step].patterns[i].count;
      }
      else
      {
         pat = g_ema_sell[tf][step].patterns[i].pattern;
         cnt = g_ema_sell[tf][step].patterns[i].count;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= 5.0)
      {
         if(result != "") result += "|";
         result += pat;
         added++;
      }
   }
   return result;
}
//|Calculate EMA Coverage and Win Rate|
void CalculateEMACoverage(int step, bool is_buy, int tf, int top_n, double &coverage, double &win_rate, int &actual_sample)
{
   coverage = 0;
   win_rate = 0;
   actual_sample = 0;
   int total = 0;
   int pattern_count = 0;
   int sum_count = 0;
   int sum_wins = 0;
   if(is_buy)
   {
      total = g_ema_buy[tf][step].total_trades;
      pattern_count = g_ema_buy[tf][step].pattern_count;
   }
   else
   {
      total = g_ema_sell[tf][step].total_trades;
      pattern_count = g_ema_sell[tf][step].pattern_count;
   }
   if(total == 0) return;
   int added = 0;
   for(int i = 0; i < pattern_count && added < top_n; i++)
   {
      int cnt = 0;
      int wins = 0;
      if(is_buy)
      {
         cnt = g_ema_buy[tf][step].patterns[i].count;
         wins = g_ema_buy[tf][step].patterns[i].win_count;
      }
      else
      {
         cnt = g_ema_sell[tf][step].patterns[i].count;
         wins = g_ema_sell[tf][step].patterns[i].win_count;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= 5.0)
      {
         sum_count += cnt;
         sum_wins += wins;
         added++;
      }
   }
   coverage = (total > 0) ? (sum_count * 100.0 / total) : 0;
   win_rate = (sum_count > 0) ? (sum_wins * 100.0 / sum_count) : 0;
   actual_sample = sum_count;
}
string BuildSmartFilterString(int step, bool is_buy, int tf)
{
   SFilterItem filters[10];
   int filter_count = 0;
   //RSI
   string rsi_range = BuildMergedRSIRange(step, is_buy, tf);
   if(rsi_range != "")
   {
      double rsi_cov = 0, rsi_wr = 0;
      int rsi_sample = 0;
      CalculateRSICoverage(step, is_buy, tf, rsi_cov, rsi_wr, rsi_sample);
      if(rsi_cov >= TH_RSI_COVERAGE && filter_count < ArraySize(filters))
      {
         filters[filter_count].Set("RSI", rsi_range, rsi_cov, rsi_wr, rsi_sample);
         filter_count++;
      }
   }
   //DI
   string di_cond = "";
   double di_cov = 0, di_wr = 0;
   int di_sample = 0;
   if(is_buy && g_adx_buy[tf][step].di_count > 0 && g_adx_buy[tf][step].total_trades > 0)
   {
      di_cond = g_adx_buy[tf][step].di_status[0].status;
      di_sample = g_adx_buy[tf][step].di_status[0].count;
      di_cov = di_sample * 100.0 / g_adx_buy[tf][step].total_trades;
      di_wr = g_adx_buy[tf][step].di_status[0].GetWinRate();
   }
   else if(!is_buy && g_adx_sell[tf][step].di_count > 0 && g_adx_sell[tf][step].total_trades > 0)
   {
      di_cond = g_adx_sell[tf][step].di_status[0].status;
      di_sample = g_adx_sell[tf][step].di_status[0].count;
      di_cov = di_sample * 100.0 / g_adx_sell[tf][step].total_trades;
      di_wr = g_adx_sell[tf][step].di_status[0].GetWinRate();
   }
   if(di_cond != "" && di_cov >= TH_DI_COVERAGE && filter_count < ArraySize(filters))
   {
      filters[filter_count].Set("DI", di_cond, di_cov, di_wr, di_sample);
      filter_count++;
   }
   //ADX
   string adx_range = BuildMergedADXRange(step, is_buy, tf);
   if(adx_range != "")
   {
      double adx_cov = 0, adx_wr = 0;
      int adx_sample = 0;
      CalculateADXCoverage(step, is_buy, tf, adx_cov, adx_wr, adx_sample);
      if(adx_cov >= TH_ADX_COVERAGE && filter_count < ArraySize(filters))
      {
         filters[filter_count].Set("ADX", adx_range, adx_cov, adx_wr, adx_sample);
         filter_count++;
      }
   }
   //EMA
   string ema_cond = BuildTopEMAPatterns(step, is_buy, tf, 3);
   if(ema_cond != "")
   {
      double ema_cov = 0, ema_wr = 0;
      int ema_sample = 0;
      CalculateEMACoverage(step, is_buy, tf, 3, ema_cov, ema_wr, ema_sample);
      if(ema_cov >= TH_EMA_COVERAGE && filter_count < ArraySize(filters))
      {
         filters[filter_count].Set("EMA", ema_cond, ema_cov, ema_wr, ema_sample);
         filter_count++;
      }
   }
   if(filter_count == 0) return "";
   //Sort once
   SortFiltersByWeight(filters, filter_count);
   //Apply penalty by rank (do not resort)
   for(int i = 0; i < filter_count; i++)
      filters[i].weight *= MathPow(0.85, i);
   int use_count = MathMin(filter_count, 2);
   string result = "";
   for(int i = 0; i < use_count; i++)
   {
      if(result != "") result += " AND ";
      result += filters[i].ToString();
   }
   return result;
}
void WriteDashboardFiltersV3(int h, int step, int tf)
{
   string box_title = inp_use_persian_language ?
      "📌 الگوهای غالب ورود (توصیه اجرایی مستقیم نیست)" :
      "📌 Dominant Entry Patterns (Not a direct trading rule)";
   string sub1 = inp_use_persian_language ?
      "این بخش فقط نشان می‌دهد کدام الگوها در داده‌های این Step پرتکرار بوده‌اند." :
      "This section only shows which entry patterns were most common in this step bucket.";
   string sub2 = inp_use_persian_language ?
      "⚠️ این‌ها لزوماً «فیلتر ورود معتبر» نیستند و باید با Auto Filter Mining / Validation جداگانه بررسی شوند." :
      "⚠️ These are NOT guaranteed executable entry filters and should be validated separately via Auto Filter Mining / out-of-sample testing.";
   string format_desc = inp_use_persian_language ?
      "فرمت: Indicator=Pattern [Coverage% | WinRate% | Weight]" :
      "Format: Indicator=Pattern [Coverage% | WinRate% | Weight]";
   string buy_label = inp_use_persian_language ? "BUY / خرید" : "BUY";
   string sell_label = inp_use_persian_language ? "SELL / فروش" : "SELL";
   string html = "<div class=\"filter-box\">\r\n";
   html += "<div class=\"filter-title\">" + box_title + " - " + g_lang.step + " " + IntegerToString(step + 1) + " (" + g_tf[tf].name + ")</div>\r\n";
   html += "<div style=\"font-size:10px;color:#aaa;margin-bottom:6px;line-height:1.7;\">" + sub1 + "</div>\r\n";
   html += "<div style=\"font-size:9px;color:#888;margin-bottom:8px;\">" + format_desc + "</div>\r\n";
   string buy_filter = BuildSmartFilterString(step, true, tf);
   string sell_filter = BuildSmartFilterString(step, false, tf);
   html += "<div class=\"filter-buy\">📈 " + buy_label + ": " +
           (buy_filter != "" ? buy_filter : g_lang.insufficient_data) + "</div>\r\n";
   html += "<div class=\"filter-sell\">📉 " + sell_label + ": " +
           (sell_filter != "" ? sell_filter : g_lang.insufficient_data) + "</div>\r\n";
   html += "<div style=\"font-size:9px;color:#666;margin-top:8px;border-top:1px solid #333;padding-top:8px;line-height:1.7;\">\r\n";
   html += sub2 + "<br>\r\n";
   html += (inp_use_persian_language ?
            "برای فیلتر اجرایی، خروجی Auto Filter Mining را ملاک قرار بده." :
            "Use Auto Filter Mining output for operational entry filters.");
   html += "</div>\r\n";
   html += "</div>\r\n";
   FileWriteString(h, html);
}
void WriteFeatureResearchSummary(int h)
{
   if(g_snapshot_count <= 0) return;
   double sum_atr_reg_main = 0, sum_adx_slope_main = 0, sum_ema_comp_main = 0;
   double sum_clv = 0, sum_body = 0, sum_ob_width_atr = 0;
   double sum_ob_age = 0;
   int cnt = 0, ob_age_cnt = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      sum_atr_reg_main   += g_snapshots[i].atr_regime[TF_IDX_MAIN];
      sum_adx_slope_main += g_snapshots[i].adx_slope[TF_IDX_MAIN];
      sum_ema_comp_main  += g_snapshots[i].ema_compression[TF_IDX_MAIN];
      sum_clv            += g_snapshots[i].signal_clv;
      sum_body           += g_snapshots[i].signal_body_ratio;
      sum_ob_width_atr   += g_snapshots[i].ob_width_atr;
      if(g_snapshots[i].ob_age_bars >= 0)
      {
         sum_ob_age += g_snapshots[i].ob_age_bars;
         ob_age_cnt++;
      }
      cnt++;
   }
   string html = "<div class=\"summary-card\">";
   html += "<h4>🔬 New Feature Research Summary</h4>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">ATR Regime (Main)</span><span class=\"stat-value\">" + DoubleToString(sum_atr_reg_main / MathMax(1, cnt), 3) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">ADX Slope (Main)</span><span class=\"stat-value\">" + DoubleToString(sum_adx_slope_main / MathMax(1, cnt), 3) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">EMA Compression (Main)</span><span class=\"stat-value\">" + DoubleToString(sum_ema_comp_main / MathMax(1, cnt), 3) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">Signal CLV</span><span class=\"stat-value\">" + DoubleToString(sum_clv / MathMax(1, cnt), 3) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">Signal Body Ratio</span><span class=\"stat-value\">" + DoubleToString(sum_body / MathMax(1, cnt), 3) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">OB Age Bars</span><span class=\"stat-value\">" + DoubleToString(sum_ob_age / MathMax(1, ob_age_cnt), 1) + "</span></div>";
   html += "<div class=\"stat-row\"><span class=\"stat-label\">OB Width / ATR</span><span class=\"stat-value\">" + DoubleToString(sum_ob_width_atr / MathMax(1, cnt), 3) + "</span></div>";
   html += "</div>\r\n";
   FileWriteString(h, html);
}
bool WriteDashboardSummaryV3(int h)
{
   string html = "<div id=\"summary\" class=\"tab-content\">\r\n";
   html += "<div class=\"section\">\r\n";
   html += "<div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">📊 SUMMARY</div>\r\n";
   int total_closed = 0;
   double total_profit = 0;
   int total_wins = 0;
   for(int i = 0; i < 5; i++)
   {
      total_closed += g_step_close_count[i];
      total_profit += g_step_close_profit[i];
      total_wins   += g_step_close_wins[i];
   }
   if(total_closed == 0)
   {
      html += "<div class=\"no-data\">📭 No analysis data available.<br><br>Run backtest or live trading to collect data.</div>\r\n";
      html += "</div>\r\n</div>\r\n";
      return (FileWriteString(h, html) > 0);
   }
   int safe_cnt = g_step_close_count[0] + g_step_close_count[1];
   double safe_profit = g_step_close_profit[0] + g_step_close_profit[1];
   int safe_wins = g_step_close_wins[0] + g_step_close_wins[1];
   int mod_cnt = g_step_close_count[2];
   double mod_profit = g_step_close_profit[2];
   int mod_wins = g_step_close_wins[2];
   int risky_cnt = g_step_close_count[3] + g_step_close_count[4];
   double risky_profit = g_step_close_profit[3] + g_step_close_profit[4];
   int risky_wins = g_step_close_wins[3] + g_step_close_wins[4];
   double safe_wr = (safe_cnt > 0) ? (safe_wins * 100.0 / safe_cnt) : 0;
   double mod_wr  = (mod_cnt  > 0) ? (mod_wins  * 100.0 / mod_cnt)  : 0;
   double risky_wr= (risky_cnt> 0) ? (risky_wins* 100.0 / risky_cnt): 0;
   double all_wr  = (total_closed > 0) ? (total_wins * 100.0 / total_closed) : 0;
   html += "<div class=\"summary-grid\">\r\n";
   html += "<div class=\"summary-card\">\r\n";
   html += "<h4>📊 Overall Performance</h4>\r\n";
   html += "<table class=\"summary-table\">\r\n";
   html += "<tr><th>Category</th><th>Trades</th><th>WinRate</th><th>Total Profit</th><th>Avg Profit/Trade</th></tr>\r\n";
   html += "<tr><td>SAFE (MaxStep &le; 2)</td>";
   html += "<td>" + IntegerToString(safe_cnt) + "</td>";
   html += "<td>" + DoubleToString(safe_wr, 1) + "%</td>";
   html += "<td>" + DoubleToString(safe_profit, 2) + "</td>";
   html += "<td>" + DoubleToString((safe_cnt > 0 ? safe_profit / safe_cnt : 0), 2) + "</td></tr>\r\n";
   html += "<tr><td>MODERATE (MaxStep = 3)</td>";
   html += "<td>" + IntegerToString(mod_cnt) + "</td>";
   html += "<td>" + DoubleToString(mod_wr, 1) + "%</td>";
   html += "<td>" + DoubleToString(mod_profit, 2) + "</td>";
   html += "<td>" + DoubleToString((mod_cnt > 0 ? mod_profit / mod_cnt : 0), 2) + "</td></tr>\r\n";
   html += "<tr><td>RISKY (MaxStep &ge; 4)</td>";
   html += "<td>" + IntegerToString(risky_cnt) + "</td>";
   html += "<td>" + DoubleToString(risky_wr, 1) + "%</td>";
   html += "<td>" + DoubleToString(risky_profit, 2) + "</td>";
   html += "<td>" + DoubleToString((risky_cnt > 0 ? risky_profit / risky_cnt : 0), 2) + "</td></tr>\r\n";
   html += "<tr><td><b>ALL CLOSED</b></td>";
   html += "<td><b>" + IntegerToString(total_closed) + "</b></td>";
   html += "<td><b>" + DoubleToString(all_wr, 1) + "%</b></td>";
   html += "<td><b>" + DoubleToString(total_profit, 2) + "</b></td>";
   html += "<td><b>" + DoubleToString((total_closed > 0 ? total_profit / total_closed : 0), 2) + "</b></td></tr>\r\n";
   html += "</table>\r\n";
   html += "</div>\r\n";
   if(FileWriteString(h, html) <= 0)
      return false;
   WriteFeatureResearchSummary(h);
   html = "</div>\r\n";   // close summary-grid
   html += "</div>\r\n";  // close section
   if(FileWriteString(h, html) <= 0)
      return false;
   WriteAutoFilterMiningSection(h);
   WritePathRiskClassificationSection(h);
   html = "</div>\r\n";
   return (FileWriteString(h, html) > 0);
}
//|WriteDashboardFooterV3 - LOCALIZED v8.0|
void WriteDashboardFooterV3(int h)
{
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   // JS fix — setZoom با یا بدون پارامتر دوم کار می‌کند
   string js_fix = "<script>\r\n";
   js_fix += "(function(){\r\n";
   js_fix += "  window.setZoom = function(level, btn){\r\n";
   js_fix += "    document.body.style.zoom = level;\r\n";
   js_fix += "    document.querySelectorAll('.zoom-btn').forEach(function(b){ b.classList.remove('active'); });\r\n";
   js_fix += "    var clickedBtn = btn || (event && event.target ? event.target.closest('.zoom-btn') : null);\r\n";
   js_fix += "    if(clickedBtn) clickedBtn.classList.add('active');\r\n";
   js_fix += "  };\r\n";
   js_fix += "})();\r\n";
   js_fix += "</script>\r\n";
   string html = js_fix;
   html += "<p style=\"text-align:center;color:#666;margin-top:30px;padding:20px;\">\r\n";
   html += "Divergence EA v8.0| " + g_lang.footer_text + "<br>\r\n";
   html += g_lang.press_keys + "<br>\r\n";
   html += "<small>&copy; " + IntegerToString(dt.year) + "</small>\r\n";
   html += "</p>\r\n</body></html>";
   FileWriteString(h, html);
}
//|END OF CODE|
