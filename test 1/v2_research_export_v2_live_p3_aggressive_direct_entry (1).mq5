   }
   hdr += "Stability_Score,DI_Agreement,EMA_Bullish_Count,HTF_Conflict,";
   hdr += "MTF_ADX_Strong,MTF_RSI_Bull,MTF_BB_Squeeze,MTF_MACD_Bull,MTF_Above_EMA200,";
