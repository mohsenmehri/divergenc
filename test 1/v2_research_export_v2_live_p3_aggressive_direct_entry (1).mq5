      if(s == "") s = "❓";
      for(int i = 0; i < di_count; i++)
      {
         if(di_status[i].status == s)
         {
            di_status[i].count++;
            di_status[i].total_profit += profit;
            if(profit > 0) di_status[i].win_count++;
            return;
         }
      }
      if(di_count < 5)
      {
         di_status[di_count].status = s;
         di_status[di_count].count = 1;
         di_status[di_count].total_profit = profit;
         di_status[di_count].win_count = (profit > 0) ? 1 : 0;
         di_count++;
      }
   }
   void AddEvent(string e, double profit)
   {
      is_sorted = false;
      if(e == "") e = "UNKNOWN";
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < adx_count - 1; i++)
         for(int j = i + 1; j < adx_count; j++)
            if(adx_ranges[j].count > adx_ranges[i].count)
            { SRangeData t = adx_ranges[i]; adx_ranges[i] = adx_ranges[j]; adx_ranges[j] = t; }
      for(int i = 0; i < di_count - 1; i++)
         for(int j = i + 1; j < di_count; j++)
            if(di_status[j].count > di_status[i].count)
            { SDIStatusData t = di_status[i]; di_status[i] = di_status[j]; di_status[j] = t; }
      for(int i = 0; i < event_count - 1; i++)
         for(int j = i + 1; j < event_count; j++)
            if(events[j].count > events[i].count)
            { SEventData t = events[i]; events[i] = events[j]; events[j] = t; }
      is_sorted = true;
   }
};
//|CCI STATS STRUCTURE - COMPLETE|
struct SCCIStats
{
   SRangeData ranges[50];
   SEventData events[20];
   int range_count, event_count, total_trades;
   double total_profit;
   int total_wins;
   int total_losses;
   bool is_sorted;
   void Reset()
   {
      range_count = event_count = total_trades = total_wins = total_losses = 0;
      total_profit = 0;
      is_sorted = false;
      for(int i = 0; i < 50; i++) { ranges[i].Reset(); }
      for(int i = 0; i < 20; i++) { events[i].Reset(); }
   }
   int GetRangeStart(double v)
   {
      double step = 25.0;
      int rs;
      if(v >= 0)
         rs = ((int)MathFloor(v / step)) * (int)step;
      else
         rs = ((int)MathFloor(v / step)) * (int)step;
      return rs;
   }
   void AddValue(double v, double profit)
   {
      is_sorted = false;
      total_trades++;
      total_profit += profit;
      if(profit > 0) total_wins++; else total_losses++;
      int rs = GetRangeStart(v);
      for(int i = 0; i < range_count; i++)
      {
         if(ranges[i].range_start == rs)
         {
            ranges[i].count++;
            ranges[i].total_profit += profit;
            if(profit > 0) ranges[i].win_count++;
            return;
         }
      }
      if(range_count < 50)
      {
         ranges[range_count].range_start = rs;
         ranges[range_count].range_end = rs + 25;
         ranges[range_count].count = 1;
         ranges[range_count].total_profit = profit;
         ranges[range_count].win_count = (profit > 0) ? 1 : 0;
         range_count++;
      }
   }
   void AddEvent(string e, double profit)
   {
      is_sorted = false;
      if(e == "") e = "UNKNOWN";
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < range_count - 1; i++)
         for(int j = i + 1; j < range_count; j++)
            if(ranges[j].count > ranges[i].count)
            { SRangeData t = ranges[i]; ranges[i] = ranges[j]; ranges[j] = t; }
      for(int i = 0; i < event_count - 1; i++)
         for(int j = i + 1; j < event_count; j++)
            if(events[j].count > events[i].count)
            { SEventData t = events[i]; events[i] = events[j]; events[j] = t; }
      is_sorted = true;
   }
};
//|ATR STATS STRUCTURE - COMPLETE|
struct SATRStats
{
   SATRRangeData ranges[30];
   SEventData events[20];
   int range_count, event_count, total_trades;
   double min_atr, max_atr, sum_atr;
   double total_profit;
   int total_wins;
   int total_losses;
   bool is_sorted;
   void Reset()
   {
      range_count = event_count = total_trades = total_wins = total_losses = 0;
      min_atr = DBL_MAX; max_atr = sum_atr = total_profit = 0;
      is_sorted = false;
      for(int i = 0; i < 30; i++) { ranges[i].Reset(); }
      for(int i = 0; i < 20; i++) { events[i].Reset(); }
   }
   void AddValue(double v, int digits, double profit)
   {
      is_sorted = false;
      total_trades++;
      sum_atr += v;
      total_profit += profit;
      if(profit > 0) total_wins++; else total_losses++;
      if(v < min_atr) min_atr = v;
      if(v > max_atr) max_atr = v;
      double step = MathPow(10, -digits) * 10;
      double rs = MathFloor(v / step) * step;
      for(int i = 0; i < range_count; i++)
      {
         if(MathAbs(ranges[i].range_start - rs) < step * 0.01)
         {
            ranges[i].count++;
            ranges[i].total_profit += profit;
            if(profit > 0) ranges[i].win_count++;
            return;
         }
      }
      if(range_count < 30)
      {
         ranges[range_count].range_start = rs;
         ranges[range_count].range_end = rs + step;
         ranges[range_count].count = 1;
         ranges[range_count].total_profit = profit;
         ranges[range_count].win_count = (profit > 0) ? 1 : 0;
         range_count++;
      }
   }
   void AddEvent(string e, double profit)
   {
      is_sorted = false;
      if(e == "") e = "UNKNOWN";
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
   double GetAverage() { return (total_trades > 0) ? sum_atr / total_trades : 0; }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < range_count - 1; i++)
         for(int j = i + 1; j < range_count; j++)
            if(ranges[j].count > ranges[i].count)
            { SATRRangeData t = ranges[i]; ranges[i] = ranges[j]; ranges[j] = t; }
      for(int i = 0; i < event_count - 1; i++)
         for(int j = i + 1; j < event_count; j++)
            if(events[j].count > events[i].count)
            { SEventData t = events[i]; events[i] = events[j]; events[j] = t; }
      is_sorted = true;
   }
};
//|PIVOT DISTANCE STATS STRUCTURE - COMPLETE|
struct SPivotDistStats
{
   SPivotDistData pivot1[50];
   SPivotDistData pivot2[50];
   SEventData events[20];
   int p1_count, p2_count, event_count, total_trades;
   double total_profit;
   int total_wins;
   int total_losses;
   bool is_sorted;
   void Reset()
   {
      p1_count = p2_count = event_count = total_trades = total_wins = total_losses = 0;
      total_profit = 0;
      is_sorted = false;
      for(int i = 0; i < 50; i++) { pivot1[i].Reset(); pivot2[i].Reset(); }
      for(int i = 0; i < 20; i++) { events[i].Reset(); }
   }
   int GetRangeStart(int d)
   {
      if(d < 0) d = 0;
      return (d / 5) * 5;
   }
   void AddP1(int d, double profit)
   {
      // ⚠️ این تابع را مستقیم استفاده نکن! از AddTrade استفاده کن
      if(d < 0) d = 0;
      int rs = GetRangeStart(d);
      for(int i = 0; i < p1_count; i++)
      {
         if(pivot1[i].dist == rs)
         {
            pivot1[i].count++;
            pivot1[i].total_profit += profit;
            if(profit > 0) pivot1[i].win_count++;
            return;
         }
      }
      if(p1_count < 50)
      {
         pivot1[p1_count].dist = rs;
         pivot1[p1_count].count = 1;
         pivot1[p1_count].total_profit = profit;
         pivot1[p1_count].win_count = (profit > 0) ? 1 : 0;
         p1_count++;
      }
   }
   void AddP2(int d, double profit)
   {
      // ⚠️ این تابع را مستقیم استفاده نکن! از AddTrade استفاده کن
      if(d < 0) d = 0;
      int rs = GetRangeStart(d);
      for(int i = 0; i < p2_count; i++)
      {
         if(pivot2[i].dist == rs)
         {
            pivot2[i].count++;
            pivot2[i].total_profit += profit;
            if(profit > 0) pivot2[i].win_count++;
            return;
         }
      }
      if(p2_count < 50)
      {
         pivot2[p2_count].dist = rs;
         pivot2[p2_count].count = 1;
         pivot2[p2_count].total_profit = profit;
         pivot2[p2_count].win_count = (profit > 0) ? 1 : 0;
         p2_count++;
      }
   }
   void AddEvent(string e, double profit)
   {
      is_sorted = false;
      if(e == "") e = "UNKNOWN";
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
      void AddTrade(int p1_dist, int p2_dist, double profit, string event_name)
      {
         is_sorted = false;
         total_trades++;
         total_profit += profit;
         if(profit > 0) total_wins++; else total_losses++;
         //P1
         if(p1_dist >= 0)
         {
            int rs = GetRangeStart(p1_dist);
            bool found = false;
            for(int i = 0; i < p1_count; i++)
            {
               if(pivot1[i].dist == rs)
               {
                  pivot1[i].count++;
                  pivot1[i].total_profit += profit;
                  if(profit > 0) pivot1[i].win_count++;
                  found = true;
                  break;
               }
            }
            if(!found && p1_count < 50)
            {
               pivot1[p1_count].dist = rs;
               pivot1[p1_count].count = 1;
               pivot1[p1_count].total_profit = profit;
               pivot1[p1_count].win_count = (profit > 0) ? 1 : 0;
               p1_count++;
            }
         }
         //P2
         if(p2_dist >= 0)
         {
            int rs = GetRangeStart(p2_dist);
            bool found = false;
            for(int i = 0; i < p2_count; i++)
            {
               if(pivot2[i].dist == rs)
               {
                  pivot2[i].count++;
                  pivot2[i].total_profit += profit;
                  if(profit > 0) pivot2[i].win_count++;
                  found = true;
                  break;
               }
            }
            if(!found && p2_count < 50)
            {
               pivot2[p2_count].dist = rs;
               pivot2[p2_count].count = 1;
               pivot2[p2_count].total_profit = profit;
               pivot2[p2_count].win_count = (profit > 0) ? 1 : 0;
               p2_count++;
            }
         }
         //Event
         AddEvent(event_name, profit);
      }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < p1_count - 1; i++)
         for(int j = i + 1; j < p1_count; j++)
            if(pivot1[j].count > pivot1[i].count)
            { SPivotDistData t = pivot1[i]; pivot1[i] = pivot1[j]; pivot1[j] = t; }
      for(int i = 0; i < p2_count - 1; i++)
         for(int j = i + 1; j < p2_count; j++)
            if(pivot2[j].count > pivot2[i].count)
            { SPivotDistData t = pivot2[i]; pivot2[i] = pivot2[j]; pivot2[j] = t; }
      for(int i = 0; i < event_count - 1; i++)
         for(int j = i + 1; j < event_count; j++)
            if(events[j].count > events[i].count)
            { SEventData t = events[i]; events[i] = events[j]; events[j] = t; }
      is_sorted = true;
   }
};
//|ENHANCED STABILITY SCORE|
struct SEnhancedStability
{
   int rsi_alignment;
   int di_consistency;
   int ema_order_match;
   int trend_strength;
   int penalty_total;
   string penalty_reasons;
   bool has_killer_flaw;
   int raw_score;
   int final_score;
   int score_cap;
   void Reset()
   {
      rsi_alignment = di_consistency = ema_order_match = trend_strength = 0;
      penalty_total = 0;
      penalty_reasons = "";
      has_killer_flaw = false;
      raw_score = final_score = 0;
      score_cap = 100;
   }
   int GetTotal()
   {
      return MathMax(0, MathMin(100, final_score));
   }
   string GetRating()
   {
      int score = GetTotal();
      if(has_killer_flaw) return "[X]";
      if(score >= 80) return "*****";
      if(score >= 60) return "****";
      if(score >= 40) return "***";
      if(score >= 20) return "**";
      return "*";
   }
   string GetRatingText()
   {
      int score = GetTotal();
      if(has_killer_flaw) return "Flawed";
      if(score >= 80) return "Excellent";
      if(score >= 60) return "Good";
      if(score >= 40) return "Average";
      if(score >= 20) return "Weak";
      return "Poor";
   }
};
//|SDominanceResult - COMPLETE v8.1 WITH TOOLTIPS|
struct SDominanceResult
{
   ENUM_DISTRIBUTION_TYPE type;
   string top1_value;
   string top2_value;
   int top1_count;
   int top2_count;
   double top1_pct;
   double top2_pct;
   double gap;
   int total;
   bool is_reliable;
   bool is_displayable;
   string badge;
   string display_text;
   string tooltip;
   //|Reset all fields|
   void Reset()
   {
      type = DIST_NO_DATA;
      top1_value = top2_value = "";
      top1_count = top2_count = 0;
      top1_pct = top2_pct = gap = 0;
      total = 0;
      is_reliable = is_displayable = false;
      badge = display_text = tooltip = "";
   }
   //|Analyze distribution pattern|
   void Analyze(int count1, int count2, int sample_total, string val1, string val2)
   {
      Reset();
      total = sample_total;
      top1_value = val1;
      top2_value = val2;
      top1_count = count1;
      top2_count = count2;
      //No data case
      if(sample_total == 0)
      {
         type = DIST_NO_DATA;
         badge = "[.]";
         display_text = g_lang.no_data_word;
         tooltip = g_lang.no_data_word;
         return;
      }
      //Low sample case
      if(sample_total < inp_min_sample_display)
      {
         type = DIST_LOW_SAMPLE;
         is_displayable = false;
         is_reliable = false;
         badge = "[!!]";
         display_text = g_lang.low_sample_word + " (" + IntegerToString(sample_total) + ")";
         tooltip = StringFormat(g_lang.need_min_trades, inp_min_sample_display);
         return;
      }
      //Can display
      is_displayable = true;
      is_reliable = (sample_total >= inp_min_sample_reliable);
      //Calculate percentages
      top1_pct = count1 * 100.0 / sample_total;
      top2_pct = count2 * 100.0 / sample_total;
      gap = top1_pct - top2_pct;
      //Determine distribution type
      if(gap >= inp_dominance_gap && top1_pct >= inp_dominance_min_pct)
      {
         //DOMINANT pattern
         type = DIST_DOMINANT;
         badge = "[D]";
         display_text = val1 + " (" + DoubleToString(top1_pct, 0) + "%)";
         tooltip = g_lang.dominant + ". Gap: " + DoubleToString(gap, 1) + "%";
         if(!is_reliable)
         {
            badge = "[D*]";
            tooltip += " (" + g_lang.low_sample_word + ")";
         }
      }
      else if(top1_pct + top2_pct >= inp_polarized_sum && gap < inp_dominance_gap)
      {
         //POLARIZED pattern
         type = DIST_POLARIZED;
         badge = "[P]";
         display_text = val1 + "/" + val2;
         tooltip = g_lang.polarized + ": " +
                   DoubleToString(top1_pct, 0) + "% vs " +
                   DoubleToString(top2_pct, 0) + "%";
      }
      else
      {
         //MIXED pattern
         type = DIST_MIXED;
         is_reliable = false;
         badge = "[M]";
         display_text = g_lang.mixed;
         tooltip = g_lang.mixed + ". " + g_lang.top + ": " + DoubleToString(top1_pct, 0) + "%";
      }
   }
   //|Get HTML representation with tooltips - v8.1|
   string GetHTML(string cell_class = "")
   {
      string cls = cell_class;
      string full_tooltip = tooltip;
      switch(type)
      {
         case DIST_DOMINANT:
            cls += is_reliable ? " dominant-reliable" : " dominant-weak";
            full_tooltip += " | " + g_lang.tooltip_dominance;
            break;
         case DIST_POLARIZED:
            cls += " polarized";
            full_tooltip += " | " + g_lang.tooltip_polarized;
            break;
         case DIST_MIXED:
            cls += " mixed";
            break;
         case DIST_LOW_SAMPLE:
            cls += " low-sample";
            full_tooltip += " | " + g_lang.tooltip_sample_size;
            break;
         default:
            cls += " no-data";
            break;
      }
      StringTrimLeft(cls);
      string safe_tt = EscapeHTMLAttr(full_tooltip);
      string sample_info = "";
      if(total > 0)
      {
         string sig_class = GetSignificanceClass(total);
         string sig_text  = GetSignificanceText(total);
         string sig_badge = GetSignificanceBadge(total);
         // sig_text هم باید safe شود
         string safe_sig = EscapeHTMLAttr(sig_text + " (n=" + IntegerToString(total) + ")");
         sample_info = " <span class=\"sample-badge " + sig_class +
                       "\" title=\"" + safe_sig + "\">" + sig_badge + "</span>";
      }
      return "<span class=\"" + cls + "\" title=\"" + safe_tt + "\">" +
             badge + " " + display_text + sample_info + "</span>";
   }
   //|Get CSV representation|
   string GetCSV()
   {
      switch(type)
      {
         case DIST_DOMINANT:
            return display_text + (is_reliable ? "" : " [WEAK]");
         case DIST_POLARIZED:
            return g_lang.polarized + ":" + display_text;
         case DIST_MIXED:
            return g_lang.mixed;
         case DIST_LOW_SAMPLE:
            return g_lang.low_sample_word + ":" + IntegerToString(total);
         default:
            return g_lang.no_data_word;
      }
   }
   //|Get plain text representation|
   string GetText()
   {
      return badge + " " + display_text;
   }
   //|Check if distribution is strong enough for trading|
   bool IsStrongForTrading()
   {
      return (type == DIST_DOMINANT && is_reliable && top1_pct >= 50.0);
   }
   //|Get color code for visualization|
   color GetColor()
   {
      switch(type)
      {
         case DIST_DOMINANT:
            return is_reliable ? clrLime : clrYellow;
         case DIST_POLARIZED:
            return clrGold;
         case DIST_MIXED:
            return clrGray;
         case DIST_LOW_SAMPLE:
            return clrOrange;
         default:
            return clrDimGray;
      }
   }
   //|Get detailed statistics string|
   string GetDetailedStats()
   {
      if(total == 0)
         return g_lang.no_data_word;
      string result = "";
      result += "Total: " + IntegerToString(total) + "| ";
      result += "Top1: " + top1_value + " (" + DoubleToString(top1_pct, 1) + "%)| ";
      if(top2_count > 0)
      {
         result += "Top2: " + top2_value + " (" + DoubleToString(top2_pct, 1) + "%)| ";
         result += "Gap: " + DoubleToString(gap, 1) + "%";
      }
      return result;
   }
   //|Export to JSON format|
   string ToJSON()
   {
      string json = "{";
      json += "\"type\":\"" + EnumToString(type) + "\",";
      json += "\"badge\":\"" + badge + "\",";
      json += "\"display_text\":\"" + display_text + "\",";
      json += "\"top1_value\":\"" + top1_value + "\",";
      json += "\"top1_count\":" + IntegerToString(top1_count) + ",";
      json += "\"top1_pct\":" + DoubleToString(top1_pct, 2) + ",";
      json += "\"top2_value\":\"" + top2_value + "\",";
      json += "\"top2_count\":" + IntegerToString(top2_count) + ",";
      json += "\"top2_pct\":" + DoubleToString(top2_pct, 2) + ",";
      json += "\"gap\":" + DoubleToString(gap, 2) + ",";
      json += "\"total\":" + IntegerToString(total) + ",";
      json += "\"is_reliable\":" + (is_reliable ? "true" : "false") + ",";
      json += "\"is_displayable\":" + (is_displayable ? "true" : "false");
      json += "}";
      return json;
   }
};
//|SMTFAgreement - LOCALIZED v8.1|
struct SMTFAgreement
{
   ENUM_MTF_AGREEMENT type;
   int agree_count;
   int neutral_count;
   int conflict_count;
   int total_valid;
   bool htf_agrees;
   string badge;
   string details;
   string recommendation;
   void Reset()
   {
      type = MTF_NO_DATA;
      agree_count = neutral_count = conflict_count = total_valid = 0;
      htf_agrees = false;
      badge = details = recommendation = "";
   }
   void Calculate(bool is_buy, int step);
   void DetermineType();
   void BuildOutput();
   string GetHTML();
   bool ShouldProceed() { return (type == MTF_STRONG_AGREE|| type == MTF_PARTIAL_AGREE); }
   bool HasConflict() { return (type == MTF_PARTIAL_CONFLICT|| type == MTF_STRONG_CONFLICT); }
};
bool SafeAddToRangeArray(SRangeData &arr[], int &count, int max_size,
                         int range_start, int range_end, double profit)
{
   //Check for existing range
   for(int i = 0; i < count; i++)
   {
      if(arr[i].range_start == range_start)
      {
         arr[i].count++;
         arr[i].total_profit += profit;
         if(profit > 0) arr[i].win_count++;
         else arr[i].loss_count++;
         return true;
      }
   }
   //? FIX: Bounds check before adding new element
   if(count >= max_size)
   {
      //Optional: Remove least significant entry
      int min_idx = 0;
      int min_count = arr[0].count;
      for(int i = 1; i < count; i++)
      {
         if(arr[i].count < min_count)
         {
            min_count = arr[i].count;
            min_idx = i;
         }
      }
      //Replace if new entry would be more significant (count >= 1)
      arr[min_idx].range_start = range_start;
      arr[min_idx].range_end = range_end;
      arr[min_idx].count = 1;
      arr[min_idx].total_profit = profit;
      arr[min_idx].win_count = (profit > 0) ? 1 : 0;
      arr[min_idx].loss_count = (profit <= 0) ? 1 : 0;
      return true;
   }
   //Add new entry
   arr[count].range_start = range_start;
   arr[count].range_end = range_end;
   arr[count].count = 1;
   arr[count].total_profit = profit;
   arr[count].win_count = (profit > 0) ? 1 : 0;
   arr[count].loss_count = (profit <= 0) ? 1 : 0;
   count++;
   return true;
}
//|SMTFAgreement::Calculate - Implementation|
void SMTFAgreement::Calculate(bool is_buy, int step)
{
   Reset();
   if(step < 0 || step >= 5)
   {
      type = MTF_NO_DATA;
      return;
   }
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      int total_trades = 0;
      if(is_buy)
         total_trades = g_ema_buy[tf][step].total_trades;
      else
         total_trades = g_ema_sell[tf][step].total_trades;
      if(total_trades < inp_min_sample_display)
         continue;
      total_valid++;
      string expected_di = is_buy ? "+" : "-";
      bool di_agrees = false;
      if(is_buy && g_adx_buy[tf][step].di_count > 0)
      {
         string top_di = g_adx_buy[tf][step].di_status[0].status;
         di_agrees = (top_di == expected_di);
      }
      else if(!is_buy && g_adx_sell[tf][step].di_count > 0)
      {
         string top_di = g_adx_sell[tf][step].di_status[0].status;
         di_agrees = (top_di == expected_di);
      }
      string expected_ema = is_buy ? "E20>E50>E100>E200" : "E200>E100>E50>E20";
      bool ema_agrees = false;
      if(is_buy && g_ema_buy[tf][step].pattern_count > 0)
      {
         string top_ema = g_ema_buy[tf][step].patterns[0].pattern;
         ema_agrees = (top_ema == expected_ema);
      }
      else if(!is_buy && g_ema_sell[tf][step].pattern_count > 0)
      {
         string top_ema = g_ema_sell[tf][step].patterns[0].pattern;
         ema_agrees = (top_ema == expected_ema);
      }
      if(di_agrees && ema_agrees)
         agree_count++;
      else if(!di_agrees && !ema_agrees)
         conflict_count++;
      else
         neutral_count++;
      // ✅ استفاده از TF_IDX به جای عدد
      if(tf == TF_IDX_H4 || tf == TF_IDX_H1)
      {
         if(di_agrees)
            htf_agrees = true;
      }
   }
   DetermineType();
   BuildOutput();
}
//|SMTFAgreement::DetermineType - Implementation|
void SMTFAgreement::DetermineType()
{
   if(total_valid == 0)
   {
      type = MTF_NO_DATA;
      return;
   }
   double agree_pct = (agree_count * 100.0) / total_valid;
   double conflict_pct = (conflict_count * 100.0) / total_valid;
   //Strong agreement: >70% agree + HTF agrees
   if(agree_pct >= 70 && htf_agrees)
      type = MTF_STRONG_AGREE;
   //Partial agreement: >50% agree
   else if(agree_pct >= 50)
      type = MTF_PARTIAL_AGREE;
   //Strong conflict: >50% conflict OR HTF conflicts
   else if(conflict_pct >= 50|| !htf_agrees)
      type = MTF_STRONG_CONFLICT;
   //Partial conflict: >30% conflict
   else if(conflict_pct >= 30)
      type = MTF_PARTIAL_CONFLICT;
   //Neutral: mixed signals
   else
      type = MTF_NEUTRAL;
}
//|SMTFAgreement::BuildOutput - Implementation|
void SMTFAgreement::BuildOutput()
{
   switch(type)
   {
      case MTF_STRONG_AGREE:
         badge = "✓✓";
         details = g_lang.mtf_strong_agree;
         recommendation = "TAKE";
         break;
      case MTF_PARTIAL_AGREE:
         badge = "✓";
         details = g_lang.mtf_partial_agree;
         recommendation = "OK";
         break;
      case MTF_NEUTRAL:
         badge = "~";
         details = g_lang.mtf_neutral;
         recommendation = "NEUTRAL";
         break;
      case MTF_PARTIAL_CONFLICT:
         badge = "⚠";
         details = g_lang.mtf_partial_conflict;
         recommendation = "RISKY";
         break;
      case MTF_STRONG_CONFLICT:
         badge = "✗✗";
         details = g_lang.mtf_strong_conflict;
         recommendation = "AVOID";
         break;
      default:
         badge = "-";
         details = g_lang.mtf_no_data;
         recommendation = "N/A";
         break;
   }
   //Add counts to details
   if(total_valid > 0)
   {
      details += " (" + IntegerToString(agree_count) + "/" +
                 IntegerToString(neutral_count) + "/" +
                 IntegerToString(conflict_count) + ")";
   }
}
//|SMTFAgreement::GetHTML - Implementation|
string SMTFAgreement::GetHTML()
{
   string css_class = "";
   switch(type)
   {
      case MTF_STRONG_AGREE:     css_class = "mtf-strong-agree"; break;
      case MTF_PARTIAL_AGREE:    css_class = "mtf-partial-agree"; break;
      case MTF_NEUTRAL:          css_class = "mtf-neutral"; break;
      case MTF_PARTIAL_CONFLICT: css_class = "mtf-partial-conflict"; break;
      case MTF_STRONG_CONFLICT:  css_class = "mtf-strong-conflict"; break;
      default:                   css_class = "mtf-no-data"; break;
   }
   string safe_details = EscapeHTMLAttr(details);
   return "<span class=\"" + css_class + "\" title=\"" + safe_details + "\">" +
          badge + " " + recommendation + "</span>";
}
//|SORTED VIEW - v7.8 (No Mutation)|
struct SSortedView
{
   int indices[100];
   int count;
   void Reset() { count = 0; ArrayInitialize(indices, -1); }
   void BuildFromPatterns(const SPatternData &arr[], int arr_count)
   {
      count = MathMin(arr_count, 100);
      for(int i = 0; i < count; i++) indices[i] = i;
      for(int i = 0; i < count - 1; i++)
         for(int j = i + 1; j < count; j++)
            if(arr[indices[j]].count > arr[indices[i]].count)
            { int t = indices[i]; indices[i] = indices[j]; indices[j] = t; }
   }
   void BuildFromRanges(const SRangeData &arr[], int arr_count)
   {
      count = MathMin(arr_count, 100);
      for(int i = 0; i < count; i++) indices[i] = i;
      for(int i = 0; i < count - 1; i++)
         for(int j = i + 1; j < count; j++)
            if(arr[indices[j]].count > arr[indices[i]].count)
            { int t = indices[i]; indices[i] = indices[j]; indices[j] = t; }
   }
   void BuildFromDI(const SDIStatusData &arr[], int arr_count)
   {
      count = MathMin(arr_count, 100);
      for(int i = 0; i < count; i++) indices[i] = i;
      for(int i = 0; i < count - 1; i++)
         for(int j = i + 1; j < count; j++)
            if(arr[indices[j]].count > arr[indices[i]].count)
            { int t = indices[i]; indices[i] = indices[j]; indices[j] = t; }
   }
   void BuildFromEvents(const SEventData &arr[], int arr_count)
   {
      count = MathMin(arr_count, 100);
      for(int i = 0; i < count; i++) indices[i] = i;
      for(int i = 0; i < count - 1; i++)
         for(int j = i + 1; j < count; j++)
            if(arr[indices[j]].count > arr[indices[i]].count)
            { int t = indices[i]; indices[i] = indices[j]; indices[j] = t; }
   }
   int Get(int rank) { return (rank >= 0 && rank < count) ? indices[rank] : -1; }
   bool IsValid(int rank) { return (rank >= 0 && rank < count && indices[rank] >= 0); }
};
//|MTF PATTERN STRUCTURE|
struct SMTFPattern
{
   int pattern_id;
   datetime entry_time;
   datetime exit_time;
   bool is_bullish;
   int max_step_reached;
   double profit;
   bool is_win;
   string close_event;
   int rsi_range[TF_COUNT];
   int adx_range[TF_COUNT];
   int cci_range[TF_COUNT];
   double atr_value[TF_COUNT];
   string di_status[TF_COUNT];
   string ema_order[TF_COUNT];
   string position_status[TF_COUNT];
   double atr_regime[TF_COUNT];
   double adx_slope[TF_COUNT];
   double ema_compression[TF_COUNT];
   double signal_clv;
   double signal_body_ratio;
   int    ob_age_bars;
   double ob_width_atr;
   string tp_status_path;
   bool   hit_tp1;
   bool   hit_tp2;
   bool   hit_ema200;
   double plus_di_value[TF_COUNT];
   double minus_di_value[TF_COUNT];
   int pivot1_dist;
   int pivot2_dist;
   SEnhancedStability stability;
   string composite_signature;
   string rsi_signature;
   string di_signature;
   void Reset()
   {
      pattern_id = 0;
      entry_time = exit_time = 0;
      is_bullish = is_win = false;
      max_step_reached = 0;
      profit = 0;
      close_event = "";
      pivot1_dist = pivot2_dist = 0;
      composite_signature = rsi_signature = di_signature = "";
      stability.Reset();
      for(int i = 0; i < TF_COUNT; i++)
      {
         rsi_range[i] = adx_range[i] = cci_range[i] = -1;
         atr_value[i] = 0;
         di_status[i] = ".";
         ema_order[i] = "N/A";
         position_status[i] = "N/A";
         plus_di_value[i] = 0;
         minus_di_value[i] = 0;
      }
   }
   string BuildRSISignature()
   {
      string sig = "";
      for(int i = 0; i < TF_COUNT; i++)
      {
         sig += (rsi_range[i] >= 0) ? IntegerToString(rsi_range[i]) : "X";
         if(i < TF_COUNT - 1) sig += ">";
      }
      rsi_signature = sig;
      return sig;
   }
   string BuildDISignature()
   {
      string sig = "";
      for(int i = 0; i < TF_COUNT; i++)
         sig += di_status[i];
      di_signature = sig;
      return sig;
   }
   string BuildCompositeSignature()
   {
      int rising = 0, falling = 0;
      for(int i = 1; i < TF_COUNT; i++)
      {
         if(rsi_range[i] < 0|| rsi_range[i-1] < 0) continue;
         if(rsi_range[i] > rsi_range[i-1]) rising++;
         else if(rsi_range[i] < rsi_range[i-1]) falling++;
      }
      string rsi_trend = (rising >= 3) ? "RSI+" : (falling >= 3) ? "RSI-" : "RSI~";
      int plus = 0, minus = 0;
      for(int i = 0; i < TF_COUNT; i++)
      {
         if(di_status[i] == "+") plus++;
         else if(di_status[i] == "-") minus++;
      }
      string di_pat = (plus >= 5) ? "DI:ALL+" : (minus >= 5) ? "DI:ALL-" :
                      (plus >= 4) ? "DI:4+" : (minus >= 4) ? "DI:4-" : "DI:MIX";
      string bullish = "E20>E50>E100>E200";
      string bearish = "E200>E100>E50>E20";
      int bull_cnt = 0, bear_cnt = 0;
      for(int i = 0; i < TF_COUNT; i++)
      {
         if(ema_order[i] == bullish) bull_cnt++;
         else if(ema_order[i] == bearish) bear_cnt++;
      }
      string ema_pat = (bull_cnt >= 4) ? "EMA:BULL" : (bear_cnt >= 4) ? "EMA:BEAR" : "EMA:MIX";
      int strong = 0;
      for(int i = 4; i < TF_COUNT; i++)
         if(adx_range[i] >= 25) strong++;
      string adx_str = (strong >= 2) ? "ADX:STRONG" : (strong >= 1) ? "ADX:MED" : "ADX:WEAK";
      composite_signature = rsi_trend + "|" + di_pat + "|" + ema_pat + "|" + adx_str;
      return composite_signature;
   }
   int CountDIPlus()
   {
      int cnt = 0;
      for(int i = 0; i < TF_COUNT; i++)
         if(di_status[i] == "+") cnt++;
      return cnt;
   }
   int CountDIMinus()
   {
      int cnt = 0;
      for(int i = 0; i < TF_COUNT; i++)
         if(di_status[i] == "-") cnt++;
      return cnt;
   }
};
//|SMTFSignatureStats - COMPLETE with Localized GetRecommendation|
struct SMTFSignatureStats
{
   string signature;
   int total_count;
   int step_counts[5];
   double step_profits[5];
   int step_wins[5];
   double total_profit;
   int total_wins;
   double entropy_score;
   double reliability_score;
   void Reset()
   {
      signature = "";
      total_count = total_wins = 0;
      total_profit = entropy_score = reliability_score = 0;
      ArrayInitialize(step_counts, 0);
      ArrayInitialize(step_profits, 0);
      ArrayInitialize(step_wins, 0);
   }
   double GetWinRate() { return (total_count > 0) ? (total_wins * 100.0 / total_count) : 0; }
   double GetAvgStep()
   {
      if(total_count == 0) return 0;
      double sum = 0;
      for(int s = 0; s < 5; s++) sum += step_counts[s] * (s + 1);
      return sum / total_count;
   }
   double GetAvgProfit() { return (total_count > 0) ? (total_profit / total_count) : 0; }
   void CalculateEntropy()
   {
      if(total_count < 5) { entropy_score = 1.0; reliability_score = 0; return; }
      double entropy = 0;
      for(int s = 0; s < 5; s++)
      {
         if(step_counts[s] > 0)
         {
            double p = (double)step_counts[s] / total_count;
            entropy -= p * MathLog(p) / MathLog(5.0);
         }
      }
      entropy_score = entropy;
      double sample_factor = MathSqrt(MathMin(total_count, 50) / 20.0);
      double wr = GetWinRate() / 100.0;
      reliability_score = wr * (1 - entropy_score) * sample_factor * 100;
   }
   void AddTrade(int step, double profit, bool is_win)
   {
      if(step < 1|| step > 5) return;
      total_count++;
      total_profit += profit;
      if(is_win) total_wins++;
      step_counts[step - 1]++;
      step_profits[step - 1] += profit;
      if(is_win) step_wins[step - 1]++;
      if(total_count >= 5) CalculateEntropy();
   }
   string GetRecommendation()
   {
      if(total_count < 5) return g_lang.need_data;
      double wr = GetWinRate();
      double avg_step = GetAvgStep();
      if(reliability_score >= 60 && wr >= 55 && avg_step <= 2.5) return g_lang.mtf_strong_rec;
      if(reliability_score >= 40 && wr >= 50 && avg_step <= 3.0) return g_lang.mtf_okay_rec;
      if(entropy_score >= 0.7|| wr < 40) return g_lang.mtf_avoid_rec;
      if(avg_step >= 3.5) return g_lang.mtf_risky_rec;
      return g_lang.mtf_neutral_rec;
   }
};
//|MTF DECISION RULE|
struct SMTFDecisionRule
{
   string name;
   string condition;
   int trades_matching;
   int trades_not_matching;
   double wr_matching;
   double wr_not_matching;
   double avg_step_matching;
   double avg_step_not_matching;
   double profit_matching;
   double profit_not_matching;
   double impact_score;
   void Reset()
   {
      name = condition = "";
      trades_matching = trades_not_matching = 0;
      wr_matching = wr_not_matching = avg_step_matching = avg_step_not_matching = 0;
      profit_matching = profit_not_matching = impact_score = 0;
   }
   void CalculateImpact()
   {
      double wr_diff = wr_matching - wr_not_matching;
      double step_diff = avg_step_not_matching - avg_step_matching;
      double profit_diff = profit_matching - profit_not_matching;
      impact_score = (wr_diff * 0.4) + (step_diff * 15) + (profit_diff * 0.01);
      if(trades_matching < 10|| trades_not_matching < 10) impact_score *= 0.5;
   }
   string GetVerdict()
   {
      if(impact_score >= 20) return "⚠️ CRITICAL";
      if(impact_score >= 10) return "📌 IMPORTANT";
      if(impact_score >= 5) return "💡 USEFUL";
      return "📝 MINOR";
   }
};
//|MTF ANALYSIS STATS|
struct SMTFAnalysisStats
{
   SMTFPattern patterns[MAX_MTF_PATTERNS];
   int pattern_count;
   SMTFSignatureStats rsi_signatures[MAX_SIGNATURES];
   SMTFSignatureStats di_signatures[MAX_SIGNATURES];
   SMTFSignatureStats composite_signatures[MAX_SIGNATURES];
   int rsi_sig_count;
   int di_sig_count;
   int composite_sig_count;
   int stability_distribution[11];
   double stability_profits[11];
   int stability_wins[11];
   int stability_step_sum[11];
   SMTFDecisionRule rules[10];
   int rule_count;
   void Reset()
   {
      pattern_count = rsi_sig_count = di_sig_count = composite_sig_count = rule_count = 0;
      ArrayInitialize(stability_distribution, 0);
      ArrayInitialize(stability_profits, 0);
      ArrayInitialize(stability_wins, 0);
      ArrayInitialize(stability_step_sum, 0);
      for(int i = 0; i < MAX_MTF_PATTERNS; i++) patterns[i].Reset();
      for(int i = 0; i < MAX_SIGNATURES; i++)
      {
         rsi_signatures[i].Reset();
         di_signatures[i].Reset();
         composite_signatures[i].Reset();
      }
      for(int i = 0; i < 10; i++) rules[i].Reset();
   }
};
