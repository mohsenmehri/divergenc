      for(int i = 0; i < 25; i++) { adx_ranges[i].Reset(); }
      for(int i = 0; i < 5; i++) { di_status[i].Reset(); }
      for(int i = 0; i < 20; i++) { events[i].Reset(); }
   }
   int GetRangeStart(double v)
   {
      if(v < 0) v = 0;
      if(v >= 100) v = 99.99;
      return ((int)MathFloor(v / 5.0)) * 5;
   }
   void AddADX(double v, double profit)
   {
