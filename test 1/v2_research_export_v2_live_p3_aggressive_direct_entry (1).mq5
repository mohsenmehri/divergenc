      case 117: { double v=sn.dist_week_open_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 118: { double v=sn.dist_week_high_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 119: { double v=sn.dist_week_low_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 120: { double v=sn.week_range_position; out=v; return (MathIsValidNumber(v)); }
      case 121: { double v=sn.dist_round_level_atr; out=v; return (MathIsValidNumber(v) && v>=0.0); }
      case 122: { double v=sn.adr5; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 123: { double v=sn.adr20; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 124: { double v=sn.today_range_pct_adr; out=v; return (MathIsValidNumber(v) && v>0.0); }
   }
   return false;
}
string S2B_FU_D1FieldName(int f)
{
   switch(f)
   {
      case 0: return "D1_PriorDayHigh_DistATR";
      case 1: return "D1_PriorDayLow_DistATR";
      case 2: return "D1_PriorDayRange_ATR";
      case 3: return "D1_PriorDayRangePosition";
      case 4: return "D1_PriorDayClose_DistATR";
      case 5: return "D1_PriorDayBodyRatio";
      case 6: return "D1_PriorDayDirection";
      case 7: return "D1_InsidePriorDayRange";
      case 8: return "D1_DayOpen_DistATR";
   }
   return "UNKNOWN_D1_FIELD";
}
string S2B_FU_D1FieldGroup(int f)
{
   switch(f)
   {
      case 0: return "LIQUIDITY_D1";
      case 1: return "LIQUIDITY_D1";
      case 2: return "VOLATILITY_D1";
      case 3: return "LOCATION_D1";
      case 4: return "LOCATION_D1";
      case 5: return "PRICE_ACTION_D1";
      case 6: return "PRICE_ACTION_D1";
      case 7: return "LOCATION_D1";
      case 8: return "LOCATION_D1";
   }
   return "UNKNOWN";
}
bool S2B_FU_D1FieldValue(SEntrySnapshot &sn,int f,double &out)
{
   out=0.0;
   double atr=sn.atr[TF_IDX_MAIN];
   if(atr<=0.0) return false;
   double px=sn.candle_close;
   if(px<=0.0) return false;
   int cb=iBarShift(_Symbol,PERIOD_D1,sn.entry_time,false);
   if(cb<0) return false;
   int pb=cb+1;
   double pdh=iHigh(_Symbol,PERIOD_D1,pb);
   double pdl=iLow(_Symbol,PERIOD_D1,pb);
   double pdo=iOpen(_Symbol,PERIOD_D1,pb);
   double pdc=iClose(_Symbol,PERIOD_D1,pb);
   double dop=iOpen(_Symbol,PERIOD_D1,cb);
   if(pdh<=0.0 || pdl<=0.0 || pdh<=pdl || pdo<=0.0 || pdc<=0.0 || dop<=0.0) return false;
   switch(f)
   {
      case 0: { double v=(pdh-px)/atr; out=v; return MathIsValidNumber(v); }
      case 1: { double v=(px-pdl)/atr; out=v; return MathIsValidNumber(v); }
      case 2: { double v=(pdh-pdl)/atr; out=v; return MathIsValidNumber(v); }
      case 3: { double v=(px-pdl)/(pdh-pdl); out=v; return MathIsValidNumber(v); }
      case 4: { double v=(px-pdc)/atr; out=v; return MathIsValidNumber(v); }
      case 5: { double v=MathAbs(pdc-pdo)/(pdh-pdl); out=v; return MathIsValidNumber(v); }
      case 6: { double v=(pdc>pdo?1.0:(pdc<pdo?-1.0:0.0)); out=v; return MathIsValidNumber(v); }
      case 7: { double v=((px<=pdh && px>=pdl)?1.0:0.0); out=v; return MathIsValidNumber(v); }
      case 8: { double v=(px-dop)/atr; out=v; return MathIsValidNumber(v); }
   }
   return false;
}
string S2B_FU_TFName(int tf)
{
   switch(tf)
   {
      case 0: return "M1";
      case 1: return "M5";
      case 2: return "M15";
      case 3: return "M30";
      case 4: return "H1";
      case 5: return "H4";
   }
   return "TF?";
}
// ===========================================================================
// v2: PRICE ACTION CONFIRMATION + DAILY VWAP (18 pre-registered features)
//
// ANTI-LEAKAGE CONTRACT
//   b  = iBarShift(entry_time)            -> the bar that CONTAINS entry (forming) : NEVER USED
//   b1 = b + 1                            -> last FULLY CLOSED bar before entry     : confirmation bar
//   b2 = b + 2                            -> the bar before the confirmation bar    : reference bar
//   Daily VWAP accumulates bars from the broker server calendar-day start up to and
//   including b1 only. No bar with time >= entry_time is ever read.
//   ATR normalisation always uses the frozen snapshot value sn.atr[TF_IDX_MAIN].
//   If any input is unavailable the feature is reported MISSING (no fabricated value).
// ===========================================================================
string S2B_FU_PAFieldName(int f)
{
   switch(f)
   {
      case 0:  return "entry_body_to_range";
      case 1:  return "entry_upper_wick_ratio";
      case 2:  return "entry_lower_wick_ratio";
      case 3:  return "entry_close_location";
      case 4:  return "entry_range_atr";
      case 5:  return "entry_directional_body";
      case 6:  return "bullish_engulfing";
      case 7:  return "bearish_engulfing";
      case 8:  return "bullish_pinbar";
      case 9:  return "bearish_shooting_star";
      case 10: return "bullish_rejection_score";
      case 11: return "bearish_rejection_score";
      case 12: return "close_breaks_prior_high";
      case 13: return "close_breaks_prior_low";
      case 14: return "close_back_inside_prior_range";
      case 15: return "daily_vwap_distance_atr";
      case 16: return "daily_vwap_side";
      case 17: return "daily_vwap_slope";
   }
   return "PA_UNKNOWN";
}
string S2B_FU_PAFieldGroup(int f)
{
   if(f<=5)  return "PA_EntryCandleStructure";
   if(f<=11) return "PA_CandlestickPattern";
   if(f<=14) return "PA_ShortTermConfirmation";
   return "PA_DailyVWAP";
}
string S2B_FU_PAFieldFormula(int f)
{
   switch(f)
   {
      case 0:  return "abs(c1-o1)/(h1-l1)";
      case 1:  return "(h1-max(o1,c1))/(h1-l1)";
      case 2:  return "(min(o1,c1)-l1)/(h1-l1)";
      case 3:  return "(c1-l1)/(h1-l1)";
      case 4:  return "(h1-l1)/atr_main";
      case 5:  return "(c1-o1)/(h1-l1)";
      case 6:  return "1 if c2<o2 AND c1>o1 AND c1>=o2 AND o1<=c2 else 0";
      case 7:  return "1 if c2>o2 AND c1<o1 AND c1<=o2 AND o1>=c2 else 0";
      case 8:  return "1 if lower_wick_ratio>=0.60 AND body_to_range<=0.30 AND close_location>=0.50 else 0";
      case 9:  return "1 if upper_wick_ratio>=0.60 AND body_to_range<=0.30 AND close_location<=0.50 else 0";
      case 10: return "lower_wick_ratio - upper_wick_ratio";
      case 11: return "upper_wick_ratio - lower_wick_ratio";
      case 12: return "1 if c1>h2 else 0";
      case 13: return "1 if c1<l2 else 0";
      case 14: return "1 if (h1>h2 OR l1<l2) AND l2<=c1<=h2 else 0";
      case 15: return "(c1-vwap_day(b1))/atr_main";
      case 16: return "1 if c1>vwap_day(b1) else 0";
      case 17: return "(vwap_day(b1)-vwap_day(b1+5))/atr_main";
   }
   return "NA";
}
// Confirmation bar b1 and reference bar b2, both strictly closed before entry.
bool S2B_FU_PABars(datetime et,MqlRates &r1,MqlRates &r2,int &b1_out)
{
   if(et<=0) return false;
   int b=iBarShift(_Symbol,S2B_FU_PA_TF,et,false);
   if(b<0) return false;
   int b1=b+1;
   MqlRates rr[];
   if(CopyRates(_Symbol,S2B_FU_PA_TF,b1,2,rr)!=2) return false;
   r2=rr[0];
   r1=rr[1];
   if(r1.time>=et || r2.time>=r1.time) return false;
   if(r1.high<=r1.low || r2.high<=r2.low) return false;
   b1_out=b1;
   return true;
}
// Session-aware daily VWAP over closed bars of the server calendar day up to b1.
bool S2B_FU_DailyVwap(int b1,double &vwap_now,double &vwap_lag,int &lag_ok,int &bars_used)
{
   vwap_now=0.0;
   vwap_lag=0.0;
   lag_ok=0;
   bars_used=0;
   datetime t1=iTime(_Symbol,S2B_FU_PA_TF,b1);
   if(t1<=0) return false;
   datetime day_start=(datetime)((((long)t1)/86400)*86400);
   int bstart=iBarShift(_Symbol,S2B_FU_PA_TF,day_start,false);
   if(bstart<b1) return false;
   int count=bstart-b1+1;
   if(count<S2B_FU_PA_VWAP_MIN_BARS) return false;
   if(count>S2B_FU_PA_VWAP_MAX_BARS) return false;
   MqlRates rr[];
   if(CopyRates(_Symbol,S2B_FU_PA_TF,b1,count,rr)!=count) return false;
   double pv=0.0,vv=0.0,pv_lag=0.0,vv_lag=0.0;
   int used=0;
   for(int i=0;i<count;i++)
   {
      if(rr[i].time<day_start) continue;
      if(rr[i].time>=t1+1 && i!=count-1) continue;
      if(rr[i].tick_volume<=0) continue;
      double tp=(rr[i].high+rr[i].low+rr[i].close)/3.0;
      double vol=(double)rr[i].tick_volume;
      pv+=tp*vol;
      vv+=vol;
      used++;
      if(i<count-S2B_FU_PA_VWAP_SLOPE_LAG)
      {
         pv_lag+=tp*vol;
         vv_lag+=vol;
      }
   }
   bars_used=used;
   if(used<S2B_FU_PA_VWAP_MIN_BARS || vv<=0.0) return false;
   vwap_now=pv/vv;
   if(vv_lag>0.0 && count>S2B_FU_PA_VWAP_SLOPE_LAG)
   {
      vwap_lag=pv_lag/vv_lag;
      lag_ok=1;
   }
   return true;
}
bool S2B_FU_PAFieldValue(SEntrySnapshot &sn,int f,double &out)
{
   out=0.0;
   double atr=sn.atr[TF_IDX_MAIN];
   MqlRates r1,r2;
   int b1=-1;
   if(!S2B_FU_PABars(sn.entry_time,r1,r2,b1)) return false;
   double o1=r1.open,h1=r1.high,l1=r1.low,c1=r1.close;
   double o2=r2.open,h2=r2.high,l2=r2.low,c2=r2.close;
   double range1=h1-l1;
   if(range1<=0.0) return false;
   double body=MathAbs(c1-o1);
   double body_ratio=body/range1;
   double upper=(h1-MathMax(o1,c1))/range1;
   double lower=(MathMin(o1,c1)-l1)/range1;
   double clv=(c1-l1)/range1;
   switch(f)
   {
      case 0: out=body_ratio; return true;
      case 1: out=upper; return true;
      case 2: out=lower; return true;
      case 3: out=clv; return true;
      case 4:
         if(atr<=0.0) return false;
         out=range1/atr;
         return true;
      case 5: out=(c1-o1)/range1; return true;
      case 6: out=((c2<o2 && c1>o1 && c1>=o2 && o1<=c2)?1.0:0.0); return true;
      case 7: out=((c2>o2 && c1<o1 && c1<=o2 && o1>=c2)?1.0:0.0); return true;
      case 8:
         out=((lower>=S2B_FU_PA_PINBAR_WICK_MIN && body_ratio<=S2B_FU_PA_PINBAR_BODY_MAX &&
               clv>=S2B_FU_PA_PINBAR_CLV_MIN)?1.0:0.0);
         return true;
      case 9:
         out=((upper>=S2B_FU_PA_PINBAR_WICK_MIN && body_ratio<=S2B_FU_PA_PINBAR_BODY_MAX &&
               clv<=S2B_FU_PA_PINBAR_CLV_MIN)?1.0:0.0);
         return true;
      case 10: out=lower-upper; return true;
      case 11: out=upper-lower; return true;
      case 12: out=((c1>h2)?1.0:0.0); return true;
      case 13: out=((c1<l2)?1.0:0.0); return true;
      case 14: out=(((h1>h2 || l1<l2) && c1<=h2 && c1>=l2)?1.0:0.0); return true;
   }
   if(atr<=0.0) return false;
   double vwap=0.0,vwap_lag=0.0;
   int lag_ok=0,bars_used=0;
   if(!S2B_FU_DailyVwap(b1,vwap,vwap_lag,lag_ok,bars_used)) return false;
   if(f==15){ out=(c1-vwap)/atr; return true; }
   if(f==16){ out=((c1>vwap)?1.0:0.0); return true; }
   if(f==17)
   {
      if(lag_ok!=1) return false;
      out=(vwap-vwap_lag)/atr;
      return true;
   }
   return false;
}
void S2B_FU_BuildRegistry()
{
   ArrayResize(g_fu_feat,S2B_FU_MAX_FEATURES);
   g_fu_feat_count=0;
   for(int tf=0; tf<TF_COUNT; tf++)
   {
      for(int f=0; f<34; f++)
      {
         if(g_fu_feat_count>=S2B_FU_MAX_FEATURES) break;
         g_fu_feat[g_fu_feat_count].name=S2B_FU_TFFieldName(f)+"_"+S2B_FU_TFName(tf);
         g_fu_feat[g_fu_feat_count].group=S2B_FU_TFFieldGroup(f);
         g_fu_feat[g_fu_feat_count].tf_name=S2B_FU_TFName(tf);
         g_fu_feat[g_fu_feat_count].kind=S2B_FU_KIND_TF;
         g_fu_feat[g_fu_feat_count].field=f;
         g_fu_feat[g_fu_feat_count].tf=tf;
         g_fu_feat_count++;
      }
   }
   for(int f=0; f<125; f++)
   {
      if(g_fu_feat_count>=S2B_FU_MAX_FEATURES) break;
      g_fu_feat[g_fu_feat_count].name=S2B_FU_GlobalFieldName(f);
      g_fu_feat[g_fu_feat_count].group=S2B_FU_GlobalFieldGroup(f);
      g_fu_feat[g_fu_feat_count].tf_name="GLOBAL";
      g_fu_feat[g_fu_feat_count].kind=S2B_FU_KIND_GLOBAL;
      g_fu_feat[g_fu_feat_count].field=f;
      g_fu_feat[g_fu_feat_count].tf=-1;
      g_fu_feat_count++;
   }
   for(int f=0; f<9; f++)
   {
      if(g_fu_feat_count>=S2B_FU_MAX_FEATURES) break;
      g_fu_feat[g_fu_feat_count].name=S2B_FU_D1FieldName(f);
      g_fu_feat[g_fu_feat_count].group=S2B_FU_D1FieldGroup(f);
      g_fu_feat[g_fu_feat_count].tf_name="D1";
      g_fu_feat[g_fu_feat_count].kind=S2B_FU_KIND_D1;
      g_fu_feat[g_fu_feat_count].field=f;
      g_fu_feat[g_fu_feat_count].tf=-1;
      g_fu_feat_count++;
   }
   for(int f=0; f<S2B_FU_PA_FIELDS; f++)
   {
      if(g_fu_feat_count>=S2B_FU_MAX_FEATURES) break;
      g_fu_feat[g_fu_feat_count].name=S2B_FU_PAFieldName(f);
      g_fu_feat[g_fu_feat_count].group=S2B_FU_PAFieldGroup(f);
      g_fu_feat[g_fu_feat_count].tf_name="PA_ENTRY";
      g_fu_feat[g_fu_feat_count].kind=S2B_FU_KIND_PA;
      g_fu_feat[g_fu_feat_count].field=f;
      g_fu_feat[g_fu_feat_count].tf=-1;
      g_fu_feat_count++;
   }
   ArrayResize(g_fu_feat,g_fu_feat_count);
}
void S2B_FU_SortIdxByValue(double &v[],int &idx[],int n)
{
   int gap=n/2;
   while(gap>0)
   {
      for(int i=gap;i<n;i++)
      {
         int    ti=idx[i];
         double tv=v[i];
         int j=i;
         while(j>=gap && v[j-gap]>tv)
         {
            v[j]=v[j-gap];
            idx[j]=idx[j-gap];
            j-=gap;
         }
         v[j]=tv;
         idx[j]=ti;
      }
      gap/=2;
   }
}
void S2B_FU_SortAsc(double &v[],int n)
{
   int gap=n/2;
   while(gap>0)
   {
      for(int i=gap;i<n;i++)
      {
         double tv=v[i];
         int j=i;
         while(j>=gap && v[j-gap]>tv){ v[j]=v[j-gap]; j-=gap; }
         v[j]=tv;
      }
      gap/=2;
   }
}
double S2B_FU_NormCdf(double z)
{
   double t=z/MathSqrt(2.0);
   double s=(t<0.0?-1.0:1.0);
   double a=MathAbs(t);
   double p=1.0/(1.0+0.3275911*a);
   double e=1.0-(((((1.061405429*p-1.453152027)*p)+1.421413741)*p-0.284496736)*p+0.254829592)*p*MathExp(-a*a);
   return 0.5*(1.0+s*e);
}
// Rank based AUC + Mann-Whitney U with tie correction.
bool S2B_FU_RankStats(double &vals[],int &ys[],int n,double &auc,double &u,double &z,double &p)
{
   auc=0.5; u=0.0; z=0.0; p=1.0;
   if(n<4) return false;
   double sv[]; int si[];
   ArrayResize(sv,n); ArrayResize(si,n);
   for(int i=0;i<n;i++){ sv[i]=vals[i]; si[i]=i; }
   S2B_FU_SortIdxByValue(sv,si,n);
   double rank_pos_sum=0.0, tie_term=0.0;
   int n1=0,n2=0;
   int i2=0;
   while(i2<n)
   {
      int j=i2;
      while(j+1<n && sv[j+1]==sv[i2]) j++;
      double tcnt=(double)(j-i2+1);
      double avg_rank=((double)(i2+1)+(double)(j+1))/2.0;
      for(int k=i2;k<=j;k++)
      {
         if(ys[si[k]]==1) rank_pos_sum+=avg_rank;
      }
      tie_term+=tcnt*tcnt*tcnt-tcnt;
      i2=j+1;
   }
   for(int i=0;i<n;i++){ if(ys[i]==1) n1++; else n2++; }
   if(n1<=0 || n2<=0) return false;
   u=rank_pos_sum-(double)n1*((double)n1+1.0)/2.0;
   auc=u/((double)n1*(double)n2);
   double dn=(double)n;
   double var=((double)n1*(double)n2/12.0)*((dn+1.0)-tie_term/(dn*(dn-1.0)));
   if(var<=0.0){ z=0.0; p=1.0; return true; }
   z=(u-(double)n1*(double)n2/2.0)/MathSqrt(var);
   p=2.0*(1.0-S2B_FU_NormCdf(MathAbs(z)));
   if(p>1.0) p=1.0;
   if(p<0.0) p=0.0;
   return true;
}
double S2B_FU_AUCFromScores(double &sc[],int &ys[],int n)
{
   double a=0.5,u=0.0,z=0.0,p=1.0;
   if(!S2B_FU_RankStats(sc,ys,n,a,u,z,p)) return 0.5;
   return a;
}
bool S2B_FU_Univariate(int f,SFUUniStat &st)
{
   st.Reset();
   st.fi=f;
   double vals[]; int ys[];
   ArrayResize(vals,g_fu_row_count);
   ArrayResize(ys,g_fu_row_count);
   int n=0,np=0,nn=0;
   double sp=0.0,sn2=0.0,ssp=0.0,ssn=0.0;
   for(int r=0;r<g_fu_row_count;r++)
   {
      if(!S2B_FU_OK(r,f)) continue;
      double v=S2B_FU_V(r,f);
      vals[n]=v;
      ys[n]=g_fu_y[r];
      n++;
      if(g_fu_y[r]==1){ np++; sp+=v; ssp+=v*v; }
      else { nn++; sn2+=v; ssn+=v*v; }
   }
   ArrayResize(vals,n);
   ArrayResize(ys,n);
   st.n_valid=n;
   st.pos_valid=np;
   st.neg_valid=nn;
   st.coverage_pct=(g_fu_row_count>0?100.0*(double)n/(double)g_fu_row_count:0.0);
   st.prevalence=(n>0?(double)np/(double)n:0.0);
   if(np<S2B_FU_MIN_VAL_POS || nn<S2B_FU_MIN_VAL_POS || n<S2B_FU_MIN_TRAIN_N)
      return false;
   st.mean_pos=sp/np;
   st.mean_neg=sn2/nn;
   double vp=(np>1?ssp/np-st.mean_pos*st.mean_pos:0.0);
   double vn=(nn>1?ssn/nn-st.mean_neg*st.mean_neg:0.0);
   if(vp<0.0) vp=0.0;
   if(vn<0.0) vn=0.0;
   st.std_pos=MathSqrt(vp);
   st.std_neg=MathSqrt(vn);
   double pooled_num=((double)np-1.0)*vp+((double)nn-1.0)*vn;
   double pooled_den=(double)np+(double)nn-2.0;
   double pooled=(pooled_den>0.0?MathSqrt(pooled_num/pooled_den):0.0);
   st.cohens_d=(pooled>1e-12?(st.mean_pos-st.mean_neg)/pooled:0.0);
   double a=0.5,u=0.0,z=0.0,p=1.0;
   if(!S2B_FU_RankStats(vals,ys,n,a,u,z,p))
      return false;
   st.auc=a;
   st.auc_abs_dev=MathAbs(a-0.5);
   st.mw_u=u;
   st.mw_z=z;
   st.mw_p=p;
   st.usable=((st.coverage_pct>=S2B_FU_MIN_COVERAGE_PCT && st.std_pos+st.std_neg>0.0)?1:0);
   return true;
}
// ---------------------------------------------------------------------------
// v2: effect size classification, per-fold stability, Benjamini-Hochberg FDR
// ---------------------------------------------------------------------------
string S2B_FU_EffectClass(double d)
{
   double a=MathAbs(d);
   if(a<0.20) return "NEGLIGIBLE";
   if(a<0.50) return "SMALL";
   if(a<0.80) return "MEDIUM";
   return "LARGE";
}
// AUC of feature f restricted to the validation rows of one fold.
bool S2B_FU_FoldAUC(int f,int fold,double &auc_out,int &dir_out)
{
   auc_out=0.5;
   dir_out=0;
   double vals[]; int ys[];
   ArrayResize(vals,g_fu_row_count);
   ArrayResize(ys,g_fu_row_count);
   int n=0,np=0,nn=0;
   double sp=0.0,sn2=0.0;
   for(int r=0;r<g_fu_row_count;r++)
   {
      if(g_fu_fold_val[r]!=fold) continue;
      if(!S2B_FU_OK(r,f)) continue;
      double v=S2B_FU_V(r,f);
      vals[n]=v;
      ys[n]=g_fu_y[r];
      n++;
      if(g_fu_y[r]==1){ np++; sp+=v; }
      else { nn++; sn2+=v; }
   }
   ArrayResize(vals,n);
   ArrayResize(ys,n);
   if(np<S2B_FU_MIN_VAL_POS || nn<S2B_FU_MIN_VAL_POS || n<S2B_FU_MIN_VAL_N) return false;
   double a=0.5,u=0.0,z=0.0,p=1.0;
   if(!S2B_FU_RankStats(vals,ys,n,a,u,z,p)) return false;
   auc_out=a;
   double mp=sp/np, mn=sn2/nn;
   if(mp>mn) dir_out=1;
   else if(mp<mn) dir_out=-1;
   else dir_out=0;
   return true;
}
// Fold-level direction consistency and severe reversal flag (report only).
void S2B_FU_FoldStability()
{
   for(int i=0;i<g_fu_uni_count;i++)
   {
      int f=g_fu_uni[i].fi;
      int pos=0,neg=0,ev=0,rev=0;
      double global_dev=g_fu_uni[i].auc-0.5;
      for(int k=0;k<g_fu_fold_count && k<3;k++)
      {
         double a=0.5;
         int dir=0;
         if(!S2B_FU_FoldAUC(f,k,a,dir))
         {
            g_fu_uni[i].auc_fold[k]=0.5;
            g_fu_uni[i].dir_fold[k]=0;
            continue;
         }
         g_fu_uni[i].auc_fold[k]=a;
         g_fu_uni[i].dir_fold[k]=dir;
         ev++;
         if(dir>0) pos++;
         else if(dir<0) neg++;
         double dev=a-0.5;
         if(global_dev*dev<0.0 && MathAbs(dev)>=S2B_FU_FOLD_REVERSAL_DEV) rev=1;
      }
      g_fu_uni[i].folds_evaluated=ev;
      g_fu_uni[i].fold_dir_consistent=((pos>=2 || neg>=2)?1:0);
      g_fu_uni[i].fold_reversal_flag=rev;
   }
}
// Benjamini-Hochberg over the ENTIRE final univariate family (one family only).
void S2B_FU_ApplyBH()
{
   int idx[];
   double key[];
   ArrayResize(idx,g_fu_uni_count);
   ArrayResize(key,g_fu_uni_count);
   int m=0;
   for(int i=0;i<g_fu_uni_count;i++)
   {
      g_fu_uni[i].bh_rank=0;
      g_fu_uni[i].fdr_q_value=1.0;
      g_fu_uni[i].fdr_pass=0;
      g_fu_uni[i].fdr_class="NOT_TESTED";
      g_fu_uni[i].effect_size_class=S2B_FU_EffectClass(g_fu_uni[i].cohens_d);
      if(g_fu_uni[i].usable!=1) continue;
      key[m]=g_fu_uni[i].mw_p;
      idx[m]=i;
      m++;
   }
   ArrayResize(key,m);
   ArrayResize(idx,m);
   if(m<=0)
   {
      Print("FU_FDR|FamilySize=0|NoTestableFeatures");
      return;
   }
   S2B_FU_SortIdxByValue(key,idx,m);
   double q[];
   ArrayResize(q,m);
   double running=1.0;
   for(int r=m-1;r>=0;r--)
   {
      double raw=g_fu_uni[idx[r]].mw_p*(double)m/(double)(r+1);
      if(raw>1.0) raw=1.0;
      if(raw<running) running=raw;
      q[r]=running;
   }
   int strong=0,moderate=0,expl=0;
   for(int r=0;r<m;r++)
   {
      int i=idx[r];
      g_fu_uni[i].bh_rank=r+1;
      g_fu_uni[i].fdr_q_value=q[r];
      if(q[r]<S2B_FU_FDR_STRONG_Q)
      {
         g_fu_uni[i].fdr_pass=2;
         g_fu_uni[i].fdr_class="STRONG";
         strong++;
      }
      else if(q[r]<S2B_FU_FDR_MODERATE_Q)
      {
         g_fu_uni[i].fdr_pass=1;
         g_fu_uni[i].fdr_class="MODERATE";
         moderate++;
      }
      else if(g_fu_uni[i].mw_p<S2B_FU_FDR_RAW_P)
      {
         g_fu_uni[i].fdr_pass=0;
         g_fu_uni[i].fdr_class="EXPLORATORY_ONLY";
         expl++;
      }
      else
      {
         g_fu_uni[i].fdr_pass=0;
         g_fu_uni[i].fdr_class="NOT_SIGNIFICANT";
      }
   }
   g_fu_fdr_family=m;
   g_fu_fdr_strong=strong;
   g_fu_fdr_moderate=moderate;
   g_fu_fdr_exploratory=expl;
   Print("FU_FDR|Version=",S2B_FU_FDR_VERSION,"|FamilySize=",m,"|Strong_q<0.05=",strong,
         "|Moderate_q<0.10=",moderate,"|ExploratoryOnly_rawp<0.05=",expl,
         "|ThresholdsFrozenBeforeRun=YES|EmptyResultIsValid=YES");
}
double S2B_FU_Pearson(int fa,int fb)
{
   int n=0;
   double sa=0.0,sb=0.0,saa=0.0,sbb=0.0,sab=0.0;
   for(int r=0;r<g_fu_row_count;r++)
   {
      if(!S2B_FU_OK(r,fa) || !S2B_FU_OK(r,fb)) continue;
      double a=S2B_FU_V(r,fa), b=S2B_FU_V(r,fb);
      n++; sa+=a; sb+=b; saa+=a*a; sbb+=b*b; sab+=a*b;
   }
   if(n<10) return 0.0;
   double dn=(double)n;
   double cov=sab/dn-(sa/dn)*(sb/dn);
   double va=saa/dn-(sa/dn)*(sa/dn);
   double vb=sbb/dn-(sb/dn)*(sb/dn);
   if(va<=1e-15 || vb<=1e-15) return 0.0;
   return cov/MathSqrt(va*vb);
}
bool S2B_FU_TrainLogit(int &feats[],int nf,int &rows[],int n,SFULogit &m)
{
   m.Reset();
   if(nf<=0 || nf>S2B_FU_MAX_MODEL_FEATS || n<S2B_FU_MIN_TRAIN_N) return false;
   m.n_features=nf;
   for(int k=0;k<nf;k++) m.feat_pos[k]=feats[k];
   for(int k=0;k<nf;k++)
   {
      double s=0.0,ss=0.0;
      for(int i=0;i<n;i++)
      {
         double v=S2B_FU_V(rows[i],feats[k]);
         s+=v; ss+=v*v;
      }
      m.mean[k]=s/n;
      double var=ss/n-m.mean[k]*m.mean[k];
      m.sd[k]=(var>1e-12?MathSqrt(var):1.0);
   }
   double w[S2B_FU_MAX_MODEL_FEATS];
   ArrayInitialize(w,0.0);
   double b=0.0;
   for(int ep=0;ep<S2B_FU_LOGIT_EPOCHS;ep++)
   {
      double gw[S2B_FU_MAX_MODEL_FEATS];
      ArrayInitialize(gw,0.0);
      double gb=0.0;
      for(int i=0;i<n;i++)
      {
         double z=b;
         for(int k=0;k<nf;k++)
            z+=w[k]*((S2B_FU_V(rows[i],feats[k])-m.mean[k])/m.sd[k]);
         double pr=S2B_FU_Sig(z);
         double err=pr-(double)g_fu_y[rows[i]];
         gb+=err;
         for(int k=0;k<nf;k++)
            gw[k]+=err*((S2B_FU_V(rows[i],feats[k])-m.mean[k])/m.sd[k]);
      }
      b-=S2B_FU_LOGIT_LR*gb/n;
      for(int k=0;k<nf;k++)
         w[k]-=S2B_FU_LOGIT_LR*(gw[k]/n+S2B_FU_LOGIT_LAMBDA*w[k]);
   }
   for(int k=0;k<nf;k++) m.w[k]=w[k];
   m.intercept=b;
   m.trained=true;
   return true;
}
double S2B_FU_ScoreLogitRow(SFULogit &m,int r)
{
   double z=m.intercept;
   for(int k=0;k<m.n_features;k++)
      z+=m.w[k]*((S2B_FU_V(r,m.feat_pos[k])-m.mean[k])/m.sd[k]);
   return S2B_FU_Sig(z);
}
double S2B_FU_ScoreLogitVec(SFULogit &m,double &xrow[])
{
   double z=m.intercept;
   for(int k=0;k<m.n_features;k++)
      z+=m.w[k]*((xrow[k]-m.mean[k])/m.sd[k]);
   return S2B_FU_Sig(z);
}
// ---- tree machinery on the imputed working matrix g_fu_x / g_fu_b -----------
double S2B_FU_X(int r,int j){ return g_fu_x[r*g_fu_sel_count+j]; }
void   S2B_FU_SetX(int r,int j,double v){ g_fu_x[r*g_fu_sel_count+j]=v; }
int    S2B_FU_B(int r,int j){ return (int)g_fu_b[r*g_fu_sel_count+j]; }
double S2B_FU_Edge(int j,int e){ return g_fu_edge[j*(S2B_FU_BINS-1)+e]; }
// Builds the imputed matrix, per-feature medians and bin edges from train rows.
void S2B_FU_PrepareWorkMatrix(int &sel[],int nsel,int &train_rows[],int n_tr)
{
   g_fu_sel_count=nsel;
   ArrayResize(g_fu_sel,nsel);
   for(int j=0;j<nsel;j++) g_fu_sel[j]=sel[j];
   ArrayResize(g_fu_x,g_fu_row_count*nsel);
   ArrayResize(g_fu_b,g_fu_row_count*nsel);
   ArrayResize(g_fu_edge,nsel*(S2B_FU_BINS-1));
   for(int j=0;j<nsel;j++)
   {
      int f=sel[j];
      double tmp[];
      ArrayResize(tmp,n_tr);
      int m=0;
      for(int i=0;i<n_tr;i++)
      {
         int r=train_rows[i];
         if(!S2B_FU_OK(r,f)) continue;
         tmp[m++]=S2B_FU_V(r,f);
      }
      ArrayResize(tmp,m);
      double med=0.0;
      if(m>0)
      {
         S2B_FU_SortAsc(tmp,m);
         med=tmp[m/2];
         for(int e=0;e<S2B_FU_BINS-1;e++)
         {
            int pos=(int)MathFloor((double)m*(double)(e+1)/(double)S2B_FU_BINS);
            if(pos<0) pos=0;
            if(pos>m-1) pos=m-1;
            g_fu_edge[j*(S2B_FU_BINS-1)+e]=tmp[pos];
         }
      }
      else
      {
         for(int e=0;e<S2B_FU_BINS-1;e++) g_fu_edge[j*(S2B_FU_BINS-1)+e]=0.0;
      }
      for(int r=0;r<g_fu_row_count;r++)
      {
         double v=(S2B_FU_OK(r,f)?S2B_FU_V(r,f):med);
         g_fu_x[r*nsel+j]=v;
         int bi=0;
         while(bi<S2B_FU_BINS-1 && v>g_fu_edge[j*(S2B_FU_BINS-1)+bi]) bi++;
         g_fu_b[r*nsel+j]=(uchar)bi;
      }
      ArrayFree(tmp);
   }
}
// One grower for both families.
// mode 0 = mean leaf (RF classification), mode 1 = Newton leaf (GB).
void S2B_FU_GrowTree(int &idx[],int n,double &g[],double &h[],int mode,int max_depth,
                     int min_leaf,double lambda,int mtry,SFUTree &t,double &imp[])
{
   t.n_nodes=0;
   for(int i=0;i<S2B_FU_MAX_NODES;i++)
   {
      t.feat[i]=-1; t.thr[i]=0.0; t.left[i]=-1; t.right[i]=-1;
      t.leaf[i]=0.0; t.is_leaf[i]=1;
   }
   int st_start[S2B_FU_MAX_NODES];
   int st_end[S2B_FU_MAX_NODES];
   int st_depth[S2B_FU_MAX_NODES];
   int st_node[S2B_FU_MAX_NODES];
   int sp=0;
   t.n_nodes=1;
   st_start[sp]=0; st_end[sp]=n; st_depth[sp]=0; st_node[sp]=0; sp++;
   while(sp>0)
   {
      sp--;
      int s0=st_start[sp], s1=st_end[sp], depth=st_depth[sp], node=st_node[sp];
      int cnt=s1-s0;
      double sg=0.0,sh=0.0;
      for(int i=s0;i<s1;i++){ sg+=g[idx[i]]; sh+=h[idx[i]]; }
      double leaf_val=(mode==0?(sh>0.0?sg/sh:0.0):-sg/(sh+lambda));
      t.leaf[node]=leaf_val;
      t.is_leaf[node]=1;
      if(depth>=max_depth || cnt<2*min_leaf) continue;
      if(t.n_nodes+2>S2B_FU_MAX_NODES) continue;
      double parent=(sg*sg)/(sh+lambda);
      double best_gain=0.0;
      int    best_j=-1, best_bin=-1;
      int cand[S2B_FU_MAX_FILTERED];
      int ncand=0;
      if(mtry>=g_fu_sel_count)
      {
         for(int j=0;j<g_fu_sel_count;j++) cand[ncand++]=j;
      }
      else
      {
         int used[S2B_FU_MAX_FILTERED];
         ArrayInitialize(used,0);
         int guard=0;
         while(ncand<mtry && guard<10*mtry+50)
         {
            int j=S2B_FU_RandInt(g_fu_sel_count);
            guard++;
            if(used[j]==1) continue;
            used[j]=1;
            cand[ncand++]=j;
         }
      }
      for(int c=0;c<ncand;c++)
      {
         int j=cand[c];
         double hg[S2B_FU_BINS], hh[S2B_FU_BINS];
         double hc[S2B_FU_BINS];
         ArrayInitialize(hg,0.0);
         ArrayInitialize(hh,0.0);
         ArrayInitialize(hc,0.0);
         for(int i=s0;i<s1;i++)
         {
            int r=idx[i];
            int b=S2B_FU_B(r,j);
            hg[b]+=g[r];
            hh[b]+=h[r];
            hc[b]+=1.0;
         }
         double cg=0.0,ch=0.0,cc=0.0;
         for(int b=0;b<S2B_FU_BINS-1;b++)
         {
            cg+=hg[b]; ch+=hh[b]; cc+=hc[b];
            double rc=(double)cnt-cc;
            if(cc<min_leaf || rc<min_leaf) continue;
            double rg=sg-cg, rh=sh-ch;
            double gain=(cg*cg)/(ch+lambda)+(rg*rg)/(rh+lambda)-parent;
            if(gain>best_gain)
            {
               best_gain=gain;
               best_j=j;
               best_bin=b;
            }
         }
      }
      if(best_j<0 || best_gain<=0.0) continue;
      double thr=S2B_FU_Edge(best_j,best_bin);
      int i1=s0, i2=s1-1;
      while(i1<=i2)
      {
         if(S2B_FU_B(idx[i1],best_j)<=best_bin) i1++;
         else
         {
            int tmp=idx[i1]; idx[i1]=idx[i2]; idx[i2]=tmp;
            i2--;
         }
      }
      int split=i1;
      if(split<=s0 || split>=s1) continue;
      int lnode=t.n_nodes; t.n_nodes++;
      int rnode=t.n_nodes; t.n_nodes++;
      t.is_leaf[node]=0;
      t.feat[node]=best_j;
      t.thr[node]=thr;
      t.left[node]=lnode;
      t.right[node]=rnode;
      imp[best_j]+=best_gain;
      st_start[sp]=s0; st_end[sp]=split; st_depth[sp]=depth+1; st_node[sp]=lnode; sp++;
      st_start[sp]=split; st_end[sp]=s1; st_depth[sp]=depth+1; st_node[sp]=rnode; sp++;
   }
}
double S2B_FU_PredictTreeRow(SFUTree &t,int r)
{
   int node=0;
   int guard=0;
   while(t.is_leaf[node]==0 && guard<64)
   {
      guard++;
      if(S2B_FU_X(r,t.feat[node])<=t.thr[node]) node=t.left[node];
      else node=t.right[node];
   }
   return t.leaf[node];
}
double S2B_FU_PredictTreeVec(SFUTree &t,double &xrow[])
{
   int node=0;
   int guard=0;
   while(t.is_leaf[node]==0 && guard<64)
   {
      guard++;
      if(xrow[t.feat[node]]<=t.thr[node]) node=t.left[node];
      else node=t.right[node];
   }
   return t.leaf[node];
}
void S2B_FU_FitForest(int &train_rows[],int n_tr,double &imp[])
{
   int mtry=(int)MathMax(4.0,MathSqrt((double)g_fu_sel_count));
   double g[],h[];
   ArrayResize(g,g_fu_row_count);
   ArrayResize(h,g_fu_row_count);
   ArrayInitialize(g,0.0);
   ArrayInitialize(h,0.0);
   for(int i=0;i<n_tr;i++)
   {
      int r=train_rows[i];
      g[r]=(double)g_fu_y[r];
      h[r]=1.0;
   }
   for(int t=0;t<S2B_FU_RF_TREES;t++)
   {
      int boot[];
      ArrayResize(boot,n_tr);
      for(int i=0;i<n_tr;i++) boot[i]=train_rows[S2B_FU_RandInt(n_tr)];
      S2B_FU_GrowTree(boot,n_tr,g,h,0,S2B_FU_RF_MAX_DEPTH,S2B_FU_RF_MIN_LEAF,0.0,mtry,g_fu_forest[t],imp);
      ArrayFree(boot);
   }
   ArrayFree(g);
   ArrayFree(h);
}
double S2B_FU_PredictForestRow(int r)
{
   double s=0.0;
   for(int t=0;t<S2B_FU_RF_TREES;t++) s+=S2B_FU_PredictTreeRow(g_fu_forest[t],r);
   return s/(double)S2B_FU_RF_TREES;
}
double S2B_FU_PredictForestVec(double &xrow[])
{
   double s=0.0;
   for(int t=0;t<S2B_FU_RF_TREES;t++) s+=S2B_FU_PredictTreeVec(g_fu_forest[t],xrow);
   return s/(double)S2B_FU_RF_TREES;
}
double g_fu_gb_base=0.0;
void S2B_FU_FitBoost(int &train_rows[],int n_tr,double &imp[])
{
   double pos=0.0;
   for(int i=0;i<n_tr;i++) pos+=(double)g_fu_y[train_rows[i]];
   double p0=(n_tr>0?pos/(double)n_tr:0.01);
   if(p0<1e-6) p0=1e-6;
   if(p0>1.0-1e-6) p0=1.0-1e-6;
   g_fu_gb_base=MathLog(p0/(1.0-p0));
   double fx[],g[],h[];
   ArrayResize(fx,g_fu_row_count);
   ArrayResize(g,g_fu_row_count);
   ArrayResize(h,g_fu_row_count);
   ArrayInitialize(fx,0.0);
   ArrayInitialize(g,0.0);
   ArrayInitialize(h,0.0);
   for(int i=0;i<n_tr;i++) fx[train_rows[i]]=g_fu_gb_base;
   for(int m=0;m<S2B_FU_GB_ROUNDS;m++)
   {
      for(int i=0;i<n_tr;i++)
      {
         int r=train_rows[i];
         double p=S2B_FU_Sig(fx[r]);
         g[r]=p-(double)g_fu_y[r];
         h[r]=MathMax(p*(1.0-p),1e-6);
      }
      int idx[];
      ArrayResize(idx,n_tr);
      for(int i=0;i<n_tr;i++) idx[i]=train_rows[i];
      S2B_FU_GrowTree(idx,n_tr,g,h,1,S2B_FU_GB_MAX_DEPTH,S2B_FU_GB_MIN_LEAF,
                      S2B_FU_GB_LAMBDA,g_fu_sel_count,g_fu_boost[m],imp);
      for(int i=0;i<n_tr;i++)
      {
         int r=train_rows[i];
         fx[r]+=S2B_FU_GB_LR*S2B_FU_PredictTreeRow(g_fu_boost[m],r);
      }
      ArrayFree(idx);
   }
   ArrayFree(fx);
   ArrayFree(g);
   ArrayFree(h);
}
double S2B_FU_PredictBoostRow(int r)
{
   double f=g_fu_gb_base;
   for(int m=0;m<S2B_FU_GB_ROUNDS;m++) f+=S2B_FU_GB_LR*S2B_FU_PredictTreeRow(g_fu_boost[m],r);
   return S2B_FU_Sig(f);
}
double S2B_FU_PredictBoostVec(double &xrow[])
{
   double f=g_fu_gb_base;
   for(int m=0;m<S2B_FU_GB_ROUNDS;m++) f+=S2B_FU_GB_LR*S2B_FU_PredictTreeVec(g_fu_boost[m],xrow);
   return S2B_FU_Sig(f);
}
// ---------------------------------------------------------------------------
// Row policy, holdout guard layers, feature matrix, hashes
// ---------------------------------------------------------------------------
string S2B_FU_File(string tag)
{
   return "Stage2B_FU_D2018_2023_v2_"+tag+"_"+_Symbol;
}
void S2B_FU_ResetState()
{
   g_fu_proto.Reset();
   g_fu_block_reason="NONE";
   g_fu_feat_count=0;
   g_fu_row_count=0;
   g_fu_uni_count=0;
   g_fu_fold_count=0;
   g_fu_sel_count=0;
   ArrayFree(g_fu_feat);
   ArrayFree(g_fu_val);
   ArrayFree(g_fu_ok);
   ArrayFree(g_fu_rows);
   ArrayFree(g_fu_snap);
   ArrayFree(g_fu_y);
   ArrayFree(g_fu_time);
   ArrayFree(g_fu_fold_val);
   ArrayFree(g_fu_uni);
   ArrayFree(g_fu_folds);
   ArrayFree(g_fu_x);
   ArrayFree(g_fu_b);
   ArrayFree(g_fu_edge);
   ArrayFree(g_fu_sel);
   S2B_FU_SeedRng(S2B_FU_SEED);
}
// GUARD LAYER 1 : no collected observation may live inside the reserved holdout.
bool S2B_FU_ValidateRunBoundary(string &reason)
{
   reason="";
   datetime hb=StringToTime(S2B_FU_DEV_TO);
   if(g_snapshot_count<=0){ reason="NO_SNAPSHOTS"; return false; }
   if(g_risklab_count<=0){ reason="NO_RISKLAB_RECORDS"; return false; }
   int bad_snap=0,bad_rec=0;
   datetime max_snap=0,max_rec=0;
   for(int i=0;i<g_snapshot_count;i++)
   {
      if(g_snapshots[i].entry_time>max_snap) max_snap=g_snapshots[i].entry_time;
      if(g_snapshots[i].entry_time>=hb) bad_snap++;
   }
   for(int i=0;i<g_risklab_count;i++)
   {
      if(g_risklab_records[i].entry_time>max_rec) max_rec=g_risklab_records[i].entry_time;
      if(g_risklab_records[i].entry_time>=hb) bad_rec++;
   }
   Print("FU_BOUNDARY|Snapshots=",g_snapshot_count,"|MaxSnapEntry=",TimeToString(max_snap,TIME_DATE|TIME_MINUTES),
         "|RiskLab=",g_risklab_count,"|MaxRecEntry=",TimeToString(max_rec,TIME_DATE|TIME_MINUTES),
         "|HoldoutFrom=",S2B_FU_DEV_TO,"|SnapInHoldout=",bad_snap,"|RecInHoldout=",bad_rec);
   if(bad_snap>0 || bad_rec>0)
   {
      reason="HOLDOUT_CONTAMINATION|Snap="+IntegerToString(bad_snap)+"|Rec="+IntegerToString(bad_rec);
      return false;
   }
   return true;
}
// GUARD LAYER 2 : every fold window must terminate before the holdout.
bool S2B_FU_BuildFolds(string &reason)
{
   reason="";
   ArrayResize(g_fu_folds,3);
   g_fu_fold_count=3;
   g_fu_folds[0].train_from=StringToTime("2018.01.01"); g_fu_folds[0].train_to=StringToTime("2021.01.01");
   g_fu_folds[0].val_from  =StringToTime("2021.01.01"); g_fu_folds[0].val_to  =StringToTime("2022.01.01");
   g_fu_folds[1].train_from=StringToTime("2018.01.01"); g_fu_folds[1].train_to=StringToTime("2022.01.01");
   g_fu_folds[1].val_from  =StringToTime("2022.01.01"); g_fu_folds[1].val_to  =StringToTime("2023.01.01");
   g_fu_folds[2].train_from=StringToTime("2018.01.01"); g_fu_folds[2].train_to=StringToTime("2023.01.01");
   g_fu_folds[2].val_from  =StringToTime("2023.01.01"); g_fu_folds[2].val_to  =StringToTime("2024.01.01");
   datetime hb=StringToTime(S2B_FU_DEV_TO);
   for(int i=0;i<3;i++)
   {
      g_fu_folds[i].train_n=0; g_fu_folds[i].train_pos=0;
      g_fu_folds[i].val_n=0;   g_fu_folds[i].val_pos=0;
      g_fu_folds[i].ok=false;
      if(g_fu_folds[i].val_to>hb || g_fu_folds[i].train_to>hb)
      {
         reason="FOLD_TOUCHES_HOLDOUT|FOLD="+IntegerToString(i+1);
         return false;
      }
   }
   return true;
}
// GUARD LAYER 3 : row level window enforcement at collection time.
bool S2B_FU_CollectRows(string &reason)
{
   reason="";
   datetime a=StringToTime(S2B_FU_DEV_FROM);
   datetime b=StringToTime(S2B_FU_DEV_TO);
   g_fu_proto.dev_from=a;
   g_fu_proto.dev_to=b;
   g_fu_proto.holdout_from=b;
   g_fu_proto.snapshot_count=g_snapshot_count;
   g_fu_proto.risklab_count=g_risklab_count;
   ArrayResize(g_fu_rows,g_risklab_count);
   ArrayResize(g_fu_snap,g_risklab_count);
   ArrayResize(g_fu_y,g_risklab_count);
   ArrayResize(g_fu_time,g_risklab_count);
   ArrayResize(g_fu_fold_val,g_risklab_count);
   int n=0,exc=0,dev=0,pos=0;
   datetime first=0,last=0;
   for(int i=0;i<g_risklab_count;i++)
   {
      datetime et=g_risklab_records[i].entry_time;
      if(et<a || et>=b) continue;
      dev++;
      bool ok=(g_risklab_records[i].max_step_reached>=1 &&
               g_risklab_records[i].max_step_reached<=5 &&
               StringLen(g_risklab_records[i].final_event)>0);
      int si=-1;
      if(ok)
      {
         si=RL_FindSnapshotBySetupId_ForRL(g_risklab_records[i].setup_id);
         if(si<0) ok=false;
      }
      if(ok && g_snapshots[si].entry_time!=et) ok=false;
      if(ok && g_snapshots[si].atr[TF_IDX_MAIN]<=0.0) ok=false;
      if(!ok){ exc++; continue; }
      g_fu_rows[n]=i;
      g_fu_snap[n]=si;
      g_fu_y[n]=(g_risklab_records[i].stop_flag?1:0);
      g_fu_time[n]=et;
      g_fu_fold_val[n]=-1;
      for(int f=0;f<g_fu_fold_count;f++)
         if(et>=g_fu_folds[f].val_from && et<g_fu_folds[f].val_to) g_fu_fold_val[n]=f;
      if(g_fu_y[n]==1) pos++;
      if(first==0 || et<first) first=et;
      if(last==0  || et>last)  last=et;
      n++;
   }
   ArrayResize(g_fu_rows,n);
   ArrayResize(g_fu_snap,n);
   ArrayResize(g_fu_y,n);
   ArrayResize(g_fu_time,n);
   ArrayResize(g_fu_fold_val,n);
   g_fu_row_count=n;
   g_fu_proto.dev_record_count=dev;
   g_fu_proto.eligible_count=n;
   g_fu_proto.excluded_count=exc;
   g_fu_proto.positive_count=pos;
   g_fu_proto.negative_count=n-pos;
   g_fu_proto.first_entry_time=first;
   g_fu_proto.last_entry_time=last;
   if(n<S2B_FU_MIN_TRAIN_N){ reason="INSUFFICIENT_ELIGIBLE_ROWS"; return false; }
   if(pos<S2B_FU_MIN_TRAIN_POS){ reason="INSUFFICIENT_POSITIVES"; return false; }
   for(int r=0;r<n;r++)
   {
      if(g_fu_time[r]<a || g_fu_time[r]>=b)
      {
         reason="ROW_OUTSIDE_DEVELOPMENT_WINDOW";
         return false;
      }
   }
   return true;
}
void S2B_FU_FillRow(SEntrySnapshot &sn,int r)
{
   int base=r*g_fu_feat_count;
   for(int f=0;f<g_fu_feat_count;f++)
   {
      double v=0.0;
      bool ok=false;
      if(g_fu_feat[f].kind==S2B_FU_KIND_TF)
         ok=S2B_FU_TFFieldValue(sn,g_fu_feat[f].field,g_fu_feat[f].tf,v);
      else if(g_fu_feat[f].kind==S2B_FU_KIND_GLOBAL)
         ok=S2B_FU_GlobalFieldValue(sn,g_fu_feat[f].field,v);
      else if(g_fu_feat[f].kind==S2B_FU_KIND_D1)
         ok=S2B_FU_D1FieldValue(sn,g_fu_feat[f].field,v);
      else
         ok=S2B_FU_PAFieldValue(sn,g_fu_feat[f].field,v);
      if(ok && !MathIsValidNumber(v)) ok=false;
      g_fu_val[base+f]=(ok?v:0.0);
      g_fu_ok[base+f]=(uchar)(ok?1:0);
   }
}
bool S2B_FU_BuildMatrix(string &reason)
{
   reason="";
   if(g_fu_feat_count<=0 || g_fu_row_count<=0){ reason="EMPTY_MATRIX"; return false; }
   long need=(long)g_fu_row_count*(long)g_fu_feat_count;
   if(ArrayResize(g_fu_val,(int)need)!=(int)need){ reason="MATRIX_ALLOC_FAILED"; return false; }
   if(ArrayResize(g_fu_ok,(int)need)!=(int)need){ reason="MASK_ALLOC_FAILED"; return false; }
   for(int r=0;r<g_fu_row_count;r++)
      S2B_FU_FillRow(g_snapshots[g_fu_snap[r]],r);
   g_fu_proto.feature_count=g_fu_feat_count;
   return true;
}
void S2B_FU_BuildHashes()
{
   uint h=0x9E3779B9;
   h=S2B_FU_Mix(h,S2B_FU_CYCLE_ID);
   h=S2B_FU_Mix(h,S2B_FU_REGISTRY_VERSION);
   h=S2B_FU_Mix(h,S2B_FU_PA_DEF_VERSION);
   h=S2B_FU_Mix(h,S2B_FU_FDR_VERSION);
   h=S2B_FU_Mix(h,"PA_ENTRY_TF|"+EnumToString((ENUM_TIMEFRAMES)Period()));
   h=S2B_FU_Mix(h,"PA_VWAP|"+string(S2B_FU_PA_VWAP_PRICE)+"|"+string(S2B_FU_PA_VWAP_VOLUME)+"|"+string(S2B_FU_PA_VWAP_SESSION));
   for(int pf=0;pf<S2B_FU_PA_FIELDS;pf++)
      h=S2B_FU_Mix(h,"PA_DEF|"+S2B_FU_PAFieldName(pf)+"|"+S2B_FU_PAFieldFormula(pf));
   for(int f=0;f<g_fu_feat_count;f++)
      h=S2B_FU_Mix(h,IntegerToString(f)+"|"+g_fu_feat[f].name+"|"+g_fu_feat[f].group+"|"+g_fu_feat[f].tf_name);
   g_fu_proto.registry_hash=S2B_HashToString(h);
   uint d=0x85EBCA6B;
   for(int r=0;r<g_fu_row_count;r++)
      d=S2B_FU_Mix(d,IntegerToString(g_risklab_records[g_fu_rows[r]].setup_id)+"@"+
                     S2B_TimeKey(g_fu_time[r])+"@"+IntegerToString(g_fu_y[r])+"@"+
                     IntegerToString(g_risklab_records[g_fu_rows[r]].max_step_reached));
   g_fu_proto.dataset_hash=S2B_HashToString(d);
   uint m=0xC2B2AE35;
   for(int r=0;r<g_fu_row_count;r++)
   {
      string row="";
      for(int f=0;f<g_fu_feat_count;f++)
      {
         if(S2B_FU_OK(r,f)) row+=DoubleToString(S2B_FU_V(r,f),8)+";";
         else row+="NA;";
         if(StringLen(row)>3000){ m=S2B_FU_Mix(m,row); row=""; }
      }
      m=S2B_FU_Mix(m,row);
   }
   g_fu_proto.feature_matrix_hash=S2B_HashToString(m);
   uint k=0x27D4EB2F;
   for(int r=0;r<g_fu_row_count;r++)
      k=S2B_FU_Mix(k,IntegerToString(g_fu_rows[r])+":"+IntegerToString(g_fu_fold_val[r]));
   g_fu_proto.row_mask_hash=S2B_HashToString(k);
   uint fo=0x165667B1;
   for(int i=0;i<g_fu_fold_count;i++)
      fo=S2B_FU_Mix(fo,S2B_TimeKey(g_fu_folds[i].train_from)+">"+S2B_TimeKey(g_fu_folds[i].train_to)+">"+
                       S2B_TimeKey(g_fu_folds[i].val_from)+">"+S2B_TimeKey(g_fu_folds[i].val_to));
   g_fu_proto.fold_hash=S2B_HashToString(fo);
   g_fu_proto.row_policy_hash=S2B_HashToString(S2B_HashString32(S2B_FU_ROW_POLICY_VERSION));
   g_fu_proto.target_hash=S2B_HashToString(S2B_HashString32("TARGET|StopFlag|rec.stop_flag == true"));
   uint p=0x1B873593;
   p=S2B_FU_Mix(p,S2B_FU_PROTOCOL_VERSION);
   p=S2B_FU_Mix(p,S2B_FU_EVALUATOR_VERSION);
   p=S2B_FU_Mix(p,S2B_FU_MODEL_POLICY);
   p=S2B_FU_Mix(p,S2B_FU_PA_DEF_VERSION);
   p=S2B_FU_Mix(p,S2B_FU_FDR_VERSION);
   p=S2B_FU_Mix(p,g_fu_proto.registry_hash);
   p=S2B_FU_Mix(p,g_fu_proto.dataset_hash);
   p=S2B_FU_Mix(p,g_fu_proto.feature_matrix_hash);
   p=S2B_FU_Mix(p,g_fu_proto.row_mask_hash);
   p=S2B_FU_Mix(p,g_fu_proto.fold_hash);
   p=S2B_FU_Mix(p,g_fu_proto.row_policy_hash);
   p=S2B_FU_Mix(p,g_fu_proto.target_hash);
   g_fu_proto.protocol_hash=S2B_HashToString(p);
   uint c=0xCC9E2D51;
   c=S2B_FU_Mix(c,g_fu_proto.protocol_hash);
   c=S2B_FU_Mix(c,"DISCOVERY_ONLY|CANDIDATE_LOCK=BLOCKED|THRESHOLD_SELECTION=BLOCKED|HOLDOUT=UNTOUCHED");
   c=S2B_FU_Mix(c,IntegerToString(g_fu_proto.eligible_count)+"|"+IntegerToString(g_fu_proto.positive_count));
   g_fu_proto.context_hash=S2B_HashToString(c);
}
// GUARD LAYER 4 : final sweep before anything is written to disk.
bool S2B_FU_FinalHoldoutSweep(string &reason)
{
   reason="";
   datetime b=StringToTime(S2B_FU_DEV_TO);
   for(int r=0;r<g_fu_row_count;r++)
   {
      if(g_fu_time[r]>=b){ reason="EXPORT_ROW_IN_HOLDOUT"; return false; }
      if(g_snapshots[g_fu_snap[r]].entry_time>=b){ reason="EXPORT_SNAPSHOT_IN_HOLDOUT"; return false; }
   }
   for(int f=0;f<g_fu_fold_count;f++)
      if(g_fu_folds[f].val_to>b){ reason="EXPORT_FOLD_IN_HOLDOUT"; return false; }
   return true;
}
int S2B_FU_CollectWindowRows(datetime from,datetime to,int &out[])
{
   ArrayResize(out,g_fu_row_count);
   int n=0;
   for(int r=0;r<g_fu_row_count;r++)
      if(g_fu_time[r]>=from && g_fu_time[r]<to) out[n++]=r;
   ArrayResize(out,n);
   return n;
}
int S2B_FU_CollectCompleteRows(datetime from,datetime to,int &feats[],int nf,int &out[])
{
   ArrayResize(out,g_fu_row_count);
   int n=0;
   for(int r=0;r<g_fu_row_count;r++)
   {
      if(g_fu_time[r]<from || g_fu_time[r]>=to) continue;
      bool ok=true;
      for(int k=0;k<nf && ok;k++) if(!S2B_FU_OK(r,feats[k])) ok=false;
      if(ok) out[n++]=r;
   }
   ArrayResize(out,n);
   return n;
}
int S2B_FU_CountPos(int &rows[],int n)
{
   int p=0;
   for(int i=0;i<n;i++) if(g_fu_y[rows[i]]==1) p++;
   return p;
}
// ---------------------------------------------------------------------------
// Importance machinery (discovery only)
// ---------------------------------------------------------------------------
double g_fu_imp_logit[];
double g_fu_imp_rf_perm[];
double g_fu_imp_gb_perm[];
double g_fu_imp_rf_gain[];
double g_fu_imp_gb_gain[];
int    g_fu_filt[];
int    g_fu_filt_count=0;
int    g_fu_red[];
int    g_fu_red_count=0;
int    g_fu_red_status[];
int    g_fu_red_parent[];
double g_fu_red_absr[];
double g_fu_oof_auc_logit=0.5;
double g_fu_oof_auc_rf=0.5;
double g_fu_oof_auc_gb=0.5;
int    g_fu_oof_n=0;
int    g_fu_oof_pos=0;
int    g_fu_valid_folds=0;
void S2B_FU_ResetImportance()
{
   ArrayResize(g_fu_imp_logit,g_fu_feat_count);
   ArrayResize(g_fu_imp_rf_perm,g_fu_feat_count);
   ArrayResize(g_fu_imp_gb_perm,g_fu_feat_count);
   ArrayResize(g_fu_imp_rf_gain,g_fu_feat_count);
   ArrayResize(g_fu_imp_gb_gain,g_fu_feat_count);
   ArrayInitialize(g_fu_imp_logit,0.0);
   ArrayInitialize(g_fu_imp_rf_perm,0.0);
   ArrayInitialize(g_fu_imp_gb_perm,0.0);
   ArrayInitialize(g_fu_imp_rf_gain,0.0);
   ArrayInitialize(g_fu_imp_gb_gain,0.0);
}
void S2B_FU_ShuffleRows(int &rows[],int n)
{
   for(int i=n-1;i>0;i--)
   {
      int k=S2B_FU_RandInt(i+1);
      int t=rows[i]; rows[i]=rows[k]; rows[k]=t;
   }
}
double S2B_FU_LogitBaseAUC(SFULogit &m,int &va[],int nv)
{
   double sc[]; int ys[];
   ArrayResize(sc,nv); ArrayResize(ys,nv);
   for(int i=0;i<nv;i++){ sc[i]=S2B_FU_ScoreLogitRow(m,va[i]); ys[i]=g_fu_y[va[i]]; }
   return S2B_FU_AUCFromScores(sc,ys,nv);
}
double S2B_FU_LogitPermAUC(SFULogit &m,int &va[],int nv,int k_perm)
{
   int perm[];
   ArrayResize(perm,nv);
   for(int i=0;i<nv;i++) perm[i]=va[i];
   S2B_FU_ShuffleRows(perm,nv);
   double sc[]; int ys[]; double xrow[];
   ArrayResize(sc,nv); ArrayResize(ys,nv); ArrayResize(xrow,m.n_features);
   for(int i=0;i<nv;i++)
   {
      for(int k=0;k<m.n_features;k++) xrow[k]=S2B_FU_V(va[i],m.feat_pos[k]);
      xrow[k_perm]=S2B_FU_V(perm[i],m.feat_pos[k_perm]);
      sc[i]=S2B_FU_ScoreLogitVec(m,xrow);
      ys[i]=g_fu_y[va[i]];
   }
   return S2B_FU_AUCFromScores(sc,ys,nv);
}
double S2B_FU_TreeBaseAUC(int &va[],int nv,int model)
{
   double sc[]; int ys[];
   ArrayResize(sc,nv); ArrayResize(ys,nv);
   for(int i=0;i<nv;i++)
   {
      sc[i]=(model==0?S2B_FU_PredictForestRow(va[i]):S2B_FU_PredictBoostRow(va[i]));
      ys[i]=g_fu_y[va[i]];
   }
   return S2B_FU_AUCFromScores(sc,ys,nv);
}
double S2B_FU_TreePermAUC(int &va[],int nv,int j,int model)
{
   int perm[];
   ArrayResize(perm,nv);
   for(int i=0;i<nv;i++) perm[i]=va[i];
   S2B_FU_ShuffleRows(perm,nv);
   double sc[]; int ys[]; double xrow[];
   ArrayResize(sc,nv); ArrayResize(ys,nv); ArrayResize(xrow,g_fu_sel_count);
   for(int i=0;i<nv;i++)
   {
      for(int c=0;c<g_fu_sel_count;c++) xrow[c]=S2B_FU_X(va[i],c);
      xrow[j]=S2B_FU_X(perm[i],j);
      sc[i]=(model==0?S2B_FU_PredictForestVec(xrow):S2B_FU_PredictBoostVec(xrow));
      ys[i]=g_fu_y[va[i]];
   }
   return S2B_FU_AUCFromScores(sc,ys,nv);
}
// Filter (coverage + Mann-Whitney) then rank by |AUC-0.5|.
void S2B_FU_BuildFilteredSet()
{
   double key[]; int idx[];
   ArrayResize(key,g_fu_uni_count);
   ArrayResize(idx,g_fu_uni_count);
   int m=0;
   for(int i=0;i<g_fu_uni_count;i++)
   {
      if(g_fu_uni[i].usable!=1) continue;
      if(g_fu_uni[i].coverage_pct<S2B_FU_MIN_COVERAGE_PCT) continue;
      if(g_fu_uni[i].mw_p>=0.05) continue;
      key[m]=-g_fu_uni[i].auc_abs_dev;
      idx[m]=g_fu_uni[i].fi;
      m++;
   }
   ArrayResize(key,m);
   ArrayResize(idx,m);
   if(m>0) S2B_FU_SortIdxByValue(key,idx,m);
   int cap=(m<S2B_FU_MAX_FILTERED?m:S2B_FU_MAX_FILTERED);
   ArrayResize(g_fu_filt,cap);
   for(int i=0;i<cap;i++) g_fu_filt[i]=idx[i];
   g_fu_filt_count=cap;
   Print("FU_FILTER|UsableSignificant=",m,"|FilteredKept=",cap,
         "|MinCoveragePct=",DoubleToString(S2B_FU_MIN_COVERAGE_PCT,2),"|MaxP=0.05");
}
// Greedy redundancy clustering on the filtered ranked list.
void S2B_FU_BuildReducedSet()
{
   ArrayResize(g_fu_red_status,g_fu_filt_count);
   ArrayResize(g_fu_red_parent,g_fu_filt_count);
   ArrayResize(g_fu_red_absr,g_fu_filt_count);
   ArrayResize(g_fu_red,S2B_FU_TOP_REDUCED);
   g_fu_red_count=0;
   for(int i=0;i<g_fu_filt_count;i++)
   {
      g_fu_red_status[i]=0;
      g_fu_red_parent[i]=-1;
      g_fu_red_absr[i]=0.0;
      int f=g_fu_filt[i];
      bool drop=false;
      for(int k=0;k<g_fu_red_count && !drop;k++)
      {
         double r=MathAbs(S2B_FU_Pearson(f,g_fu_red[k]));
         if(r>=S2B_FU_REDUNDANCY_ABS_R)
         {
            drop=true;
            g_fu_red_parent[i]=g_fu_red[k];
            g_fu_red_absr[i]=r;
         }
      }
      if(drop){ g_fu_red_status[i]=2; continue; }
      if(g_fu_red_count<S2B_FU_TOP_REDUCED && g_fu_red_count<S2B_FU_MAX_MODEL_FEATS)
      {
         g_fu_red[g_fu_red_count]=f;
         g_fu_red_count++;
         g_fu_red_status[i]=1;
      }
      else g_fu_red_status[i]=3;
   }
   ArrayResize(g_fu_red,g_fu_red_count);
   Print("FU_REDUNDANCY|Filtered=",g_fu_filt_count,"|ReducedKept=",g_fu_red_count,
         "|AbsRThreshold=",DoubleToString(S2B_FU_REDUNDANCY_ABS_R,2));
}
void S2B_FU_RunLogisticOOF()
{
   if(g_fu_red_count<=0) return;
   double oof_sc[]; int oof_y[];
   ArrayResize(oof_sc,g_fu_row_count);
   ArrayResize(oof_y,g_fu_row_count);
   int on=0;
   double wsum=0.0;
   g_fu_valid_folds=0;
   for(int f=0;f<g_fu_fold_count;f++)
   {
      int tr[],va[];
      int nt=S2B_FU_CollectCompleteRows(g_fu_folds[f].train_from,g_fu_folds[f].train_to,g_fu_red,g_fu_red_count,tr);
      int nv=S2B_FU_CollectCompleteRows(g_fu_folds[f].val_from,g_fu_folds[f].val_to,g_fu_red,g_fu_red_count,va);
      int pt=S2B_FU_CountPos(tr,nt);
      int pv=S2B_FU_CountPos(va,nv);
      g_fu_folds[f].train_n=nt; g_fu_folds[f].train_pos=pt;
      g_fu_folds[f].val_n=nv;   g_fu_folds[f].val_pos=pv;
      g_fu_folds[f].ok=(nt>=S2B_FU_MIN_TRAIN_N && pt>=S2B_FU_MIN_TRAIN_POS &&
                        nv>=S2B_FU_MIN_VAL_N && pv>=S2B_FU_MIN_VAL_POS &&
                        (nt-pt)>0 && (nv-pv)>0);
      Print("FU_FOLD|Fold=",f+1,"|TrainN=",nt,"|TrainPos=",pt,"|ValN=",nv,"|ValPos=",pv,
            "|Usable=",(g_fu_folds[f].ok?"YES":"NO"));
      if(!g_fu_folds[f].ok){ ArrayFree(tr); ArrayFree(va); continue; }
      g_fu_valid_folds++;
      SFULogit m;
      if(!S2B_FU_TrainLogit(g_fu_red,g_fu_red_count,tr,nt,m)){ ArrayFree(tr); ArrayFree(va); continue; }
      for(int i=0;i<nv;i++){ oof_sc[on]=S2B_FU_ScoreLogitRow(m,va[i]); oof_y[on]=g_fu_y[va[i]]; on++; }
      double base=S2B_FU_LogitBaseAUC(m,va,nv);
      for(int k=0;k<g_fu_red_count;k++)
      {
         double acc=0.0;
         for(int rep=0;rep<S2B_FU_PERM_REPEATS_LOGIT;rep++)
            acc+=(base-S2B_FU_LogitPermAUC(m,va,nv,k));
         g_fu_imp_logit[g_fu_red[k]]+=(double)nv*acc/(double)S2B_FU_PERM_REPEATS_LOGIT;
      }
      wsum+=(double)nv;
      Print("FU_LOGIT_FOLD|Fold=",f+1,"|ValAUC=",DoubleToString(base,6),"|Features=",g_fu_red_count);
      ArrayFree(tr);
      ArrayFree(va);
   }
   if(wsum>0.0)
      for(int k=0;k<g_fu_red_count;k++) g_fu_imp_logit[g_fu_red[k]]/=wsum;
   ArrayResize(oof_sc,on);
   ArrayResize(oof_y,on);
   g_fu_oof_n=on;
   g_fu_oof_pos=0;
   for(int i=0;i<on;i++) if(oof_y[i]==1) g_fu_oof_pos++;
   if(on>=S2B_FU_MIN_VAL_N && g_fu_oof_pos>=S2B_FU_MIN_VAL_POS)
      g_fu_oof_auc_logit=S2B_FU_AUCFromScores(oof_sc,oof_y,on);
   Print("FU_LOGIT_OOF|N=",on,"|Pos=",g_fu_oof_pos,"|AUC=",DoubleToString(g_fu_oof_auc_logit,6),
         "|ValidFolds=",g_fu_valid_folds,"|CandidateLock=BLOCKED|ThresholdSelection=BLOCKED");
}
void S2B_FU_RunTreeImportance()
{
   if(g_fu_filt_count<=0) return;
   double rf_sc[],gb_sc[];
   int rf_y[];
   ArrayResize(rf_sc,g_fu_row_count);
   ArrayResize(gb_sc,g_fu_row_count);
   ArrayResize(rf_y,g_fu_row_count);
   int on=0;
   double wsum=0.0;
   for(int f=0;f<g_fu_fold_count;f++)
   {
      int tr[],va[];
      int nt=S2B_FU_CollectWindowRows(g_fu_folds[f].train_from,g_fu_folds[f].train_to,tr);
      int nv=S2B_FU_CollectWindowRows(g_fu_folds[f].val_from,g_fu_folds[f].val_to,va);
      int pt=S2B_FU_CountPos(tr,nt);
      int pv=S2B_FU_CountPos(va,nv);
      if(nt<S2B_FU_MIN_TRAIN_N || pt<S2B_FU_MIN_TRAIN_POS || nv<S2B_FU_MIN_VAL_N || pv<S2B_FU_MIN_VAL_POS)
      {
         Print("FU_TREE_FOLD_SKIPPED|Fold=",f+1,"|TrainN=",nt,"|TrainPos=",pt,"|ValN=",nv,"|ValPos=",pv);
         ArrayFree(tr); ArrayFree(va);
         continue;
      }
      S2B_FU_PrepareWorkMatrix(g_fu_filt,g_fu_filt_count,tr,nt);
      double gain_rf[],gain_gb[];
      ArrayResize(gain_rf,g_fu_sel_count);
      ArrayResize(gain_gb,g_fu_sel_count);
      ArrayInitialize(gain_rf,0.0);
      ArrayInitialize(gain_gb,0.0);
      S2B_FU_FitForest(tr,nt,gain_rf);
      double base_rf=S2B_FU_TreeBaseAUC(va,nv,0);
      S2B_FU_FitBoost(tr,nt,gain_gb);
      double base_gb=S2B_FU_TreeBaseAUC(va,nv,1);
      for(int i=0;i<nv;i++)
      {
         rf_sc[on]=S2B_FU_PredictForestRow(va[i]);
         gb_sc[on]=S2B_FU_PredictBoostRow(va[i]);
         rf_y[on]=g_fu_y[va[i]];
         on++;
      }
      for(int j=0;j<g_fu_sel_count;j++)
      {
         double arf=0.0,agb=0.0;
         for(int rep=0;rep<S2B_FU_PERM_REPEATS_TREE;rep++)
         {
            arf+=(base_rf-S2B_FU_TreePermAUC(va,nv,j,0));
            agb+=(base_gb-S2B_FU_TreePermAUC(va,nv,j,1));
         }
         int f_idx=g_fu_sel[j];
         g_fu_imp_rf_perm[f_idx]+=(double)nv*arf/(double)S2B_FU_PERM_REPEATS_TREE;
         g_fu_imp_gb_perm[f_idx]+=(double)nv*agb/(double)S2B_FU_PERM_REPEATS_TREE;
         g_fu_imp_rf_gain[f_idx]+=gain_rf[j];
         g_fu_imp_gb_gain[f_idx]+=gain_gb[j];
      }
      wsum+=(double)nv;
      Print("FU_TREE_FOLD|Fold=",f+1,"|TrainN=",nt,"|ValN=",nv,"|ValPos=",pv,
            "|RF_ValAUC=",DoubleToString(base_rf,6),"|GB_ValAUC=",DoubleToString(base_gb,6),
            "|Features=",g_fu_sel_count,"|ImportanceOnly=YES");
      ArrayFree(gain_rf);
      ArrayFree(gain_gb);
      ArrayFree(tr);
      ArrayFree(va);
   }
   if(wsum>0.0)
   {
      for(int i=0;i<g_fu_filt_count;i++)
      {
         int f_idx=g_fu_filt[i];
         g_fu_imp_rf_perm[f_idx]/=wsum;
         g_fu_imp_gb_perm[f_idx]/=wsum;
      }
   }
   ArrayResize(rf_sc,on);
   ArrayResize(gb_sc,on);
   ArrayResize(rf_y,on);
   if(on>=S2B_FU_MIN_VAL_N)
   {
      g_fu_oof_auc_rf=S2B_FU_AUCFromScores(rf_sc,rf_y,on);
      g_fu_oof_auc_gb=S2B_FU_AUCFromScores(gb_sc,rf_y,on);
   }
   Print("FU_TREE_OOF|N=",on,"|RF_AUC=",DoubleToString(g_fu_oof_auc_rf,6),
         "|GB_AUC=",DoubleToString(g_fu_oof_auc_gb,6),"|Role=IMPORTANCE_ONLY|DecisionModel=LOGISTIC");
}
// ---------------------------------------------------------------------------
// Exports
// ---------------------------------------------------------------------------
void S2B_FU_ExportProtocol()
{
   string fn=S2B_FU_File("Protocol")+".txt";
   int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);
   if(h==INVALID_HANDLE) return;
   FileWriteString(h,"STOPFLAG FULL FEATURE UNIVERSE - DISCOVERY PROTOCOL\n");
   FileWriteString(h,"CycleId="+string(S2B_FU_CYCLE_ID)+"\n");
   FileWriteString(h,"ProtocolVersion="+string(S2B_FU_PROTOCOL_VERSION)+"\n");
   FileWriteString(h,"EvaluatorVersion="+string(S2B_FU_EVALUATOR_VERSION)+"\n");
   FileWriteString(h,"RegistryVersion="+string(S2B_FU_REGISTRY_VERSION)+"\n");
   FileWriteString(h,"RowPolicyVersion="+string(S2B_FU_ROW_POLICY_VERSION)+"\n");
   FileWriteString(h,"ImportanceVersion="+string(S2B_FU_IMPORTANCE_VERSION)+"\n");
   FileWriteString(h,"ModelPolicy="+string(S2B_FU_MODEL_POLICY)+"\n");
   FileWriteString(h,"Symbol="+_Symbol+"\n");
   FileWriteString(h,"DevelopmentFrom="+string(S2B_FU_DEV_FROM)+"\nDevelopmentTo="+string(S2B_FU_DEV_TO)+"\n");
   FileWriteString(h,"HoldoutFrom="+string(S2B_FU_DEV_TO)+"\nHoldout=BLOCKED_UNTOUCHED\n");
   FileWriteString(h,"CandidateLock=BLOCKED\nThresholdSelection=BLOCKED\nWinner=BLOCKED\nFrozen=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n");
   FileWriteString(h,"Target=StopFlag|rec.stop_flag == true\n");
   FileWriteString(h,"RowPolicy=max_step_reached in [1..5] AND final_event non-empty AND snapshot resolved AND entry_time aligned AND atr[MAIN]>0\n");
   FileWriteString(h,"Bridge=g_risklab_records -> RL_FindSnapshotBySetupId_ForRL (g_snap_map_ids/g_snap_map_idx) -> g_snapshots\n");
   FileWriteString(h,"DataRegeneration=NONE\n");
   FileWriteString(h,StringFormat("SnapshotCount=%d\nRiskLabCount=%d\nDevelopmentRecords=%d\nEligible=%d\nExcluded=%d\nPositives=%d\nNegatives=%d\nFeatureCount=%d\n",
      g_fu_proto.snapshot_count,g_fu_proto.risklab_count,g_fu_proto.dev_record_count,
      g_fu_proto.eligible_count,g_fu_proto.excluded_count,g_fu_proto.positive_count,
      g_fu_proto.negative_count,g_fu_proto.feature_count));
   FileWriteString(h,"FirstEntry="+TimeToString(g_fu_proto.first_entry_time,TIME_DATE|TIME_MINUTES)+
                     "\nLastEntry="+TimeToString(g_fu_proto.last_entry_time,TIME_DATE|TIME_MINUTES)+"\n");
   for(int i=0;i<g_fu_fold_count;i++)
      FileWriteString(h,StringFormat("Fold%d=Train[%s..%s) Val[%s..%s)\n",i+1,
         TimeToString(g_fu_folds[i].train_from,TIME_DATE),TimeToString(g_fu_folds[i].train_to,TIME_DATE),
         TimeToString(g_fu_folds[i].val_from,TIME_DATE),TimeToString(g_fu_folds[i].val_to,TIME_DATE)));
   FileWriteString(h,"--- MULTIPLICITY CONTROL (frozen before run) ---\n");
   FileWriteString(h,"FDRVersion="+string(S2B_FU_FDR_VERSION)+"\nFDRFamily=ALL_UNIVARIATE_TESTS_OF_FINAL_UNIVERSE_SINGLE_FAMILY\n");
   FileWriteString(h,StringFormat("FDRStrongQ=%.4f\nFDRModerateQ=%.4f\nRawPReported=YES\nRawPRetained=YES\nPostRunThresholdChange=FORBIDDEN\nEmptyFDRResultIsValid=YES\n",
      S2B_FU_FDR_STRONG_Q,S2B_FU_FDR_MODERATE_Q));
   FileWriteString(h,"EffectSizeClass=NEGLIGIBLE|d|<0.2 SMALL|d|<0.5 MEDIUM|d|<0.8 LARGE otherwise\n");
   FileWriteString(h,"FoldStability=per-fold AUC + effect direction + 2of3 consistency + reversal flag (|dev|>="+DoubleToString(S2B_FU_FOLD_REVERSAL_DEV,2)+")\n");
   FileWriteString(h,"PermutationImportance=EXPLORATORY_ONLY|NoCandidate|NoThreshold\n");
   FileWriteString(h,"--- PRICE ACTION / DAILY VWAP PRE-REGISTRATION ---\n");
   FileWriteString(h,"PADefVersion="+string(S2B_FU_PA_DEF_VERSION)+"\nPAFeatureCount="+IntegerToString(S2B_FU_PA_FIELDS)+"\n");
   FileWriteString(h,"PAEntryTimeframe="+EnumToString((ENUM_TIMEFRAMES)Period())+"\n");
   FileWriteString(h,"PABarContract=b=iBarShift(entry_time) NOT_USED | b1=b+1 confirmation closed bar | b2=b+2 reference closed bar\n");
   FileWriteString(h,"PAAntiLeakage=NO_BAR_WITH_TIME>=ENTRY_TIME_IS_READ|ENTRY_BAR_EXCLUDED|ATR_FROM_FROZEN_SNAPSHOT\n");
   FileWriteString(h,StringFormat("PAPinbarRule=wick>=%.2f AND body<=%.2f AND clv side %.2f\n",
      S2B_FU_PA_PINBAR_WICK_MIN,S2B_FU_PA_PINBAR_BODY_MAX,S2B_FU_PA_PINBAR_CLV_MIN));
   FileWriteString(h,"VWAPPrice="+string(S2B_FU_PA_VWAP_PRICE)+"\nVWAPVolume="+string(S2B_FU_PA_VWAP_VOLUME)+
                     "\nVWAPSession="+string(S2B_FU_PA_VWAP_SESSION)+"\nVWAPTimezone=BROKER_SERVER_TIME\n");
   FileWriteString(h,StringFormat("VWAPResetRule=EVERY_SERVER_DAY_00:00\nVWAPMinBars=%d\nVWAPSlopeLagBars=%d\nVWAPMaxBars=%d\nVWAPFallback=NONE_REPORTED_AS_MISSING\nVWAPZeroVolumeBars=EXCLUDED\n",
      S2B_FU_PA_VWAP_MIN_BARS,S2B_FU_PA_VWAP_SLOPE_LAG,S2B_FU_PA_VWAP_MAX_BARS));
   for(int pf=0;pf<S2B_FU_PA_FIELDS;pf++)
      FileWriteString(h,"PAFeature"+IntegerToString(pf)+"="+S2B_FU_PAFieldName(pf)+"|"+
                        S2B_FU_PAFieldGroup(pf)+"|"+S2B_FU_PAFieldFormula(pf)+"\n");
   for(int cf=0;cf<g_fu_feat_count;cf++)
   {
      if(g_fu_feat[cf].kind!=S2B_FU_KIND_PA) continue;
      int vok=0;
      for(int r=0;r<g_fu_row_count;r++) if(S2B_FU_OK(r,cf)) vok++;
      FileWriteString(h,StringFormat("PACoverage|%s|valid=%d|total=%d|coverage_pct=%.4f|missing=%d\n",
         g_fu_feat[cf].name,vok,g_fu_row_count,
         (g_fu_row_count>0?100.0*(double)vok/(double)g_fu_row_count:0.0),g_fu_row_count-vok));
   }
   FileWriteString(h,"--- HASHES ---\n");
   FileWriteString(h,"RegistryHash="+g_fu_proto.registry_hash+"\nDatasetHash="+g_fu_proto.dataset_hash+
                     "\nFeatureMatrixHash="+g_fu_proto.feature_matrix_hash+"\nRowMaskHash="+g_fu_proto.row_mask_hash+
                     "\nFoldHash="+g_fu_proto.fold_hash+"\nRowPolicyHash="+g_fu_proto.row_policy_hash+
                     "\nTargetHash="+g_fu_proto.target_hash+"\nProtocolHash="+g_fu_proto.protocol_hash+
                     "\nContextHash="+g_fu_proto.context_hash+"\n");
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
void S2B_FU_ExportCoverage()
{
   string fn=S2B_FU_File("FeatureCoverage")+".csv";
   int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_COMMON,",");
   if(h==INVALID_HANDLE) return;
   FileWrite(h,"feature_index","feature","group","timeframe","kind","valid_rows","total_rows",
               "coverage_pct","valid_positives","valid_negatives","prevalence","usable");
   for(int i=0;i<g_fu_uni_count;i++)
   {
      int f=g_fu_uni[i].fi;
      FileWrite(h,IntegerToString(f),g_fu_feat[f].name,g_fu_feat[f].group,g_fu_feat[f].tf_name,
                IntegerToString(g_fu_feat[f].kind),
                IntegerToString(g_fu_uni[i].n_valid),IntegerToString(g_fu_row_count),
                DoubleToString(g_fu_uni[i].coverage_pct,4),
                IntegerToString(g_fu_uni[i].pos_valid),IntegerToString(g_fu_uni[i].neg_valid),
                DoubleToString(g_fu_uni[i].prevalence,6),IntegerToString(g_fu_uni[i].usable));
   }
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
