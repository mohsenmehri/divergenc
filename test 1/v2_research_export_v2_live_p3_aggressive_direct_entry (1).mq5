   {
      trained=false; n_features=0; intercept=0.0;
      for(int i=0;i<S2B_FU_MAX_MODEL_FEATS;i++){feat_pos[i]=-1;mean[i]=0.0;sd[i]=1.0;w[i]=0.0;}
   }
};
