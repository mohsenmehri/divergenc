void S2B_FU_ExportRedundancy()
{
   string fn=S2B_FU_File("Redundancy")+".csv";
   int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_COMMON,",");
   if(h==INVALID_HANDLE) return;
   FileWrite(h,"rank","feature_index","feature","group","timeframe","auc","auc_abs_dev",
               "status","kept_by_feature","abs_pearson_r");
   for(int i=0;i<g_fu_filt_count;i++)
   {
      int f=g_fu_filt[i];
      double auc=0.5,dev=0.0;
      for(int u=0;u<g_fu_uni_count;u++)
         if(g_fu_uni[u].fi==f){ auc=g_fu_uni[u].auc; dev=g_fu_uni[u].auc_abs_dev; break; }
      string status="KEPT_REDUCED";
      if(g_fu_red_status[i]==2) status="DROPPED_REDUNDANT";
      else if(g_fu_red_status[i]==3) status="DROPPED_CAP";
      string parent="NONE";
      if(g_fu_red_parent[i]>=0) parent=g_fu_feat[g_fu_red_parent[i]].name;
      FileWrite(h,IntegerToString(i+1),IntegerToString(f),g_fu_feat[f].name,g_fu_feat[f].group,
                g_fu_feat[f].tf_name,DoubleToString(auc,6),DoubleToString(dev,6),
                status,parent,DoubleToString(g_fu_red_absr[i],6));
   }
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
void S2B_FU_ExportPermImportance()
{
   string fn=S2B_FU_File("PermImportance")+".csv";
   int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_COMMON,",");
   if(h==INVALID_HANDLE) return;
   FileWrite(h,"feature_index","feature","group","timeframe","in_filtered","in_reduced",
               "logit_perm_auc_drop","rf_perm_auc_drop","gb_perm_auc_drop",
               "rf_gain","gb_gain","univariate_auc","coverage_pct");
   for(int i=0;i<g_fu_filt_count;i++)
   {
      int f=g_fu_filt[i];
      int inred=0;
      for(int k=0;k<g_fu_red_count;k++) if(g_fu_red[k]==f) inred=1;
      double auc=0.5,cov=0.0;
      for(int u=0;u<g_fu_uni_count;u++)
         if(g_fu_uni[u].fi==f){ auc=g_fu_uni[u].auc; cov=g_fu_uni[u].coverage_pct; break; }
      FileWrite(h,IntegerToString(f),g_fu_feat[f].name,g_fu_feat[f].group,g_fu_feat[f].tf_name,
                "1",IntegerToString(inred),
                DoubleToString(g_fu_imp_logit[f],8),DoubleToString(g_fu_imp_rf_perm[f],8),
                DoubleToString(g_fu_imp_gb_perm[f],8),DoubleToString(g_fu_imp_rf_gain[f],8),
                DoubleToString(g_fu_imp_gb_gain[f],8),DoubleToString(auc,6),DoubleToString(cov,4));
   }
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
void S2B_FU_ExportTimeframeImportance()
{
   string fn=S2B_FU_File("TimeframeImportance")+".csv";
   int h=FileOpen(fn,FILE_WRITE|FILE_CSV|FILE_COMMON,",");
   if(h==INVALID_HANDLE) return;
   FileWrite(h,"timeframe","features_total","features_usable","features_filtered","features_reduced",
               "mean_auc_abs_dev","max_auc_abs_dev","best_feature","sum_logit_perm","sum_rf_perm",
               "sum_gb_perm","sum_rf_gain","sum_gb_gain");
   string tfs[8];
   int ntf=0;
   for(int f=0;f<g_fu_feat_count;f++)
   {
      bool seen=false;
      for(int t=0;t<ntf;t++) if(tfs[t]==g_fu_feat[f].tf_name) seen=true;
      if(!seen && ntf<8){ tfs[ntf]=g_fu_feat[f].tf_name; ntf++; }
   }
   for(int t=0;t<ntf;t++)
   {
      int tot=0,usable=0,filt=0,red=0;
      double sumdev=0.0,maxdev=0.0,sl=0.0,sr=0.0,sg=0.0,grf=0.0,ggb=0.0;
      string best="NONE";
      for(int f=0;f<g_fu_feat_count;f++)
      {
         if(g_fu_feat[f].tf_name!=tfs[t]) continue;
         tot++;
         for(int u=0;u<g_fu_uni_count;u++)
         {
            if(g_fu_uni[u].fi!=f) continue;
            if(g_fu_uni[u].usable==1)
            {
               usable++;
               sumdev+=g_fu_uni[u].auc_abs_dev;
               if(g_fu_uni[u].auc_abs_dev>maxdev){ maxdev=g_fu_uni[u].auc_abs_dev; best=g_fu_feat[f].name; }
            }
            break;
         }
         for(int i=0;i<g_fu_filt_count;i++) if(g_fu_filt[i]==f) filt++;
         for(int k=0;k<g_fu_red_count;k++) if(g_fu_red[k]==f) red++;
         sl+=g_fu_imp_logit[f];
         sr+=g_fu_imp_rf_perm[f];
         sg+=g_fu_imp_gb_perm[f];
         grf+=g_fu_imp_rf_gain[f];
         ggb+=g_fu_imp_gb_gain[f];
      }
      FileWrite(h,tfs[t],IntegerToString(tot),IntegerToString(usable),IntegerToString(filt),
                IntegerToString(red),DoubleToString((usable>0?sumdev/usable:0.0),6),
                DoubleToString(maxdev,6),best,DoubleToString(sl,8),DoubleToString(sr,8),
                DoubleToString(sg,8),DoubleToString(grf,8),DoubleToString(ggb,8));
   }
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
void S2B_FU_ExportModelSummary()
{
   string fn=S2B_FU_File("ModelSummary")+".txt";
   int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);
   if(h==INVALID_HANDLE) return;
   FileWriteString(h,"STOPFLAG FULL FEATURE UNIVERSE - DISCOVERY MODEL SUMMARY\n");
   FileWriteString(h,"CycleId="+string(S2B_FU_CYCLE_ID)+"\nProtocolHash="+g_fu_proto.protocol_hash+
                     "\nContextHash="+g_fu_proto.context_hash+"\n");
   FileWriteString(h,"CandidateLock=BLOCKED\nThresholdSelection=BLOCKED\nHoldout=BLOCKED_UNTOUCHED\n");
   FileWriteString(h,"DecisionModel=LOGISTIC_REGRESSION\nRF=IMPORTANCE_ONLY\nGB=IMPORTANCE_ONLY\nNN=NOT_USED\n");
   FileWriteString(h,StringFormat("UniverseFeatures=%d\nFilteredFeatures=%d\nReducedFeatures=%d\nEligibleRows=%d\nPositives=%d\n",
      g_fu_feat_count,g_fu_filt_count,g_fu_red_count,g_fu_row_count,g_fu_proto.positive_count));
   FileWriteString(h,StringFormat("ValidFolds=%d\nOOF_N=%d\nOOF_Pos=%d\nOOF_AUC_Logit=%.6f\nOOF_AUC_RF=%.6f\nOOF_AUC_GB=%.6f\n",
      g_fu_valid_folds,g_fu_oof_n,g_fu_oof_pos,g_fu_oof_auc_logit,g_fu_oof_auc_rf,g_fu_oof_auc_gb));
   FileWriteString(h,StringFormat("RF=trees:%d depth:%d min_leaf:%d bins:%d\nGB=rounds:%d depth:%d min_leaf:%d lr:%.4f lambda:%.4f\n",
      S2B_FU_RF_TREES,S2B_FU_RF_MAX_DEPTH,S2B_FU_RF_MIN_LEAF,S2B_FU_BINS,
      S2B_FU_GB_ROUNDS,S2B_FU_GB_MAX_DEPTH,S2B_FU_GB_MIN_LEAF,S2B_FU_GB_LR,S2B_FU_GB_LAMBDA));
   FileWriteString(h,StringFormat("PermRepeats=logit:%d tree:%d\nSeed=%d\nMissingPolicy=LOGIT:COMPLETE_CASE|TREES:TRAIN_MEDIAN_IMPUTATION\n",
      S2B_FU_PERM_REPEATS_LOGIT,S2B_FU_PERM_REPEATS_TREE,(int)S2B_FU_SEED));
   for(int i=0;i<g_fu_fold_count;i++)
      FileWriteString(h,StringFormat("FoldCardinality%d=TrainN:%d TrainPos:%d ValN:%d ValPos:%d Usable:%s\n",
         i+1,g_fu_folds[i].train_n,g_fu_folds[i].train_pos,g_fu_folds[i].val_n,g_fu_folds[i].val_pos,
         (g_fu_folds[i].ok?"YES":"NO")));
   FileWriteString(h,"ReducedSet=");
   for(int k=0;k<g_fu_red_count;k++)
      FileWriteString(h,g_fu_feat[g_fu_red[k]].name+(k<g_fu_red_count-1?"|":""));
   FileWriteString(h,"\n");
   FileWriteString(h,StringFormat("FDRFamilySize=%d\nFDRStrong_q_lt_005=%d\nFDRModerate_q_lt_010=%d\nExploratoryOnly_rawp_lt_005=%d\n",
      g_fu_fdr_family,g_fu_fdr_strong,g_fu_fdr_moderate,g_fu_fdr_exploratory));
   FileWriteString(h,"ModelFeatureFilter=RAW_P_LT_0.05_AND_COVERAGE_GE_90|LabelledEXPLORATORY|NotAConfirmatorySelection\n");
   FileWriteString(h,"PermutationImportance=EXPLORATORY_ONLY\nManualScoringSystem=NOT_CREATED\n");
   FileWriteString(h,"PostRunFeatureRedefinition=FORBIDDEN_REQUIRES_NEW_CYCLE_AND_NEW_HASHES\n");
   FileWriteString(h,"Interpretation=DISCOVERY_ONLY_NO_DEPLOYABLE_ARTIFACT\n");
   FileClose(h);
   Print("FU_EXPORT|",fn);
}
// ---------------------------------------------------------------------------
// Discovery runner (single entry point)
// ---------------------------------------------------------------------------
void S2B_FU_RunDiscovery()
{
   Print("================ STOPFLAG FULL FEATURE UNIVERSE DISCOVERY v2 ================");
   Print("FU_V2|FDR=",S2B_FU_FDR_VERSION,"|PriceAction=",S2B_FU_PA_DEF_VERSION,
         "|PAEntryTF=",EnumToString((ENUM_TIMEFRAMES)Period()),
         "|SecondTarget=NONE|ManualScoring=NONE|PermImportance=EXPLORATORY_ONLY");
   Print("FU_START|CycleId=",S2B_FU_CYCLE_ID,"|Mode=DISCOVERY_ONLY|Dev=[",S2B_FU_DEV_FROM,",",
         S2B_FU_DEV_TO,")|Holdout=BLOCKED|CandidateLock=BLOCKED|ThresholdSelection=BLOCKED");
   S2B_FU_ResetState();
   string reason="";
   if(!S2B_FU_ValidateRunBoundary(reason))
   {
      g_fu_block_reason=reason;
      Print("FU_ABORT|",reason);
      return;
   }
   S2B_FU_BuildRegistry();
   Print("FU_REGISTRY|Features=",g_fu_feat_count,"|Timeframes=",TF_COUNT,"|RegistryVersion=",S2B_FU_REGISTRY_VERSION);
   if(!S2B_FU_BuildFolds(reason))
   {
      g_fu_block_reason=reason;
      Print("FU_ABORT|",reason);
      return;
   }
   if(!S2B_FU_CollectRows(reason))
   {
      g_fu_block_reason=reason;
      Print("FU_ABORT|",reason);
      return;
   }
   Print("FU_ROWS|DevRecords=",g_fu_proto.dev_record_count,"|Eligible=",g_fu_row_count,
         "|Excluded=",g_fu_proto.excluded_count,"|Positives=",g_fu_proto.positive_count,
         "|Negatives=",g_fu_proto.negative_count);
   if(!S2B_FU_BuildMatrix(reason))
   {
      g_fu_block_reason=reason;
      Print("FU_ABORT|",reason);
      return;
   }
   S2B_FU_BuildHashes();
   Print("FU_HASHES|Registry=",g_fu_proto.registry_hash,"|Dataset=",g_fu_proto.dataset_hash,
         "|Matrix=",g_fu_proto.feature_matrix_hash,"|RowMask=",g_fu_proto.row_mask_hash,
         "|Fold=",g_fu_proto.fold_hash,"|Protocol=",g_fu_proto.protocol_hash,
         "|Context=",g_fu_proto.context_hash);
   if(!S2B_FU_FinalHoldoutSweep(reason))
   {
      g_fu_block_reason=reason;
      Print("FU_ABORT|",reason);
      return;
   }
   g_fu_proto.valid=true;
   S2B_FU_ExportProtocol();
   ArrayResize(g_fu_uni,g_fu_feat_count);
   g_fu_uni_count=g_fu_feat_count;
   for(int f=0;f<g_fu_feat_count;f++)
   {
      SFUUniStat st;
      S2B_FU_Univariate(f,st);
      st.fi=f;
      g_fu_uni[f]=st;
   }
   S2B_FU_FoldStability();
   S2B_FU_ApplyBH();
   S2B_FU_ExportCoverage();
   S2B_FU_ExportUnivariate();
   S2B_FU_ResetImportance();
   S2B_FU_BuildFilteredSet();
   S2B_FU_BuildReducedSet();
   S2B_FU_ExportRedundancy();
   S2B_FU_RunLogisticOOF();
   S2B_FU_RunTreeImportance();
   if(!S2B_FU_FinalHoldoutSweep(reason))
   {
      Print("FU_ABORT_BEFORE_IMPORTANCE_EXPORT|",reason);
      return;
   }
   S2B_FU_ExportPermImportance();
   S2B_FU_ExportTimeframeImportance();
   S2B_FU_ExportModelSummary();
   Print("FU_DONE|Features=",g_fu_feat_count,"|Filtered=",g_fu_filt_count,"|Reduced=",g_fu_red_count,
         "|OOF_AUC_Logit=",DoubleToString(g_fu_oof_auc_logit,6),
         "|OOF_AUC_RF=",DoubleToString(g_fu_oof_auc_rf,6),
         "|OOF_AUC_GB=",DoubleToString(g_fu_oof_auc_gb,6));
   Print("FU_END|CandidateLock=BLOCKED|ThresholdSelection=BLOCKED|Winner=BLOCKED|Frozen=BLOCKED|Stage2C=BLOCKED|Stage2D=BLOCKED|Holdout=UNTOUCHED");
}
//---------------------------------------------------------------
// Run Phase 7
//---------------------------------------------------------------
void S2B_RunPhase7()
{
   Print("=== Stage 2B Phase 7 START ===");
   // Existing Step4 outcome diagnostics
   S2B_ExportStep4OutcomeTable();
   S2B_ExportBandOutcomeDiagnostics();
   S2B_ExportStep4OutcomeSummary();
   // New independent StopFlag pipeline
   S2B_RunStopFlagPipeline();
   Print("=== Stage 2B Phase 7 DONE ===");
}
void S2B_RunStopFlagPipeline()
{
   if(inp_s2b_phase_b_threshold_only)
   {
      Print("=== Stage 2B StopFlag — PHASE B DEV-ONLY OOF START ===");
      // This call initializes the shared protocol, the two DEV-only folds,
      // the Stop evaluation context and the common Stop row mask. It does
      // not call Final Dev->2023 evaluation.
      S2B_RunWalkForward_Stop_v2();
      if(g_s2b_stop_context.valid)
         S2B_RunStopPhaseB();
      else
      {
         g_s2b_stop_phaseb_verdict = "BLOCKED_STOP_CONTEXT_INVALID";
         g_s2b_stop_phaseb_block_reason = g_s2b_stop_context.invalid_reason;
         g_s2b_stop_operational_threshold_selected = false;
         S2B_ExportStopThresholdTradeoff();
         S2B_ExportStopThresholdLock();
      }
      g_s2b_stop_context.historical_confirmation_used = false;
      g_s2b_stop_oos_allowed = false;
      g_s2b_stop_winner_confirmed = false;
      g_s2b_stop_freeze_allowed = false;
      g_s2b_stop_frozen_generated_this_run = false;
      Print("STOP_PHASEB_GUARD",
            "|2023=HISTORICAL_CONFIRMATION_SELECTION_AWARE_NOT_BLIND_NOT_ACCESSED",
            "|2024_2026=RESERVED_UNTOUCHED_TRUE_HOLDOUT",
            "|NUMERIC_PROBABILITY_THRESHOLD_SELECTED=NO",
            "|HISTORICAL_CONFIRMATION=BLOCKED",
            "|WINNER_CONFIRMATION=BLOCKED",
            "|FROZEN_EXPORT=BLOCKED",
            "|STAGE2C=BLOCKED",
            "|STAGE2D=BLOCKED");
      Print("=== Stage 2B StopFlag — PHASE B DEV-ONLY OOF DONE ===");
      return;
   }
   Print("=== Stage 2B StopFlag — PHASE A START ===");
   S2B_RunWalkForward_Stop_v2();
   if(g_s2b_stop_search_allowed && g_s2b_stop_context.valid)
   {
      S2B_RunSystematicCompactSearch_Stop(4, 6);
      S2B_ExportCompactSearchReport_Stop();
      S2B_ExportStopCandidateLock();
   }
   else
   {
      Print("STOP_PHASE_A|BLOCKED|Reason=", g_s2b_stop_block_reason);
   }
   g_s2b_stop_context.historical_confirmation_used = false;
   g_s2b_stop_context.threshold_selected = false;
   g_s2b_stop_oos_allowed = false;
   g_s2b_stop_winner_confirmed = false;
   g_s2b_stop_freeze_allowed = false;
   g_s2b_stop_frozen_generated_this_run = false;
   Print("STOP_PHASE_A_GUARD",
         "|2023=HISTORICAL_CONFIRMATION_SELECTION_AWARE_NOT_BLIND_NOT_ACCESSED",
         "|2024PLUS=RESERVED_UNTOUCHED_TRUE_HOLDOUT",
         "|THRESHOLD_SELECTED=NO",
         "|WINNER_CONFIRMATION=BLOCKED",
         "|FROZEN_EXPORT=BLOCKED",
         "|STAGE2C=BLOCKED",
         "|STAGE2D=BLOCKED");
   Print("=== Stage 2B StopFlag — PHASE A DONE ===");
}
#define S2C_N_BANDS       5
// Band boundaries — from OOS quintiles
// Updated after each fresh backtest via S2C_ComputeBandBoundaries()
double g_s2c_band_boundaries[4] = { 0.4492, 0.4730, 0.4987, 0.5365 };
// Band names
string S2C_BandName(int band)
{
   switch(band)
   {
      case 0: return "E_MinimalRisk";
      case 1: return "D_LowRisk";
      case 2: return "C_ModerateRisk";
      case 3: return "B_HighRisk";
      case 4: return "A_VeryHighRisk";
   }
   return "UNKNOWN";
}
// Decision from band
string S2C_DecisionFromBand(int band)
{
   switch(band)
   {
      case 4: return "VERY_HIGH_PATH_RISK";
      case 3: return "HIGH_PATH_RISK";
      case 2: return "MODERATE_PATH_RISK";
      case 1: return "LOW_PATH_RISK";
      case 0: return "MINIMAL_PATH_RISK";
   }
   return "UNKNOWN";
}
string S2C_OverlayActionText(int band)
{
   switch(band)
   {
      case 4:
         return "Require strongest confirmation; reduce exposure if risk budget is tight; do not use as standalone reject.";
      case 3:
         return "Use caution; require stronger confirmation; monitor path risk.";
      case 2:
         return "Neutral path risk; use normal confirmation rules.";
      case 1:
         return "Favorable path risk; lower expected path complexity.";
      case 0:
         return "Most favorable path risk; simplest expected path.";
   }
   return "UNKNOWN";
}
// ================================================================
// S2C_ScoreStep4
// Score one snapshot using compact winner model
// Returns raw sigmoid score
// ================================================================
double S2C_ScoreStep4(SEntrySnapshot &sn)
{
   if(!g_s2b_compact_winner.trained)
      return 0.5;
   int n_feat = g_s2b_compact_winner.n_features;
   double fvec[];
   ArrayResize(fvec, n_feat);
   // Extract features from snapshot
   for(int k = 0; k < n_feat; k++)
   {
      int fi = g_s2b_compact_winner.feature_idx[k];
      double v = 0.0;
      switch(fi)
      {
         case S2B_F_ADX_M30:
            v = sn.adx[TF_IDX_M30];
            break;
         case S2B_F_ADX_SLOPE_M15:
            v = sn.adx_slope[TF_IDX_M15];
            break;
         case S2B_F_EMA_COMP_H4:
            v = sn.ema_compression[TF_IDX_H4];
            break;
         case S2B_F_OB_DIST_PCT:
            v = sn.ob_dist_pct;
            if(v < 0.0) v = 0.0;
            break;
         default:
            v = 0.0;
            break;
      }
      fvec[k] = v;
   }
   // Normalize using DEV params
   double fvec_norm[];
   ArrayResize(fvec_norm, n_feat);
   for(int k = 0; k < n_feat; k++)
   {
      double s = g_s2b_compact_winner.feat_std[k];
      if(s < 1e-10) s = 1.0;
      fvec_norm[k] = (fvec[k] - g_s2b_compact_winner.feat_mean[k]) / s;
   }
   // Logistic prediction
   double z = g_s2b_compact_winner.intercept;
   for(int k = 0; k < n_feat; k++)
      z += g_s2b_compact_winner.weights[k] * fvec_norm[k];
   double score = S2B_Sigmoid(z);
   ArrayFree(fvec);
   ArrayFree(fvec_norm);
   return score;
}
// ================================================================
// S2C_GetBand
// Convert raw score to band index (0-4)
// ================================================================
int S2C_GetBand(double raw_score)
{
   if(raw_score < g_s2c_band_boundaries[0]) return 0; // E
   if(raw_score < g_s2c_band_boundaries[1]) return 1; // D
   if(raw_score < g_s2c_band_boundaries[2]) return 2; // C
   if(raw_score < g_s2c_band_boundaries[3]) return 3; // B
   return 4; // A
}
// ================================================================
// S2C_ComputeBandBoundaries
// Recompute quintile boundaries from current OOS data
// ================================================================
void S2C_ComputeBandBoundaries()
{
   if(!g_s2b_compact_winner.trained) return;
   int n_feat = g_s2b_compact_winner.n_features;
   double scores[];
   ArrayResize(scores, g_risklab_count);
   int n = 0;
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      n_feat);
   ArrayResize(fvec_norm, n_feat);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      if(!S2B_BuildFeatureVector(r, g_s2b_compact_winner, fvec)) continue;
      S2B_NormalizeVector(fvec, g_s2b_compact_winner, fvec_norm);
      double z = g_s2b_compact_winner.intercept;
      for(int k = 0; k < n_feat; k++)
         z += g_s2b_compact_winner.weights[k] * fvec_norm[k];
      scores[n++] = S2B_Sigmoid(z);
   }
   ArrayFree(fvec);
   ArrayFree(fvec_norm);
   if(n < 20)
   {
      Print("S2C_ComputeBandBoundaries: Not enough OOS samples (", n, ")");
      return;
   }
   ArrayResize(scores, n);
   ArraySort(scores);
   g_s2c_band_boundaries[0] = scores[(int)(n * 0.20)];
   g_s2c_band_boundaries[1] = scores[(int)(n * 0.40)];
   g_s2c_band_boundaries[2] = scores[(int)(n * 0.60)];
   g_s2c_band_boundaries[3] = scores[(int)(n * 0.80)];
   ArrayFree(scores);
   Print("S2C Band boundaries updated:",
         " Q20=", DoubleToString(g_s2c_band_boundaries[0], 4),
         " Q40=", DoubleToString(g_s2c_band_boundaries[1], 4),
         " Q60=", DoubleToString(g_s2c_band_boundaries[2], 4),
         " Q80=", DoubleToString(g_s2c_band_boundaries[3], 4));
}
// ================================================================
// S2C_ScoreRiskLabRecord
// Score one risklab record (for batch scoring)
// ================================================================
double S2C_ScoreRiskLabRecord(int rec_idx)
{
   if(!g_s2b_compact_winner.trained) return 0.5;
   if(rec_idx < 0 || rec_idx >= g_risklab_count) return 0.5;
   int n_feat = g_s2b_compact_winner.n_features;
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      n_feat);
   ArrayResize(fvec_norm, n_feat);
   if(!S2B_BuildFeatureVector(rec_idx, g_s2b_compact_winner, fvec))
   {
      ArrayFree(fvec);
      ArrayFree(fvec_norm);
      return 0.5;
   }
   S2B_NormalizeVector(fvec, g_s2b_compact_winner, fvec_norm);
   double z = g_s2b_compact_winner.intercept;
   for(int k = 0; k < n_feat; k++)
      z += g_s2b_compact_winner.weights[k] * fvec_norm[k];
   double score = S2B_Sigmoid(z);
   ArrayFree(fvec);
   ArrayFree(fvec_norm);
   return score;
}
// ================================================================
// S2C_ExportStep4ScorePolicy
// Export scoring policy + band performance + decision rules
// ================================================================
void S2C_ExportStep4ScorePolicy()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C_ExportStep4ScorePolicy: Winner not trained.");
      return;
   }
   Print("=== Stage 2C Path Risk Policy Export START ===");
   string fn = "Stage2C_PathRiskPolicy_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create Stage2C path risk policy file.");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2C.1 — PATH / DEPTH RISK OVERLAY POLICY\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, "Model  : Step4_CompactWinner (4 features)\n");
   FileWriteString(h, line);
   // --- Model specification ---
   FileWriteString(h, "\n[MODEL SPECIFICATION]\n" + sep);
   FileWriteString(h, "  Official Compact Candidate Features:\n");
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
   {
      FileWriteString(h, StringFormat(
         "    %d. %-25s  w=%+.6f  (mean=%.4f  std=%.4f)\n",
         k + 1,
         S2B_FeatureName(g_s2b_compact_winner.feature_idx[k]),
         g_s2b_compact_winner.weights[k],
         g_s2b_compact_winner.feat_mean[k],
         g_s2b_compact_winner.feat_std[k]));
   }
   FileWriteString(h, StringFormat("  Intercept: %+.6f\n", g_s2b_compact_winner.intercept));
   FileWriteString(h, StringFormat("  DEV AUC  : %.4f\n", g_s2b_compact_winner.dev_auc));
   FileWriteString(h, StringFormat("  OOS AUC  : %.4f\n", g_s2b_compact_winner.oos_auc));
   FileWriteString(h, "  IMPORTANT: Model output is a ranking / path-risk score, NOT calibrated probability.\n");
   // --- Band boundaries ---
   FileWriteString(h, "\n[BAND BOUNDARIES]\n" + sep);
   FileWriteString(h, "  Method: OOS quintile-based\n\n");
   FileWriteString(h, StringFormat("  %-18s  %-22s\n", "Band", "Score Range"));
   FileWriteString(h, sep);
   FileWriteString(h, StringFormat("  %-18s  score < %.4f\n", S2C_BandName(0), g_s2c_band_boundaries[0]));
   FileWriteString(h, StringFormat("  %-18s  %.4f <= score < %.4f\n", S2C_BandName(1), g_s2c_band_boundaries[0], g_s2c_band_boundaries[1]));
   FileWriteString(h, StringFormat("  %-18s  %.4f <= score < %.4f\n", S2C_BandName(2), g_s2c_band_boundaries[1], g_s2c_band_boundaries[2]));
   FileWriteString(h, StringFormat("  %-18s  %.4f <= score < %.4f\n", S2C_BandName(3), g_s2c_band_boundaries[2], g_s2c_band_boundaries[3]));
   FileWriteString(h, StringFormat("  %-18s  score >= %.4f\n", S2C_BandName(4), g_s2c_band_boundaries[3]));
   // --- Decision / overlay policy ---
   FileWriteString(h, "\n[PATH RISK OVERLAY POLICY]\n" + sep);
   FileWriteString(h, "  NOTE: Band = risk tier, not entry-quality tier.\n");
   FileWriteString(h, "  High score means higher probability of deep / costly path.\n\n");
   FileWriteString(h, StringFormat("  %-18s  %-24s  %s\n", "Band", "Risk Tier", "Overlay Guidance"));
   FileWriteString(h, sep);
   for(int b = 4; b >= 0; b--)
   {
      FileWriteString(h, StringFormat("  %-18s  %-24s  %s\n",
         S2C_BandName(b),
         S2C_DecisionFromBand(b),
         S2C_OverlayActionText(b)));
   }
   // --- Band performance on OOS ---
   FileWriteString(h, "\n[BAND PERFORMANCE — OOS]\n" + sep);
   int    band_n[5], band_step4[5], band_profit[5], band_stop[5], band_deep[5];
   double band_pnl[5], band_dd[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_step4, 0);
   ArrayInitialize(band_profit, 0);
   ArrayInitialize(band_stop, 0);
   ArrayInitialize(band_deep, 0);
   ArrayInitialize(band_pnl, 0.0);
   ArrayInitialize(band_dd, 0.0);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      band_n[band]++;
      if(g_risklab_records[r].hit_step4_plus) band_step4[band]++;
      if(g_risklab_records[r].pnl > 0.0)      band_profit[band]++;
      if(g_risklab_records[r].stop_flag)      band_stop[band]++;
      if(g_risklab_records[r].stop_flag && g_risklab_records[r].max_step_reached >= 4) band_deep[band]++;
      band_pnl[band] += g_risklab_records[r].pnl;
      band_dd[band]  += g_risklab_records[r].max_dd;
   }
   FileWriteString(h, StringFormat("  %-18s  %6s  %8s  %9s  %8s  %10s  %10s\n",
      "Band", "N", "Step4%", "Profit%", "Stop%", "AvgPnL", "AvgMaxDD"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      double step4_pct = (band_n[b] > 0) ? (band_step4[b] * 100.0 / band_n[b]) : 0.0;
      double prof_pct  = (band_n[b] > 0) ? (band_profit[b] * 100.0 / band_n[b]) : 0.0;
      double stop_pct  = (band_n[b] > 0) ? (band_stop[b] * 100.0 / band_n[b]) : 0.0;
      double avgp      = (band_n[b] > 0) ? (band_pnl[b] / band_n[b]) : 0.0;
      double avgdd     = (band_n[b] > 0) ? (band_dd[b]  / band_n[b]) : 0.0;
      FileWriteString(h, StringFormat("  %-18s  %6d  %7.1f%%  %8.1f%%  %7.1f%%  %10.2f  %10.2f\n",
         S2C_BandName(b), band_n[b], step4_pct, prof_pct, stop_pct, avgp, avgdd));
   }
   // --- Role validation summary ---
   double top_step4_rate  = (band_n[4] > 0) ? (band_step4[4] * 100.0 / band_n[4]) : 0.0;
   double low_step4_rate  = (band_n[0] > 0) ? (band_step4[0] * 100.0 / band_n[0]) : 0.0;
   double top_profit_rate = (band_n[4] > 0) ? (band_profit[4] * 100.0 / band_n[4]) : 0.0;
   double low_profit_rate = (band_n[0] > 0) ? (band_profit[0] * 100.0 / band_n[0]) : 0.0;
   double top_stop_rate   = (band_n[4] > 0) ? (band_stop[4] * 100.0 / band_n[4]) : 0.0;
   double low_stop_rate   = (band_n[0] > 0) ? (band_stop[0] * 100.0 / band_n[0]) : 0.0;
   double top_avg_pnl     = (band_n[4] > 0) ? (band_pnl[4] / band_n[4]) : 0.0;
   double low_avg_pnl     = (band_n[0] > 0) ? (band_pnl[0] / band_n[0]) : 0.0;
   double top_avg_dd      = (band_n[4] > 0) ? (band_dd[4] / band_n[4]) : 0.0;
   double low_avg_dd      = (band_n[0] > 0) ? (band_dd[0] / band_n[0]) : 0.0;
   FileWriteString(h, "\n[ROLE VALIDATION]\n" + sep);
   FileWriteString(h, StringFormat("  Band A Step4 Rate   : %.1f%%\n", top_step4_rate));
   FileWriteString(h, StringFormat("  Band E Step4 Rate   : %.1f%%\n", low_step4_rate));
   FileWriteString(h, StringFormat("  Band A Profit Rate  : %.1f%%\n", top_profit_rate));
   FileWriteString(h, StringFormat("  Band E Profit Rate  : %.1f%%\n", low_profit_rate));
   FileWriteString(h, StringFormat("  Band A Stop Rate    : %.1f%%\n", top_stop_rate));
   FileWriteString(h, StringFormat("  Band E Stop Rate    : %.1f%%\n", low_stop_rate));
   FileWriteString(h, StringFormat("  Band A AvgPnL       : %.2f\n", top_avg_pnl));
   FileWriteString(h, StringFormat("  Band E AvgPnL       : %.2f\n", low_avg_pnl));
   FileWriteString(h, StringFormat("  Band A AvgMaxDD     : %.2f\n", top_avg_dd));
   FileWriteString(h, StringFormat("  Band E AvgMaxDD     : %.2f\n", low_avg_dd));
   FileWriteString(h, "\n[INTERPRETATION]\n" + sep);
   FileWriteString(h, "  Conclusion: Higher score means higher probability of Step4+,\n");
   FileWriteString(h, "  but also higher path cost (more drawdown / stop risk / weaker PnL).\n");
   FileWriteString(h, "  Therefore the model should be treated as a PATH / DEPTH RISK OVERLAY.\n");
   // --- Usage guide (corrected) ---
   FileWriteString(h, "\n[PRACTICAL USAGE IN EA]\n" + sep);
   FileWriteString(h, "  1. On each new signal, compute raw score:\n");
   FileWriteString(h, "     score = S2C_ScoreStep4(g_current_snapshot)\n\n");
   FileWriteString(h, "  2. Convert to band:\n");
   FileWriteString(h, "     band = S2C_GetBand(score)\n\n");
   FileWriteString(h, "  3. Interpret as PATH RISK tier:\n");
   FileWriteString(h, "     tier = S2C_DecisionFromBand(band)\n\n");
   FileWriteString(h, "  4. Overlay policy (not standalone entry trigger):\n");
   FileWriteString(h, "     - Band A/B: require stronger confirmation, tighten risk budget\n");
   FileWriteString(h, "     - Band C  : neutral, use normal confirmation logic\n");
   FileWriteString(h, "     - Band D/E: more favorable path risk\n\n");
   FileWriteString(h, "  IMPORTANT:\n");
   FileWriteString(h, "  - Do NOT interpret score as profit probability.\n");
   FileWriteString(h, "  - Do NOT use band alone as full-position signal.\n");
   FileWriteString(h, "  - Use it as risk overlay, path complexity flag, and prioritization modifier.\n");
   FileWriteString(h, "  - Stop/DeepStop models are not yet integrated into final decision.\n");
   // --- Summary ---
   FileWriteString(h, "\n[SUMMARY]\n" + sep);
   FileWriteString(h, "  Model Role       : PATH / DEPTH RISK OVERLAY\n");
   FileWriteString(h, "  Stage 2C.1 Status: COMPLETE\n");
   FileWriteString(h, "  Next Step        : Stage 2C.2 (Decision Fusion Layer)\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2C Path Risk Policy: ", fn);
}
// ================================================================
// S2C_ExportScoreCSV
// Export all OOS scores with bands for audit
// ================================================================
void S2C_ExportScoreCSV()
{
   if(!g_s2b_compact_winner.trained) return;
   string fn = "Stage2C_PathRiskScores_" + _Symbol + ".csv";
   int hc = SafeOpenCSV(fn);
   if(hc == INVALID_HANDLE) return;
   FileWriteString(hc,
      "Setup_ID,EntryTime,Signal,Split,"
      "y_step4,y_stop,y_deepstop,"
      "Step4RawScore,PathRiskBand,PathRiskTier,OverlayAction,"
      "MaxStep,PnL,FinalEvent\r\n");
   for(int r = 0; r < g_risklab_count; r++)
   {
      SRiskLabRecord rec = g_risklab_records[r];
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      int y_step4 = rec.hit_step4_plus ? 1 : 0;
      int y_stop  = rec.stop_flag ? 1 : 0;
      int y_deep  = (rec.stop_flag && rec.max_step_reached >= 4) ? 1 : 0;
      string row = "";
      row += IntegerToString(rec.setup_id) + ",";
      row += TimeToString(rec.entry_time, TIME_DATE|TIME_MINUTES) + ",";
      row += rec.signal + ",";
      row += (rec.is_oos ? "OOS" : "DEV") + ",";
      row += IntegerToString(y_step4) + ",";
      row += IntegerToString(y_stop) + ",";
      row += IntegerToString(y_deep) + ",";
      row += DoubleToString(score, 6) + ",";
      row += S2C_BandName(band) + ",";
      row += S2C_DecisionFromBand(band) + ",";
      row += EscapeCSV(S2C_OverlayActionText(band)) + ",";
      row += IntegerToString(rec.max_step_reached) + ",";
      row += DoubleToString(rec.pnl, 2) + ",";
      row += EscapeCSV(rec.final_event);
      FileWriteString(hc, row + "\r\n");
   }
   FileFlush(hc);
   FileClose(hc);
   Print("Stage2C Path Risk Scores CSV: ", fn);
}
// ================================================================
// S2C_RunPhase1 — Score Layer
// ================================================================
void S2C_RunPhase1()
{
   Print("=== Stage 2C Phase 1 START ===");
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C: Compact winner not trained. Run Phase 6 first.");
      return;
   }
   // 1) Compute band boundaries from OOS
   S2C_ComputeBandBoundaries();
   // 2) Export path-risk policy
   S2C_ExportStep4ScorePolicy();
   // 3) Export all scores CSV
   S2C_ExportScoreCSV();
   Print("=== Stage 2C Phase 1 DONE ===");
}
//================================================================
// Stage 2C.2 — Decision Fusion Layer
// Policy-based modifier, not gate
//================================================================
// ================================================================
// SPathRiskPolicy — extensible policy object
// ================================================================
struct SPathRiskPolicy
{
   // Band info
   int    band;
   string band_name;
   string risk_tier;
   // Confirmation requirements
   int    confirmation_level;     // 0=none, 1=light, 2=moderate, 3=strong
   // Execution modifiers (suggestions, not hard rules)
   bool   require_extra_confirmation;
   bool   reduce_position_size;
   bool   tighten_risk_budget;
   bool   raise_log_level;
   // Future extension slots (for Stop/DeepStop when ready)
   bool   check_stop_model;       // placeholder — not yet active
   bool   check_deepstop_model;   // placeholder — not yet active
   // Human-readable summary
   string guidance;
   string execution_hint;
   void Reset()
   {
      band = -1;
      band_name = "";
      risk_tier = "";
      confirmation_level = 0;
      require_extra_confirmation = false;
      reduce_position_size       = false;
      tighten_risk_budget        = false;
      raise_log_level            = false;
      check_stop_model     = false;
      check_deepstop_model = false;
      guidance       = "";
      execution_hint = "";
   }
};
// ================================================================
// S2C_BuildPolicy
// Convert band index → full policy object
// ================================================================
SPathRiskPolicy S2C_BuildPolicy(int band)
{
   SPathRiskPolicy p;
   p.Reset();
   p.band      = band;
   p.band_name = S2C_BandName(band);
   p.risk_tier = S2C_DecisionFromBand(band);
   switch(band)
   {
      case 4: // A_VeryHighRisk
         p.confirmation_level = 3;
         p.require_extra_confirmation = true;
         p.reduce_position_size       = true;
         p.tighten_risk_budget        = true;
         p.raise_log_level            = true;
         p.guidance = "Very high path risk. Require strongest confirmation.";
         p.execution_hint = "Proceed only if all confirmation criteria are met. "
                            "Reduce exposure if margin or risk budget is tight.";
         break;
      case 3: // B_HighRisk
         p.confirmation_level = 2;
         p.require_extra_confirmation = true;
         p.reduce_position_size       = false;
         p.tighten_risk_budget        = true;
         p.raise_log_level            = true;
         p.guidance = "High path risk. Require stronger-than-normal confirmation.";
         p.execution_hint = "Entry allowed with confirmation. Monitor drawdown closely.";
         break;
      case 2: // C_ModerateRisk
         p.confirmation_level = 1;
         p.require_extra_confirmation = false;
         p.reduce_position_size       = false;
         p.tighten_risk_budget        = false;
         p.raise_log_level            = false;
         p.guidance = "Neutral path risk. Use normal confirmation rules.";
         p.execution_hint = "Standard entry. Apply normal position management.";
         break;
      case 1: // D_LowRisk
         p.confirmation_level = 0;
         p.require_extra_confirmation = false;
         p.reduce_position_size       = false;
         p.tighten_risk_budget        = false;
         p.raise_log_level            = false;
         p.guidance = "Favorable path risk. Lower expected path complexity.";
         p.execution_hint = "Entry favorable. Standard or slightly relaxed risk rules.";
         break;
      case 0: // E_MinimalRisk
         p.confirmation_level = 0;
         p.require_extra_confirmation = false;
         p.reduce_position_size       = false;
         p.tighten_risk_budget        = false;
         p.raise_log_level            = false;
         p.guidance = "Minimal path risk. Simplest expected path.";
         p.execution_hint = "Most favorable tier. Normal entry with no extra constraints.";
         break;
      default:
         p.confirmation_level = 1;
         p.guidance = "Unknown band. Use normal rules.";
         p.execution_hint = "Apply standard entry logic.";
         break;
   }
   return p;
}
// ================================================================
// S2C_FusionDecision
// Combine signal state + path risk policy → execution decision
// ================================================================
string S2C_FusionDecision(bool signal_valid,
                          SPathRiskPolicy &policy,
                          bool has_extra_confirmation)
{
   if(!signal_valid)
      return "NO_SIGNAL";
   // Modifier logic — not a gate
   if(policy.require_extra_confirmation && !has_extra_confirmation)
      return "NEEDS_CONFIRMATION";
   if(policy.tighten_risk_budget)
      return "ENTER_WITH_CAUTION";
   return "ENTER_NORMAL";
}
// ================================================================
// S2C_ApplyOverlay
// Main integration point for FireSignal()
// Returns policy + fusion decision
// Call AFTER signal is confirmed, BEFORE execution
// ================================================================
SPathRiskPolicy S2C_ApplyOverlay(SEntrySnapshot &sn,
                                 bool has_extra_confirmation,
                                 string &out_decision)
{
   double score = S2C_ScoreStep4(sn);
   int band = S2C_GetBand(score);
   SPathRiskPolicy policy = S2C_BuildPolicy(band);
   out_decision = S2C_FusionDecision(true, policy, has_extra_confirmation);
   if(policy.raise_log_level)
   {
      Print("S2C Overlay | Band=", policy.band_name,
            " | Risk=", policy.risk_tier,
            " | Score=", DoubleToString(score, 4),
            " | Decision=", out_decision);
   }
   return policy;
}
// ================================================================
// S2C_ExportFusionPolicyReport
// Show what each band maps to in the fusion layer
// ================================================================
void S2C_ExportFusionPolicyReport()
{
   if(!g_s2b_compact_winner.trained) return;
   Print("=== Fusion Policy Report START ===");
   string fn = "Stage2C_FusionPolicy_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create Fusion Policy report.");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2C.2 — FUSION POLICY LAYER\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   // Design principles
   FileWriteString(h, "\n[DESIGN PRINCIPLES]\n" + sep);
   FileWriteString(h, "  1. Path Risk Score = MODIFIER, not gate.\n");
   FileWriteString(h, "  2. Band A does NOT automatically reject a signal.\n");
   FileWriteString(h, "  3. Band E does NOT automatically approve a signal.\n");
   FileWriteString(h, "  4. The overlay adjusts confirmation requirements and risk posture.\n");
   FileWriteString(h, "  5. Stop/DeepStop models are NOT yet active — reserved for future.\n");
   // Decision flow
   FileWriteString(h, "\n[DECISION FLOW]\n" + sep);
   FileWriteString(h, "  Signal Engine\n");
   FileWriteString(h, "       |\n");
   FileWriteString(h, "       v\n");
   FileWriteString(h, "  Signal Candidate\n");
   FileWriteString(h, "       |\n");
   FileWriteString(h, "       v\n");
   FileWriteString(h, "  Path Risk Overlay  ← S2C_ApplyOverlay()\n");
   FileWriteString(h, "       |\n");
   FileWriteString(h, "       v\n");
   FileWriteString(h, "  Execution Policy\n");
   FileWriteString(h, "       |\n");
   FileWriteString(h, "       v\n");
   FileWriteString(h, "  ENTER_NORMAL / ENTER_WITH_CAUTION / NEEDS_CONFIRMATION\n");
   // Policy table
   FileWriteString(h, "\n[POLICY TABLE]\n" + sep);
   FileWriteString(h, StringFormat("  %-18s  %5s  %6s  %6s  %8s  %5s  %s\n",
      "Band", "ConfLv", "ExtCon", "RedSz", "TightRB", "LogLv", "Execution Hint"));
   FileWriteString(h, sep);
   for(int b = 4; b >= 0; b--)
   {
      SPathRiskPolicy p = S2C_BuildPolicy(b);
      FileWriteString(h, StringFormat("  %-18s  %5d  %6s  %6s  %8s  %5s  %s\n",
         p.band_name,
         p.confirmation_level,
         p.require_extra_confirmation ? "YES" : "NO",
         p.reduce_position_size ? "YES" : "NO",
         p.tighten_risk_budget ? "YES" : "NO",
         p.raise_log_level ? "YES" : "NO",
         p.execution_hint));
   }
   // Band performance summary (OOS)
   FileWriteString(h, "\n[BAND PERFORMANCE SUMMARY — OOS]\n" + sep);
   FileWriteString(h, "  (Showing which execution tier would have applied per band)\n\n");
   int    band_n[5], band_profit[5], band_stop[5], band_step4[5];
   double band_pnl[5], band_dd[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_profit, 0);
   ArrayInitialize(band_stop, 0);
   ArrayInitialize(band_step4, 0);
   ArrayInitialize(band_pnl, 0.0);
   ArrayInitialize(band_dd, 0.0);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      double sc = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(sc);
      band_n[band]++;
      if(g_risklab_records[r].pnl > 0.0) band_profit[band]++;
      if(g_risklab_records[r].stop_flag) band_stop[band]++;
      if(g_risklab_records[r].hit_step4_plus) band_step4[band]++;
      band_pnl[band] += g_risklab_records[r].pnl;
      band_dd[band]  += g_risklab_records[r].max_dd;
   }
   FileWriteString(h, StringFormat("  %-18s  %5s  %8s  %8s  %8s  %10s  %10s\n",
      "Band", "N", "Profit%", "Stop%", "Step4%", "AvgPnL", "AvgMaxDD"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      double prof_pct  = (band_n[b] > 0) ? (band_profit[b] * 100.0 / band_n[b]) : 0.0;
      double stop_pct  = (band_n[b] > 0) ? (band_stop[b]   * 100.0 / band_n[b]) : 0.0;
      double step4_pct = (band_n[b] > 0) ? (band_step4[b]  * 100.0 / band_n[b]) : 0.0;
      double avgp = (band_n[b] > 0) ? (band_pnl[b] / band_n[b]) : 0.0;
      double avgd = (band_n[b] > 0) ? (band_dd[b]  / band_n[b]) : 0.0;
      SPathRiskPolicy p = S2C_BuildPolicy(b);
      FileWriteString(h, StringFormat("  %-18s  %5d  %7.1f%%  %7.1f%%  %7.1f%%  %10.2f  %10.2f\n",
         S2C_BandName(b), band_n[b], prof_pct, stop_pct, step4_pct, avgp, avgd));
   }
   // Expected behavior under policy
   FileWriteString(h, "\n[EXPECTED EFFECT OF OVERLAY]\n" + sep);
   int oos_total = 0;
   int normal_cnt = 0, caution_cnt = 0, needs_conf_cnt = 0;
   double normal_pnl = 0.0, caution_pnl = 0.0, needs_conf_pnl = 0.0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      double sc = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(sc);
      SPathRiskPolicy p = S2C_BuildPolicy(band);
      string decision = S2C_FusionDecision(true, p, false);
      oos_total++;
      if(decision == "ENTER_NORMAL")
      {
         normal_cnt++;
         normal_pnl += g_risklab_records[r].pnl;
      }
      else if(decision == "ENTER_WITH_CAUTION")
      {
         caution_cnt++;
         caution_pnl += g_risklab_records[r].pnl;
      }
      else if(decision == "NEEDS_CONFIRMATION")
      {
         needs_conf_cnt++;
         needs_conf_pnl += g_risklab_records[r].pnl;
      }
   }
   FileWriteString(h, "  (Assuming has_extra_confirmation = false for all)\n\n");
   FileWriteString(h, StringFormat("  %-22s  %6s  %10s  %12s\n",
      "Fusion Decision", "N", "TotalPnL", "AvgPnL"));
   FileWriteString(h, sep);
   FileWriteString(h, StringFormat("  %-22s  %6d  %10.2f  %12.2f\n",
      "ENTER_NORMAL",
      normal_cnt, normal_pnl,
      (normal_cnt > 0 ? normal_pnl / normal_cnt : 0.0)));
   FileWriteString(h, StringFormat("  %-22s  %6d  %10.2f  %12.2f\n",
      "ENTER_WITH_CAUTION",
      caution_cnt, caution_pnl,
      (caution_cnt > 0 ? caution_pnl / caution_cnt : 0.0)));
   FileWriteString(h, StringFormat("  %-22s  %6d  %10.2f  %12.2f\n",
      "NEEDS_CONFIRMATION",
      needs_conf_cnt, needs_conf_pnl,
      (needs_conf_cnt > 0 ? needs_conf_pnl / needs_conf_cnt : 0.0)));
   // Extension notes
   FileWriteString(h, "\n[EXTENSION NOTES — Future Stop/DeepStop Integration]\n" + sep);
   FileWriteString(h, "  When Stop/DeepStop models are ready:\n");
   FileWriteString(h, "  1. Set policy.check_stop_model = true for bands A/B.\n");
   FileWriteString(h, "  2. Run Stop/DeepStop scorer.\n");
   FileWriteString(h, "  3. Combine scores in S2C_FusionDecision().\n");
   FileWriteString(h, "  No changes to Signal Engine or EA core logic required.\n");
   // Final summary
   FileWriteString(h, "\n[SUMMARY]\n" + sep);
   FileWriteString(h, StringFormat("  OOS total: %d\n", oos_total));
   FileWriteString(h, StringFormat("  ENTER_NORMAL:         %d (%.0f%%)\n",
      normal_cnt, (oos_total > 0 ? normal_cnt * 100.0 / oos_total : 0)));
   FileWriteString(h, StringFormat("  ENTER_WITH_CAUTION:   %d (%.0f%%)\n",
      caution_cnt, (oos_total > 0 ? caution_cnt * 100.0 / oos_total : 0)));
   FileWriteString(h, StringFormat("  NEEDS_CONFIRMATION:   %d (%.0f%%)\n",
      needs_conf_cnt, (oos_total > 0 ? needs_conf_cnt * 100.0 / oos_total : 0)));
   FileWriteString(h, "\n  Stage 2C.2 Status: COMPLETE\n");
   FileWriteString(h, "  Next: EA integration (S2C_ApplyOverlay in FireSignal)\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2C Fusion Policy: ", fn);
   Print("=== Fusion Policy Report DONE ===");
}
// ================================================================
// S2C_RunPhase2 — Decision Fusion Layer
// ================================================================
void S2C_RunPhase2()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C_RunPhase2: Compact winner not trained.");
      return;
   }
   Print("=== Stage 2C Phase 2 START ===");
   S2C_ExportFusionPolicyReport();
   Print("=== Stage 2C Phase 2 DONE ===");
}
//================================================================
// Stage 2C.2b — Policy Sensitivity Report
// Purpose: validate policy mappings, not activate them
//================================================================
#define S2C_STATE_NORMAL   0
#define S2C_STATE_CAUTION  1
#define S2C_STATE_CONFIRM  2
string S2C_StateName(int st)
{
   if(st == S2C_STATE_NORMAL)  return "ENTER_NORMAL";
   if(st == S2C_STATE_CAUTION) return "ENTER_WITH_CAUTION";
   if(st == S2C_STATE_CONFIRM) return "NEEDS_CONFIRMATION";
   return "UNKNOWN";
}
string S2C_PolicyName(int pid)
{
   if(pid == 1) return "P1_BASELINE_AB_CONFIRM";
   if(pid == 2) return "P2_A_CONFIRM_B_CAUTION";
   if(pid == 3) return "P3_ONLY_A_CONFIRM";
   return "UNKNOWN_POLICY";
}
string S2C_PolicyComment(int pid)
{
   if(pid == 1) return "Baseline: A,B -> CONFIRM ; C,D,E -> NORMAL";
   if(pid == 2) return "Separates B: A -> CONFIRM ; B -> CAUTION ; C,D,E -> NORMAL";
   if(pid == 3) return "Only A filtered: A -> CONFIRM ; B,C,D,E -> NORMAL";
   return "";
}
int S2C_MapBandToState(int policy_id, int band)
{
   // band: 0=E,1=D,2=C,3=B,4=A
   if(policy_id == 1)
   {
      // P1: A/B => CONFIRM
      if(band >= 3) return S2C_STATE_CONFIRM;
      return S2C_STATE_NORMAL;
   }
   if(policy_id == 2)
   {
      // P2: A => CONFIRM, B => CAUTION
      if(band == 4) return S2C_STATE_CONFIRM;
      if(band == 3) return S2C_STATE_CAUTION;
      return S2C_STATE_NORMAL;
   }
   if(policy_id == 3)
   {
      // P3: only A => CONFIRM
      if(band == 4) return S2C_STATE_CONFIRM;
      return S2C_STATE_NORMAL;
   }
   return S2C_STATE_NORMAL;
}
//---------------------------------------------------------------
// State stats
//---------------------------------------------------------------
struct S2CPolicyStateStats
{
   int    n;
   int    profit_cnt;
   int    stop_cnt;
   int    step4_cnt;
   int    deepstop_cnt;
   double pnl_sum;
   double dd_sum;
   double pnl_vals[];
   double dd_vals[];
   double avg_pnl;
   double med_pnl;
   double q25_pnl;
   double q75_pnl;
   double avg_dd;
   double med_dd;
   void Reset()
   {
      n = 0;
      profit_cnt = 0;
      stop_cnt = 0;
      step4_cnt = 0;
      deepstop_cnt = 0;
      pnl_sum = 0.0;
      dd_sum = 0.0;
      ArrayResize(pnl_vals, 0);
      ArrayResize(dd_vals, 0);
      avg_pnl = med_pnl = q25_pnl = q75_pnl = 0.0;
      avg_dd = med_dd = 0.0;
   }
   void Add(double pnl, double dd, bool is_profit, bool is_stop, bool is_step4, bool is_deepstop)
   {
      int np = ArraySize(pnl_vals);
      ArrayResize(pnl_vals, np + 1);
      pnl_vals[np] = pnl;
      int nd = ArraySize(dd_vals);
      ArrayResize(dd_vals, nd + 1);
      dd_vals[nd] = dd;
      n++;
      pnl_sum += pnl;
      dd_sum  += dd;
      if(is_profit)   profit_cnt++;
      if(is_stop)     stop_cnt++;
      if(is_step4)    step4_cnt++;
      if(is_deepstop) deepstop_cnt++;
   }
   void Finalize()
   {
      if(n <= 0) return;
      avg_pnl = pnl_sum / n;
      avg_dd  = dd_sum  / n;
      double mean=0, med=0, q25=0, q75=0, minv=0, maxv=0;
      S2B7_Summarize(pnl_vals, n, mean, med, q25, q75, minv, maxv);
      med_pnl = med;
      q25_pnl = q25;
      q75_pnl = q75;
      S2B7_Summarize(dd_vals, n, mean, med, q25, q75, minv, maxv);
      med_dd = med;
   }
   double ProfitRate() { return (n > 0 ? profit_cnt * 100.0 / n : 0.0); }
   double StopRate()   { return (n > 0 ? stop_cnt   * 100.0 / n : 0.0); }
   double Step4Rate()  { return (n > 0 ? step4_cnt  * 100.0 / n : 0.0); }
   double DeepRate()   { return (n > 0 ? deepstop_cnt * 100.0 / n : 0.0); }
};
//---------------------------------------------------------------
// Helpers for merged tradable subset (NORMAL + CAUTION)
//---------------------------------------------------------------
void S2C_BuildTradableSummary(S2CPolicyStateStats &normal_state,
                              S2CPolicyStateStats &caution_state,
                              double &avg_pnl, double &med_pnl,
                              double &profit_rate, double &stop_rate,
                              double &step4_rate, double &avg_dd,
                              int &n_total)
{
   n_total = normal_state.n + caution_state.n;
   avg_pnl = med_pnl = profit_rate = stop_rate = step4_rate = avg_dd = 0.0;
   if(n_total <= 0) return;
   avg_pnl = (normal_state.pnl_sum + caution_state.pnl_sum) / n_total;
   avg_dd  = (normal_state.dd_sum  + caution_state.dd_sum)  / n_total;
   profit_rate = (normal_state.profit_cnt + caution_state.profit_cnt) * 100.0 / n_total;
   stop_rate   = (normal_state.stop_cnt   + caution_state.stop_cnt)   * 100.0 / n_total;
   step4_rate  = (normal_state.step4_cnt  + caution_state.step4_cnt)  * 100.0 / n_total;
   double all_pnl[];
   ArrayResize(all_pnl, n_total);
   int idx = 0;
   for(int i = 0; i < ArraySize(normal_state.pnl_vals); i++) all_pnl[idx++] = normal_state.pnl_vals[i];
   for(int i = 0; i < ArraySize(caution_state.pnl_vals); i++) all_pnl[idx++] = caution_state.pnl_vals[i];
   med_pnl = S2B7_Quantile(all_pnl, n_total, 0.50);
   ArrayFree(all_pnl);
}
//---------------------------------------------------------------
// Main export
//---------------------------------------------------------------
void S2C_ExportPolicySensitivityReport()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C_ExportPolicySensitivityReport: Compact winner not trained.");
      return;
   }
   Print("=== Stage 2C.2b Policy Sensitivity START ===");
   // make sure boundaries are current
   S2C_ComputeBandBoundaries();
   // NOTE:
   // In MQL5, local multidimensional arrays need literal dimensions.
   // So we use [3][3] directly instead of [N_POL][N_ST].
   S2CPolicyStateStats pol_states[3][3];
   for(int p = 0; p < 3; p++)
      for(int s = 0; s < 3; s++)
         pol_states[p][s].Reset();
   // Transition matrices relative to P1
   int trans_p2[3][3];
   int trans_p3[3][3];
   ArrayInitialize(trans_p2, 0);
   ArrayInitialize(trans_p3, 0);
   // OOS baseline totals
   int oos_total = 0;
   int oos_profit = 0;
   int oos_stop = 0;
   int oos_step4 = 0;
   double oos_pnl_sum = 0.0;
   double oos_dd_sum  = 0.0;
   // score coverage
   int scoreable_oos = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      oos_total++;
      // Can score?
      double dummy_fvec[], dummy_norm[];
      ArrayResize(dummy_fvec, g_s2b_compact_winner.n_features);
      ArrayResize(dummy_norm, g_s2b_compact_winner.n_features);
      bool scoreable = S2B_BuildFeatureVector(r, g_s2b_compact_winner, dummy_fvec);
      ArrayFree(dummy_fvec);
      ArrayFree(dummy_norm);
      if(!scoreable) continue;
      scoreable_oos++;
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      bool is_profit   = (g_risklab_records[r].pnl > 0.0);
      bool is_stop     = g_risklab_records[r].stop_flag;
      bool is_step4    = g_risklab_records[r].hit_step4_plus;
      bool is_deepstop = (g_risklab_records[r].stop_flag && g_risklab_records[r].max_step_reached >= 4);
      double pnl = g_risklab_records[r].pnl;
      double dd  = g_risklab_records[r].max_dd;
      if(is_profit) oos_profit++;
      if(is_stop)   oos_stop++;
      if(is_step4)  oos_step4++;
      oos_pnl_sum += pnl;
      oos_dd_sum  += dd;
      int st_p1 = S2C_MapBandToState(1, band);
      int st_p2 = S2C_MapBandToState(2, band);
      int st_p3 = S2C_MapBandToState(3, band);
      pol_states[0][st_p1].Add(pnl, dd, is_profit, is_stop, is_step4, is_deepstop);
      pol_states[1][st_p2].Add(pnl, dd, is_profit, is_stop, is_step4, is_deepstop);
      pol_states[2][st_p3].Add(pnl, dd, is_profit, is_stop, is_step4, is_deepstop);
      trans_p2[st_p1][st_p2]++;
      trans_p3[st_p1][st_p3]++;
   }
   for(int p = 0; p < 3; p++)
      for(int s = 0; s < 3; s++)
         pol_states[p][s].Finalize();
   double oos_profit_rate = (scoreable_oos > 0 ? oos_profit * 100.0 / scoreable_oos : 0.0);
   double oos_stop_rate   = (scoreable_oos > 0 ? oos_stop   * 100.0 / scoreable_oos : 0.0);
   double oos_step4_rate  = (scoreable_oos > 0 ? oos_step4  * 100.0 / scoreable_oos : 0.0);
   double oos_avg_pnl     = (scoreable_oos > 0 ? oos_pnl_sum / scoreable_oos : 0.0);
   double oos_avg_dd      = (scoreable_oos > 0 ? oos_dd_sum  / scoreable_oos : 0.0);
   string fn = "Stage2C_PolicySensitivity_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create Stage2C policy sensitivity report.");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2C.2b — POLICY SENSITIVITY REPORT\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   // ------------------------------------------------------------
   // Coverage
   // ------------------------------------------------------------
   FileWriteString(h, "\n[SCORE COVERAGE]\n" + sep);
   FileWriteString(h, StringFormat("  OOS Total       : %d\n", oos_total));
   FileWriteString(h, StringFormat("  OOS Scoreable   : %d\n", scoreable_oos));
   FileWriteString(h, StringFormat("  Coverage        : %.2f%%\n",
      oos_total > 0 ? scoreable_oos * 100.0 / oos_total : 0.0));
   // ------------------------------------------------------------
   // Policy table summary
   // ------------------------------------------------------------
   FileWriteString(h, "\n[POLICY SUMMARY TABLE]\n" + sep);
   FileWriteString(h,
      "Policy | N_Normal | N_Caution | N_Confirm | Tradable_N | Coverage% | AvgPnL | MedPnL | ProfitRate | StopRate | Step4Rate | AvgMaxDD | Comment\n");
   FileWriteString(h, sep);
   for(int p = 0; p < 3; p++)
   {
      double trad_avg_pnl = 0.0, trad_med_pnl = 0.0;
      double trad_profit_rate = 0.0, trad_stop_rate = 0.0, trad_step4_rate = 0.0, trad_avg_dd = 0.0;
      int trad_n = 0;
      S2C_BuildTradableSummary(
         pol_states[p][S2C_STATE_NORMAL],
         pol_states[p][S2C_STATE_CAUTION],
         trad_avg_pnl, trad_med_pnl,
         trad_profit_rate, trad_stop_rate,
         trad_step4_rate, trad_avg_dd,
         trad_n);
      double cov = (scoreable_oos > 0 ? trad_n * 100.0 / scoreable_oos : 0.0);
      string comment = S2C_PolicyComment(p + 1);
      FileWriteString(h,
         S2C_PolicyName(p + 1) + " | " +
         IntegerToString(pol_states[p][S2C_STATE_NORMAL].n) + " | " +
         IntegerToString(pol_states[p][S2C_STATE_CAUTION].n) + " | " +
         IntegerToString(pol_states[p][S2C_STATE_CONFIRM].n) + " | " +
         IntegerToString(trad_n) + " | " +
         DoubleToString(cov, 1) + "% | " +
         DoubleToString(trad_avg_pnl, 2) + " | " +
         DoubleToString(trad_med_pnl, 2) + " | " +
         DoubleToString(trad_profit_rate, 1) + "% | " +
         DoubleToString(trad_stop_rate, 1) + "% | " +
         DoubleToString(trad_step4_rate, 1) + "% | " +
         DoubleToString(trad_avg_dd, 2) + " | " +
         comment + "\n");
   }
   // ------------------------------------------------------------
   // State detail per policy
   // ------------------------------------------------------------
   for(int p = 0; p < 3; p++)
   {
      FileWriteString(h, "\n[" + S2C_PolicyName(p + 1) + " — STATE DETAILS]\n" + sep);
      FileWriteString(h,
         "State | N | AvgPnL | MedPnL | Q25 | Q75 | ProfitRate | StopRate | Step4Rate | DeepStopRate | AvgMaxDD | MedMaxDD\n");
      FileWriteString(h, sep);
      for(int s = 0; s < 3; s++)
      {
         FileWriteString(h,
            S2C_StateName(s) + " | " +
            IntegerToString(pol_states[p][s].n) + " | " +
            DoubleToString(pol_states[p][s].avg_pnl, 2) + " | " +
            DoubleToString(pol_states[p][s].med_pnl, 2) + " | " +
            DoubleToString(pol_states[p][s].q25_pnl, 2) + " | " +
            DoubleToString(pol_states[p][s].q75_pnl, 2) + " | " +
            DoubleToString(pol_states[p][s].ProfitRate(), 1) + "% | " +
            DoubleToString(pol_states[p][s].StopRate(), 1) + "% | " +
            DoubleToString(pol_states[p][s].Step4Rate(), 1) + "% | " +
            DoubleToString(pol_states[p][s].DeepRate(), 1) + "% | " +
            DoubleToString(pol_states[p][s].avg_dd, 2) + " | " +
            DoubleToString(pol_states[p][s].med_dd, 2) + "\n");
      }
   }
   // ------------------------------------------------------------
   // Transition counts relative to P1
   // ------------------------------------------------------------
   FileWriteString(h, "\n[TRANSITION COUNTS RELATIVE TO P1]\n" + sep);
   FileWriteString(h, "P2 transitions (rows=P1, cols=P2)\n");
   FileWriteString(h, "                | NORMAL | CAUTION | CONFIRM\n");
   FileWriteString(h, sep);
   for(int s1 = 0; s1 < 3; s1++)
   {
      FileWriteString(h,
         S2C_StateName(s1) + " | " +
         IntegerToString(trans_p2[s1][0]) + " | " +
         IntegerToString(trans_p2[s1][1]) + " | " +
         IntegerToString(trans_p2[s1][2]) + "\n");
   }
   FileWriteString(h, "\nP3 transitions (rows=P1, cols=P3)\n");
   FileWriteString(h, "                | NORMAL | CAUTION | CONFIRM\n");
   FileWriteString(h, sep);
   for(int s1 = 0; s1 < 3; s1++)
   {
      FileWriteString(h,
         S2C_StateName(s1) + " | " +
         IntegerToString(trans_p3[s1][0]) + " | " +
         IntegerToString(trans_p3[s1][1]) + " | " +
         IntegerToString(trans_p3[s1][2]) + "\n");
   }
   // ------------------------------------------------------------
   // Policy efficiency
   // ------------------------------------------------------------
   FileWriteString(h, "\n[POLICY EFFICIENCY]\n" + sep);
   FileWriteString(h,
      "Policy | Tradable_N | HardRestricted_N | OverlayFlagged_N | StopReduction | AvgDDReduction | PnLChange | ProfitRateChange | Step4RateChange\n");
   FileWriteString(h, sep);
   for(int p = 0; p < 3; p++)
   {
      int n_normal  = pol_states[p][S2C_STATE_NORMAL].n;
      int n_caution = pol_states[p][S2C_STATE_CAUTION].n;
      int n_confirm = pol_states[p][S2C_STATE_CONFIRM].n;
      int trad_n = n_normal + n_caution;
      int hard_restricted = n_confirm;
      int flagged_n = n_caution + n_confirm;
      double trad_avg_pnl = 0.0, trad_med_pnl = 0.0;
      double trad_profit_rate = 0.0, trad_stop_rate = 0.0, trad_step4_rate = 0.0, trad_avg_dd = 0.0;
      int dummy_n = 0;
      S2C_BuildTradableSummary(
         pol_states[p][S2C_STATE_NORMAL],
         pol_states[p][S2C_STATE_CAUTION],
         trad_avg_pnl, trad_med_pnl,
         trad_profit_rate, trad_stop_rate,
         trad_step4_rate, trad_avg_dd,
         dummy_n);
      double stop_red = oos_stop_rate - trad_stop_rate;
      double dd_red   = oos_avg_dd    - trad_avg_dd;
      double pnl_chg  = trad_avg_pnl  - oos_avg_pnl;
      double prof_chg = trad_profit_rate - oos_profit_rate;
      double step_chg = trad_step4_rate  - oos_step4_rate;
      FileWriteString(h,
         S2C_PolicyName(p + 1) + " | " +
         IntegerToString(trad_n) + " | " +
         IntegerToString(hard_restricted) + " | " +
         IntegerToString(flagged_n) + " | " +
         DoubleToString(stop_red, 2) + " | " +
         DoubleToString(dd_red, 2) + " | " +
         DoubleToString(pnl_chg, 2) + " | " +
         DoubleToString(prof_chg, 2) + " | " +
         DoubleToString(step_chg, 2) + "\n");
   }
   // ------------------------------------------------------------
   // Recommendation
   // ------------------------------------------------------------
   FileWriteString(h, "\n[RECOMMENDATION]\n" + sep);
   bool p2_has_caution = (pol_states[1][S2C_STATE_CAUTION].n > 0);
   bool p2_intermediate_step4 = false;
   bool p2_intermediate_stop  = false;
   bool p2_intermediate_dd    = false;
   if(p2_has_caution)
   {
      double n_step = pol_states[1][S2C_STATE_NORMAL].Step4Rate();
      double c_step = pol_states[1][S2C_STATE_CAUTION].Step4Rate();
      double f_step = pol_states[1][S2C_STATE_CONFIRM].Step4Rate();
      double n_stop = pol_states[1][S2C_STATE_NORMAL].StopRate();
      double c_stop = pol_states[1][S2C_STATE_CAUTION].StopRate();
      double f_stop = pol_states[1][S2C_STATE_CONFIRM].StopRate();
      double n_dd = pol_states[1][S2C_STATE_NORMAL].avg_dd;
      double c_dd = pol_states[1][S2C_STATE_CAUTION].avg_dd;
      double f_dd = pol_states[1][S2C_STATE_CONFIRM].avg_dd;
      p2_intermediate_step4 = ((c_step >= n_step && c_step <= f_step) || (c_step <= n_step && c_step >= f_step));
      p2_intermediate_stop  = ((c_stop >= n_stop && c_stop <= f_stop) || (c_stop <= n_stop && c_stop >= f_stop));
      p2_intermediate_dd    = ((c_dd >= n_dd && c_dd <= f_dd) || (c_dd <= n_dd && c_dd >= f_dd));
   }
   FileWriteString(h, "Policy sensitivity interpretation:\n");
   FileWriteString(h, "  - P1 = Baseline overlay\n");
   FileWriteString(h, "  - P2 = Tests whether Band B deserves its own audit state\n");
   FileWriteString(h, "  - P3 = Tests whether only Band A should remain restricted\n\n");
   if(p2_has_caution && p2_intermediate_step4 && p2_intermediate_stop && p2_intermediate_dd)
   {
      FileWriteString(h, "Recommendation: POLICY_2_IS_INFORMATIVE\n");
      FileWriteString(h, "Reason: Band B forms a meaningful intermediate risk tier.\n");
      FileWriteString(h, "Action: Keep Band B as ENTER_WITH_CAUTION in audit mode.\n");
   }
   else
   {
      FileWriteString(h, "Recommendation: KEEP_POLICY_1_FOR_NOW\n");
      FileWriteString(h, "Reason: Band B is not yet clearly separable from Band A or normal states.\n");
      FileWriteString(h, "Action: Do not activate ENTER_WITH_CAUTION as execution modifier yet.\n");
   }
   FileWriteString(h, "\nIMPORTANT:\n");
   FileWriteString(h, "  Stage 2C.2b is a sensitivity validation layer.\n");
   FileWriteString(h, "  It does NOT activate caution logic in the EA yet.\n");
   FileWriteString(h, "  ENTER_WITH_CAUTION should remain audit-only until validated on future data.\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2C Policy Sensitivity Report: ", fn,
         " | Coverage=", DoubleToString(oos_total > 0 ? scoreable_oos * 100.0 / oos_total : 0.0, 1), "%");
   Print("=== Stage 2C.2b Policy Sensitivity DONE ===");
}
//---------------------------------------------------------------
// Run Phase 2b
//---------------------------------------------------------------
void S2C_RunPhase2b()
{
   Print("=== Stage 2C Phase 2b START ===");
   S2C_ExportPolicySensitivityReport();
   Print("=== Stage 2C Phase 2b DONE ===");
}
//================================================================
// Stage 2C.3 — Passive Integration / Shadow Mode
// ExecutionPolicyCandidate = Policy 1
// AuditPolicy             = Policy 2
// No execution effect yet
//================================================================
// ================================================================
// Policy mappings
// ================================================================
int S2C_GetExecutionStateP1(int band)
{
   // Policy 1:
   // A,B -> NEEDS_CONFIRMATION
   // C,D,E -> ENTER_NORMAL
   if(band >= 3) return S2C_STATE_CONFIRM; // A/B
   return S2C_STATE_NORMAL;                // C/D/E
}
int S2C_GetAuditStateP2(int band)
{
   // Policy 2:
   // A -> NEEDS_CONFIRMATION
   // B -> ENTER_WITH_CAUTION
   // C,D,E -> ENTER_NORMAL
   if(band == 4) return S2C_STATE_CONFIRM; // A
   if(band == 3) return S2C_STATE_CAUTION; // B
   return S2C_STATE_NORMAL;                // C/D/E
}
string S2C_GetExecutionPolicyP1(int band)
{
   return S2C_StateName(S2C_GetExecutionStateP1(band));
}
string S2C_GetAuditPolicyP2(int band)
{
   return S2C_StateName(S2C_GetAuditStateP2(band));
}
// ================================================================
// S2C_ExportPassiveIntegrationReport
// Candidate execution policy (P1) + audit policy (P2)
// No activation yet
// ================================================================
void S2C_ExportPassiveIntegrationReport()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C_ExportPassiveIntegrationReport: Compact winner not trained.");
      return;
   }
   Print("=== Stage 2C.3 Passive Integration Report START ===");
   // ensure boundaries are current
   S2C_ComputeBandBoundaries();
   // P1 execution states: NORMAL / CONFIRM
   S2CPolicyStateStats exec_states[3];
   // P2 audit states: NORMAL / CAUTION / CONFIRM
   S2CPolicyStateStats audit_states[3];
   for(int s = 0; s < 3; s++)
   {
      exec_states[s].Reset();
      audit_states[s].Reset();
   }
   int oos_total = 0;
   int scoreable_oos = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      oos_total++;
      double dummy_fvec[], dummy_norm[];
      ArrayResize(dummy_fvec, g_s2b_compact_winner.n_features);
      ArrayResize(dummy_norm, g_s2b_compact_winner.n_features);
      bool scoreable = S2B_BuildFeatureVector(r, g_s2b_compact_winner, dummy_fvec);
      ArrayFree(dummy_fvec);
      ArrayFree(dummy_norm);
      if(!scoreable) continue;
      scoreable_oos++;
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      int exec_state  = S2C_GetExecutionStateP1(band);
      int audit_state = S2C_GetAuditStateP2(band);
      bool is_profit   = (g_risklab_records[r].pnl > 0.0);
      bool is_stop     = g_risklab_records[r].stop_flag;
      bool is_step4    = g_risklab_records[r].hit_step4_plus;
      bool is_deepstop = (g_risklab_records[r].stop_flag && g_risklab_records[r].max_step_reached >= 4);
      double pnl = g_risklab_records[r].pnl;
      double dd  = g_risklab_records[r].max_dd;
      exec_states[exec_state].Add(pnl, dd, is_profit, is_stop, is_step4, is_deepstop);
      audit_states[audit_state].Add(pnl, dd, is_profit, is_stop, is_step4, is_deepstop);
   }
   for(int s = 0; s < 3; s++)
   {
      exec_states[s].Finalize();
      audit_states[s].Finalize();
   }
   string fn = "Stage2C_PassiveIntegration_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create passive integration report.");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2C.3 — PASSIVE INTEGRATION / SHADOW MODE\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[MODE]\n" + sep);
   FileWriteString(h, "  ExecutionPolicyCandidate = Policy 1\n");
   FileWriteString(h, "  AuditPolicy              = Policy 2\n");
   FileWriteString(h, "  Execution effect         = NONE (passive only)\n");
   FileWriteString(h, "  Purpose                  = Collect forward evidence before activation\n");
   FileWriteString(h, "\n[SCORE COVERAGE]\n" + sep);
   FileWriteString(h, StringFormat("  OOS Total       : %d\n", oos_total));
   FileWriteString(h, StringFormat("  OOS Scoreable   : %d\n", scoreable_oos));
   FileWriteString(h, StringFormat("  Coverage        : %.2f%%\n",
      oos_total > 0 ? scoreable_oos * 100.0 / oos_total : 0.0));
   // ------------------------------------------------------------
   // Candidate execution policy (P1)
   // ------------------------------------------------------------
   FileWriteString(h, "\n[EXECUTION POLICY CANDIDATE — Policy 1]\n" + sep);
   FileWriteString(h, "  Mapping: A,B -> NEEDS_CONFIRMATION ; C,D,E -> ENTER_NORMAL\n\n");
   FileWriteString(h,
      "State | N | AvgPnL | MedPnL | Q25 | Q75 | ProfitRate | StopRate | Step4Rate | DeepStopRate | AvgMaxDD | MedMaxDD\n");
   FileWriteString(h, sep);
   for(int s = 0; s < 3; s++)
   {
      FileWriteString(h,
         S2C_StateName(s) + " | " +
         IntegerToString(exec_states[s].n) + " | " +
         DoubleToString(exec_states[s].avg_pnl, 2) + " | " +
         DoubleToString(exec_states[s].med_pnl, 2) + " | " +
         DoubleToString(exec_states[s].q25_pnl, 2) + " | " +
         DoubleToString(exec_states[s].q75_pnl, 2) + " | " +
         DoubleToString(exec_states[s].ProfitRate(), 1) + "% | " +
         DoubleToString(exec_states[s].StopRate(), 1) + "% | " +
         DoubleToString(exec_states[s].Step4Rate(), 1) + "% | " +
         DoubleToString(exec_states[s].DeepRate(), 1) + "% | " +
         DoubleToString(exec_states[s].avg_dd, 2) + " | " +
         DoubleToString(exec_states[s].med_dd, 2) + "\n");
   }
   // ------------------------------------------------------------
   // Audit policy (P2)
   // ------------------------------------------------------------
   FileWriteString(h, "\n[AUDIT POLICY — Policy 2]\n" + sep);
   FileWriteString(h, "  Mapping: A -> NEEDS_CONFIRMATION ; B -> ENTER_WITH_CAUTION ; C,D,E -> ENTER_NORMAL\n\n");
   FileWriteString(h,
      "State | N | AvgPnL | MedPnL | Q25 | Q75 | ProfitRate | StopRate | Step4Rate | DeepStopRate | AvgMaxDD | MedMaxDD\n");
   FileWriteString(h, sep);
   for(int s = 0; s < 3; s++)
   {
      FileWriteString(h,
         S2C_StateName(s) + " | " +
         IntegerToString(audit_states[s].n) + " | " +
         DoubleToString(audit_states[s].avg_pnl, 2) + " | " +
         DoubleToString(audit_states[s].med_pnl, 2) + " | " +
         DoubleToString(audit_states[s].q25_pnl, 2) + " | " +
         DoubleToString(audit_states[s].q75_pnl, 2) + " | " +
         DoubleToString(audit_states[s].ProfitRate(), 1) + "% | " +
         DoubleToString(audit_states[s].StopRate(), 1) + "% | " +
         DoubleToString(audit_states[s].Step4Rate(), 1) + "% | " +
         DoubleToString(audit_states[s].DeepRate(), 1) + "% | " +
         DoubleToString(audit_states[s].avg_dd, 2) + " | " +
         DoubleToString(audit_states[s].med_dd, 2) + "\n");
   }
   // ------------------------------------------------------------
   // Practical interpretation
   // ------------------------------------------------------------
   FileWriteString(h, "\n[INTERPRETATION]\n" + sep);
   FileWriteString(h, "  Execution candidate remains Policy 1 because it preserves the highest tradable quality.\n");
   FileWriteString(h, "  Audit policy keeps Band B separate as an intermediate path-risk state.\n");
   FileWriteString(h, "  ENTER_WITH_CAUTION is currently ANALYTICAL ONLY and must not affect execution.\n");
   // ------------------------------------------------------------
   // Official checkpoint
   // ------------------------------------------------------------
   FileWriteString(h, "\n[OFFICIAL STATUS]\n" + sep);
   FileWriteString(h, "  Path/Depth Risk Overlay : ACTIVE IN PASSIVE MODE\n");
   FileWriteString(h, "  ExecutionPolicyCandidate: Policy 1\n");
   FileWriteString(h, "  AuditPolicy             : Policy 2\n");
   FileWriteString(h, "  EA Behavioral Change    : NONE\n");
   FileWriteString(h, "  Next Step               : Collect forward evidence before activation\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2C Passive Integration Report: ", fn,
         " | Coverage=", DoubleToString(oos_total > 0 ? scoreable_oos * 100.0 / oos_total : 0.0, 1), "%");
   Print("=== Stage 2C.3 Passive Integration Report DONE ===");
}
// ================================================================
// S2C_ExportPassiveIntegrationCSV
// Row-level export for audit / shadow mode
// ================================================================
void S2C_ExportPassiveIntegrationCSV()
{
   if(!g_s2b_compact_winner.trained) return;
   string fn = "Stage2C_PassiveIntegration_" + _Symbol + ".csv";
   int hc = SafeOpenCSV(fn);
   if(hc == INVALID_HANDLE) return;
   FileWriteString(hc,
      "Setup_ID,EntryTime,Signal,Split,"
      "Step4RawScore,PathRiskBand,"
      "ExecutionPolicyP1,AuditPolicyP2,"
      "y_step4,y_stop,y_deepstop,"
      "MaxStep,PnL,MaxDD,FinalEvent\r\n");
   for(int r = 0; r < g_risklab_count; r++)
   {
      SRiskLabRecord rec = g_risklab_records[r];
      double fvec[], fnorm[];
      ArrayResize(fvec,  g_s2b_compact_winner.n_features);
      ArrayResize(fnorm, g_s2b_compact_winner.n_features);
      bool scoreable = S2B_BuildFeatureVector(r, g_s2b_compact_winner, fvec);
      ArrayFree(fvec);
      ArrayFree(fnorm);
      if(!scoreable) continue;
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      string exec_p1 = S2C_GetExecutionPolicyP1(band);
      string audit_p2 = S2C_GetAuditPolicyP2(band);
      int y_step4 = rec.hit_step4_plus ? 1 : 0;
      int y_stop  = rec.stop_flag ? 1 : 0;
      int y_deep  = (rec.stop_flag && rec.max_step_reached >= 4) ? 1 : 0;
      string row = "";
      row += IntegerToString(rec.setup_id) + ",";
      row += TimeToString(rec.entry_time, TIME_DATE|TIME_MINUTES) + ",";
      row += rec.signal + ",";
      row += (rec.is_oos ? "OOS" : "DEV") + ",";
      row += DoubleToString(score, 6) + ",";
      row += S2C_BandName(band) + ",";
      row += exec_p1 + ",";
      row += audit_p2 + ",";
      row += IntegerToString(y_step4) + ",";
      row += IntegerToString(y_stop) + ",";
      row += IntegerToString(y_deep) + ",";
      row += IntegerToString(rec.max_step_reached) + ",";
      row += DoubleToString(rec.pnl, 2) + ",";
      row += DoubleToString(rec.max_dd, 2) + ",";
      row += EscapeCSV(rec.final_event);
      FileWriteString(hc, row + "\r\n");
   }
   FileFlush(hc);
   FileClose(hc);
   Print("Stage2C Passive Integration CSV: ", fn);
}
// ================================================================
// S2C_RunPhase3
// Passive integration / shadow mode
// ================================================================
void S2C_RunPhase3()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2C_RunPhase3: Compact winner not trained.");
      return;
   }
   Print("=== Stage 2C Phase 3 START ===");
   // Passive only — no execution behavior changes
   S2C_ExportPassiveIntegrationReport();
   S2C_ExportPassiveIntegrationCSV();
   Print("=== Stage 2C Phase 3 DONE ===");
}
//================================================================
// Stage 2D — Forward Shadow Validation
//================================================================
// ================================================================
// Forward CSV management
// ================================================================
bool g_s2d_header_written = false;
datetime g_s2d_last_export = 0;
string S2D_GetForwardCSVName()
{
   return "Stage2D_ForwardCollector_" + _Symbol + ".csv";
}
void S2D_WriteForwardRecord(int setup_id,
                            datetime entry_time,
                            string signal,
                            double score,
                            int band,
                            bool step4, bool stop, bool deepstop,
                            int max_step,
                            double pnl,
                            double max_dd,
                            string final_event)
{
   if(!g_s2b_compact_winner.trained) return;
   string fn = S2D_GetForwardCSVName();
   bool file_exists = FileIsExist(fn, FILE_COMMON);
   int h = INVALID_HANDLE;
   if(!file_exists || !g_s2d_header_written)
   {
      h = SafeOpenCSV(fn);
      if(h == INVALID_HANDLE)
      {
         Print("S2D_WriteForwardRecord: Cannot create file.");
         return;
      }
      FileWriteString(h,
         "Setup_ID,EntryTime,Signal,DataType,"
         "Step4RawScore,PathRiskBand,"
         "ExecutionPolicyP1,AuditPolicyP2,"
         "y_step4,y_stop,y_deepstop,"
         "MaxStep,PnL,MaxDD,FinalEvent\r\n");
      g_s2d_header_written = true;
   }
   else
   {
      h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
      if(h == INVALID_HANDLE)
      {
         Print("S2D_WriteForwardRecord: Cannot open for append.");
         return;
      }
      FileSeek(h, 0, SEEK_END);
   }
   string exec_p1  = S2C_GetExecutionPolicyP1(band);
   string audit_p2 = S2C_GetAuditPolicyP2(band);
   string row = "";
   row += IntegerToString(setup_id) + ",";
   row += TimeToString(entry_time, TIME_DATE|TIME_MINUTES) + ",";
   row += signal + ",";
   row += S2D_CurrentDataType() + ",";
   row += DoubleToString(score, 6) + ",";
   row += S2C_BandName(band) + ",";
   row += exec_p1 + ",";
   row += audit_p2 + ",";
   row += (step4 ? "1" : "0") + ",";
   row += (stop  ? "1" : "0") + ",";
   row += (deepstop ? "1" : "0") + ",";
   row += IntegerToString(max_step) + ",";
   row += DoubleToString(pnl, 2) + ",";
   row += DoubleToString(max_dd, 2) + ",";
   row += EscapeCSV(final_event);
   FileWriteString(h, row + "\r\n");
   FileFlush(h);
   FileClose(h);
}
void S2D_CollectForwardRecord(int setup_idx,
                              double realized_pnl,
                              string close_event)
{
   if(!g_s2b_compact_winner.trained) return;
   if(setup_idx < 0 || setup_idx >= g_setup_cnt) return;
   // IMPORTANT:
   // do NOT require is_active=true here,
   // because this collector may be called at the very end of close handling.
   int setup_id = g_setups[setup_idx].setup_id;
   datetime entry_time = g_setups[setup_idx].created_time;
   string signal = g_setups[setup_idx].is_bullish ? "BUY" : "SELL";
   int max_step = g_setups[setup_idx].max_step_reached;
   double max_dd = g_setups[setup_idx].max_drawdown_money;
   // Prefer finalized snapshot if available
   SEntrySnapshot snap;
   bool snap_ok = false;
   int snap_idx = FindSnapshotIndexBySetupId(setup_id);
   if(snap_idx >= 0 && snap_idx < g_snapshot_count)
   {
      snap = g_snapshots[snap_idx];
      snap_ok = true;
   }
   else if(g_current_snapshot.setup_id == setup_id)
   {
      snap = g_current_snapshot;
      snap_ok = true;
   }
   else
   {
      snap = g_current_snapshot;
      snap.setup_id = setup_id;
      snap_ok = true;
   }
   if(!snap_ok) return;
   double score = S2C_ScoreStep4(snap);
   int band = S2C_GetBand(score);
   string ft = OS_GetFinalToken(NormalizeEventString(close_event));
   bool is_stop = OS_IsStopToken(ft);
   bool is_step4 = (max_step >= 4);
   bool is_deepstop = (is_stop && max_step >= 4);
   S2D_WriteForwardRecord(
      setup_id,
      entry_time,
      signal,
      score,
      band,
      is_step4,
      is_stop,
      is_deepstop,
      max_step,
      realized_pnl,
      max_dd,
      NormalizeEventString(close_event)
   );
}
// ================================================================
// S2D_LoadForwardData
// Load forward collector CSV into arrays for analysis
// ================================================================
struct S2D_ForwardRecord
{
   int    setup_id;
   datetime entry_time;
   string signal;
   double score;
   int    band;
   bool   step4;
   bool   stop;
   bool   deepstop;
   int    max_step;
   double pnl;
   double max_dd;
   string final_event;
   void Reset()
   {
      setup_id = 0;
      entry_time = 0;
      signal = "";
      score = 0.5;
      band = 2;
      step4 = stop = deepstop = false;
      max_step = 0;
      pnl = max_dd = 0.0;
      final_event = "";
   }
};
int S2D_LoadForwardData(S2D_ForwardRecord &records[])
{
   ArrayResize(records, 0);
   int cnt = 0;
   string fn = S2D_GetForwardCSVName();
   if(!FileIsExist(fn, FILE_COMMON))
   {
      Print("S2D_LoadForwardData: File not found: ", fn);
      return 0;
   }
   int h = FileOpen(fn, FILE_READ | FILE_TXT | FILE_SHARE_READ | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("S2D_LoadForwardData: Cannot open file: ", fn);
      return 0;
   }
   // skip header
   if(!FileIsEnding(h))
      FileReadString(h);
   string wanted_type = (inp_s2d_run_mode == MODE_TRUE_FORWARD)
                        ? "FORWARD_TRUE"
                        : "FORWARD_SIM";
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(StringLen(line) < 5) continue;
      string parts[];
      if(StringSplit(line, ',', parts) < 15) continue;
      string dtype = parts[3];
      StringTrimLeft(dtype);
      StringTrimRight(dtype);
      // IMPORTANT:
      // only load records belonging to the current mode
      if(dtype != wanted_type)
         continue;
      ArrayResize(records, cnt + 1);
      records[cnt].Reset();
      records[cnt].setup_id   = (int)StringToInteger(parts[0]);
      records[cnt].entry_time = StringToTime(parts[1]);
      records[cnt].signal     = parts[2];
      records[cnt].score      = StringToDouble(parts[4]);
      string bname = parts[5];
      StringTrimLeft(bname);
      StringTrimRight(bname);
      if(bname == "E_MinimalRisk")              records[cnt].band = 0;
      else if(bname == "D_LowRisk")             records[cnt].band = 1;
      else if(bname == "C_ModerateRisk")        records[cnt].band = 2;
      else if(bname == "B_HighRisk")            records[cnt].band = 3;
      else if(bname == "A_VeryHighRisk")        records[cnt].band = 4;
      else                                      records[cnt].band = 2;
      records[cnt].step4    = (parts[8]  == "1");
      records[cnt].stop     = (parts[9]  == "1");
      records[cnt].deepstop = (parts[10] == "1");
      records[cnt].max_step = (int)StringToInteger(parts[11]);
      records[cnt].pnl      = StringToDouble(parts[12]);
      records[cnt].max_dd   = StringToDouble(parts[13]);
      string fevt = (ArraySize(parts) > 14) ? parts[14] : "";
      StringTrimLeft(fevt);
      StringTrimRight(fevt);
      records[cnt].final_event = fevt;
      cnt++;
   }
   FileClose(h);
   Print("S2D_LoadForwardData: loaded ", cnt,
         " rows | wanted_type=", wanted_type,
         " | mode=", S2D_ModeName());
   return cnt;
}
void S2D_BuildForwardCollectorFromCurrentRun()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2D_BuildForwardCollectorFromCurrentRun: compact winner not trained.");
      return;
   }
   if(g_risklab_count <= 0)
   {
      Print("S2D_BuildForwardCollectorFromCurrentRun: no risklab records.");
      return;
   }
   string fn = S2D_GetForwardCSVName();
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE)
   {
      Print("S2D_BuildForwardCollectorFromCurrentRun: cannot create file.");
      return;
   }
   FileWriteString(h,
      "Setup_ID,EntryTime,Signal,DataType,"
      "Step4RawScore,PathRiskBand,"
      "ExecutionPolicyP1,AuditPolicyP2,"
      "y_step4,y_stop,y_deepstop,"
      "MaxStep,PnL,MaxDD,FinalEvent\r\n");
   int written = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      double fvec[], fnorm[];
      ArrayResize(fvec,  g_s2b_compact_winner.n_features);
      ArrayResize(fnorm, g_s2b_compact_winner.n_features);
      bool ok = S2B_BuildFeatureVector(r, g_s2b_compact_winner, fvec);
      ArrayFree(fvec);
      ArrayFree(fnorm);
      if(!ok) continue;
      SRiskLabRecord rec = g_risklab_records[r];
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      string exec_p1  = S2C_GetExecutionPolicyP1(band);
      string audit_p2 = S2C_GetAuditPolicyP2(band);
      int y_step4 = rec.hit_step4_plus ? 1 : 0;
      int y_stop  = rec.stop_flag ? 1 : 0;
      int y_deep  = (rec.stop_flag && rec.max_step_reached >= 4) ? 1 : 0;
      string row = "";
      row += IntegerToString(rec.setup_id) + ",";
      row += TimeToString(rec.entry_time, TIME_DATE|TIME_MINUTES) + ",";
      row += rec.signal + ",";
      row += "FORWARD_SIM,";
      row += DoubleToString(score, 6) + ",";
      row += S2C_BandName(band) + ",";
      row += exec_p1 + ",";
      row += audit_p2 + ",";
      row += IntegerToString(y_step4) + ",";
      row += IntegerToString(y_stop) + ",";
      row += IntegerToString(y_deep) + ",";
      row += IntegerToString(rec.max_step_reached) + ",";
      row += DoubleToString(rec.pnl, 2) + ",";
      row += DoubleToString(rec.max_dd, 2) + ",";
      row += EscapeCSV(rec.final_event);
      FileWriteString(h, row + "\r\n");
      written++;
   }
   FileFlush(h);
   FileClose(h);
   g_s2d_header_written = true;
   Print("S2D forward collector built from current run: ", fn,
         " | Rows=", written,
         " | Mode=FORWARD_SIM");
}
// ================================================================
// S2D_RunForwardValidation
// Called manually or periodically when enough forward data exists
// ================================================================
void S2D_RunForwardValidation()
{
   Print("=== Stage 2D Forward Validation START ===");
   S2D_ForwardRecord fwd[];
   int n_fwd = S2D_LoadForwardData(fwd);
   string fn = "Stage2D_ForwardValidation_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("S2D_RunForwardValidation: Cannot create report.");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D — FORWARD SHADOW VALIDATION\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[FORWARD DATA SUMMARY]\n" + sep);
   FileWriteString(h, "  Forward records loaded: " + IntegerToString(n_fwd) + "\n");
   if(n_fwd < 50)
   {
      FileWriteString(h, "  INSUFFICIENT DATA: need at least 50 forward records for analysis.\n");
      FileWriteString(h, "  Current count: " + IntegerToString(n_fwd) + "\n");
      FileWriteString(h, "  Recommendation: continue collecting forward data.\n");
      FileWriteString(h, "\n" + line);
      FileFlush(h);
      FileClose(h);
      Print("S2D: Insufficient forward data (", n_fwd, "). Need >= 50.");
      return;
   }
   // ------------------------------------------------------------------
   // Band distribution
   // ------------------------------------------------------------------
   int band_n[5], band_step4[5], band_stop[5];
   double band_pnl[5], band_dd[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_step4, 0);
   ArrayInitialize(band_stop, 0);
   ArrayInitialize(band_pnl, 0.0);
   ArrayInitialize(band_dd, 0.0);
   for(int i = 0; i < n_fwd; i++)
   {
      int b = fwd[i].band;
      if(b < 0 || b > 4) continue;
      band_n[b]++;
      if(fwd[i].step4) band_step4[b]++;
      if(fwd[i].stop)  band_stop[b]++;
      band_pnl[b] += fwd[i].pnl;
      band_dd[b]  += fwd[i].max_dd;
   }
   FileWriteString(h, "\n[FORWARD BAND DISTRIBUTION]\n" + sep);
   FileWriteString(h, StringFormat("  %-18s  %6s  %8s  %8s  %10s  %10s\n",
      "Band", "N", "Step4%", "Stop%", "AvgPnL", "AvgMaxDD"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      double s4pct = (band_n[b] > 0) ? (band_step4[b] * 100.0 / band_n[b]) : 0.0;
      double stpct = (band_n[b] > 0) ? (band_stop[b]  * 100.0 / band_n[b]) : 0.0;
      double avgp  = (band_n[b] > 0) ? (band_pnl[b] / band_n[b]) : 0.0;
      double avgd  = (band_n[b] > 0) ? (band_dd[b]  / band_n[b]) : 0.0;
      FileWriteString(h, StringFormat("  %-18s  %6d  %7.1f%%  %7.1f%%  %10.2f  %10.2f\n",
         S2C_BandName(b), band_n[b], s4pct, stpct, avgp, avgd));
   }
   // ------------------------------------------------------------------
   // Policy 1 stability check (NORMAL vs CONFIRM)
   // ------------------------------------------------------------------
   int pol1_normal_n = 0, pol1_confirm_n = 0;
   int pol1_normal_stop = 0, pol1_confirm_stop = 0;
   int pol1_normal_step4 = 0, pol1_confirm_step4 = 0;
   double pol1_normal_pnl = 0.0, pol1_confirm_pnl = 0.0;
   double pol1_normal_dd = 0.0, pol1_confirm_dd = 0.0;
   for(int i = 0; i < n_fwd; i++)
   {
      int exec_state = S2C_GetExecutionStateP1(fwd[i].band);
      if(exec_state == S2C_STATE_NORMAL)
      {
         pol1_normal_n++;
         if(fwd[i].stop)  pol1_normal_stop++;
         if(fwd[i].step4) pol1_normal_step4++;
         pol1_normal_pnl += fwd[i].pnl;
         pol1_normal_dd  += fwd[i].max_dd;
      }
      else if(exec_state == S2C_STATE_CONFIRM)
      {
         pol1_confirm_n++;
         if(fwd[i].stop)  pol1_confirm_stop++;
         if(fwd[i].step4) pol1_confirm_step4++;
         pol1_confirm_pnl += fwd[i].pnl;
         pol1_confirm_dd  += fwd[i].max_dd;
      }
   }
   FileWriteString(h, "\n[POLICY 1 FORWARD STABILITY]\n" + sep);
   FileWriteString(h, StringFormat("  %-22s  %6s  %8s  %8s  %10s  %10s\n",
      "State", "N", "Step4%", "Stop%", "AvgPnL", "AvgMaxDD"));
   FileWriteString(h, sep);
   double n_s4pct = (pol1_normal_n > 0)  ? (pol1_normal_step4  * 100.0 / pol1_normal_n)  : 0.0;
   double n_stpct = (pol1_normal_n > 0)  ? (pol1_normal_stop   * 100.0 / pol1_normal_n)  : 0.0;
   double n_avgp  = (pol1_normal_n > 0)  ? (pol1_normal_pnl  / pol1_normal_n)  : 0.0;
   double n_avgd  = (pol1_normal_n > 0)  ? (pol1_normal_dd   / pol1_normal_n)  : 0.0;
   double c_s4pct = (pol1_confirm_n > 0) ? (pol1_confirm_step4 * 100.0 / pol1_confirm_n) : 0.0;
   double c_stpct = (pol1_confirm_n > 0) ? (pol1_confirm_stop  * 100.0 / pol1_confirm_n) : 0.0;
   double c_avgp  = (pol1_confirm_n > 0) ? (pol1_confirm_pnl / pol1_confirm_n) : 0.0;
   double c_avgd  = (pol1_confirm_n > 0) ? (pol1_confirm_dd  / pol1_confirm_n) : 0.0;
   FileWriteString(h, StringFormat("  %-22s  %6d  %7.1f%%  %7.1f%%  %10.2f  %10.2f\n",
      "ENTER_NORMAL", pol1_normal_n, n_s4pct, n_stpct, n_avgp, n_avgd));
   FileWriteString(h, StringFormat("  %-22s  %6d  %7.1f%%  %7.1f%%  %10.2f  %10.2f\n",
      "NEEDS_CONFIRMATION", pol1_confirm_n, c_s4pct, c_stpct, c_avgp, c_avgd));
   // ------------------------------------------------------------------
   // Drift detection (vs OOS baseline)
   // ------------------------------------------------------------------
   FileWriteString(h, "\n[BAND DRIFT vs OOS BASELINE]\n" + sep);
   FileWriteString(h, "  OOS baseline (from Stage 2C): E=20% D=20% C=20% B=20% A=20%\n\n");
   int total_fwd = n_fwd;
   bool has_large_drift = false;
   FileWriteString(h, StringFormat("  %-18s  %8s  %8s  %8s\n", "Band", "OOS_Pct", "FWD_Pct", "Drift"));
   FileWriteString(h, sep);
   // OOS baseline: ~20% per band (quintle-based)
   double oos_pct_baseline = 20.0;
   for(int b = 0; b < 5; b++)
   {
      double fwd_pct = (total_fwd > 0 ? band_n[b] * 100.0 / total_fwd : 0.0);
      double drift   = fwd_pct - oos_pct_baseline;
      string drift_flag = "";
      if(MathAbs(drift) > 10.0)
      {
         drift_flag = " ← LARGE DRIFT";
         has_large_drift = true;
      }
      else if(MathAbs(drift) > 5.0)
      {
         drift_flag = " ← MODERATE DRIFT";
      }
      FileWriteString(h, StringFormat("  %-18s  %7.1f%%  %7.1f%%  %+7.1f%%%s\n",
         S2C_BandName(b), oos_pct_baseline, fwd_pct, drift, drift_flag));
   }
   // ------------------------------------------------------------------
   // Recommendation
   // ------------------------------------------------------------------
   FileWriteString(h, "\n[RECOMMENDATION]\n" + sep);
   bool normal_better_than_confirm =
      (pol1_normal_n > 10 && pol1_confirm_n > 10 &&
       n_avgp > c_avgp && n_stpct < c_stpct);
   bool band_ordering_preserved =
      (band_step4[4] >= band_step4[2] && band_step4[0] <= band_step4[2]);
   if(n_fwd < 200)
   {
      FileWriteString(h, "  STATUS: EARLY_STAGE (n<200)\n");
      FileWriteString(h, "  Continue collecting data. Avoid policy changes.\n");
   }
   else if(has_large_drift && !band_ordering_preserved)
   {
      FileWriteString(h, "  STATUS: DRIFT_DETECTED\n");
      FileWriteString(h, "  Band distribution drifted AND ordering changed.\n");
      FileWriteString(h, "  Action: Consider recalibrating band boundaries.\n");
   }
   else if(normal_better_than_confirm && band_ordering_preserved && !has_large_drift)
   {
      FileWriteString(h, "  STATUS: POLICY_STABLE\n");
      FileWriteString(h, "  ENTER_NORMAL maintains advantage. Band ordering preserved. No large drift.\n");
      FileWriteString(h, "  Action: Policy 1 is ready for activation consideration.\n");
   }
   else if(normal_better_than_confirm && !has_large_drift)
   {
      FileWriteString(h, "  STATUS: CONDITIONAL_STABLE\n");
      FileWriteString(h, "  ENTER_NORMAL maintains advantage. Some drift but not critical.\n");
      FileWriteString(h, "  Action: Continue monitoring. Do not activate yet.\n");
   }
   else
   {
      FileWriteString(h, "  STATUS: AMBIGUOUS\n");
      FileWriteString(h, "  Either ordering changed or NORMAL advantage is not clear.\n");
      FileWriteString(h, "  Action: Do not activate. Review model and data quality.\n");
   }
   FileWriteString(h, "\n[ACTIVATION CRITERIA — required for Policy 1 activation]\n" + sep);
   FileWriteString(h, "  1. Forward N >= 500\n");
   FileWriteString(h, "  2. ENTER_NORMAL AvgPnL > NEEDS_CONFIRMATION AvgPnL\n");
   FileWriteString(h, "  3. ENTER_NORMAL StopRate < NEEDS_CONFIRMATION StopRate\n");
   FileWriteString(h, "  4. No large band drift (|drift| < 10%)\n");
   FileWriteString(h, "  5. Band A Step4Rate > Band E Step4Rate (ordering preserved)\n");
   bool crit1 = (n_fwd >= 500);
   bool crit2 = (pol1_normal_n > 10 && pol1_confirm_n > 10 && n_avgp > c_avgp);
   bool crit3 = (pol1_normal_n > 10 && pol1_confirm_n > 10 && n_stpct < c_stpct);
   bool crit4 = !has_large_drift;
   bool crit5 = (band_n[4] > 0 && band_n[0] > 0 &&
                 (band_step4[4] * 100.0 / band_n[4]) > (band_step4[0] * 100.0 / band_n[0]));
   FileWriteString(h, "\n[ACTIVATION CHECKLIST]\n" + sep);
   FileWriteString(h, StringFormat("  N >= 500                     : %s (%d)\n", (crit1 ? "PASS" : "FAIL"), n_fwd));
   FileWriteString(h, StringFormat("  Normal AvgPnL > Confirm      : %s\n", (crit2 ? "PASS" : "FAIL")));
   FileWriteString(h, StringFormat("  Normal StopRate < Confirm    : %s\n", (crit3 ? "PASS" : "FAIL")));
   FileWriteString(h, StringFormat("  No Large Band Drift          : %s\n", (crit4 ? "PASS" : "FAIL")));
   FileWriteString(h, StringFormat("  Band Ordering Preserved      : %s\n", (crit5 ? "PASS" : "FAIL")));
   bool all_passed = (crit1 && crit2 && crit3 && crit4 && crit5);
   FileWriteString(h, "\n  OVERALL: " + (all_passed ? "READY FOR ACTIVATION" : "NOT YET READY") + "\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(fwd);
   Print("Stage2D Forward Validation: ", fn,
         " | N=", n_fwd,
         " | AllPass=", (all_passed ? "YES" : "NO"));
      // Run outcome-aware diagnostics
   S2D_RunOutcomeAwareValidation();
      // Stage 2D.1 — root cause diagnostics
   S2D1_RunPhase1();
   Print("=== Stage 2D Forward Validation DONE ===");
}
//----------------------------------------------------------------
// S2D_RunPhase_Collect
// Call in OnDeinit or periodically
//----------------------------------------------------------------
void S2D_RunPhase_Collect()
{
   // Passive — no action needed here
   // Data is collected via S2D_CollectForwardRecord() after each trade close
   Print("S2D Forward Collector: active. Records in: ", S2D_GetForwardCSVName());
}
void S2D_RunForwardValidationIfReady(int min_required = 1)
{
   string fn = S2D_GetForwardCSVName();
   if(!FileIsExist(fn, FILE_COMMON))
   {
      Print("S2D: Forward collector file not found: ", fn);
      return;
   }
   S2D_ForwardRecord tmp[];
   int n = S2D_LoadForwardData(tmp);
   ArrayFree(tmp);
   if(n >= min_required)
   {
      Print("S2D: Forward data count=", n, " >= min=", min_required, ". Running validation...");
      S2D_RunForwardValidation();
   }
   else
   {
      Print("S2D: Forward data count=", n, " < min=", min_required, ". Keep collecting.");
   }
}
//================================================================
// Stage 2D — Outcome-aware Validation
//================================================================
// ---------------------------------------------------------------
// Forward Outcome Group
// ---------------------------------------------------------------
struct S2D_OutcomeGroup
{
   string name;
   int    n;
   int    win_cnt;
   int    stop_cnt;
   int    deepstop_cnt;
   int    maxstep_sum;
   double pnl_vals[];
   double dd_vals[];
   double pnl_mean;
   double pnl_median;
   double pnl_q25;
   double pnl_q75;
   double dd_mean;
   double dd_median;
   void Reset(string nm)
   {
      name = nm;
      n = 0;
      win_cnt = 0;
      stop_cnt = 0;
      deepstop_cnt = 0;
      maxstep_sum = 0;
      ArrayResize(pnl_vals, 0);
      ArrayResize(dd_vals, 0);
      pnl_mean = pnl_median = pnl_q25 = pnl_q75 = 0.0;
      dd_mean  = dd_median  = 0.0;
   }
   void Add(double pnl, double dd, bool is_profit, bool is_stop, bool is_deepstop, int maxstep)
   {
      int np = ArraySize(pnl_vals);
      ArrayResize(pnl_vals, np + 1);
      pnl_vals[np] = pnl;
      int nd = ArraySize(dd_vals);
      ArrayResize(dd_vals, nd + 1);
      dd_vals[nd] = dd;
      n++;
      if(is_profit) win_cnt++;
      if(is_stop) stop_cnt++;
      if(is_deepstop) deepstop_cnt++;
      maxstep_sum += maxstep;
   }
   void Finalize()
   {
      if(n <= 0) return;
      double minv=0,maxv=0;
      S2B7_Summarize(pnl_vals, n, pnl_mean, pnl_median, pnl_q25, pnl_q75, minv, maxv);
      S2B7_Summarize(dd_vals,  n, dd_mean,  dd_median,  minv, minv, minv, maxv);
   }
   double WinRate()    { return (n > 0 ? win_cnt * 100.0 / n : 0.0); }
   double StopRate()   { return (n > 0 ? stop_cnt * 100.0 / n : 0.0); }
   double DeepRate()   { return (n > 0 ? deepstop_cnt * 100.0 / n : 0.0); }
   double AvgMaxStep() { return (n > 0 ? (double)maxstep_sum / n : 0.0); }
};
string S2D_ModeName()
{
   return (inp_s2d_run_mode == MODE_TRUE_FORWARD ? "MODE_TRUE_FORWARD" : "MODE_TRAIN_EXPORT");
}
string S2D_FrozenWinnerFile()   { return "FrozenWinnerParams_" + _Symbol + ".txt"; }
string S2D_FrozenBandFile()     { return "FrozenBandConfig_"   + _Symbol + ".txt"; }
string S2D_FrozenPolicyFile()   { return "FrozenPolicyConfig_" + _Symbol + ".txt"; }
string S2D_FrozenManifestFile() { return "FrozenManifest_"     + _Symbol + ".txt"; }
bool S2D_ParseKV(string line, string &key, string &val)
{
   key = "";
   val = "";
   int eq = StringFind(line, "=");
   if(eq < 0) return false;
   key = StringSubstr(line, 0, eq);
   val = StringSubstr(line, eq + 1);
   StringTrimLeft(key);  StringTrimRight(key);
   StringTrimLeft(val);  StringTrimRight(val);
   return (key != "");
}
// simple 32-bit FNV-1a
uint S2D_HashString32(string s)
{
   uint h = 2166136261u;
   int len = StringLen(s);
   for(int i = 0; i < len; i++)
   {
      ushort ch = (ushort)StringGetCharacter(s, i);
      h ^= (uint)ch;
      h *= 16777619u;
   }
   return h;
}
string S2D_HashToString(uint h)
{
   return StringFormat("%u", h);
}
string S2D_BuildWinnerSignature()
{
   string s = "";
   s += "MODEL=" + g_s2b_compact_winner.model_name + "|";
   s += "TARGET=" + g_s2b_compact_winner.target_name + "|";
   s += "N=" + IntegerToString(g_s2b_compact_winner.n_features) + "|";
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
   {
      s += "F" + IntegerToString(k) + "=" + S2B_FeatureName(g_s2b_compact_winner.feature_idx[k]) + "|";
      s += "W" + IntegerToString(k) + "=" + DoubleToString(g_s2b_compact_winner.weights[k], 8) + "|";
      s += "M" + IntegerToString(k) + "=" + DoubleToString(g_s2b_compact_winner.feat_mean[k], 8) + "|";
      s += "S" + IntegerToString(k) + "=" + DoubleToString(g_s2b_compact_winner.feat_std[k], 8) + "|";
   }
   s += "I=" + DoubleToString(g_s2b_compact_winner.intercept, 8) + "|";
   s += "THR=" + DoubleToString(g_s2b_compact_winner.best_threshold, 8) + "|";
   s += "Q20=" + DoubleToString(g_s2c_band_boundaries[0], 8) + "|";
   s += "Q40=" + DoubleToString(g_s2c_band_boundaries[1], 8) + "|";
   s += "Q60=" + DoubleToString(g_s2c_band_boundaries[2], 8) + "|";
   s += "Q80=" + DoubleToString(g_s2c_band_boundaries[3], 8) + "|";
   s += "EXEC=" + g_s2d_exec_policy_name + "|";
   s += "AUDIT=" + g_s2d_audit_policy_name;
   return S2D_HashToString(S2D_HashString32(s));
}
string S2D_CurrentDataType()
{
   return (inp_s2d_run_mode == MODE_TRUE_FORWARD ? "FORWARD_TRUE" : "FORWARD_SIM");
}
bool S2D_ExportFrozenWinnerParams()
{
   if(!g_s2b_compact_winner.trained) return false;
   string fn = S2D_FrozenWinnerFile();
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   FileWriteString(h, "MODEL_NAME=" + g_s2b_compact_winner.model_name + "\n");
   FileWriteString(h, "TARGET_NAME=" + g_s2b_compact_winner.target_name + "\n");
   FileWriteString(h, "N_FEATURES=" + IntegerToString(g_s2b_compact_winner.n_features) + "\n");
   FileWriteString(h, "INTERCEPT=" + DoubleToString(g_s2b_compact_winner.intercept, 10) + "\n");
   FileWriteString(h, "BEST_THRESHOLD=" + DoubleToString(g_s2b_compact_winner.best_threshold, 10) + "\n");
   FileWriteString(h, "DEV_AUC=" + DoubleToString(g_s2b_compact_winner.dev_auc, 10) + "\n");
   FileWriteString(h, "OOS_AUC=" + DoubleToString(g_s2b_compact_winner.oos_auc, 10) + "\n");
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
   {
      FileWriteString(h, "F" + IntegerToString(k) + "_IDX=" + IntegerToString(g_s2b_compact_winner.feature_idx[k]) + "\n");
      FileWriteString(h, "F" + IntegerToString(k) + "_NAME=" + S2B_FeatureName(g_s2b_compact_winner.feature_idx[k]) + "\n");
      FileWriteString(h, "F" + IntegerToString(k) + "_WEIGHT=" + DoubleToString(g_s2b_compact_winner.weights[k], 10) + "\n");
      FileWriteString(h, "F" + IntegerToString(k) + "_MEAN=" + DoubleToString(g_s2b_compact_winner.feat_mean[k], 10) + "\n");
      FileWriteString(h, "F" + IntegerToString(k) + "_STD=" + DoubleToString(g_s2b_compact_winner.feat_std[k], 10) + "\n");
   }
   FileWriteString(h, "HASH=" + S2D_BuildWinnerSignature() + "\n");
   FileFlush(h);
   FileClose(h);
   return true;
}
bool S2D_ExportFrozenBandConfig()
{
   string fn = S2D_FrozenBandFile();
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   FileWriteString(h, "Q20=" + DoubleToString(g_s2c_band_boundaries[0], 10) + "\n");
   FileWriteString(h, "Q40=" + DoubleToString(g_s2c_band_boundaries[1], 10) + "\n");
   FileWriteString(h, "Q60=" + DoubleToString(g_s2c_band_boundaries[2], 10) + "\n");
   FileWriteString(h, "Q80=" + DoubleToString(g_s2c_band_boundaries[3], 10) + "\n");
   FileWriteString(h, "HASH=" + S2D_BuildWinnerSignature() + "\n");
   FileFlush(h);
   FileClose(h);
   return true;
}
bool S2D_ExportFrozenPolicyConfig()
{
   string fn = S2D_FrozenPolicyFile();
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   FileWriteString(h, "EXECUTION_POLICY=" + g_s2d_exec_policy_name + "\n");
   FileWriteString(h, "AUDIT_POLICY=" + g_s2d_audit_policy_name + "\n");
   FileWriteString(h, "HASH=" + S2D_BuildWinnerSignature() + "\n");
   FileFlush(h);
   FileClose(h);
   return true;
}
bool S2D_ExportFrozenManifest()
{
   string fn = S2D_FrozenManifestFile();
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   datetime tmin = 0, tmax = 0;
   if(g_risklab_count > 0)
   {
      tmin = g_risklab_records[0].entry_time;
      tmax = g_risklab_records[0].entry_time;
      for(int i = 1; i < g_risklab_count; i++)
      {
         if(g_risklab_records[i].entry_time < tmin) tmin = g_risklab_records[i].entry_time;
         if(g_risklab_records[i].entry_time > tmax) tmax = g_risklab_records[i].entry_time;
      }
   }
   string hash = S2D_BuildWinnerSignature();
   FileWriteString(h, "MODE=" + S2D_ModeName() + "\n");
   FileWriteString(h, "SYMBOL=" + _Symbol + "\n");
   FileWriteString(h, "CREATED_AT=" + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, "TRAIN_FROM=" + TimeToString(tmin, TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, "TRAIN_TO=" + TimeToString(tmax, TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, "SNAPSHOT_COUNT=" + IntegerToString(g_snapshot_count) + "\n");
   FileWriteString(h, "RISKLAB_COUNT=" + IntegerToString(g_risklab_count) + "\n");
   FileWriteString(h, "MODEL_HASH=" + hash + "\n");
   FileFlush(h);
   FileClose(h);
   return true;
}
bool S2D_ExportFrozenPackage()
{
   if(!g_s2b_compact_winner.trained)
   {
      Print("S2D_ExportFrozenPackage: compact winner not trained.");
      return false;
   }
   bool ok1 = S2D_ExportFrozenWinnerParams();
   bool ok2 = S2D_ExportFrozenBandConfig();
   bool ok3 = S2D_ExportFrozenPolicyConfig();
   bool ok4 = S2D_ExportFrozenManifest();
   bool all_ok = (ok1 && ok2 && ok3 && ok4);
   if(all_ok)
   {
      g_s2d_frozen_hash = S2D_BuildWinnerSignature();
      Print("Frozen package exported successfully.");
      Print("  Winner : ", S2D_FrozenWinnerFile());
      Print("  Bands  : ", S2D_FrozenBandFile());
      Print("  Policy : ", S2D_FrozenPolicyFile());
      Print("  Manifest: ", S2D_FrozenManifestFile());
      Print("  Hash   : ", g_s2d_frozen_hash);
   }
   else
   {
      Print("ERROR: Frozen package export failed.");
   }
   return all_ok;
}
bool S2D_IsFrozenWinnerAvailable()
{
   return FileIsExist(S2D_FrozenWinnerFile(), FILE_COMMON) &&
          FileIsExist(S2D_FrozenBandFile(), FILE_COMMON) &&
          FileIsExist(S2D_FrozenPolicyFile(), FILE_COMMON) &&
          FileIsExist(S2D_FrozenManifestFile(), FILE_COMMON);
}
bool S2D_LoadFrozenWinnerParams()
{
   string fn = S2D_FrozenWinnerFile();
   if(!FileIsExist(fn, FILE_COMMON)) return false;
   int h = FileOpen(fn, FILE_READ | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   g_s2b_compact_winner.Reset();
   string key, val;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(!S2D_ParseKV(line, key, val)) continue;
      if(key == "MODEL_NAME")      g_s2b_compact_winner.model_name = val;
      else if(key == "TARGET_NAME")g_s2b_compact_winner.target_name = val;
      else if(key == "N_FEATURES") g_s2b_compact_winner.n_features = (int)StringToInteger(val);
      else if(key == "INTERCEPT")  g_s2b_compact_winner.intercept = StringToDouble(val);
      else if(key == "BEST_THRESHOLD") g_s2b_compact_winner.best_threshold = StringToDouble(val);
      else if(key == "DEV_AUC")    g_s2b_compact_winner.dev_auc = StringToDouble(val);
      else if(key == "OOS_AUC")    g_s2b_compact_winner.oos_auc = StringToDouble(val);
      else if(key == "HASH")       g_s2d_frozen_hash = val;
      else
      {
         for(int k = 0; k < 20; k++)
         {
            if(key == "F" + IntegerToString(k) + "_IDX")
               g_s2b_compact_winner.feature_idx[k] = (int)StringToInteger(val);
            else if(key == "F" + IntegerToString(k) + "_WEIGHT")
               g_s2b_compact_winner.weights[k] = StringToDouble(val);
            else if(key == "F" + IntegerToString(k) + "_MEAN")
               g_s2b_compact_winner.feat_mean[k] = StringToDouble(val);
            else if(key == "F" + IntegerToString(k) + "_STD")
               g_s2b_compact_winner.feat_std[k] = StringToDouble(val);
         }
      }
   }
   FileClose(h);
   if(g_s2b_compact_winner.n_features <= 0)
      return false;
   g_s2b_compact_winner.trained = true;
   return true;
}
bool S2D_LoadFrozenBandConfig()
{
   string fn = S2D_FrozenBandFile();
   if(!FileIsExist(fn, FILE_COMMON)) return false;
   int h = FileOpen(fn, FILE_READ | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   string key, val;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(!S2D_ParseKV(line, key, val)) continue;
      if(key == "Q20") g_s2c_band_boundaries[0] = StringToDouble(val);
      else if(key == "Q40") g_s2c_band_boundaries[1] = StringToDouble(val);
      else if(key == "Q60") g_s2c_band_boundaries[2] = StringToDouble(val);
      else if(key == "Q80") g_s2c_band_boundaries[3] = StringToDouble(val);
   }
   FileClose(h);
   return true;
}
bool S2D_LoadFrozenPolicyConfig()
{
   string fn = S2D_FrozenPolicyFile();
   if(!FileIsExist(fn, FILE_COMMON)) return false;
   int h = FileOpen(fn, FILE_READ | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   string exec_pol = "", audit_pol = "";
   string key, val;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(!S2D_ParseKV(line, key, val)) continue;
      if(key == "EXECUTION_POLICY") exec_pol = val;
      else if(key == "AUDIT_POLICY") audit_pol = val;
   }
   FileClose(h);
   if(exec_pol != g_s2d_exec_policy_name) return false;
   if(audit_pol != g_s2d_audit_policy_name) return false;
   return true;
}
bool S2D_LoadFrozenManifest()
{
   string fn = S2D_FrozenManifestFile();
   if(!FileIsExist(fn, FILE_COMMON)) return false;
   int h = FileOpen(fn, FILE_READ | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return false;
   string model_hash = "";
   string symbol = "";
   string mode = "";
   string key, val;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(!S2D_ParseKV(line, key, val)) continue;
      if(key == "MODEL_HASH") model_hash = val;
      else if(key == "SYMBOL") symbol = val;
      else if(key == "MODE") mode = val;
   }
   FileClose(h);
   if(symbol != _Symbol) return false;
   if(mode != "MODE_TRAIN_EXPORT") return false;
   string current_hash = S2D_BuildWinnerSignature();
   if(model_hash != current_hash)
   {
      Print("ERROR: Frozen manifest hash mismatch.");
      Print("  Manifest: ", model_hash);
      Print("  Current : ", current_hash);
      return false;
   }
   g_s2d_frozen_hash = model_hash;
   return true;
}
bool S2D_LoadFrozenPackage()
{
   if(!S2D_IsFrozenWinnerAvailable())
   {
      Print("S2D_LoadFrozenPackage: frozen files not found.");
      return false;
   }
   bool ok1 = S2D_LoadFrozenWinnerParams();
   bool ok2 = S2D_LoadFrozenBandConfig();
   bool ok3 = S2D_LoadFrozenPolicyConfig();
   bool ok4 = S2D_LoadFrozenManifest();
   bool all_ok = (ok1 && ok2 && ok3 && ok4);
   if(all_ok)
   {
      g_s2d_frozen_loaded = true;
      Print("Frozen package loaded successfully.");
      Print("  Hash: ", g_s2d_frozen_hash);
      Print("  Mode: TRUE_FORWARD");
   }
   else
   {
      g_s2d_frozen_loaded = false;
      Print("ERROR: Frozen package load failed.");
   }
   return all_ok;
}
// ---------------------------------------------------------------
// Forward Band Group
// ---------------------------------------------------------------
struct S2D_BandGroup
{
   string name;
   int    n;
   int    step4_cnt;
   int    profit_cnt;
   int    stop_cnt;
   int    deepstop_cnt;
   int    maxstep_sum;
   double pnl_vals[];
   double dd_vals[];
   double mean_pnl;
   double median_pnl;
   double q25_pnl;
   double q75_pnl;
   double mean_dd;
   double median_dd;
   void Reset(string nm)
   {
      name = nm;
      n = 0;
      step4_cnt = 0;
      profit_cnt = 0;
      stop_cnt = 0;
      deepstop_cnt = 0;
      maxstep_sum = 0;
      ArrayResize(pnl_vals, 0);
      ArrayResize(dd_vals, 0);
      mean_pnl = median_pnl = q25_pnl = q75_pnl = 0.0;
      mean_dd = median_dd = 0.0;
   }
   void Add(double pnl, double dd, bool is_step4, bool is_profit, bool is_stop, bool is_deepstop, int maxstep)
   {
      int np = ArraySize(pnl_vals);
      ArrayResize(pnl_vals, np + 1);
      pnl_vals[np] = pnl;
      int nd = ArraySize(dd_vals);
      ArrayResize(dd_vals, nd + 1);
      dd_vals[nd] = dd;
      n++;
      if(is_step4) step4_cnt++;
      if(is_profit) profit_cnt++;
      if(is_stop) stop_cnt++;
      if(is_deepstop) deepstop_cnt++;
      maxstep_sum += maxstep;
   }
   void Finalize()
   {
      if(n <= 0) return;
      double minv=0,maxv=0;
      S2B7_Summarize(pnl_vals, n, mean_pnl, median_pnl, q25_pnl, q75_pnl, minv, maxv);
      S2B7_Summarize(dd_vals,  n, mean_dd,  median_dd,  minv, minv, minv, maxv);
   }
   double Step4Rate()  { return (n > 0 ? step4_cnt * 100.0 / n : 0.0); }
   double ProfitRate() { return (n > 0 ? profit_cnt * 100.0 / n : 0.0); }
   double StopRate()   { return (n > 0 ? stop_cnt * 100.0 / n : 0.0); }
   double DeepRate()   { return (n > 0 ? deepstop_cnt * 100.0 / n : 0.0); }
   double AvgMaxStep() { return (n > 0 ? (double)maxstep_sum / n : 0.0); }
};
// ---------------------------------------------------------------
// Report 1 — Step4 Outcome Table
// ---------------------------------------------------------------
void S2D_ExportForwardOutcomeTable()
{
   S2D_ForwardRecord recs[];
   int n = S2D_LoadForwardData(recs);
   if(n <= 0) return;
   S2D_OutcomeGroup gA, gB, gC, gD;
   gA.Reset("Step4+ & Profit");
   gB.Reset("Step4+ & Loss");
   gC.Reset("NoStep4 & Profit");
   gD.Reset("NoStep4 & Loss");
   for(int i = 0; i < n; i++)
   {
      bool step4 = recs[i].step4;
      bool prof  = (recs[i].pnl > 0.0);
      bool stop  = recs[i].stop;
      bool deep  = recs[i].deepstop;
      if(step4 && prof)        gA.Add(recs[i].pnl, recs[i].max_dd, true,  stop, deep, recs[i].max_step);
      else if(step4 && !prof)  gB.Add(recs[i].pnl, recs[i].max_dd, false, stop, deep, recs[i].max_step);
      else if(!step4 && prof)  gC.Add(recs[i].pnl, recs[i].max_dd, true,  stop, deep, recs[i].max_step);
      else                     gD.Add(recs[i].pnl, recs[i].max_dd, false, stop, deep, recs[i].max_step);
   }
   gA.Finalize(); gB.Finalize(); gC.Finalize(); gD.Finalize();
   string fn = "Stage2D_OutcomeTable_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D — STEP4 OUTCOME TABLE\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Data   : FORWARD / FORWARD_SIM\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-20s | %6s | %8s | %8s | %8s | %8s | %8s | %8s | %8s | %8s\n",
      "Group", "Count", "WinRate", "StopRate", "AvgPnL", "MedPnL", "Q25", "Q75", "AvgDD", "AvgStep"));
   FileWriteString(h, sep);
   S2D_OutcomeGroup groups[4];
   groups[0] = gA; groups[1] = gB; groups[2] = gC; groups[3] = gD;
   for(int i = 0; i < 4; i++)
   {
      FileWriteString(h, StringFormat(
         "%-20s | %6d | %7.1f%% | %7.1f%% | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f\n",
         groups[i].name,
         groups[i].n,
         groups[i].WinRate(),
         groups[i].StopRate(),
         groups[i].pnl_mean,
         groups[i].pnl_median,
         groups[i].pnl_q25,
         groups[i].pnl_q75,
         groups[i].dd_mean,
         groups[i].AvgMaxStep()));
   }
   // Step4+ vs NoStep4 effect
   double step4_pnl[];
   double nostep_pnl[];
   ArrayResize(step4_pnl, gA.n + gB.n);
   ArrayResize(nostep_pnl, gC.n + gD.n);
   int ns4 = 0, nns = 0;
   for(int i=0;i<ArraySize(gA.pnl_vals);i++) step4_pnl[ns4++] = gA.pnl_vals[i];
   for(int i=0;i<ArraySize(gB.pnl_vals);i++) step4_pnl[ns4++] = gB.pnl_vals[i];
   for(int i=0;i<ArraySize(gC.pnl_vals);i++) nostep_pnl[nns++] = gC.pnl_vals[i];
   for(int i=0;i<ArraySize(gD.pnl_vals);i++) nostep_pnl[nns++] = gD.pnl_vals[i];
   double coh=0.0, cliff=0.0, u=0.0, z=0.0;
   if(ns4 > 1 && nns > 1)
   {
      coh = S2B7_CohensD(step4_pnl, ns4, nostep_pnl, nns);
      cliff = S2B7_CliffsDelta(step4_pnl, ns4, nostep_pnl, nns);
      S2B7_MannWhitney(step4_pnl, ns4, nostep_pnl, nns, u, z);
   }
   FileWriteString(h, "\n[STEP4+ vs NO-STEP4 OUTCOME EFFECT]\n" + sep);
   FileWriteString(h, StringFormat("Cohen's d      : %.4f\n", coh));
   FileWriteString(h, StringFormat("Cliff's Delta  : %.4f\n", cliff));
   FileWriteString(h, StringFormat("Mann-Whitney U : %.2f  | z≈%.4f\n", u, z));
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(step4_pnl);
   ArrayFree(nostep_pnl);
   ArrayFree(recs);
   Print("Stage2D Outcome Table: ", fn);
}
// ---------------------------------------------------------------
// Report 2 — Band Outcome Report
// ---------------------------------------------------------------
void S2D_ExportForwardBandOutcomeReport()
{
   S2D_ForwardRecord recs[];
   int n = S2D_LoadForwardData(recs);
   if(n <= 0) return;
   S2D_BandGroup bands[5];
   for(int b = 0; b < 5; b++)
      bands[b].Reset(S2C_BandName(b));
   for(int i = 0; i < n; i++)
   {
      int b = recs[i].band;
      if(b < 0 || b > 4) continue;
      bool prof = (recs[i].pnl > 0.0);
      bands[b].Add(recs[i].pnl,
                   recs[i].max_dd,
                   recs[i].step4,
                   prof,
                   recs[i].stop,
                   recs[i].deepstop,
                   recs[i].max_step);
   }
   for(int b = 0; b < 5; b++)
      bands[b].Finalize();
   string fn = "Stage2D_BandOutcomeReport_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D — BAND OUTCOME REPORT\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-18s | %5s | %7s | %7s | %8s | %8s | %8s | %8s | %8s | %8s | %7s | %7s\n",
      "Band","N","Step4%","Profit%","AvgPnL","MedPnL","Q25","Q75","AvgDD","MedDD","Stop%","Deep%"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      FileWriteString(h, StringFormat(
         "%-18s | %5d | %6.1f%% | %6.1f%% | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %6.1f%% | %6.1f%%\n",
         bands[b].name,
         bands[b].n,
         bands[b].Step4Rate(),
         bands[b].ProfitRate(),
         bands[b].mean_pnl,
         bands[b].median_pnl,
         bands[b].q25_pnl,
         bands[b].q75_pnl,
         bands[b].mean_dd,
         bands[b].median_dd,
         bands[b].StopRate(),
         bands[b].DeepRate()));
   }
   // A vs E effect on PnL
   double a_pnl[];
   double e_pnl[];
   ArrayResize(a_pnl, ArraySize(bands[4].pnl_vals));
   ArrayResize(e_pnl, ArraySize(bands[0].pnl_vals));
   for(int i=0;i<ArraySize(bands[4].pnl_vals);i++) a_pnl[i] = bands[4].pnl_vals[i];
   for(int i=0;i<ArraySize(bands[0].pnl_vals);i++) e_pnl[i] = bands[0].pnl_vals[i];
   double coh=0.0, cliff=0.0, u=0.0, z=0.0;
   if(ArraySize(a_pnl) > 1 && ArraySize(e_pnl) > 1)
   {
      coh = S2B7_CohensD(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl));
      cliff = S2B7_CliffsDelta(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl));
      S2B7_MannWhitney(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl), u, z);
   }
   FileWriteString(h, "\n[BAND A vs BAND E — PnL EFFECT]\n" + sep);
   FileWriteString(h, StringFormat("Band A Mean/Median PnL: %.2f / %.2f\n", bands[4].mean_pnl, bands[4].median_pnl));
   FileWriteString(h, StringFormat("Band E Mean/Median PnL: %.2f / %.2f\n", bands[0].mean_pnl, bands[0].median_pnl));
   FileWriteString(h, StringFormat("Cohen's d      : %.4f\n", coh));
   FileWriteString(h, StringFormat("Cliff's Delta  : %.4f\n", cliff));
   FileWriteString(h, StringFormat("Mann-Whitney U : %.2f  | z≈%.4f\n", u, z));
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(a_pnl);
   ArrayFree(e_pnl);
   ArrayFree(recs);
   Print("Stage2D Band Outcome Report: ", fn);
}
// ---------------------------------------------------------------
// Report 3 — Outcome Summary / Role validation
// ---------------------------------------------------------------
void S2D_ExportForwardOutcomeSummary()
{
   S2D_ForwardRecord recs[];
   int n = S2D_LoadForwardData(recs);
   if(n <= 0) return;
   double score_vals[];
   double pnl_vals[];
   double step_vals[];
   double stop_vals[];
   double profit_vals[];
   double dd_vals[];
   ArrayResize(score_vals,  n);
   ArrayResize(pnl_vals,    n);
   ArrayResize(step_vals,   n);
   ArrayResize(stop_vals,   n);
   ArrayResize(profit_vals, n);
   ArrayResize(dd_vals,     n);
   for(int i = 0; i < n; i++)
   {
      score_vals[i]  = recs[i].score;
      pnl_vals[i]    = recs[i].pnl;
      step_vals[i]   = recs[i].step4 ? 1.0 : 0.0;
      stop_vals[i]   = recs[i].stop  ? 1.0 : 0.0;
      profit_vals[i] = (recs[i].pnl > 0.0 ? 1.0 : 0.0);
      dd_vals[i]     = recs[i].max_dd;
   }
   string fn = "Stage2D_OutcomeSummary_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(score_vals); ArrayFree(pnl_vals); ArrayFree(step_vals);
      ArrayFree(stop_vals); ArrayFree(profit_vals); ArrayFree(dd_vals); ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D — OUTCOME-AWARE VALIDATION SUMMARY\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   double p_score_pnl   = S2B7_Pearson(score_vals, pnl_vals, n);
   double s_score_pnl   = S2B7_Spearman(score_vals, pnl_vals, n);
   double p_score_step4 = S2B7_Pearson(score_vals, step_vals, n);
   double s_score_step4 = S2B7_Spearman(score_vals, step_vals, n);
   double p_score_stop  = S2B7_Pearson(score_vals, stop_vals, n);
   double s_score_stop  = S2B7_Spearman(score_vals, stop_vals, n);
   double p_score_prof  = S2B7_Pearson(score_vals, profit_vals, n);
   double s_score_prof  = S2B7_Spearman(score_vals, profit_vals, n);
   double p_score_dd    = S2B7_Pearson(score_vals, dd_vals, n);
   double s_score_dd    = S2B7_Spearman(score_vals, dd_vals, n);
   FileWriteString(h, "\n[OUTCOME ASSOCIATION]\n" + sep);
   FileWriteString(h, StringFormat("%-18s | %10s | %10s\n", "Relation", "Pearson", "Spearman"));
   FileWriteString(h, sep);
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs PnL",    p_score_pnl,   s_score_pnl));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Step4",  p_score_step4, s_score_step4));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Stop",   p_score_stop,  s_score_stop));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Profit", p_score_prof,  s_score_prof));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs MaxDD",  p_score_dd,    s_score_dd));
   string role = "AMBIGUOUS";
   string reason = "";
   bool strong_step4_signal = (s_score_step4 > 0.08);
   bool pnl_negative_assoc  = (s_score_pnl < -0.05 || s_score_prof < -0.05);
   bool risk_positive_assoc = (s_score_stop > 0.03 || s_score_dd > 0.08);
   if(strong_step4_signal && pnl_negative_assoc && risk_positive_assoc)
   {
      role = "PATH_DEPTH_RISK_OVERLAY";
      reason = "Score increases Step4 risk and worsens economic/risk outcomes.";
   }
   else if(strong_step4_signal && !pnl_negative_assoc)
   {
      role = "ENTRY_RANKING";
      reason = "Score increases Step4 but does not clearly worsen outcome.";
   }
   else
   {
      role = "AMBIGUOUS";
      reason = "Role not cleanly separable from current forward evidence.";
   }
   FileWriteString(h, "\n[FINAL INTERPRETATION]\n" + sep);
   FileWriteString(h, "Recommendation : " + role + "\n");
   FileWriteString(h, "Reason         : " + reason + "\n");
   if(role == "PATH_DEPTH_RISK_OVERLAY")
   {
      FileWriteString(h, "\nInterpretation:\n");
      FileWriteString(h, "  Model should remain a path/depth risk overlay.\n");
      FileWriteString(h, "  Use it to stratify exposure and confirmation burden, not to estimate profit probability.\n");
   }
   else if(role == "ENTRY_RANKING")
   {
      FileWriteString(h, "\nInterpretation:\n");
      FileWriteString(h, "  Model behaves like an entry-quality ranker.\n");
   }
   else
   {
      FileWriteString(h, "\nInterpretation:\n");
      FileWriteString(h, "  More evidence needed before fixing the model role.\n");
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(score_vals); ArrayFree(pnl_vals); ArrayFree(step_vals);
   ArrayFree(stop_vals); ArrayFree(profit_vals); ArrayFree(dd_vals); ArrayFree(recs);
   Print("Stage2D Outcome Summary: ", fn,
         " | Recommendation=", role);
}
// ---------------------------------------------------------------
// Run full Stage 2D outcome-aware validation
// ---------------------------------------------------------------
void S2D_RunOutcomeAwareValidation()
{
   Print("=== Stage 2D Outcome-Aware Validation START ===");
   S2D_ExportForwardOutcomeTable();
   S2D_ExportForwardBandOutcomeReport();
   S2D_ExportForwardOutcomeSummary();
   Print("=== Stage 2D Outcome-Aware Validation DONE ===");
}
//================================================================
// Stage 2D.1 — Forward Root Cause Diagnostic
//================================================================
// ---------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------
int S2D1_FindWinnerFeaturePos(int feat_idx)
{
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
      if(g_s2b_compact_winner.feature_idx[k] == feat_idx)
         return k;
   return -1;
}
void S2D1_SortDesc(double &vals[], int &idx[], int n)
{
   for(int i = 0; i < n; i++) idx[i] = i;
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp = idx[i];
         int j = i;
         while(j >= gap && vals[idx[j-gap]] < vals[tmp])
         {
            idx[j] = idx[j-gap];
            j -= gap;
         }
         idx[j] = tmp;
      }
      gap /= 2;
   }
}
double S2D1_EffectiveAUC(double auc_raw)
{
   return MathMax(auc_raw, 1.0 - auc_raw);
}
string S2D1_DriftLabel(double drift_abs)
{
   if(drift_abs < 0.20) return "STABLE";
   if(drift_abs < 0.50) return "MILD";
   if(drift_abs < 0.80) return "MODERATE";
   return "LARGE";
}
// ---------------------------------------------------------------
// Report A — Feature Diagnostic
// ---------------------------------------------------------------
void S2D1_ExportForwardFeatureDiagnostic()
{
   if(inp_s2d_run_mode != MODE_TRUE_FORWARD)
      return;
   if(!g_s2b_compact_winner.trained)
      return;
   int n_feat = g_s2b_compact_winner.n_features;
   if(n_feat <= 0) return;
   string fn = "Stage2D1_FeatureDiagnostic_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D.1 — FORWARD FEATURE DIAGNOSTIC\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Mode   : TRUE_FORWARD\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-24s | %10s | %10s | %10s | %8s | %8s | %8s | %8s | %12s\n",
      "Feature", "TrainMean", "FwdMean", "Drift(SD)", "AUC", "RhoStep4", "RhoPnL", "RhoDD", "SignConsistency"));
   FileWriteString(h, sep);
   for(int k = 0; k < n_feat; k++)
   {
      int feat_idx = g_s2b_compact_winner.feature_idx[k];
      double x[];
      int    y_step4[];
      double y_pnl[];
      double y_dd[];
      ArrayResize(x,       g_risklab_count);
      ArrayResize(y_step4, g_risklab_count);
      ArrayResize(y_pnl,   g_risklab_count);
      ArrayResize(y_dd,    g_risklab_count);
      int n = 0;
      double sum = 0.0, sumsq = 0.0;
      for(int r = 0; r < g_risklab_count; r++)
      {
         double fv = 0.0;
         if(!S2B_GetFeatureValue(r, feat_idx, fv)) continue;
         x[n]       = fv;
         y_step4[n] = g_risklab_records[r].hit_step4_plus ? 1 : 0;
         y_pnl[n]   = g_risklab_records[r].pnl;
         y_dd[n]    = g_risklab_records[r].max_dd;
         sum += fv;
         sumsq += fv * fv;
         n++;
      }
      if(n < 20)
      {
         ArrayFree(x); ArrayFree(y_step4); ArrayFree(y_pnl); ArrayFree(y_dd);
         continue;
      }
      ArrayResize(x,       n);
      ArrayResize(y_step4, n);
      ArrayResize(y_pnl,   n);
      ArrayResize(y_dd,    n);
      double fwd_mean = sum / n;
      double fwd_var  = sumsq / n - fwd_mean * fwd_mean;
      double fwd_std  = (fwd_var > 1e-12) ? MathSqrt(fwd_var) : 0.0;
      double train_mean = g_s2b_compact_winner.feat_mean[k];
      double train_std  = g_s2b_compact_winner.feat_std[k];
      if(train_std < 1e-10) train_std = 1.0;
      double drift = (fwd_mean - train_mean) / train_std;
      // AUC raw + effective
      double auc_raw = RL_CalcAUC(x, y_step4, n);
      double auc_eff = S2D1_EffectiveAUC(auc_raw);
      // Convert binary target to double for rho
      double y_step4_d[];
      ArrayResize(y_step4_d, n);
      for(int i = 0; i < n; i++) y_step4_d[i] = (double)y_step4[i];
      double rho_step4 = S2B7_Spearman(x, y_step4_d, n);
      double rho_pnl   = S2B7_Spearman(x, y_pnl, n);
      double rho_dd    = S2B7_Spearman(x, y_dd, n);
      // sign consistency
      string sign_consistency = "AMBIGUOUS";
      double w = g_s2b_compact_winner.weights[k];
      if(MathAbs(w) < 0.02)
      {
         sign_consistency = "NEAR_ZERO_WEIGHT";
      }
      else if(MathAbs(rho_step4) < 0.03)
      {
         sign_consistency = "WEAK_FORWARD_SIGNAL";
      }
      else
      {
         bool expected_pos = (w >= 0.0);
         bool observed_pos = (rho_step4 >= 0.0);
         sign_consistency = (expected_pos == observed_pos) ? "CONSISTENT" : "INCONSISTENT";
      }
      FileWriteString(h, StringFormat(
         "%-24s | %10.4f | %10.4f | %10.4f | %8.4f | %8.4f | %8.4f | %8.4f | %12s\n",
         S2B_FeatureName(feat_idx),
         train_mean, fwd_mean, drift,
         auc_eff, rho_step4, rho_pnl, rho_dd, sign_consistency));
      ArrayFree(x);
      ArrayFree(y_step4);
      ArrayFree(y_pnl);
      ArrayFree(y_dd);
      ArrayFree(y_step4_d);
   }
   FileWriteString(h, "\nLegend:\n");
   FileWriteString(h, "  AUC      = effective AUC vs y_step4 (direction-agnostic)\n");
   FileWriteString(h, "  Drift    = (ForwardMean - TrainMean) / TrainStd\n");
   FileWriteString(h, "  RhoStep4 = Spearman(feature, y_step4)\n");
   FileWriteString(h, "  RhoPnL   = Spearman(feature, pnl)\n");
   FileWriteString(h, "  RhoDD    = Spearman(feature, max_dd)\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2D1 Feature Diagnostic: ", fn);
}
// ---------------------------------------------------------------
// Report B — Score Decile Diagnostic
// ---------------------------------------------------------------
void S2D1_ExportForwardScoreDecileDiagnostic()
{
   if(inp_s2d_run_mode != MODE_TRUE_FORWARD)
      return;
   S2D_ForwardRecord recs[];
   int n = S2D_LoadForwardData(recs);
   if(n < 50)
   {
      ArrayFree(recs);
      return;
   }
   double scores[];
   ArrayResize(scores, n);
   for(int i = 0; i < n; i++) scores[i] = recs[i].score;
   int ord[];
   ArrayResize(ord, n);
   S2D1_SortDesc(scores, ord, n); // high score first
   int dec_n[10], dec_step4[10], dec_stop[10], dec_profit[10];
   double dec_score_sum[10], dec_pnl_sum[10], dec_dd_sum[10];
   double dec_pnl_vals[10][6000]; // generous ceiling for current use
   int    dec_pnl_cnt[10];
   ArrayInitialize(dec_n, 0);
   ArrayInitialize(dec_step4, 0);
   ArrayInitialize(dec_stop, 0);
   ArrayInitialize(dec_profit, 0);
   ArrayInitialize(dec_score_sum, 0.0);
   ArrayInitialize(dec_pnl_sum, 0.0);
   ArrayInitialize(dec_dd_sum, 0.0);
   ArrayInitialize(dec_pnl_cnt, 0);
   for(int r = 0; r < n; r++)
   {
      int idx = ord[r];
      int d = (int)MathFloor((double)r * 10.0 / n);
      if(d > 9) d = 9;
      dec_n[d]++;
      dec_score_sum[d] += recs[idx].score;
      dec_pnl_sum[d]   += recs[idx].pnl;
      dec_dd_sum[d]    += recs[idx].max_dd;
      if(recs[idx].step4) dec_step4[d]++;
      if(recs[idx].stop)  dec_stop[d]++;
      if(recs[idx].pnl > 0.0) dec_profit[d]++;
      int c = dec_pnl_cnt[d];
      if(c < 6000)
      {
         dec_pnl_vals[d][c] = recs[idx].pnl;
         dec_pnl_cnt[d]++;
      }
   }
   string fn = "Stage2D1_ScoreDecileDiagnostic_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(scores); ArrayFree(ord); ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D.1 — SCORE DECILE DIAGNOSTIC\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-8s | %5s | %8s | %8s | %8s | %8s | %8s | %8s\n",
      "Decile", "N", "ScoreAvg", "Step4%", "Stop%", "AvgPnL", "MedPnL", "AvgDD"));
   FileWriteString(h, sep);
   int step4_viol = 0;
   int stop_viol  = 0;
   int dd_viol    = 0;
   double prev_step4 = -1.0, prev_stop = -1.0, prev_dd = -1.0;
   for(int d = 0; d < 10; d++)
   {
      double score_avg = (dec_n[d] > 0) ? dec_score_sum[d] / dec_n[d] : 0.0;
      double step4_pct = (dec_n[d] > 0) ? dec_step4[d] * 100.0 / dec_n[d] : 0.0;
      double stop_pct  = (dec_n[d] > 0) ? dec_stop[d]  * 100.0 / dec_n[d] : 0.0;
      double avg_pnl   = (dec_n[d] > 0) ? dec_pnl_sum[d] / dec_n[d] : 0.0;
      double avg_dd    = (dec_n[d] > 0) ? dec_dd_sum[d]  / dec_n[d] : 0.0;
      double med_pnl = 0.0;
      if(dec_pnl_cnt[d] > 0)
      {
         double tmp[];
         ArrayResize(tmp, dec_pnl_cnt[d]);
         for(int i = 0; i < dec_pnl_cnt[d]; i++) tmp[i] = dec_pnl_vals[d][i];
         med_pnl = S2B7_Quantile(tmp, dec_pnl_cnt[d], 0.50);
         ArrayFree(tmp);
      }
      FileWriteString(h, StringFormat(
         "D%-7d | %5d | %8.4f | %7.1f%% | %7.1f%% | %8.2f | %8.2f | %8.2f\n",
         d+1, dec_n[d], score_avg, step4_pct, stop_pct, avg_pnl, med_pnl, avg_dd));
      // Monotonicity expectations:
      // D1 highest score ... D10 lowest score
      // So Step4%, Stop%, AvgDD should be non-increasing as d increases
      if(d > 0)
      {
         if(step4_pct > prev_step4 + 0.0001) step4_viol++;
         if(stop_pct  > prev_stop  + 0.0001) stop_viol++;
         if(avg_dd    > prev_dd    + 0.0001) dd_viol++;
      }
      prev_step4 = step4_pct;
      prev_stop  = stop_pct;
      prev_dd    = avg_dd;
   }
   FileWriteString(h, "\n[MONOTONICITY SCORE]\n" + sep);
   FileWriteString(h, StringFormat("Step4 violations: %d / 9\n", step4_viol));
   FileWriteString(h, StringFormat("Stop  violations: %d / 9\n", stop_viol));
   FileWriteString(h, StringFormat("DD    violations: %d / 9\n", dd_viol));
   FileWriteString(h, "\nInterpretation:\n");
   if(step4_viol <= 2)
      FileWriteString(h, "  Score still ranks Step4 reasonably well.\n");
   else
      FileWriteString(h, "  Score ranking for Step4 is weak / unstable.\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(scores);
   ArrayFree(ord);
   ArrayFree(recs);
   Print("Stage2D1 Score Decile Diagnostic: ", fn);
}
// ---------------------------------------------------------------
// Report C — Band Diagnostic
// ---------------------------------------------------------------
void S2D1_ExportForwardBandDiagnostic()
{
   if(inp_s2d_run_mode != MODE_TRUE_FORWARD)
      return;
   S2D_ForwardRecord recs[];
   int n = S2D_LoadForwardData(recs);
   if(n < 50)
   {
      ArrayFree(recs);
      return;
   }
   S2D_BandGroup bands[5];
   for(int b = 0; b < 5; b++)
      bands[b].Reset(S2C_BandName(b));
   for(int i = 0; i < n; i++)
   {
      int b = recs[i].band;
      if(b < 0 || b > 4) continue;
      bands[b].Add(recs[i].pnl,
                   recs[i].max_dd,
                   recs[i].step4,
                   (recs[i].pnl > 0.0),
                   recs[i].stop,
                   recs[i].deepstop,
                   recs[i].max_step);
   }
   for(int b = 0; b < 5; b++)
      bands[b].Finalize();
   string fn = "Stage2D1_BandDiagnostic_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D.1 — BAND DIAGNOSTIC\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-18s | %5s | %7s | %7s | %8s | %8s | %8s | %8s | %8s | %8s | %7s | %7s\n",
      "Band","N","Step4%","Profit%","AvgPnL","MedPnL","Q25","Q75","AvgDD","MedDD","Stop%","Deep%"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      FileWriteString(h, StringFormat(
         "%-18s | %5d | %6.1f%% | %6.1f%% | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %6.1f%% | %6.1f%%\n",
         bands[b].name,
         bands[b].n,
         bands[b].Step4Rate(),
         bands[b].ProfitRate(),
         bands[b].mean_pnl,
         bands[b].median_pnl,
         bands[b].q25_pnl,
         bands[b].q75_pnl,
         bands[b].mean_dd,
         bands[b].median_dd,
         bands[b].StopRate(),
         bands[b].DeepRate()));
   }
   // Band monotonicity
   int step4_viol = 0, stop_viol = 0, dd_viol = 0, pnl_viol = 0;
   // Expected from A(high risk) to E(low risk):
   // Step4, Stop, DD: A >= B >= C >= D >= E
   // Profit/PnL:      A <= B <= C <= D <= E (loosely)
   for(int b = 4; b > 0; b--)
   {
      if(bands[b].Step4Rate() < bands[b-1].Step4Rate()) step4_viol++;
      if(bands[b].StopRate()  < bands[b-1].StopRate())  stop_viol++;
      if(bands[b].mean_dd     < bands[b-1].mean_dd)     dd_viol++;
      if(bands[b].mean_pnl    > bands[b-1].mean_pnl)    pnl_viol++;
   }
   FileWriteString(h, "\n[BAND MONOTONICITY SCORE]\n" + sep);
   FileWriteString(h, StringFormat("Step4 ordering violations: %d / 4\n", step4_viol));
   FileWriteString(h, StringFormat("Stop ordering violations : %d / 4\n", stop_viol));
   FileWriteString(h, StringFormat("DD ordering violations   : %d / 4\n", dd_viol));
   FileWriteString(h, StringFormat("PnL ordering violations  : %d / 4\n", pnl_viol));
   FileWriteString(h, "\nInterpretation:\n");
   if(step4_viol <= 1)
      FileWriteString(h, "  Band ordering for Step4 is mostly preserved.\n");
   else
      FileWriteString(h, "  Band ordering for Step4 is weak / broken.\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(recs);
   Print("Stage2D1 Band Diagnostic: ", fn);
}
// ---------------------------------------------------------------
// Report D — Root Cause Summary
// ---------------------------------------------------------------
void S2D1_ExportForwardRootCauseSummary()
{
   if(inp_s2d_run_mode != MODE_TRUE_FORWARD)
      return;
   // ===== Inputs for verdict =====
   int n = g_risklab_count;
   if(n < 100)
   {
      string fn0 = "Stage2D1_RootCauseSummary_" + _Symbol + ".txt";
      int h0 = FileOpen(fn0, FILE_WRITE | FILE_TXT | FILE_COMMON);
      if(h0 != INVALID_HANDLE)
      {
         FileWriteString(h0, "INSUFFICIENT_EVIDENCE\n");
         FileClose(h0);
      }
      return;
   }
   // --- Feature health
   int alive_count = 0;
   int sign_consistent_count = 0;
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
   {
      int feat_idx = g_s2b_compact_winner.feature_idx[k];
      double x[];
      int    y_step4[];
      ArrayResize(x, g_risklab_count);
      ArrayResize(y_step4, g_risklab_count);
      int m = 0;
      for(int r = 0; r < g_risklab_count; r++)
      {
         double fv = 0.0;
         if(!S2B_GetFeatureValue(r, feat_idx, fv)) continue;
         x[m] = fv;
         y_step4[m] = g_risklab_records[r].hit_step4_plus ? 1 : 0;
         m++;
      }
      if(m < 20)
      {
         ArrayFree(x); ArrayFree(y_step4);
         continue;
      }
      ArrayResize(x, m);
      ArrayResize(y_step4, m);
      double auc_raw = RL_CalcAUC(x, y_step4, m);
      double auc_eff = S2D1_EffectiveAUC(auc_raw);
      double y_d[];
      ArrayResize(y_d, m);
      for(int i = 0; i < m; i++) y_d[i] = (double)y_step4[i];
      double rho_step4 = S2B7_Spearman(x, y_d, m);
      if(auc_eff >= 0.54) alive_count++;
      double w = g_s2b_compact_winner.weights[k];
      if(MathAbs(w) < 0.02)
      {
         // do not count
      }
      else if(MathAbs(rho_step4) >= 0.03)
      {
         bool expected_pos = (w >= 0.0);
         bool observed_pos = (rho_step4 >= 0.0);
         if(expected_pos == observed_pos)
            sign_consistent_count++;
      }
      ArrayFree(x);
      ArrayFree(y_step4);
      ArrayFree(y_d);
   }
   bool feature_pass = (alive_count >= 2 && sign_consistent_count >= 3);
   // --- Score diagnostic
   S2D_ForwardRecord recs[];
   int nr = S2D_LoadForwardData(recs);
   double score_vals[];
   double step_vals[];
   ArrayResize(score_vals, nr);
   ArrayResize(step_vals, nr);
   for(int i = 0; i < nr; i++)
   {
      score_vals[i] = recs[i].score;
      step_vals[i]  = recs[i].step4 ? 1.0 : 0.0;
   }
   double rho_score_step4 = (nr >= 20 ? S2B7_Spearman(score_vals, step_vals, nr) : 0.0);
   bool score_pass = (rho_score_step4 >= 0.08);
   // --- Band diagnostic
   int band_n[5], band_step4[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_step4, 0);
   for(int i = 0; i < nr; i++)
   {
      int b = recs[i].band;
      if(b < 0 || b > 4) continue;
      band_n[b]++;
      if(recs[i].step4) band_step4[b]++;
   }
   int step4_band_viol = 0;
   for(int b = 4; b > 0; b--)
   {
      double cur = (band_n[b] > 0 ? band_step4[b] * 100.0 / band_n[b] : 0.0);
      double nxt = (band_n[b-1] > 0 ? band_step4[b-1] * 100.0 / band_n[b-1] : 0.0);
      if(cur < nxt) step4_band_viol++;
   }
   bool band_pass = (step4_band_viol <= 1);
   // --- Drift check
   int large_drift_features = 0;
   for(int k = 0; k < g_s2b_compact_winner.n_features; k++)
   {
      int feat_idx = g_s2b_compact_winner.feature_idx[k];
      double sum = 0.0;
      int cnt = 0;
      for(int r = 0; r < g_risklab_count; r++)
      {
         double fv = 0.0;
         if(!S2B_GetFeatureValue(r, feat_idx, fv)) continue;
         sum += fv;
         cnt++;
      }
      if(cnt <= 0) continue;
      double fwd_mean = sum / cnt;
      double train_mean = g_s2b_compact_winner.feat_mean[k];
      double train_std  = g_s2b_compact_winner.feat_std[k];
      if(train_std < 1e-10) train_std = 1.0;
      double drift = MathAbs((fwd_mean - train_mean) / train_std);
      if(drift > 0.8) large_drift_features++;
   }
   // --- Verdict
   string verdict = "INSUFFICIENT_EVIDENCE";
   string reason  = "";
   string confidence = "LOW";
   if(nr < 500)
   {
      verdict = "INSUFFICIENT_EVIDENCE";
      reason = "Forward sample too small for reliable diagnosis.";
      confidence = "LOW";
   }
   else if(!feature_pass)
   {
      verdict = "FEATURE_DECAY";
      reason = "Winner features lost predictive information or sign consistency.";
      confidence = "HIGH";
   }
   else if(feature_pass && score_pass && !band_pass)
   {
      verdict = "CALIBRATION_DRIFT";
      reason = "Features still alive and score still carries signal, but band ordering broke.";
      confidence = "MEDIUM";
   }
   else if(feature_pass && !score_pass)
   {
      verdict = "MODEL_DECAY";
      reason = "Features still carry some information, but frozen score no longer ranks Step4 sufficiently.";
      confidence = "HIGH";
   }
   else if(feature_pass && score_pass && band_pass)
   {
      verdict = "FEATURES_STILL_ALIVE";
      reason = "Features and score still preserve forward signal.";
      confidence = "MEDIUM";
   }
   string fn = "Stage2D1_RootCauseSummary_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(score_vals);
      ArrayFree(step_vals);
      ArrayFree(recs);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2D.1 ROOT CAUSE DIAGNOSTIC\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[SUMMARY SIGNAL CHECKS]\n" + sep);
   FileWriteString(h, StringFormat("  Forward N              : %d\n", nr));
   FileWriteString(h, StringFormat("  Feature Alive Count    : %d / %d\n", alive_count, g_s2b_compact_winner.n_features));
   FileWriteString(h, StringFormat("  Sign Consistency Count : %d / %d\n", sign_consistent_count, g_s2b_compact_winner.n_features));
   FileWriteString(h, StringFormat("  Score vs Step4 rho     : %.4f\n", rho_score_step4));
   FileWriteString(h, StringFormat("  Band Step4 violations  : %d / 4\n", step4_band_viol));
   FileWriteString(h, StringFormat("  Large Drift Features   : %d\n", large_drift_features));
   FileWriteString(h, "\n[VERDICT]\n" + sep);
   FileWriteString(h, "Result     : " + verdict + "\n");
   FileWriteString(h, "Confidence : " + confidence + "\n");
   FileWriteString(h, "Reason     : " + reason + "\n");
   FileWriteString(h, "\n[RECOMMENDATION]\n" + sep);
   if(verdict == "FEATURES_STILL_ALIVE")
   {
      FileWriteString(h, "  → Features still alive. Re-check policy / calibration before retrain.\n");
   }
   else if(verdict == "CALIBRATION_DRIFT")
   {
      FileWriteString(h, "  → Consider band recalibration before full retrain.\n");
   }
   else if(verdict == "MODEL_DECAY")
   {
      FileWriteString(h, "  → Retrain / reselect is justified.\n");
      FileWriteString(h, "  → Suggested next cycle: Train 2018–2023, holdout 2024–2026.\n");
   }
   else if(verdict == "FEATURE_DECAY")
   {
      FileWriteString(h, "  → Reopen feature selection. Current feature set may no longer be sufficient.\n");
   }
   else
   {
      FileWriteString(h, "  → Collect more forward evidence.\n");
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(score_vals);
   ArrayFree(step_vals);
   ArrayFree(recs);
   Print("Stage2D1 Root Cause Summary: ", fn,
         " | Verdict=", verdict,
         " | Confidence=", confidence);
}
// ---------------------------------------------------------------
// Run Stage 2D.1
// ---------------------------------------------------------------
void S2D1_RunPhase1()
{
   Print("=== Stage 2D.1 Forward Root Cause Diagnostic START ===");
   S2D1_ExportForwardFeatureDiagnostic();
   S2D1_ExportForwardScoreDecileDiagnostic();
   S2D1_ExportForwardBandDiagnostic();
   S2D1_ExportForwardRootCauseSummary();
   Print("=== Stage 2D.1 Forward Root Cause Diagnostic DONE ===");
}
//================================================================
// RL_BuildDatasetHealthCheckSection
// Stage 1: Dataset Health Check v1.0
//
// Scope:
//   - Dataset Overview
//   - Year / Side / Session distribution
//   - Label distribution (Stop/Target/MaxStep/PathClass)
//   - QC coverage
//   - Temporal Integrity checks
//   - Core feature coverage
//   - Optional feature coverage
//   - Quick peek (first/last records)
//
// Explicitly NOT in scope:
//   - Correlation Matrix
//   - Feature Importance / AUC / Cohen's d
//   - Threshold Scan / Combo Mining
//   - Full missing audit for all 407 columns
//   - Real feature leakage detection
//================================================================
string RL_BuildDatasetHealthCheckSection()
{
   string out = "";
   //================================================================
   // Header
   //================================================================
   out += "\r\n================================================================\r\n";
   out += "=== STAGE 1: DATASET HEALTH CHECK " + string(DHC_VERSION) + " ===\r\n";
   out += "================================================================\r\n";
   out += "GeneratedAt=" + TimeToString(TimeCurrent(), TIME_DATE | TIME_MINUTES) + "\r\n";
   out += "EA_Version=EA_v8.2\r\n";
   out += "SchemaVersion=FS_v2.0\r\n";
   out += "TF_COUNT=" + IntegerToString(TF_COUNT) + "\r\n";
   out += "Expected_Feature_Count=" + IntegerToString(DHC_GetExpectedFeatureCount()) + "\r\n";
   out += "Scope=Health Check only. No correlation, no feature importance.\r\n";
   if(g_snapshot_count <= 0)
   {
      out += "OverallStatus=NO_DATA\r\n";
      return out;
   }
   //================================================================
   // Counters
   //================================================================
   datetime first_time = g_snapshots[0].entry_time;
   datetime last_time  = g_snapshots[0].entry_time;
   int buy_cnt  = 0;
   int sell_cnt = 0;
   int stop_cnt      = 0;
   int target_cnt    = 0;
   int step4p_cnt    = 0;
   int step5_cnt     = 0;
   int deep_stop_cnt = 0;
   int deep_target_cnt = 0;
   int maxstep_cnt[6];
   ArrayInitialize(maxstep_cnt, 0);
   int path_cnt[DHC_PATH_COUNT];
   ArrayInitialize(path_cnt, 0);
   int session_cnt[DHC_SESSION_COUNT];
   ArrayInitialize(session_cnt, 0);
   // Year distribution
   int year_keys[32];
   int year_vals[32];
   ArrayInitialize(year_keys, 0);
   ArrayInitialize(year_vals, 0);
   int year_used = 0;
   // QC
   int qc_valid_cnt    = 0;
   int qc_alltf_cnt    = 0;
   int qc_ind_ok_cnt   = 0;
   int qc_nofuture_cnt = 0;
   // Temporal integrity
   int close_time_present_cnt = 0;
   int close_before_entry_cnt = 0;
   int duration_mismatch_cnt  = 0;
   int step_time_anomaly_cnt  = 0;
   // Feature count consistency
   int featurecount_ok_cnt = 0;
   int expected_fc = DHC_GetExpectedFeatureCount();
   // Core global feature coverage
   int div_span_valid_cnt       = 0;
   int div_strength_nonzero_cnt = 0;
   int piv_rsi_p1_valid_cnt     = 0;
   int piv_rsi_p2_valid_cnt     = 0;
   int piv_rsi_p3_valid_cnt     = 0;
   int ob_dist_valid_cnt        = 0;
   int ob_age_valid_cnt         = 0;
   int ob_width_valid_cnt       = 0;
   // Per-TF core coverage
   int rsi_valid[TF_COUNT];
   int adx_valid[TF_COUNT];
   int cci_valid[TF_COUNT];
   int atr_valid[TF_COUNT];
   int ema200_valid[TF_COUNT];
   int di_valid[TF_COUNT];
   // Per-TF optional coverage
   int macd_valid[TF_COUNT];
   int bb_valid[TF_COUNT];
   int stoch_valid[TF_COUNT];
   int williams_valid[TF_COUNT];
   ArrayInitialize(rsi_valid, 0);
   ArrayInitialize(adx_valid, 0);
   ArrayInitialize(cci_valid, 0);
   ArrayInitialize(atr_valid, 0);
   ArrayInitialize(ema200_valid, 0);
   ArrayInitialize(di_valid, 0);
   ArrayInitialize(macd_valid, 0);
   ArrayInitialize(bb_valid, 0);
   ArrayInitialize(stoch_valid, 0);
   ArrayInitialize(williams_valid, 0);
   // Overall summary counters
   int warn_count = 0;
   int fail_count = 0;
   //================================================================
   // Main scan
   //================================================================
   for(int i = 0; i < g_snapshot_count; i++)
   {
      SEntrySnapshot sn = g_snapshots[i];
      if(sn.entry_time < first_time) first_time = sn.entry_time;
      if(sn.entry_time > last_time)  last_time  = sn.entry_time;
      if(sn.is_bullish) buy_cnt++;
      else              sell_cnt++;
      string ft = OS_GetFinalToken(sn.close_event);
      bool is_stop   = OS_IsStopToken(ft);
      bool is_target = OS_IsTargetToken(ft);
      if(is_stop)   stop_cnt++;
      if(is_target) target_cnt++;
      if(sn.actual_max_step >= 4) step4p_cnt++;
      if(sn.actual_max_step >= 5) step5_cnt++;
      if(sn.actual_max_step >= 4 && is_stop)   deep_stop_cnt++;
      if(sn.actual_max_step >= 4 && is_target) deep_target_cnt++;
      if(sn.actual_max_step >= 1 && sn.actual_max_step <= 5)
         maxstep_cnt[sn.actual_max_step]++;
      int pc = (int)sn.path_class;
      if(pc >= 0 && pc < DHC_PATH_COUNT)
         path_cnt[pc]++;
      if(sn.session_id >= 0 && sn.session_id < DHC_SESSION_COUNT)
         session_cnt[sn.session_id]++;
      MqlDateTime dt;
      TimeToStruct(sn.entry_time, dt);
      int yidx = -1;
      for(int y = 0; y < year_used; y++)
      {
         if(year_keys[y] == dt.year)
         {
            yidx = y;
            break;
         }
      }
      if(yidx < 0 && year_used < 32)
      {
         year_keys[year_used] = dt.year;
         year_vals[year_used] = 1;
         year_used++;
      }
      else if(yidx >= 0)
      {
         year_vals[yidx]++;
      }
      if(sn.feature_count == expected_fc)
         featurecount_ok_cnt++;
      // QC
      if(sn.qc_valid)             qc_valid_cnt++;
      if(sn.qc_all_tf_valid)      qc_alltf_cnt++;
      if(sn.qc_all_indicators_ok) qc_ind_ok_cnt++;
      if(sn.qc_no_future_leak)    qc_nofuture_cnt++;
      // Temporal integrity
      if(sn.close_time > 0)
      {
         close_time_present_cnt++;
         if(sn.close_time < sn.entry_time)
            close_before_entry_cnt++;
         int expected_dur = (int)((sn.close_time - sn.entry_time) / 60);
         if(MathAbs(expected_dur - sn.trade_duration_min) > 1)
            duration_mismatch_cnt++;
      }
      datetime prev_step_t = 0;
      for(int s = 0; s < 5; s++)
      {
         if(sn.step_entry_times[s] <= 0)
            continue;
         if(sn.step_entry_times[s] < sn.entry_time)
            step_time_anomaly_cnt++;
         if(sn.close_time > 0 && sn.step_entry_times[s] > sn.close_time)
            step_time_anomaly_cnt++;
         if(prev_step_t > 0 && sn.step_entry_times[s] < prev_step_t)
            step_time_anomaly_cnt++;
         prev_step_t = sn.step_entry_times[s];
      }
      // Core global coverage
      if(sn.div_span_bars > 0)
         div_span_valid_cnt++;
      if(MathAbs(sn.price_div_strength) > 0.0000001 ||
         MathAbs(sn.rsi_div_strength)   > 0.0000001)
         div_strength_nonzero_cnt++;
      if(sn.pivot_rsi_p1 > 0.0) piv_rsi_p1_valid_cnt++;
      if(sn.pivot_rsi_p2 > 0.0) piv_rsi_p2_valid_cnt++;
      if(sn.pivot_rsi_p3 > 0.0) piv_rsi_p3_valid_cnt++;
      if(sn.ob_dist_pct >= 0.0) ob_dist_valid_cnt++;
      if(sn.ob_age_bars >= 0)   ob_age_valid_cnt++;
      if(sn.ob_width_atr > 0.0) ob_width_valid_cnt++;
      // Per-TF coverage
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(sn.rsi[tf] > 0.0 && sn.rsi[tf] <= 100.0) rsi_valid[tf]++;
         if(sn.adx[tf] > 0.0 && sn.adx[tf] <= 100.0) adx_valid[tf]++;
         if(MathIsValidNumber(sn.cci[tf]) && MathAbs(sn.cci[tf]) > 0.0) cci_valid[tf]++;
         if(sn.atr[tf] > 0.0) atr_valid[tf]++;
         if(sn.ema200[tf] > 0.0) ema200_valid[tf]++;
         if(sn.di[tf] == "+" || sn.di[tf] == "-") di_valid[tf]++;
         if(MathAbs(sn.macd_main[tf])   > 0.0000001 ||
            MathAbs(sn.macd_signal[tf]) > 0.0000001 ||
            MathAbs(sn.macd_hist[tf])   > 0.0000001)
            macd_valid[tf]++;
         if(sn.bb_width[tf] > 0.0) bb_valid[tf]++;
         if(sn.stoch_k[tf] > 0.0 || sn.stoch_d[tf] > 0.0) stoch_valid[tf]++;
         if(MathAbs(sn.williams_r[tf]) > 0.0000001) williams_valid[tf]++;
      }
   }
   //================================================================
   // Sort years ascending
   //================================================================
   for(int i = 0; i < year_used - 1; i++)
   {
      for(int j = i + 1; j < year_used; j++)
      {
         if(year_keys[j] < year_keys[i])
         {
            int tk = year_keys[i];
            year_keys[i] = year_keys[j];
            year_keys[j] = tk;
            int tv = year_vals[i];
            year_vals[i] = year_vals[j];
            year_vals[j] = tv;
         }
      }
   }
   //================================================================
   // Status helper macros
   //================================================================
   #define DHC_STATUS_QC(pct) \
      ((pct) >= DHC_THRESHOLD_QC_PASS ? "PASS" : ((pct) >= DHC_THRESHOLD_QC_WARN ? "WARN" : "FAIL"))
   #define DHC_STATUS_CORE(pct) \
      ((pct) >= DHC_THRESHOLD_CORE_PASS ? "PASS" : ((pct) >= DHC_THRESHOLD_CORE_WARN ? "WARN" : "FAIL"))
   #define DHC_STATUS_OPT(pct) \
      ((pct) >= DHC_THRESHOLD_OPT_PASS ? "PASS" : ((pct) >= DHC_THRESHOLD_OPT_WARN ? "WARN" : "FAIL"))
   #define DHC_STATUS_OB(pct) \
      ((pct) >= DHC_THRESHOLD_OB_PASS ? "PASS" : ((pct) >= DHC_THRESHOLD_OB_WARN ? "WARN" : "FAIL"))
   #define DHC_STATUS_DIV(pct) \
      ((pct) >= DHC_THRESHOLD_DIV_PASS ? "PASS" : ((pct) >= DHC_THRESHOLD_DIV_WARN ? "WARN" : "FAIL"))
   //================================================================
   // [OVERVIEW]
   //================================================================
   out += "\r\n[OVERVIEW]\r\n";
   out += "TotalSnapshots=" + IntegerToString(g_snapshot_count) + "\r\n";
   out += "FirstEventTime=" + TimeToString(first_time, TIME_DATE | TIME_MINUTES) + "\r\n";
   out += "LastEventTime=" + TimeToString(last_time, TIME_DATE | TIME_MINUTES) + "\r\n";
   out += "CoveredYears=" + IntegerToString(year_used) + "\r\n";
   out += "ExpectedFeatureCount=" + IntegerToString(expected_fc) + "\r\n";
   out += "FeatureCountConsistent=" + IntegerToString(featurecount_ok_cnt) + "/" + IntegerToString(g_snapshot_count)
        + (featurecount_ok_cnt == g_snapshot_count ? " [PASS]" : " [FAIL]") + "\r\n";
   out += "Note_SchemaSource=Fill_Meta() is reference for FeatureCount. Direct CSV header audit requires external tool.\r\n";
   if(featurecount_ok_cnt != g_snapshot_count)
      fail_count++;
   //================================================================
   // [YEAR DISTRIBUTION]
   //================================================================
   out += "\r\n[YEAR DISTRIBUTION]\r\n";
   out += "Year,Count,Pct\r\n";
   for(int i = 0; i < year_used; i++)
   {
      out += IntegerToString(year_keys[i]) + "," +
             IntegerToString(year_vals[i]) + "," +
             DoubleToString(year_vals[i] * 100.0 / g_snapshot_count, 2) + "%\r\n";
   }
   //================================================================
   // [SIDE DISTRIBUTION]
   //================================================================
   out += "\r\n[SIDE DISTRIBUTION]\r\n";
   out += "BUY=" + IntegerToString(buy_cnt) + " (" + DoubleToString(buy_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "SELL=" + IntegerToString(sell_cnt) + " (" + DoubleToString(sell_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   //================================================================
   // [SESSION DISTRIBUTION]
   //================================================================
   out += "\r\n[SESSION DISTRIBUTION]\r\n";
   string session_names[DHC_SESSION_COUNT] =
   {
      DHC_SESSION_NAME_0,
      DHC_SESSION_NAME_1,
      DHC_SESSION_NAME_2,
      DHC_SESSION_NAME_3
   };
   for(int s = 0; s < DHC_SESSION_COUNT; s++)
   {
      out += session_names[s] + "=" + IntegerToString(session_cnt[s]) +
             " (" + DoubleToString(session_cnt[s] * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   }
   //================================================================
   // [LABEL DISTRIBUTION]
   //================================================================
   out += "\r\n[LABEL DISTRIBUTION]\r\n";
   out += "StopFlag=" + IntegerToString(stop_cnt) + " (" + DoubleToString(stop_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "TargetFlag=" + IntegerToString(target_cnt) + " (" + DoubleToString(target_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "HitStep4Plus=" + IntegerToString(step4p_cnt) + " (" + DoubleToString(step4p_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "HitStep5=" + IntegerToString(step5_cnt) + " (" + DoubleToString(step5_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "DeepStop=" + IntegerToString(deep_stop_cnt) + " (" + DoubleToString(deep_stop_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "DeepTarget=" + IntegerToString(deep_target_cnt) + " (" + DoubleToString(deep_target_cnt * 100.0 / g_snapshot_count, 2) + "%)\r\n";
   out += "\r\n[MAXSTEP DISTRIBUTION]\r\n";
   out += "MaxStep,Count,Pct\r\n";
   for(int s = 1; s <= 5; s++)
   {
      out += IntegerToString(s) + "," +
             IntegerToString(maxstep_cnt[s]) + "," +
             DoubleToString(maxstep_cnt[s] * 100.0 / g_snapshot_count, 2) + "%\r\n";
   }
   out += "\r\n[PATHCLASS DISTRIBUTION]\r\n";
   out += "PathClass,Count,Pct\r\n";
   for(int pc = 0; pc < DHC_PATH_COUNT; pc++)
   {
      out += PathClassName((ENUM_PATH_CLASS)pc) + "," +
             IntegerToString(path_cnt[pc]) + "," +
             DoubleToString(path_cnt[pc] * 100.0 / g_snapshot_count, 2) + "%\r\n";
   }
   //================================================================
   // [QC COVERAGE]
   //================================================================
   out += "\r\n[QC COVERAGE]\r\n";
   out += "Metric,Count,Pct,Status\r\n";
   double pct = 0.0;
   string status = "";
   pct = qc_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_QC(pct);
   out += "QC_Valid," + IntegerToString(qc_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = qc_alltf_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_QC(pct);
   out += "QC_AllTF_Valid," + IntegerToString(qc_alltf_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = qc_ind_ok_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_QC(pct);
   out += "QC_IndicatorsOK," + IntegerToString(qc_ind_ok_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = qc_nofuture_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_QC(pct);
   out += "QC_NoFutureLeak," + IntegerToString(qc_nofuture_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   //================================================================
   // [TEMPORAL INTEGRITY CHECKS]
   //================================================================
   out += "\r\n[TEMPORAL INTEGRITY CHECKS]\r\n";
   out += "Note: Checks temporal ordering only. Feature-level leakage analysis is Stage 2+.\r\n";
   out += "Check,IssueCount,IssuePct,Status\r\n";
   {
      int issue = g_snapshot_count - close_time_present_cnt;
      double issue_pct = issue * 100.0 / g_snapshot_count;
      status = (issue == 0 ? "PASS" : (issue_pct <= DHC_TEMPORAL_MAX_ISSUE_PCT ? "WARN" : "FAIL"));
      out += "CloseTimeMissing," + IntegerToString(issue) + "," + DoubleToString(issue_pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   }
   {
      double issue_pct = close_before_entry_cnt * 100.0 / g_snapshot_count;
      status = (close_before_entry_cnt == 0 ? "PASS" : "FAIL");
      out += "CloseBeforeEntry," + IntegerToString(close_before_entry_cnt) + "," + DoubleToString(issue_pct, 2) + "%," + status + "\r\n";
      if(status == "FAIL") fail_count++;
   }
   {
      double issue_pct = duration_mismatch_cnt * 100.0 / g_snapshot_count;
      status = (duration_mismatch_cnt == 0 ? "PASS" : (issue_pct <= DHC_TEMPORAL_MAX_ISSUE_PCT ? "WARN" : "FAIL"));
      out += "TradeDurationMismatch," + IntegerToString(duration_mismatch_cnt) + "," + DoubleToString(issue_pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   }
   {
      double issue_pct = step_time_anomaly_cnt * 100.0 / g_snapshot_count;
      status = (step_time_anomaly_cnt == 0 ? "PASS" : (issue_pct <= DHC_TEMPORAL_MAX_ISSUE_PCT ? "WARN" : "FAIL"));
      out += "StepTimeAnomaly," + IntegerToString(step_time_anomaly_cnt) + "," + DoubleToString(issue_pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   }
   //================================================================
   // [CORE FEATURE COVERAGE]
   //================================================================
   out += "\r\n[CORE FEATURE COVERAGE]\r\n";
   out += "Feature,ValidCount,Pct,Status\r\n";
   pct = div_span_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_DIV(pct);
   out += "Div_Span_Bars>0," + IntegerToString(div_span_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = div_strength_nonzero_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_DIV(pct);
   out += "Div_Strength_NonZero," + IntegerToString(div_strength_nonzero_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = piv_rsi_p1_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_DIV(pct);
   out += "Pivot_RSI_P1," + IntegerToString(piv_rsi_p1_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = piv_rsi_p2_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_DIV(pct);
   out += "Pivot_RSI_P2," + IntegerToString(piv_rsi_p2_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = piv_rsi_p3_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_DIV(pct);
   out += "Pivot_RSI_P3," + IntegerToString(piv_rsi_p3_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = ob_dist_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_OB(pct);
   out += "OB_DistPct_Valid," + IntegerToString(ob_dist_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = ob_age_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_OB(pct);
   out += "OB_AgeBars_Valid," + IntegerToString(ob_age_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   pct = ob_width_valid_cnt * 100.0 / g_snapshot_count;
   status = DHC_STATUS_OB(pct);
   out += "OB_Width_ATR_Valid," + IntegerToString(ob_width_valid_cnt) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   //================================================================
   // [CORE FEATURE COVERAGE — PER TF]
   //================================================================
   out += "\r\n[CORE FEATURE COVERAGE — PER TF]\r\n";
   out += "Family,TF,ValidCount,Pct,Status\r\n";
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      string tfn = g_tf[tf].name;
      pct = rsi_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "RSI," + tfn + "," + IntegerToString(rsi_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
      pct = adx_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "ADX," + tfn + "," + IntegerToString(adx_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
      pct = cci_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "CCI," + tfn + "," + IntegerToString(cci_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
      pct = atr_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "ATR," + tfn + "," + IntegerToString(atr_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
      pct = ema200_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "EMA200," + tfn + "," + IntegerToString(ema200_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
      pct = di_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_CORE(pct);
      out += "DI," + tfn + "," + IntegerToString(di_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      if(status == "WARN") warn_count++; else if(status == "FAIL") fail_count++;
   }
   //================================================================
   // [OPTIONAL FEATURE COVERAGE — PER TF]
   //================================================================
   out += "\r\n[OPTIONAL FEATURE COVERAGE — PER TF]\r\n";
   out += "Note: WARN/FAIL here does not block research. These indicators may fail at session boundaries or early history.\r\n";
   out += "Family,TF,ValidCount,Pct,Status\r\n";
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      string tfn = g_tf[tf].name;
      pct = macd_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_OPT(pct);
      out += "MACD," + tfn + "," + IntegerToString(macd_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      pct = bb_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_OPT(pct);
      out += "BB," + tfn + "," + IntegerToString(bb_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      pct = stoch_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_OPT(pct);
      out += "Stoch," + tfn + "," + IntegerToString(stoch_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
      pct = williams_valid[tf] * 100.0 / g_snapshot_count;
      status = DHC_STATUS_OPT(pct);
      out += "Williams," + tfn + "," + IntegerToString(williams_valid[tf]) + "," + DoubleToString(pct, 2) + "%," + status + "\r\n";
   }
   //================================================================
   // [QUICK PEEK]
   //================================================================
   int peek_n = MathMin(3, g_snapshot_count);
   out += "\r\n[QUICK PEEK — FIRST RECORDS]\r\n";
   out += "SnapshotIndex,EventID,EventTime,Side,MaxStep,FinalEvent,ExitReason,FinalProfit\r\n";
   for(int i = 0; i < peek_n; i++)
   {
      string side        = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      string final_event = NormalizeEventString(g_snapshots[i].close_event);
      string exit_reason = OS_GetFinalToken(g_snapshots[i].close_event);
      out += IntegerToString(i) + ","
          + IntegerToString(g_snapshots[i].setup_id) + ","
          + TimeToString(g_snapshots[i].entry_time, TIME_DATE | TIME_MINUTES) + ","
          + side + ","
          + IntegerToString(g_snapshots[i].actual_max_step) + ","
          + final_event + ","
          + exit_reason + ","
          + DoubleToString(g_snapshots[i].final_profit, 2) + "\r\n";
   }
   out += "\r\n[QUICK PEEK — LAST RECORDS]\r\n";
   out += "SnapshotIndex,EventID,EventTime,Side,MaxStep,FinalEvent,ExitReason,FinalProfit\r\n";
   for(int i = g_snapshot_count - peek_n; i < g_snapshot_count; i++)
   {
      if(i < 0) continue;
      string side        = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      string final_event = NormalizeEventString(g_snapshots[i].close_event);
      string exit_reason = OS_GetFinalToken(g_snapshots[i].close_event);
      out += IntegerToString(i) + ","
          + IntegerToString(g_snapshots[i].setup_id) + ","
          + TimeToString(g_snapshots[i].entry_time, TIME_DATE | TIME_MINUTES) + ","
          + side + ","
          + IntegerToString(g_snapshots[i].actual_max_step) + ","
          + final_event + ","
          + exit_reason + ","
          + DoubleToString(g_snapshots[i].final_profit, 2) + "\r\n";
   }
   //================================================================
   // [HEALTH SUMMARY]
   // Optional coverage is intentionally excluded from fail escalation
   //================================================================
   string overall_status = "PASS";
   if(fail_count > 0) overall_status = "FAIL";
   else if(warn_count > 0) overall_status = "WARN";
   out += "\r\n================================================================\r\n";
   out += "=== HEALTH SUMMARY ===\r\n";
   out += "OverallStatus=" + overall_status + "\r\n";
   out += "Warnings=" + IntegerToString(warn_count) + "\r\n";
   out += "Failures=" + IntegerToString(fail_count) + "\r\n";
   out += "Note: Optional feature FAILs are excluded from OverallStatus.\r\n";
   out += "================================================================\r\n";
   #undef DHC_STATUS_QC
   #undef DHC_STATUS_CORE
   #undef DHC_STATUS_OPT
   #undef DHC_STATUS_OB
   #undef DHC_STATUS_DIV
   return out;
}
void RL_ExportSummary()
{
   string fn = "RiskLab_Summary_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create RiskLab_Summary");
      return;
   }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot reopen RiskLab_Summary");
      return;
   }
   FileSeek(h, 0, SEEK_END);
   string content = RL_BuildSummaryContent();
   content += RL_BuildDatasetHealthCheckSection();
   FileWriteString(h, content);
   FileFlush(h);
   FileClose(h);
   Print("RiskLab_Summary exported: ", fn,
         " | Stage 1 Health Check v1.0 added.");
}
void CalculateGroupStats()
{
   g_group_safe.Reset();
   g_group_moderate.Reset();
   g_group_risky.Reset();
   g_group_safe.group_type = GROUP_SAFE;
   g_group_moderate.group_type = GROUP_MODERATE;
   g_group_risky.group_type = GROUP_RISKY;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      switch(g_snapshots[i].GetGroup())
      {
         case GROUP_SAFE:
            g_group_safe.AddTrade(g_snapshots[i]);
            break;
         case GROUP_MODERATE:
            g_group_moderate.AddTrade(g_snapshots[i]);
            break;
         case GROUP_RISKY:
            g_group_risky.AddTrade(g_snapshots[i]);
            break;
      }
   }
   g_group_safe.Finalize();
   g_group_moderate.Finalize();
   g_group_risky.Finalize();
   Print("📊 Group Stats Calculated:");
   Print("   SAFE: ", g_group_safe.count, " trades| WR: ", DoubleToString(g_group_safe.GetWinRate(), 1), "%");
   Print("   MODERATE: ", g_group_moderate.count, " trades| WR: ", DoubleToString(g_group_moderate.GetWinRate(), 1), "%");
   Print("   RISKY: ", g_group_risky.count, " trades| WR: ", DoubleToString(g_group_risky.GetWinRate(), 1), "%");
}
//| ManageSetups - FIXED: No race condition|
void ManageSetups()
{
   if(!IsMarketOpen()) return;
   // از کپی setup_cnt در ابتدا استفاده می‌کنیم
   // تا اگر در حین loop setup_cnt تغییر کرد، crash نشود
   int current_cnt = g_setup_cnt;
   for(int i = 0; i < current_cnt; i++)
   {
      if(!g_setups[i].is_active) continue;
      // مرحله 1: اول TP چک کن (اولویت = بستن)
      CheckTakeProfit(i);
      // اگر setup بسته شد یا در close-only retry است، دیگر Step جدید باز نکن.
      if(!g_setups[i].is_active || g_setups[i].basket_close_pending) continue;
      // مرحله 2: ورود پله جدید — فقط اگر هنوز active است
      int step_before = g_setups[i].current_step;
      ManagePositions(i);
      // مرحله 3: اگر پله جدید وارد شد، state را ذخیره کن
      if(g_setups[i].is_active && g_setups[i].current_step != step_before)
      {
         SaveSetupBackup(i);
         SaveStepBackup(g_setups[i].current_step);
      }
   }
}
//|Compare SAFE vs RISKY groups in detail|
void CompareGroupsDetailed(bool is_buy_context)
{
   g_feature_diff_count = 0;
   if(g_group_safe.count < 10|| g_group_risky.count < 5)
   {
      Print("⚠️ Not enough data for comparison. SAFE:", g_group_safe.count, " RISKY:", g_group_risky.count);
      return;
   }
   //Compare each TF
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      string tf_name = g_tf[tf].name;
      //RSI
      if(g_feature_diff_count < 100)
      {
         g_feature_diffs[g_feature_diff_count].Calculate(
            "RSI", tf_name,
            g_group_safe.avg_rsi[tf],
            g_group_risky.avg_rsi[tf],
            is_buy_context
         );
         g_feature_diff_count++;
      }
      //ADX
      if(g_feature_diff_count < 100)
      {
         g_feature_diffs[g_feature_diff_count].Calculate(
            "ADX", tf_name,
            g_group_safe.avg_adx[tf],
            g_group_risky.avg_adx[tf],
            is_buy_context
         );
         g_feature_diff_count++;
      }
      //DI Gap
      if(g_feature_diff_count < 100)
      {
         g_feature_diffs[g_feature_diff_count].Calculate(
            "DI_Gap", tf_name,
            g_group_safe.avg_di_gap[tf],
            g_group_risky.avg_di_gap[tf],
            is_buy_context
         );
         g_feature_diff_count++;
      }
      //EMA200 Distance
      if(g_feature_diff_count < 100)
      {
         g_feature_diffs[g_feature_diff_count].Calculate(
            "EMA200_Dist", tf_name,
            g_group_safe.avg_ema200_dist[tf],
            g_group_risky.avg_ema200_dist[tf],
            is_buy_context
         );
         g_feature_diff_count++;
      }
      //DI Plus Percentage
      if(g_feature_diff_count < 100)
      {
         g_feature_diffs[g_feature_diff_count].Calculate(
            "DI_Plus_Pct", tf_name,
            g_group_safe.GetDIPlusPct(tf),
            g_group_risky.GetDIPlusPct(tf),
            is_buy_context
         );
         g_feature_diff_count++;
      }
   }
   //Global features
   if(g_feature_diff_count < 100)
   {
      g_feature_diffs[g_feature_diff_count].Calculate(
         "Stability", "ALL",
         g_group_safe.avg_stability,
         g_group_risky.avg_stability,
         is_buy_context
      );
      g_feature_diff_count++;
   }
   if(g_feature_diff_count < 100)
   {
      g_feature_diffs[g_feature_diff_count].Calculate(
         "HTF_Conflict_Pct", "ALL",
         g_group_safe.GetHTFConflictPct(),
         g_group_risky.GetHTFConflictPct(),
         is_buy_context
      );
      g_feature_diff_count++;
   }
   if(g_feature_diff_count < 100)
   {
      g_feature_diffs[g_feature_diff_count].Calculate(
         "DI_Agreement", "ALL",
         g_group_safe.avg_di_agreement,
         g_group_risky.avg_di_agreement,
         is_buy_context
      );
      g_feature_diff_count++;
   }
   if(g_feature_diff_count < 100)
   {
      g_feature_diffs[g_feature_diff_count].Calculate(
         "Pivot1_Dist", "ALL",
         g_group_safe.avg_pivot1_dist,
         g_group_risky.avg_pivot1_dist,
         is_buy_context
      );
      g_feature_diff_count++;
   }
   //Sort by predictive power
   SortFeatureDiffs();
   //Print significant differences
   Print("📊 Feature Comparison (SAFE vs RISKY):");
   int printed = 0;
   for(int i = 0; i < g_feature_diff_count && printed < 10; i++)
   {
      if(g_feature_diffs[i].IsSignificant())
      {
         Print("   ", g_feature_diffs[i].GetImpactEmoji(), " ",
               g_feature_diffs[i].feature_name, "(", g_feature_diffs[i].tf_name, "): ",
               "SAFE=", DoubleToString(g_feature_diffs[i].safe_value, 1), "| ",
               "RISKY=", DoubleToString(g_feature_diffs[i].risky_value, 1), "| ",
               "Diff=", DoubleToString(g_feature_diffs[i].diff_percent, 1), "%");
         if(g_feature_diffs[i].suggested_rule != "")
            Print("      ? Rule: ", g_feature_diffs[i].suggested_rule, " ? ", g_feature_diffs[i].rule_action);
         printed++;
      }
   }
}
SStepPrediction PredictMaxStep(SEntrySnapshot &current)
{
   SStepPrediction pred;
   pred.Reset();
   static int last_calc_snapshot_count = -1;
   if(g_snapshot_count >= 20 && g_snapshot_count != last_calc_snapshot_count)
   {
      CalculateGroupStats();
      last_calc_snapshot_count = g_snapshot_count;
   }
   if(g_group_safe.count < 25 || g_group_risky.count < 15)
   {
      pred.reasoning = "Insufficient data (need SAFE>=25, RISKY>=15)";
      pred.confidence = 20;
      pred.predicted_step = 2;
      pred.recommended_target = "TP2";
      return pred;
   }
   pred.max_risk_score = 100;
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      if(!TFDecisionInputValid(current, tf))
         continue;
      double tf_weight = 1.0;
      if(tf >= TF_IDX_H1) tf_weight = 2.0;
      else if(tf >= TF_IDX_M15) tf_weight = 1.5;
      // --- RSI ---
      double rsi_safe  = g_group_safe.avg_rsi[tf];
      double rsi_risky = g_group_risky.avg_rsi[tf];
      double rsi_range = MathMax(MathAbs(rsi_safe - rsi_risky), 5.0);
      double rsi_current = current.rsi[tf];
      if(rsi_range > 3.0)
      {
         double dist_safe  = MathAbs(rsi_current - rsi_safe) / rsi_range;
         double dist_risky = MathAbs(rsi_current - rsi_risky) / rsi_range;
         if(dist_risky < dist_safe * 0.7)
         {
            int points = (int)MathRound(3.0 * tf_weight);
            pred.AddRiskFactor("RSI(" + g_tf[tf].name + ") closer to RISKY "
               + "[cur:" + DoubleToString(rsi_current,1)
               + " safe:" + DoubleToString(rsi_safe,1)
               + " risky:" + DoubleToString(rsi_risky,1) + "]", points);
         }
      }
      // --- ADX ---
      double adx_safe  = g_group_safe.avg_adx[tf];
      double adx_risky = g_group_risky.avg_adx[tf];
      double adx_range = MathMax(MathAbs(adx_safe - adx_risky), 3.0);
      double adx_current = current.adx[tf];
      if(adx_range > 2.0)
      {
         if(adx_risky < adx_safe && adx_current < (adx_safe + adx_risky) / 2.0)
         {
            int points = (int)MathRound(3.0 * tf_weight);
            pred.AddRiskFactor("ADX(" + g_tf[tf].name + ") weak trend", points);
         }
      }
      // --- DI Direction ---
      string expected_di = current.is_bullish ? "+" : "-";
      if(current.di[tf] != expected_di)
      {
         int points = (int)MathRound(4.0 * tf_weight);
         pred.AddRiskFactor("DI(" + g_tf[tf].name + ") wrong direction", points);
      }
      // --- DI Gap ---
      double gap_safe  = g_group_safe.avg_di_gap[tf];
      double gap_risky = g_group_risky.avg_di_gap[tf];
      if(gap_safe > 1.0 && gap_risky < gap_safe * 0.6 &&
         current.di_gap[tf] > 0.0 &&
         current.di_gap[tf] < gap_safe * 0.7)
      {
         int points = (int)MathRound(2.0 * tf_weight);
         pred.AddRiskFactor("DI_Gap(" + g_tf[tf].name + ") weak", points);
      }
   }
   // --- Global factors ---
   if(current.has_htf_conflict)
   {
      double conflict_safe  = g_group_safe.GetHTFConflictPct();
      double conflict_risky = g_group_risky.GetHTFConflictPct();
      if(conflict_risky > conflict_safe * 1.3)
         pred.AddRiskFactor("HTF Conflict (common in RISKY)", 8);
   }
   if(current.stability_score > 0 &&
      current.stability_score < g_group_safe.avg_stability - 20)
      pred.AddRiskFactor("Low Stability Score", 6);
   if(current.di_agreement_count >= 0 &&
      current.di_agreement_count < g_group_safe.avg_di_agreement - 1.5)
      pred.AddRiskFactor("Low DI Agreement", 4);
   pred.Finalize();
   double sample_factor = MathMin(1.0,
      MathSqrt((double)MathMin(g_group_safe.count, g_group_risky.count) / 50.0));
   pred.confidence *= sample_factor;
   return pred;
}
//====================================================================
//  v9.2: HTF trend guard for ladder adds.
//  Returns false when H1 shows a STRONG trend AGAINST the setup direction
//  (ADX >= threshold AND DI opposed AND full EMA order opposed).
//  Fail-open whenever data is missing — the guard may defer an add,
//  it must never break the ladder logic itself.
//====================================================================
bool StepTrendGuardOK(bool is_bull)
{
   int h1 = GetTFIndexByPeriod(PERIOD_H1);
   if(h1 < 0) return true;
   double adx  = g_tf[h1].GetBufferValue(g_tf[h1].buffer_adx, 1);
   double pdi  = g_tf[h1].GetBufferValue(g_tf[h1].buffer_plus_di, 1);
   double mdi  = g_tf[h1].GetBufferValue(g_tf[h1].buffer_minus_di, 1);
   double e20  = g_tf[h1].GetBufferValue(g_tf[h1].buffer_ema_20, 1);
   double e50  = g_tf[h1].GetBufferValue(g_tf[h1].buffer_ema_50, 1);
   double e100 = g_tf[h1].GetBufferValue(g_tf[h1].buffer_ema_100, 1);
   double e200 = g_tf[h1].GetBufferValue(g_tf[h1].buffer_ema_200, 1);
   if(adx <= 0.0 || e20 <= 0.0 || e50 <= 0.0 || e100 <= 0.0 || e200 <= 0.0)
      return true;   // no data => open
   bool di_against = is_bull ? (mdi > pdi) : (pdi > mdi);
   string ord     = GetEMAOrder(e20, e50, e100, e200);
   string opposed = is_bull ? "E200>E100>E50>E20" : "E20>E50>E100>E200";
   bool order_against = (ord == opposed);
   bool trend_against = (adx >= inp_step_guard_adx_min) && di_against && order_against;
   return !trend_against;
}
//|Manage positions with market check - FIXED: exact candle entry|
void ManagePositions(int idx)
{
   if(!g_setups[idx].is_active) return;
   int cur_step = g_setups[idx].current_step;
   if(cur_step >= 5) return;
   int  next = cur_step + 1;
   bool is_bull = g_setups[idx].is_bullish;
   double next_entry = g_setups[idx].stop_levels[next - 1];
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return;
   double tick_price = is_bull ? tk.bid : tk.ask;
   bool should_enter = is_bull
       ? (tick_price <= next_entry)
       : (tick_price >= next_entry);
   // ---------- v9.2: bar-reclaim confirmation (anti knife-catch) ----------
   // Instead of buying the exact touch of the level, require the last closed
   // bar to have WICKED THROUGH the level and CLOSED BACK on the setup side.
   // Failsafe: if price runs inp_step_confirm_failsafe_atr * ATR past the
   // level without a reclaim, enter anyway so the ladder can never stall.
   if(inp_step_confirm_mode == STEP_CONFIRM_BAR_RECLAIM)
   {
      double c1  = iClose(_Symbol, PERIOD_CURRENT, 1);
      double h1b = iHigh(_Symbol, PERIOD_CURRENT, 1);
      double l1b = iLow(_Symbol, PERIOD_CURRENT, 1);
      bool reclaimed = is_bull
         ? (l1b <= next_entry && c1 > next_entry)
         : (h1b >= next_entry && c1 < next_entry);
      double atr_c  = g_tf[0].GetBufferValue(g_tf[0].buffer_atr, 1);
      double fs_dist = (atr_c > 0.0 ? atr_c : 0.0) * inp_step_confirm_failsafe_atr;
      bool failsafe = (fs_dist > 0.0) && (is_bull
         ? (tick_price <= next_entry - fs_dist)
         : (tick_price >= next_entry + fs_dist));
      should_enter = reclaimed || failsafe;
   }
   // ---------- v9.2: HTF trend guard for ladder adds ----------
   // Defer the add while H1 trend is strongly against the setup. Failsafe:
   // beyond inp_step_guard_max_slip_atr * ATR past the level, add anyway.
   if(should_enter && inp_use_step_trend_guard && !StepTrendGuardOK(is_bull))
   {
      double atr_g  = g_tf[0].GetBufferValue(g_tf[0].buffer_atr, 1);
      double g_dist = (atr_g > 0.0 ? atr_g : 0.0) * inp_step_guard_max_slip_atr;
      bool too_far  = (g_dist > 0.0) && (is_bull
         ? (tick_price <= next_entry - g_dist)
         : (tick_price >= next_entry + g_dist));
      if(!too_far)
      {
         should_enter = false;
         static datetime last_guard_log = 0;
         if(TimeCurrent() - last_guard_log > 60)
         {
            Print("Step ", next, " deferred by trend guard | Setup #",
                  g_setups[idx].setup_id);
            last_guard_log = TimeCurrent();
         }
      }
   }
   if(should_enter)
   {
      if(!IsMarketOpen())
      {
         g_setups[idx].pending_step_entry  = next;
         g_setups[idx].pending_entry_price = next_entry;
         if(!g_testing || g_visual)
            Print("Step ", next, " pending - Market closed| Setup #",
                  g_setups[idx].setup_id);
         return;
      }
      if(!IsSpreadOK())
      {
         static datetime last_spread_warn = 0;
         if(TimeCurrent() - last_spread_warn > 60)
         {
            LogWarning("High spread, delaying Step " + IntegerToString(next) +
                       "| Setup #" + IntegerToString(g_setups[idx].setup_id));
            last_spread_warn = TimeCurrent();
         }
         return;
      }
      double required_lot = GetPlannedStepLot(next);
      double free_margin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
      double margin_required = 0;
      if(!OrderCalcMargin(is_bull ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,
                          _Symbol, required_lot,
                          is_bull ? SymbolInfoDouble(_Symbol, SYMBOL_ASK)
                                  : SymbolInfoDouble(_Symbol, SYMBOL_BID),
                          margin_required))
      {
         LogError("Cannot calculate margin for Step " + IntegerToString(next));
         return;
      }
      if(margin_required > free_margin * 0.9)
      {
         LogWarning("Insufficient margin for Step " + IntegerToString(next) +
                    "| Required: " + DoubleToString(margin_required, 2) +
                    "| Free: "     + DoubleToString(free_margin, 2));
         return;
      }
      // ===== CF EXPERIMENT (research-only) — decision-time VETO gate (Freeze v2).
      // Applied exactly at the decision to place the next Step, after all
      // entry gates and BEFORE any order send. No latch: every tick re-evaluated.
      // =====
      // C2/M2 Repair V1 (Owner-approved D1-D12, d_DI=0): Step3->4 M2 is isolated
      // from the shared CF_ShouldVeto/CF_LogEvent path so M0/M1/M3 are unchanged.
      // M0 Shift-1 population collection also uses a separate observation-only
      // path and never applies a veto.
      bool cf_veto   = false;
      bool is_m0collect = (inp_cf_mode == 0 && inp_c2m2_collect_shift1_m0 &&
                           cur_step == 3 && next == 4);
      bool is_c2m2   = (inp_cf_mode == 2 && cur_step == 3 && next == 4);
      if(is_m0collect)
      {
         cf_veto = C2M2_CollectM0Step34Decision(idx, is_bull, tk);
      }
      else if(is_c2m2)
      {
         cf_veto = C2M2_Step34ShouldVeto(idx, is_bull, tk);
      }
      else
      {
         cf_veto = CF_ShouldVeto(cur_step, next, is_bull);
         CF_LogEvent(idx, cur_step, next, is_bull, tk, cf_veto ? "V" : "A",
                     cf_veto ? ("M" + IntegerToString(inp_cf_mode)) : "NONE", 0.0, 0);
      }
      if(cf_veto)
         return;
      bool success  = false;
      int  attempts = 0;
      while(!success && attempts < MAX_TRADE_ATTEMPTS)
      {
         success = PlaceEntry(g_setups[idx].setup_id, is_bull, next);
         if(!success)
         {
            attempts++;
            if(!IsMarketOpen())
            {
               g_setups[idx].pending_step_entry  = next;
               g_setups[idx].pending_entry_price = next_entry;
               Print("Market closed during Step ", next, " entry attempts");
               return;
            }
            if(!MQLInfoInteger(MQL_TESTER)) Sleep(500 * attempts);
         }
      }
      if(success)
      {
         CF_LogEvent(idx, cur_step, next, is_bull, tk, "P",
                     "M" + IntegerToString(inp_cf_mode), 0.0, 0);
         g_setups[idx].current_step = next;
         g_setups[idx].max_step_reached = MathMax(g_setups[idx].max_step_reached, next);
         if(next>=1 && next<=5) g_profile_stats[(int)TestProfile].step_entries[next-1]++;
         double fill_price = next_entry;
         datetime fill_time = TimeCurrent();
         TryGetLatestSetupPositionFill(g_setups[idx].setup_id, required_lot, fill_price, fill_time);
         if(next >= 1 && next <= 5)
         {
            g_setups[idx].step_times[next - 1]  = fill_time;
            g_setups[idx].step_prices[next - 1] = fill_price;
         }
         CF_LogEvent(idx, cur_step, next, is_bull, tk, "F",
                     "M" + IntegerToString(inp_cf_mode), fill_price, fill_time);
         // v9.21: record position-open research snapshot (ladder step)
         RecordPositionOpenBySetup(idx, next,
                                   GetLatestSetupPositionId(g_setups[idx].setup_id),
                                   fill_price, fill_time);
         // RX observation only: lifecycle event after the core step state/fill record.
         RX_RecordStepOpen(idx, next, fill_price);
         if(next >= 3)
         {
            g_setups[idx].use_ema200_as_target = false;
            if(!g_testing || g_visual)
               Print("Step ", next, " reached - EMA200 target disabled for Setup #",
                     g_setups[idx].setup_id);
         }
         g_setups[idx].pending_step_entry = 0;
         Print("Step ", next, " entered| Setup #", g_setups[idx].setup_id,
               "| ", is_bull ? "LONG" : "SHORT");
         SaveStepData(next);
         SaveStepBackup(next);
         SaveSetupBackup(idx);
         if(inp_export_on_signal)
            ExportToExcel(is_bull,
                          "ENTRY_STEP" + IntegerToString(next),
                          0, next, 0, 0);
      }
      else
      {
         LogError("Failed Step " + IntegerToString(next) +
                  " after " + IntegerToString(attempts) +
                  " attempts| Setup #" +
                  IntegerToString(g_setups[idx].setup_id));
      }
   }
}
void CheckPendingEntries()
{
   if(!IsMarketOpen()) return;
   for(int i = 0; i < g_setup_cnt; i++)
   {
      if(!g_setups[i].is_active) continue;
      if(g_setups[i].pending_step_entry == 0) continue;
      //Re-check if we should still enter
      bool is_bull = g_setups[i].is_bullish;
      double current_price = is_bull ? SymbolInfoDouble(_Symbol, SYMBOL_BID) :
                                       SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      bool still_valid = is_bull
         ? (current_price <= g_setups[i].pending_entry_price * (1.0 + PENDING_ENTRY_TOLERANCE_PCT))
         : (current_price >= g_setups[i].pending_entry_price * (1.0 - PENDING_ENTRY_TOLERANCE_PCT));
      if(still_valid)
      {
         Print("→ Processing pending Step ", g_setups[i].pending_step_entry,
               " for Setup #", g_setups[i].setup_id);
         //Use ManagePositions to handle the entry
         ManagePositions(i);
      }
      else
      {
         //Price moved away, clear pending
         Print("✗ Pending Step ", g_setups[i].pending_step_entry,
               " no longer valid - price moved| Setup #", g_setups[i].setup_id);
         g_setups[i].pending_step_entry = 0;
         g_setups[i].pending_entry_price = 0;
      }
   }
}
// Returns true when position_id belongs to one of the currently-open
// positions of this setup.
bool BasketContainsPositionId(ulong &position_ids[], int count, ulong position_id)
{
   for(int i = 0; i < count; i++)
      if(position_ids[i] == position_id) return true;
   return false;
}
// Cached conservative commission+fee rate from recent deals of this EA on
// this symbol. The cache avoids scanning 90 days of history on every tick.
double GetObservedCloseCostPerLot()
{
   static datetime last_scan = 0;
   static double cached_rate = 0.0;
   datetime now = TimeCurrent();
   if(last_scan > 0 && now - last_scan < 300)
      return cached_rate;
   last_scan = now;
   cached_rate = 0.0;
   datetime from_time = now - 90 * 86400;
   if(from_time < 0) from_time = 0;
   if(!HistorySelect(from_time, now + 60))
      return cached_rate;
   for(int i = 0; i < HistoryDealsTotal(); i++)
   {
      ulong deal = HistoryDealGetTicket(i);
      if(deal == 0) continue;
      if(HistoryDealGetString(deal, DEAL_SYMBOL) != _Symbol) continue;
      if(HistoryDealGetInteger(deal, DEAL_MAGIC) != (long)inp_magic_number) continue;
      double volume = HistoryDealGetDouble(deal, DEAL_VOLUME);
      if(volume <= 0.0) continue;
      double rate = (MathAbs(HistoryDealGetDouble(deal, DEAL_COMMISSION)) +
                     MathAbs(HistoryDealGetDouble(deal, DEAL_FEE))) / volume;
      if(rate > cached_rate) cached_rate = rate;
   }
   return cached_rate;
}
// Collects the costs that are knowable before close. POSITION_PROFIT is not
// used here because EvaluateBasketNetAtPrice calculates gross P/L at an exact
// close-side quote. Opening commission/fees are read from deals. Expected
// closing commission/fees use a conservative observed absolute cost-per-lot.
// Swap is read from each open position.
bool GetNetBasketCostData(int idx,
                          double &open_costs_signed,
                          double &estimated_close_cost,
                          double &swap_total,
                          double &total_volume,
                          int &position_count)
{
   open_costs_signed = 0.0;
   estimated_close_cost = 0.0;
   swap_total = 0.0;
   total_volume = 0.0;
   position_count = 0;
   string cf = BuildComment(g_setups[idx].setup_id);
   ulong position_ids[];
   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) != cf) continue;
      ArrayResize(position_ids, position_count + 1);
      position_ids[position_count] = (ulong)PositionGetInteger(POSITION_IDENTIFIER);
      position_count++;
      total_volume += PositionGetDouble(POSITION_VOLUME);
      swap_total += PositionGetDouble(POSITION_SWAP);
   }
   if(position_count == 0 || total_volume <= 0.0)
      return false;
   datetime from_time = g_setups[idx].created_time - 86400;
   if(from_time < 0) from_time = 0;
   if(!HistorySelect(from_time, TimeCurrent() + 60))
      return false;
   double max_cost_per_lot = 0.0;
   int deals_total = HistoryDealsTotal();
   for(int i = 0; i < deals_total; i++)
   {
      ulong deal = HistoryDealGetTicket(i);
      if(deal == 0) continue;
      ulong position_id = (ulong)HistoryDealGetInteger(deal, DEAL_POSITION_ID);
      if(!BasketContainsPositionId(position_ids, position_count, position_id))
         continue;
      double commission = HistoryDealGetDouble(deal, DEAL_COMMISSION);
      double fee = HistoryDealGetDouble(deal, DEAL_FEE);
      open_costs_signed += commission + fee;
      double deal_volume = HistoryDealGetDouble(deal, DEAL_VOLUME);
      if(deal_volume > 0.0)
      {
         double cost_per_lot = (MathAbs(commission) + MathAbs(fee)) / deal_volume;
         if(cost_per_lot > max_cost_per_lot)
            max_cost_per_lot = cost_per_lot;
      }
   }
   // Also use the cached same-Symbol/same-Magic historical rate, which covers
   // brokers that book commission only on closing deals.
   max_cost_per_lot = MathMax(max_cost_per_lot, GetObservedCloseCostPerLot());
   estimated_close_cost = max_cost_per_lot * total_volume;
   return true;
}
// Evaluates the whole setup as if every matching position were closed at the
// same close-side quote. For BUY baskets close_price is Bid; for SELL baskets
// it is Ask, so the current spread is already embedded in OrderCalcProfit.
bool EvaluateBasketNetAtPrice(int idx,
                              double close_price,
                              double open_costs_signed,
                              double estimated_close_cost,
                              double swap_total,
                              double safety_buffer,
                              double &net_result)
{
   net_result = 0.0;
   string cf = BuildComment(g_setups[idx].setup_id);
   bool is_bull = g_setups[idx].is_bullish;
   int found = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) != cf) continue;
      ENUM_POSITION_TYPE position_type =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if((is_bull && position_type != POSITION_TYPE_BUY) ||
         (!is_bull && position_type != POSITION_TYPE_SELL))
         return false;
      double gross_profit = 0.0;
      if(!OrderCalcProfit(is_bull ? ORDER_TYPE_BUY : ORDER_TYPE_SELL,
                          _Symbol,
                          PositionGetDouble(POSITION_VOLUME),
                          PositionGetDouble(POSITION_PRICE_OPEN),
                          close_price,
                          gross_profit))
         return false;
      net_result += gross_profit;
      found++;
   }
   if(found == 0) return false;
   net_result += swap_total;
   net_result += open_costs_signed;       // broker values are normally negative
   net_result -= estimated_close_cost;    // closing deals do not exist yet
   net_result -= safety_buffer;           // close slippage / unexposed costs
   return true;
}
// NET_BASKET_BE is the close-side quote at which the projected result of all
// positions in this setup is zero after known opening costs, current swap,
// estimated close costs, and the configured safety buffer.
bool CalculateNetBasketBreakEven(int idx,
                                 double &net_be_price,
                                 double &net_result_now,
                                 double &open_costs_signed,
                                 double &estimated_close_cost,
                                 double &swap_total,
                                 double &safety_buffer,
                                 int &position_count,
                                 double &total_volume)
{
   net_be_price = 0.0;
   net_result_now = 0.0;
   safety_buffer = MathMax(0.0, inp_net_be_safety_buffer_dollars);
   if(!GetNetBasketCostData(idx, open_costs_signed, estimated_close_cost,
                            swap_total, total_volume, position_count))
      return false;
   MqlTick tick;
   if(!SymbolInfoTick(_Symbol, tick)) return false;
   bool is_bull = g_setups[idx].is_bullish;
   double close_quote = is_bull ? tick.bid : tick.ask;
   double tick_size = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   if(tick_size <= 0.0) tick_size = _Point;
   if(close_quote <= 0.0 || tick_size <= 0.0) return false;
   if(!EvaluateBasketNetAtPrice(idx, close_quote,
                                open_costs_signed, estimated_close_cost,
                                swap_total, safety_buffer, net_result_now))
      return false;
   double probe_price = close_quote + (is_bull ? tick_size : -tick_size);
   double probe_net = 0.0;
   if(probe_price <= 0.0 ||
      !EvaluateBasketNetAtPrice(idx, probe_price,
                                open_costs_signed, estimated_close_cost,
                                swap_total, safety_buffer, probe_net))
      return false;
   double slope = (probe_net - net_result_now) / (probe_price - close_quote);
   if(!MathIsValidNumber(slope) || MathAbs(slope) < 1e-12)
      return false;
   double raw_be = close_quote - net_result_now / slope;
   if(!MathIsValidNumber(raw_be) || raw_be <= 0.0)
      return false;
   // Round toward profit so the displayed/checked level remains conservative.
   net_be_price = is_bull
      ? MathCeil(raw_be / tick_size) * tick_size
      : MathFloor(raw_be / tick_size) * tick_size;
   net_be_price = NormalizeDouble(net_be_price, _Digits);
   // Verify the rounded quote and move it one tick toward profit if required.
   double be_net = 0.0;
   for(int n = 0; n < 100; n++)
   {
      if(!EvaluateBasketNetAtPrice(idx, net_be_price,
                                   open_costs_signed, estimated_close_cost,
                                   swap_total, safety_buffer, be_net))
         return false;
      if(be_net >= 0.0) return true;
      net_be_price += is_bull ? tick_size : -tick_size;
      net_be_price = NormalizeDouble(net_be_price, _Digits);
   }
   return false;
}
// Step 1-3 nominal targets are candle-touch triggers only. A target touch
// never closes an individual position and never closes the basket unless the
// currently executable Bid/Ask also produces a non-negative cost-adjusted net.
bool ProcessNominalBasketTarget(int idx,
                                double bid,
                                double ask,
                                double candle_high,
                                double candle_low)
{
   int current_step = g_setups[idx].current_step;
   if(current_step < 1 || current_step > 3) return false;
   double target = 0.0;
   string target_type = "";
   CalculateTargetForStep(idx,
                          current_step,
                          g_setups[idx].max_step_reached,
                          g_setups[idx].atr_distance,
                          bid, ask, candle_high, candle_low,
                          target, target_type);
   bool is_bull = g_setups[idx].is_bullish;
   bool target_touched = (target > 0.0) && (is_bull
      ? (candle_high >= target)
      : (candle_low <= target));
   if(!target_touched) return false;
   double net_be_price = 0.0;
   double net_result_now = 0.0;
   double open_costs_signed = 0.0;
   double estimated_close_cost = 0.0;
   double swap_total = 0.0;
   double safety_buffer = 0.0;
   double total_volume = 0.0;
   int basket_positions = 0;
   bool net_ready = CalculateNetBasketBreakEven(idx,
                                                 net_be_price,
                                                 net_result_now,
                                                 open_costs_signed,
                                                 estimated_close_cost,
                                                 swap_total,
                                                 safety_buffer,
                                                 basket_positions,
                                                 total_volume);
   if(net_ready && net_result_now >= 0.0)
   {
      Print("BASKET_TARGET_NET_CONFIRMED|Setup=", g_setups[idx].setup_id,
            "|Step=", current_step,
            "|TargetType=", target_type,
            "|Positions=", basket_positions,
            "|Volume=", DoubleToString(total_volume, 2),
            "|ProjectedNet=", DoubleToString(net_result_now, 2),
            "|NetBE=", DoubleToString(net_be_price, _Digits));
      CloseSetupWithReason(idx, target_type + "_NET");
   }
   // The target was touched. Even if costs keep Net below zero, do not allow
   // a lower-priority exit to close this basket on the same tick.
   return true;
}
void CheckTakeProfit(int idx)
{
   if(!g_setups[idx].is_active) return;
   if(!IsMarketOpen()) return;
   string cf = BuildComment(g_setups[idx].setup_id);
   double floating_profit = 0;
   int pos_cnt = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(PositionGetSymbol(i) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) != cf) continue;
      floating_profit += PositionGetDouble(POSITION_PROFIT)
                       + PositionGetDouble(POSITION_SWAP);
      pos_cnt++;
   }
   if(pos_cnt == 0) return;
   // A previous basket-close cycle left one or more tickets open. Continue
   // closing the remainder without re-evaluating Entry/Target/NET membership.
   if(g_setups[idx].basket_close_pending)
   {
      string pending_reason = g_setups[idx].basket_close_reason;
      if(pending_reason == "") pending_reason = "BASKET_CLOSE_RETRY";
      CloseSetupWithReason(idx, pending_reason);
      return;
   }
   // Emergency basket stop has the highest priority at every Step (1..5).
   // Start with current POSITION_PROFIT + POSITION_SWAP and add the signed
   // Commission/Fee already booked on this setup's deals. Cost lookup is
   // best-effort here: a history-read failure must never disable the $ stop.
   double emergency_open_costs = 0.0;
   double emergency_close_estimate = 0.0;
   double emergency_swap_check = 0.0;
   double emergency_volume = 0.0;
   int emergency_positions = 0;
   bool emergency_costs_ok = GetNetBasketCostData(idx,
                                                   emergency_open_costs,
                                                   emergency_close_estimate,
                                                   emergency_swap_check,
                                                   emergency_volume,
                                                   emergency_positions);
   double floating_net = floating_profit +
                         (emergency_costs_ok ? emergency_open_costs : 0.0);
   if(inp_max_loss_dollars > 0 && floating_net <= -inp_max_loss_dollars)
   {
      Print("BASKET_DOLLAR_STOP|Setup=", g_setups[idx].setup_id,
            "|Step=", g_setups[idx].current_step,
            "|FloatingNet=", DoubleToString(floating_net, 2),
            "|OpenCommissionFee=", DoubleToString(emergency_open_costs, 2),
            "|SwapIncluded=", DoubleToString(emergency_swap_check, 2));
      CloseSetupWithReason(idx, "SL_DOLLAR");
      return;
   }
   // Step 4/5 have no profit target. Exit the entire setup only when the
   // projected result after commission, fees, swap, current close-side spread,
   // estimated close cost and safety buffer is non-negative.
   if(g_setups[idx].current_step >= 4)
   {
      // CF fix (research-only, Freeze v2): keep MAE/MFE/MaxDD fresh at Step>=4.
      // Tracking/export only — logging fix != strategy change; no trade impact.
      UpdateDrawdown(idx);
      double net_be_price = 0.0;
      double net_result_now = 0.0;
      double open_costs_signed = 0.0;
      double estimated_close_cost = 0.0;
      double swap_total = 0.0;
      double safety_buffer = 0.0;
      double total_volume = 0.0;
      int basket_positions = 0;
      if(!CalculateNetBasketBreakEven(idx,
                                      net_be_price,
                                      net_result_now,
                                      open_costs_signed,
                                      estimated_close_cost,
                                      swap_total,
                                      safety_buffer,
                                      basket_positions,
                                      total_volume))
         return; // fail closed: never close a deep basket on incomplete cost data
      MqlTick net_tick;
      if(!SymbolInfoTick(_Symbol, net_tick)) return;
      bool is_bull_net = g_setups[idx].is_bullish;
      double close_quote = is_bull_net ? net_tick.bid : net_tick.ask;
      bool price_reached = is_bull_net
         ? (close_quote >= net_be_price)
         : (close_quote <= net_be_price);
      if(price_reached && net_result_now >= 0.0)
      {
         Print("NET_BASKET_BE_TRIGGER|Setup=", g_setups[idx].setup_id,
               "|Step=", g_setups[idx].current_step,
               "|Positions=", basket_positions,
               "|Volume=", DoubleToString(total_volume, 2),
               "|BEPrice=", DoubleToString(net_be_price, _Digits),
               "|CloseQuote=", DoubleToString(close_quote, _Digits),
               "|ProjectedNet=", DoubleToString(net_result_now, 2),
               "|OpenCosts=", DoubleToString(open_costs_signed, 2),
               "|Swap=", DoubleToString(swap_total, 2),
               "|EstimatedCloseCost=", DoubleToString(estimated_close_cost, 2),
               "|SafetyBuffer=", DoubleToString(safety_buffer, 2));
         CloseSetupWithReason(idx, "NET_BASKET_BE");
      }
      return;
   }
   UpdateDrawdown(idx);
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return;
   double hi0 = iHigh(_Symbol, PERIOD_CURRENT, 0);
   double lo0 = iLow(_Symbol, PERIOD_CURRENT, 0);
   bool is_bull  = g_setups[idx].is_bullish;
   double atr_dist = g_setups[idx].atr_distance;
   UpdateTPTouchTracking(idx, hi0, lo0, atr_dist);
   // Priority 2 after the emergency dollar stop: Step 1-3 candle target.
   // LONG uses candle HIGH; SHORT uses candle LOW.
   if(ProcessNominalBasketTarget(idx, tk.bid, tk.ask, hi0, lo0))
      return;
   // Lower-priority legacy time exit remains available only when no nominal
   // target was touched on this tick. Step 4/5 returned through NET_BASKET_BE.
   if(inp_use_time_stop && g_setups[idx].created_time > 0)
   {
      int age_sec = (int)(TimeCurrent() - g_setups[idx].created_time);
      if(age_sec >= inp_time_stop_hours * 3600 &&
         floating_profit < inp_time_stop_profit_floor)
      {
         CloseSetupWithReason(idx, "TIME_STOP");
         return;
      }
   }
   // ---------- v9.2: ATR chandelier trailing after TP1 ----------
   // Research: fixed near-BE exits for deep ladders cap winners at ~0R;
   // a chandelier trail keeps the basket open while protecting the TP1 gain.
   // Target processing has already run above; trailing is a lower-priority
   // optional exit for Step 1-3 only.
   if(inp_exit_mode == EXIT_TP1_ATR_TRAIL && g_setups[idx].hit_tp1)
   {
      double atr_t = g_tf[0].GetBufferValue(g_tf[0].buffer_atr, 1);
      if(atr_t > 0.0)
      {
         if(!g_setups[idx].trail_armed)
         {
            g_setups[idx].trail_armed = true;
            g_setups[idx].trail_peak  = is_bull ? hi0 : lo0;
            UpdateEventPath(idx, "TRAIL_ARM");
         }
         if(is_bull)
         { if(hi0 > g_setups[idx].trail_peak) g_setups[idx].trail_peak = hi0; }
         else
         { if(lo0 < g_setups[idx].trail_peak) g_setups[idx].trail_peak = lo0; }
         double trail = is_bull
            ? (g_setups[idx].trail_peak - inp_trail_atr_mult * atr_t)
            : (g_setups[idx].trail_peak + inp_trail_atr_mult * atr_t);
         // BE lock: after TP1, worst case ~= basket break-even
         if(inp_trail_lock_be)
         {
            int cs = g_setups[idx].current_step;
            double be_lvl = (cs >= 2)
               ? g_setups[idx].break_even_levels[MathMin(cs - 2, 3)]
               : g_setups[idx].stop_levels[0];
            if(be_lvl > 0.0)
               trail = is_bull ? MathMax(trail, be_lvl) : MathMin(trail, be_lvl);
         }
         bool trail_hit = is_bull ? (tk.bid <= trail) : (tk.ask >= trail);
         if(trail_hit)
         {
            CloseSetupWithReason(idx, "TP1_ATR_TRAIL");
            return;
         }
      }
   }
   // =========================================================
   // DEEP_PROFIT_PROT — FIX: guard current_step >= 2
   // Old code: break_even_levels[current_step-2] crashed when
   // current_step == 1  (index = -1).
   // =========================================================
   int cur_step = g_setups[idx].current_step;
   if(g_setups[idx].max_step_reached >= 4
      && floating_profit > 0
      && cur_step >= 2)               // <-- FIX: require step >= 2
   {
      // break_even_levels[0] = BE after step-2 entry (weighted avg step1+step2)
      // break_even_levels[cur_step-2] is always valid when cur_step >= 2
      int be_idx = cur_step - 2;
      // Extra safety clamp
      if(be_idx < 0)  be_idx = 0;
      if(be_idx > 3)  be_idx = 3;
      double be_level = g_setups[idx].break_even_levels[be_idx];
      bool protect = is_bull
         ? (tk.bid < be_level + DEEP_PROFIT_BREAKEVEN_BUFFER * _Point)
         : (tk.ask > be_level - DEEP_PROFIT_BREAKEVEN_BUFFER * _Point);
      if(protect)
      {
         CloseSetupWithReason(idx, "DEEP_PROFIT_PROT");
         return;
      }
   }
}
string GetLastEventTokenFromPath(string path)
{
   path = NormalizeEventString(path);
   if(path == "") return "";
   int last_arrow = -1;
   int len = StringLen(path);
   for(int i = len - 2; i >= 0; i--)
   {
      if(StringSubstr(path, i, 2) == "->")
      {
         last_arrow = i;
         break;
      }
   }
   string last = (last_arrow >= 0) ? StringSubstr(path, last_arrow + 2) : path;
   return NormalizeEventToken(last);
}
// Helper: append final reason token to path if needed
string AppendFinalReasonToPath(string path, string reason)
{
   string p = NormalizeEventString(path);
   string r = NormalizeEventToken(reason);
   if(p == "")
      return NormalizeEventString(r);
   if(r == "")
      return p;
   string last = GetLastEventTokenFromPath(p);
   if(last == r) // already ends with same token
      return p;
   return NormalizeEventString(p + "->" + r);
}
void CloseSetupWithReason(int idx, string reason)
{
   if(idx < 0 || idx >= g_setup_cnt || !g_setups[idx].is_active) return;
   g_current_setup_id = g_setups[idx].setup_id;
   if(reason == "") reason = "BASKET_CLOSE";
   g_setups[idx].basket_close_pending = true;
   g_setups[idx].basket_close_reason = reason;
   string evt_str = AppendFinalReasonToPath(g_setups[idx].event_path, reason);
   // RX audit only: EXIT_REQUESTED is never a final label.
   RX_RecordExitRequested(idx, reason);
   if(CloseAllPositions(g_setups[idx].setup_id))
   {
      g_setups[idx].basket_close_pending = false;
      g_setups[idx].basket_close_reason = "";
      double realized = 0.0;
      for(int attempt = 0; attempt < 5; attempt++)
      {
         if(!MQLInfoInteger(MQL_TESTER)) Sleep(200 * (attempt + 1));
         realized = CalcHistProfit(g_setups[idx].setup_id, g_setups[idx].created_time);
         if(MathAbs(realized) > 0.0000001)
            break;
      }
      if(MathAbs(realized) < 0.0000001)
      {
         realized = CalcHistProfit(g_setups[idx].setup_id, g_setups[idx].created_time);
         if(MathAbs(realized) < 0.0000001)
         {
            Print("⚠ WARNING: CalcHistProfit returned 0 for Setup #",
                  g_setups[idx].setup_id,
                  " — profit may be inaccurate in exports");
         }
      }
      g_setups[idx].external_close_handled = true;
      g_profile_stats[(int)TestProfile].completed++;
      g_profile_stats[(int)TestProfile].total_pnl+=realized;
      if(OS_IsStopToken(OS_GetFinalToken(evt_str))) g_profile_stats[(int)TestProfile].stops++;
      if(g_setups[idx].max_step_reached>=4) g_profile_stats[(int)TestProfile].deep4plus++;
      g_stats[1]++;
      int step = g_setups[idx].current_step;
      if(step >= 1 && step <= 5) g_stats[step + 1]++;
      FinalizeSnapshot(idx, realized, evt_str);
      RecordAnalysis(g_setups[idx].max_step_reached, g_setups[idx].is_bullish, evt_str, realized);
      // v9.21: finalize position-open research records for this setup
      FinalizePositionOpenRecordsForSetup(idx, realized, evt_str);
      // RX final label is written only after EXIT_COMPLETED core finalization.
      RX_FinalizeSetup(idx, realized, evt_str, false, "", false);
      if(inp_export_on_close)
         ExportToExcel(g_setups[idx].is_bullish, evt_str, realized, step,
                       g_setups[idx].max_drawdown_money, g_setups[idx].max_drawdown_percent);
      SaveStats();
      // ============================
      // Stage 2D — collect forward record
      // For true-forward mode later
      // ============================
      if(g_s2b_compact_winner.trained)
         S2D_CollectForwardRecord(idx, realized, evt_str);
      DeleteBackups(g_setups[idx].setup_id);
      g_setups[idx].is_active = false;
   }
   else
   {
      // At least one position remains. Persist close-only mode and retry the
      // remaining basket on a later tick; never resume target/step processing.
      SaveSetupBackup(idx);
   }
}
// Helper: Update TP touch flags
void UpdateTPTouchTracking(int idx, double hi0, double lo0, double atr_dist)
{
   if(idx < 0 || idx >= g_setup_cnt) return;
   if(!g_setups[idx].is_active) return;
   bool is_bull = g_setups[idx].is_bullish;
   int max_step = g_setups[idx].max_step_reached;
   double dist12 = MathAbs(g_setups[idx].stop_levels[0] - g_setups[idx].stop_levels[1]);
   double half12 = dist12 / 2.0;
   double tp1 = is_bull
      ? (g_setups[idx].stop_levels[0] + dist12)
      : (g_setups[idx].stop_levels[0] - dist12);
   tp1 = NormalizeDouble(tp1, _Digits);
   double tp2 = is_bull
      ? (g_setups[idx].break_even_levels[0] + half12)
      : (g_setups[idx].break_even_levels[0] - half12);
   tp2 = NormalizeDouble(tp2, _Digits);
   bool tp1_touch = is_bull ? (hi0 >= tp1) : (lo0 <= tp1);
   bool tp2_touch = is_bull ? (hi0 >= tp2) : (lo0 <= tp2);
   if(tp1_touch && !g_setups[idx].hit_tp1)
   {
      g_setups[idx].hit_tp1 = true;
      UpdateEventPath(idx, "TP1");
      RX_RecordFirstTouch(idx, "TP1", tp1);
   }
   if(max_step >= 2 && tp2_touch && !g_setups[idx].hit_tp2)
   {
      g_setups[idx].hit_tp2 = true;
      UpdateEventPath(idx, "TP2");
      RX_RecordFirstTouch(idx, "TP2", tp2);
   }
   if(max_step >= 3)
   {
      double tp3 = is_bull
         ? (g_setups[idx].break_even_levels[1] + half12)
         : (g_setups[idx].break_even_levels[1] - half12);
      tp3 = NormalizeDouble(tp3, _Digits);
      bool tp3_touch = is_bull ? (hi0 >= tp3) : (lo0 <= tp3);
      if(tp3_touch && !g_setups[idx].hit_tp3)
      {
         g_setups[idx].hit_tp3 = true;
         UpdateEventPath(idx, "TP3");
         RX_RecordFirstTouch(idx, "TP3", tp3);
      }
   }
   // Step 4/5 have no execution TP touch state. They return earlier from
   // CheckTakeProfit() and are managed exclusively by NET_BASKET_BE.
   double ema200 = GetEMA200LiveMain();
   if(ema200 > 0)
   {
      bool ema_touch = is_bull ? (hi0 >= ema200) : (lo0 <= ema200);
      if(ema_touch && !g_setups[idx].hit_ema200)
      {
         g_setups[idx].hit_ema200 = true;
         UpdateEventPath(idx, "EMA");
         RX_RecordFirstTouch(idx, "EMA200", ema200);
      }
   }
}
// Helper: Calculate target for current step
void CalculateTargetForStep(int idx, int cur_step, int max_step, double atr_dist,
                            double bid, double ask, double hi0, double lo0,
                            double &target, string &target_type)
{
   bool is_bull  = g_setups[idx].is_bullish;
   bool is_above = g_setups[idx].is_above_ema200;
   // Deep baskets are handled before this function by NET_BASKET_BE.
   // Return no legacy target if this function is ever called for Step 4/5.
   if(cur_step >= 4)
   {
      target = 0.0;
      target_type = "NET_BASKET_BE";
      return;
   }
   bool is_counter_ema = (is_bull && !is_above) || (!is_bull && is_above);
   double ema200 = GetEMA200LiveMain();
   if(ema200 == 0) ema200 = g_setups[idx].ema200_at_entry;
   // ✅ OPTIONAL: فقط اگر input روشن باشد و معامله خلاف EMA200 باشد و فقط تا Step2
   if(inp_use_counter_ema200_target &&
      is_counter_ema &&
      max_step <= 2 &&
      g_setups[idx].use_ema200_as_target &&
      ema200 > 0)
   {
      target = NormalizeDouble(ema200, _Digits);
      target_type = "EMA200";
      return;
   }
   // ✅ وقتی OFF باشد یا شرط EMA200 برقرار نباشد:
   // Step1 => TP1 ، Step2 => TP2 ، ...
   double dist12 = MathAbs(g_setups[idx].stop_levels[0] - g_setups[idx].stop_levels[1]);
   double half12 = dist12 / 2.0;
   switch(cur_step)
   {
      case 1:
         target = is_bull ? (g_setups[idx].stop_levels[0] + dist12)
                          : (g_setups[idx].stop_levels[0] - dist12);
         target_type = "TP1";
         break;
      case 2:
         target = is_bull ? (g_setups[idx].break_even_levels[0] + half12)
                          : (g_setups[idx].break_even_levels[0] - half12);
         target_type = "TP2";
         break;
      case 3:
         target = is_bull ? (g_setups[idx].break_even_levels[1] + half12)
                          : (g_setups[idx].break_even_levels[1] - half12);
         target_type = "TP3";
         break;
      default:
         target = is_bull ? (g_setups[idx].stop_levels[0] + dist12)
                          : (g_setups[idx].stop_levels[0] - dist12);
         target_type = "TP1";
         break;
   }
   target = NormalizeDouble(target, _Digits);
}
void UpdateDrawdown(int idx)
{
   if(idx < 0 || idx >= g_setup_cnt || !g_setups[idx].is_active)
      return;
   string cf = BuildComment(g_setups[idx].setup_id);
   double profit = 0.0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(PositionGetSymbol(i) != _Symbol)
         continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number)
         continue;
      if(PositionGetString(POSITION_COMMENT) != cf)
         continue;
      profit += PositionGetDouble(POSITION_PROFIT)
              + PositionGetDouble(POSITION_SWAP);
   }
   // --- peak / trough tracking ---
   if(profit < g_setups[idx].lowest_profit)
      g_setups[idx].lowest_profit = profit;
   if(profit > g_setups[idx].peak_profit)
      g_setups[idx].peak_profit = profit;
   // --- MaxDrawdown از peak ---
   double dd = g_setups[idx].peak_profit - profit;
   if(profit < 0.0 && (-profit) > dd)
      dd = -profit;
   if(dd > g_setups[idx].max_drawdown_money)
   {
      g_setups[idx].max_drawdown_money = dd;
      if(g_setups[idx].entry_balance > 0.0)
         g_setups[idx].max_drawdown_percent =
            (dd / g_setups[idx].entry_balance) * 100.0;
   }
   // --- MFE: بیشترین floating profit که تا الان دیده‌ایم ---
   if(profit > g_setups[idx].mfe_money)
      g_setups[idx].mfe_money = profit;
   // --- MAE: بیشترین floating loss که تا الان دیده‌ایم ---
   // مثبت ذخیره می‌شود (magnitude)
   if(profit < 0.0 && (-profit) > g_setups[idx].mae_money)
      g_setups[idx].mae_money = -profit;
}
// Sync g_step[*].tp_status with setup event_path (for BuildStatsComment + Excel/HTML TPStatus)
void SyncTPStatusFromPath(int setup_idx)
{
   if(setup_idx < 0 || setup_idx >= g_setup_cnt) return;
   if(!g_setups[setup_idx].is_active) return;
   string path = g_setups[setup_idx].event_path;
   if(path == "") return;
   int cs = g_setups[setup_idx].current_step;
   if(cs < 1) cs = 1;
   if(cs > 5) cs = 5;
   for(int s = 0; s < cs; s++)
   {
      if(g_step[s].step_time != 0) // فقط اگر این استپ واقعاً ثبت شده
         g_step[s].tp_status = path;
   }
}
// ASCII upper (only a-z), safe across MQL5 builds
string ToUpperASCII(string s)
{
   int len = StringLen(s);
   for(int i = 0; i < len; i++)
   {
      ushort ch = (ushort)StringGetCharacter(s, i);
      if(ch >= 97 && ch <= 122) // 'a'..'z'
         StringSetCharacter(s, i, (ushort)(ch - 32)); // to 'A'..'Z'
   }
   return s;
}
// Normalize whole event string (also normalizes paths like TP1->TP2->TP1->EMA)
string NormalizeEventString(string evt)
{
   if(evt == "") return "";
   // path
   if(StringFind(evt, "->") >= 0)
   {
      string s = evt;
      StringReplace(s, "->", "|");
      string parts[];
      int n = StringSplit(s, '|', parts);
      if(n <= 0) return NormalizeEventToken(evt);
      string out = "";
      string last = "";
      for(int i = 0; i < n; i++)
      {
         string tok = NormalizeEventToken(parts[i]);
         if(tok == "") continue;
         if(tok == last) continue; // no consecutive duplicates
         if(out == "") out = tok;
         else out += "->" + tok;
         last = tok;
      }
      return out;
   }
   // single token
   return NormalizeEventToken(evt);
}
//|Update Event Path - Real-time tracker (normalized)|
void UpdateEventPath(int idx, string new_event)
{
   if(idx < 0 || idx >= g_setup_cnt) return;
   if(!g_setups[idx].is_active) return;
   new_event = NormalizeEventString(new_event);
   string path = g_setups[idx].event_path;
   path = NormalizeEventString(path);
   // آخرین ایونت مسیر را دربیاریم تا تکرار پشت سر هم نزنیم
   string last_event = "";
   int path_len = StringLen(path);
   if(path_len > 0)
   {
      int last_arrow = -1;
      for(int i = path_len - 2; i >= 0; i--)
      {
         if(StringSubstr(path, i, 2) == "->")
         {
            last_arrow = i;
            break;
         }
      }
      if(last_arrow >= 0) last_event = StringSubstr(path, last_arrow + 2);
      else                last_event = path;
      last_event = NormalizeEventString(last_event);
   }
   if(last_event == new_event) return;
   if(path == "") path = new_event;
   else           path += "->" + new_event;
   // نرمال‌سازی نهایی (اگر داخل رشته قبلاً TP4_TARGET بود)
   path = NormalizeEventString(path);
   g_setups[idx].event_path = path;
   // اگر قبلاً SyncTPStatusFromPath داری:
   SyncTPStatusFromPath(idx);
}
//|Check if opposite position opened during this setup|
bool CheckOppositeSignal(int idx)
{
   if(idx < 0 || idx >= g_setup_cnt) return false;
   if(!g_setups[idx].is_active) return false;
   bool is_bull  = g_setups[idx].is_bullish;
   int  max_step = g_setups[idx].max_step_reached;
   // فقط در پله ۱ یا ۲
   if(max_step >= 3) return false;
   string my_comment = BuildComment(g_setups[idx].setup_id);
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(PositionGetSymbol(i) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      string pos_comment = PositionGetString(POSITION_COMMENT);
      if(pos_comment == my_comment) continue; // پوزیشن خودمان
      ENUM_POSITION_TYPE pos_type =
         (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
      if(is_bull  && pos_type == POSITION_TYPE_SELL) return true;
      if(!is_bull && pos_type == POSITION_TYPE_BUY)  return true;
   }
   return false;
}
//|Build final event path string for Excel/HTML|
string BuildEventPath(int idx)
{
   if(idx < 0 || idx >= g_setup_cnt) return "";
   // اگر مسیر real-time ثبت شده، همان را برگردان
   if(g_setups[idx].event_path != "")
      return g_setups[idx].event_path;
   // فالبک: ساخت مسیر از فلگ‌ها
   bool is_bull    = g_setups[idx].is_bullish;
   bool h1         = g_setups[idx].hit_tp1;
   bool h2         = g_setups[idx].hit_tp2;
   bool h3         = g_setups[idx].hit_tp3;
   bool h4         = g_setups[idx].hit_tp4;
   bool h5         = g_setups[idx].hit_tp5;
   bool hema       = g_setups[idx].hit_ema200;
   int  max_step   = g_setups[idx].max_step_reached;
   bool ema_ok     = g_setups[idx].use_ema200_as_target && (max_step <= 2);
   string path = "";
   if(h1) { path = "TP1"; }
   if(max_step <= 2 && ema_ok && hema)
   {
      if(h2) path += (path==""?"":"->") + "TP2->EMA";
      else    path += (path==""?"EMA":"->EMA");
      return path;
   }
   if(h2) path += (path==""?"TP2":"->TP2");
   if(h3) path += (path==""?"TP3":"->TP3");
   if(h4) path += (path==""?"TP4":"->TP4");
   if(h5) path += (path==""?"TP5":"->TP5");
   return path;
}
bool PR_IsFinalStop(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsStopToken(ft);
}
bool PR_IsFinalTarget(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsTargetToken(ft);
}
ENUM_PATH_CLASS ClassifyPath(SEntrySnapshot &sn)
{
   bool is_stop   = PR_IsFinalStop(sn);
   bool is_target = PR_IsFinalTarget(sn);
   if(sn.actual_max_step <= 0)
      return PATH_UNKNOWN;
   if(sn.actual_max_step <= 2)
   {
      if(is_target) return PATH_SAFE_TARGET;
      if(is_stop)   return PATH_SAFE_STOP;
   }
   else if(sn.actual_max_step == 3)
   {
      if(is_target) return PATH_MID_TARGET;
      if(is_stop)   return PATH_MID_STOP;
   }
   else
   {
      if(is_target) return PATH_DEEP_TARGET;
      if(is_stop)   return PATH_DEEP_STOP;
   }
   return PATH_UNKNOWN;
}
string PathClassName(ENUM_PATH_CLASS pc)
{
   switch(pc)
   {
      case PATH_SAFE_TARGET: return "SAFE_TARGET";
      case PATH_SAFE_STOP:   return "SAFE_STOP";
      case PATH_MID_TARGET:  return "MID_TARGET";
      case PATH_MID_STOP:    return "MID_STOP";
      case PATH_DEEP_TARGET: return "DEEP_TARGET";
      case PATH_DEEP_STOP:   return "DEEP_STOP";
   }
   return "UNKNOWN";
}
bool ClosePositionSafe(ulong ticket)
{
   datetime now = TimeTradeServer();
   if(now == 0) now = TimeCurrent();
   if(g_trade_blocked_until > 0 && now < g_trade_blocked_until)
      return false;
   if(!IsMarketOpen()) return false;
   if(!PositionSelectByTicket(ticket)) return true;
   if(!CanSubmitPositionClose(ticket)) return false;
   // Exactly one broker close request per frozen ticket in this close cycle.
   // A failed ticket remains open and the active setup can retry on a later
   // tick; it is never submitted twice by the same CloseAllPositions() call.
   if(g_trade.PositionClose(ticket, inp_slippage_points))
      return true;
   uint code = g_trade.ResultRetcode();
   if(code == TRADE_RETCODE_MARKET_CLOSED)
   {
      g_trade_blocked_until = now + 120;
      static datetime last_msg = 0;
      if(TimeCurrent() - last_msg > 30)
      {
         Print("Close blocked: MARKET_CLOSED (cooldown 120s) | ticket#", ticket);
         last_msg = TimeCurrent();
      }
   }
   return false;
}
bool CloseAllPositions(int id)
{
   string cf = BuildComment(id);
   bool all_closed = true;
   if(!IsMarketOpen()) return false;
   // Freeze the complete basket membership before sending the first close.
   // MT5 exposes no atomic multi-ticket close request, so every frozen ticket
   // is submitted in this single function invocation without re-evaluating an
   // individual TP/BE condition between tickets.
   ulong basket_tickets[];
   int basket_count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0 || !PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) != cf) continue;
      ArrayResize(basket_tickets, basket_count + 1);
      basket_tickets[basket_count++] = ticket;
   }
   if(basket_count == 0) return false;
   for(int i = 0; i < basket_count; i++)
      if(!ClosePositionSafe(basket_tickets[i])) all_closed = false;
   // Do not finalize the setup unless every position in the frozen basket is
   // gone and no matching position remains.
   if(CountPositions(id) != 0) all_closed = false;
   return all_closed;
}
string GetCloseReason(int id, datetime from)
{
   string cf = BuildComment(id);
   if(!HistorySelect(from - 86400, TimeCurrent() + 60))
      return "CLOSED_UNKNOWN";
   int deals_total = HistoryDealsTotal();
   // مرحله ۱: پیدا کردن POSITION_IDها
   ulong pos_ids[];
   int pos_count = 0;
   for(int i = 0; i < deals_total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(StringFind(HistoryDealGetString(ticket, DEAL_COMMENT), cf) >= 0)
      {
         ulong pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
         if(pid == 0) continue;
         bool found = false;
         for(int p = 0; p < pos_count; p++)
            if(pos_ids[p] == pid) { found = true; break; }
         if(!found)
         {
            ArrayResize(pos_ids, pos_count + 1);
            pos_ids[pos_count++] = pid;
         }
      }
   }
   // مرحله ۲: آخرین close deal مربوط به این positionها
   string reason = "CLOSED_UNKNOWN";
   for(int i = deals_total - 1; i >= 0; i--)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      ENUM_DEAL_ENTRY entry = (ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY);
      if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY)
         continue;
      ulong deal_pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
      if(deal_pid == 0) continue;
      bool belongs = false;
      for(int p = 0; p < pos_count; p++)
         if(pos_ids[p] == deal_pid) { belongs = true; break; }
      if(!belongs) continue;
      ENUM_DEAL_REASON r = (ENUM_DEAL_REASON)HistoryDealGetInteger(ticket, DEAL_REASON);
      ArrayFree(pos_ids);
      switch(r)
      {
         case DEAL_REASON_SO:     return "STOP_OUT";
         case DEAL_REASON_SL:     return "SL";
         case DEAL_REASON_TP:     return "TAKE_PROFIT";
         case DEAL_REASON_EXPERT: return "CL_BY_EA";
         case DEAL_REASON_CLIENT: return "CL_MANUAL";
         default:                 return "CL_OTHER";
      }
   }
   ArrayFree(pos_ids);
   return reason;
}
string GetPersistentStateFile()
{
   //بهتر: نام فایل وابسته به نماد + مجیک
   return "PersistentState_" + g_symbol_name + "_" + IntegerToString((int)inp_magic_number) + ".bin";
}
//ذخیره long به صورت 2×int32 (lo/hi) => بدون هشدار و بدون از دست رفتن دیتا
void PS_WriteLong(int h, long v)
{
   ulong uv = (ulong)v;
   uint lo = (uint)(uv & 0xFFFFFFFF);
   uint hi = (uint)(uv >> 32);
   //FileWriteInteger در بیلد شما روی long هشدار می‌دهد، پس int می‌نویسیم
   FileWriteInteger(h, (int)lo);
   FileWriteInteger(h, (int)hi);
}
long PS_ReadLong(int h)
{
   //FileReadInteger ممکن است long برگرداند؛ با cast به uint بیت‌ها را حفظ می‌کنیم
   uint lo = (uint)(ulong)FileReadInteger(h);
   uint hi = (uint)(ulong)FileReadInteger(h);
   ulong uv = ((ulong)hi << 32)| (ulong)lo;
   return (long)uv;
}
void PS_WriteInt(int h, int v)   { PS_WriteLong(h, (long)v); }
int PS_ReadInt(int h)
{
   long v = PS_ReadLong(h);
   if(v > 2147483647L)  v = 2147483647L;
   if(v < -2147483648L) v = -2147483648L;
   return (int)v;
}
void PS_WriteBool(int h, bool v) { PS_WriteLong(h, v ? 1 : 0); }
bool PS_ReadBool(int h)          { return (PS_ReadLong(h) != 0); }
void PS_WriteDT(int h, datetime t) { PS_WriteLong(h, (long)t); }
datetime PS_ReadDT(int h)          { return (datetime)PS_ReadLong(h); }
void PS_WriteDouble(int h, double v) { FileWriteDouble(h, v); }
double PS_ReadDouble(int h)          { return FileReadDouble(h); }
//UTF-8 string in binary: [len][bytes]
bool PS_WriteStringUTF8(int h, const string s)
{
   uchar data[];
   int len = StringToCharArray(s, data, 0, WHOLE_ARRAY, CP_UTF8);
   if(len < 0) len = 0;
   int payload = (len > 0) ? (len - 1) : 0; //remove '\0'
   PS_WriteInt(h, payload);
   if(payload > 0)
      FileWriteArray(h, data, 0, payload);
   return true;
}
bool PS_ReadStringUTF8(int h, string &out)
{
   out = "";
   int payload = PS_ReadInt(h);
   if(payload <= 0) { out = ""; return true; }
   if(payload > 200000) return false; //corruption guard
   uchar data[];
   ArrayResize(data, payload);
   uint read = (uint)FileReadArray(h, data, 0, payload);
   if(read != (uint)payload) return false;
   out = CharArrayToString(data, 0, payload, CP_UTF8);
   return true;
}
//----------------- Base structs -----------------
void PS_SaveRangeData(int h, const SRangeData &d)
{
   PS_WriteInt(h, d.range_start);
   PS_WriteInt(h, d.range_end);
   PS_WriteInt(h, d.count);
   PS_WriteDouble(h, d.total_profit);
   PS_WriteInt(h, d.win_count);
   PS_WriteInt(h, d.loss_count);
}
bool PS_CanReadBytes(int h, int bytes_needed)
{
   long pos  = (long)FileTell(h);
   long size = (long)FileSize(h);
   if(pos < 0 || size < 0) return false;
   return (pos + bytes_needed <= size);
}
bool PS_LoadRangeData(int h, SRangeData &d)
{
   if(!PS_CanReadBytes(h, 48))
      return false;
   d.range_start  = PS_ReadInt(h);
   d.range_end    = PS_ReadInt(h);
   d.count        = PS_ReadInt(h);
   d.total_profit = PS_ReadDouble(h);
   d.win_count    = PS_ReadInt(h);
   d.loss_count   = PS_ReadInt(h);
   return true;
}
void PS_SaveEventData(int h, const SEventData &e)
{
   PS_WriteStringUTF8(h, e.event);
   PS_WriteInt(h, e.count);
   PS_WriteDouble(h, e.total_profit);
   PS_WriteInt(h, e.win_count);
}
bool PS_LoadEventData(int h, SEventData &e)
{
   if(!PS_ReadStringUTF8(h, e.event)) return false;
   e.count        = PS_ReadInt(h);
   e.total_profit = PS_ReadDouble(h);
   e.win_count    = PS_ReadInt(h);
   return true;
}
void PS_SaveDIStatusData(int h, const SDIStatusData &d)
{
   PS_WriteStringUTF8(h, d.status);
   PS_WriteInt(h, d.count);
   PS_WriteDouble(h, d.total_profit);
   PS_WriteInt(h, d.win_count);
}
bool PS_LoadDIStatusData(int h, SDIStatusData &d)
{
   if(!PS_ReadStringUTF8(h, d.status)) return false;
   d.count        = PS_ReadInt(h);
   d.total_profit = PS_ReadDouble(h);
   d.win_count    = PS_ReadInt(h);
   return true;
}
void PS_SavePatternData(int h, const SPatternData &p)
{
   PS_WriteStringUTF8(h, p.pattern);
   PS_WriteInt(h, p.count);
   PS_WriteDouble(h, p.total_profit);
   PS_WriteInt(h, p.win_count);
}
bool PS_LoadPatternData(int h, SPatternData &p)
{
   if(!PS_ReadStringUTF8(h, p.pattern)) return false;
   p.count        = PS_ReadInt(h);
   p.total_profit = PS_ReadDouble(h);
   p.win_count    = PS_ReadInt(h);
   return true;
}
void PS_SaveATRRangeData(int h, const SATRRangeData &a)
{
   PS_WriteDouble(h, a.range_start);
   PS_WriteDouble(h, a.range_end);
   PS_WriteInt(h, a.count);
   PS_WriteDouble(h, a.total_profit);
   PS_WriteInt(h, a.win_count);
}
bool PS_LoadATRRangeData(int h, SATRRangeData &a)
{
   // double,double,int,double,int => 40 bytes
   if(!PS_CanReadBytes(h, 40))
      return false;
   a.range_start  = PS_ReadDouble(h);
   a.range_end    = PS_ReadDouble(h);
   a.count        = PS_ReadInt(h);
   a.total_profit = PS_ReadDouble(h);
   a.win_count    = PS_ReadInt(h);
   return true;
}
void PS_SavePivotDistData(int h, const SPivotDistData &p)
{
   PS_WriteInt(h, p.dist);
   PS_WriteInt(h, p.count);
   PS_WriteDouble(h, p.total_profit);
   PS_WriteInt(h, p.win_count);
}
bool PS_LoadPivotDistData(int h, SPivotDistData &p)
{
   // int,int,double,int => 32 bytes
   if(!PS_CanReadBytes(h, 32))
      return false;
   p.dist         = PS_ReadInt(h);
   p.count        = PS_ReadInt(h);
   p.total_profit = PS_ReadDouble(h);
   p.win_count    = PS_ReadInt(h);
   return true;
}
//----------------- Indicator stats -----------------
void PS_SaveEMAStats(int h, const SEMAStats &s)
{
   PS_WriteInt(h, s.pattern_count);
   PS_WriteInt(h, s.position_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int pc = MathMin(s.pattern_count, 24);
   for(int i=0;i<pc;i++) PS_SavePatternData(h, s.patterns[i]);
   int posc = MathMin(s.position_count, 20);
   for(int i=0;i<posc;i++) PS_SavePatternData(h, s.positions[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadEMAStats(int h, SEMAStats &s)
{
   s.Reset();
   s.pattern_count  = PS_ReadInt(h);
   s.position_count = PS_ReadInt(h);
   s.event_count    = PS_ReadInt(h);
   s.total_trades   = PS_ReadInt(h);
   s.total_profit   = PS_ReadDouble(h);
   s.total_wins     = PS_ReadInt(h);
   s.total_losses   = PS_ReadInt(h);
   s.pattern_count  = MathMin(MathMax(s.pattern_count,0), 24);
   s.position_count = MathMin(MathMax(s.position_count,0), 20);
   s.event_count    = MathMin(MathMax(s.event_count,0), 20);
   for(int i=0;i<s.pattern_count;i++)  if(!PS_LoadPatternData(h, s.patterns[i])) return false;
   for(int i=0;i<s.position_count;i++) if(!PS_LoadPatternData(h, s.positions[i])) return false;
   for(int i=0;i<s.event_count;i++)    if(!PS_LoadEventData(h, s.events[i])) return false;
   s.is_sorted = false;
   return true;
}
void PS_SaveRSIStats(int h, const SRSIStats &s)
{
   PS_WriteInt(h, s.range_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int rc = MathMin(s.range_count, 25);
   for(int i=0;i<rc;i++) PS_SaveRangeData(h, s.ranges[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadRSIStats(int h, SRSIStats &s)
{
   s.Reset();
   s.range_count  = PS_ReadInt(h);
   s.event_count  = PS_ReadInt(h);
   s.total_trades = PS_ReadInt(h);
   s.total_profit = PS_ReadDouble(h);
   s.total_wins   = PS_ReadInt(h);
   s.total_losses = PS_ReadInt(h);
   s.range_count = MathMin(MathMax(s.range_count,0), 25);
   s.event_count = MathMin(MathMax(s.event_count,0), 20);
   for(int i=0;i<s.range_count;i++)
      if(!PS_LoadRangeData(h, s.ranges[i])) return false;
   for(int i=0;i<s.event_count;i++)
      if(!PS_LoadEventData(h, s.events[i])) return false;
   s.is_sorted = false;
   return true;
}
void PS_SaveADXStats(int h, const SADXDIStats &s)
{
   PS_WriteInt(h, s.adx_count);
   PS_WriteInt(h, s.di_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int ac = MathMin(s.adx_count, 25);
   for(int i=0;i<ac;i++) PS_SaveRangeData(h, s.adx_ranges[i]);
   int dc = MathMin(s.di_count, 5);
   for(int i=0;i<dc;i++) PS_SaveDIStatusData(h, s.di_status[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadADXStats(int h, SADXDIStats &s)
{
   s.Reset();
   s.adx_count    = PS_ReadInt(h);
   s.di_count     = PS_ReadInt(h);
   s.event_count  = PS_ReadInt(h);
   s.total_trades = PS_ReadInt(h);
   s.total_profit = PS_ReadDouble(h);
   s.total_wins   = PS_ReadInt(h);
   s.total_losses = PS_ReadInt(h);
   s.adx_count   = MathMin(MathMax(s.adx_count,0), 25);
   s.di_count    = MathMin(MathMax(s.di_count,0), 5);
   s.event_count = MathMin(MathMax(s.event_count,0), 20);
   for(int i=0;i<s.adx_count;i++)
      if(!PS_LoadRangeData(h, s.adx_ranges[i])) return false;
   for(int i=0;i<s.di_count;i++)
      if(!PS_LoadDIStatusData(h, s.di_status[i])) return false;
   for(int i=0;i<s.event_count;i++)
      if(!PS_LoadEventData(h, s.events[i])) return false;
   s.is_sorted = false;
   return true;
}
void PS_SaveCCIStats(int h, const SCCIStats &s)
{
   PS_WriteInt(h, s.range_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int rc = MathMin(s.range_count, 50);
   for(int i=0;i<rc;i++) PS_SaveRangeData(h, s.ranges[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadCCIStats(int h, SCCIStats &s)
{
