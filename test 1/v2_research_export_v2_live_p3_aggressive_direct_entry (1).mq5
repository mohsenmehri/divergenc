void WriteFlatSummaryTable(int h)
{
   int total_closed = 0;
   double total_profit = 0;
   int total_wins = 0;
   for(int i = 0; i < 5; i++)
   {
      total_closed += g_step_close_count[i];
      total_profit += g_step_close_profit[i];
      total_wins   += g_step_close_wins[i];
   }
   if(total_closed == 0)
   {
      FileWriteString(h, "<p>No data available.</p>\r\n");
      return;
   }
   string html = "<div class=\"section\">\r\n";
   html += "<h4>Overall Performance</h4>\r\n";
   html += "<table>\r\n";
   html += "<tr><th>Category</th><th>Trades</th><th>WinRate</th><th>Total Profit</th><th>Avg Profit/Trade</th></tr>\r\n";
   string cats[4] = {"SAFE (Step 1-2)", "MODERATE (Step 3)", "RISKY (Step 4-5)", "ALL CLOSED"};
   for(int cat = 0; cat < 4; cat++)
   {
      int cnt = 0;
      double prof = 0;
      int wins = 0;
      if(cat == 0)      { cnt = g_step_close_count[0]+g_step_close_count[1]; prof = g_step_close_profit[0]+g_step_close_profit[1]; wins = g_step_close_wins[0]+g_step_close_wins[1]; }
      else if(cat == 1) { cnt = g_step_close_count[2]; prof = g_step_close_profit[2]; wins = g_step_close_wins[2]; }
      else if(cat == 2) { cnt = g_step_close_count[3]+g_step_close_count[4]; prof = g_step_close_profit[3]+g_step_close_profit[4]; wins = g_step_close_wins[3]+g_step_close_wins[4]; }
      else              { cnt = total_closed; prof = total_profit; wins = total_wins; }
      double wr = (cnt > 0) ? (wins * 100.0 / cnt) : 0;
      double avg = (cnt > 0) ? (prof / cnt) : 0;
      html += "<tr><td><b>" + cats[cat] + "</b></td>";
      html += "<td>" + IntegerToString(cnt) + "</td>";
      html += "<td>" + DoubleToString(wr, 1) + "%</td>";
      html += "<td>" + DoubleToString(prof, 2) + "</td>";
      html += "<td>" + DoubleToString(avg, 2) + "</td></tr>\r\n";
   }
   html += "</table>\r\n";
   // Step distribution
   html += "<h4>Step Close Distribution</h4>\r\n<table>\r\n";
   html += "<tr><th>Step</th><th>Count</th><th>Profit</th><th>Wins</th><th>WR%</th></tr>\r\n";
   for(int s = 0; s < 5; s++)
   {
      int c = g_step_close_count[s];
      double p = g_step_close_profit[s];
      int w = g_step_close_wins[s];
      double wr = (c > 0) ? (w * 100.0 / c) : 0;
      html += "<tr><td>" + IntegerToString(s+1) + "</td>";
      html += "<td>" + IntegerToString(c) + "</td>";
      html += "<td>" + DoubleToString(p, 2) + "</td>";
      html += "<td>" + IntegerToString(w) + "</td>";
      html += "<td>" + DoubleToString(wr, 1) + "%</td></tr>\r\n";
   }
   html += "</table>\r\n</div>\r\n";
   FileWriteString(h, html);
}
void WriteDashboardOutcomesTabV1_Flat(int h)
{
   string html = "<h2>📌 Outcomes</h2>\r\n";
   FileWriteString(h, html);
   if(g_snapshot_count < 20)
   {
      FileWriteString(h, "<div class=\"section\"><p>Need >= 20 snapshots. Have: " +
                         IntegerToString(g_snapshot_count) + "</p></div>\r\n");
      return;
   }
   for(int cx = 0; cx < 3; cx++)
   {
      ENUM_OS_CONTEXT ctx = (ENUM_OS_CONTEXT)cx;
      string ctxName = OS_ContextName(ctx);
      SOSReportGroup gTargets, gStops, gStep1Target, gStep45, gEMA_Final, gDeepTP_NoEMA;
      gTargets.Reset("TARGET");
      gStops.Reset("STOP");
      gStep1Target.Reset("Step1+Target");
      gStep45.Reset("Step4/5");
      gEMA_Final.Reset("EMA Final");
      gDeepTP_NoEMA.Reset("Deep TP-touch no EMA");
      for(int i = 0; i < g_snapshot_count; i++)
      {
         if(!OS_ContextMatch(g_snapshots[i], ctx)) continue;
         if(DX_IsFinalStop(g_snapshots[i]))   gStops.Add(g_snapshots[i]);
         if(DX_IsFinalTarget(g_snapshots[i])) gTargets.Add(g_snapshots[i]);
         if(DX_IsStep1(g_snapshots[i]) && DX_IsFinalTarget(g_snapshots[i]))
            gStep1Target.Add(g_snapshots[i]);
         if(DX_IsStep45(g_snapshots[i]))
            gStep45.Add(g_snapshots[i]);
         if(DX_IsFinalEMA(g_snapshots[i]))
            gEMA_Final.Add(g_snapshots[i]);
         if(DX_IsDeepTPtouch_NoEMA(g_snapshots[i]))
            gDeepTP_NoEMA.Add(g_snapshots[i]);
      }
      gTargets.Finalize();
      gStops.Finalize();
      gStep1Target.Finalize();
      gStep45.Finalize();
      gEMA_Final.Finalize();
      gDeepTP_NoEMA.Finalize();
      html = "<div class=\"section\">\r\n<h3>" + ctxName + "</h3>\r\n";
      FileWriteString(h, html);
      // A) TARGET vs STOP
      FileWriteString(h, "<h4>A) TARGET vs STOP</h4>\r\n");
      OS_WriteTwoGroupReport(h, "TARGET vs STOP", gTargets, gStops);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: TARGET vs STOP", gTargets, gStops);
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:12px 0;\">\r\n");
      // B) Step1+Target vs Step4/5
      FileWriteString(h, "<h4>B) Step1+Target vs Step4/5</h4>\r\n");
      OS_WriteTwoGroupReport(h, "Step1+Target vs Step4/5", gStep1Target, gStep45);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: Step1Target vs Step4/5", gStep1Target, gStep45);
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:12px 0;\">\r\n");
      // C) EMA-final vs Deep TP-touch-no-EMA
      FileWriteString(h, "<h4>C) EMA-final vs Deep TP-touch-no-EMA</h4>\r\n");
      OS_WriteTwoGroupReport(h, "EMA-final vs Deep TP-touch-no-EMA", gEMA_Final, gDeepTP_NoEMA);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: EMA vs TP-touch-no-EMA", gEMA_Final, gDeepTP_NoEMA);
      FileWriteString(h, "</div>\r\n");
   }
}
void ExportAllAnalysis()
{
   if(!inp_enable_export)
      return;
   SortAllAnalysisData();
   Print("Exporting useful analysis files only...");
   SStepDistanceAnalysis step_analysis = AnalyzeStepDistances();
   if(!g_testing || g_visual)
      Print(step_analysis.GetReport());
   // ============================================================
   // MAIN OUTPUTS FOR YOUR CURRENT GOAL
   // ============================================================
   ExportPositionOpenDatasetCSV();
   ExportStep1OutcomeComparisonCSV();
   ExportStep1OutcomeComparisonSummaryCSV();
   ExportPositionOpenIndicatorStatsCSV();
   ExportPositionOpenSummaryReport();
   ExportAutoFilterSuggestionsCSV();
   ExportSignalRegistryCSV();
   ExportFeatureDistributionCSV();
   ExportFilterImpactCSV();
   if(g_risklab_count > 0)
   {
      RL_CalcDevCutoff();
      RL_ExportRaw();
      RL_ExportSummary();
      Print("Running Raw Feature Analysis...");
      RL_RunFullFeatureAnalysis();
      RL_ExportFeatureAnalysis();
      Print("Exporting Single Feature Leaderboard...");
      RL_ExportSingleFeatureLeaderboard();
      Print("Running Feature Importance...");
      RL_BuildFeatureImportanceMatrix();
      RL_ExportFeatureImportanceResults();
      Print("Running Threshold Validation...");
      RL_ExportThresholdValidation();
   }
   Print("Useful analysis exports completed.");
}
//|ANALYSIS HELPER FUNCTIONS|
string GetEvtClass(string e)
{
   // Normalize path like TP1->TP2->SL$ or TP1->EMA
   string path = NormalizeEventString(e);
   if(path == "")
      return "event-warn";
   // Extract last token from path
   string last = path;
   int len = StringLen(path);
   for(int i = len - 2; i >= 0; i--)
   {
      if(StringSubstr(path, i, 2) == "->")
      {
         last = StringSubstr(path, i + 2);
         break;
      }
   }
   last = NormalizeEventToken(last);
   string u = ToUpperASCII(last);
   // BAD outcomes (stop/loss)
   if(StringFind(u, "SL$") >= 0)   return "event-bad";
   if(StringFind(u, "SL") >= 0)    return "event-bad";
   if(StringFind(u, "STOP") >= 0)  return "event-bad";
   if(StringFind(u, "MARGIN") >= 0)return "event-bad";
   // GOOD outcomes (targets)
   if(StringFind(u, "EMA") >= 0)      return "event-good";
   if(StringFind(u, "TP") >= 0)       return "event-good";
   if(StringFind(u, "TARGET") >= 0)   return "event-good";
   if(StringFind(u, "TAKE") >= 0)     return "event-good";
   if(StringFind(u, "PROFIT") >= 0)   return "event-good";
   return "event-warn";
}
string GetPctClass(double pct) { return (pct >= 30) ? "pct-high" : (pct >= 15) ? "pct-mid" : "pct-low"; }
//|DOMINANCE ANALYZERS - v7.8|
SDominanceResult AnalyzeRSIDominance(bool is_buy, int tf, int step)
{
   SDominanceResult result;
   result.Reset();
   int total = is_buy ? g_rsi_buy[tf][step].total_trades : g_rsi_sell[tf][step].total_trades;
   int range_count = is_buy ? g_rsi_buy[tf][step].range_count : g_rsi_sell[tf][step].range_count;
   if(range_count < 1) return result;
   if(range_count == 1)
   {
      int rs = is_buy ? g_rsi_buy[tf][step].ranges[0].range_start : g_rsi_sell[tf][step].ranges[0].range_start;
      int cnt = is_buy ? g_rsi_buy[tf][step].ranges[0].count : g_rsi_sell[tf][step].ranges[0].count;
      result.Analyze(cnt, 0, total, "[" + IntegerToString(rs) + "-" + IntegerToString(rs+5) + "]", "");
      return result;
   }
   SSortedView sv;
   if(is_buy) sv.BuildFromRanges(g_rsi_buy[tf][step].ranges, range_count);
   else sv.BuildFromRanges(g_rsi_sell[tf][step].ranges, range_count);
   int idx1 = sv.Get(0);
   int idx2 = sv.Get(1);
   if(idx1 < 0) return result;
   int rs1 = is_buy ? g_rsi_buy[tf][step].ranges[idx1].range_start : g_rsi_sell[tf][step].ranges[idx1].range_start;
   int cnt1 = is_buy ? g_rsi_buy[tf][step].ranges[idx1].count : g_rsi_sell[tf][step].ranges[idx1].count;
   int rs2 = 0, cnt2 = 0;
   if(idx2 >= 0)
   {
      rs2 = is_buy ? g_rsi_buy[tf][step].ranges[idx2].range_start : g_rsi_sell[tf][step].ranges[idx2].range_start;
      cnt2 = is_buy ? g_rsi_buy[tf][step].ranges[idx2].count : g_rsi_sell[tf][step].ranges[idx2].count;
   }
   string val1 = "[" + IntegerToString(rs1) + "-" + IntegerToString(rs1+5) + "]";
   string val2 = (idx2 >= 0) ? "[" + IntegerToString(rs2) + "-" + IntegerToString(rs2+5) + "]" : "";
   result.Analyze(cnt1, cnt2, total, val1, val2);
   return result;
}
