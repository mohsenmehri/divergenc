      trend_regime = "";
      trend_regime_id = 0;
      adx_regime = "";
      adx_regime_id = 0;
      momentum_regime = "";
      momentum_regime_id = 0;
      dist_day_open_atr = 0.0;
      dist_day_high_atr = 0.0;
      dist_day_low_atr = 0.0;
      day_range_position = 0.0;
      dist_week_open_atr = 0.0;
      dist_week_high_atr = 0.0;
      dist_week_low_atr = 0.0;
      week_range_position = 0.0;
      nearest_round_level = 0.0;
      dist_round_level_atr = 0.0;
      adr5 = 0.0;
      adr20 = 0.0;
      today_range_pct_adr = 0.0;
      actual_max_step = 0;
      final_profit = 0.0;
      hit_tp1 = false;
      hit_tp2 = false;
      hit_ema200 = false;
      tp1_hit_time = 0;
      tp2_hit_time = 0;
      ema200_hit_time = 0;
      max_favorable_price = 0.0;
      reversal_price = 0.0;
      close_event = "";
      path_class = PATH_UNKNOWN;
      close_time = 0;
      mfe_points = 0.0;
      mae_points = 0.0;
      mfe_money = 0.0;
      mae_money = 0.0;
      max_dd_money = 0.0;
      max_dd_pct = 0.0;
      trade_duration_min = 0;
      predicted_step = 0;
      prediction_confidence = 0.0;
      recommended_target = "";
      ArrayInitialize(step_entry_times, 0);
      ArrayInitialize(step_entry_prices, 0.0);
   }
   ENUM_TRADE_GROUP GetGroup()
   {
      if(actual_max_step <= 2) return GROUP_SAFE;
      if(actual_max_step == 3) return GROUP_MODERATE;
      return GROUP_RISKY;
   }
   string GetGroupName()
   {
      switch(GetGroup())
      {
         case GROUP_SAFE:     return "SAFE";
         case GROUP_MODERATE: return "MODERATE";
         case GROUP_RISKY:    return "RISKY";
      }
      return "UNKNOWN";
   }
   bool IsSafe()  { return (actual_max_step <= 2); }
   bool IsRisky() { return (actual_max_step >= 4); }
   void CalculateDIAgreement()
   {
      di_agreement_count = 0;
      string expected = is_bullish ? "+" : "-";
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(di[tf] == expected)
            di_agreement_count++;
         di_gap[tf] = MathAbs(plus_di[tf] - minus_di[tf]);
      }
   }
   void CalculateEMACount()
   {
      ema_bullish_count = 0;
      string bull = "E20>E50>E100>E200";
      string bear = "E200>E100>E50>E20";
      string need = is_bullish ? bull : bear;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(ema_order[tf] == need)
            ema_bullish_count++;
      }
   }
   void CheckHTFConflict()
   {
      has_htf_conflict = false;
      string expected = is_bullish ? "+" : "-";
      string d1 = di[TF_IDX_H1];
      string d4 = di[TF_IDX_H4];
      bool v1 = (d1 == "+" || d1 == "-");
      bool v4 = (d4 == "+" || d4 == "-");
      if(!v1 || !v4)
         return;
      if(d1 != expected || d4 != expected)
         has_htf_conflict = true;
   }
   // RSI Gate State (4 fields) - Added for complete Step1 ML schema
   bool rsi_gate_enabled;
   int rsi_high_gate, rsi_low_gate;
   bool rsi_gate_passed;
};
//|RISKLAB RECORD — فقط برای Logging و Export|
struct SRiskLabRecord
{
   // === شناسه ===
   int      setup_id;
   string   signal;           // BUY / SELL
   datetime entry_time;
   int      entry_hour;
   int      entry_day;
   // === Outcome خام ===
   int      final_step;
   int      max_step_reached;
   int      num_martingale_steps;  // = max_step_reached - 1
   bool     stop_flag;        // SL / SL$ / STOP
   bool     target_flag;      // TP1..TP5 / EMA
   double   pnl;
   double   max_dd;
   double   max_dd_pct;
   string   final_event;
   // === Labels تحلیلی ===
   string   group3;           // SAFE / WARNING / DANGER
   bool     hit_step3_plus;
   bool     hit_step4_plus;
   bool     pnl_negative;
   // === Raw Features — per TF ===
   double   rsi[TF_COUNT];
   double   adx[TF_COUNT];
   double   cci[TF_COUNT];
   double   atr[TF_COUNT];
   double   atr_regime[TF_COUNT];
   double   adx_slope[TF_COUNT];
   double   ema_compression[TF_COUNT];
   double   ema200_dist[TF_COUNT];
   string   di[TF_COUNT];
   double   di_gap[TF_COUNT];
   string   ema_order[TF_COUNT];
   string   position[TF_COUNT];
   // === Raw Features — Global ===
   int      stability;
   int      di_agreement_count;
   int      ema_bullish_count;
   int      pivot1_dist;
   int      pivot2_dist;       // = PivotSpan
   int      pivot_gap_min;
   int      pivot_gap_max;
   double   ob_dist_pct;
   int      ob_in_tol;
   int      ob_age_bars;
   double   ob_width_atr;
   double   signal_clv;
   double   signal_body_ratio;
   // === Block Scores — فقط برای تحلیل، نه تصمیم ===
   int      block_direction;
   int      block_strength;
   int      block_signal_quality;
   int      block_location;
   int      total_score;       // 0..8
   // === Development / OOS ===
   bool     is_oos;
   void Reset()
   {
      setup_id = 0;
      signal = "";
      entry_time = 0;
      entry_hour = 0;
      entry_day = 0;
      final_step = 0;
      max_step_reached = 0;
      num_martingale_steps = 0;
      stop_flag = false;
      target_flag = false;
      pnl = 0.0;
      max_dd = 0.0;
      max_dd_pct = 0.0;
      final_event = "";
      group3 = "SAFE";
      hit_step3_plus = false;
      hit_step4_plus = false;
      pnl_negative = false;
      for(int i = 0; i < TF_COUNT; i++)
      {
         rsi[i] = 0.0;
         adx[i] = 0.0;
         cci[i] = 0.0;
         atr[i] = 0.0;
         atr_regime[i] = 0.0;
         adx_slope[i] = 0.0;
         ema_compression[i] = 0.0;
         ema200_dist[i] = 0.0;
         di[i] = "";
         di_gap[i] = 0.0;
         ema_order[i] = "";
         position[i] = "";
      }
      stability = 0;
      di_agreement_count = 0;
      ema_bullish_count = 0;
      pivot1_dist = 0;
      pivot2_dist = 0;
      pivot_gap_min = 0;
      pivot_gap_max = 0;
      ob_dist_pct = -1.0;
      ob_in_tol = 0;
      ob_age_bars = -1;
      ob_width_atr = 0.0;
      signal_clv = 0.0;
      signal_body_ratio = 0.0;
      block_direction = 0;
      block_strength = 0;
      block_signal_quality = 0;
      block_location = 0;
      total_score = 0;
      is_oos = false;
   }
};
