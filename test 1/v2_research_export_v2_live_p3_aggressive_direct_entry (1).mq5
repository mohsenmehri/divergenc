#define MATRIX_SIZE             500
#define MAX_SIGNALS             100
#define MAX_SETUPS              20
#define TF_COUNT                6
#define TF_IDX_MAIN             0
#define TF_IDX_M5               1
#define TF_IDX_M15              2
#define TF_IDX_M30              3
#define TF_IDX_H1               4
#define TF_IDX_H4               5
