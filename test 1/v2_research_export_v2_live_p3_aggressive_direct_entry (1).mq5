input double   inp_lot_for_tier_6   = 0.06;
input double   inp_lot_for_tier_7   = 0.07;
input group "=============== Order Block Settings ==============="
input int      inp_ob_lookback_periods   = 5;
input double   inp_ob_minimum_move_pct   = 0;
input bool     inp_ob_use_wicks          = false;
input int      inp_ob_min_same_direction = 4;
input bool     inp_ob_check_overlap      = false;
input group "=============== Confluence Settings ==============="
input bool     inp_require_ob_confluence = false;
input double   inp_confluence_tolerance_pct = 0.5;
input int      inp_max_ob_age_bars        = 500;
input group "=============== Stats Display ==============="
input bool     inp_show_stats_table = true;
input int      inp_stats_update_seconds = 2;
input group "=============== Multi-Timeframe Settings ==============="
input int      inp_mtf_minutes_1    = 5;
input int      inp_mtf_minutes_2    = 15;
input int      inp_mtf_minutes_3    = 30;
input int      inp_mtf_minutes_4    = 60;
input int      inp_mtf_minutes_5    = 240;
input group "=============== Export Settings ==============="
input bool     inp_enable_export         = false;
input string   inp_export_file_name      = "RUN_T0_BASELINE";
input bool     inp_export_on_signal      = false;
input bool     inp_export_on_close       = false;
// v9.21: dedicated switch for the position-open research dataset.
// Works WITHOUT inp_enable_export (which pulls in the heavy RL export chain).
input bool     inp_export_position_open_dataset = true;
input group "=============== Analysis / Shadow Tracking ==============="
input bool inp_enable_reject_tracking    = false;
input bool inp_enable_shadow_tracking    = false;
input bool inp_shadow_track_only_rejected = true;
input bool inp_enable_lifecycle_tracking = false;
input bool inp_export_reject_stats_csv   = false;
input group "=============== CSV Export ==============="
input bool     inp_enable_excel_export   = false;
input bool     inp_export_main_csv       = false;
input group "=============== HTML Export ==============="
input bool     inp_export_csv_pro_dashboard_html = false;
input bool     inp_export_dashboard_html = false;
input bool     inp_export_flat_dashboard_html = false;
input bool     inp_export_mtf_html       = false;
input group "=============== Language Settings ==============="
input bool     inp_use_persian_language = true;
input group "=============== Setup ID Management ==============="
input bool     inp_reset_setup_id = true;
input group "=============== Statistical Thresholds ==============="
input int      inp_min_sample_display   = 10;
input int      inp_min_sample_reliable  = 30;
input int      inp_min_sample_confident = 50;
input double   inp_dominance_gap        = 18.0;
input double   inp_dominance_min_pct    = 33.0;
input double   inp_polarized_sum        = 65.0;
input bool     inp_force_close_at_target = false;
input group "=============== Persistence / Resume ==============="
input bool  inp_enable_state_persistence = false;
input bool  inp_load_state_on_init       = false;
input bool  inp_autosave_state_on_close  = false;
input bool  inp_autosave_state_on_timer  = false;
input group "=============== Fast Backtest Mode ==============="
input bool  inp_fast_backtest_mode = true;
//========================================================
// Enums related to trade summary
//========================================================
enum ENUM_EMA_SLOPE
{
   SLOPE_STRONG_UP,
   SLOPE_WEAK_UP,
   SLOPE_FLAT,
   SLOPE_WEAK_DOWN,
   SLOPE_STRONG_DOWN
};
enum ENUM_PRICE_VS_EMA
{
   POS_ABOVE_FAR,
   POS_ABOVE_NEAR,
   POS_AT_EMA,
   POS_BELOW_NEAR,
   POS_BELOW_FAR
};
