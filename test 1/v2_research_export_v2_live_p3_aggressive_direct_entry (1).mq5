//========================================================
// Normalize Event Token
//========================================================
string NormalizeEventToken(string t)
{
   StringTrimLeft(t);
   StringTrimRight(t);
   if(t == "") return "";
   string u = ToUpperASCII(t);
   // v9.21: preserve v9.2 exit-engine tokens exactly (must run BEFORE the
   // generic rules: "TP1_ATR_TRAIL" contains "TP1", "TIME_STOP" contains "STOP")
   if(u == "TP1_ATR_TRAIL" || u == "TRAIL_ARM" ||
      u == "TIME_STOP"      || u == "EOT_OPEN")
      return u;
   // STOP / SL
   if(StringFind(u, "STOP") >= 0 || u == "SO" || StringFind(u, "MARGIN") >= 0)
      return "STOP";
   // SL_DOLLAR preserve
   if(StringFind(u, "SL_DOLLAR") >= 0 || StringFind(u, "SL_$") >= 0 || StringFind(u, "SL$") >= 0)
      return "SL$";
   // SL normal
   if(StringFind(u, "SL") >= 0)
      return "SL";
   // EMA
   if(StringFind(u, "EMA") >= 0)
      return "EMA";
   // TP exact
   if(StringFind(u, "TP1") >= 0) return "TP1";
   if(StringFind(u, "TP2") >= 0) return "TP2";
   if(StringFind(u, "TP3") >= 0) return "TP3";
   if(StringFind(u, "TP4") >= 0) return "TP4";
   if(StringFind(u, "TP5") >= 0) return "TP5";
   // Generic target/profit words
   if(StringFind(u, "TAKE_PROFIT") >= 0) return "TP";
   if(StringFind(u, "TARGET") >= 0)      return "TP";
   if(StringFind(u, "PROFIT") >= 0)      return "TP";
   return t;
}
//|DISTRIBUTION TYPE|
enum ENUM_DISTRIBUTION_TYPE
{
   DIST_DOMINANT,
   DIST_POLARIZED,
   DIST_MIXED,
   DIST_LOW_SAMPLE,
   DIST_NO_DATA
};
//|MTF AGREEMENT TYPE|
enum ENUM_MTF_AGREEMENT
{
   MTF_STRONG_AGREE,
   MTF_PARTIAL_AGREE,
   MTF_NEUTRAL,
   MTF_PARTIAL_CONFLICT,
   MTF_STRONG_CONFLICT,
   MTF_NO_DATA
};
//|STATISTICAL SIGNIFICANCE|
enum ENUM_STAT_SIGNIFICANCE
{
   SIG_INSUFFICIENT,
   SIG_WEAK,
   SIG_MODERATE,
   SIG_GOOD,
   SIG_STRONG
};
//|Get Statistical Significance Level|
ENUM_STAT_SIGNIFICANCE GetStatSignificance(int sample_count)
{
   if(sample_count < 15)  return SIG_INSUFFICIENT;
   if(sample_count < 30)  return SIG_WEAK;
   if(sample_count < 60)  return SIG_MODERATE;
   if(sample_count < 100) return SIG_GOOD;
   return SIG_STRONG;
}
//|Get Significance Badge|
string GetSignificanceBadge(int sample_count)
{
   switch(GetStatSignificance(sample_count))
   {
      case SIG_INSUFFICIENT: return "🚫";
      case SIG_WEAK:         return "⚠️";
      case SIG_MODERATE:     return "📊";
      case SIG_GOOD:         return "✅";
      case SIG_STRONG:       return "💪";
   }
   return "❓";
}
//|Get Significance CSS Class|
string GetSignificanceClass(int sample_count)
{
   switch(GetStatSignificance(sample_count))
   {
      case SIG_INSUFFICIENT: return "sig-insufficient";
      case SIG_WEAK:         return "sig-weak";
      case SIG_MODERATE:     return "sig-moderate";
      case SIG_GOOD:         return "sig-good";
      case SIG_STRONG:       return "sig-strong";
   }
   return "";
}
//|Get Significance Text|
string GetSignificanceText(int sample_count)
{
   switch(GetStatSignificance(sample_count))
   {
      case SIG_INSUFFICIENT: return "Not Reliable";
      case SIG_WEAK:         return "Low Confidence";
      case SIG_MODERATE:     return "Moderate";
      case SIG_GOOD:         return "Good";
      case SIG_STRONG:       return "High Confidence";
   }
   return "Unknown";
}
//|Calculate Pattern Score for Ranking|
double CalculatePatternScore(int count, int win_count, double total_profit)
{
   if(count < 5)
      return -999999.0;
   double expectancy = total_profit / (double)count;
   double win_rate   = (double)win_count / (double)count;
   double wr_factor  = (win_rate > 0.001) ? (win_rate / 0.5) : 0.001;
   double sample_factor = MathLog((double)count + 1.0);
   if(sample_factor < 0.1)
      sample_factor = 0.1;
   return expectancy * wr_factor * sample_factor;
}
