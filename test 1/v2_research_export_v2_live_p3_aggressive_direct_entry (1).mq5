//SATRStats
void PS_SaveATRStats(int h, const SATRStats &s)
{
   PS_WriteInt(h, s.range_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.min_atr);
   PS_WriteDouble(h, s.max_atr);
   PS_WriteDouble(h, s.sum_atr);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int rc = MathMin(s.range_count, 30);
   for(int i=0;i<rc;i++) PS_SaveATRRangeData(h, s.ranges[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadATRStats(int h, SATRStats &s)
{
   s.Reset();
   s.range_count  = PS_ReadInt(h);
   s.event_count  = PS_ReadInt(h);
   s.total_trades = PS_ReadInt(h);
   s.min_atr = PS_ReadDouble(h);
   s.max_atr = PS_ReadDouble(h);
   s.sum_atr = PS_ReadDouble(h);
   s.total_profit = PS_ReadDouble(h);
   s.total_wins   = PS_ReadInt(h);
   s.total_losses = PS_ReadInt(h);
   s.range_count = MathMin(MathMax(s.range_count,0), 30);
   s.event_count = MathMin(MathMax(s.event_count,0), 20);
   for(int i=0;i<s.range_count;i++)
      if(!PS_LoadATRRangeData(h, s.ranges[i])) return false;
   for(int i=0;i<s.event_count;i++)
      if(!PS_LoadEventData(h, s.events[i])) return false;
   s.is_sorted = false;
   return true;
}
//SPivotDistStats
void PS_SavePivotDistStats(int h, const SPivotDistStats &s)
{
   PS_WriteInt(h, s.p1_count);
   PS_WriteInt(h, s.p2_count);
   PS_WriteInt(h, s.event_count);
   PS_WriteInt(h, s.total_trades);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteInt(h, s.total_losses);
   int c1 = MathMin(s.p1_count, 50);
   for(int i=0;i<c1;i++) PS_SavePivotDistData(h, s.pivot1[i]);
   int c2 = MathMin(s.p2_count, 50);
   for(int i=0;i<c2;i++) PS_SavePivotDistData(h, s.pivot2[i]);
   int ec = MathMin(s.event_count, 20);
   for(int i=0;i<ec;i++) PS_SaveEventData(h, s.events[i]);
}
bool PS_LoadPivotDistStats(int h, SPivotDistStats &s)
{
   s.Reset();
   s.p1_count     = PS_ReadInt(h);
   s.p2_count     = PS_ReadInt(h);
   s.event_count  = PS_ReadInt(h);
   s.total_trades = PS_ReadInt(h);
   s.total_profit = PS_ReadDouble(h);
   s.total_wins   = PS_ReadInt(h);
   s.total_losses = PS_ReadInt(h);
   s.p1_count    = MathMin(MathMax(s.p1_count,0), 50);
   s.p2_count    = MathMin(MathMax(s.p2_count,0), 50);
   s.event_count = MathMin(MathMax(s.event_count,0), 20);
   for(int i=0;i<s.p1_count;i++)
      if(!PS_LoadPivotDistData(h, s.pivot1[i])) return false;
   for(int i=0;i<s.p2_count;i++)
      if(!PS_LoadPivotDistData(h, s.pivot2[i])) return false;
   for(int i=0;i<s.event_count;i++)
      if(!PS_LoadEventData(h, s.events[i])) return false;
   s.is_sorted = false;
   return true;
}
//SEarlyTPStats
void PS_SaveEarlyTPStats(int h, const SEarlyTPStats &s)
{
   PS_WriteInt(h, s.total_cases);
   PS_WriteInt(h, s.buy_cases);
   PS_WriteInt(h, s.sell_cases);
   PS_WriteDouble(h, s.sum_rsi);
   PS_WriteDouble(h, s.sum_adx);
   PS_WriteDouble(h, s.sum_cci);
   PS_WriteDouble(h, s.sum_atr);
   PS_WriteInt(h, s.rsi_above_70);
   PS_WriteInt(h, s.rsi_above_65);
   PS_WriteInt(h, s.rsi_below_30);
   PS_WriteInt(h, s.rsi_below_35);
   PS_WriteInt(h, s.adx_below_20);
   PS_WriteInt(h, s.adx_below_25);
   PS_WriteInt(h, s.adx_above_30);
   PS_WriteInt(h, s.di_wrong_direction);
   PS_WriteInt(h, s.mtf_conflict);
   PS_WriteDouble(h, s.total_final_profit);
   PS_WriteDouble(h, s.total_potential_profit);
   PS_WriteInt(h, s.win_count);
   PS_WriteInt(h, s.loss_count);
   PS_WriteInt(h, s.reached_step3);
   PS_WriteInt(h, s.reached_step4);
   PS_WriteInt(h, s.reached_step5);
}
void PS_LoadEarlyTPStats(int h, SEarlyTPStats &s)
{
   s.Reset();
   s.total_cases = PS_ReadInt(h);
   s.buy_cases   = PS_ReadInt(h);
   s.sell_cases  = PS_ReadInt(h);
   s.sum_rsi = PS_ReadDouble(h);
   s.sum_adx = PS_ReadDouble(h);
   s.sum_cci = PS_ReadDouble(h);
   s.sum_atr = PS_ReadDouble(h);
   s.rsi_above_70 = PS_ReadInt(h);
   s.rsi_above_65 = PS_ReadInt(h);
   s.rsi_below_30 = PS_ReadInt(h);
   s.rsi_below_35 = PS_ReadInt(h);
   s.adx_below_20 = PS_ReadInt(h);
   s.adx_below_25 = PS_ReadInt(h);
   s.adx_above_30 = PS_ReadInt(h);
   s.di_wrong_direction = PS_ReadInt(h);
   s.mtf_conflict       = PS_ReadInt(h);
   s.total_final_profit     = PS_ReadDouble(h);
   s.total_potential_profit = PS_ReadDouble(h);
   s.win_count  = PS_ReadInt(h);
   s.loss_count = PS_ReadInt(h);
   s.reached_step3 = PS_ReadInt(h);
   s.reached_step4 = PS_ReadInt(h);
   s.reached_step5 = PS_ReadInt(h);
}
//----------------- MTF serialization (FULL) -----------------
void PS_SaveEnhancedStability(int h, const SEnhancedStability &s)
{
   PS_WriteInt(h, s.rsi_alignment);
   PS_WriteInt(h, s.di_consistency);
   PS_WriteInt(h, s.ema_order_match);
   PS_WriteInt(h, s.trend_strength);
   PS_WriteInt(h, s.penalty_total);
   PS_WriteStringUTF8(h, s.penalty_reasons);
   PS_WriteBool(h, s.has_killer_flaw);
   PS_WriteInt(h, s.raw_score);
   PS_WriteInt(h, s.final_score);
   PS_WriteInt(h, s.score_cap);
}
bool PS_LoadEnhancedStability(int h, SEnhancedStability &s)
{
   s.Reset();
   s.rsi_alignment   = PS_ReadInt(h);
   s.di_consistency  = PS_ReadInt(h);
   s.ema_order_match = PS_ReadInt(h);
   s.trend_strength  = PS_ReadInt(h);
   s.penalty_total = PS_ReadInt(h);
   if(!PS_ReadStringUTF8(h, s.penalty_reasons)) return false;
   s.has_killer_flaw = PS_ReadBool(h);
   s.raw_score   = PS_ReadInt(h);
   s.final_score = PS_ReadInt(h);
   s.score_cap   = PS_ReadInt(h);
   return true;
}
void PS_SaveMTFPattern(int h, const SMTFPattern &p)
{
   PS_WriteInt(h, p.pattern_id);
   PS_WriteDT(h, p.entry_time);
   PS_WriteDT(h, p.exit_time);
   PS_WriteBool(h, p.is_bullish);
   PS_WriteInt(h, p.max_step_reached);
   PS_WriteDouble(h, p.profit);
   PS_WriteBool(h, p.is_win);
   PS_WriteStringUTF8(h, p.close_event);
   for(int i=0;i<TF_COUNT;i++) PS_WriteInt(h, p.rsi_range[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteInt(h, p.adx_range[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteInt(h, p.cci_range[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteDouble(h, p.atr_value[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteStringUTF8(h, p.di_status[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteStringUTF8(h, p.ema_order[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteStringUTF8(h, p.position_status[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteDouble(h, p.plus_di_value[i]);
   for(int i=0;i<TF_COUNT;i++) PS_WriteDouble(h, p.minus_di_value[i]);
   PS_WriteInt(h, p.pivot1_dist);
   PS_WriteInt(h, p.pivot2_dist);
   PS_SaveEnhancedStability(h, p.stability);
   PS_WriteStringUTF8(h, p.composite_signature);
   PS_WriteStringUTF8(h, p.rsi_signature);
   PS_WriteStringUTF8(h, p.di_signature);
}
bool PS_LoadMTFPattern(int h, SMTFPattern &p)
{
   p.Reset();
   p.pattern_id = PS_ReadInt(h);
   p.entry_time = PS_ReadDT(h);
   p.exit_time  = PS_ReadDT(h);
   p.is_bullish = PS_ReadBool(h);
   p.max_step_reached = PS_ReadInt(h);
   p.profit = PS_ReadDouble(h);
   p.is_win = PS_ReadBool(h);
   if(!PS_ReadStringUTF8(h, p.close_event)) return false;
   for(int i=0;i<TF_COUNT;i++) p.rsi_range[i] = PS_ReadInt(h);
   for(int i=0;i<TF_COUNT;i++) p.adx_range[i] = PS_ReadInt(h);
   for(int i=0;i<TF_COUNT;i++) p.cci_range[i] = PS_ReadInt(h);
   for(int i=0;i<TF_COUNT;i++) p.atr_value[i] = PS_ReadDouble(h);
   for(int i=0;i<TF_COUNT;i++) if(!PS_ReadStringUTF8(h, p.di_status[i])) return false;
   for(int i=0;i<TF_COUNT;i++) if(!PS_ReadStringUTF8(h, p.ema_order[i])) return false;
   for(int i=0;i<TF_COUNT;i++) if(!PS_ReadStringUTF8(h, p.position_status[i])) return false;
   for(int i=0;i<TF_COUNT;i++) p.plus_di_value[i]  = PS_ReadDouble(h);
   for(int i=0;i<TF_COUNT;i++) p.minus_di_value[i] = PS_ReadDouble(h);
   p.pivot1_dist = PS_ReadInt(h);
   p.pivot2_dist = PS_ReadInt(h);
   if(!PS_LoadEnhancedStability(h, p.stability)) return false;
   if(!PS_ReadStringUTF8(h, p.composite_signature)) return false;
   if(!PS_ReadStringUTF8(h, p.rsi_signature)) return false;
   if(!PS_ReadStringUTF8(h, p.di_signature)) return false;
   return true;
}
void PS_SaveMTFSignature(int h, const SMTFSignatureStats &s)
{
   PS_WriteStringUTF8(h, s.signature);
   PS_WriteInt(h, s.total_count);
   for(int i=0;i<5;i++) PS_WriteInt(h, s.step_counts[i]);
   for(int i=0;i<5;i++) PS_WriteDouble(h, s.step_profits[i]);
   for(int i=0;i<5;i++) PS_WriteInt(h, s.step_wins[i]);
   PS_WriteDouble(h, s.total_profit);
   PS_WriteInt(h, s.total_wins);
   PS_WriteDouble(h, s.entropy_score);
   PS_WriteDouble(h, s.reliability_score);
}
bool PS_LoadMTFSignature(int h, SMTFSignatureStats &s)
{
   s.Reset();
   if(!PS_ReadStringUTF8(h, s.signature)) return false;
   s.total_count = PS_ReadInt(h);
   for(int i=0;i<5;i++) s.step_counts[i] = PS_ReadInt(h);
   for(int i=0;i<5;i++) s.step_profits[i] = PS_ReadDouble(h);
   for(int i=0;i<5;i++) s.step_wins[i] = PS_ReadInt(h);
   s.total_profit = PS_ReadDouble(h);
   s.total_wins = PS_ReadInt(h);
   s.entropy_score = PS_ReadDouble(h);
   s.reliability_score = PS_ReadDouble(h);
   return true;
}
void PS_SaveMTFRule(int h, const SMTFDecisionRule &r)
{
   PS_WriteStringUTF8(h, r.name);
   PS_WriteStringUTF8(h, r.condition);
   PS_WriteInt(h, r.trades_matching);
   PS_WriteInt(h, r.trades_not_matching);
   PS_WriteDouble(h, r.wr_matching);
   PS_WriteDouble(h, r.wr_not_matching);
   PS_WriteDouble(h, r.avg_step_matching);
   PS_WriteDouble(h, r.avg_step_not_matching);
   PS_WriteDouble(h, r.profit_matching);
   PS_WriteDouble(h, r.profit_not_matching);
   PS_WriteDouble(h, r.impact_score);
}
bool PS_LoadMTFRule(int h, SMTFDecisionRule &r)
{
   r.Reset();
   if(!PS_ReadStringUTF8(h, r.name)) return false;
   if(!PS_ReadStringUTF8(h, r.condition)) return false;
   r.trades_matching     = PS_ReadInt(h);
   r.trades_not_matching = PS_ReadInt(h);
   r.wr_matching         = PS_ReadDouble(h);
   r.wr_not_matching     = PS_ReadDouble(h);
   r.avg_step_matching   = PS_ReadDouble(h);
   r.avg_step_not_matching = PS_ReadDouble(h);
   r.profit_matching     = PS_ReadDouble(h);
   r.profit_not_matching = PS_ReadDouble(h);
   r.impact_score        = PS_ReadDouble(h);
   return true;
}
void PS_SaveMTFAnalysisStats(int h, const SMTFAnalysisStats &a)
{
   PS_WriteInt(h, a.pattern_count);
   int pc = MathMin(a.pattern_count, MAX_MTF_PATTERNS);
   for(int i=0;i<pc;i++) PS_SaveMTFPattern(h, a.patterns[i]);
   PS_WriteInt(h, a.rsi_sig_count);
   int rsc = MathMin(a.rsi_sig_count, MAX_SIGNATURES);
   for(int i=0;i<rsc;i++) PS_SaveMTFSignature(h, a.rsi_signatures[i]);
   PS_WriteInt(h, a.di_sig_count);
   int dsc = MathMin(a.di_sig_count, MAX_SIGNATURES);
   for(int i=0;i<dsc;i++) PS_SaveMTFSignature(h, a.di_signatures[i]);
   PS_WriteInt(h, a.composite_sig_count);
   int csc = MathMin(a.composite_sig_count, MAX_SIGNATURES);
   for(int i=0;i<csc;i++) PS_SaveMTFSignature(h, a.composite_signatures[i]);
   for(int i=0;i<11;i++) PS_WriteInt(h, a.stability_distribution[i]);
   for(int i=0;i<11;i++) PS_WriteDouble(h, a.stability_profits[i]);
   for(int i=0;i<11;i++) PS_WriteInt(h, a.stability_wins[i]);
   for(int i=0;i<11;i++) PS_WriteInt(h, a.stability_step_sum[i]);
   PS_WriteInt(h, a.rule_count);
   int rc = MathMin(a.rule_count, 10);
   for(int i=0;i<rc;i++) PS_SaveMTFRule(h, a.rules[i]);
}
bool PS_LoadMTFAnalysisStats(int h, SMTFAnalysisStats &a)
{
   a.Reset();
   a.pattern_count = PS_ReadInt(h);
   if(a.pattern_count < 0) a.pattern_count = 0;
   if(a.pattern_count > MAX_MTF_PATTERNS) a.pattern_count = MAX_MTF_PATTERNS;
   for(int i=0;i<a.pattern_count;i++)
      if(!PS_LoadMTFPattern(h, a.patterns[i])) return false;
   a.rsi_sig_count = PS_ReadInt(h);
   if(a.rsi_sig_count < 0) a.rsi_sig_count = 0;
   if(a.rsi_sig_count > MAX_SIGNATURES) a.rsi_sig_count = MAX_SIGNATURES;
   for(int i=0;i<a.rsi_sig_count;i++)
      if(!PS_LoadMTFSignature(h, a.rsi_signatures[i])) return false;
   a.di_sig_count = PS_ReadInt(h);
   if(a.di_sig_count < 0) a.di_sig_count = 0;
   if(a.di_sig_count > MAX_SIGNATURES) a.di_sig_count = MAX_SIGNATURES;
   for(int i=0;i<a.di_sig_count;i++)
      if(!PS_LoadMTFSignature(h, a.di_signatures[i])) return false;
   a.composite_sig_count = PS_ReadInt(h);
   if(a.composite_sig_count < 0) a.composite_sig_count = 0;
   if(a.composite_sig_count > MAX_SIGNATURES) a.composite_sig_count = MAX_SIGNATURES;
   for(int i=0;i<a.composite_sig_count;i++)
      if(!PS_LoadMTFSignature(h, a.composite_signatures[i])) return false;
   for(int i=0;i<11;i++) a.stability_distribution[i] = PS_ReadInt(h);
   for(int i=0;i<11;i++) a.stability_profits[i] = PS_ReadDouble(h);
   for(int i=0;i<11;i++) a.stability_wins[i] = PS_ReadInt(h);
   for(int i=0;i<11;i++) a.stability_step_sum[i] = PS_ReadInt(h);
   a.rule_count = PS_ReadInt(h);
   if(a.rule_count < 0) a.rule_count = 0;
   if(a.rule_count > 10) a.rule_count = 10;
   for(int i=0;i<a.rule_count;i++)
      if(!PS_LoadMTFRule(h, a.rules[i])) return false;
   return true;
}
bool PS_SaveSnapshot(int h, const SEntrySnapshot &s)
{
   PS_WriteInt(h, s.setup_id);
   PS_WriteDT(h, s.entry_time);
   PS_WriteInt(h, s.entry_hour);
   PS_WriteInt(h, s.entry_day_of_week);
   PS_WriteBool(h, s.is_bullish);
   PS_WriteInt(h, s.pivot1_dist);
   PS_WriteInt(h, s.pivot2_dist);
   PS_WriteDouble(h, s.pivot1_rsi);
   PS_WriteDouble(h, s.pivot2_rsi);
   // NEW: Divergence Quality Features
   PS_WriteDouble(h, s.price_div_strength);
   PS_WriteDouble(h, s.rsi_div_strength);
   PS_WriteDouble(h, s.div_price_slope);
   PS_WriteDouble(h, s.div_rsi_slope);
   PS_WriteInt(h, s.div_span_bars);
   PS_WriteDouble(h, s.pivot_symmetry);
   PS_WriteInt(h, s.time_since_p3);
   PS_WriteDouble(h, s.pivot_rsi_p1);
   PS_WriteDouble(h, s.pivot_rsi_p2);
   PS_WriteDouble(h, s.pivot_rsi_p3);
   PS_WriteDouble(h, s.price_p1_to_p2_chg);
   PS_WriteDouble(h, s.price_p2_to_p3_chg);
   PS_WriteDouble(h, s.price_leg_ratio);
   PS_WriteDouble(h, s.rsi_p1_to_p2_delta);
   PS_WriteDouble(h, s.rsi_p2_to_p3_delta);
   PS_WriteDouble(h, s.rsi_acceleration);
   PS_WriteDouble(h, s.divergence_angle);
   // NEW: pivot gaps & OB precision
   PS_WriteInt(h, s.piv_gap_min);
   PS_WriteInt(h, s.piv_gap_max);
   PS_WriteDouble(h, s.ob_dist_pct);
   PS_WriteInt(h, s.ob_in_tol);
   for(int i=0;i<TF_COUNT;i++)
   {
      PS_WriteDouble(h, s.rsi[i]);
      PS_WriteDouble(h, s.adx[i]);
      PS_WriteDouble(h, s.cci[i]);
      PS_WriteDouble(h, s.atr[i]);
      PS_WriteStringUTF8(h, s.di[i]);
      PS_WriteStringUTF8(h, s.ema_order[i]);
      PS_WriteStringUTF8(h, s.position[i]);
      PS_WriteDouble(h, s.ema200_dist[i]);
      PS_WriteDouble(h, s.plus_di[i]);
      PS_WriteDouble(h, s.minus_di[i]);
      PS_WriteDouble(h, s.di_gap[i]);
      PS_WriteDouble(h, s.atr_regime[i]);
      PS_WriteDouble(h, s.adx_slope[i]);
      PS_WriteDouble(h, s.ema_compression[i]);
   }
   PS_WriteDouble(h, s.signal_clv);
   PS_WriteDouble(h, s.signal_body_ratio);
   PS_WriteInt(h, s.ob_age_bars);
   PS_WriteDouble(h, s.ob_width_atr);
   PS_WriteInt(h, s.stability_score);
   PS_WriteBool(h, s.has_htf_conflict);
   PS_WriteInt(h, s.di_agreement_count);
   PS_WriteInt(h, s.ema_bullish_count);
   PS_WriteInt(h, s.actual_max_step);
   PS_WriteDouble(h, s.final_profit);
   PS_WriteBool(h, s.hit_tp1);
   PS_WriteBool(h, s.hit_tp2);
   PS_WriteBool(h, s.hit_ema200);
   PS_WriteDT(h, s.tp1_hit_time);
   PS_WriteDT(h, s.tp2_hit_time);
   PS_WriteDT(h, s.ema200_hit_time);
   PS_WriteDouble(h, s.max_favorable_price);
   PS_WriteDouble(h, s.reversal_price);
   PS_WriteStringUTF8(h, s.close_event);
   PS_WriteInt(h, s.predicted_step);
   PS_WriteDouble(h, s.prediction_confidence);
   PS_WriteStringUTF8(h, s.recommended_target);
   // lifecycle fields
   PS_WriteDT(h, s.close_time);
   PS_WriteDouble(h, s.mfe_points);
   PS_WriteDouble(h, s.mae_points);
   PS_WriteDouble(h, s.mfe_money);
   PS_WriteDouble(h, s.mae_money);
   PS_WriteDouble(h, s.max_dd_money);
   PS_WriteDouble(h, s.max_dd_pct);
   // NEW: step timestamps and prices
   for(int i=0;i<5;i++) PS_WriteDT(h, s.step_entry_times[i]);
   for(int i=0;i<5;i++) PS_WriteDouble(h, s.step_entry_prices[i]);
   return true;
}
bool PS_LoadSnapshot(int h, SEntrySnapshot &s)
{
   s.Reset();
   s.setup_id = PS_ReadInt(h);
   s.entry_time = PS_ReadDT(h);
   s.entry_hour = PS_ReadInt(h);
   s.entry_day_of_week = PS_ReadInt(h);
   s.is_bullish = PS_ReadBool(h);
   s.pivot1_dist = PS_ReadInt(h);
   s.pivot2_dist = PS_ReadInt(h);
   s.pivot1_rsi = PS_ReadDouble(h);
   s.pivot2_rsi = PS_ReadDouble(h);
   // NEW: Divergence Quality Features
   s.price_div_strength  = PS_ReadDouble(h);
   s.rsi_div_strength    = PS_ReadDouble(h);
   s.div_price_slope     = PS_ReadDouble(h);
   s.div_rsi_slope       = PS_ReadDouble(h);
   s.div_span_bars       = PS_ReadInt(h);
   s.pivot_symmetry      = PS_ReadDouble(h);
   s.time_since_p3       = PS_ReadInt(h);
   s.pivot_rsi_p1        = PS_ReadDouble(h);
   s.pivot_rsi_p2        = PS_ReadDouble(h);
   s.pivot_rsi_p3        = PS_ReadDouble(h);
   s.price_p1_to_p2_chg  = PS_ReadDouble(h);
   s.price_p2_to_p3_chg  = PS_ReadDouble(h);
   s.price_leg_ratio     = PS_ReadDouble(h);
   s.rsi_p1_to_p2_delta  = PS_ReadDouble(h);
   s.rsi_p2_to_p3_delta  = PS_ReadDouble(h);
   s.rsi_acceleration    = PS_ReadDouble(h);
   s.divergence_angle    = PS_ReadDouble(h);
   // NEW: pivot gaps & OB precision
   s.piv_gap_min = PS_ReadInt(h);
   s.piv_gap_max = PS_ReadInt(h);
   s.ob_dist_pct = PS_ReadDouble(h);
   s.ob_in_tol   = PS_ReadInt(h);
   for(int i=0;i<TF_COUNT;i++)
   {
      s.rsi[i] = PS_ReadDouble(h);
      s.adx[i] = PS_ReadDouble(h);
      s.cci[i] = PS_ReadDouble(h);
      s.atr[i] = PS_ReadDouble(h);
      if(!PS_ReadStringUTF8(h, s.di[i])) return false;
      if(!PS_ReadStringUTF8(h, s.ema_order[i])) return false;
      if(!PS_ReadStringUTF8(h, s.position[i])) return false;
      s.ema200_dist[i] = PS_ReadDouble(h);
      s.plus_di[i]  = PS_ReadDouble(h);
      s.minus_di[i] = PS_ReadDouble(h);
      s.di_gap[i]   = PS_ReadDouble(h);
      s.atr_regime[i] = PS_ReadDouble(h);
      s.adx_slope[i] = PS_ReadDouble(h);
      s.ema_compression[i] = PS_ReadDouble(h);
   }
   s.signal_clv = PS_ReadDouble(h);
   s.signal_body_ratio = PS_ReadDouble(h);
   s.ob_age_bars = PS_ReadInt(h);
   s.ob_width_atr = PS_ReadDouble(h);
   s.stability_score = PS_ReadInt(h);
   s.has_htf_conflict = PS_ReadBool(h);
   s.di_agreement_count = PS_ReadInt(h);
   s.ema_bullish_count = PS_ReadInt(h);
   s.actual_max_step = PS_ReadInt(h);
   s.final_profit = PS_ReadDouble(h);
   s.hit_tp1 = PS_ReadBool(h);
   s.hit_tp2 = PS_ReadBool(h);
   s.hit_ema200 = PS_ReadBool(h);
   s.tp1_hit_time = PS_ReadDT(h);
   s.tp2_hit_time = PS_ReadDT(h);
   s.ema200_hit_time = PS_ReadDT(h);
   s.max_favorable_price = PS_ReadDouble(h);
   s.reversal_price = PS_ReadDouble(h);
   if(!PS_ReadStringUTF8(h, s.close_event)) return false;
   s.predicted_step = PS_ReadInt(h);
   s.prediction_confidence = PS_ReadDouble(h);
   if(!PS_ReadStringUTF8(h, s.recommended_target)) return false;
   // lifecycle fields
   s.close_time   = PS_ReadDT(h);
   s.mfe_points   = PS_ReadDouble(h);
   s.mae_points   = PS_ReadDouble(h);
   s.mfe_money    = PS_ReadDouble(h);
   s.mae_money    = PS_ReadDouble(h);
   s.max_dd_money = PS_ReadDouble(h);
   s.max_dd_pct   = PS_ReadDouble(h);
   // NEW: step timestamps and prices
   for(int i=0;i<5;i++) s.step_entry_times[i]  = PS_ReadDT(h);
   for(int i=0;i<5;i++) s.step_entry_prices[i] = PS_ReadDouble(h);
   return true;
}
//----------------- Main Save/Load -----------------
void DeletePersistentState()
{
   string fn = GetPersistentStateFile();
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
}
bool SavePersistentState()
{
   if(!inp_enable_state_persistence) return true;
   string fn = GetPersistentStateFile();
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE| FILE_BIN| FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot write state file: ", fn);
      return false;
   }
   PS_WriteLong(h, PSTATE_MAGIC);
   PS_WriteLong(h, PSTATE_VERSION);
   //Core
   PS_WriteInt(h, g_row_cnt);
   PS_WriteInt(h, g_html_row_cnt);
   PS_WriteInt(h, g_next_setup_id);
   for(int i=0;i<7;i++) PS_WriteInt(h, g_stats[i]);
   //Step tracking arrays
   for(int s=0;s<5;s++)
   {
      PS_WriteInt(h, g_step_entries[s]);
      PS_WriteInt(h, g_step_survivals[s]);
      PS_WriteDouble(h, g_step_profits[s]);
      PS_WriteInt(h, g_step_wins[s]);
      PS_WriteInt(h, g_step_close_count[s]);
      PS_WriteDouble(h, g_step_close_profit[s]);
      PS_WriteInt(h, g_step_close_wins[s]);
      PS_WriteInt(h, g_step_reach_count[s]);
      PS_WriteDouble(h, g_step_cumulative_profit[s]);
      PS_WriteInt(h, g_step_cumulative_wins[s]);
   }
   //Indicator stats
   for(int tf=0; tf<TF_COUNT; tf++)
   {
      for(int st=0; st<5; st++)
      {
         PS_SaveEMAStats(h, g_ema_buy[tf][st]);
         PS_SaveEMAStats(h, g_ema_sell[tf][st]);
         PS_SaveRSIStats(h, g_rsi_buy[tf][st]);
         PS_SaveRSIStats(h, g_rsi_sell[tf][st]);
         PS_SaveADXStats(h, g_adx_buy[tf][st]);
         PS_SaveADXStats(h, g_adx_sell[tf][st]);
         PS_SaveCCIStats(h, g_cci_buy[tf][st]);
         PS_SaveCCIStats(h, g_cci_sell[tf][st]);
         PS_SaveATRStats(h, g_atr_buy[tf][st]);
         PS_SaveATRStats(h, g_atr_sell[tf][st]);
      }
   }
   for(int st=0; st<5; st++)
   {
      PS_SavePivotDistStats(h, g_pivdist_buy[st]);
      PS_SavePivotDistStats(h, g_pivdist_sell[st]);
   }
   //Early TP
   PS_SaveEarlyTPStats(h, g_early_tp_buy);
   PS_SaveEarlyTPStats(h, g_early_tp_sell);
   //✅ MTF (FULL)
   PS_SaveMTFAnalysisStats(h, g_mtf_buy);
   PS_SaveMTFAnalysisStats(h, g_mtf_sell);
   //Snapshots
   int sc = MathMin(g_snapshot_count, MAX_SNAPSHOTS);
   PS_WriteInt(h, sc);
   for(int i=0;i<sc;i++)
      PS_SaveSnapshot(h, g_snapshots[i]);
   FileClose(h);
   return true;
}
bool LoadPersistentState()
{
   if(!inp_enable_state_persistence)
      return false;
   string fn = GetPersistentStateFile();
   if(!FileIsExist(fn, FILE_COMMON))
      return false;
   int h = FileOpen(fn, FILE_READ | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
      return false;
   bool ok = true;
   long magic = PS_ReadLong(h);
   long ver   = PS_ReadLong(h);
   if(magic != PSTATE_MAGIC || ver != PSTATE_VERSION)
   {
      FileClose(h);
      if(magic != PSTATE_MAGIC)
      {
         Print("WARNING: State file has wrong magic number.",
               " Expected=", PSTATE_MAGIC, " Got=", magic,
               " → File is corrupt or belongs to different EA.",
               " Deleting and starting fresh.");
      }
      else
      {
         Print("WARNING: State file version mismatch.",
               " Expected v", PSTATE_VERSION, " but found v", ver, ".",
               " Old snapshot format detected — cannot load.",
               " Deleting state file and rebuilding from CSV.");
      }
      DeletePersistentState();
      return false;
   }
   g_row_cnt       = PS_ReadInt(h);
   g_html_row_cnt  = PS_ReadInt(h);
   g_next_setup_id = PS_ReadInt(h);
   for(int i = 0; i < 7; i++) g_stats[i] = PS_ReadInt(h);
   for(int s = 0; s < 5; s++)
   {
      g_step_entries[s]   = PS_ReadInt(h);
      g_step_survivals[s] = PS_ReadInt(h);
      g_step_profits[s]   = PS_ReadDouble(h);
      g_step_wins[s]      = PS_ReadInt(h);
      g_step_close_count[s]  = PS_ReadInt(h);
      g_step_close_profit[s] = PS_ReadDouble(h);
      g_step_close_wins[s]   = PS_ReadInt(h);
      g_step_reach_count[s]       = PS_ReadInt(h);
      g_step_cumulative_profit[s] = PS_ReadDouble(h);
      g_step_cumulative_wins[s]   = PS_ReadInt(h);
   }
   for(int tf = 0; tf < TF_COUNT && ok; tf++)
   {
      for(int st = 0; st < 5 && ok; st++)
      {
         if(!PS_LoadEMAStats(h, g_ema_buy[tf][st]))  ok = false;
         if(!PS_LoadEMAStats(h, g_ema_sell[tf][st])) ok = false;
         if(!PS_LoadRSIStats(h, g_rsi_buy[tf][st]))  ok = false;
         if(!PS_LoadRSIStats(h, g_rsi_sell[tf][st])) ok = false;
         if(!PS_LoadADXStats(h, g_adx_buy[tf][st]))  ok = false;
         if(!PS_LoadADXStats(h, g_adx_sell[tf][st])) ok = false;
         if(!PS_LoadCCIStats(h, g_cci_buy[tf][st]))  ok = false;
         if(!PS_LoadCCIStats(h, g_cci_sell[tf][st])) ok = false;
         if(!PS_LoadATRStats(h, g_atr_buy[tf][st]))  ok = false;
         if(!PS_LoadATRStats(h, g_atr_sell[tf][st])) ok = false;
      }
   }
   for(int st = 0; st < 5 && ok; st++)
   {
      if(!PS_LoadPivotDistStats(h, g_pivdist_buy[st]))  ok = false;
      if(!PS_LoadPivotDistStats(h, g_pivdist_sell[st])) ok = false;
   }
   if(ok)
   {
      PS_LoadEarlyTPStats(h, g_early_tp_buy);
      PS_LoadEarlyTPStats(h, g_early_tp_sell);
   }
   if(ok)
   {
      if(!PS_LoadMTFAnalysisStats(h, g_mtf_buy))  ok = false;
      if(!PS_LoadMTFAnalysisStats(h, g_mtf_sell)) ok = false;
   }
   if(ok)
   {
      g_snapshot_count = PS_ReadInt(h);
      if(g_snapshot_count < 0)            g_snapshot_count = 0;
      if(g_snapshot_count > MAX_SNAPSHOTS) g_snapshot_count = MAX_SNAPSHOTS;
      if(g_snapshot_count > ArraySize(g_snapshots))
      {
         if(ArrayResize(g_snapshots, g_snapshot_count) < 0)
            ok = false;
      }
      for(int i = 0; i < g_snapshot_count && ok; i++)
      {
         if(!PS_LoadSnapshot(h, g_snapshots[i]))
            ok = false;
      }
      // Rebuild lookup map after loading all snapshots
      if(ok)
      {
         SnapMap_Rebuild();
         g_snap_map_dirty = false;
      }
   }
   FileClose(h);
   if(!ok)
   {
      Print("WARNING: Persistent state corrupted → deleted and restarting fresh.");
      DeletePersistentState();
      // Reset map on corruption
      g_snap_map_count = 0;
      g_snap_map_dirty = true;
      ArrayFree(g_snap_map_ids);
      ArrayFree(g_snap_map_idx);
      return false;
   }
   CalculateGroupStats();
   return true;
}
int OnInit()
{
   // FIX-D1 (audit 2026-09-04): make DIV3 signal-mode semantics explicit at startup.
   if(inp_div3_signal_mode == DIV3_LIVE_P3_ONLY)
      Print("WARNING|DIV3_LIVE_P3_ONLY is DISPLAY-ONLY: the confirmed stream is disabled inside CheckDivergence() and live arms are never consumable - this mode opens NO trades.");
   else if(inp_div3_signal_mode == DIV3_DUAL_MODE)
      Print("NOTE|DIV3_DUAL_MODE trades ONLY the confirmed stream; live display arms never open positions.");
   g_symbol_name = _Symbol;
   g_lang = GetLanguageStrings();
   g_testing = MQLInfoInteger(MQL_TESTER);
   g_visual  = MQLInfoInteger(MQL_VISUAL_MODE);
   g_fast_mode_active = (g_testing && !g_visual && inp_fast_backtest_mode);
   g_armed_divergence.Reset();
   for(int p=0;p<4;p++) g_profile_stats[p].Reset();
   ME_Initialize();
   if(g_fast_mode_active)
      Print("⚡ FAST BACKTEST MODE ACTIVE — Full export only at end of test");
   if(!ValidateInputs())
   {
      Alert("ERROR: Invalid parameters!");
      return INIT_PARAMETERS_INCORRECT;
   }
   if(!DIV3_SpanShadowValidateResearchConfig()) return INIT_PARAMETERS_INCORRECT;
   if(!DIV3_Recovery50FinalHandoffValidate()) return INIT_PARAMETERS_INCORRECT;
   Print("DIV3_RECOVERY50_FINAL|INIT|HandoffId=",RECOVERY50_FINAL_HANDOFF_ID,
         "|CandidateLockId=",RECOVERY50_SOURCE_CANDIDATE_LOCK_ID,
         "|ExecutionPolicy=STEP4_5_NET_BASKET_BE|Recovery50Orders=DISABLED|ResearchShadowOnly=YES|DateGuard=NONE|EvidenceScope=XAUUSD_o_M1_DEV2018_2023");
   GetPivotParams(inp_pivot_type, g_pivot_left, g_pivot_right);
   Print("DIV3_INIT|Version=",DIV3_ENGINE_VERSION,
         "|Engine=",EnumToString(inp_div3_pivot_engine),
         "|PivotType=",EnumToString(inp_pivot_type),
         "|Source=",EnumToString(inp_pivot_source),
         "|BaseLeft=",g_pivot_left,"|BaseRight=",g_pivot_right,
         "|ExtraLeft=",inp_div3_extra_left_bars,"|ExtraRight=",inp_div3_extra_right_bars,
         "|PromATR=",DoubleToString(inp_div3_min_prominence_atr,3),
         "|ExcursionATR=",DoubleToString(inp_div3_min_same_side_excursion_atr,3),
         "|RSIAlignment=",EnumToString(inp_div3_rsi_alignment),
         "|RSITolerance=",inp_div3_rsi_alignment_tolerance,
         "|RSITurn=",(inp_div3_require_rsi_turn ? "1" : "0"),
         "|ThreePivotMode=",(inp_rsi_relaxed_3pivot ? "RELAXED" : "STRICT"),
         "|SignalMode=",EnumToString(inp_div3_signal_mode),
         "|ConfirmedStream=NON_REPAINT|LiveP3Stream=FORMING_REPAINT_ALLOWED");
   DIV3_AuditInitialize();
   DIV3_SpanShadowInitialize();
   //Initialize Main TF first
   g_tf[0].Initialize(PERIOD_CURRENT, TFToStr(PERIOD_CURRENT), BUFFER_COPY_SIZE);
   if(!g_tf[0].CreateIndicatorHandles(_Symbol, inp_rsi_period, inp_atr_period, inp_adx_period, inp_cci_period))
   {
      LogError("Failed to create indicator handles");
      return INIT_FAILED;
   }
   g_profile_m1_atr_handle=iATR(_Symbol,PERIOD_M1,inp_atr_period);
   if(TestProfile==PROFILE_D_FULL && g_profile_m1_atr_handle==INVALID_HANDLE)
   {
      LogError("Profile D requires a valid M1 ATR handle");
      return INIT_FAILED;
   }
   Print("PROFILE_INIT|Selected=",TestProfileName(TestProfile));
   //Initialize MTF
   int mtf[] = {inp_mtf_minutes_1, inp_mtf_minutes_2, inp_mtf_minutes_3, inp_mtf_minutes_4, inp_mtf_minutes_5};
   for(int i = 1; i < TF_COUNT; i++)
   {
      ENUM_TIMEFRAMES tf = MinToTF(mtf[i - 1]);
      g_tf[i].Initialize(tf, TFToStr(tf), 100);
      g_tf[i].CreateIndicatorHandles(_Symbol, inp_rsi_period, inp_atr_period, inp_adx_period, inp_cci_period);
      g_tf[i].CopyIndicatorBuffers(100);
      CalculateVARSI(g_tf[i], 100);
   }
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only)
   {
      if(ArrayResize(g_pivots,MATRIX_SIZE)<0) { Print("DIV3_SPAN_SHADOW|INIT_ERROR|PivotAllocationFailed"); return INIT_FAILED; }
      for(int i=0;i<MATRIX_SIZE;i++) g_pivots[i].Reset();
      for(int i=0;i<3;i++) { g_bull_pivots[i].Reset(); g_bear_pivots[i].Reset(); }
      g_pivot_idx=0; g_bull_piv_cnt=0; g_bear_piv_cnt=0; g_last_pivot_check=0;
      g_div3_span_shadow_runtime_ready=true;
      Print("DIV3_STEP5_RECOVERY50_EXECSHADOW|RESEARCH_MINIMAL_INIT|PASS|LegacyStatsLoad=SKIPPED|Persistence=SKIPPED|ResearchFramework=SKIPPED|Orders=BLOCKED|OnlyOutputs=PAIRED_CSV_SUMMARY");
      return INIT_SUCCEEDED;
   }
   //Load stats
   LoadStats();
   LoadStatsFromCSV();
   LoadHTMLRowCounter();
   //Setup ID management
   if(!inp_reset_setup_id)
   {
      int saved = LoadSetupID();
      if(saved > g_next_setup_id) g_next_setup_id = saved;
   }
   else
   {
      g_next_setup_id = 1;
      g_row_cnt = g_html_row_cnt = 0;
      for(int i = 0; i < 7; i++) g_stats[i] = 0;
      SaveSetupID(1);
      SaveStats();
   }
   //Validate lot tiers
   if(inp_balance_tier_2 <= inp_balance_tier_1 ||
      inp_balance_tier_3 <= inp_balance_tier_2 ||
      inp_balance_tier_4 <= inp_balance_tier_3 ||
      inp_balance_tier_5 <= inp_balance_tier_4 ||
      inp_balance_tier_6 <= inp_balance_tier_5 ||
      inp_balance_tier_7 <= inp_balance_tier_6)
   {
      Alert("Error: Balance tiers must be ascending!");
      return INIT_PARAMETERS_INCORRECT;
   }
   //Allocate arrays
   bool alloc_ok = true;
   if(ArrayResize(g_pivots, MATRIX_SIZE) < 0)                          alloc_ok = false;
   if(ArrayResize(g_signals, MAX_SIGNALS) < 0)                         alloc_ok = false;
   if(ArrayResize(g_setups, MAX_SETUPS) < 0)                           alloc_ok = false;
   if(ArrayResize(g_shadow_signals, 500) < 0)                          alloc_ok = false;
   if(ArrayResize(g_op_entries, MAX_OP_ENTRIES) < 0)                   alloc_ok = false;
   if(ArrayResize(g_snapshots, 500) < 0)                               alloc_ok = false;
   if(ArrayResize(g_recorded_ids, 200) < 0)                            alloc_ok = false;
   if(ArrayResize(g_risklab_records, 500) < 0)                         alloc_ok = false;
   if(ArrayResize(g_sens_best_results, MAX_SENS_RESULTS) < 0)          alloc_ok = false;
   if(ArrayResize(g_combo_results, MAX_COMBO_RESULTS) < 0)             alloc_ok = false;
   if(ArrayResize(g_sens_threshold_rows, MAX_SENS_THRESHOLD_ROWS) < 0) alloc_ok = false;
   if(ArrayResize(g_sens_stat_thresholds, MAX_SELECTED_THRESHOLDS) < 0) alloc_ok = false;
   if(ArrayResize(g_sens_exec_thresholds, MAX_SELECTED_THRESHOLDS) < 0) alloc_ok = false;
   if(!alloc_ok)
   {
      Alert("CRITICAL: Memory allocation failed!");
      return INIT_FAILED;
   }
   // Reset counters
   g_snapshot_count = 0;
   g_recorded_count = 0;
   g_risklab_count = 0;
   g_shadow_count = 0;
   g_next_shadow_id = 1;
   g_next_research_protocol_id = 1;
   g_active_shadow_count = 0;
   ArrayFree(g_active_shadow_indices);
   g_total_shadow_accepted = 0;
   g_total_shadow_rejected = 0;
   ArrayInitialize(g_reject_filter_counts, 0);
   g_reject_combo_count = 0;
   for(int i = 0; i < MAX_REJECT_COMBOS; i++)
      g_reject_combo_stats[i].Reset();
   g_risklab_header_written = false;
   g_risklab_dev_cutoff = 0;
   g_op_entry_count = 0;
   g_sens_threshold_row_count = 0;
   g_sens_stat_threshold_count = 0;
   g_sens_exec_threshold_count = 0;
   for(int i = 0; i < MAX_SENS_THRESHOLD_ROWS; i++)
      g_sens_threshold_rows[i].Reset();
   for(int i = 0; i < MAX_SELECTED_THRESHOLDS; i++)
   {
      g_sens_stat_thresholds[i].Reset();
      g_sens_exec_thresholds[i].Reset();
   }
   for(int i = 0; i < MAX_OP_ENTRIES; i++)
      g_op_entries[i].Reset();
   g_sens_best_count = 0;
   for(int i = 0; i < MAX_SENS_RESULTS; i++)
      g_sens_best_results[i].Reset();
   g_combo_result_count = 0;
   for(int i = 0; i < MAX_COMBO_RESULTS; i++)
      g_combo_results[i].Reset();
   ArrayInitialize(g_recorded_ids, 0);
   //Initialize arrays
   for(int i = 0; i < MATRIX_SIZE; i++) g_pivots[i].Reset();
   for(int i = 0; i < 3; i++) { g_bull_pivots[i].Reset(); g_bear_pivots[i].Reset(); }
   for(int i = 0; i < 5; i++) g_step[i].Reset();
   for(int i = 0; i < MAX_SETUPS; i++) g_setups[i].Reset();
   for(int i = 0; i < MAX_ORDER_BLOCKS; i++) { g_bull_obs[i].Reset(); g_bear_obs[i].Reset(); }
   g_setup_cnt = 0;
   g_signal_cnt = 0;
   g_pivot_idx = 0;
   g_bull_piv_cnt = 0;
   g_bear_piv_cnt = 0;
   g_bull_ob_cnt = 0;
   g_bear_ob_cnt = 0;
   g_trade.SetExpertMagicNumber(inp_magic_number);
   g_trade.SetDeviationInPoints(inp_slippage_points);
   g_trade.SetTypeFilling(GetFilling());
   //Load setup backups
   LoadAllSetupBackups();
   Print("=== ANALYSIS LOADING START ===");
   InitAllAnalysis();
   // NEW: Initialize Research Framework
   RschInit();
   DebugPrintAnalysisStatus("After Init");
   bool state_loaded = false;
   if(!g_testing && !inp_reset_setup_id && inp_enable_state_persistence && inp_load_state_on_init)
   {
      state_loaded = LoadPersistentState();
      if(state_loaded)
         Print("✅ Persistent State Loaded (Resumed).");
   }
   if(!state_loaded)
   {
      if(!inp_reset_setup_id)
      {
         g_snapshot_count = 0;
         if(RebuildAllAnalysisFromCSV())
         {
            Print("✅ Rebuilt full cumulative analysis from CSV.");
         }
         else
         {
            LoadAnalysisFromCSV();
            Print("ℹ️ Loaded minimal analysis from CSV (fallback).");
         }
      }
      else
      {
         Print("Reset requested - Analysis data cleared.");
         if(inp_enable_state_persistence) DeletePersistentState();
      }
   }
   Print("=== ANALYSIS LOADING END ===");
   DebugPrintAnalysisStatus("After Load");
   if(!EventSetTimer(MAINTENANCE_INTERVAL))
      LogWarning("Failed to set timer");
   Print("================================================================");
   Print("=     Divergence EA v8.1 - MTF Analysis                        =");
   Print("================================================================");
   Print("Main TF: ", g_tf[0].name);
   Print("Starting: Row=", g_row_cnt, "| HTML=", g_html_row_cnt, "| ID=", g_next_setup_id);
   Print("Opened=", g_stats[0], "| Closed=", g_stats[1]);
   Print("Steps: ", g_stats[2], "/", g_stats[3], "/", g_stats[4], "/", g_stats[5], "/", g_stats[6]);
   Print("MTF Buy Patterns: ", g_mtf_buy.pattern_count, "| MTF Sell Patterns: ", g_mtf_sell.pattern_count);
   Print("RiskLab ready.");
   Print("Research Framework initialized.");
      // ============================================================
   // Stage 2D — TRUE FORWARD MODE LOAD
   // ============================================================
   g_s2d_frozen_loaded = false;
   if(inp_s2d_run_mode == MODE_TRUE_FORWARD)
   {
      Print("=== TRUE FORWARD MODE INIT ===");
      if(!S2D_LoadFrozenPackage())
      {
         Print("ERROR: True Forward Mode requires valid frozen package.");
         return INIT_FAILED;
      }
      g_s2d_header_written = FileIsExist(S2D_GetForwardCSVName(), FILE_COMMON);
      Print("TRUE FORWARD MODE: frozen winner loaded and ready.");
   }
   RX_BeginRun();
   return INIT_SUCCEEDED;
}
struct SDecisionResult
{
   string context;          // BUY|StopFlag
   string feature;
   string threshold_rule;
   string decision;         // ENABLE / PILOT / WATCHLIST / REJECT
   string reason;
   double confidence;       // 0-100
   int    priority;         // 1=highest
   void Reset()
   {
      context = feature = threshold_rule = "";
      decision = "REJECT";
      reason   = "";
      confidence = 0.0;
      priority   = 99;
   }
};
//================================================================
// RunDecisionEngine
// Reads research results and automatically classifies each rule.
// Returns array of decisions sorted by confidence.
//================================================================
int RunDecisionEngine(SDecisionResult &decisions[])
{
   ArrayResize(decisions, 0);
   int dc = 0;
   for(int i = 0; i < g_op_entry_count; i++)
   {
      SDecisionResult res;
      res.Reset();
      res.context         = g_op_entries[i].context;
      res.feature         = g_op_entries[i].feature_name;
      res.threshold_rule  = g_op_entries[i].threshold_or_rule;
      double oos_red  = g_op_entries[i].oos_reduction;
      double oos_cov  = g_op_entries[i].oos_cov;
      double oos_avgp = g_op_entries[i].oos_avgp;
      bool   ready    = g_op_entries[i].execution_ready;
      bool   sel_exec = g_op_entries[i].selected_as_execution;
      bool   sel_stat = g_op_entries[i].selected_as_statistical;
      bool   op_rec   = g_op_entries[i].op_recommended;
      string ctype    = g_op_entries[i].threshold_or_rule;
      // ============================================================
      // Decision Tree
      // ============================================================
      if(!ready)
      {
         res.decision   = "REJECT";
         res.reason     = "NOT_EXECUTION_READY";
         res.confidence = 0.0;
         res.priority   = 99;
      }
      else if(!sel_exec)
      {
         res.decision   = "REJECT";
         res.reason     = "NOT_SELECTED_AS_EXECUTION";
         res.confidence = 5.0;
         res.priority   = 99;
      }
      else if(!op_rec)
      {
         res.decision   = "WATCHLIST";
         res.reason     = "NOT_OPERATIONALLY_RECOMMENDED";
         res.confidence = 20.0;
         res.priority   = 8;
      }
      else if(oos_cov < 10.0)
      {
         res.decision   = "REJECT";
         res.reason     = "COVERAGE_TOO_LOW(<10%)";
         res.confidence = 0.0;
         res.priority   = 99;
      }
      else if(oos_red <= 0.0)
      {
         res.decision   = "REJECT";
         res.reason     = "NO_OOS_REDUCTION";
         res.confidence = 0.0;
         res.priority   = 99;
      }
      else
      {
         // Evaluate OOS quality
         bool strong_reduction = (oos_red >= DE_MIN_OOS_REDUCTION_STRONG);
         bool good_reduction   = (oos_red >= DE_MIN_OOS_REDUCTION_GOOD);
         bool ok_reduction     = (oos_red >= DE_MIN_OOS_REDUCTION_OK);
         bool good_coverage    = (oos_cov >= DE_MIN_EXEC_COVERAGE);
         bool ok_coverage      = (oos_cov >= DE_MIN_EXEC_COVERAGE_PILOT);
         bool positive_pnl  = (oos_avgp >= 0.0);
         bool stat_confirmed = sel_stat;
         // Check OOS stability from validation results
         string stability = "UNKNOWN";
         for(int j = 0; j < g_oos_result_count; j++)
         {
            if(StringFind(g_oos_results[j].feature_name,
                          g_op_entries[i].feature_name) >= 0)
            {
               stability = g_oos_results[j].stability_label;
               break;
            }
         }
         bool is_stable = (stability == "STABLE");
         bool is_mild   = (stability == "MILD_DEGRADATION");
         // ---- ENABLE (Production Ready) ----
         if(strong_reduction && good_coverage && positive_pnl
            && stat_confirmed && (is_stable || is_mild))
         {
            res.decision   = "ENABLE";
            res.reason     = "STRONG_OOS+STABLE+EXEC_SELECTED";
            res.confidence = MathMin(95.0,
               60.0 + oos_red * 1.5 + (is_stable ? 10.0 : 5.0));
            res.priority   = 1;
         }
         // ---- ENABLE (weaker but still good) ----
         else if(good_reduction && ok_coverage && positive_pnl && stat_confirmed)
         {
            res.decision   = "ENABLE";
            res.reason     = "GOOD_OOS+EXEC_SELECTED";
            res.confidence = MathMin(80.0, 45.0 + oos_red * 1.5);
            res.priority   = 2;
         }
         // ---- PILOT ----
         else if(ok_reduction && ok_coverage)
         {
            res.decision   = "PILOT";
            res.reason     = "OK_OOS_NEEDS_MORE_DATA";
            res.confidence = MathMin(60.0, 30.0 + oos_red * 1.2);
            res.priority   = 5;
         }
         // ---- WATCHLIST ----
         else
         {
            res.decision   = "WATCHLIST";
            res.reason     = "MARGINAL_OOS";
            res.confidence = MathMin(35.0, 15.0 + oos_red * 0.8);
            res.priority   = 7;
         }
      }
      ArrayResize(decisions, dc + 1);
      decisions[dc++] = res;
   }
   // Sort by priority then confidence
   for(int i = 0; i < dc - 1; i++)
   {
      for(int j = i + 1; j < dc; j++)
      {
         bool swap = false;
         if(decisions[j].priority < decisions[i].priority) swap = true;
         else if(decisions[j].priority == decisions[i].priority &&
                 decisions[j].confidence > decisions[i].confidence) swap = true;
         if(swap)
         {
            SDecisionResult tmp = decisions[i];
            decisions[i] = decisions[j];
            decisions[j] = tmp;
         }
      }
   }
   return dc;
}
void S2D_FinalCleanupOnly(const int reason)
{
   SStepDistanceAnalysis step_analysis = AnalyzeStepDistances();
   if(!g_testing || g_visual)
      Print(step_analysis.GetReport());
   for(int i = 0; i < TF_COUNT; i++)
   {
      g_tf[i].ReleaseHandles();
      g_tf[i].FreeBuffers();
   }
   if(g_profile_m1_atr_handle!=INVALID_HANDLE)
   {
      IndicatorRelease(g_profile_m1_atr_handle);
      g_profile_m1_atr_handle=INVALID_HANDLE;
   }
   g_snap_map_count = 0;
   g_snap_map_dirty = true;
   ArrayFree(g_snap_map_ids);
   ArrayFree(g_snap_map_idx);
   ArrayFree(g_pivots);
   ArrayFree(g_signals);
   ArrayFree(g_setups);
   ArrayFree(g_snapshots);
   ArrayFree(g_recorded_ids);
   ArrayFree(g_risklab_records);
   ArrayFree(g_rl_feature_stats);
   ArrayFree(g_rl_models);
   ArrayFree(g_sens_best_results);
   ArrayFree(g_sens_threshold_rows);
   ArrayFree(g_sens_stat_thresholds);
   ArrayFree(g_sens_exec_thresholds);
   ArrayFree(g_combo_results);
   ArrayFree(g_op_entries);
   ArrayFree(g_shadow_signals);
   ArrayFree(g_active_shadow_indices);
   g_active_shadow_count=0;
   // NEW
   ArrayFree(g_position_open_records);
   ArrayFree(g_rsch_meta);
   ArrayFree(g_rsch_groups);
   ArrayFree(g_rsch_results);
   ArrayFree(g_rsch_combos);
   ArrayFree(g_rsch_pairs);
   ArrayFree(g_oos_results);
   g_oos_result_count = 0;
   g_oos_cutoff       = 0;
   ArrayFree(g_feat_rank_stability);
   ArrayFree(g_compact_results);
   g_compact_result_count = 0;
   g_s2b_step4.Reset();
   g_s2b_stop.Reset();
   g_s2b_deepstop.Reset();
   g_s2b_compact_winner.Reset();
   g_snapshot_count             = 0;
   g_recorded_count             = 0;
   g_risklab_count              = 0;
   g_rl_feature_stat_count      = 0;
   g_rl_model_count             = 0;
   g_sens_best_count            = 0;
   g_sens_threshold_row_count   = 0;
   g_sens_stat_threshold_count  = 0;
   g_sens_exec_threshold_count  = 0;
   g_combo_result_count         = 0;
   g_op_entry_count             = 0;
   g_rsch_result_count          = 0;
   g_rsch_combo_count           = 0;
   g_rsch_pair_count            = 0;
   g_shadow_count               = 0;
   g_next_shadow_id             = 1;
   g_total_shadow_accepted      = 0;
   g_total_shadow_rejected      = 0;
   ArrayInitialize(g_reject_filter_counts, 0);
   g_reject_combo_count         = 0;
   g_setup_cnt                  = 0;
   g_signal_cnt                 = 0;
   g_pivot_idx                  = 0;
   g_bull_piv_cnt               = 0;
   g_bear_piv_cnt               = 0;
   g_bull_ob_cnt                = 0;
   g_bear_ob_cnt                = 0;
   g_position_open_count = 0;
   g_next_position_open_record_id = 1;
   g_rebuild_mode               = false;
   g_research_summary.Reset();
   ResetAllAnalysisData();
   ObjectsDeleteAll(0, "DIV_");
   ObjectsDeleteAll(0, "LVL_");
   ObjectsDeleteAll(0, "TGT_");
   ObjectsDeleteAll(0, "BE_");
   Comment("");
   string reason_str = GetDeinitReasonString(reason);
   Print("=== OnDeinit END | Reason: ", reason_str, " ===");
}
void S2D_HandleTrueForwardOnDeinit(const int reason)
{
   Print("=== TRUE FORWARD MODE ===");
   Print("Skipping Stage 2A/2B training/search/export blocks.");
   if(inp_enable_export)
   {
      // Stage 2C passive exports are okay because they only read frozen model
      if(g_s2d_frozen_loaded && g_s2b_compact_winner.trained)
      {
         Print("Running Stage 2C passive exports (frozen model)...");
         S2C_RunPhase1();
         S2C_RunPhase2();
         S2C_RunPhase2b();
         S2C_RunPhase3();
      }
      else
      {
         Print("ERROR: TRUE_FORWARD mode active but frozen package not loaded.");
      }
      Print("Running TRUE forward Stage 2D validation check...");
      S2D_RunForwardValidationIfReady(50);
      Print("TRUE forward Stage 2D validation check done.");
   }
   S2D_FinalCleanupOnly(reason);
}
void OnDeinit(const int reason)
{
   EventKillTimer();
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only && !g_div3_span_shadow_runtime_ready)
   {
      Print("DIV3_SPAN_SHADOW|DEINIT_SKIPPED|Reason=INIT_NOT_READY|FilesCreated=0");
      return;
   }
   Print("=== OnDeinit START ===");
   DIV3_SpanShadowFinalizeAll();
   DIV3_SpanShadowExport();
   DIV3_AuditFinalize();
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only)
   {
      Print("DIV3_STEP5_RECOVERY50_EXECSHADOW|AUDIT_ONLY_CLEANUP|UnrelatedReports=SUPPRESSED|Orders=BLOCKED");
      DIV3_SpanShadowMinimalCleanup();
      return;
   }
   SaveStats();
   SaveSetupID(g_next_setup_id);
   // Finalize still-open PositionOpen labels before ExportUnexportedSetups()
   // marks their setup inactive. EOT_OPEN is censored metadata, never a loss.
   if(inp_export_position_open_dataset)
   {
      for(int i=0;i<g_setup_cnt;i++)
      {
         if(!g_setups[i].is_active) continue;
         FinalizePositionOpenRecordsForSetup(i,0.0,"EOT_OPEN");
      }
   }
   // RX labels every still-open setup as censored before core export deactivates it.
   RX_CensorOpenSetups();
   ExportUnexportedSetups();
   SaveStats();
   bool any_shadow_feature =
      (inp_enable_reject_tracking || inp_enable_shadow_tracking ||
       inp_enable_lifecycle_tracking || inp_export_reject_stats_csv ||
       inp_enable_research_protocol);
   if(any_shadow_feature)
      FinalizeAllActiveShadows();
   if(inp_enable_research_protocol)
      ExportResearchProtocolCSV();
   // ---------- v9.21: position-open research dataset ----------
   // inp_enable_export pulls in the whole heavy RL export chain. The
   // position-open dataset is the primary research output, so it has its own
   // switch and also exports when the full chain is off. EOT finalization
   // must run BEFORE ExportAllAnalysis so still-open setups appear as
   // censored (SetupFinalEvent=EOT_OPEN) instead of vanishing.
   if(inp_export_position_open_dataset)
   {
      if(!inp_enable_export)
      {
         Print("Exporting position-open research dataset (standalone)...");
         ExportPositionOpenDatasetCSV();
         ExportStep1OutcomeComparisonCSV();
         ExportStep1OutcomeComparisonSummaryCSV();
         ExportPositionOpenIndicatorStatsCSV();
         ExportPositionOpenSummaryReport();
      }
   }
   // Market Edge export runs after actual PositionOpen labels are finalized.
   // Active horizons are explicitly censored; no partial future label is used.
   if(inp_enable_market_edge_collector)
   {
      ME_CensorActiveOnDeinit();
      ME_ExportCSV();
   }
   if(inp_enable_export)
      ExportAllAnalysis();
   if(g_armed_divergence.active && g_armed_divergence.confirmed)
   {
      g_profile_stats[(int)TestProfile].rejected_structure++;
      g_armed_divergence.Reset();
   }
   PrintProfileStatistics();
   ExportProfileStatisticsCSV();
   RX_ExportAll();
   S2D_FinalCleanupOnly(reason);
}
#define AFM_MAX_CANDIDATES 512
#define AFM_MAX_EVALS      512
#define AFM_MAX_COMBO_EVALS 256
#define AFM_COMBO_TOP_SINGLE 12
enum ENUM_AFM_OBJECTIVE
{
   AFM_OBJ_STOP = 0,
   AFM_OBJ_STEP4 = 1
};
enum ENUM_AFM_FAMILY
{
   AFM_FAM_NUM_TF = 0,
   AFM_FAM_STR_TF = 1,
   AFM_FAM_NUM_G  = 2,
   AFM_FAM_BOOL_G = 3
};
enum ENUM_AFM_CMP
{
   AFM_CMP_GE = 0,
   AFM_CMP_LE = 1,
   AFM_CMP_EQ_STR = 2,
   AFM_CMP_EQ_BOOL = 3
};
enum ENUM_AFM_NUMTF_FIELD
{
   AFM_NUMTF_RSI = 0,
   AFM_NUMTF_ADX = 1,
   AFM_NUMTF_CCI = 2,
   AFM_NUMTF_ATR = 3,
   AFM_NUMTF_EMA200_DIST = 4,
   AFM_NUMTF_ATR_REGIME = 5,
   AFM_NUMTF_ADX_SLOPE = 6,
   AFM_NUMTF_EMA_COMP = 7
};
enum ENUM_AFM_STRTF_FIELD
{
   AFM_STRTF_DI = 0,
   AFM_STRTF_EMA = 1,
   AFM_STRTF_POS = 2
};
enum ENUM_AFM_NUMG_FIELD
{
   AFM_NUMG_STABILITY = 0,
   AFM_NUMG_DI_AGREE = 1,
   AFM_NUMG_EMA_BULL = 2,
   AFM_NUMG_PIV1 = 3,
   AFM_NUMG_PIV2 = 4,
   AFM_NUMG_SIG_CLV = 5,
   AFM_NUMG_SIG_BODY = 6,
   AFM_NUMG_OB_AGE = 7,
   AFM_NUMG_OB_WIDTH = 8
};
enum ENUM_AFM_BOOLG_FIELD
{
   AFM_BOOLG_HTF_CONFLICT = 0
};
struct SAFMCandidate
{
   int    family;
   int    tf;
   int    field;
   int    cmp;
   double threshold;
   string sval;
   bool   bval;
   string name;
   void Reset()
   {
      family = AFM_FAM_NUM_TF;
      tf = -1;
      field = 0;
      cmp = AFM_CMP_GE;
      threshold = 0.0;
      sval = "";
      bval = false;
      name = "";
   }
};
struct SAFMEval
{
   string filter_name;
   string skip_rule;
   SAFMCandidate src_cand;
   int total;
   int bad_total;
   int total_wins;
   int accepted;
   int accepted_bad;
   int accepted_wins;
   double accepted_profit;
   int rejected;
   int rejected_bad;
   int rejected_wins;
   double rejected_profit;
   double baseline_bad_pct;
   double baseline_wr;
   double accepted_bad_pct;
   double rejected_bad_pct;
   double reduction_pct;
   double coverage_pct;
   double accepted_wr;
   double rejected_wr;
   double accepted_avgp;
   double rejected_avgp;
   double score;
   void Reset()
   {
      filter_name = "";
      skip_rule = "";
      src_cand.Reset();
      total = 0;
      bad_total = 0;
      total_wins = 0;
      accepted = 0;
      accepted_bad = 0;
      accepted_wins = 0;
      accepted_profit = 0.0;
      rejected = 0;
      rejected_bad = 0;
      rejected_wins = 0;
      rejected_profit = 0.0;
      baseline_bad_pct = 0.0;
      baseline_wr = 0.0;
      accepted_bad_pct = 0.0;
      rejected_bad_pct = 0.0;
      reduction_pct = 0.0;
      coverage_pct = 0.0;
      accepted_wr = 0.0;
      rejected_wr = 0.0;
      accepted_avgp = 0.0;
      rejected_avgp = 0.0;
      score = -999999.0;
   }
};
string AFM_ObjectiveName(ENUM_AFM_OBJECTIVE obj)
{
   if(inp_use_persian_language)
      return (obj == AFM_OBJ_STOP ? "کاهش استاپ" : "جلوگیری از Step4+");
   return (obj == AFM_OBJ_STOP ? "Reduce STOP" : "Avoid Step4+");
}
string AFM_ContextName(bool is_buy)
{
   return is_buy ? "BUY" : "SELL";
}
bool AFM_IsStopOutcome(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsStopToken(ft);
}
bool AFM_IsBad(SEntrySnapshot &sn, ENUM_AFM_OBJECTIVE obj)
{
   if(obj == AFM_OBJ_STOP)
      return AFM_IsStopOutcome(sn);
   return (sn.actual_max_step >= 4);
}
bool AFM_ContextMatch(SEntrySnapshot &sn, bool is_buy)
{
   if(sn.actual_max_step < 1 || sn.actual_max_step > 5)
      return false;
   return (sn.is_bullish == is_buy);
}
string AFM_NumTFLabel(int field)
{
   switch(field)
   {
      case AFM_NUMTF_RSI:         return "RSI";
      case AFM_NUMTF_ADX:         return "ADX";
      case AFM_NUMTF_CCI:         return "CCI";
      case AFM_NUMTF_ATR:         return "ATR";
      case AFM_NUMTF_EMA200_DIST: return "EMA200_Dist";
      case AFM_NUMTF_ATR_REGIME:  return "ATR_Regime";
      case AFM_NUMTF_ADX_SLOPE:   return "ADX_Slope";
      case AFM_NUMTF_EMA_COMP:    return "EMA_Compression";
   }
   return "NumTF";
}
string AFM_StrTFLabel(int field)
{
   switch(field)
   {
      case AFM_STRTF_DI:  return "DI";
      case AFM_STRTF_EMA: return "EMAOrder";
      case AFM_STRTF_POS: return "Position";
   }
   return "StrTF";
}
string AFM_NumGLabel(int field)
{
   switch(field)
   {
      case AFM_NUMG_STABILITY: return "Stability";
      case AFM_NUMG_DI_AGREE:  return "DI_Agreement";
      case AFM_NUMG_EMA_BULL:  return "EMA_Bullish_Count";
      case AFM_NUMG_PIV1:      return "Pivot1Dist";
      case AFM_NUMG_PIV2:      return "Pivot2Dist";
      case AFM_NUMG_SIG_CLV:   return "Signal_CLV";
      case AFM_NUMG_SIG_BODY:  return "Signal_BodyRatio";
      case AFM_NUMG_OB_AGE:    return "OB_AgeBars";
      case AFM_NUMG_OB_WIDTH:  return "OB_Width_ATR";
   }
   return "NumG";
}
string AFM_BoolGLabel(int field)
{
   switch(field)
   {
      case AFM_BOOLG_HTF_CONFLICT: return "HTF_Conflict";
   }
   return "BoolG";
}
string AFM_ThrToStr(double v)
{
   if(MathAbs(v) >= 100.0) return DoubleToString(v, 0);
   if(MathAbs(v) >= 10.0)  return DoubleToString(v, 1);
   return DoubleToString(v, 3);
}
double AFM_ThresholdEps(double v)
{
   double a = MathAbs(v);
   if(a >= 100.0) return 1.0;
   if(a >= 10.0)  return 0.25;
   if(a >= 1.0)   return 0.05;
   return 0.005;
}
void AFM_PushValue(double &arr[], double v)
{
   int n = ArraySize(arr);
   ArrayResize(arr, n + 1);
   arr[n] = v;
}
double AFM_GetQuantile(double &vals[], double q01)
{
   int n = ArraySize(vals);
   if(n <= 0) return 0.0;
   if(q01 < 0.0) q01 = 0.0;
   if(q01 > 1.0) q01 = 1.0;
   ArraySort(vals);
   int idx = (int)MathFloor((n - 1) * q01 + 0.5);
   if(idx < 0) idx = 0;
   if(idx >= n) idx = n - 1;
   return vals[idx];
}
bool AFM_CandidateExists(SAFMCandidate &cands[], int count, SAFMCandidate &c)
{
   for(int i = 0; i < count; i++)
   {
      if(cands[i].family != c.family) continue;
      if(cands[i].tf     != c.tf)     continue;
      if(cands[i].field  != c.field)  continue;
      if(cands[i].cmp    != c.cmp)    continue;
      if(c.cmp == AFM_CMP_EQ_STR)
      {
         if(cands[i].sval == c.sval)
            return true;
      }
      else if(c.cmp == AFM_CMP_EQ_BOOL)
      {
         if(cands[i].bval == c.bval)
            return true;
      }
      else
      {
         if(MathAbs(cands[i].threshold - c.threshold) <= AFM_ThresholdEps(c.threshold))
            return true;
      }
   }
   return false;
}
void AFM_AddCandidateUnique(SAFMCandidate &cands[], int &cc, SAFMCandidate &c)
{
   if(cc >= ArraySize(cands))
      return;
   if(AFM_CandidateExists(cands, cc, c))
      return;
   cands[cc++] = c;
}
void AFM_GetSplitIndices(bool &is_train[])
{
   int n = g_snapshot_count;
   ArrayResize(is_train, n);
   if(n <= 0) return;
   // Sort timestamps to find the 70th percentile cutoff
   datetime times[];
   ArrayResize(times, n);
   for(int i = 0; i < n; i++)
      times[i] = g_snapshots[i].entry_time;
   ArraySort(times);
   int cutoff_idx = (int)MathFloor(n * 0.70);
   if(cutoff_idx >= n) cutoff_idx = n - 1;
   if(cutoff_idx < 1)  cutoff_idx = 1;
   datetime cutoff_time = times[cutoff_idx];
   ArrayFree(times);
   // Assign train/eval based on entry_time vs cutoff
   int train_cnt = 0, eval_cnt = 0;
   for(int i = 0; i < n; i++)
   {
      is_train[i] = (g_snapshots[i].entry_time < cutoff_time);
      if(is_train[i]) train_cnt++;
      else            eval_cnt++;
   }
   double actual_train_pct = (n > 0) ? (train_cnt * 100.0 / n) : 0.0;
   double actual_eval_pct  = (n > 0) ? (eval_cnt  * 100.0 / n) : 0.0;
   static datetime last_printed_cutoff = 0;
   if(last_printed_cutoff != cutoff_time)
   {
      last_printed_cutoff = cutoff_time;
      Print("AFM Temporal Split: Cutoff=", TimeToString(cutoff_time, TIME_DATE),
            " | Requested: 70/30",
            " | Actual: ", DoubleToString(actual_train_pct, 1), "/",
                           DoubleToString(actual_eval_pct,  1),
            " | Train=", train_cnt, " | Eval=", eval_cnt,
            (MathAbs(actual_train_pct - 70.0) > 5.0
               ? " ⚠ WARNING: Split deviates >5% from target (timestamp ties?)"
               : ""));
   }
}
bool AFM_CollectNumTFValues(bool is_buy, ENUM_AFM_OBJECTIVE obj, int tf, int field,
                            double &all_vals[], double &mean_good, double &mean_bad,
                            int &n_good, int &n_bad)
{
   ArrayResize(all_vals, g_snapshot_count);
   mean_good = 0.0;
   mean_bad  = 0.0;
   n_good    = 0;
   n_bad     = 0;
   // Build temporal split mask
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   double sum_good = 0.0;
   double sum_bad  = 0.0;
   int actual_count = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;   // train set only for candidate generation
      double v = 0.0;
      if(!AFM_GetNumTF(g_snapshots[i], tf, field, v)) continue;
      if(!MathIsValidNumber(v)) continue;
      if(actual_count < ArraySize(all_vals))
         all_vals[actual_count++] = v;
      if(AFM_IsBad(g_snapshots[i], obj))
      {
         sum_bad += v;
         n_bad++;
      }
      else
      {
         sum_good += v;
         n_good++;
      }
   }
   ArrayFree(is_train);
   if(n_good < 15 || n_bad < 10 || actual_count < 25)
   {
      ArrayResize(all_vals, 0);
      return false;
   }
   ArrayResize(all_vals, actual_count);
   mean_good = sum_good / n_good;
   mean_bad  = sum_bad  / n_bad;
   return true;
}
bool AFM_CollectNumGValues(bool is_buy, ENUM_AFM_OBJECTIVE obj, int field,
                           double &all_vals[], double &mean_good, double &mean_bad,
                           int &n_good, int &n_bad)
{
   ArrayResize(all_vals, g_snapshot_count);
   mean_good = 0.0;
   mean_bad  = 0.0;
   n_good    = 0;
   n_bad     = 0;
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   double sum_good = 0.0;
   double sum_bad  = 0.0;
   int actual_count = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;
      double v = 0.0;
      if(!AFM_GetNumG(g_snapshots[i], field, v)) continue;
      if(!MathIsValidNumber(v)) continue;
      if(actual_count < ArraySize(all_vals))
         all_vals[actual_count++] = v;
      if(AFM_IsBad(g_snapshots[i], obj))
      {
         sum_bad += v;
         n_bad++;
      }
      else
      {
         sum_good += v;
         n_good++;
      }
   }
   ArrayFree(is_train);
   if(n_good < 15 || n_bad < 10 || actual_count < 25)
   {
      ArrayResize(all_vals, 0);
      return false;
   }
   ArrayResize(all_vals, actual_count);
   mean_good = sum_good / n_good;
   mean_bad  = sum_bad  / n_bad;
   return true;
}
void AFM_TryAddNumTFCandidate(int tf, int field, int cmp, double thr, SAFMCandidate &cands[], int &cc)
{
   SAFMCandidate c;
   c.Reset();
   c.family = AFM_FAM_NUM_TF;
   c.tf = tf;
   c.field = field;
   c.cmp = cmp;
   c.threshold = thr;
   c.name = g_tf[tf].name + " " + AFM_NumTFLabel(field) + " " +
            ((cmp == AFM_CMP_GE) ? ">=" : "<=") + " " + AFM_ThrToStr(thr);
   AFM_AddCandidateUnique(cands, cc, c);
}
void AFM_TryAddNumGCandidate(int field, int cmp, double thr, SAFMCandidate &cands[], int &cc)
{
   SAFMCandidate c;
   c.Reset();
   c.family = AFM_FAM_NUM_G;
   c.tf = -1;
   c.field = field;
   c.cmp = cmp;
   c.threshold = thr;
   c.name = AFM_NumGLabel(field) + " " +
            ((cmp == AFM_CMP_GE) ? ">=" : "<=") + " " + AFM_ThrToStr(thr);
   AFM_AddCandidateUnique(cands, cc, c);
}
void AFM_AddNumTFCandidatesMulti(bool is_buy, ENUM_AFM_OBJECTIVE obj, int tf, int field,
                                 SAFMCandidate &cands[], int &cc)
{
   double vals[];
   double mean_good = 0.0, mean_bad = 0.0;
   int n_good = 0, n_bad = 0;
   if(!AFM_CollectNumTFValues(is_buy, obj, tf, field, vals, mean_good, mean_bad, n_good, n_bad))
      return;
   double diff  = MathAbs(mean_good - mean_bad);
   double scale = (MathAbs(mean_good) + MathAbs(mean_bad)) / 2.0;
   if(scale < 0.000001) scale = 1.0;
   if((diff / scale) < 0.05 && diff < 0.5)
      return;
   int cmp = (mean_good > mean_bad) ? AFM_CMP_GE : AFM_CMP_LE;
   double midpoint = (mean_good + mean_bad) / 2.0;
   double q20 = AFM_GetQuantile(vals, 0.20);
   double q35 = AFM_GetQuantile(vals, 0.35);
   double q50 = AFM_GetQuantile(vals, 0.50);
   double q65 = AFM_GetQuantile(vals, 0.65);
   double q80 = AFM_GetQuantile(vals, 0.80);
   AFM_TryAddNumTFCandidate(tf, field, cmp, midpoint, cands, cc);
   AFM_TryAddNumTFCandidate(tf, field, cmp, q20, cands, cc);
   AFM_TryAddNumTFCandidate(tf, field, cmp, q35, cands, cc);
   AFM_TryAddNumTFCandidate(tf, field, cmp, q50, cands, cc);
   AFM_TryAddNumTFCandidate(tf, field, cmp, q65, cands, cc);
   AFM_TryAddNumTFCandidate(tf, field, cmp, q80, cands, cc);
}
void AFM_AddNumGCandidatesMulti(bool is_buy, ENUM_AFM_OBJECTIVE obj, int field,
                                SAFMCandidate &cands[], int &cc)
{
   double vals[];
   double mean_good = 0.0, mean_bad = 0.0;
   int n_good = 0, n_bad = 0;
   if(!AFM_CollectNumGValues(is_buy, obj, field, vals, mean_good, mean_bad, n_good, n_bad))
      return;
   double diff  = MathAbs(mean_good - mean_bad);
   double scale = (MathAbs(mean_good) + MathAbs(mean_bad)) / 2.0;
   if(scale < 0.000001) scale = 1.0;
   if((diff / scale) < 0.05 && diff < 0.5)
      return;
   int cmp = (mean_good > mean_bad) ? AFM_CMP_GE : AFM_CMP_LE;
   double midpoint = (mean_good + mean_bad) / 2.0;
   double q20 = AFM_GetQuantile(vals, 0.20);
   double q35 = AFM_GetQuantile(vals, 0.35);
   double q50 = AFM_GetQuantile(vals, 0.50);
   double q65 = AFM_GetQuantile(vals, 0.65);
   double q80 = AFM_GetQuantile(vals, 0.80);
   AFM_TryAddNumGCandidate(field, cmp, midpoint, cands, cc);
   AFM_TryAddNumGCandidate(field, cmp, q20, cands, cc);
   AFM_TryAddNumGCandidate(field, cmp, q35, cands, cc);
   AFM_TryAddNumGCandidate(field, cmp, q50, cands, cc);
   AFM_TryAddNumGCandidate(field, cmp, q65, cands, cc);
   AFM_TryAddNumGCandidate(field, cmp, q80, cands, cc);
}
struct SAFMComboEval
{
   string name_a;
   string name_b;
   string combined_name;
   string skip_rule;
   int total;
   int bad_total;
   int accepted;
   int accepted_bad;
   int accepted_wins;
   double accepted_profit;
   int rejected;
   int rejected_bad;
   double baseline_bad_pct;
   double coverage_pct;
   double accepted_bad_pct;
   double rejected_bad_pct;
   double reduction_pct;
   double accepted_wr;
   double accepted_avgp;
   double score;
   void Reset()
   {
      name_a = "";
      name_b = "";
      combined_name = "";
      skip_rule = "";
      total = 0;
      bad_total = 0;
      accepted = 0;
      accepted_bad = 0;
      accepted_wins = 0;
      accepted_profit = 0.0;
      rejected = 0;
      rejected_bad = 0;
      baseline_bad_pct = 0.0;
      coverage_pct = 0.0;
      accepted_bad_pct = 0.0;
      rejected_bad_pct = 0.0;
      reduction_pct = 0.0;
      accepted_wr = 0.0;
      accepted_avgp = 0.0;
      score = -999999.0;
   }
};
void AFM_EvaluateCombo(SAFMCandidate &ca, SAFMCandidate &cb,
                       bool is_buy, ENUM_AFM_OBJECTIVE obj,
                       SAFMComboEval &ev)
{
   ev.Reset();
   ev.name_a = ca.name;
   ev.name_b = cb.name;
   ev.combined_name = ca.name + " AND " + cb.name;
   ev.skip_rule     = "SKIP if NOT (" + ca.name + " AND " + cb.name + ")";
   // Eval set only (temporal 30%)
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(is_train[i]) continue;  // eval set
      ev.total++;
      bool bad  = AFM_IsBad(g_snapshots[i], obj);
      if(bad) ev.bad_total++;
      bool pass = (AFM_CandidateMatch(g_snapshots[i], ca) &&
                   AFM_CandidateMatch(g_snapshots[i], cb));
      if(pass)
      {
         ev.accepted++;
         if(bad) ev.accepted_bad++;
         if(g_snapshots[i].final_profit > 0) ev.accepted_wins++;
         ev.accepted_profit += g_snapshots[i].final_profit;
      }
      else
      {
         ev.rejected++;
         if(bad) ev.rejected_bad++;
      }
   }
   ArrayFree(is_train);
   if(ev.total <= 0 || ev.accepted < 15) { ev.score = -999999.0; return; }
   ev.baseline_bad_pct = ev.bad_total * 100.0 / ev.total;
   ev.coverage_pct     = ev.accepted * 100.0 / ev.total;
   ev.accepted_bad_pct = (ev.accepted > 0) ? (ev.accepted_bad * 100.0 / ev.accepted) : 0.0;
   ev.rejected_bad_pct = (ev.rejected > 0) ? (ev.rejected_bad * 100.0 / ev.rejected) : 0.0;
   ev.reduction_pct    = ev.baseline_bad_pct - ev.accepted_bad_pct;
   ev.accepted_wr      = (ev.accepted > 0) ? (ev.accepted_wins * 100.0 / ev.accepted) : 0.0;
   ev.accepted_avgp    = (ev.accepted > 0) ? (ev.accepted_profit / ev.accepted) : 0.0;
   ev.score = (ev.reduction_pct * 5.0)
            + (MathMin(ev.coverage_pct, 70.0) * 0.20)
            + (MathMax(0.0, ev.accepted_wr - ev.baseline_bad_pct) * 0.30)
            + (MathMax(0.0, ev.rejected_bad_pct - ev.accepted_bad_pct) * 0.15);
   if(ev.coverage_pct < 10.0)       ev.score *= 0.05;
   else if(ev.coverage_pct < 20.0)  ev.score *= 0.25;
   else if(ev.coverage_pct < 30.0)  ev.score *= 0.55;
   if(ev.reduction_pct <= 0.0)  ev.score *= 0.03;
   if(ev.reduction_pct <= 1.0)  ev.score *= 0.20;
}
void AFM_SortComboEvals(SAFMComboEval &arr[], int count)
{
   // Shell Sort: O(n log²n)
   int gap = count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < count; i++)
      {
         SAFMComboEval temp = arr[i];
         int j = i;
         while(j >= gap && arr[j - gap].score < temp.score)
         {
            arr[j] = arr[j - gap];
            j -= gap;
         }
         arr[j] = temp;
      }
      gap /= 2;
   }
}
bool AFM_IsSameFeature(SAFMCandidate &a, SAFMCandidate &b)
{
   if(a.family != b.family) return false;
   if(a.tf != b.tf)         return false;
   if(a.field != b.field)   return false;
   return true;
}
void AFM_WriteComboTable(int h, bool is_buy, ENUM_AFM_OBJECTIVE obj,
                         SAFMEval &single_evals[], int single_count)
{
   int top_n = MathMin(single_count, AFM_COMBO_TOP_SINGLE);
   if(top_n < 2) return;
   SAFMComboEval combos[];
   ArrayResize(combos, AFM_MAX_COMBO_EVALS);
   int combo_count = 0;
   for(int a = 0; a < top_n - 1 && combo_count < AFM_MAX_COMBO_EVALS; a++)
   {
      for(int b = a + 1; b < top_n && combo_count < AFM_MAX_COMBO_EVALS; b++)
      {
         if(AFM_IsSameFeature(single_evals[a].src_cand, single_evals[b].src_cand))
            continue;
         SAFMComboEval ev;
         AFM_EvaluateCombo(single_evals[a].src_cand, single_evals[b].src_cand,
                           is_buy, obj, ev);
         if(ev.score > -1000.0 && ev.reduction_pct > 0.5)
            combos[combo_count++] = ev;
      }
   }
   if(combo_count <= 0)
   {
      ArrayFree(combos);
      return;
   }
   AFM_SortComboEvals(combos, combo_count);
   string title = AFM_ContextName(is_buy) + " | " + AFM_ObjectiveName(obj) + " | AND Combos";
   string html = "<details style=\"margin:12px 0;background:rgba(0,0,0,0.2);border:1px solid #555;border-radius:10px;padding:10px;\">\r\n";
   html += "<summary style=\"cursor:pointer;color:#ffd700;font-weight:bold;\">🔗 " + title + "</summary>\r\n";
   html += "<div style=\"color:#aaa;font-size:11px;line-height:1.8;margin-top:8px;\">";
   html += (inp_use_persian_language ?
            "ترکیب دو فیلتر مستقل: فقط تریدهایی باز شوند که هر دو شرط را رعایت کنند." :
            "Combining two independent filters: only allow entries that pass BOTH conditions.");
   html += "</div>\r\n";
   html += "<div style=\"overflow:auto;margin-top:8px;\">\r\n";
   html += "<table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#ffd700;\">";
   html += "<th>#</th>";
   html += "<th>Condition A</th>";
   html += "<th>Condition B</th>";
   html += "<th>Accepted</th>";
   html += "<th>Coverage%</th>";
   html += "<th>Baseline Bad%</th>";
   html += "<th>Accepted Bad%</th>";
   html += "<th>Reduction%</th>";
   html += "<th>Accepted WR%</th>";
   html += "<th>AvgProfit</th>";
   html += "<th>Rejected Bad%</th>";
   html += "</tr>\r\n";
   int shown = MathMin(combo_count, 12);
   for(int i = 0; i < shown; i++)
   {
      string c_red = (combos[i].reduction_pct >= 12.0) ? "#00ff88" :
                     (combos[i].reduction_pct >= 6.0)  ? "#ffff00" :
                     (combos[i].reduction_pct > 0.0)   ? "#ffa500" : "#ff4444";
      string c_cov = (combos[i].coverage_pct >= 50.0) ? "#00ff88" :
                     (combos[i].coverage_pct >= 30.0) ? "#ffff00" : "#ffa500";
      string c_profit = (combos[i].accepted_avgp >= 0.0 ? "#00ff88" : "#ff4444");
      html += "<tr>";
      html += "<td>" + IntegerToString(i + 1) + "</td>";
      html += "<td style=\"text-align:left;font-family:Consolas,monospace;font-size:9px;\">" + combos[i].name_a + "</td>";
      html += "<td style=\"text-align:left;font-family:Consolas,monospace;font-size:9px;\">" + combos[i].name_b + "</td>";
      html += "<td>" + IntegerToString(combos[i].accepted) + "/" + IntegerToString(combos[i].total) + "</td>";
      html += "<td style=\"color:" + c_cov + ";\">" + DoubleToString(combos[i].coverage_pct, 1) + "%</td>";
      html += "<td>" + DoubleToString(combos[i].baseline_bad_pct, 1) + "%</td>";
      html += "<td style=\"color:#00ff88;\">" + DoubleToString(combos[i].accepted_bad_pct, 1) + "%</td>";
      html += "<td style=\"color:" + c_red + ";font-weight:bold;\">-" + DoubleToString(combos[i].reduction_pct, 1) + "%</td>";
      html += "<td>" + DoubleToString(combos[i].accepted_wr, 1) + "%</td>";
      html += "<td style=\"color:" + c_profit + ";\">$" + DoubleToString(combos[i].accepted_avgp, 2) + "</td>";
      html += "<td>" + DoubleToString(combos[i].rejected_bad_pct, 1) + "%</td>";
      html += "</tr>\r\n";
   }
   html += "</table></div>\r\n";
   if(shown > 0 && combos[0].reduction_pct > 5.0 && combos[0].coverage_pct > 25.0)
   {
      html += "<div style=\"margin-top:10px;padding:10px;background:rgba(255,215,0,0.1);border:1px solid #ffd700;border-radius:8px;\">\r\n";
      html += "<div style=\"color:#ffd700;font-weight:bold;\">⭐ Best Combo:</div>\r\n";
      html += "<div style=\"font-family:Consolas,monospace;font-size:12px;color:#fff;margin-top:5px;\">";
      html += combos[0].name_a + "<br>AND<br>" + combos[0].name_b;
      html += "</div>\r\n";
      html += "<div style=\"margin-top:8px;font-size:11px;color:#aaa;\">";
      html += "Bad Rate: " + DoubleToString(combos[0].baseline_bad_pct, 1) + "% → " +
              DoubleToString(combos[0].accepted_bad_pct, 1) + "% ";
      html += "(<b style=\"color:#00ff88;\">-" + DoubleToString(combos[0].reduction_pct, 1) + "%</b>)<br>";
      html += "Coverage: " + DoubleToString(combos[0].coverage_pct, 1) + "% | ";
      html += "WR: " + DoubleToString(combos[0].accepted_wr, 1) + "% | ";
      html += "AvgProfit: $" + DoubleToString(combos[0].accepted_avgp, 2);
      html += "</div>\r\n</div>\r\n";
   }
   html += "</details>\r\n";
   FileWriteString(h, html);
   ArrayFree(combos);
}
bool AFM_GetNumTF(SEntrySnapshot &sn, int tf, int field, double &out)
{
   out = 0.0;
   if(tf < 0 || tf >= TF_COUNT) return false;
   switch(field)
   {
      case AFM_NUMTF_RSI:
         out = sn.rsi[tf];
         return (out > 0.0 && out <= 100.0);
      case AFM_NUMTF_ADX:
         out = sn.adx[tf];
         return (out > 0.0 && out <= 100.0);
      case AFM_NUMTF_CCI:
         out = sn.cci[tf];
         return MathIsValidNumber(out);
      case AFM_NUMTF_ATR:
         out = sn.atr[tf];
         return (out > 0.0);
      case AFM_NUMTF_EMA200_DIST:
         out = sn.ema200_dist[tf];
         return (out > 0.0);
      case AFM_NUMTF_ATR_REGIME:
         out = sn.atr_regime[tf];
         return (out > 0.0);
      case AFM_NUMTF_ADX_SLOPE:
         out = sn.adx_slope[tf];
         return MathIsValidNumber(out);
      case AFM_NUMTF_EMA_COMP:
         out = sn.ema_compression[tf];
         return (out > 0.0);
   }
   return false;
}
bool AFM_GetStrTF(SEntrySnapshot &sn, int tf, int field, string &out)
{
   out = "";
   if(tf < 0 || tf >= TF_COUNT) return false;
   switch(field)
   {
      case AFM_STRTF_DI:
         out = sn.di[tf];
         return (out == "+" || out == "-");
      case AFM_STRTF_EMA:
         out = sn.ema_order[tf];
         return (out != "" && out != "N/A");
      case AFM_STRTF_POS:
         out = sn.position[tf];
         return (out != "" && out != "N/A");
   }
   return false;
}
bool AFM_GetNumG(SEntrySnapshot &sn, int field, double &out)
{
   out = 0.0;
   switch(field)
   {
      case AFM_NUMG_STABILITY:
         out = sn.stability_score;
         return (out >= 0.0);
      case AFM_NUMG_DI_AGREE:
         out = sn.di_agreement_count;
         return (out >= 0.0);
      case AFM_NUMG_EMA_BULL:
         out = sn.ema_bullish_count;
         return (out >= 0.0);
      case AFM_NUMG_PIV1:
         out = sn.pivot1_dist;
         return (out > 0.0);
      case AFM_NUMG_PIV2:
         out = sn.pivot2_dist;
         return (out > 0.0);
      case AFM_NUMG_SIG_CLV:
         out = sn.signal_clv;
         return (out >= 0.0 && out <= 1.0);
      case AFM_NUMG_SIG_BODY:
         out = sn.signal_body_ratio;
         return (out >= 0.0 && out <= 1.0);
      case AFM_NUMG_OB_AGE:
         out = sn.ob_age_bars;
         return (out >= 0.0);
      case AFM_NUMG_OB_WIDTH:
         out = sn.ob_width_atr;
         return (out > 0.0);
   }
   return false;
}
bool AFM_GetBoolG(SEntrySnapshot &sn, int field, bool &out)
{
   out = false;
   switch(field)
   {
      case AFM_BOOLG_HTF_CONFLICT:
         out = sn.has_htf_conflict;
         return true;
   }
   return false;
}
bool AFM_CandidateMatch(SEntrySnapshot &sn, SAFMCandidate &c)
{
   if(c.family == AFM_FAM_NUM_TF)
   {
      double v = 0.0;
      if(!AFM_GetNumTF(sn, c.tf, c.field, v))
         return false;
      if(c.cmp == AFM_CMP_GE) return (v >= c.threshold);
      if(c.cmp == AFM_CMP_LE) return (v <= c.threshold);
      return false;
   }
   if(c.family == AFM_FAM_STR_TF)
   {
      string s = "";
      if(!AFM_GetStrTF(sn, c.tf, c.field, s))
         return false;
      return (s == c.sval);
   }
   if(c.family == AFM_FAM_NUM_G)
   {
      double v = 0.0;
      if(!AFM_GetNumG(sn, c.field, v))
         return false;
      if(c.cmp == AFM_CMP_GE) return (v >= c.threshold);
      if(c.cmp == AFM_CMP_LE) return (v <= c.threshold);
      return false;
   }
   if(c.family == AFM_FAM_BOOL_G)
   {
      bool b = false;
      if(!AFM_GetBoolG(sn, c.field, b))
         return false;
      return (b == c.bval);
   }
   return false;
}
bool AFM_BuildNumTFCandidate(bool is_buy, ENUM_AFM_OBJECTIVE obj,
                             int tf, int field, SAFMCandidate &out)
{
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   double sum_good = 0.0, sum_bad = 0.0;
   int n_good = 0, n_bad = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;
      double v = 0.0;
      if(!AFM_GetNumTF(g_snapshots[i], tf, field, v)) continue;
      if(AFM_IsBad(g_snapshots[i], obj)) { sum_bad += v; n_bad++; }
      else                               { sum_good += v; n_good++; }
   }
   ArrayFree(is_train);
   if(n_good < 20 || n_bad < 15) return false;
   double mean_good = sum_good / n_good;
   double mean_bad  = sum_bad  / n_bad;
   double diff  = MathAbs(mean_good - mean_bad);
   double scale = (MathAbs(mean_good) + MathAbs(mean_bad)) / 2.0;
   if(scale < 0.000001) scale = 1.0;
   if((diff / scale) < 0.07 && diff < 0.5) return false;
   out.Reset();
   out.family    = AFM_FAM_NUM_TF;
   out.tf        = tf;
   out.field     = field;
   out.threshold = (mean_good + mean_bad) / 2.0;
   out.cmp       = (mean_good > mean_bad) ? AFM_CMP_GE : AFM_CMP_LE;
   out.name      = g_tf[tf].name + " " + AFM_NumTFLabel(field) + " " +
                   ((out.cmp == AFM_CMP_GE) ? ">=" : "<=") + " " +
                   AFM_ThrToStr(out.threshold);
   return true;
}
bool AFM_BuildNumGCandidate(bool is_buy, ENUM_AFM_OBJECTIVE obj,
                            int field, SAFMCandidate &out)
{
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   double sum_good = 0.0, sum_bad = 0.0;
   int n_good = 0, n_bad = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;
      double v = 0.0;
      if(!AFM_GetNumG(g_snapshots[i], field, v)) continue;
      if(AFM_IsBad(g_snapshots[i], obj)) { sum_bad += v; n_bad++; }
      else                               { sum_good += v; n_good++; }
   }
   ArrayFree(is_train);
   if(n_good < 20 || n_bad < 15) return false;
   double mean_good = sum_good / n_good;
   double mean_bad  = sum_bad  / n_bad;
   double diff  = MathAbs(mean_good - mean_bad);
   double scale = (MathAbs(mean_good) + MathAbs(mean_bad)) / 2.0;
   if(scale < 0.000001) scale = 1.0;
   if((diff / scale) < 0.07 && diff < 0.5) return false;
   out.Reset();
   out.family    = AFM_FAM_NUM_G;
   out.tf        = -1;
   out.field     = field;
   out.threshold = (mean_good + mean_bad) / 2.0;
   out.cmp       = (mean_good > mean_bad) ? AFM_CMP_GE : AFM_CMP_LE;
   out.name      = AFM_NumGLabel(field) + " " +
                   ((out.cmp == AFM_CMP_GE) ? ">=" : "<=") + " " +
                   AFM_ThrToStr(out.threshold);
   return true;
}
bool AFM_BuildStrTFCandidate(bool is_buy, ENUM_AFM_OBJECTIVE obj,
                             int tf, int field, SAFMCandidate &out)
{
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   string keys[24];
   int good_cnt[24], bad_cnt[24];
   ArrayInitialize(good_cnt, 0);
   ArrayInitialize(bad_cnt, 0);
   for(int i = 0; i < 24; i++) keys[i] = "";
   int used = 0, total_good = 0, total_bad = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;
      string s = "";
      if(!AFM_GetStrTF(g_snapshots[i], tf, field, s)) continue;
      int idx_k = -1;
      for(int k = 0; k < used; k++)
         if(keys[k] == s) { idx_k = k; break; }
      if(idx_k < 0)
      {
         if(used >= 24) continue;
         idx_k = used;
         keys[used] = s;
         used++;
      }
      if(AFM_IsBad(g_snapshots[i], obj)) { bad_cnt[idx_k]++; total_bad++; }
      else                               { good_cnt[idx_k]++; total_good++; }
   }
   ArrayFree(is_train);
   if(total_good < 20 || total_bad < 15 || used <= 0) return false;
   int best_idx = -1, best_good = -1;
   for(int i = 0; i < used; i++)
      if(good_cnt[i] > best_good) { best_good = good_cnt[i]; best_idx = i; }
   if(best_idx < 0) return false;
   double good_pct = best_good * 100.0 / total_good;
   double bad_pct  = (total_bad > 0) ? (bad_cnt[best_idx] * 100.0 / total_bad) : 0.0;
   if(good_pct < 35.0) return false;
   if((good_pct - bad_pct) < 10.0) return false;
   out.Reset();
   out.family = AFM_FAM_STR_TF;
   out.tf     = tf;
   out.field  = field;
   out.cmp    = AFM_CMP_EQ_STR;
   out.sval   = keys[best_idx];
   out.name   = g_tf[tf].name + " " + AFM_StrTFLabel(field) + " = " + out.sval;
   return true;
}
bool AFM_BuildBoolGCandidate(bool is_buy, ENUM_AFM_OBJECTIVE obj,
                             int field, SAFMCandidate &out)
{
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   int good_true = 0, good_false = 0, bad_true = 0, bad_false = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(!is_train[i]) continue;
      bool b = false;
      if(!AFM_GetBoolG(g_snapshots[i], field, b)) continue;
      if(AFM_IsBad(g_snapshots[i], obj))
      {
         if(b) bad_true++; else bad_false++;
      }
      else
      {
         if(b) good_true++; else good_false++;
      }
   }
   ArrayFree(is_train);
   int total_good = good_true + good_false;
   int total_bad  = bad_true  + bad_false;
   if(total_good < 20 || total_bad < 15) return false;
   double good_true_pct = good_true * 100.0 / total_good;
   double bad_true_pct  = bad_true  * 100.0 / total_bad;
   bool prefer_true     = (good_true_pct > bad_true_pct);
   double diff = MathAbs(good_true_pct - bad_true_pct);
   if(diff < 10.0) return false;
   out.Reset();
   out.family = AFM_FAM_BOOL_G;
   out.tf     = -1;
   out.field  = field;
   out.cmp    = AFM_CMP_EQ_BOOL;
   out.bval   = prefer_true;
   out.name   = AFM_BoolGLabel(field) + " = " + string(prefer_true ? "TRUE" : "FALSE");
   return true;
}
void AFM_EvaluateCandidate(SAFMCandidate &c, bool is_buy,
                           ENUM_AFM_OBJECTIVE obj, SAFMEval &ev)
{
   ev.Reset();
   ev.filter_name = c.name;
   ev.src_cand    = c;
   if(c.cmp == AFM_CMP_GE)      ev.skip_rule = "ALLOW if >= " + AFM_ThrToStr(c.threshold);
   else if(c.cmp == AFM_CMP_LE) ev.skip_rule = "ALLOW if <= " + AFM_ThrToStr(c.threshold);
   else if(c.cmp == AFM_CMP_EQ_STR)  ev.skip_rule = "ALLOW if == " + c.sval;
   else if(c.cmp == AFM_CMP_EQ_BOOL) ev.skip_rule = "ALLOW if == " + string(c.bval ? "TRUE" : "FALSE");
   // Build temporal split — EVAL set is the held-out 30%
   bool is_train[];
   AFM_GetSplitIndices(is_train);
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!AFM_ContextMatch(g_snapshots[i], is_buy)) continue;
      if(is_train[i]) continue;  // eval set only (held-out)
      ev.total++;
      bool bad = AFM_IsBad(g_snapshots[i], obj);
      if(bad) ev.bad_total++;
      if(g_snapshots[i].final_profit > 0) ev.total_wins++;
      if(AFM_CandidateMatch(g_snapshots[i], c))
      {
         ev.accepted++;
         if(bad) ev.accepted_bad++;
         if(g_snapshots[i].final_profit > 0) ev.accepted_wins++;
         ev.accepted_profit += g_snapshots[i].final_profit;
      }
      else
      {
         ev.rejected++;
         if(bad) ev.rejected_bad++;
         if(g_snapshots[i].final_profit > 0) ev.rejected_wins++;
         ev.rejected_profit += g_snapshots[i].final_profit;
      }
   }
   ArrayFree(is_train);
   if(ev.total <= 0 || ev.accepted < 15) { ev.score = -999999.0; return; }
   ev.baseline_bad_pct = ev.bad_total * 100.0 / ev.total;
   ev.baseline_wr      = ev.total_wins * 100.0 / ev.total;
   ev.coverage_pct     = ev.accepted * 100.0 / ev.total;
   ev.accepted_bad_pct = ev.accepted_bad * 100.0 / ev.accepted;
   ev.rejected_bad_pct = (ev.rejected > 0) ? (ev.rejected_bad * 100.0 / ev.rejected) : 0.0;
   ev.reduction_pct    = ev.baseline_bad_pct - ev.accepted_bad_pct;
   ev.accepted_wr      = ev.accepted_wins * 100.0 / ev.accepted;
   ev.accepted_avgp    = ev.accepted_profit / ev.accepted;
   ev.score = (ev.reduction_pct * 8.0)
            + (MathMin(ev.coverage_pct, 60.0) * 0.15)
            + (MathMax(0.0, ev.rejected_bad_pct - ev.accepted_bad_pct) * 1.5);
   if(ev.coverage_pct < 20.0)   ev.score *= 0.2;
   if(ev.reduction_pct <= 0.5)  ev.score *= 0.01;
}
void AFM_SortEvals(SAFMEval &arr[], int count)
{
   // Shell Sort: O(n log²n)
   int gap = count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < count; i++)
      {
         SAFMEval temp = arr[i];
         int j = i;
         while(j >= gap && arr[j - gap].score < temp.score)
         {
            arr[j] = arr[j - gap];
            j -= gap;
         }
         arr[j] = temp;
      }
      gap /= 2;
   }
}
int AFM_BuildCandidates(bool is_buy, ENUM_AFM_OBJECTIVE obj, SAFMCandidate &cands[])
{
   ArrayResize(cands, AFM_MAX_CANDIDATES);
   int cc = 0;
   SAFMCandidate c;
   // ========= Numeric TF features: multi-threshold mining =========
   for(int tf = 0; tf < TF_COUNT && cc < AFM_MAX_CANDIDATES; tf++)
   {
      for(int f = AFM_NUMTF_RSI; f <= AFM_NUMTF_EMA_COMP && cc < AFM_MAX_CANDIDATES; f++)
      {
         AFM_AddNumTFCandidatesMulti(is_buy, obj, tf, f, cands, cc);
      }
      // ========= String TF features: dominant candidate =========
      for(int f = AFM_STRTF_DI; f <= AFM_STRTF_POS && cc < AFM_MAX_CANDIDATES; f++)
      {
         if(AFM_BuildStrTFCandidate(is_buy, obj, tf, f, c))
            AFM_AddCandidateUnique(cands, cc, c);
      }
   }
   // ========= Numeric Global features: multi-threshold mining =========
   for(int f = AFM_NUMG_STABILITY; f <= AFM_NUMG_OB_WIDTH && cc < AFM_MAX_CANDIDATES; f++)
   {
      AFM_AddNumGCandidatesMulti(is_buy, obj, f, cands, cc);
   }
   // ========= Bool Global features =========
   for(int f = AFM_BOOLG_HTF_CONFLICT; f <= AFM_BOOLG_HTF_CONFLICT && cc < AFM_MAX_CANDIDATES; f++)
   {
      if(AFM_BuildBoolGCandidate(is_buy, obj, f, c))
         AFM_AddCandidateUnique(cands, cc, c);
   }
   return cc;
}
void AFM_WriteOneTableFromEvals(int h, bool is_buy, ENUM_AFM_OBJECTIVE obj,
                                SAFMEval &evals[], int ec)
{
   string title = AFM_ContextName(is_buy) + " | " + AFM_ObjectiveName(obj);
   string html = "<details style=\"margin:12px 0;background:rgba(0,0,0,0.25);border:1px solid #333;border-radius:10px;padding:10px;\" open>\r\n";
   html += "<summary style=\"cursor:pointer;color:#00d4ff;font-weight:bold;\">" + title + "</summary>\r\n";
   html += "<div style=\"color:#888;font-size:10px;margin-top:6px;padding:6px;background:rgba(0,0,0,0.2);border-radius:4px;\">";
   html += (inp_use_persian_language ?
      "⚠ این نتایج از eval set (50% داده‌ها) محاسبه شده‌اند — threshold از train set. حداقل نمونه eval: 15" :
      "⚠ Results computed on eval set (50% of data) — threshold from train set. Min eval sample: 15");
   html += "</div>\r\n";
   html += "<div style=\"color:#aaa;font-size:11px;line-height:1.8;margin-top:8px;\">";
   html += (inp_use_persian_language ?
            "منطق جدول: شرطی که اگر آن را به‌عنوان فیلتر ورود استفاده کنی، نرخ Step4+/Stop در معاملات پذیرفته‌شده کمتر می‌شود." :
            "Meaning: if you use this condition as an entry filter, accepted trades should show lower Step4+/Stop rate.");
   html += "</div>\r\n";
   html += "<div style=\"overflow:auto;margin-top:8px;\">\r\n";
   html += "<table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>#</th>";
   html += "<th>Condition</th>";
   html += "<th>Accepted</th>";
   html += "<th>Coverage%</th>";
   html += "<th>Baseline Bad%</th>";
   html += "<th>Accepted Bad%</th>";
   html += "<th>Reduction%</th>";
   html += "<th>Accepted WR%</th>";
   html += "<th>AvgProfit</th>";
   html += "<th>Rejected Bad%</th>";
   html += "<th>Suggested Use</th>";
   html += "</tr>\r\n";
   int shown = MathMin(ec, 18);
   if(shown <= 0)
   {
      html += "<tr><td colspan=\"11\" style=\"color:#666;\">No strong automatic filters found</td></tr>\r\n";
   }
   else
   {
      for(int i = 0; i < shown; i++)
      {
         string c_red = (evals[i].reduction_pct >= 10.0) ? "#00ff88" :
                        (evals[i].reduction_pct >= 5.0)  ? "#ffff00" :
                        (evals[i].reduction_pct > 0.0)   ? "#ffa500" : "#ff4444";
         string c_cov = (evals[i].coverage_pct >= 60.0) ? "#00ff88" :
                        (evals[i].coverage_pct >= 40.0) ? "#ffff00" : "#ffa500";
         string c_profit = (evals[i].accepted_avgp >= 0.0 ? "#00ff88" : "#ff4444");
         html += "<tr>";
         html += "<td>" + IntegerToString(i + 1) + "</td>";
         html += "<td style=\"text-align:left;font-family:Consolas,monospace;\">" + evals[i].filter_name + "</td>";
         html += "<td>" + IntegerToString(evals[i].accepted) + "/" + IntegerToString(evals[i].total) + "</td>";
         html += "<td style=\"color:" + c_cov + ";\">" + DoubleToString(evals[i].coverage_pct, 1) + "%</td>";
         html += "<td>" + DoubleToString(evals[i].baseline_bad_pct, 1) + "%</td>";
         html += "<td style=\"color:#00ff88;\">" + DoubleToString(evals[i].accepted_bad_pct, 1) + "%</td>";
         html += "<td style=\"color:" + c_red + ";font-weight:bold;\">-" + DoubleToString(evals[i].reduction_pct, 1) + "%</td>";
         html += "<td>" + DoubleToString(evals[i].accepted_wr, 1) + "%</td>";
         html += "<td style=\"color:" + c_profit + ";\">$" + DoubleToString(evals[i].accepted_avgp, 2) + "</td>";
         html += "<td>" + DoubleToString(evals[i].rejected_bad_pct, 1) + "%</td>";
         html += "<td style=\"text-align:left;font-size:10px;color:#aaa;\">" + evals[i].skip_rule + "</td>";
         html += "</tr>\r\n";
      }
   }
   html += "</table></div>\r\n";
   html += "</details>\r\n";
   FileWriteString(h, html);
}
void WriteAutoFilterMiningSection(int h)
{
   if(g_snapshot_count < 50)
   {
      FileWriteString(h,
         "<div class=\"section\"><div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">🤖 Auto Filter Mining</div>"
         "<div class=\"no-data\">Need at least 50 snapshots. Current: " + IntegerToString(g_snapshot_count) + "</div></div>\r\n");
      return;
   }
   string html = "<div class=\"section\">\r\n";
   html += "<div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">🤖 Auto Filter Mining (Single + Combo)</div>\r\n";
   html += "<div style=\"color:#aaa;font-size:11px;line-height:1.8;\">";
   html += (inp_use_persian_language ?
            "این بخش تمام فیلدهای Snapshot را اسکن می‌کند و فیلترهای تک‌شرطی و دوشرطی (AND) پیشنهاد می‌دهد." :
            "This section scans ALL snapshot fields and suggests single AND combo (two-condition) filters.");
   html += "</div>\r\n";
   FileWriteString(h, html);
   for(int side = 0; side < 2; side++)
   {
      bool is_buy = (side == 0);
      for(int ob = 0; ob < 2; ob++)
      {
         ENUM_AFM_OBJECTIVE obj = (ENUM_AFM_OBJECTIVE)ob;
         SAFMCandidate cands[];
         int cc = AFM_BuildCandidates(is_buy, obj, cands);
         SAFMEval evals[];
         ArrayResize(evals, AFM_MAX_EVALS);
         int ec = 0;
         for(int i = 0; i < cc && ec < AFM_MAX_EVALS; i++)
         {
            SAFMEval ev;
            AFM_EvaluateCandidate(cands[i], is_buy, obj, ev);
            if(ev.score > -1000.0)
               evals[ec++] = ev;
         }
         AFM_SortEvals(evals, ec);
         AFM_WriteOneTableFromEvals(h, is_buy, obj, evals, ec);
         AFM_WriteComboTable(h, is_buy, obj, evals, ec);
         ArrayFree(cands);
         ArrayResize(evals, 0);
      }
   }
   FileWriteString(h, "</div>\r\n");
}
void ExportAutoFilterSuggestionsCSV()
{
   if(g_snapshot_count < 50)
      return;
   string fn = inp_export_file_name + "_" + g_symbol_name + "_AutoFilters.csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE)
   {
      LogError("Cannot create AutoFilters CSV: " + fn);
      return;
   }
   FileWriteString(h, "Context,Objective,Rank,Condition,Accepted,Total,CoveragePct,BaselineBadPct,AcceptedBadPct,ReductionPct,AcceptedWR,AcceptedAvgProfit,RejectedBadPct,SuggestedUse\r\n");
   for(int side = 0; side < 2; side++)
   {
      bool is_buy = (side == 0);
      // ✅ فقط ASCII - نه فارسی
      string context_str = is_buy ? "BUY" : "SELL";
      for(int ob = 0; ob < 2; ob++)
      {
         ENUM_AFM_OBJECTIVE obj = (ENUM_AFM_OBJECTIVE)ob;
         // ✅ فقط ASCII
         string obj_str = (obj == AFM_OBJ_STOP) ? "ReduceSTOP" : "AvoidStep4+";
         SAFMCandidate cands[];
         int cc = AFM_BuildCandidates(is_buy, obj, cands);
         SAFMEval evals[];
         ArrayResize(evals, AFM_MAX_EVALS);
         int ec = 0;
         for(int i = 0; i < cc && ec < AFM_MAX_EVALS; i++)
         {
            SAFMEval ev;
            AFM_EvaluateCandidate(cands[i], is_buy, obj, ev);
            if(ev.score > -1000.0)
               evals[ec++] = ev;
         }
         AFM_SortEvals(evals, ec);
         int shown = MathMin(ec, 20);
         for(int r = 0; r < shown; r++)
         {
            string row = "";
            row += context_str + ",";
            row += obj_str + ",";
            row += IntegerToString(r + 1) + ",";
            row += EscapeCSV(evals[r].filter_name) + ",";
            row += IntegerToString(evals[r].accepted) + ",";
            row += IntegerToString(evals[r].total) + ",";
            row += DoubleToString(evals[r].coverage_pct, 2) + ",";
            row += DoubleToString(evals[r].baseline_bad_pct, 2) + ",";
            row += DoubleToString(evals[r].accepted_bad_pct, 2) + ",";
            row += DoubleToString(evals[r].reduction_pct, 2) + ",";
            row += DoubleToString(evals[r].accepted_wr, 2) + ",";
            row += DoubleToString(evals[r].accepted_avgp, 2) + ",";
            row += DoubleToString(evals[r].rejected_bad_pct, 2) + ",";
            row += EscapeCSV(evals[r].skip_rule) + "\r\n";
            FileWriteString(h, row);
         }
         ArrayFree(cands);
         ArrayResize(evals, 0);
      }
   }
   FileFlush(h);
   FileClose(h);
   Print("AutoFilters CSV exported: ", fn);
}
void RL_ExportThresholdValidation()
{
   if(g_snapshot_count < 50) return;
   string fn = "RiskLab_ThresholdValidation_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ|FILE_WRITE|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   FileSeek(h, 0, SEEK_END);
   // Header
   string hdr = "Side,Target,Feature_Condition,";
   hdr += "DEV_Total,DEV_Accepted,DEV_Cov%,DEV_BaseBad%,DEV_AccBad%,DEV_Reduction%,";
   hdr += "OOS_Total,OOS_Accepted,OOS_Cov%,OOS_BaseBad%,OOS_AccBad%,OOS_Reduction%,";
   hdr += "Stability_Score,Verdict";
   FileWriteString(h, hdr + "\r\n");
   string sides[2] = {"BUY", "SELL"};
   for(int si=0; si<2; si++)
   {
      string side = sides[si];
      for(int ob=0; ob<2; ob++)
      {
         ENUM_AFM_OBJECTIVE obj = (ENUM_AFM_OBJECTIVE)ob;
         string tname = (obj == AFM_OBJ_STOP ? "StopFlag" : "HitStep4Plus");
         // ساخت کاندیداها (دقیقا مشابه منطق AutoFilter)
         SAFMCandidate cands[];
         int cc = AFM_BuildCandidates((side=="BUY"), obj, cands);
         for(int i=0; i<cc; i++)
         {
            // ارزیابی جداگانه روی DEV و OOS
            int d_tot=0, d_bad=0, d_acc=0, d_acc_bad=0;
            int o_tot=0, o_bad=0, o_acc=0, o_acc_bad=0;
            for(int j=0; j<g_snapshot_count; j++)
            {
               if(g_snapshots[j].is_bullish != (side=="BUY")) continue;
               bool bad = AFM_IsBad(g_snapshots[j], obj);
               bool pass = AFM_CandidateMatch(g_snapshots[j], cands[i]);
               bool is_oos = g_snapshots[j].entry_time >= g_risklab_dev_cutoff;
               if(!is_oos) {
                  d_tot++; if(bad) d_bad++;
                  if(pass) { d_acc++; if(bad) d_acc_bad++; }
               } else {
                  o_tot++; if(bad) o_bad++;
                  if(pass) { o_acc++; if(bad) o_acc_bad++; }
               }
            }
            if(d_tot < 20 || o_tot < 10 || d_acc < 5 || o_acc < 5) continue;
            double d_base_rate = d_bad * 100.0 / d_tot;
            double d_acc_rate  = d_acc_bad * 100.0 / d_acc;
            double d_red       = d_base_rate - d_acc_rate;
            double o_base_rate = o_bad * 100.0 / o_tot;
            double o_acc_rate  = o_acc_bad * 100.0 / o_acc;
            double o_red       = o_base_rate - o_acc_rate;
            // محاسبه اسکور پایداری (هرچه اختلاف کاهش ریسک در DEV و OOS کمتر باشد بهتر است)
            double stab_score = 0;
            if(d_red > 0 && o_red > 0) stab_score = MathMin(d_red, o_red) / MathMax(d_red, o_red);
            if(d_red <= 0 || o_red <= 0) stab_score = -1.0;
            string verdict = "UNSTABLE";
            if(d_red > 1.0 && o_red > 0.5) {
               if(stab_score > 0.6) verdict = "RELIABLE";
               else if(stab_score > 0.3) verdict = "POTENTIAL";
            }
            if(o_red > d_red + 2.0 && o_red > 1.0) verdict = "OOS_SUPERIOR";
            // خروجی فقط برای فیلترهایی که حداقل کمی در DEV موثر بودند
            if(d_red > 0.5)
            {
               string row = side + "," + tname + "," + EscapeCSV(cands[i].name) + ",";
               row += IntegerToString(d_tot) + "," + IntegerToString(d_acc) + "," + DoubleToString(d_acc*100.0/d_tot,1) + ",";
               row += DoubleToString(d_base_rate,2) + "," + DoubleToString(d_acc_rate,2) + "," + DoubleToString(d_red,2) + ",";
               row += IntegerToString(o_tot) + "," + IntegerToString(o_acc) + "," + DoubleToString(o_acc*100.0/o_tot,1) + ",";
               row += DoubleToString(o_base_rate,2) + "," + DoubleToString(o_acc_rate,2) + "," + DoubleToString(o_red,2) + ",";
               row += DoubleToString(stab_score,2) + "," + verdict;
               FileWriteString(h, row + "\r\n");
            }
         }
         ArrayFree(cands);
      }
   }
   FileClose(h);
   Print("RiskLab Threshold Validation exported.");
}
//|Reset All Analysis Data - NEW FUNCTION|
void ResetAllAnalysisData()
{
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
