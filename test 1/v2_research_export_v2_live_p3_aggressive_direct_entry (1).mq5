//|Get Tooltip for Header Column - v8.1|
string GetHeaderTooltip(string header)
{
   //Map header names to indicators
   if(header == g_lang.rsi|| header == "RSI")           return g_lang.tooltip_rsi;
   if(header == g_lang.adx|| header == "ADX")           return g_lang.tooltip_adx;
   if(header == g_lang.di|| header == "DI")             return g_lang.tooltip_di;
   if(header == g_lang.cci|| header == "CCI")           return g_lang.tooltip_cci;
   if(header == g_lang.atr|| header == "ATR")           return g_lang.tooltip_atr;
   if(header == g_lang.ema_order|| header == "EMA")     return g_lang.tooltip_ema;
   if(header == g_lang.pivot1|| header == "Pivot")      return g_lang.tooltip_pivot;
   if(header == g_lang.pivot2)                           return g_lang.tooltip_pivot;
   if(header == g_lang.step|| header == "Step")         return g_lang.tooltip_step;
   if(header == g_lang.stability|| header == "Stab")    return g_lang.tooltip_stability;
   if(header == g_lang.win_rate|| header == "WR")       return g_lang.tooltip_win_rate;
   if(header == g_lang.expectancy)                       return g_lang.tooltip_expectancy;
   if(header == g_lang.profit_factor|| header == "PF")  return g_lang.tooltip_profit_factor;
   if(header == g_lang.mtf_agreement|| header == "MTF") return g_lang.tooltip_mtf;
   if(header == g_lang.sample|| header == "Sample")     return g_lang.tooltip_sample_size;
   return "";
}
//|Build Table Header with Tooltip - v8.1|
string BuildTableHeader(string header_text, string indicator_key = "")
{
   string tooltip = "";
   if(indicator_key != "")
      tooltip = GetIndicatorTooltip(indicator_key);
   if(tooltip == "")
      tooltip = GetHeaderTooltip(header_text);
   if(tooltip == "")
      return "<th>" + header_text + "</th>";
   string safe = EscapeHTMLAttr(tooltip);
   return "<th class=\"has-tooltip\" title=\"" + safe + "\">" +
          header_text + BuildHelpIcon(tooltip) + "</th>";
}
//|Range Data Structure (for RSI, ADX ranges)|
struct SRangeData
{
   int range_start;
   int range_end;
   int count;
   double total_profit;
   int win_count;
   int loss_count;
   void Reset()
   {
      range_start = range_end = count = win_count = loss_count = 0;
      total_profit = 0;
   }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
   double GetAvgProfit() { return (count > 0) ? (total_profit / count) : 0; }
};
//|Event Data Structure (for close events)|
struct SEventData
{
   string event;
   int count;
   double total_profit;
   int win_count;
   void Reset() { event = ""; count = win_count = 0; total_profit = 0; }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
   double GetAvgProfit() { return (count > 0) ? (total_profit / count) : 0; }
};
//|DI Status Data Structure|
struct SDIStatusData
{
   string status;
   int count;
   double total_profit;
   int win_count;
   void Reset() { status = ""; count = win_count = 0; total_profit = 0; }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
};
//|ATR Range Data Structure|
struct SATRRangeData
{
   double range_start;
   double range_end;
   int count;
   double total_profit;
   int win_count;
   void Reset() { range_start = range_end = total_profit = 0; count = win_count = 0; }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
};
//|Pivot Distance Data Structure|
struct SPivotDistData
{
   int dist;
   int count;
   double total_profit;
   int win_count;
   void Reset() { dist = count = win_count = 0; total_profit = 0; }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
};
//|Pattern Data Structure (for EMA patterns)|
struct SPatternData
{
   string pattern;
   int count;
   double total_profit;
   int win_count;
   void Reset() { pattern = ""; count = win_count = 0; total_profit = 0; }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
   double GetAvgProfit() { return (count > 0) ? (total_profit / count) : 0; }
};
//|EMA Value Structure (for sorting)|
struct SEMAValue
{
   double value;
   int id;
};
//|ORDER BLOCK STRUCTURE|
struct SOrderBlock
{
   double high, low, mid;
   datetime time;
   bool is_valid;
   void Reset() { high = low = mid = 0; time = 0; is_valid = false; }
   void Set(double h, double l, datetime t) { high = h; low = l; mid = (h + l) / 2.0; time = t; is_valid = true; }
};
//|TIMEFRAME DATA STRUCTURE|
//|TIMEFRAME DATA STRUCTURE|
//====================================================================
// v2.0
// Expanded for research dataset:
// - MACD
// - Bollinger Bands
// - Stochastic
// - Williams %R
//
// Design rule:
// Base trading indicators are REQUIRED.
// Research-only indicators are OPTIONAL and should not break EA logic.
//====================================================================
struct STimeframeData
{
   ENUM_TIMEFRAMES timeframe;
   string name;
   //================ REQUIRED HANDLES (EA core logic) ================
   int handle_rsi;
   int handle_atr;
   int handle_adx;
   int handle_cci;
   int handle_ema_20;
   int handle_ema_50;
   int handle_ema_100;
   int handle_ema_200;
   //================ OPTIONAL HANDLES (research dataset) =============
   int handle_macd;
   int handle_bb;
   int handle_stoch;
   int handle_wpr;
   //================ REQUIRED BUFFERS ================================
   double buffer_rsi[];
   double buffer_atr[];
   double buffer_adx[];
   double buffer_cci[];
   double buffer_varsi[];  // VA-RSI
   double buffer_plus_di[];
   double buffer_minus_di[];
   double buffer_ema_20[];
   double buffer_ema_50[];
   double buffer_ema_100[];
   double buffer_ema_200[];
   //================ OPTIONAL BUFFERS ================================
   // MACD
   double buffer_macd_main[];
   double buffer_macd_signal[];
   double buffer_macd_hist[];
   // Bollinger
   double buffer_bb_upper[];
   double buffer_bb_lower[];
   double buffer_bb_middle[];
   // Stochastic
   double buffer_stoch_k[];
   double buffer_stoch_d[];
   // Williams %R
   double buffer_wpr[];
   void Initialize(ENUM_TIMEFRAMES tf, string tf_name, int buffer_size)
   {
      timeframe = tf;
      name = tf_name;
      // required
      handle_rsi     = INVALID_HANDLE;
      handle_atr     = INVALID_HANDLE;
      handle_adx     = INVALID_HANDLE;
      handle_cci     = INVALID_HANDLE;
      handle_ema_20  = INVALID_HANDLE;
      handle_ema_50  = INVALID_HANDLE;
      handle_ema_100 = INVALID_HANDLE;
      handle_ema_200 = INVALID_HANDLE;
      // optional
      handle_macd  = INVALID_HANDLE;
      handle_bb    = INVALID_HANDLE;
      handle_stoch = INVALID_HANDLE;
      handle_wpr   = INVALID_HANDLE;
      // required buffers
      ArrayResize(buffer_rsi,       buffer_size);
      ArrayResize(buffer_atr,       buffer_size);
      ArrayResize(buffer_adx,       buffer_size);
      ArrayResize(buffer_cci,       buffer_size);
      ArrayResize(buffer_varsi,     buffer_size);
      ArrayResize(buffer_plus_di,   buffer_size);
      ArrayResize(buffer_minus_di,  buffer_size);
      ArrayResize(buffer_ema_20,    buffer_size);
      ArrayResize(buffer_ema_50,    buffer_size);
      ArrayResize(buffer_ema_100,   buffer_size);
      ArrayResize(buffer_ema_200,   buffer_size);
      // optional buffers
      ArrayResize(buffer_macd_main,   buffer_size);
      ArrayResize(buffer_macd_signal, buffer_size);
      ArrayResize(buffer_macd_hist,   buffer_size);
      ArrayResize(buffer_bb_upper,    buffer_size);
      ArrayResize(buffer_bb_lower,    buffer_size);
      ArrayResize(buffer_bb_middle,   buffer_size);
      ArrayResize(buffer_stoch_k,     buffer_size);
      ArrayResize(buffer_stoch_d,     buffer_size);
      ArrayResize(buffer_wpr,         buffer_size);
      SetBuffersAsSeries();
      // initialize optional buffers to zero
      ArrayInitialize(buffer_macd_main,   0.0);
      ArrayInitialize(buffer_macd_signal, 0.0);
      ArrayInitialize(buffer_macd_hist,   0.0);
      ArrayInitialize(buffer_bb_upper,    0.0);
      ArrayInitialize(buffer_bb_lower,    0.0);
      ArrayInitialize(buffer_bb_middle,   0.0);
      ArrayInitialize(buffer_stoch_k,     0.0);
      ArrayInitialize(buffer_stoch_d,     0.0);
      ArrayInitialize(buffer_wpr,         0.0);
   }
   void SetBuffersAsSeries()
   {
      // required
      ArraySetAsSeries(buffer_rsi, true);
      ArraySetAsSeries(buffer_atr, true);
      ArraySetAsSeries(buffer_adx, true);
      ArraySetAsSeries(buffer_cci, true);
      ArraySetAsSeries(buffer_varsi, true);
      ArraySetAsSeries(buffer_plus_di, true);
      ArraySetAsSeries(buffer_minus_di, true);
      ArraySetAsSeries(buffer_ema_20, true);
      ArraySetAsSeries(buffer_ema_50, true);
      ArraySetAsSeries(buffer_ema_100, true);
      ArraySetAsSeries(buffer_ema_200, true);
      // optional
      ArraySetAsSeries(buffer_macd_main, true);
      ArraySetAsSeries(buffer_macd_signal, true);
      ArraySetAsSeries(buffer_macd_hist, true);
      ArraySetAsSeries(buffer_bb_upper, true);
      ArraySetAsSeries(buffer_bb_lower, true);
      ArraySetAsSeries(buffer_bb_middle, true);
      ArraySetAsSeries(buffer_stoch_k, true);
      ArraySetAsSeries(buffer_stoch_d, true);
      ArraySetAsSeries(buffer_wpr, true);
   }
   void FreeBuffers()
   {
      // required
      ArrayFree(buffer_rsi);
      ArrayFree(buffer_atr);
      ArrayFree(buffer_adx);
      ArrayFree(buffer_cci);
      ArrayFree(buffer_varsi);
      ArrayFree(buffer_plus_di);
      ArrayFree(buffer_minus_di);
      ArrayFree(buffer_ema_20);
      ArrayFree(buffer_ema_50);
      ArrayFree(buffer_ema_100);
      ArrayFree(buffer_ema_200);
      // optional
      ArrayFree(buffer_macd_main);
      ArrayFree(buffer_macd_signal);
      ArrayFree(buffer_macd_hist);
      ArrayFree(buffer_bb_upper);
      ArrayFree(buffer_bb_lower);
      ArrayFree(buffer_bb_middle);
      ArrayFree(buffer_stoch_k);
      ArrayFree(buffer_stoch_d);
      ArrayFree(buffer_wpr);
   }
   bool CreateIndicatorHandles(string symbol, int rsi_p, int atr_p, int adx_p, int cci_p)
   {
      //================ REQUIRED =================
      handle_rsi     = iRSI(symbol, timeframe, rsi_p, PRICE_CLOSE);
      handle_atr     = iATR(symbol, timeframe, atr_p);
      handle_adx     = iADX(symbol, timeframe, adx_p);
      handle_cci     = iCCI(symbol, timeframe, cci_p, PRICE_TYPICAL);
      handle_ema_20  = iMA(symbol, timeframe, 20,  0, MODE_EMA, PRICE_CLOSE);
      handle_ema_50  = iMA(symbol, timeframe, 50,  0, MODE_EMA, PRICE_CLOSE);
      handle_ema_100 = iMA(symbol, timeframe, 100, 0, MODE_EMA, PRICE_CLOSE);
      handle_ema_200 = iMA(symbol, timeframe, 200, 0, MODE_EMA, PRICE_CLOSE);
      bool base_ok =
         (handle_rsi     != INVALID_HANDLE &&
          handle_atr     != INVALID_HANDLE &&
          handle_adx     != INVALID_HANDLE &&
          handle_cci     != INVALID_HANDLE &&
          handle_ema_20  != INVALID_HANDLE &&
          handle_ema_50  != INVALID_HANDLE &&
          handle_ema_100 != INVALID_HANDLE &&
          handle_ema_200 != INVALID_HANDLE);
      if(!base_ok)
         return false;
      //================ OPTIONAL (research only) =================
      handle_macd  = iMACD(symbol, timeframe, 12, 26, 9, PRICE_CLOSE);
      handle_bb    = iBands(symbol, timeframe, 20, 0, 2.0, PRICE_CLOSE);
      handle_stoch = iStochastic(symbol, timeframe, 5, 3, 3, MODE_SMA, STO_LOWHIGH);
      handle_wpr   = iWPR(symbol, timeframe, 14);
      // Optional handles may fail; do not fail EA init because of them
      if(handle_macd  == INVALID_HANDLE) Print("WARNING: Optional MACD handle failed for ", name);
      if(handle_bb    == INVALID_HANDLE) Print("WARNING: Optional BB handle failed for ", name);
      if(handle_stoch == INVALID_HANDLE) Print("WARNING: Optional Stoch handle failed for ", name);
      if(handle_wpr   == INVALID_HANDLE) Print("WARNING: Optional WPR handle failed for ", name);
      return true;
   }
   void ReleaseHandles()
   {
      // required
      if(handle_rsi     != INVALID_HANDLE) { IndicatorRelease(handle_rsi);     handle_rsi = INVALID_HANDLE; }
      if(handle_atr     != INVALID_HANDLE) { IndicatorRelease(handle_atr);     handle_atr = INVALID_HANDLE; }
      if(handle_adx     != INVALID_HANDLE) { IndicatorRelease(handle_adx);     handle_adx = INVALID_HANDLE; }
      if(handle_cci     != INVALID_HANDLE) { IndicatorRelease(handle_cci);     handle_cci = INVALID_HANDLE; }
      if(handle_ema_20  != INVALID_HANDLE) { IndicatorRelease(handle_ema_20);  handle_ema_20 = INVALID_HANDLE; }
      if(handle_ema_50  != INVALID_HANDLE) { IndicatorRelease(handle_ema_50);  handle_ema_50 = INVALID_HANDLE; }
      if(handle_ema_100 != INVALID_HANDLE) { IndicatorRelease(handle_ema_100); handle_ema_100 = INVALID_HANDLE; }
      if(handle_ema_200 != INVALID_HANDLE) { IndicatorRelease(handle_ema_200); handle_ema_200 = INVALID_HANDLE; }
      // optional
      if(handle_macd  != INVALID_HANDLE) { IndicatorRelease(handle_macd);  handle_macd = INVALID_HANDLE; }
      if(handle_bb    != INVALID_HANDLE) { IndicatorRelease(handle_bb);    handle_bb = INVALID_HANDLE; }
      if(handle_stoch != INVALID_HANDLE) { IndicatorRelease(handle_stoch); handle_stoch = INVALID_HANDLE; }
      if(handle_wpr   != INVALID_HANDLE) { IndicatorRelease(handle_wpr);   handle_wpr = INVALID_HANDLE; }
   }
   bool CopyIndicatorBuffers(int count)
   {
      //================ REQUIRED =================
      bool base_ok =
         (CopyBuffer(handle_rsi, 0, 0, count, buffer_rsi) > 0 &&
          CopyBuffer(handle_atr, 0, 0, count, buffer_atr) > 0 &&
          CopyBuffer(handle_adx, MAIN_LINE,   0, count, buffer_adx) > 0 &&
          CopyBuffer(handle_adx, PLUSDI_LINE, 0, count, buffer_plus_di) > 0 &&
          CopyBuffer(handle_adx, MINUSDI_LINE,0, count, buffer_minus_di) > 0 &&
          CopyBuffer(handle_cci, 0, 0, count, buffer_cci) > 0 &&
          CopyBuffer(handle_ema_20,  0, 0, count, buffer_ema_20) > 0 &&
          CopyBuffer(handle_ema_50,  0, 0, count, buffer_ema_50) > 0 &&
          CopyBuffer(handle_ema_100, 0, 0, count, buffer_ema_100) > 0 &&
          CopyBuffer(handle_ema_200, 0, 0, count, buffer_ema_200) > 0);
      if(!base_ok)
         return false;
      //================ OPTIONAL: MACD =================
      // MQL5 iMACD has only MAIN and SIGNAL buffers.
      // Histogram is calculated manually as MAIN - SIGNAL.
      if(handle_macd != INVALID_HANDLE)
      {
         bool macd_ok =
            (CopyBuffer(handle_macd, 0, 0, count, buffer_macd_main) > 0 &&
             CopyBuffer(handle_macd, 1, 0, count, buffer_macd_signal) > 0);
         if(macd_ok)
         {
            int sz = MathMin(ArraySize(buffer_macd_main), ArraySize(buffer_macd_signal));
            if(sz > count) sz = count;
            for(int i = 0; i < sz; i++)
               buffer_macd_hist[i] = buffer_macd_main[i] - buffer_macd_signal[i];
         }
         else
         {
            ArrayInitialize(buffer_macd_main,   0.0);
            ArrayInitialize(buffer_macd_signal, 0.0);
            ArrayInitialize(buffer_macd_hist,   0.0);
         }
      }
      else
      {
         ArrayInitialize(buffer_macd_main,   0.0);
         ArrayInitialize(buffer_macd_signal, 0.0);
         ArrayInitialize(buffer_macd_hist,   0.0);
      }
      //================ OPTIONAL: BOLLINGER =================
      // iBands buffers:
      // 0 = middle
      // 1 = upper
      // 2 = lower
      if(handle_bb != INVALID_HANDLE)
      {
         bool bb_ok =
            (CopyBuffer(handle_bb, 0, 0, count, buffer_bb_middle) > 0 &&
             CopyBuffer(handle_bb, 1, 0, count, buffer_bb_upper)  > 0 &&
             CopyBuffer(handle_bb, 2, 0, count, buffer_bb_lower)  > 0);
         if(!bb_ok)
         {
            ArrayInitialize(buffer_bb_middle, 0.0);
            ArrayInitialize(buffer_bb_upper,  0.0);
            ArrayInitialize(buffer_bb_lower,  0.0);
         }
      }
      else
      {
         ArrayInitialize(buffer_bb_middle, 0.0);
         ArrayInitialize(buffer_bb_upper,  0.0);
         ArrayInitialize(buffer_bb_lower,  0.0);
      }
      //================ OPTIONAL: STOCHASTIC =================
      if(handle_stoch != INVALID_HANDLE)
      {
         bool st_ok =
            (CopyBuffer(handle_stoch, 0, 0, count, buffer_stoch_k) > 0 &&
             CopyBuffer(handle_stoch, 1, 0, count, buffer_stoch_d) > 0);
         if(!st_ok)
         {
            ArrayInitialize(buffer_stoch_k, 0.0);
            ArrayInitialize(buffer_stoch_d, 0.0);
         }
      }
      else
      {
         ArrayInitialize(buffer_stoch_k, 0.0);
         ArrayInitialize(buffer_stoch_d, 0.0);
      }
      //================ OPTIONAL: WPR =================
      if(handle_wpr != INVALID_HANDLE)
      {
         bool wpr_ok = (CopyBuffer(handle_wpr, 0, 0, count, buffer_wpr) > 0);
         if(!wpr_ok)
            ArrayInitialize(buffer_wpr, 0.0);
      }
      else
      {
         ArrayInitialize(buffer_wpr, 0.0);
      }
      return true;
   }
   double GetBufferValue(const double &buffer[], int index)
   {
      int size = ArraySize(buffer);
      if(size == 0 || index < 0 || index >= size)
         return 0.0;
      double val = buffer[index];
      return (val == EMPTY_VALUE || !MathIsValidNumber(val)) ? 0.0 : val;
   }
};
//|Calculate VA-RSI (Volatility-Adjusted RSI) - from Pine Script VA-RSI v3.6|
bool CalculateVARSI(STimeframeData &tf_data, int count)
{
   if(count < inp_rsi_period + 2)
      return false;
   int buf_size = ArraySize(tf_data.buffer_varsi);
   if(buf_size < count)
      return false;
   // Clear stale values before calculating the available causal window.
   ArrayInitialize(tf_data.buffer_varsi, 0.0);
   double close_buf[];
   ArrayResize(close_buf, count + 1);
   ArraySetAsSeries(close_buf, true);
   int copied = CopyClose(_Symbol, tf_data.timeframe, 0, count + 1, close_buf);
   if(copied <= 0)
   {
      ArrayFree(close_buf);
      return false;
   }
   int rsi_len = MathMax(2, inp_rsi_period);
   int last = MathMin(count, copied - 1);
   // A custom symbol can return fewer bars than requested during warm-up.
   // Use only the bars actually copied; never index the requested count.
   if(last < rsi_len + 1)
   {
      ArrayFree(close_buf);
      return false;
   }
   double alpha = 2.0 / (rsi_len + 1.0);
   double ad_arr[];
   double g_arr[];
   double lo_arr[];
   ArrayResize(ad_arr, last + 1);
   ArrayResize(g_arr, last + 1);
   ArrayResize(lo_arr, last + 1);
   // Calculate only across the history that is actually available.
   for(int i = last; i >= 0; i--)
   {
      double atr_val = tf_data.GetBufferValue(tf_data.buffer_atr, i);
      double ch = 0.0;
      if(i < last)
         ch = close_buf[i] - close_buf[i + 1];
      double ad = (atr_val > 0.0) ? (ch / atr_val) : 0.0;
      ad_arr[i] = ad;
      g_arr[i]  = MathMax(ad, 0.0);
      lo_arr[i] = MathAbs(MathMin(ad, 0.0));
   }
   double ag = 0.0;
   double al = 0.0;
   // Initial SMA over the oldest RSI window in the available buffer.
   for(int i = last; i > last - rsi_len; i--)
   {
      ag += g_arr[i];
      al += lo_arr[i];
   }
   ag /= rsi_len;
   al /= rsi_len;
   for(int i = last - rsi_len; i >= 1; i--)
   {
      ag = alpha * g_arr[i] + (1.0 - alpha) * ag;
      al = alpha * lo_arr[i] + (1.0 - alpha) * al;
      double r = (al > 0.0) ? (ag / al) : 100.0;
      double varsi_val = 100.0 - (100.0 / (1.0 + r));
      if(i < buf_size)
         tf_data.buffer_varsi[i] = varsi_val;
   }
   // Keep the forming bar stable by mirroring the latest closed bar.
   if(buf_size > 1)
      tf_data.buffer_varsi[0] = tf_data.buffer_varsi[1];
   else if(buf_size > 0)
      tf_data.buffer_varsi[0] = 50.0;
   ArrayFree(close_buf);
   ArrayFree(ad_arr);
   ArrayFree(g_arr);
   ArrayFree(lo_arr);
   return true;
}
//|STEP DATA STRUCTURE|
struct SStepData
{
   datetime step_time;
   string step_date_str, step_time_str, day_name, tp_status;
   bool is_valid[TF_COUNT];
   double rsi_value[TF_COUNT], adx_value[TF_COUNT], cci_value[TF_COUNT], atr_value[TF_COUNT];
   double plus_di_value[TF_COUNT], minus_di_value[TF_COUNT];
   string di_status[TF_COUNT], position_status[TF_COUNT], ema_order[TF_COUNT];
   void Reset()
   {
      step_time = 0; step_date_str = step_time_str = day_name = tp_status = "";
      for(int i = 0; i < TF_COUNT; i++)
      {
         is_valid[i] = false;
         rsi_value[i] = adx_value[i] = cci_value[i] = atr_value[i] = 0;
         plus_di_value[i] = minus_di_value[i] = 0;
         di_status[i] = position_status[i] = ema_order[i] = "";
      }
   }
};
//|EMA STATS STRUCTURE - COMPLETE|
struct SEMAStats
{
   SPatternData patterns[24];
   SPatternData positions[20];
   SEventData events[20];
   int pattern_count, position_count, event_count, total_trades;
   double total_profit;
   int total_wins;
   int total_losses;
   bool is_sorted;
   void Reset()
   {
      pattern_count = position_count = event_count = total_trades = total_wins = total_losses = 0;
      total_profit = 0;
      is_sorted = false;
      for(int i = 0; i < 24; i++) { patterns[i].Reset(); }
      for(int i = 0; i < 20; i++) { positions[i].Reset(); events[i].Reset(); }
   }
   void AddPattern(string p, double profit)
   {
      if(p == ""|| p == "N/A") return;
      is_sorted = false;
      total_trades++;
      total_profit += profit;
      if(profit > 0) total_wins++; else total_losses++;
      for(int i = 0; i < pattern_count; i++)
      {
         if(patterns[i].pattern == p)
         {
            patterns[i].count++;
            patterns[i].total_profit += profit;
            if(profit > 0) patterns[i].win_count++;
            return;
         }
      }
      if(pattern_count < 24)
      {
         patterns[pattern_count].pattern = p;
         patterns[pattern_count].count = 1;
         patterns[pattern_count].total_profit = profit;
         patterns[pattern_count].win_count = (profit > 0) ? 1 : 0;
         pattern_count++;
      }
   }
   void AddPosition(string p, double profit)
   {
      if(p == ""|| p == "N/A") return;
      is_sorted = false;
      for(int i = 0; i < position_count; i++)
      {
         if(positions[i].pattern == p)
         {
            positions[i].count++;
            positions[i].total_profit += profit;
            if(profit > 0) positions[i].win_count++;
            return;
         }
      }
      if(position_count < 20)
      {
         positions[position_count].pattern = p;
         positions[position_count].count = 1;
         positions[position_count].total_profit = profit;
         positions[position_count].win_count = (profit > 0) ? 1 : 0;
         position_count++;
      }
   }
   void AddEvent(string e, double profit)
   {
      if(e == "") e = "UNKNOWN";
      is_sorted = false;
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < pattern_count - 1; i++)
      {
         for(int j = i + 1; j < pattern_count; j++)
         {
            double score_i = CalculatePatternScore(patterns[i].count, patterns[i].win_count, patterns[i].total_profit);
            double score_j = CalculatePatternScore(patterns[j].count, patterns[j].win_count, patterns[j].total_profit);
            if(score_j > score_i)
            {
               SPatternData t = patterns[i];
               patterns[i] = patterns[j];
               patterns[j] = t;
            }
         }
      }
      for(int i = 0; i < position_count - 1; i++)
      {
         for(int j = i + 1; j < position_count; j++)
         {
            if(positions[j].count > positions[i].count)
            {
               SPatternData t = positions[i];
               positions[i] = positions[j];
               positions[j] = t;
            }
         }
      }
      for(int i = 0; i < event_count - 1; i++)
      {
         for(int j = i + 1; j < event_count; j++)
         {
            if(events[j].count > events[i].count)
            {
               SEventData t = events[i];
               events[i] = events[j];
               events[j] = t;
            }
         }
      }
      is_sorted = true;
   }
};
//|RSI STATS STRUCTURE - FIXED VERSION|
struct SRSIStats
{
   SRangeData ranges[25];
   SEventData events[20];
   int range_count, event_count, total_trades;
   double total_profit;
   int total_wins;
   int total_losses;
   bool is_sorted;
   void Reset()
   {
      range_count = event_count = total_trades = total_wins = total_losses = 0;
      total_profit = 0;
      is_sorted = false;
      for(int i = 0; i < 25; i++) { ranges[i].Reset(); }
      for(int i = 0; i < 20; i++) { events[i].Reset(); }
   }
   int GetRangeStart(double v)
   {
      if(v < 0) v = 0;
      if(v >= 100) v = 99.99;
      return ((int)MathFloor(v / 5.0)) * 5;
   }
   void AddValue(double v, double profit)
   {
      is_sorted = false;
      total_trades++;
      total_profit += profit;
      if(profit > 0) total_wins++; else total_losses++;
      if(v < 0) v = 0;
      if(v >= 100) v = 99.99;
      int rs = GetRangeStart(v);
      for(int i = 0; i < range_count; i++)
      {
         if(ranges[i].range_start == rs)
         {
            ranges[i].count++;
            ranges[i].total_profit += profit;
            if(profit > 0) ranges[i].win_count++;
            else ranges[i].loss_count++;
            return;
         }
      }
      if(range_count < 25)
      {
         ranges[range_count].range_start = rs;
         ranges[range_count].range_end = rs + 5;
         ranges[range_count].count = 1;
         ranges[range_count].total_profit = profit;
         ranges[range_count].win_count = (profit > 0) ? 1 : 0;
         ranges[range_count].loss_count = (profit <= 0) ? 1 : 0;
         range_count++;
      }
      else
      {
         PrintFormat("WARNING: SRSIStats overflow - range_count=%d, RSI=%.2f, rs=%d", range_count, v, rs);
      }
   }
   void AddEvent(string e, double profit)
   {
      is_sorted = false;
      if(e == "") e = "UNKNOWN";
      for(int i = 0; i < event_count; i++)
      {
         if(events[i].event == e)
         {
            events[i].count++;
            events[i].total_profit += profit;
            if(profit > 0) events[i].win_count++;
            return;
         }
      }
      if(event_count < 20)
      {
         events[event_count].event = e;
         events[event_count].count = 1;
         events[event_count].total_profit = profit;
         events[event_count].win_count = (profit > 0) ? 1 : 0;
         event_count++;
      }
   }
   double GetWinRate() { return (total_trades > 0) ? (total_wins * 100.0 / total_trades) : 0; }
   double GetAvgProfit() { return (total_trades > 0) ? (total_profit / total_trades) : 0; }
   void SortDesc()
   {
      if(is_sorted) return;
      for(int i = 0; i < range_count - 1; i++)
         for(int j = i + 1; j < range_count; j++)
            if(ranges[j].count > ranges[i].count)
            { SRangeData t = ranges[i]; ranges[i] = ranges[j]; ranges[j] = t; }
      for(int i = 0; i < event_count - 1; i++)
         for(int j = i + 1; j < event_count; j++)
            if(events[j].count > events[i].count)
            { SEventData t = events[i]; events[i] = events[j]; events[j] = t; }
      is_sorted = true;
   }
};
//|ADX/DI STATS STRUCTURE - COMPLETE|
struct SADXDIStats
{
   SRangeData adx_ranges[25];
   SDIStatusData di_status[5];
   SEventData events[20];
