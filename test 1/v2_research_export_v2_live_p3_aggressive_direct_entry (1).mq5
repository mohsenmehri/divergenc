   {
      shadow_id = 0;
      candidate_setup_id = 0;
      is_bullish = false;
      was_accepted = false;
      is_active = false;
      signal_time = 0;
      close_time = 0;
      last_bar_time = 0;
      base_lot = 0.0;
      tick_value = 0.0;
      tick_size = 0.0;
      atr_distance = 0.0;
      ema200_at_signal = 0.0;
      use_ema200_target = false;
      current_step = 0;
      max_step_reached = 0;
      ArrayInitialize(entry_levels, 0.0);
      ArrayInitialize(break_even_levels, 0.0);
      ArrayInitialize(target_levels, 0.0);
      hit_tp1 = false;
      hit_tp2 = false;
      hit_tp3 = false;
      hit_tp4 = false;
      hit_tp5 = false;
      hit_ema200 = false;
      event_path = "";
      final_event = "";
      final_profit_est = 0.0;
      reject_info.Reset();
      lifecycle.Reset();
      snapshot.Reset();
      research_protocol=false;
      research_record_id=0;
      research_executed=false;
      research_setup_id=0;
      research_p3_time=0;
      ArrayInitialize(research_atr_percentile,0.0);
      research_profile_armed=false;
      research_profile_status="OBSERVED_PENDING";
      research_reject_stage="";
      research_reject_reason="";
      research_decision_time=0;
      research_seen_active_setup_gate=false;
      research_seen_session_gate=false;
      research_seen_cooldown_gate=false;
   }
};
