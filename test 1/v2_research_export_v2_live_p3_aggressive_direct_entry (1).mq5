{
   string csv=S2B_StopD2024_File("CompactSearch")+".csv";int h=FileOpen(csv,FILE_WRITE|FILE_CSV|FILE_COMMON,',');if(h!=INVALID_HANDLE){FileWrite(h,"Rank","NFeatures","Features","FeatureHash","MeanAUC","WorstAUC","StdAUC","MeanPRAUC","MeanPRLift","MeanMCC","ValidPrimaryFolds","AbsoluteGate","GateReason","SelectedByPolicy","ContextHash");for(int i=0;i<g_s2b_stop_d2024_candidate_count;i++){SCompactResult r=g_s2b_stop_d2024_candidates[i];FileWrite(h,i+1,r.n_feat,r.feat_names,r.feature_hash,DoubleToString(r.wf_mean_auc,8),DoubleToString(r.wf_worst_auc,8),DoubleToString(r.wf_std_auc,8),DoubleToString(r.wf_mean_prauc,8),DoubleToString(r.wf_mean_pr_lift,8),DoubleToString(r.wf_mean_mcc,8),r.valid_primary_folds,(r.abs_gate_pass?"PASS":"FAIL"),r.abs_gate_reason,(r.selected_by_policy?"YES":"NO"),r.evaluation_context_hash);}FileClose(h);}string txt=S2B_StopD2024_File("CompactSearch_Top10")+".txt";int t=FileOpen(txt,FILE_WRITE|FILE_TXT|FILE_COMMON);if(t!=INVALID_HANDLE){FileWriteString(t,"STOPFLAG D2024 PHASE A TOP 10\nSearchExecuted="+string(g_s2b_stop_d2024_search_executed?"YES":"NO")+"\nCandidateLocked="+string(g_s2b_stop_d2024_candidate_locked?"YES":"NO")+"\n");for(int i=0;i<MathMin(10,g_s2b_stop_d2024_candidate_count);i++){SCompactResult r=g_s2b_stop_d2024_candidates[i];FileWriteString(t,StringFormat("Rank=%d|Hash=%s|Features=%s|MeanAUC=%.6f|WorstAUC=%.6f|StdAUC=%.6f|PRLift=%.6f|Gate=%s|Selected=%s\n",i+1,r.feature_hash,r.feat_names,r.wf_mean_auc,r.wf_worst_auc,r.wf_std_auc,r.wf_mean_pr_lift,(r.abs_gate_pass?"PASS":"FAIL"),(r.selected_by_policy?"YES":"NO")));S2B_StopD2024_WriteFoldDiagnostics(t,r);}FileClose(t);}Print("STOP_D2024_SEARCH_REPORTS|",csv,"|",txt);
}
