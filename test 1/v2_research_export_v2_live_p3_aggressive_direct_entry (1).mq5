// Independent detector-span counterfactual lifecycle. It never places orders.
struct SDiv3SpanShadow
{
   int id;
   int pair_id;
   int policy_id; // 0=H0 five-step, 1=H1 max-step4
   int max_allowed_step;
   double step_lot_factors[5];
   int cohort;
   bool early_step5_recovery_target;
   bool is_bullish;
   bool is_active;
   bool is_censored;
   datetime signal_time;
   datetime close_time;
   datetime p1_time,p2_time,p3_time;
   double p1_price,p2_price,p3_price;
   double p1_rsi,p2_rsi,p3_rsi;
   double p1_prom,p2_prom,p3_prom;
   int p1_rsi_shift,p2_rsi_shift,p3_rsi_shift;
   int gap12,gap23,span;
   double base_lot,tick_value,tick_size,atr_distance,ema200_at_signal;
   bool use_ema200_target;
   int current_step,max_step_reached,bars_alive;
   double entry_levels[5],break_even_levels[4],target_levels[5];
   bool hit_tp1,hit_tp2,hit_tp3,hit_tp4,hit_tp5,hit_ema200;
   double max_profit_money,max_loss_money,mfe_points,mae_points,final_profit_est;
   string event_path,final_event;
   void Reset()
   {
      id=pair_id=policy_id=cohort=0; max_allowed_step=5; early_step5_recovery_target=false;
      for(int z=0;z<5;z++) step_lot_factors[z]=(double)(z+1);
      is_bullish=false; is_active=false; is_censored=false; signal_time=close_time=0;
      p1_time=p2_time=p3_time=0; p1_price=p2_price=p3_price=0.0;
      p1_rsi=p2_rsi=p3_rsi=0.0; p1_prom=p2_prom=p3_prom=0.0;
      p1_rsi_shift=p2_rsi_shift=p3_rsi_shift=-1; gap12=gap23=span=0;
      base_lot=tick_value=tick_size=atr_distance=ema200_at_signal=0.0;
      use_ema200_target=false; current_step=max_step_reached=bars_alive=0;
      ArrayInitialize(entry_levels,0.0); ArrayInitialize(break_even_levels,0.0); ArrayInitialize(target_levels,0.0);
      hit_tp1=hit_tp2=hit_tp3=hit_tp4=hit_tp5=hit_ema200=false;
      max_profit_money=max_loss_money=mfe_points=mae_points=final_profit_est=0.0;
      event_path=final_event="";
   }
};
