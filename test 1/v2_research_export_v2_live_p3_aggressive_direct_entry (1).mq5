      row += DoubleToString(sn.rsi_m1_minus_h1, 3) + ",";
      row += DoubleToString(sn.atr_m1_div_h1, 4) + ",";
      row += DoubleToString(sn.adx_m15_div_h1, 4) + ",";
      row += DoubleToString(sn.atr_acceleration, 3) + ",";
      row += IntegerToString(sn.momentum_consensus) + ",";
      row += EscapeCSV(sn.vol_regime) + ",";
      row += IntegerToString(sn.vol_regime_id) + ",";
      row += EscapeCSV(sn.trend_regime) + ",";
      row += IntegerToString(sn.trend_regime_id) + ",";
      row += EscapeCSV(sn.adx_regime) + ",";
      row += IntegerToString(sn.adx_regime_id) + ",";
      row += EscapeCSV(sn.momentum_regime) + ",";
      row += IntegerToString(sn.momentum_regime_id) + ",";
      row += DoubleToString(sn.dist_day_open_atr, 4) + ",";
      row += DoubleToString(sn.dist_day_high_atr, 4) + ",";
      row += DoubleToString(sn.dist_day_low_atr, 4) + ",";
      row += DoubleToString(sn.day_range_position, 4) + ",";
      row += DoubleToString(sn.dist_week_open_atr, 4) + ",";
      row += DoubleToString(sn.dist_week_high_atr, 4) + ",";
      row += DoubleToString(sn.dist_week_low_atr, 4) + ",";
      row += DoubleToString(sn.week_range_position, 4) + ",";
      row += DoubleToString(sn.nearest_round_level, _Digits) + ",";
      row += DoubleToString(sn.dist_round_level_atr, 4) + ",";
      row += DoubleToString(sn.adr5, _Digits) + ",";
      row += DoubleToString(sn.adr20, _Digits) + ",";
      row += DoubleToString(sn.today_range_pct_adr, 4) + ",";
      string ft = OS_GetFinalToken(sn.close_event);
      bool is_stop = OS_IsStopToken(ft);
      bool is_target = OS_IsTargetToken(ft);
      row += IntegerToString(sn.actual_max_step) + ",";
      row += (is_stop ? "1" : "0") + ",";
      row += (is_target ? "1" : "0") + ",";
      row += (sn.actual_max_step >= 2 ? "1" : "0") + ",";
      row += (sn.actual_max_step >= 3 ? "1" : "0") + ",";
      row += (sn.actual_max_step >= 4 ? "1" : "0") + ",";
      row += (sn.actual_max_step >= 5 ? "1" : "0") + ",";
      bool deep_stop = (sn.actual_max_step >= 4 && is_stop);
      bool deep_target = (sn.actual_max_step >= 4 && is_target);
      row += (deep_stop ? "1" : "0") + ",";
      row += (deep_target ? "1" : "0") + ",";
      row += (sn.hit_tp1 ? "1" : "0") + ",";
      row += (sn.hit_tp2 ? "1" : "0") + ",";
      row += (sn.hit_ema200 ? "1" : "0") + ",";
      row += EscapeCSV(PathClassName(sn.path_class)) + ",";
      row += EscapeCSV(final_event) + ",";
      row += DoubleToString(sn.final_profit, 2) + ",";
      row += DoubleToString(sn.mfe_money, 2) + ",";
      row += DoubleToString(sn.mae_money, 2) + ",";
      row += DoubleToString(sn.max_dd_money, 2) + ",";
      row += DoubleToString(sn.max_dd_pct, 2) + ",";
      row += IntegerToString(sn.trade_duration_min) + ",";
      row += EscapeCSV(exit_reason) + ",";
      for(int s = 0; s < 5; s++)
         row += (sn.step_entry_times[s] > 0
                 ? TimeToString(sn.step_entry_times[s], TIME_DATE | TIME_MINUTES)
                 : "")
                + (s < 4 ? "," : "");
      row += ",";
      for(int s = 0; s < 5; s++)
         row += DoubleToString(sn.step_entry_prices[s], _Digits)
                + (s < 4 ? "," : "");
      row += "\r\n";
      FileWriteString(h, row);
      rc++;
   }
   FileFlush(h);
   FileClose(h);
   Print("SignalRegistry v2.5 exported: ", fn,
         " | Rows=", rc,
         " | Dataset=", DS_VERSION,
         " | FeatureSet=", DS_FEATURE_SET);
}
struct SFeatureDistAgg
{
   string feature;
   string side;
   string bin;
   int count;
   int stop_cnt;
   int target_cnt;
   int step4p_cnt;
   int accepted_cnt;
   int rejected_cnt;
   double profit_sum;
   double mfe_sum;
   double mae_sum;
   void Reset()
   {
      feature = "";
      side = "";
      bin = "";
      count = 0;
      stop_cnt = 0;
      target_cnt = 0;
      step4p_cnt = 0;
      accepted_cnt = 0;
      rejected_cnt = 0;
      profit_sum = 0.0;
      mfe_sum = 0.0;
      mae_sum = 0.0;
   }
};
int FD_FindAgg(SFeatureDistAgg &aggs[], int agg_count, string feature, string side, string bin)
{
   for(int i = 0; i < agg_count; i++)
   {
      if(aggs[i].feature == feature &&
         aggs[i].side == side &&
         aggs[i].bin == bin)
         return i;
   }
   return -1;
}
void FD_AddAgg(SFeatureDistAgg &aggs[], int &agg_count, string feature, string side, string bin, SUnifiedRegistryRow &r)
{
   if(bin == "") return;
   int idx = FD_FindAgg(aggs, agg_count, feature, side, bin);
   if(idx < 0)
   {
      if(agg_count >= ArraySize(aggs))
         return;
      idx = agg_count++;
      aggs[idx].Reset();
      aggs[idx].feature = feature;
      aggs[idx].side = side;
      aggs[idx].bin = bin;
   }
   aggs[idx].count++;
   if(r.stop_flag) aggs[idx].stop_cnt++;
   if(r.target_flag) aggs[idx].target_cnt++;
   if(r.max_step >= 4) aggs[idx].step4p_cnt++;
   if(r.accepted) aggs[idx].accepted_cnt++;
   else aggs[idx].rejected_cnt++;
   aggs[idx].profit_sum += r.final_profit;
   aggs[idx].mfe_sum += r.mfe_points;
   aggs[idx].mae_sum += r.mae_points;
}
string FD_BinRSI(double v)
{
   if(v <= 0.0 || v > 100.0) return "";
   int lo = ((int)MathFloor(v / 5.0)) * 5;
   return "[" + IntegerToString(lo) + "-" + IntegerToString(lo + 5) + "]";
}
string FD_BinADX(double v)
{
   if(v <= 0.0 || v > 100.0) return "";
   int lo = ((int)MathFloor(v / 5.0)) * 5;
   return "[" + IntegerToString(lo) + "-" + IntegerToString(lo + 5) + "]";
}
string FD_BinCCI(double v)
{
   int lo = ((int)MathFloor(v / 25.0)) * 25;
   return "[" + IntegerToString(lo) + "-" + IntegerToString(lo + 25) + "]";
}
string FD_BinATRReg(double v)
{
   if(v <= 0.0) return "";
   double lo = MathFloor(v / 0.2) * 0.2;
   double hi = lo + 0.2;
   return "[" + DoubleToString(lo, 1) + "-" + DoubleToString(hi, 1) + "]";
}
string FD_BinEMAComp(double v)
{
   if(v <= 0.0) return "";
   double lo = MathFloor(v);
   double hi = lo + 1.0;
   return "[" + DoubleToString(lo, 0) + "-" + DoubleToString(hi, 0) + "]";
}
string FD_BinRatio(double v)
{
   if(v < 0.0) return "";
   double lo = MathFloor(v / 0.1) * 0.1;
   double hi = lo + 0.1;
   return "[" + DoubleToString(lo, 1) + "-" + DoubleToString(hi, 1) + "]";
}
string FD_BinInt5(int v)
{
   if(v < 0) return "";
   int lo = (v / 5) * 5;
   return "[" + IntegerToString(lo) + "-" + IntegerToString(lo + 5) + "]";
}
string FD_BinOBWidth(double v)
{
   if(v <= 0.0) return "";
   double lo = MathFloor(v / 0.25) * 0.25;
   double hi = lo + 0.25;
   return "[" + DoubleToString(lo, 2) + "-" + DoubleToString(hi, 2) + "]";
}
void ExportFeatureDistributionCSV()
{
   #define FD_KEY_MAX 8000
   string fd_keys[FD_KEY_MAX];
   int    fd_cnt[FD_KEY_MAX];
   int    fd_stop[FD_KEY_MAX];
   int    fd_target[FD_KEY_MAX];
   int    fd_step4p[FD_KEY_MAX];
   int    fd_accepted[FD_KEY_MAX];
   int    fd_rejected[FD_KEY_MAX];
   double fd_profit[FD_KEY_MAX];
   double fd_mfe[FD_KEY_MAX];
   double fd_mae[FD_KEY_MAX];
   int    fd_n = 0;
   for(int k = 0; k < FD_KEY_MAX; k++)
   {
      fd_keys[k]     = "";
      fd_cnt[k]      = 0;
      fd_stop[k]     = 0;
      fd_target[k]   = 0;
      fd_step4p[k]   = 0;
      fd_accepted[k] = 0;
      fd_rejected[k] = 0;
      fd_profit[k]   = 0.0;
      fd_mfe[k]      = 0.0;
      fd_mae[k]      = 0.0;
   }
   #define FD_UPSERT(feat, side_str, bin_str, is_acc, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v) \
   { \
      if((bin_str) != "") \
      { \
         string _k = string(feat) + "|" + string(side_str) + "|" + string(bin_str); \
         int _lo=0, _hi=fd_n-1, _fi=-1; \
         while(_lo<=_hi){int _m=(_lo+_hi)/2; int _c=StringCompare(fd_keys[_m],_k,true); if(_c==0){_fi=_m;break;}else if(_c<0)_lo=_m+1;else _hi=_m-1;} \
         if(_fi<0 && fd_n<FD_KEY_MAX){ \
            int _ins=_lo; \
            for(int _s=fd_n;_s>_ins;_s--){fd_keys[_s]=fd_keys[_s-1];fd_cnt[_s]=fd_cnt[_s-1];fd_stop[_s]=fd_stop[_s-1];fd_target[_s]=fd_target[_s-1];fd_step4p[_s]=fd_step4p[_s-1];fd_accepted[_s]=fd_accepted[_s-1];fd_rejected[_s]=fd_rejected[_s-1];fd_profit[_s]=fd_profit[_s-1];fd_mfe[_s]=fd_mfe[_s-1];fd_mae[_s]=fd_mae[_s-1];} \
            fd_keys[_ins]=_k;fd_cnt[_ins]=0;fd_stop[_ins]=0;fd_target[_ins]=0;fd_step4p[_ins]=0;fd_accepted[_ins]=0;fd_rejected[_ins]=0;fd_profit[_ins]=0.0;fd_mfe[_ins]=0.0;fd_mae[_ins]=0.0; \
            fd_n++;_fi=_ins;} \
         if(_fi>=0){fd_cnt[_fi]++;if(is_stp)fd_stop[_fi]++;if(is_tgt)fd_target[_fi]++;if(is_4p)fd_step4p[_fi]++;if(is_acc)fd_accepted[_fi]++;else fd_rejected[_fi]++;fd_profit[_fi]+=(pft);fd_mfe[_fi]+=(mfe_v);fd_mae[_fi]+=(mae_v);} \
      } \
   }
   // ===== REAL / ACCEPTED =====
   for(int i = 0; i < g_snapshot_count; i++)
   {
      string side = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      string ft     = OS_GetFinalToken(g_snapshots[i].close_event);
      bool   is_stp = OS_IsStopToken(ft);
      bool   is_tgt = OS_IsTargetToken(ft);
      bool   is_4p  = (g_snapshots[i].actual_max_step >= 4);
      double pft    = g_snapshots[i].final_profit;
      FD_UPSERT("RSI_M1",          side, FD_BinRSI(g_snapshots[i].rsi[TF_IDX_MAIN]),                         true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("RSI_H1",          side, FD_BinRSI(g_snapshots[i].rsi[TF_IDX_H1]),                           true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("RSI_H4",          side, FD_BinRSI(g_snapshots[i].rsi[TF_IDX_H4]),                           true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("ADX_M1",          side, FD_BinADX(g_snapshots[i].adx[TF_IDX_MAIN]),                         true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("ADX_H1",          side, FD_BinADX(g_snapshots[i].adx[TF_IDX_H1]),                           true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("ADX_H4",          side, FD_BinADX(g_snapshots[i].adx[TF_IDX_H4]),                           true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("CCI_M1",          side, FD_BinCCI(g_snapshots[i].cci[TF_IDX_MAIN]),                         true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("ATR_Regime_M1",   side, FD_BinATRReg(g_snapshots[i].atr_regime[TF_IDX_MAIN]),               true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("ATR_Regime_H1",   side, FD_BinATRReg(g_snapshots[i].atr_regime[TF_IDX_H1]),                 true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("EMA_Comp_M1",     side, FD_BinEMAComp(g_snapshots[i].ema_compression[TF_IDX_MAIN]),         true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("EMA_Comp_M5",     side, FD_BinEMAComp(g_snapshots[i].ema_compression[TF_IDX_M5]),           true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("Signal_BodyRatio",side, FD_BinRatio(g_snapshots[i].signal_body_ratio),                      true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("Signal_CLV",      side, FD_BinRatio(g_snapshots[i].signal_clv),                             true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("Pivot1Dist",      side, FD_BinInt5(g_snapshots[i].pivot1_dist),                             true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("Pivot2Dist",      side, FD_BinInt5(g_snapshots[i].pivot2_dist),                             true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("OB_AgeBars",      side, FD_BinInt5(g_snapshots[i].ob_age_bars),                             true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
      FD_UPSERT("OB_Width_ATR",    side, FD_BinOBWidth(g_snapshots[i].ob_width_atr),                         true, is_stp, is_tgt, is_4p, pft, 0.0, 0.0)
   }
   // ===== SHADOW / REJECTED =====
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(g_shadow_signals[i].was_accepted) continue;
      if(g_shadow_signals[i].is_active)    continue;
      string side = g_shadow_signals[i].is_bullish ? "BUY" : "SELL";
      string raw    = (g_shadow_signals[i].final_event != "")
                      ? g_shadow_signals[i].final_event
                      : g_shadow_signals[i].event_path;
      string ft     = UR_GetFinalToken(NormalizeEventString(raw));
      bool   is_stp = UR_IsStopToken(ft);
      bool   is_tgt = UR_IsTargetToken(ft);
      bool   is_4p  = (g_shadow_signals[i].max_step_reached >= 4);
      double pft    = g_shadow_signals[i].final_profit_est;
      double mfe_v  = g_shadow_signals[i].lifecycle.mfe_points;
      double mae_v  = g_shadow_signals[i].lifecycle.mae_points;
      FD_UPSERT("RSI_M1",          side, FD_BinRSI(g_shadow_signals[i].snapshot.rsi[TF_IDX_MAIN]),                         false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("RSI_H1",          side, FD_BinRSI(g_shadow_signals[i].snapshot.rsi[TF_IDX_H1]),                           false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("RSI_H4",          side, FD_BinRSI(g_shadow_signals[i].snapshot.rsi[TF_IDX_H4]),                           false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("ADX_M1",          side, FD_BinADX(g_shadow_signals[i].snapshot.adx[TF_IDX_MAIN]),                         false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("ADX_H1",          side, FD_BinADX(g_shadow_signals[i].snapshot.adx[TF_IDX_H1]),                           false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("ADX_H4",          side, FD_BinADX(g_shadow_signals[i].snapshot.adx[TF_IDX_H4]),                           false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("CCI_M1",          side, FD_BinCCI(g_shadow_signals[i].snapshot.cci[TF_IDX_MAIN]),                         false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("ATR_Regime_M1",   side, FD_BinATRReg(g_shadow_signals[i].snapshot.atr_regime[TF_IDX_MAIN]),               false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("ATR_Regime_H1",   side, FD_BinATRReg(g_shadow_signals[i].snapshot.atr_regime[TF_IDX_H1]),                 false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("EMA_Comp_M1",     side, FD_BinEMAComp(g_shadow_signals[i].snapshot.ema_compression[TF_IDX_MAIN]),         false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("EMA_Comp_M5",     side, FD_BinEMAComp(g_shadow_signals[i].snapshot.ema_compression[TF_IDX_M5]),           false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("Signal_BodyRatio",side, FD_BinRatio(g_shadow_signals[i].snapshot.signal_body_ratio),                      false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("Signal_CLV",      side, FD_BinRatio(g_shadow_signals[i].snapshot.signal_clv),                             false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("Pivot1Dist",      side, FD_BinInt5(g_shadow_signals[i].snapshot.pivot1_dist),                             false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("Pivot2Dist",      side, FD_BinInt5(g_shadow_signals[i].snapshot.pivot2_dist),                             false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("OB_AgeBars",      side, FD_BinInt5(g_shadow_signals[i].snapshot.ob_age_bars),                             false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
      FD_UPSERT("OB_Width_ATR",    side, FD_BinOBWidth(g_shadow_signals[i].snapshot.ob_width_atr),                         false, is_stp, is_tgt, is_4p, pft, mfe_v, mae_v)
   }
   // ===== Export CSV =====
   string fn = "FeatureDistribution_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE) return;
   FileWriteString(h,
      "Feature,Side,Bin,Count,AcceptedRoutePct,RejectedRoutePct,"
      "StopPct,TargetPct,Step4PlusPct,AvgProfit,AvgMFE,AvgMAE\r\n"
   );
   for(int i = 0; i < fd_n; i++)
   {
      if(fd_cnt[i] <= 0) continue;
      string parts[];
      if(StringSplit(fd_keys[i], '|', parts) < 3) continue;
      int cnt = fd_cnt[i];
      string row = "";
      row += EscapeCSV(parts[0]) + ",";
      row += parts[1] + ",";
      row += EscapeCSV(parts[2]) + ",";
      row += IntegerToString(cnt) + ",";
      row += DoubleToString(fd_accepted[i] * 100.0 / cnt, 2) + ",";
      row += DoubleToString(fd_rejected[i] * 100.0 / cnt, 2) + ",";
      row += DoubleToString(fd_stop[i]     * 100.0 / cnt, 2) + ",";
      row += DoubleToString(fd_target[i]   * 100.0 / cnt, 2) + ",";
      row += DoubleToString(fd_step4p[i]   * 100.0 / cnt, 2) + ",";
      row += DoubleToString(fd_profit[i]   / cnt,         2) + ",";
      row += DoubleToString(fd_mfe[i]      / cnt,         2) + ",";
      row += DoubleToString(fd_mae[i]      / cnt,         2) + "\r\n";
      FileWriteString(h, row);
   }
   FileFlush(h);
   FileClose(h);
   Print("FeatureDistribution exported: ", fn, " | Keys=", fd_n);
   #undef FD_KEY_MAX
   #undef FD_UPSERT
}
//|CLASSES|
class CPivotPoint
{
public:
   double price_level, rsi_value, prominence_atr;
   datetime pivot_time, confirm_time;
   int original_bar_shift, pivot_kind, rsi_shift;
   CPivotPoint() { Reset(); }
   void Reset()
   {
      price_level = rsi_value = prominence_atr = 0.0;
      pivot_time = confirm_time = 0;
      original_bar_shift = pivot_kind = rsi_shift = -1;
   }
   void Set(double price,double rsi,datetime time,int shift,int kind,
            datetime confirmed_at,int aligned_rsi_shift,double prom_atr)
   {
      price_level=price; rsi_value=rsi; pivot_time=time; original_bar_shift=shift; pivot_kind=kind;
      confirm_time=confirmed_at; rsi_shift=aligned_rsi_shift; prominence_atr=prom_atr;
   }
   void CopyFrom(CPivotPoint &src)
   {
      price_level=src.price_level; rsi_value=src.rsi_value; prominence_atr=src.prominence_atr;
      pivot_time=src.pivot_time; confirm_time=src.confirm_time;
      original_bar_shift=src.original_bar_shift; pivot_kind=src.pivot_kind; rsi_shift=src.rsi_shift;
   }
   int GetCurrentBarShift() { return (pivot_time == 0) ? -1 : iBarShift(_Symbol, PERIOD_CURRENT, pivot_time, false); }
   bool IsValid() { return (pivot_time > 0 && price_level > 0); }
};
class CSignalData
{
public:
   datetime signal_time;
   bool is_bullish;
   double entry_levels[5], break_even_levels[4], target_levels[5];
   CSignalData() { signal_time = 0; is_bullish = false; ArrayInitialize(entry_levels, 0);
                   ArrayInitialize(break_even_levels, 0); ArrayInitialize(target_levels, 0); }
   int GetCurrentBarShift() { return (signal_time == 0) ? -1 : iBarShift(_Symbol, PERIOD_CURRENT, signal_time, false); }
};
//|SETUP TRACKER CLASS - ENHANCED|
class CSetupTracker
{
public:
   int setup_id, current_step, max_step_reached;
   bool is_bullish, is_active, is_above_ema200, use_ema200_as_target, external_close_handled;
   double stop_levels[5], break_even_levels[4], target_levels[5];
   double atr_distance, ema200_at_entry;
   datetime created_time;
   double max_drawdown_money, max_drawdown_percent, peak_profit, lowest_profit, entry_balance, entry_equity;
   int pending_step_entry;
   double pending_entry_price;
   // A basket close can be partially filled/rejected by the broker. Keep the
   // setup in close-only mode until every frozen/matching position is gone.
   bool basket_close_pending;
   string basket_close_reason;
   double feat_atr_regime[TF_COUNT];
   double feat_adx_slope[TF_COUNT];
   double feat_ema_compression[TF_COUNT];
   double feat_signal_clv;
   double feat_signal_body_ratio;
   int    feat_ob_age_bars;
   double feat_ob_width_atr;
   // TP Tracking
   bool hit_tp1;
   bool hit_tp2;
   bool hit_ema200;
   bool hit_tp3;
   bool hit_tp4;
   bool hit_tp5;
   string event_path;
   // MFE/MAE tracking
   double mfe_money;
   double mae_money;
   // NEW: Step timestamps and prices
   datetime step_times[5];
   double   step_prices[5];
   // v9.2: post-TP1 ATR chandelier trailing state (not persisted in backups;
   // on reload it re-arms from hit_tp1 which IS persisted)
   bool     trail_armed;
   double   trail_peak;
   // C2/M2 Step3->4 LATCH (Repair V1). Owner decisions approved:
   // D1-D12 (D9 d_DI=0). Latch is independent of PlaceEntry retry.
   int      c2m2_step34_latch;      // 0=NONE,1=ALLOW,2=VETO,3=INVALID
   datetime c2m2_step34_latch_time; // tick-time of first valid C2/M2 decision
   CSetupTracker() { Reset(); }
   void Reset()
   {
      setup_id = -1;
      current_step = max_step_reached = 0;
      is_bullish = is_active = is_above_ema200 = use_ema200_as_target = external_close_handled = false;
      ArrayInitialize(stop_levels, 0);
      ArrayInitialize(break_even_levels, 0);
      ArrayInitialize(target_levels, 0);
      atr_distance = ema200_at_entry = 0;
      created_time = 0;
      max_drawdown_money = max_drawdown_percent = peak_profit = lowest_profit = entry_balance = entry_equity = 0;
      pending_step_entry = 0;
      pending_entry_price = 0;
      basket_close_pending = false;
      basket_close_reason = "";
      ArrayInitialize(feat_atr_regime, 0.0);
      ArrayInitialize(feat_adx_slope, 0.0);
      ArrayInitialize(feat_ema_compression, 0.0);
      feat_signal_clv = 0.0;
      feat_signal_body_ratio = 0.0;
      feat_ob_age_bars = -1;
      feat_ob_width_atr = 0.0;
      hit_tp1 = false;
      hit_tp2 = false;
      hit_ema200 = false;
      hit_tp3 = false;
      hit_tp4 = false;
      hit_tp5 = false;
      event_path = "";
      mfe_money = 0.0;
      mae_money = 0.0;
      // NEW
      ArrayInitialize(step_times, 0);
      ArrayInitialize(step_prices, 0.0);
      trail_armed = false;
      trail_peak  = 0.0;
      c2m2_step34_latch = 0;
      c2m2_step34_latch_time = 0;
   }
};
struct SArmedDivergence
{
   bool active;
   bool confirmed;
   bool is_bull;
   datetime armed_time;
   datetime last_eval_bar;
   datetime p1_time,p2_time,p3_time;
   double p1_price,p2_price,p3_price;
   double p1_rsi,p2_rsi,p3_rsi;
   double structure_level;
   double reclaim_level;
   double rsi_failure_level;
   int setup_id_hint;
   string source;
   void Reset()
   {
      active=false; confirmed=false; is_bull=false;
      armed_time=last_eval_bar=p1_time=p2_time=p3_time=0;
      p1_price=p2_price=p3_price=0.0;
      p1_rsi=p2_rsi=p3_rsi=0.0;
      structure_level=reclaim_level=rsi_failure_level=0.0;
      setup_id_hint=0; source="";
   }
};
struct SProfileStats
{
   long live_armed;
   long confirmed_signals;
   long entries;
   long rejected_structure;
   long rejected_rsi;
   long rejected_regime;
   long rejected_volatility;
   long step_entries[5];
   long completed;
   long stops;
   long deep4plus;
   double total_pnl;
   void Reset()
   {
      live_armed=confirmed_signals=entries=0;
      rejected_structure=rejected_rsi=rejected_regime=rejected_volatility=0;
      ArrayInitialize(step_entries,0);
      completed=stops=deep4plus=0;
      total_pnl=0.0;
   }
};
