bool S2B_FU_TFFieldValue(SEntrySnapshot &sn,int f,int tf,double &out)
{
   out=0.0;
   if(tf<0 || tf>=TF_COUNT) return false;
   switch(f)
   {
      case 0: { double v=sn.rsi[tf]; out=v; return (sn.qc_has_rsi_data && v>0.0 && v<=100.0); }
      case 1: { double v=sn.rsi_slope_5[tf]; out=v; return (sn.qc_has_rsi_data && MathIsValidNumber(v)); }
      case 2: { double v=sn.rsi_dist_50[tf]; out=v; return (sn.qc_has_rsi_data && MathIsValidNumber(v)); }
      case 3: { double v=sn.adx[tf]; out=v; return (sn.qc_has_adx_data && v>0.0 && v<=100.0); }
      case 4: { double v=sn.adx_slope[tf]; out=v; return (sn.qc_has_adx_data && MathIsValidNumber(v)); }
      case 5: { double v=(sn.adx_rising[tf]?1.0:0.0); out=v; return (sn.qc_has_adx_data); }
      case 6: { double v=sn.plus_di[tf]; out=v; return (sn.qc_has_adx_data && v>=0.0 && v<=100.0); }
      case 7: { double v=sn.minus_di[tf]; out=v; return (sn.qc_has_adx_data && v>=0.0 && v<=100.0); }
      case 8: { double v=sn.di_gap[tf]; out=v; return (sn.qc_has_adx_data && v>=0.0); }
      case 9: { double v=sn.cci[tf]; out=v; return (sn.qc_has_cci_data && MathIsValidNumber(v) && MathAbs(v)<=2000.0); }
      case 10: { double v=sn.cci_slope_5[tf]; out=v; return (sn.qc_has_cci_data && MathIsValidNumber(v)); }
      case 11: { double v=sn.atr[tf]; out=v; return (v>0.0); }
      case 12: { double v=sn.atr_regime[tf]; out=v; return (v>0.0); }
      case 13: { double v=sn.ema_compression[tf]; out=v; return (v>0.0); }
      case 14: { double v=sn.ema200_dist[tf]; out=v; return (v>0.0); }
      case 15: { double v=sn.ema20_slope[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 16: { double v=sn.ema50_slope[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 17: { double v=sn.ema200_slope[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 18: { double v=sn.ema_gap_20_50[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 19: { double v=sn.ema_gap_50_200[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 20: { double v=sn.ema20_dist_atr[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 21: { double v=sn.ema50_dist_atr[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 22: { double v=sn.ema200_dist_atr[tf]; out=v; return (sn.qc_has_ema_data && MathIsValidNumber(v)); }
      case 23: { double v=(sn.price_above_ema200[tf]?1.0:0.0); out=v; return (sn.qc_has_ema_data); }
      case 24: { double v=sn.macd_main[tf]; out=v; return (sn.qc_has_macd_data && MathIsValidNumber(v) && !(sn.macd_main[tf]==0.0 && sn.macd_signal[tf]==0.0)); }
      case 25: { double v=sn.macd_signal[tf]; out=v; return (sn.qc_has_macd_data && MathIsValidNumber(v) && !(sn.macd_main[tf]==0.0 && sn.macd_signal[tf]==0.0)); }
      case 26: { double v=sn.macd_hist[tf]; out=v; return (sn.qc_has_macd_data && MathIsValidNumber(v) && !(sn.macd_main[tf]==0.0 && sn.macd_signal[tf]==0.0)); }
      case 27: { double v=sn.stoch_k[tf]; out=v; return (sn.qc_has_stoch_data && v>=0.0 && v<=100.0 && !(sn.stoch_k[tf]==0.0 && sn.stoch_d[tf]==0.0)); }
      case 28: { double v=sn.stoch_d[tf]; out=v; return (sn.qc_has_stoch_data && v>=0.0 && v<=100.0 && !(sn.stoch_k[tf]==0.0 && sn.stoch_d[tf]==0.0)); }
      case 29: { double v=sn.williams_r[tf]; out=v; return (sn.qc_has_williams_data && v>=-100.0 && v<=0.0 && sn.williams_r[tf]!=0.0); }
      case 30: { double v=sn.bb_width[tf]; out=v; return (sn.qc_has_bb_data && v>0.0); }
      case 31: { double v=sn.bb_position[tf]; out=v; return (sn.qc_has_bb_data && MathIsValidNumber(v)); }
      case 32: { double v=sn.bb_dist_middle[tf]; out=v; return (sn.qc_has_bb_data && MathIsValidNumber(v)); }
      case 33: { double v=(sn.bb_squeeze[tf]?1.0:0.0); out=v; return (sn.qc_has_bb_data); }
   }
   return false;
}
string S2B_FU_GlobalFieldName(int f)
{
   switch(f)
   {
      case 0: return "Is_Bullish";
      case 1: return "Entry_Hour";
      case 2: return "Entry_DayOfWeek";
      case 3: return "Entry_Month";
