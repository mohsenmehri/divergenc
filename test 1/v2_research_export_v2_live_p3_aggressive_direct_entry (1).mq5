// ============================================================================
// RESEARCH EXPORT LAYER v1 — OBSERVATION ONLY
// Immutable Step-1 features; lifecycle labels are written only after outcomes.
// This layer never submits, changes, closes, or sizes a trade.
// ============================================================================
#define RX_SCHEMA_VERSION "RX_STEP1_DATASET_V1"
#define RX_LAYER_VERSION  "RX_OBSERVATION_ONLY_V1"
struct SRXRunMeta
{
   string run_id, schema_version, layer_version, symbol, broker, main_tf, mtf_layout;
   datetime started_at, finished_at;
   bool is_testing, is_visual;
   void Reset()
   {
      run_id=""; schema_version=RX_SCHEMA_VERSION; layer_version=RX_LAYER_VERSION;
      symbol=broker=main_tf=mtf_layout=""; started_at=finished_at=0; is_testing=false; is_visual=false;
   }
};
// --- RX capture policy ----------------------------------------------------
// Features are read from the last completed bar so that every row is
// reproducible from historical OHLC. Slope features look back 5 bars from
// there, i.e. index RX_FEATURE_SHIFT+5.
#define RX_FEATURE_SHIFT   1
#define RX_SLOPE_LOOKBACK  5
#define RX_SLOPE_SHIFT     (RX_FEATURE_SHIFT+RX_SLOPE_LOOKBACK)
// RX_NA marks a value whose source was unavailable. It is exported as an empty
// CSV field, so a genuine 0.0 is never confused with missing data and derived
// values are never fabricated from a missing input.
#define RX_NA              DBL_MAX
bool RX_Ok(const double v)  { return v!=RX_NA && MathIsValidNumber(v); }
bool RX_Pos(const double v) { return RX_Ok(v) && v>0.0; }
// Missing-aware buffer read: unlike GetBufferValue() it does not collapse
// "empty buffer / out of range / EMPTY_VALUE / NaN" into 0.0.
double RX_Buf(const double &buffer[],const int index)
{
   const int size=ArraySize(buffer);
   if(size==0 || index<0 || index>=size) return RX_NA;
   const double v=buffer[index];
   if(v==EMPTY_VALUE || !MathIsValidNumber(v)) return RX_NA;
   return v;
}
struct SRXStep1Snapshot
{
   int setup_id; ulong position_id; bool is_buy; string signal_source;
   datetime signal_time, fill_time, feature_asof_time;
   double fill_price, planned_entry, balance, equity, atr_distance, spread_points;
   double step_level[5], be_level[4], tp[3]; double ema200_at_entry;
   bool use_ema200_target, counter_ema200;
   datetime p1_time,p2_time,p3_time; double p1_price,p2_price,p3_price,p1_rsi,p2_rsi,p3_rsi;
   int div_gap12,div_gap23,div_span; double div_gap_ratio,div_rsi_spread,div_price_spread_atr,div_prom_atr_p3;
   double price_div_strength,rsi_div_strength,div_price_slope,div_rsi_slope,divergence_angle;
   bool confirmation_after_p3,rsi_reclaim_after_p3;
   datetime tf_bar_time[TF_COUNT]; int tf_shift[TF_COUNT]; bool tf_forming[TF_COUNT],tf_valid[TF_COUNT];
   double rsi[TF_COUNT],adx[TF_COUNT],cci[TF_COUNT],atr[TF_COUNT],pdi[TF_COUNT],mdi[TF_COUNT],di_gap[TF_COUNT];
   double ema20[TF_COUNT],ema50[TF_COUNT],ema100[TF_COUNT],ema200[TF_COUNT],ema200_dist_atr[TF_COUNT];
   double rsi_slope5[TF_COUNT],cci_slope5[TF_COUNT],adx_slope5[TF_COUNT],atr_regime[TF_COUNT];
   double ema20_slope5[TF_COUNT],ema50_slope5[TF_COUNT],ema200_slope5[TF_COUNT],ema_gap2050[TF_COUNT],ema_gap50200[TF_COUNT],ema_compression[TF_COUNT];
   string di_status[TF_COUNT],ema_order[TF_COUNT],trend_regime[TF_COUNT];
   int price_above_ema200[TF_COUNT]; // 1=above, 0=below, -1=unknown (EMA200 missing)
   // Forming-bar mirror of the raw indicators. Diagnostics only: never use as a
   // model feature, it is not reproducible from historical OHLC.
   datetime tf_forming_bar_time[TF_COUNT];
   double rsi_forming[TF_COUNT],adx_forming[TF_COUNT],cci_forming[TF_COUNT],atr_forming[TF_COUNT],pdi_forming[TF_COUNT],mdi_forming[TF_COUNT];
   double ema20_forming[TF_COUNT],ema50_forming[TF_COUNT],ema100_forming[TF_COUNT],ema200_forming[TF_COUNT];
   int mtf_ema200_align,mtf_di_align,mtf_valid_count;
   bool finalized, censored, external_close, hit_tp1,hit_tp2,hit_tp3,hit_ema200;
   int max_step; datetime step_time[5],tp1_time,tp2_time,tp3_time,ema200_time,close_time;
   string final_event,event_path,censor_reason; double final_profit,mfe_money,mae_money,max_dd_money,max_dd_pct;
   // ========================================================================
   // EXTENDED ML FEATURES (61 fields) - Added for complete Step1 ML schema
   // ========================================================================
   // Time/Session Features (13 fields)
   int entry_hour, entry_day_of_week, entry_month, entry_week_of_month;
   string session;
   int session_id;
   bool is_london, is_newyork, is_asia, is_overlap;
   int min_from_session_open, bars_since_signal, minutes_since_signal;
   // Price Action Features (19 fields)
   double candle_open, candle_high, candle_low, candle_close;
   double candle_range, candle_body, candle_upper_wick, candle_lower_wick;
   double signal_clv, signal_body_ratio, candle_atr_norm;
   int spread_entry;
   double spread_atr_ratio;
   long tick_volume;
   bool is_bull_candle, is_bear_candle, is_pin_bar, is_long_body, is_inside_bar;
   // Quality Control Flags (13 fields) - Metadata/quality features
   bool qc_valid, qc_all_tf_valid, qc_spread_normal, qc_all_indicators_ok, qc_no_future_leak;
   bool qc_has_ema_data, qc_has_rsi_data, qc_has_adx_data, qc_has_cci_data;
   bool qc_has_macd_data, qc_has_bb_data, qc_has_stoch_data, qc_has_williams_data;
   // Order Block State (2 fields)
   double ob_dist_pct;
   int ob_in_tol;
   // Structure State (10 fields)
   bool break_of_structure_flag, change_of_character_flag;
   int bars_since_bos, bars_since_choch;
   int last_structure_event_type; // 0=None, 1=BOS_UP, 2=BOS_DOWN, 3=CHOCH_UP, 4=CHOCH_DOWN
   bool structure_event_direction_match;
   double bos_break_distance_atr, choch_break_distance_atr;
   int bars_between_swing_and_bos;
   double range_position_since_bos;
   // RSI Gate State (4 fields)
   bool rsi_gate_enabled;
   int rsi_high_gate, rsi_low_gate;
   bool rsi_gate_passed;
   void Reset()
   {
      setup_id=0; position_id=0; is_buy=false; signal_source=""; signal_time=fill_time=feature_asof_time=0;
      fill_price=planned_entry=balance=equity=atr_distance=spread_points=ema200_at_entry=0.0;
      use_ema200_target=counter_ema200=false; p1_time=p2_time=p3_time=0;
      p1_price=p2_price=p3_price=p1_rsi=p2_rsi=p3_rsi=0.0; div_gap12=div_gap23=div_span=0;
      div_gap_ratio=div_rsi_spread=div_price_spread_atr=div_prom_atr_p3=0.0;
      price_div_strength=rsi_div_strength=div_price_slope=div_rsi_slope=divergence_angle=0.0;
      confirmation_after_p3=rsi_reclaim_after_p3=false; mtf_ema200_align=mtf_di_align=mtf_valid_count=0;
      finalized=censored=external_close=hit_tp1=hit_tp2=hit_tp3=hit_ema200=false; max_step=0;
      tp1_time=tp2_time=tp3_time=ema200_time=close_time=0; final_event=event_path=censor_reason="";
      final_profit=mfe_money=mae_money=max_dd_money=max_dd_pct=0.0;
      ArrayInitialize(step_level,0.0); ArrayInitialize(be_level,0.0); ArrayInitialize(tp,0.0); ArrayInitialize(step_time,0);
      for(int t=0;t<TF_COUNT;t++) { tf_bar_time[t]=0; tf_shift[t]=RX_FEATURE_SHIFT; tf_forming[t]=false; tf_valid[t]=false;
         rsi[t]=adx[t]=cci[t]=atr[t]=pdi[t]=mdi[t]=di_gap[t]=RX_NA; ema20[t]=ema50[t]=ema100[t]=ema200[t]=ema200_dist_atr[t]=RX_NA;
         rsi_slope5[t]=cci_slope5[t]=adx_slope5[t]=atr_regime[t]=RX_NA; ema20_slope5[t]=ema50_slope5[t]=ema200_slope5[t]=RX_NA;
         ema_gap2050[t]=ema_gap50200[t]=ema_compression[t]=RX_NA; di_status[t]=ema_order[t]=trend_regime[t]=""; price_above_ema200[t]=-1;
         tf_forming_bar_time[t]=0; rsi_forming[t]=adx_forming[t]=cci_forming[t]=atr_forming[t]=pdi_forming[t]=mdi_forming[t]=RX_NA;
         ema20_forming[t]=ema50_forming[t]=ema100_forming[t]=ema200_forming[t]=RX_NA; }
      // Reset extended ML features
      entry_hour=0; entry_day_of_week=0; entry_month=0; entry_week_of_month=0;
      session=""; session_id=0;
      is_london=false; is_newyork=false; is_asia=false; is_overlap=false;
      min_from_session_open=0; bars_since_signal=0; minutes_since_signal=0;
      candle_open=0.0; candle_high=0.0; candle_low=0.0; candle_close=0.0;
      candle_range=0.0; candle_body=0.0; candle_upper_wick=0.0; candle_lower_wick=0.0;
      signal_clv=0.0; signal_body_ratio=0.0; candle_atr_norm=0.0;
      spread_entry=0; spread_atr_ratio=0.0; tick_volume=0;
      is_bull_candle=false; is_bear_candle=false; is_pin_bar=false; is_long_body=false; is_inside_bar=false;
      qc_valid=false; qc_all_tf_valid=false; qc_spread_normal=false; qc_all_indicators_ok=false; qc_no_future_leak=false;
      qc_has_ema_data=false; qc_has_rsi_data=false; qc_has_adx_data=false; qc_has_cci_data=false;
      qc_has_macd_data=false; qc_has_bb_data=false; qc_has_stoch_data=false; qc_has_williams_data=false;
      ob_dist_pct=0.0; ob_in_tol=0;
      break_of_structure_flag=false; change_of_character_flag=false;
      bars_since_bos=0; bars_since_choch=0;
      last_structure_event_type=0;
      structure_event_direction_match=false;
      bos_break_distance_atr=0.0; choch_break_distance_atr=0.0;
      bars_between_swing_and_bos=0;
      range_position_since_bos=0.0;
      rsi_gate_enabled=false;
      rsi_high_gate=0; rsi_low_gate=0;
      rsi_gate_passed=false;
   }
};
struct SRXLifecycleEvent
{
   int setup_id, seq, step; string name, source; datetime event_time; double event_price;
   void Reset() { setup_id=seq=step=0; name=source=""; event_time=0; event_price=0.0; }
};
SRXRunMeta g_rx_run;
SRXStep1Snapshot g_rx_rows[];
SRXLifecycleEvent g_rx_events[];
int g_rx_row_count=0, g_rx_event_count=0, g_rx_seq=0;
bool g_rx_ready=false, g_rx_exported=false;
int RX_Find(const int setup_id)
{
   for(int i=0;i<g_rx_row_count;i++) if(g_rx_rows[i].setup_id==setup_id) return i;
   return -1;
}
string RX_Time(const datetime t) { return t>0 ? TimeToString(t,TIME_DATE|TIME_MINUTES|TIME_SECONDS) : ""; }
string RX_Bool(const bool v) { return v ? "1" : "0"; }
string RX_CSV(const string s) { return EscapeCSV(s); }
void RX_BeginRun()
{
   g_rx_run.Reset();
   g_rx_run.started_at=TimeCurrent();
   g_rx_run.run_id="RX_"+IntegerToString((int)g_rx_run.started_at)+"_"+_Symbol;
   g_rx_run.symbol=_Symbol; g_rx_run.broker=AccountInfoString(ACCOUNT_COMPANY);
   g_rx_run.main_tf=TFToStr((ENUM_TIMEFRAMES)Period());
   for(int t=0;t<TF_COUNT;t++) { if(t>0) g_rx_run.mtf_layout+="|"; g_rx_run.mtf_layout+=g_tf[t].name; }
   g_rx_run.is_testing=g_testing; g_rx_run.is_visual=g_visual;
   g_rx_row_count=g_rx_event_count=g_rx_seq=0; ArrayResize(g_rx_rows,0); ArrayResize(g_rx_events,0);
   g_rx_ready=true; g_rx_exported=false;
   Print("RX|RUN_BEGIN|",g_rx_run.run_id,"|Schema=",RX_SCHEMA_VERSION);
}
void RX_Event(const int setup_id,const string name,const int step,const double price,const string source)
{
   if(!g_rx_ready || RX_Find(setup_id)<0) return;
   ArrayResize(g_rx_events,g_rx_event_count+1);
   SRXLifecycleEvent e; e.Reset(); e.setup_id=setup_id; e.seq=++g_rx_seq; e.name=name; e.step=step;
   e.event_time=TimeCurrent(); e.event_price=price; e.source=source;
   g_rx_events[g_rx_event_count++]=e;
}
void RX_CaptureStep1Snapshot(const int setup_idx,const ulong position_id,const double fill_price,const datetime fill_time)
{
   if(!g_rx_ready || setup_idx<0 || setup_idx>=g_setup_cnt) return;
   const int id=g_setups[setup_idx].setup_id;
   if(RX_Find(id)>=0) return;
   ArrayResize(g_rx_rows,g_rx_row_count+1);
   SRXStep1Snapshot r; r.Reset();
   r.setup_id=id; r.position_id=position_id; r.is_buy=g_setups[setup_idx].is_bullish;
   r.signal_source=g_current_signal_source; r.signal_time=g_current_snapshot.entry_time; r.fill_time=fill_time; r.feature_asof_time=fill_time;
   r.fill_price=fill_price; r.planned_entry=g_setups[setup_idx].stop_levels[0]; r.balance=g_setups[setup_idx].entry_balance; r.equity=g_setups[setup_idx].entry_equity;
   r.atr_distance=g_setups[setup_idx].atr_distance; r.ema200_at_entry=g_setups[setup_idx].ema200_at_entry; r.use_ema200_target=g_setups[setup_idx].use_ema200_as_target;
   r.counter_ema200=(r.is_buy ? fill_price<=r.ema200_at_entry : fill_price>=r.ema200_at_entry);
   MqlTick q; if(SymbolInfoTick(_Symbol,q)) r.spread_points=(q.ask-q.bid)/_Point;
   ArrayCopy(r.step_level,g_setups[setup_idx].stop_levels); ArrayCopy(r.be_level,g_setups[setup_idx].break_even_levels);
   r.tp[0]=g_setups[setup_idx].target_levels[0]; r.tp[1]=g_setups[setup_idx].target_levels[1]; r.tp[2]=g_setups[setup_idx].target_levels[2];
   r.p1_time=g_armed_divergence.p1_time; r.p2_time=g_armed_divergence.p2_time; r.p3_time=g_armed_divergence.p3_time;
   r.p1_price=g_armed_divergence.p1_price; r.p2_price=g_armed_divergence.p2_price; r.p3_price=g_armed_divergence.p3_price;
   r.p1_rsi=g_armed_divergence.p1_rsi; r.p2_rsi=g_armed_divergence.p2_rsi; r.p3_rsi=g_armed_divergence.p3_rsi;
   r.div_gap12=g_current_snapshot.pivot_gap_12; r.div_gap23=g_current_snapshot.pivot_gap_23; r.div_span=g_current_snapshot.div_span_bars;
   r.div_gap_ratio=g_current_snapshot.pivot_gap_ratio; r.div_rsi_spread=g_current_snapshot.rsi_div_strength; r.div_price_spread_atr=g_current_snapshot.price_leg_23_atr;
   r.div_prom_atr_p3=0.0; r.price_div_strength=g_current_snapshot.price_div_strength; r.rsi_div_strength=g_current_snapshot.rsi_div_strength;
   r.div_price_slope=g_current_snapshot.div_price_slope; r.div_rsi_slope=g_current_snapshot.div_rsi_slope; r.divergence_angle=g_current_snapshot.divergence_angle;
   r.confirmation_after_p3=g_current_snapshot.confirmation_after_p3; r.rsi_reclaim_after_p3=g_current_snapshot.rsi_reclaim_after_p3;
   for(int t=0;t<TF_COUNT;t++)
   {
      // Capture policy: last completed bar (RX_FEATURE_SHIFT), so the row can be
      // reproduced from historical OHLC. Buffers are refreshed to MIN_BUFFER_DEPTH
      // first, otherwise a shallow refresh elsewhere leaves the slope lookback
      // index out of range.
      r.tf_bar_time[t]=iTime(_Symbol,g_tf[t].timeframe,RX_FEATURE_SHIFT);
      r.tf_forming_bar_time[t]=iTime(_Symbol,g_tf[t].timeframe,0);
      r.tf_shift[t]=RX_FEATURE_SHIFT; r.tf_forming[t]=false;
      if(!g_tf[t].CopyIndicatorBuffers(MIN_BUFFER_DEPTH))
         continue; // every feature stays RX_NA and TF_Valid stays 0
      r.rsi[t]=RX_Buf(g_tf[t].buffer_rsi,RX_FEATURE_SHIFT);
      r.adx[t]=RX_Buf(g_tf[t].buffer_adx,RX_FEATURE_SHIFT);
      r.cci[t]=RX_Buf(g_tf[t].buffer_cci,RX_FEATURE_SHIFT);
      r.atr[t]=RX_Buf(g_tf[t].buffer_atr,RX_FEATURE_SHIFT);
      r.pdi[t]=RX_Buf(g_tf[t].buffer_plus_di,RX_FEATURE_SHIFT);
      r.mdi[t]=RX_Buf(g_tf[t].buffer_minus_di,RX_FEATURE_SHIFT);
      r.ema20[t]=RX_Buf(g_tf[t].buffer_ema_20,RX_FEATURE_SHIFT);
      r.ema50[t]=RX_Buf(g_tf[t].buffer_ema_50,RX_FEATURE_SHIFT);
      r.ema100[t]=RX_Buf(g_tf[t].buffer_ema_100,RX_FEATURE_SHIFT);
      r.ema200[t]=RX_Buf(g_tf[t].buffer_ema_200,RX_FEATURE_SHIFT);
      // Forming-bar mirror, exported for diagnostics only.
      r.rsi_forming[t]=RX_Buf(g_tf[t].buffer_rsi,0);
      r.adx_forming[t]=RX_Buf(g_tf[t].buffer_adx,0);
      r.cci_forming[t]=RX_Buf(g_tf[t].buffer_cci,0);
      r.atr_forming[t]=RX_Buf(g_tf[t].buffer_atr,0);
      r.pdi_forming[t]=RX_Buf(g_tf[t].buffer_plus_di,0);
      r.mdi_forming[t]=RX_Buf(g_tf[t].buffer_minus_di,0);
      r.ema20_forming[t]=RX_Buf(g_tf[t].buffer_ema_20,0);
      r.ema50_forming[t]=RX_Buf(g_tf[t].buffer_ema_50,0);
      r.ema100_forming[t]=RX_Buf(g_tf[t].buffer_ema_100,0);
      r.ema200_forming[t]=RX_Buf(g_tf[t].buffer_ema_200,0);
      const bool ok_di=(RX_Ok(r.pdi[t]) && RX_Ok(r.mdi[t]));
      r.di_gap[t]=(ok_di ? MathAbs(r.pdi[t]-r.mdi[t]) : RX_NA);
      const double px=iClose(_Symbol,g_tf[t].timeframe,RX_FEATURE_SHIFT);
      const bool ok_px=(px>0.0);
      const bool ok_atr=RX_Pos(r.atr[t]);
      const bool ok_e20=RX_Pos(r.ema20[t]), ok_e50=RX_Pos(r.ema50[t]);
      const bool ok_e100=RX_Pos(r.ema100[t]), ok_e200=RX_Pos(r.ema200[t]);
      r.tf_valid[t]=(RX_Pos(r.rsi[t]) && ok_atr && ok_e200 && ok_px);
      r.ema200_dist_atr[t]=((ok_px && ok_e200 && ok_atr) ? (px-r.ema200[t])/r.atr[t] : RX_NA);
      r.price_above_ema200[t]=((ok_px && ok_e200) ? (px>r.ema200[t] ? 1 : 0) : -1);
      r.di_status[t]=(ok_di ? (r.pdi[t]>r.mdi[t] ? "+" : "-") : "");
      r.ema_order[t]=((ok_e20 && ok_e50 && ok_e100 && ok_e200) ? GetEMAOrder(r.ema20[t],r.ema50[t],r.ema100[t],r.ema200[t]) : "");
      r.trend_regime[t]=(r.ema_order[t]=="" ? "" : PO_TrendFromEMAOrder(r.ema_order[t]));
      const double rsi_b=RX_Buf(g_tf[t].buffer_rsi,RX_SLOPE_SHIFT);
      const double cci_b=RX_Buf(g_tf[t].buffer_cci,RX_SLOPE_SHIFT);
      const double adx_b=RX_Buf(g_tf[t].buffer_adx,RX_SLOPE_SHIFT);
      const double atr_b=RX_Buf(g_tf[t].buffer_atr,RX_SLOPE_SHIFT);
      r.rsi_slope5[t]=((RX_Ok(r.rsi[t]) && RX_Ok(rsi_b)) ? (r.rsi[t]-rsi_b)/RX_SLOPE_LOOKBACK : RX_NA);
      r.cci_slope5[t]=((RX_Ok(r.cci[t]) && RX_Ok(cci_b)) ? (r.cci[t]-cci_b)/RX_SLOPE_LOOKBACK : RX_NA);
      r.adx_slope5[t]=((RX_Ok(r.adx[t]) && RX_Ok(adx_b)) ? (r.adx[t]-adx_b)/RX_SLOPE_LOOKBACK : RX_NA);
      r.atr_regime[t]=((ok_atr && RX_Pos(atr_b)) ? r.atr[t]/atr_b : RX_NA);
      const double e20_b=RX_Buf(g_tf[t].buffer_ema_20,RX_SLOPE_SHIFT);
      const double e50_b=RX_Buf(g_tf[t].buffer_ema_50,RX_SLOPE_SHIFT);
      const double e200_b=RX_Buf(g_tf[t].buffer_ema_200,RX_SLOPE_SHIFT);
      r.ema20_slope5[t]=((ok_atr && ok_e20 && RX_Pos(e20_b)) ? (r.ema20[t]-e20_b)/(RX_SLOPE_LOOKBACK*r.atr[t]) : RX_NA);
      r.ema50_slope5[t]=((ok_atr && ok_e50 && RX_Pos(e50_b)) ? (r.ema50[t]-e50_b)/(RX_SLOPE_LOOKBACK*r.atr[t]) : RX_NA);
      r.ema200_slope5[t]=((ok_atr && ok_e200 && RX_Pos(e200_b)) ? (r.ema200[t]-e200_b)/(RX_SLOPE_LOOKBACK*r.atr[t]) : RX_NA);
      r.ema_gap2050[t]=((ok_atr && ok_e20 && ok_e50) ? (r.ema20[t]-r.ema50[t])/r.atr[t] : RX_NA);
      r.ema_gap50200[t]=((ok_atr && ok_e50 && ok_e200) ? (r.ema50[t]-r.ema200[t])/r.atr[t] : RX_NA);
      r.ema_compression[t]=((ok_atr && ok_e20 && ok_e50 && ok_e100 && ok_e200)
                            ? (MathMax(MathMax(r.ema20[t],r.ema50[t]),MathMax(r.ema100[t],r.ema200[t]))
                              -MathMin(MathMin(r.ema20[t],r.ema50[t]),MathMin(r.ema100[t],r.ema200[t])))/r.atr[t]
                            : RX_NA);
      if(r.tf_valid[t])
      {
         r.mtf_valid_count++;
         if(r.price_above_ema200[t]>=0 && r.is_buy==(r.price_above_ema200[t]==1)) r.mtf_ema200_align++;
         if(ok_di && ((r.is_buy && r.pdi[t]>r.mdi[t]) || (!r.is_buy && r.mdi[t]>r.pdi[t]))) r.mtf_di_align++;
      }
   }
   // ========================================================================
   // CAPTURE EXTENDED ML FEATURES (61 fields)
   // ========================================================================
   // Time/Session Features (13 fields) - Copy from g_current_snapshot
   r.entry_hour = g_current_snapshot.entry_hour;
   r.entry_day_of_week = g_current_snapshot.entry_day_of_week;
   r.entry_month = g_current_snapshot.entry_month;
   r.entry_week_of_month = g_current_snapshot.entry_week_of_month;
   r.session = g_current_snapshot.session;
   r.session_id = g_current_snapshot.session_id;
   r.is_london = g_current_snapshot.is_london;
   r.is_newyork = g_current_snapshot.is_newyork;
   r.is_asia = g_current_snapshot.is_asia;
   r.is_overlap = g_current_snapshot.is_overlap;
   r.min_from_session_open = g_current_snapshot.min_from_session_open;
   r.bars_since_signal = g_current_snapshot.bars_since_signal;
   r.minutes_since_signal = g_current_snapshot.minutes_since_signal;
   // Price Action Features (19 fields) - Copy from g_current_snapshot
   r.candle_open = g_current_snapshot.candle_open;
   r.candle_high = g_current_snapshot.candle_high;
   r.candle_low = g_current_snapshot.candle_low;
   r.candle_close = g_current_snapshot.candle_close;
   r.candle_range = g_current_snapshot.candle_range;
   r.candle_body = g_current_snapshot.candle_body;
   r.candle_upper_wick = g_current_snapshot.candle_upper_wick;
   r.candle_lower_wick = g_current_snapshot.candle_lower_wick;
   r.signal_clv = g_current_snapshot.signal_clv;
   r.signal_body_ratio = g_current_snapshot.signal_body_ratio;
   r.candle_atr_norm = g_current_snapshot.candle_atr_norm;
   r.spread_entry = g_current_snapshot.spread_entry;
   r.spread_atr_ratio = g_current_snapshot.spread_atr_ratio;
   r.tick_volume = g_current_snapshot.tick_volume;
   r.is_bull_candle = g_current_snapshot.is_bull_candle;
   r.is_bear_candle = g_current_snapshot.is_bear_candle;
   r.is_pin_bar = g_current_snapshot.is_pin_bar;
   r.is_long_body = g_current_snapshot.is_long_body;
   r.is_inside_bar = g_current_snapshot.is_inside_bar;
   // Quality Control Flags (13 fields) - Copy from g_current_snapshot
   r.qc_valid = g_current_snapshot.qc_valid;
   r.qc_all_tf_valid = g_current_snapshot.qc_all_tf_valid;
   r.qc_spread_normal = g_current_snapshot.qc_spread_normal;
   r.qc_all_indicators_ok = g_current_snapshot.qc_all_indicators_ok;
   r.qc_no_future_leak = g_current_snapshot.qc_no_future_leak;
   r.qc_has_ema_data = g_current_snapshot.qc_has_ema_data;
   r.qc_has_rsi_data = g_current_snapshot.qc_has_rsi_data;
   r.qc_has_adx_data = g_current_snapshot.qc_has_adx_data;
   r.qc_has_cci_data = g_current_snapshot.qc_has_cci_data;
   r.qc_has_macd_data = g_current_snapshot.qc_has_macd_data;
   r.qc_has_bb_data = g_current_snapshot.qc_has_bb_data;
   r.qc_has_stoch_data = g_current_snapshot.qc_has_stoch_data;
   r.qc_has_williams_data = g_current_snapshot.qc_has_williams_data;
   // Order Block State (2 fields) - Copy from g_current_snapshot
   r.ob_dist_pct = g_current_snapshot.ob_dist_pct;
   r.ob_in_tol = g_current_snapshot.ob_in_tol;
   // Structure State (10 fields) - Copy from g_current_snapshot
   r.break_of_structure_flag = g_current_snapshot.break_of_structure_flag;
   r.change_of_character_flag = g_current_snapshot.change_of_character_flag;
   r.bars_since_bos = g_current_snapshot.bars_since_bos;
   r.bars_since_choch = g_current_snapshot.bars_since_choch;
   r.last_structure_event_type = g_current_snapshot.last_structure_event_type;
   r.structure_event_direction_match = g_current_snapshot.structure_event_direction_match;
   r.bos_break_distance_atr = g_current_snapshot.bos_break_distance_atr;
   r.choch_break_distance_atr = g_current_snapshot.choch_break_distance_atr;
   r.bars_between_swing_and_bos = g_current_snapshot.bars_between_swing_and_bos;
   r.range_position_since_bos = g_current_snapshot.range_position_since_bos;
   // RSI Gate State (4 fields) - Copy from g_current_snapshot
   r.rsi_gate_enabled = g_current_snapshot.rsi_gate_enabled;
   r.rsi_high_gate = g_current_snapshot.rsi_high_gate;
   r.rsi_low_gate = g_current_snapshot.rsi_low_gate;
   r.rsi_gate_passed = g_current_snapshot.rsi_gate_passed;
   g_rx_rows[g_rx_row_count++]=r; RX_Event(id,"STEP1_OPEN",1,fill_price,"RX_CaptureStep1Snapshot");
}
void RX_RecordStepOpen(const int setup_idx,const int step,const double fill_price)
{
   if(setup_idx<0 || setup_idx>=g_setup_cnt) return; int ri=RX_Find(g_setups[setup_idx].setup_id); if(ri<0 || step<2 || step>5) return;
   if(g_rx_rows[ri].step_time[step-1]>0) return; g_rx_rows[ri].step_time[step-1]=g_setups[setup_idx].step_times[step-1]; RX_Event(g_setups[setup_idx].setup_id,"STEP"+IntegerToString(step)+"_OPEN",step,fill_price,"ManagePositions");
}
void RX_RecordFirstTouch(const int setup_idx,const string target,const double price)
{
   if(setup_idx<0 || setup_idx>=g_setup_cnt) return; int ri=RX_Find(g_setups[setup_idx].setup_id); if(ri<0) return;
   datetime now=TimeCurrent();
   if(target=="TP1") { if(g_rx_rows[ri].hit_tp1) return; g_rx_rows[ri].hit_tp1=true; g_rx_rows[ri].tp1_time=now; }
   else if(target=="TP2") { if(g_rx_rows[ri].hit_tp2) return; g_rx_rows[ri].hit_tp2=true; g_rx_rows[ri].tp2_time=now; }
   else if(target=="TP3") { if(g_rx_rows[ri].hit_tp3) return; g_rx_rows[ri].hit_tp3=true; g_rx_rows[ri].tp3_time=now; }
   else if(target=="EMA200") { if(g_rx_rows[ri].hit_ema200) return; g_rx_rows[ri].hit_ema200=true; g_rx_rows[ri].ema200_time=now; }
   else return; RX_Event(g_setups[setup_idx].setup_id,target+"_TOUCH",g_setups[setup_idx].current_step,price,"UpdateTPTouchTracking");
}
void RX_RecordExitRequested(const int setup_idx,const string reason)
{
   if(setup_idx<0 || setup_idx>=g_setup_cnt) return; RX_Event(g_setups[setup_idx].setup_id,"EXIT_REQUESTED",g_setups[setup_idx].current_step,0.0,"CloseSetupWithReason:"+reason);
}
void RX_FinalizeSetup(const int setup_idx,const double profit,const string event,const bool censored,const string censor_reason,const bool external_close)
{
   if(setup_idx<0 || setup_idx>=g_setup_cnt) return; int ri=RX_Find(g_setups[setup_idx].setup_id); if(ri<0 || g_rx_rows[ri].finalized) return;
   SRXStep1Snapshot r=g_rx_rows[ri]; r.finalized=true; r.censored=censored; r.external_close=external_close; r.censor_reason=censor_reason; r.close_time=TimeCurrent(); r.final_event=NormalizeEventString(event); r.event_path=g_setups[setup_idx].event_path;
   r.max_step=g_setups[setup_idx].max_step_reached; for(int s=0;s<5;s++) r.step_time[s]=g_setups[setup_idx].step_times[s];
   r.hit_tp1=g_setups[setup_idx].hit_tp1; r.hit_tp2=g_setups[setup_idx].hit_tp2; r.hit_tp3=g_setups[setup_idx].hit_tp3; r.hit_ema200=g_setups[setup_idx].hit_ema200;
   r.final_profit=profit; r.mfe_money=g_setups[setup_idx].mfe_money; r.mae_money=g_setups[setup_idx].mae_money; r.max_dd_money=g_setups[setup_idx].max_drawdown_money; r.max_dd_pct=g_setups[setup_idx].max_drawdown_percent;
   g_rx_rows[ri]=r;
   RX_Event(r.setup_id,(censored?"CENSORED_EOT_OPEN":(external_close?"EXTERNAL_CLOSE":"EXIT_COMPLETED")),r.max_step,0.0,"RX_FinalizeSetup");
}
void RX_CensorOpenSetups()
{
   for(int i=0;i<g_setup_cnt;i++) if(g_setups[i].is_active) RX_FinalizeSetup(i,0.0,"EOT_OPEN",true,"EOT_OPEN",false);
}
string RX_Num(const double v,const int digits) { return RX_Ok(v) ? DoubleToString(v,digits) : ""; }
string RX_Tri(const int v) { return v<0 ? "" : (v>0 ? "1" : "0"); }
// Observation-time columns only: keys, entry metadata, divergence geometry and
// the per-timeframe features. Nothing here depends on how the trade ended.
string RX_FeatureHeader()
{
   string x="RunID,SetupID,PositionID,SignalTime,Step1FillTime,FeatureAsOfTime,Direction,SignalSource,FillPrice,PlannedEntry,SpreadPoints,Balance,Equity,ATRDistance,Step2Level,Step3Level,Step4Level,Step5Level,BE2,BE3,BE4,BE5Nominal,TP1,TP2,TP3,EMA200AtEntry,UseEMA200Target,CounterEMA200,P1Time,P2Time,P3Time,P1Price,P2Price,P3Price,P1RSI,P2RSI,P3RSI,DivGap12,DivGap23,DivSpan,DivGapRatio,PriceDivStrength,RSIDivStrength,DivPriceSlope,DivRSISlope,DivergenceAngle,ConfirmationAfterP3,RSIReclaimAfterP3,MTFValid,MTFEMA200Align,MTFDIAlign";
   for(int t=0;t<TF_COUNT;t++)
   {
      const string z=g_tf[t].name;
      x+=","+z+"_BarTime,"+z+"_Shift,"+z+"_Forming,"+z+"_Valid,"+z+"_RSI,"+z+"_ADX,"+z+"_CCI,"+z+"_ATR,"+z+"_DIPlus,"+z+"_DIMinus,"+z+"_DIGap,"+z+"_EMA20,"+z+"_EMA50,"+z+"_EMA100,"+z+"_EMA200,"+z+"_EMA200DistATR,"+z+"_RSISlope5,"+z+"_CCISlope5,"+z+"_ADXSlope5,"+z+"_ATRRegime,"+z+"_EMA20Slope5ATR,"+z+"_EMA50Slope5ATR,"+z+"_EMA200Slope5ATR,"+z+"_EMAGap2050ATR,"+z+"_EMAGap50200ATR,"+z+"_EMACompressionATR,"+z+"_DIStatus,"+z+"_EMAOrder,"+z+"_TrendRegime,"+z+"_PriceAboveEMA200";
      x+=","+z+"_FormingBarTime,"+z+"_RSIForming,"+z+"_ADXForming,"+z+"_CCIForming,"+z+"_ATRForming,"+z+"_DIPlusForming,"+z+"_DIMinusForming,"+z+"_EMA20Forming,"+z+"_EMA50Forming,"+z+"_EMA100Forming,"+z+"_EMA200Forming";
   }
   // Extended ML Features (61 fields)
   x+=",EntryHour,EntryDayOfWeek,EntryMonth,EntryWeekOfMonth,Session,SessionID,IsLondon,IsNewYork,IsAsia,IsOverlap,MinFromSessionOpen,BarsSinceSignal,MinutesSinceSignal";
   x+=",CandleOpen,CandleHigh,CandleLow,CandleClose,CandleRange,CandleBody,CandleUpperWick,CandleLowerWick,SignalCLV,SignalBodyRatio,CandleATRNorm,SpreadEntry,SpreadATRNorm,TickVolume,IsBullCandle,IsBearCandle,IsPinBar,IsLongBody,IsInsideBar";
   x+=",QCValid,QCAllTFValid,QCSpreadNormal,QCAllIndicatorsOK,QCNoFutureLeak,QCHasEMAData,QCHasRSIData,QCHasADXData,QCHasCCIData,QCHasMACDData,QCHasBBData,QCHasStochData,QCHasWilliamsData";
   x+=",OBDistPct,OBInTol";
   x+=",BreakOfStructureFlag,ChangeOfCharacterFlag,BarsSinceBOS,BarsSinceCHoCH,LastStructureEventType,StructureEventDirectionMatch,BOSBreakDistanceATR,CHoCHBreakDistanceATR,BarsBetweenSwingAndBOS,RangePositionSinceBOS";
   x+=",RSIGateEnabled,RSIHighGate,RSILowGate,RSIGatePassed";
   return x;
}
string RX_FeatureRow(const SRXStep1Snapshot &r)
{
   string x=g_rx_run.run_id+","+IntegerToString(r.setup_id)+","+StringFormat("%I64u",r.position_id)+","+RX_Time(r.signal_time)+","+RX_Time(r.fill_time)+","+RX_Time(r.feature_asof_time)+","+(r.is_buy?"BUY":"SELL")+","+RX_CSV(r.signal_source)+","+DoubleToString(r.fill_price,_Digits)+","+DoubleToString(r.planned_entry,_Digits)+","+DoubleToString(r.spread_points,2)+","+DoubleToString(r.balance,2)+","+DoubleToString(r.equity,2)+","+DoubleToString(r.atr_distance,_Digits);
   for(int i=1;i<5;i++) x+=","+DoubleToString(r.step_level[i],_Digits);
   for(int i=0;i<4;i++) x+=","+DoubleToString(r.be_level[i],_Digits);
   for(int i=0;i<3;i++) x+=","+DoubleToString(r.tp[i],_Digits);
   x+=","+DoubleToString(r.ema200_at_entry,_Digits)+","+RX_Bool(r.use_ema200_target)+","+RX_Bool(r.counter_ema200)+","+RX_Time(r.p1_time)+","+RX_Time(r.p2_time)+","+RX_Time(r.p3_time)+","+DoubleToString(r.p1_price,_Digits)+","+DoubleToString(r.p2_price,_Digits)+","+DoubleToString(r.p3_price,_Digits)+","+DoubleToString(r.p1_rsi,4)+","+DoubleToString(r.p2_rsi,4)+","+DoubleToString(r.p3_rsi,4)+","+IntegerToString(r.div_gap12)+","+IntegerToString(r.div_gap23)+","+IntegerToString(r.div_span)+","+DoubleToString(r.div_gap_ratio,6)+","+DoubleToString(r.price_div_strength,8)+","+DoubleToString(r.rsi_div_strength,8)+","+DoubleToString(r.div_price_slope,8)+","+DoubleToString(r.div_rsi_slope,8)+","+DoubleToString(r.divergence_angle,8)+","+RX_Bool(r.confirmation_after_p3)+","+RX_Bool(r.rsi_reclaim_after_p3)+","+IntegerToString(r.mtf_valid_count)+","+IntegerToString(r.mtf_ema200_align)+","+IntegerToString(r.mtf_di_align);
   for(int t=0;t<TF_COUNT;t++)
   {
      x+=","+RX_Time(r.tf_bar_time[t])+","+IntegerToString(r.tf_shift[t])+","+RX_Bool(r.tf_forming[t])+","+RX_Bool(r.tf_valid[t])+","+RX_Num(r.rsi[t],6)+","+RX_Num(r.adx[t],6)+","+RX_Num(r.cci[t],6)+","+RX_Num(r.atr[t],_Digits)+","+RX_Num(r.pdi[t],6)+","+RX_Num(r.mdi[t],6)+","+RX_Num(r.di_gap[t],6)+","+RX_Num(r.ema20[t],_Digits)+","+RX_Num(r.ema50[t],_Digits)+","+RX_Num(r.ema100[t],_Digits)+","+RX_Num(r.ema200[t],_Digits)+","+RX_Num(r.ema200_dist_atr[t],6)+","+RX_Num(r.rsi_slope5[t],6)+","+RX_Num(r.cci_slope5[t],6)+","+RX_Num(r.adx_slope5[t],6)+","+RX_Num(r.atr_regime[t],6)+","+RX_Num(r.ema20_slope5[t],6)+","+RX_Num(r.ema50_slope5[t],6)+","+RX_Num(r.ema200_slope5[t],6)+","+RX_Num(r.ema_gap2050[t],6)+","+RX_Num(r.ema_gap50200[t],6)+","+RX_Num(r.ema_compression[t],6)+","+RX_CSV(r.di_status[t])+","+RX_CSV(r.ema_order[t])+","+RX_CSV(r.trend_regime[t])+","+RX_Tri(r.price_above_ema200[t]);
      x+=","+RX_Time(r.tf_forming_bar_time[t])+","+RX_Num(r.rsi_forming[t],6)+","+RX_Num(r.adx_forming[t],6)+","+RX_Num(r.cci_forming[t],6)+","+RX_Num(r.atr_forming[t],_Digits)+","+RX_Num(r.pdi_forming[t],6)+","+RX_Num(r.mdi_forming[t],6)+","+RX_Num(r.ema20_forming[t],_Digits)+","+RX_Num(r.ema50_forming[t],_Digits)+","+RX_Num(r.ema100_forming[t],_Digits)+","+RX_Num(r.ema200_forming[t],_Digits);
   }
   // Extended ML Features (61 fields)
   x+=","+IntegerToString(r.entry_hour)+","+IntegerToString(r.entry_day_of_week)+","+IntegerToString(r.entry_month)+","+IntegerToString(r.entry_week_of_month);
   x+=","+RX_CSV(r.session)+","+IntegerToString(r.session_id);
   x+=","+RX_Bool(r.is_london)+","+RX_Bool(r.is_newyork)+","+RX_Bool(r.is_asia)+","+RX_Bool(r.is_overlap);
   x+=","+IntegerToString(r.min_from_session_open)+","+IntegerToString(r.bars_since_signal)+","+IntegerToString(r.minutes_since_signal);
   x+=","+DoubleToString(r.candle_open,_Digits)+","+DoubleToString(r.candle_high,_Digits)+","+DoubleToString(r.candle_low,_Digits)+","+DoubleToString(r.candle_close,_Digits);
   x+=","+DoubleToString(r.candle_range,_Digits)+","+DoubleToString(r.candle_body,_Digits)+","+DoubleToString(r.candle_upper_wick,_Digits)+","+DoubleToString(r.candle_lower_wick,_Digits);
   x+=","+DoubleToString(r.signal_clv,6)+","+DoubleToString(r.signal_body_ratio,6)+","+DoubleToString(r.candle_atr_norm,6);
   x+=","+IntegerToString(r.spread_entry)+","+DoubleToString(r.spread_atr_ratio,6)+","+IntegerToString(r.tick_volume);
   x+=","+RX_Bool(r.is_bull_candle)+","+RX_Bool(r.is_bear_candle)+","+RX_Bool(r.is_pin_bar)+","+RX_Bool(r.is_long_body)+","+RX_Bool(r.is_inside_bar);
   x+=","+RX_Bool(r.qc_valid)+","+RX_Bool(r.qc_all_tf_valid)+","+RX_Bool(r.qc_spread_normal)+","+RX_Bool(r.qc_all_indicators_ok)+","+RX_Bool(r.qc_no_future_leak);
   x+=","+RX_Bool(r.qc_has_ema_data)+","+RX_Bool(r.qc_has_rsi_data)+","+RX_Bool(r.qc_has_adx_data)+","+RX_Bool(r.qc_has_cci_data);
   x+=","+RX_Bool(r.qc_has_macd_data)+","+RX_Bool(r.qc_has_bb_data)+","+RX_Bool(r.qc_has_stoch_data)+","+RX_Bool(r.qc_has_williams_data);
   x+=","+DoubleToString(r.ob_dist_pct,6)+","+IntegerToString(r.ob_in_tol);
   x+=","+RX_Bool(r.break_of_structure_flag)+","+RX_Bool(r.change_of_character_flag);
   x+=","+IntegerToString(r.bars_since_bos)+","+IntegerToString(r.bars_since_choch);
   x+=","+IntegerToString(r.last_structure_event_type);
   x+=","+RX_Bool(r.structure_event_direction_match);
   x+=","+DoubleToString(r.bos_break_distance_atr,6)+","+DoubleToString(r.choch_break_distance_atr,6);
   x+=","+IntegerToString(r.bars_between_swing_and_bos);
   x+=","+DoubleToString(r.range_position_since_bos,6);
   x+=","+RX_Bool(r.rsi_gate_enabled);
   x+=","+IntegerToString(r.rsi_high_gate)+","+IntegerToString(r.rsi_low_gate);
   x+=","+RX_Bool(r.rsi_gate_passed);
   return x;
}
// Post-outcome columns only. Kept in a separate file so a feature table can
// never be handed to a model with its own labels inside it.
string RX_LabelHeader()
{
   return "RunID,SetupID,PositionID,Step1FillTime,MaxStep,ReachedStep2,ReachedStep3,ReachedStep4,ReachedStep5,HitTP1,HitTP2,HitTP3,HitEMA200,Step2Time,Step3Time,Step4Time,Step5Time,TP1Time,TP2Time,TP3Time,EMA200Time,CloseTime,FinalEvent,EventPath,FinalProfit,MFEMoney,MAEMoney,MaxDDMoney,MaxDDPct,IsFinalized,IsCensored,CensorReason,IsExternalClose";
}
string RX_LabelRow(const SRXStep1Snapshot &r)
{
   return g_rx_run.run_id+","+IntegerToString(r.setup_id)+","+StringFormat("%I64u",r.position_id)+","+RX_Time(r.fill_time)+","+IntegerToString(r.max_step)+","+RX_Bool(r.max_step>=2)+","+RX_Bool(r.max_step>=3)+","+RX_Bool(r.max_step>=4)+","+RX_Bool(r.max_step>=5)+","+RX_Bool(r.hit_tp1)+","+RX_Bool(r.hit_tp2)+","+RX_Bool(r.hit_tp3)+","+RX_Bool(r.hit_ema200)+","+RX_Time(r.step_time[1])+","+RX_Time(r.step_time[2])+","+RX_Time(r.step_time[3])+","+RX_Time(r.step_time[4])+","+RX_Time(r.tp1_time)+","+RX_Time(r.tp2_time)+","+RX_Time(r.tp3_time)+","+RX_Time(r.ema200_time)+","+RX_Time(r.close_time)+","+RX_CSV(r.final_event)+","+RX_CSV(r.event_path)+","+DoubleToString(r.final_profit,2)+","+DoubleToString(r.mfe_money,2)+","+DoubleToString(r.mae_money,2)+","+DoubleToString(r.max_dd_money,2)+","+DoubleToString(r.max_dd_pct,6)+","+RX_Bool(r.finalized)+","+RX_Bool(r.censored)+","+RX_CSV(r.censor_reason)+","+RX_Bool(r.external_close);
}
string RX_JsonCols(const string header)
{
   string parts[];
   const int n=StringSplit(header,(ushort)',',parts);
   string out="";
   for(int i=0;i<n;i++) { if(i>0) out+=","; out+="\""+parts[i]+"\""; }
   return out;
}
void RX_ExportAll()
{
   if(!g_rx_ready || g_rx_exported) return;
   g_rx_run.finished_at=TimeCurrent();
   const string stem="RX_"+_Symbol+"_"+g_rx_run.run_id;
   const string features_file=stem+"_Features.csv";
   const string labels_file=stem+"_Labels.csv";
   const string events_file=stem+"_SetupLifecycleEvents.csv";
   const string feature_header=RX_FeatureHeader();
   const string label_header=RX_LabelHeader();
   int h=SafeOpenCSV(features_file,false);
   if(h!=INVALID_HANDLE)
   {
      FileWriteString(h,feature_header+"\r\n");
      for(int i=0;i<g_rx_row_count;i++) FileWriteString(h,RX_FeatureRow(g_rx_rows[i])+"\r\n");
      FileClose(h);
   }
   h=SafeOpenCSV(labels_file,false);
   if(h!=INVALID_HANDLE)
   {
      FileWriteString(h,label_header+"\r\n");
      for(int i=0;i<g_rx_row_count;i++) FileWriteString(h,RX_LabelRow(g_rx_rows[i])+"\r\n");
      FileClose(h);
   }
   h=SafeOpenCSV(events_file,false);
   if(h!=INVALID_HANDLE)
   {
      FileWriteString(h,"RunID,SetupID,Sequence,EventName,EventTime,EventPrice,Step,Source\r\n");
      for(int i=0;i<g_rx_event_count;i++) FileWriteString(h,g_rx_run.run_id+","+IntegerToString(g_rx_events[i].setup_id)+","+IntegerToString(g_rx_events[i].seq)+","+RX_CSV(g_rx_events[i].name)+","+RX_Time(g_rx_events[i].event_time)+","+DoubleToString(g_rx_events[i].event_price,_Digits)+","+IntegerToString(g_rx_events[i].step)+","+RX_CSV(g_rx_events[i].source)+"\r\n");
      FileClose(h);
   }
   int j=OpenTextUTF8(stem+"_Manifest.json",FILE_WRITE|FILE_TXT|FILE_COMMON);
   if(j!=INVALID_HANDLE)
   {
      string m="{\n";
      m+="\"schema_version\":\""+RX_SCHEMA_VERSION+"\",\n";
      m+="\"layer_version\":\""+RX_LAYER_VERSION+"\",\n";
      m+="\"run_id\":\""+g_rx_run.run_id+"\",\n";
      m+="\"symbol\":\""+g_rx_run.symbol+"\",\n";
      m+="\"mtf_layout\":\""+g_rx_run.mtf_layout+"\",\n";
      m+="\"rows\":"+IntegerToString(g_rx_row_count)+",\n";
      m+="\"events\":"+IntegerToString(g_rx_event_count)+",\n";
      m+="\"encoding\":\"utf-8\",\n";
      m+="\"na_representation\":\"empty_field\",\n";
      m+="\"csv_dialect\":{\"delimiter\":\",\",\"line_terminator\":\"crlf\",\"bom\":true,\"header_row\":0},\n";
      m+="\"join_key\":[\"RunID\",\"SetupID\"],\n";
      m+="\"capture_policy\":{\"bar\":\"last_completed\",\"shift\":"+IntegerToString(RX_FEATURE_SHIFT)+",\"slope_lookback_bars\":"+IntegerToString(RX_SLOPE_LOOKBACK)+",\"forming_columns\":\"diagnostic_only\"},\n";
      m+="\"files\":{\"features\":\""+features_file+"\",\"labels\":\""+labels_file+"\",\"events\":\""+events_file+"\"},\n";
      m+="\"feature_columns\":["+RX_JsonCols(feature_header)+"],\n";
      m+="\"label_columns\":["+RX_JsonCols(label_header)+"]\n";
      m+="}\n";
      FileWriteString(j,m);
      FileClose(j);
   }
   int q=SafeOpenHTML(stem+"_DatasetQualityReport.html");
   if(q!=INVALID_HANDLE)
   {
      int c4=0,c5=0,ce=0;
      for(int i=0;i<g_rx_row_count;i++){if(g_rx_rows[i].max_step>=4)c4++;if(g_rx_rows[i].max_step>=5)c5++;if(g_rx_rows[i].censored)ce++;}
      FileWriteString(q,"<html><body><h1>RX Dataset Quality</h1><p>RunID: "+g_rx_run.run_id+"</p><p>Step1 rows: "+IntegerToString(g_rx_row_count)+"</p><p>Lifecycle events: "+IntegerToString(g_rx_event_count)+"</p><p>Step4Plus: "+IntegerToString(c4)+"</p><p>Step5: "+IntegerToString(c5)+"</p><p>Censored: "+IntegerToString(ce)+"</p><p>Feature policy: fill-time / last completed bar (shift "+IntegerToString(RX_FEATURE_SHIFT)+"), per-TF bar-time columns, missing values exported as empty fields.</p><p>Features and labels are exported to separate files and joined on RunID+SetupID.</p></body></html>");
      FileClose(q);
   }
   g_rx_exported=true; Print("RX|EXPORT_DONE|Rows=",g_rx_row_count,"|Events=",g_rx_event_count);
}
