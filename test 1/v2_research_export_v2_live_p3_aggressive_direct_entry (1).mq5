const string DAY_NAMES[7] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
//|SAMPLE QUALITY HELPERS - v7.8|
string GetSampleBadge(int total)
{
   if(total == 0)                          return "❌";
   if(total < inp_min_sample_display)      return "!!";
   if(total < inp_min_sample_reliable)     return "!";
   if(total < inp_min_sample_confident)    return "OK";
   return "++";
}
string GetSampleText(int total)
{
   if(total == 0)                          return "No Data";
   if(total < inp_min_sample_display)      return "Insufficient (" + IntegerToString(total) + ")";
   if(total < inp_min_sample_reliable)     return "Low (" + IntegerToString(total) + ")";
   if(total < inp_min_sample_confident)    return "Moderate (" + IntegerToString(total) + ")";
   return "Good (" + IntegerToString(total) + ")";
}
bool IsSampleReliable(int total) { return total >= inp_min_sample_reliable; }
bool IsSampleConfident(int total) { return total >= inp_min_sample_confident; }
bool ShouldLog()
{
   if(g_fast_mode_active)
      return false;
   if(!g_testing || g_visual)
      return true;
   return false;
}
void LogError(string msg) { Print("ERROR: ", msg); }
void LogWarning(string msg) { Print("WARNING: ", msg); }
string GetDayName(datetime t) { MqlDateTime dt; TimeToStruct(t, dt); return (dt.day_of_week >= 0 && dt.day_of_week <= 6) ? DAY_NAMES[dt.day_of_week] : "Unknown"; }
string GetEMAOrder(double e20, double e50, double e100, double e200)
{
   if(e20 == 0|| e50 == 0|| e100 == 0|| e200 == 0) return "N/A";
   SEMAValue emas[4];
   emas[0].value = e20; emas[0].id = 0; emas[1].value = e50; emas[1].id = 1;
   emas[2].value = e100; emas[2].id = 2; emas[3].value = e200; emas[3].id = 3;
   for(int i = 0; i < 3; i++) for(int j = i + 1; j < 4; j++)
      if(emas[i].value < emas[j].value) { SEMAValue t = emas[i]; emas[i] = emas[j]; emas[j] = t; }
   const string names[4] = {"E20", "E50", "E100", "E200"};
   return names[emas[0].id] + ">" + names[emas[1].id] + ">" + names[emas[2].id] + ">" + names[emas[3].id];
}
string GetPosStatus(double p, double e20, double e50, double e100, double e200)
{
   if(p <= 0|| e20 == 0|| e50 == 0|| e100 == 0|| e200 == 0) return "N/A";
   if(p > e20 && e20 > e50 && e50 > e100 && e100 > e200) return "Up_EMA20";
   if(p < e20 && e20 < e50 && e50 < e100 && e100 < e200) return "Down_EMA20";
   if((p > e50 && p < e20) || (p > e20 && p < e50)) return "Btw_50-20";
   if(p > MathMin(e50, e100) && p < MathMax(e50, e100)) return "Btw_100-50";
   if(p > MathMin(e100, e200) && p < MathMax(e100, e200)) return "Btw_200-100";
   return (p > e200) ? "Up_EMA200" : "Down_EMA200";
}
string GetEventStatus(string e)
{
   string u = ToUpperASCII(e);
   if(StringFind(u, "SL_DOLLAR") >= 0 || StringFind(u, "SL_$") >= 0 || StringFind(u, "SL$") >= 0)
      return "SL$";
   if(StringFind(u, "TP5") >= 0) return "TP5";
   if(StringFind(u, "TP4") >= 0) return "TP4";
   if(StringFind(u, "TP3") >= 0) return "TP3";
   if(StringFind(u, "TP2") >= 0 && StringFind(u, "TP1") >= 0) return "TP1->TP2";
   if(StringFind(u, "TP2") >= 0) return "TP2";
   if(StringFind(u, "TP1") >= 0) return "TP1";
   if(StringFind(u, "EMA200") >= 0 || StringFind(u, "EMA") >= 0) return "EMA";
   if(StringFind(u, "STOP_OUT") >= 0 || StringFind(u, "MARGIN") >= 0) return "STOP";
   if(StringFind(u, "SL") >= 0) return "SL";
   if(StringFind(u, "MANUAL") >= 0) return "MANUAL_CL";
   if(StringFind(u, "BY_EA") >= 0) return "EA_CLOSE";
   if(StringFind(u, "EA_STOPPED") >= 0) return "EA_STOPPED";
   if(StringFind(u, "CLOSED") >= 0) return "CL_OTHER";
   return e;
}
ENUM_TIMEFRAMES MinToTF(int m) {
   switch(m) { case 1: return PERIOD_M1; case 5: return PERIOD_M5; case 15: return PERIOD_M15;
               case 30: return PERIOD_M30; case 60: return PERIOD_H1; case 240: return PERIOD_H4;
               case 1440: return PERIOD_D1; default: return PERIOD_H1; }
}
string TFToStr(ENUM_TIMEFRAMES tf) {
   if(tf == PERIOD_CURRENT) tf = (ENUM_TIMEFRAMES)Period();
   switch(tf) {
      case PERIOD_M1:  return "M1";
      case PERIOD_M5:  return "M5";
      case PERIOD_M15: return "M15";
      case PERIOD_M30: return "M30";
      case PERIOD_H1:  return "H1";
      case PERIOD_H4:  return "H4";
      case PERIOD_D1:  return "D1";
      case PERIOD_W1:  return "W1";
      case PERIOD_MN1: return "MN1";
      default: return "N/A";
   }
}
int GetTFIndexByPeriod(ENUM_TIMEFRAMES tf)
{
   for(int i = 0; i < TF_COUNT; i++)
      if(g_tf[i].timeframe == tf)
         return i;
   return -1;
}
// Trend Pullback Filter: فقط هم‌جهت با روند H1/H4 اجازه ورود می‌دهد
bool PassTrendPullbackFilter(bool is_bull, string &reason)
{
   reason = "";
   int h1 = GetTFIndexByPeriod(PERIOD_H1);
   int h4 = GetTFIndexByPeriod(PERIOD_H4);
   // اگر H1/H4 در MTF شما تعریف نشده، فیلتر را اعمال نکن (fail-open)
   if(h1 < 0 && h4 < 0)
      return true;
   string bull_order = "E20>E50>E100>E200";
   string bear_order = "E200>E100>E50>E20";
   string need_order = is_bull ? bull_order : bear_order;
   string need_di    = is_bull ? "+" : "-";
   // حداقل ADX برای اینکه بگیم HTF واقعاً جهت‌دار است
   const double MIN_HTF_ADX = 18.0;
   bool ok_h1 = false, ok_h4 = false;
   if(h1 >= 0)
   {
      string ema = g_current_snapshot.ema_order[h1];
      string di  = g_current_snapshot.di[h1];
      double adx = g_current_snapshot.adx[h1];
      ok_h1 = (ema == need_order && di == need_di && adx >= MIN_HTF_ADX);
   }
   if(h4 >= 0)
   {
      string ema = g_current_snapshot.ema_order[h4];
      string di  = g_current_snapshot.di[h4];
      double adx = g_current_snapshot.adx[h4];
      ok_h4 = (ema == need_order && di == need_di && adx >= MIN_HTF_ADX);
   }
   if(ok_h1 || ok_h4)
      return true;
   // دلیل رد شدن
   string h1_dbg = "";
   string h4_dbg = "";
   if(h1 >= 0)
      h1_dbg = "H1[EMA=" + g_current_snapshot.ema_order[h1] + ", DI=" + g_current_snapshot.di[h1] +
               ", ADX=" + DoubleToString(g_current_snapshot.adx[h1], 1) + "]";
   else
      h1_dbg = "H1[NA]";
   if(h4 >= 0)
      h4_dbg = "H4[EMA=" + g_current_snapshot.ema_order[h4] + ", DI=" + g_current_snapshot.di[h4] +
               ", ADX=" + DoubleToString(g_current_snapshot.adx[h4], 1) + "]";
   else
      h4_dbg = "H4[NA]";
   reason = "HTF trend not aligned for " + string(is_bull ? "BUY" : "SELL") + " | " + h1_dbg + " " + h4_dbg;
   return false;
}
//|Check if market is open - ENHANCED|
bool IsMarketOpen()
{
   // اگر ترمینال اجازه ترید نمی‌دهد
   if(!TerminalInfoInteger(TERMINAL_TRADE_ALLOWED)) return false;
   if(!MQLInfoInteger(MQL_TRADE_ALLOWED))           return false;
   MqlTick t;
   if(!SymbolInfoTick(_Symbol, t))
      return false;
   if(t.bid <= 0 || t.ask <= 0)
      return false;
   long trade_mode = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_MODE);
   if(trade_mode == SYMBOL_TRADE_MODE_DISABLED || trade_mode == SYMBOL_TRADE_MODE_CLOSEONLY)
      return false;
   // زمان سرور/ترید
   datetime now = TimeTradeServer();
   if(now == 0) now = TimeCurrent();
   if(g_trade_blocked_until > 0 && now < g_trade_blocked_until)
      return false;
   MqlDateTime dt;
   TimeToStruct(now, dt);
   ENUM_DAY_OF_WEEK dow = (ENUM_DAY_OF_WEEK)dt.day_of_week;
   // --- Session check (برای اینکه در تستر هم Market Closed درست تشخیص داده شود) ---
   bool have_sessions = false;
   bool in_session    = false;
   int cur_sec = dt.hour * 3600 + dt.min * 60 + dt.sec;
   for(uint s = 0; s < 10; s++)
   {
      datetime from, to;
      if(!SymbolInfoSessionTrade(_Symbol, dow, s, from, to))
         break;
      if(from == 0 && to == 0)
         continue;
      have_sessions = true;
      MqlDateTime fdt, tdt;
      TimeToStruct(from, fdt);
      TimeToStruct(to,   tdt);
      int from_sec = fdt.hour * 3600 + fdt.min * 60 + fdt.sec;
      int to_sec   = tdt.hour * 3600 + tdt.min * 60 + tdt.sec;
      if(from_sec == to_sec)
         continue;
      // session معمولی
      if(from_sec < to_sec)
      {
         if(cur_sec >= from_sec && cur_sec < to_sec)
         {
            in_session = true;
            break;
         }
      }
      else
      {
         if(cur_sec >= from_sec || cur_sec < to_sec)
         {
            in_session = true;
            break;
         }
      }
   }
   // Fail closed: every broker request must be backed by an explicit
   // SymbolInfoSessionTrade() session for the current server day/time.
   if(!have_sessions || !in_session)
      return false;
   return true;
}
bool IsSpreadOK() { return !inp_use_spread_filter|| SymbolInfoInteger(_Symbol, SYMBOL_SPREAD) <= inp_max_spread_points; }
bool IsSessionActive()
{
   if(!inp_use_session_filter) return true;
   MqlDateTime dt; TimeToStruct(TimeGMT(), dt); int h = dt.hour;
   if(inp_trade_london && h >= inp_london_start && h < inp_london_end) return true;
   if(inp_trade_newyork && h >= inp_newyork_start && h < inp_newyork_end) return true;
   if(inp_trade_asia) {
      if(inp_asia_start > inp_asia_end) { if(h >= inp_asia_start|| h < inp_asia_end) return true; }
      else { if(h >= inp_asia_start && h < inp_asia_end) return true; }
   }
   return false;
}
double GetEMA200LiveMain()
{
   double b[];
   ArrayResize(b, 1);
   ArraySetAsSeries(b, true);
   if(g_tf[0].handle_ema_200 == INVALID_HANDLE)
      return 0;
   if(CopyBuffer(g_tf[0].handle_ema_200, 0, 0, 1, b) > 0)
   {
      if(b[0] != EMPTY_VALUE && MathIsValidNumber(b[0]))
         return b[0];
   }
   return 0;
}
double GetLotSize()
{
   if(!inp_use_dynamic_lot_size) return inp_fixed_lot_size;
   double b = AccountInfoDouble(ACCOUNT_BALANCE);
   if(b >= inp_balance_tier_7) return inp_lot_for_tier_7;
   if(b >= inp_balance_tier_6) return inp_lot_for_tier_6;
   if(b >= inp_balance_tier_5) return inp_lot_for_tier_5;
   if(b >= inp_balance_tier_4) return inp_lot_for_tier_4;
   if(b >= inp_balance_tier_3) return inp_lot_for_tier_3;
   if(b >= inp_balance_tier_2) return inp_lot_for_tier_2;
   return inp_lot_for_tier_1;
}
ENUM_ORDER_TYPE_FILLING GetFilling() {
   uint m = (uint)SymbolInfoInteger(_Symbol, SYMBOL_FILLING_MODE);
   if((m & SYMBOL_FILLING_FOK) != 0) return ORDER_FILLING_FOK;
   if((m & SYMBOL_FILLING_IOC) != 0) return ORDER_FILLING_IOC;
   return ORDER_FILLING_RETURN;
}
// Non-executing broker preflight. It does not accept/reject a strategy signal;
// it only suppresses an OrderSend request when the server reports MARKET_CLOSED.
bool CanSubmitMarketOrder(bool is_long,double volume)
{
   if(!IsMarketOpen()) return false; // includes SymbolInfoSessionTrade()
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol,tk)) return false;
   MqlTradeRequest req;
   MqlTradeCheckResult chk;
   ZeroMemory(req);
   ZeroMemory(chk);
   req.action=TRADE_ACTION_DEAL;
   req.magic=inp_magic_number;
   req.symbol=_Symbol;
   req.volume=volume;
   req.type=is_long ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   req.price=is_long ? tk.ask : tk.bid;
   req.deviation=inp_slippage_points;
   req.type_filling=GetFilling();
   req.type_time=ORDER_TIME_GTC;
   bool checked=OrderCheck(req,chk);
   if((!checked && chk.retcode==TRADE_RETCODE_MARKET_CLOSED) ||
      chk.retcode==TRADE_RETCODE_MARKET_CLOSED)
   {
      datetime now=TimeTradeServer(); if(now==0) now=TimeCurrent();
      g_trade_blocked_until=now+120;
      return false;
   }
   // Preserve existing strategy/broker behavior for every non-session result.
   return true;
}
bool CanSubmitPositionClose(ulong ticket)
{
   if(!IsMarketOpen()) return false; // includes SymbolInfoSessionTrade()
   if(!PositionSelectByTicket(ticket)) return true;
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol,tk)) return false;
   ENUM_POSITION_TYPE pos_type=(ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
   MqlTradeRequest req;
   MqlTradeCheckResult chk;
   ZeroMemory(req);
   ZeroMemory(chk);
   req.action=TRADE_ACTION_DEAL;
   req.magic=inp_magic_number;
   req.position=ticket;
   req.symbol=_Symbol;
   req.volume=PositionGetDouble(POSITION_VOLUME);
   req.type=(pos_type==POSITION_TYPE_BUY ? ORDER_TYPE_SELL : ORDER_TYPE_BUY);
   req.price=(req.type==ORDER_TYPE_BUY ? tk.ask : tk.bid);
   req.deviation=inp_slippage_points;
   req.type_filling=GetFilling();
   req.type_time=ORDER_TIME_GTC;
   bool checked=OrderCheck(req,chk);
   if((!checked && chk.retcode==TRADE_RETCODE_MARKET_CLOSED) ||
      chk.retcode==TRADE_RETCODE_MARKET_CLOSED)
   {
      datetime now=TimeTradeServer(); if(now==0) now=TimeCurrent();
      g_trade_blocked_until=now+120;
      return false;
   }
   return true;
}
void GetPivotParams(ENUM_PIVOT_TYPE pt, int &l, int &r) {
   switch(pt) { case PIVOT_MAJOR: l=8; r=5; break; case PIVOT_MID_MAJOR: l=5; r=3; break;
                case PIVOT_MINOR: l=3; r=2; break; case PIVOT_SUPER_MINOR: l=2; r=2; break;
                default: l=inp_pivot_left_bars; r=inp_pivot_right_bars; }
}
string BuildComment(int id) { return IntegerToString(inp_magic_number) + "_S" + IntegerToString(id); }
int CountPositions(int id)
{
   string cf = BuildComment(id); int cnt = 0;
   for(int i = 0; i < PositionsTotal(); i++) {
      if(PositionGetSymbol(i) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) == cf) cnt++;
   }
   return cnt;
}
double CalcHistProfit(int id, datetime from)
{
   string cf = BuildComment(id);
   for(int attempt = 0; attempt < 3; attempt++)
   {
      if(!HistorySelect(from - 86400, TimeCurrent() + 60))
      {
         if(attempt < 2) Sleep(200);
         continue;
      }
      // مرحله ۱: پیدا کردن POSITION_IDهای مربوط به این setup
      ulong pos_ids[];
      int pos_count = 0;
      int deals_total = HistoryDealsTotal();
      for(int i = 0; i < deals_total; i++)
      {
         ulong ticket = HistoryDealGetTicket(i);
         if(ticket == 0) continue;
         string deal_comment = HistoryDealGetString(ticket, DEAL_COMMENT);
         if(StringFind(deal_comment, cf) >= 0)
         {
            ulong pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
            if(pid == 0) continue;
            bool found = false;
            for(int p = 0; p < pos_count; p++)
            {
               if(pos_ids[p] == pid)
               {
                  found = true;
                  break;
               }
            }
            if(!found)
            {
               ArrayResize(pos_ids, pos_count + 1);
               pos_ids[pos_count++] = pid;
            }
         }
      }
      if(pos_count == 0)
      {
         if(attempt < 2) Sleep(200);
         continue;
      }
      // مرحله ۲: نتیجه واقعی همه dealهای مربوط به این positionها.
      // Profit/Swap/Commission/Fee تمام IN و OUT dealها جمع می‌شود؛ بنابراین
      // بروکر چه هزینه را هنگام Open و چه هنگام Close ثبت کند، نتیجه نهایی
      // Basket شامل آن خواهد بود و هیچ هزینه‌ای به علت محل ثبت حذف نمی‌شود.
      double total = 0.0;
      for(int i = 0; i < deals_total; i++)
      {
         ulong ticket = HistoryDealGetTicket(i);
         if(ticket == 0) continue;
         ulong deal_pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
         if(deal_pid == 0) continue;
         bool belongs = false;
         for(int p = 0; p < pos_count; p++)
         {
            if(pos_ids[p] == deal_pid)
            {
               belongs = true;
               break;
            }
         }
         if(!belongs) continue;
         total += HistoryDealGetDouble(ticket, DEAL_PROFIT);
         total += HistoryDealGetDouble(ticket, DEAL_SWAP);
         total += HistoryDealGetDouble(ticket, DEAL_COMMISSION);
         total += HistoryDealGetDouble(ticket, DEAL_FEE);
      }
      ArrayFree(pos_ids);
      if(pos_count > 0)
         return total;
   }
   return 0.0;
}
double GetOpenSetupFloatingProfit(int id)
{
   string cf = BuildComment(id);
   double total = 0.0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;
      if(!PositionSelectByTicket(ticket)) continue;
      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if(PositionGetInteger(POSITION_MAGIC) != (long)inp_magic_number) continue;
      if(PositionGetString(POSITION_COMMENT) != cf) continue;
      total += PositionGetDouble(POSITION_PROFIT);
      total += PositionGetDouble(POSITION_SWAP);
      // اگر خواستی و بیلدت ساپورت کرد، این را هم می‌توانی اضافه کنی:
      // total += PositionGetDouble(POSITION_COMMISSION);
   }
   return total;
}
string GetDuration(datetime s, datetime e)
{
   if(s == 0|| e == 0|| e <= s) return "--";
   long d = (long)(e - s);
   return StringFormat("%2d/%02d:%02d:%02d", (int)(d/86400), (int)((d%86400)/3600), (int)((d%3600)/60), (int)(d%60));
}
string EscapeCSV(string f) {
   if(StringFind(f, ",") >= 0|| StringFind(f, "\"") >= 0) { StringReplace(f, "\"", "\"\""); return "\"" + f + "\""; }
   return f;
}
//|Safe Open HTML File - بدون BOM (برای HTML لازم نیس|
int SafeOpenHTML(string filename)
{
   int h = OpenTextUTF8(filename, FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE)
   {
      LogError("Failed to open HTML: " + filename);
      return INVALID_HANDLE;
   }
   return h;
}
// excel_sep writes the Excel "sep=," preamble. It must be disabled for machine
// readable datasets: it is not part of the CSV format and shifts the header row.
int SafeOpenCSV(string filename, bool excel_sep = true)
{
   if(FileIsExist(filename, FILE_COMMON))
      FileDelete(filename, FILE_COMMON);
   int h = FileOpen(filename, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      LogError("Failed to open CSV: " + filename);
      return INVALID_HANDLE;
   }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   if(excel_sep)
   {
      uchar sep_data[];
      StringToCharArray("sep=,\r\n", sep_data, 0, WHOLE_ARRAY, CP_UTF8);
      FileWriteArray(h, sep_data, 0, ArraySize(sep_data) - 1);
   }
   FileClose(h);
   h = OpenTextUTF8(filename, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h != INVALID_HANDLE)
      FileSeek(h, 0, SEEK_END);
   else
      LogError("Failed to reopen CSV as UTF-8: " + filename);
   return h;
}
//|Safe Open file for Reading|
int SafeOpenRead(string filename)
{
   int h = FileOpen(filename, FILE_READ| FILE_TXT| FILE_SHARE_READ| FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      LogError("Failed to open for reading: " + filename);
      return INVALID_HANDLE;
   }
   return h;
}
//|Safe Open file for Append|
int SafeOpenAppend(string filename)
{
   if(!FileIsExist(filename, FILE_COMMON))
   {
      LogError("File does not exist for append: " + filename);
      return INVALID_HANDLE;
   }
   int h = FileOpen(filename, FILE_READ| FILE_WRITE| FILE_TXT| FILE_SHARE_READ| FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      LogError("Failed to open for append: " + filename);
      return INVALID_HANDLE;
   }
   FileSeek(h, 0, SEEK_END);
   return h;
}
bool ValidateInputs()
{
   bool ok = true;
   int err = 0;
   if(inp_rsi_period < 2 || inp_rsi_period > 100) { LogError("RSI period invalid"); ok = false; err++; }
   if(inp_rsi_oversold >= inp_rsi_overbought) { LogError("RSI oversold >= overbought"); ok = false; err++; }
   if(inp_rsi_low_gate >= inp_rsi_high_gate) { LogError("RSI low gate >= high gate"); ok = false; err++; }
   if(inp_atr_period < 1 || inp_atr_period > 100) { LogError("ATR period invalid"); ok = false; err++; }
   if(inp_atr_multiplier <= 0) { LogError("ATR multiplier must be positive"); ok = false; err++; }
   if(inp_net_be_safety_buffer_dollars < 0.0) { LogError("NET_BASKET_BE safety buffer must be >= 0"); ok = false; err++; }
   if(inp_enable_market_edge_collector && inp_market_edge_version!=V923_MARKET_TARGET_VERSION)
      { LogError("Market Edge version must remain frozen at "+string(V923_MARKET_TARGET_VERSION)); ok=false; err++; }
   if(inp_enable_market_edge_collector && inp_div3_span_shadow_audit_only)
      { LogError("Market Edge collector is incompatible with DIV3 span audit-only mode"); ok=false; err++; }
   if(inp_pivot_left_bars < 1 || inp_pivot_right_bars < 1) { LogError("Pivot bars must be >= 1"); ok = false; err++; }
   if(inp_min_pivot_gap_between < 1) { LogError("inp_min_pivot_gap_between must be >= 1"); ok = false; err++; }
   if(inp_max_pivot_span_p1_p3 < 5) { LogError("inp_max_pivot_span_p1_p3 too small"); ok = false; err++; }
   if(inp_div3_extra_left_bars < 0 || inp_div3_extra_right_bars < 0) { LogError("DIV3 extra bars must be >= 0"); ok = false; err++; }
   if(inp_div3_min_prominence_atr < 0.0) { LogError("DIV3 prominence ATR must be >= 0"); ok = false; err++; }
   if(inp_div3_min_same_side_excursion_atr < 0.0) { LogError("DIV3 excursion ATR must be >= 0"); ok = false; err++; }
   if(inp_div3_rsi_alignment_tolerance < 0 || inp_div3_rsi_alignment_tolerance > 10) { LogError("DIV3 RSI alignment tolerance must be 0..10"); ok = false; err++; }
   int div3_base_left=0, div3_base_right=0;
   GetPivotParams(inp_pivot_type,div3_base_left,div3_base_right);
   int div3_confirm_right = div3_base_right + (inp_div3_require_multiscale ? inp_div3_extra_right_bars : 0);
   if(inp_div3_rsi_alignment == DIV3_RSI_LOCAL_EXTREME && inp_div3_rsi_alignment_tolerance > div3_confirm_right) { LogError("DIV3 RSI tolerance exceeds confirmed right-side bars"); ok = false; err++; }
   if(inp_ob_touch_precision_pct < 0) { LogError("OB touch precision pct must be >= 0"); ok = false; err++; }
   if(inp_fixed_lot_size <= 0) { LogError("Lot size must be positive"); ok = false; err++; }
   double minl = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   double maxl = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   if(minl > 0 && inp_fixed_lot_size < minl) { LogError("Lot size < broker min"); ok = false; err++; }
   if(maxl > 0 && inp_fixed_lot_size > maxl) { LogError("Lot size > broker max"); ok = false; err++; }
   // --- MTF minutes sanity (IMPORTANT چون کد در جاهایی از TF_IDX_* ثابت استفاده کرده) ---
   int m1 = inp_mtf_minutes_1;
   int m2 = inp_mtf_minutes_2;
   int m3 = inp_mtf_minutes_3;
   int m4 = inp_mtf_minutes_4;
   int m5 = inp_mtf_minutes_5;
   if(!(m1 == 5 && m2 == 15 && m3 == 30 && m4 == 60 && m5 == 240))
   {
      LogError("MTF minutes must be exactly: 5,15,30,60,240 (because code uses TF_IDX_M5..TF_IDX_H4 fixed indices in some logic).");
      ok = false; err++;
   }
   if(ok) Print("All parameters validated!");
   else   Print("VALIDATION FAILED: ", err, " error(s)");
   return ok;
}
int CountActiveSetups() { int c=0; for(int i=0; i<g_setup_cnt; i++) if(g_setups[i].is_active) c++; return c; }
//|DEBUG FUNCTION|
void DebugPrintAnalysisStatus(string stage)
{
   int total_ema = 0, total_rsi = 0, total_adx = 0;
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      for(int s = 0; s < 5; s++)
      {
         total_ema += g_ema_buy[tf][s].total_trades + g_ema_sell[tf][s].total_trades;
         total_rsi += g_rsi_buy[tf][s].total_trades + g_rsi_sell[tf][s].total_trades;
         total_adx += g_adx_buy[tf][s].total_trades + g_adx_sell[tf][s].total_trades;
      }
   }
   Print("=== DEBUG [", stage, "] === EMA:", total_ema, "| RSI:", total_rsi, "| ADX:", total_adx);
}
