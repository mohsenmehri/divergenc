      row += IntegerToString(sn.ob_age_bars) + ",";
      row += DoubleToString(sn.ob_width_atr, 3) + ",";
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         row += DoubleToString(sn.ema20[tf], _Digits) + ",";
