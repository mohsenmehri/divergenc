   {
      total = g_pivdist_buy[step].total_trades;
      if(total <= 0) return "<td>-</td><td>-</td>";
      if(is_p1)
      {
         count_n = g_pivdist_buy[step].p1_count;
         if(rank >= count_n) return "<td>-</td><td>-</td>";
         rs = g_pivdist_buy[step].pivot1[rank].dist;
         cnt = g_pivdist_buy[step].pivot1[rank].count;
      }
      else
      {
         count_n = g_pivdist_buy[step].p2_count;
         if(rank >= count_n) return "<td>-</td><td>-</td>";
         rs = g_pivdist_buy[step].pivot2[rank].dist;
         cnt = g_pivdist_buy[step].pivot2[rank].count;
      }
   }
   else
   {
      total = g_pivdist_sell[step].total_trades;
      if(total <= 0) return "<td>-</td><td>-</td>";
      if(is_p1)
      {
         count_n = g_pivdist_sell[step].p1_count;
         if(rank >= count_n) return "<td>-</td><td>-</td>";
         rs = g_pivdist_sell[step].pivot1[rank].dist;
         cnt = g_pivdist_sell[step].pivot1[rank].count;
