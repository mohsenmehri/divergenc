bool S2B_FU_GlobalFieldValue(SEntrySnapshot &sn,int f,double &out)
{
   out=0.0;
   switch(f)
   {
      case 0: { double v=(sn.is_bullish?1.0:0.0); out=v; return (true); }
      case 1: { double v=(double)sn.entry_hour; out=v; return (v>=0.0 && v<=23.0); }
      case 2: { double v=(double)sn.entry_day_of_week; out=v; return (v>=0.0 && v<=6.0); }
      case 3: { double v=(double)sn.entry_month; out=v; return (v>=1.0 && v<=12.0); }
      case 4: { double v=(double)sn.entry_week_of_month; out=v; return (v>=1.0 && v<=6.0); }
      case 5: { double v=(double)sn.session_id; out=v; return (v>=0.0); }
      case 6: { double v=(sn.is_london?1.0:0.0); out=v; return (true); }
      case 7: { double v=(sn.is_newyork?1.0:0.0); out=v; return (true); }
      case 8: { double v=(sn.is_asia?1.0:0.0); out=v; return (true); }
      case 9: { double v=(sn.is_overlap?1.0:0.0); out=v; return (true); }
      case 10: { double v=(double)sn.min_from_session_open; out=v; return (v>=0.0); }
      case 11: { double v=(double)sn.bars_since_signal; out=v; return (v>=0.0); }
      case 12: { double v=(double)sn.minutes_since_signal; out=v; return (v>=0.0); }
      case 13: { double v=sn.candle_range; out=v; return (v>0.0); }
      case 14: { double v=sn.candle_body; out=v; return (v>=0.0 && sn.candle_range>0.0); }
      case 15: { double v=sn.candle_upper_wick; out=v; return (v>=0.0 && sn.candle_range>0.0); }
      case 16: { double v=sn.candle_lower_wick; out=v; return (v>=0.0 && sn.candle_range>0.0); }
      case 17: { double v=(sn.candle_range>0.0?sn.candle_body/sn.candle_range:0.0); out=v; return (sn.candle_range>0.0); }
      case 18: { double v=(sn.candle_range>0.0?sn.candle_upper_wick/sn.candle_range:0.0); out=v; return (sn.candle_range>0.0); }
      case 19: { double v=(sn.candle_range>0.0?sn.candle_lower_wick/sn.candle_range:0.0); out=v; return (sn.candle_range>0.0); }
      case 20: { double v=sn.signal_clv; out=v; return (v>=0.0 && v<=1.0); }
      case 21: { double v=sn.signal_body_ratio; out=v; return (v>=0.0 && v<=1.0); }
      case 22: { double v=sn.candle_atr_norm; out=v; return (v>0.0); }
      case 23: { double v=sn.spread_atr_ratio; out=v; return (v>=0.0); }
      case 24: { double v=(double)sn.spread_entry; out=v; return (v>=0.0); }
      case 25: { double v=(double)sn.tick_volume; out=v; return (v>0.0); }
      case 26: { double v=(sn.is_bull_candle?1.0:0.0); out=v; return (true); }
      case 27: { double v=(sn.is_pin_bar?1.0:0.0); out=v; return (true); }
      case 28: { double v=(sn.is_long_body?1.0:0.0); out=v; return (true); }
      case 29: { double v=(sn.is_inside_bar?1.0:0.0); out=v; return (true); }
      case 30: { double v=(sn.is_outside_bar?1.0:0.0); out=v; return (true); }
      case 31: { double v=(double)sn.prev3_bull_count; out=v; return (v>=0.0 && v<=3.0); }
      case 32: { double v=sn.last5_body_avg; out=v; return (v>0.0); }
      case 33: { double v=sn.last5_range_avg; out=v; return (v>0.0); }
      case 34: { double v=(sn.last5_atr_expansion?1.0:0.0); out=v; return (true); }
      case 35: { double v=(sn.last5_body_avg>0.0?sn.candle_body/sn.last5_body_avg:0.0); out=v; return (sn.last5_body_avg>0.0); }
      case 36: { double v=(sn.last5_range_avg>0.0?sn.candle_range/sn.last5_range_avg:0.0); out=v; return (sn.last5_range_avg>0.0); }
      case 37: { double v=(double)sn.pivot1_dist; out=v; return (v>0.0); }
      case 38: { double v=(double)sn.pivot2_dist; out=v; return (v>0.0); }
      case 39: { double v=sn.pivot1_rsi; out=v; return (v>0.0 && v<=100.0); }
      case 40: { double v=sn.pivot2_rsi; out=v; return (v>0.0 && v<=100.0); }
      case 41: { double v=(double)sn.piv_gap_min; out=v; return (v>0.0); }
      case 42: { double v=(double)sn.piv_gap_max; out=v; return (v>0.0); }
      case 43: { double v=sn.ob_dist_pct; out=v; return (v>=0.0); }
      case 44: { double v=(double)sn.ob_in_tol; out=v; return (v>=0.0); }
      case 45: { double v=(double)sn.ob_age_bars; out=v; return (v>=0.0); }
      case 46: { double v=sn.ob_width_atr; out=v; return (v>0.0); }
      case 47: { double v=sn.price_div_strength; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 48: { double v=sn.rsi_div_strength; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 49: { double v=sn.div_price_slope; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 50: { double v=sn.div_rsi_slope; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 51: { double v=(double)sn.div_span_bars; out=v; return (v>0.0); }
      case 52: { double v=sn.divergence_angle; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 53: { double v=sn.pivot_symmetry; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 54: { double v=(double)sn.time_since_p3; out=v; return (v>=0.0); }
      case 55: { double v=sn.pivot_rsi_p1; out=v; return (v>0.0 && v<=100.0); }
      case 56: { double v=sn.pivot_rsi_p2; out=v; return (v>0.0 && v<=100.0); }
      case 57: { double v=sn.pivot_rsi_p3; out=v; return (v>0.0 && v<=100.0); }
      case 58: { double v=sn.price_p1_to_p2_chg; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 59: { double v=sn.price_p2_to_p3_chg; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 60: { double v=sn.price_leg_ratio; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 61: { double v=sn.rsi_p1_to_p2_delta; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 62: { double v=sn.rsi_p2_to_p3_delta; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 63: { double v=sn.rsi_acceleration; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 64: { double v=(double)sn.pivot_gap_12; out=v; return (v>0.0); }
      case 65: { double v=(double)sn.pivot_gap_23; out=v; return (v>0.0); }
      case 66: { double v=sn.pivot_gap_ratio; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 67: { double v=sn.price_leg_12_atr; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 68: { double v=sn.price_leg_23_atr; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 69: { double v=(sn.confirmation_after_p3?1.0:0.0); out=v; return (true); }
      case 70: { double v=(sn.rsi_reclaim_after_p3?1.0:0.0); out=v; return (true); }
      case 71: { double v=sn.tick_volume_ratio_20; out=v; return (MathIsValidNumber(v) && v>0.0); }
      case 72: { double v=sn.tick_volume_zscore_20; out=v; return (MathIsValidNumber(v)); }
      case 73: { double v=(double)sn.bars_since_swing_high; out=v; return (v>=0.0); }
      case 74: { double v=(double)sn.bars_since_swing_low; out=v; return (v>=0.0); }
      case 75: { double v=sn.distance_to_swing_high_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 76: { double v=sn.distance_to_swing_low_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 77: { double v=(sn.break_of_structure_flag?1.0:0.0); out=v; return (true); }
      case 78: { double v=(sn.change_of_character_flag?1.0:0.0); out=v; return (true); }
      case 79: { double v=(double)sn.bars_since_bos; out=v; return (v>=0.0); }
      case 80: { double v=(double)sn.bars_since_choch; out=v; return (v>=0.0); }
      case 81: { double v=sn.range_position_last_n; out=v; return (MathIsValidNumber(v)); }
      case 82: { double v=sn.bos_break_distance_atr; out=v; return (MathIsValidNumber(v) && v!=0.0); }
      case 83: { double v=(double)sn.bars_between_swing_and_bos; out=v; return (v>=0.0); }
      case 84: { double v=(double)sn.last_structure_event_type; out=v; return (v>=0.0 && v<=4.0); }
      case 85: { double v=(sn.structure_event_direction_match?1.0:0.0); out=v; return (true); }
      case 86: { double v=sn.range_position_since_bos; out=v; return (MathIsValidNumber(v)); }
