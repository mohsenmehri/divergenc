struct SGroupStats
{
   int      count;
   ENUM_TRADE_GROUP group_type;
   //=== Averages per TF ===
   double   avg_rsi[TF_COUNT];
   double   avg_adx[TF_COUNT];
   double   avg_cci[TF_COUNT];
   double   avg_atr[TF_COUNT];
   double   avg_ema200_dist[TF_COUNT];
   double   avg_di_gap[TF_COUNT];
   //=== DI Distribution per TF ===
   int      di_plus_count[TF_COUNT];
   int      di_minus_count[TF_COUNT];
   //=== Other Averages ===
   double   avg_pivot1_dist;
   double   avg_pivot2_dist;
   double   avg_stability;
   double   avg_profit;
   double   avg_di_agreement;
   double   avg_ema_bullish;
   //=== Conflict Stats ===
   int      htf_conflict_count;
   //=== Hour Distribution ===
   int      hour_dist[24];
   int      hour_asian;    //0-7
   int      hour_london;   //8-15
   int      hour_newyork;  //16-23
   //=== Win/Loss ===
   int      win_count;
   int      loss_count;
   double   total_profit;
   //=== TP Stats ===
   int      hit_tp1_count;
   int      hit_tp2_count;
   int      hit_ema200_count;
   void Reset()
   {
   count = 0;
   group_type = GROUP_SAFE;
   for(int i = 0; i < TF_COUNT; i++)
   {
      avg_rsi[i] = 0;
      avg_adx[i] = 0;
      avg_cci[i] = 0;
      avg_atr[i] = 0;
      avg_ema200_dist[i] = 0;
      avg_di_gap[i] = 0;
      di_plus_count[i]  = 0;
      di_minus_count[i] = 0;
   }
   avg_pivot1_dist   = 0;
   avg_pivot2_dist   = 0;
   avg_stability     = 0;
   avg_profit        = 0;
   avg_di_agreement  = 0;
   avg_ema_bullish   = 0;
   htf_conflict_count = 0;
   win_count          = 0;
   loss_count         = 0;
   total_profit       = 0;
   hit_tp1_count      = 0;
   hit_tp2_count      = 0;
   hit_ema200_count   = 0;
   for(int i = 0; i < 24; i++)
      hour_dist[i] = 0;
   hour_asian  = 0;
   hour_london = 0;
   hour_newyork= 0;
   }
   void AddTrade(SEntrySnapshot &snap)
   {
      count++;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         avg_rsi[tf] += snap.rsi[tf];
         avg_adx[tf] += snap.adx[tf];
         avg_cci[tf] += snap.cci[tf];
         avg_atr[tf] += snap.atr[tf];
         avg_ema200_dist[tf] += snap.ema200_dist[tf];
         avg_di_gap[tf] += snap.di_gap[tf];
         // FIX: فقط اگر DI معتبر بود بشمار
         if(snap.di[tf] == "+") di_plus_count[tf]++;
         else if(snap.di[tf] == "-") di_minus_count[tf]++;
      }
      avg_pivot1_dist += snap.pivot1_dist;
      avg_pivot2_dist += snap.pivot2_dist;
      avg_stability += snap.stability_score;
      avg_profit += snap.final_profit;
      avg_di_agreement += snap.di_agreement_count;
      avg_ema_bullish += snap.ema_bullish_count;
      if(snap.has_htf_conflict) htf_conflict_count++;
      if(snap.final_profit > 0) win_count++; else loss_count++;
      total_profit += snap.final_profit;
      if(snap.hit_tp1) hit_tp1_count++;
      if(snap.hit_tp2) hit_tp2_count++;
      if(snap.hit_ema200) hit_ema200_count++;
      if(snap.entry_hour >= 0 && snap.entry_hour < 24)
      {
         hour_dist[snap.entry_hour]++;
         if(snap.entry_hour >= 0 && snap.entry_hour < 8) hour_asian++;
         else if(snap.entry_hour >= 8 && snap.entry_hour < 16) hour_london++;
         else hour_newyork++;
      }
   }
   void Finalize()
   {
      if(count == 0) return;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         avg_rsi[tf] /= count;
         avg_adx[tf] /= count;
         avg_cci[tf] /= count;
         avg_atr[tf] /= count;
         avg_ema200_dist[tf] /= count;
         avg_di_gap[tf] /= count;
      }
      avg_pivot1_dist /= count;
      avg_pivot2_dist /= count;
      avg_stability /= count;
      avg_profit /= count;
      avg_di_agreement /= count;
      avg_ema_bullish /= count;
   }
   double GetWinRate() { return (count > 0) ? (win_count * 100.0 / count) : 0; }
   double GetDIPlusPct(int tf) { return (count > 0) ? (di_plus_count[tf] * 100.0 / count) : 0; }
   double GetHTFConflictPct() { return (count > 0) ? (htf_conflict_count * 100.0 / count) : 0; }
   double GetTP1HitPct() { return (count > 0) ? (hit_tp1_count * 100.0 / count) : 0; }
   double GetTP2HitPct() { return (count > 0) ? (hit_tp2_count * 100.0 / count) : 0; }
   double GetEMA200HitPct() { return (count > 0) ? (hit_ema200_count * 100.0 / count) : 0; }
};
//|INCREMENTAL MODEL FUNCTIONS|
// Sigmoid
double RL_Sigmoid(double x)
{
   if(x >  20.0) return 1.0;
   if(x < -20.0) return 0.0;
   return 1.0 / (1.0 + MathExp(-x));
}
// Normalize feature values به [0,1] بر اساس train set
void RL_Normalize(double &vals[], int n,
                  double &mean_out, double &std_out)
{
   mean_out = 0.0; std_out = 1.0;
   if(n <= 0) return;
   double sum = 0.0;
   for(int i = 0; i < n; i++) sum += vals[i];
   mean_out = sum / n;
   double var = 0.0;
   for(int i = 0; i < n; i++)
      var += (vals[i] - mean_out) * (vals[i] - mean_out);
   std_out = MathSqrt(var / MathMax(1, n - 1));
   if(std_out < 1e-10) std_out = 1.0;
   for(int i = 0; i < n; i++)
      vals[i] = (vals[i] - mean_out) / std_out;
}
// Logistic Regression با SGD — n_features = 1, 2 یا 3
// X: n x n_feat matrix به صورت آرایه‌های جداگانه
// برمی‌گرداند weights
void RL_FitLogistic(
   double &X1[], double &X2[], double &X3[],
   int &Y[], int n, int n_feat,
   double &w0, double &w1, double &w2, double &w3,
   int epochs = 300, double lr = 0.05)
{
   w0 = 0.0; w1 = 0.0; w2 = 0.0; w3 = 0.0;
   if(n < 10) return;
   // محاسبه class weight برای جبران imbalance
   int n_pos = 0, n_neg = 0;
   for(int i = 0; i < n; i++)
   {
      if(Y[i] == 1) n_pos++;
      else          n_neg++;
   }
   if(n_pos == 0 || n_neg == 0) return;
   // weight inverse of frequency — cap at 20x to avoid instability
   double w_pos = MathMin(20.0, (double)n / (2.0 * n_pos));
   double w_neg = MathMin(20.0, (double)n / (2.0 * n_neg));
   double lambda = 0.01; // L2 regularization
   for(int ep = 0; ep < epochs; ep++)
   {
      double g0 = 0.0, g1 = 0.0, g2 = 0.0, g3 = 0.0;
      for(int i = 0; i < n; i++)
      {
         double z = w0;
         if(n_feat >= 1) z += w1 * X1[i];
         if(n_feat >= 2) z += w2 * X2[i];
         if(n_feat >= 3) z += w3 * X3[i];
         double pred = RL_Sigmoid(z);
         double err  = pred - Y[i];
         // اعمال class weight
         double cw = (Y[i] == 1) ? w_pos : w_neg;
         err *= cw;
         g0 += err;
         if(n_feat >= 1) g1 += err * X1[i];
         if(n_feat >= 2) g2 += err * X2[i];
         if(n_feat >= 3) g3 += err * X3[i];
      }
      double inv_n = lr / n;
      w0 -= inv_n * g0;
      if(n_feat >= 1) w1 -= inv_n * (g1 + lambda * w1);
      if(n_feat >= 2) w2 -= inv_n * (g2 + lambda * w2);
      if(n_feat >= 3) w3 -= inv_n * (g3 + lambda * w3);
      // Learning rate decay
      if(ep % 100 == 99) lr *= 0.5;
   }
}
// محاسبه AUC از predictions
double RL_AUCFromPreds(double &preds[], int &targets[], int n)
{
   if(n < 5) return 0.5;
   int n_pos = 0, n_neg = 0;
   for(int i = 0; i < n; i++)
   {
      if(targets[i] == 1) n_pos++;
      else                n_neg++;
   }
   if(n_pos == 0 || n_neg == 0) return 0.5;
   // Tie-aware AUC: Mann-Whitney U with average ranks for equal predictions.
   // (The old trapezoid walk assigned an arbitrary order inside ties, which
   // biased AUC whenever predictions were discrete — e.g. binary features.)
   int idx[];
   ArrayResize(idx, n);
   RL_ArgSort(preds, idx, n);
   double rank_sum = 0.0;
   int i = 0;
   while(i < n)
   {
      int j = i;
      while(j < n - 1 && preds[idx[j]] == preds[idx[j + 1]]) j++;
      double avg_rank = (i + 1 + j + 1) / 2.0;
      for(int k = i; k <= j; k++)
      {
         if(targets[idx[k]] == 1)
            rank_sum += avg_rank;
      }
      i = j + 1;
   }
   double u = rank_sum - (double)n_pos * (n_pos + 1) / 2.0;
   double auc = u / ((double)n_pos * n_neg);
   ArrayFree(idx);
   return auc;
}
// Brier Score
double RL_BrierScore(double &preds[], int &targets[], int n)
{
   if(n <= 0) return 0.25;
   double brier = 0.0;
   for(int i = 0; i < n; i++)
      brier += (preds[i] - targets[i]) * (preds[i] - targets[i]);
   return brier / n;
}
void RL_BootstrapAUC_CI(double &preds[], int &targets[], int n,
                         double &ci_lower, double &ci_upper,
                         int n_bootstrap = 200)
{
   ci_lower = 0.5;
   ci_upper = 0.5;
   if(n < 20) return;
   // REPRODUCIBLE SEED — changes only when dataset size changes.
   // Uses LOCAL LCG generator — does NOT affect global MathRand() state.
   uint seed = 42u + (uint)g_snapshot_count * 7u + (uint)g_risklab_count * 13u;
   LCG_Seed(seed);
   double boot_aucs[];
   ArrayResize(boot_aucs, n_bootstrap);
   double boot_preds[];
   int    boot_tgts[];
   ArrayResize(boot_preds, n);
   ArrayResize(boot_tgts,  n);
   for(int b = 0; b < n_bootstrap; b++)
   {
      for(int i = 0; i < n; i++)
      {
         int idx       = LCG_RandInt(n);   // local LCG — no global state change
         boot_preds[i] = preds[idx];
         boot_tgts[i]  = targets[idx];
      }
      boot_aucs[b] = RL_AUCFromPreds(boot_preds, boot_tgts, n);
   }
   ArraySort(boot_aucs);
   int lo_idx = (int)MathFloor(n_bootstrap * 0.025);
   int hi_idx = (int)MathFloor(n_bootstrap * 0.975);
   if(lo_idx < 0)            lo_idx = 0;
   if(hi_idx >= n_bootstrap) hi_idx = n_bootstrap - 1;
   ci_lower = boot_aucs[lo_idx];
   ci_upper = boot_aucs[hi_idx];
   ArrayFree(boot_preds);
   ArrayFree(boot_tgts);
   ArrayFree(boot_aucs);
}
// Calibration analysis — 10 bins
void RL_Calibration(double &preds[], int &targets[], int n,
                    double &bin_pred[], double &bin_actual[],
                    int &bin_count[], double &ece)
{
   for(int i = 0; i < 10; i++)
   {
      bin_pred[i]   = 0.0;
      bin_actual[i] = 0.0;
      bin_count[i]  = 0;
   }
   ece = 0.0;
   if(n <= 0) return;
   for(int i = 0; i < n; i++)
   {
      int bin = (int)MathFloor(preds[i] * 10.0);
      if(bin > 9) bin = 9;
      if(bin < 0) bin = 0;
      bin_pred[bin]   += preds[i];
      bin_actual[bin] += targets[i];
      bin_count[bin]++;
   }
   for(int b = 0; b < 10; b++)
   {
      if(bin_count[b] > 0)
      {
         bin_pred[b]   /= bin_count[b];
         bin_actual[b] /= bin_count[b];
         ece += (double)bin_count[b] / n * MathAbs(bin_pred[b] - bin_actual[b]);
      }
   }
}
// Cost-based threshold — F-beta score
// beta=2 یعنی recall دو برابر precision اهمیت دارد
// برای rare events (Stop ~5%) معمولاً beta>1 بهتر است
void RL_FindBestThreshold(double &preds[], int &targets[], int n,
                          double &best_thr, double &best_prec,
                          double &best_rec, double &best_f,
                          double beta = 2.0)
{
   best_thr = 0.5;
   best_prec = best_rec = best_f = 0.0;
   if(n < 10) return;
   // 20 threshold امتحان کن
   for(int t = 1; t <= 20; t++)
   {
      double thr = t / 21.0;
      int tp = 0, fp = 0, fn = 0, tn = 0;
      for(int i = 0; i < n; i++)
      {
         bool pred_pos = (preds[i] >= thr);
         bool act_pos  = (targets[i] == 1);
         if(pred_pos && act_pos)  tp++;
         if(pred_pos && !act_pos) fp++;
         if(!pred_pos && act_pos) fn++;
         if(!pred_pos && !act_pos) tn++;
      }
      double prec = (tp + fp > 0) ? (double)tp / (tp + fp) : 0.0;
      double rec  = (tp + fn > 0) ? (double)tp / (tp + fn) : 0.0;
      double beta2 = beta * beta;
      double f = ((1.0 + beta2) * prec * rec > 0)
         ? ((1.0 + beta2) * prec * rec / (beta2 * prec + rec))
         : 0.0;
      if(f > best_f)
      {
         best_f    = f;
         best_thr  = thr;
         best_prec = prec;
         best_rec  = rec;
      }
   }
}
// گرفتن مقادیر Feature از RiskLab records
bool RL_GetFeatureValues(string feat_name, string tf_name,
                         int &filtered_idx[], int nf,
                         double &out_vals[])
{
   ArrayResize(out_vals, nf);
   int tf_idx = -1;
   if(tf_name != "")
   {
      for(int t = 0; t < TF_COUNT; t++)
         if(g_tf[t].name == tf_name) { tf_idx = t; break; }
      if(tf_idx < 0) return false;
   }
   for(int i = 0; i < nf; i++)
   {
      int ri = filtered_idx[i];
      double v = 0.0;
      if(tf_idx >= 0)
      {
         // Per-TF features
         if(feat_name == "RSI")             v = g_risklab_records[ri].rsi[tf_idx];
         else if(feat_name == "ADX")        v = g_risklab_records[ri].adx[tf_idx];
         else if(feat_name == "CCI")        v = g_risklab_records[ri].cci[tf_idx];
         else if(feat_name == "ATR")        v = g_risklab_records[ri].atr[tf_idx];
         else if(feat_name == "ATR_Regime") v = g_risklab_records[ri].atr_regime[tf_idx];
         else if(feat_name == "ADX_Slope")  v = g_risklab_records[ri].adx_slope[tf_idx];
         else if(feat_name == "EMA_Compression") v = g_risklab_records[ri].ema_compression[tf_idx];
         else if(feat_name == "EMA200_Dist") v = g_risklab_records[ri].ema200_dist[tf_idx];
         else if(feat_name == "DI_Gap")     v = g_risklab_records[ri].di_gap[tf_idx];
         else return false;
      }
      else
      {
         // Global features
         if(feat_name == "Stability")       v = g_risklab_records[ri].stability;
         else if(feat_name == "DI_Agreement") v = g_risklab_records[ri].di_agreement_count;
         else if(feat_name == "EMA_Bullish") v = g_risklab_records[ri].ema_bullish_count;
         else if(feat_name == "Pivot1Dist")  v = g_risklab_records[ri].pivot1_dist;
         else if(feat_name == "PivotSpan")   v = g_risklab_records[ri].pivot2_dist;
         else if(feat_name == "PivotGapMin") v = g_risklab_records[ri].pivot_gap_min;
         else if(feat_name == "PivotGapMax") v = g_risklab_records[ri].pivot_gap_max;
         else if(feat_name == "OB_DistPct")  v = (g_risklab_records[ri].ob_dist_pct >= 0 ? g_risklab_records[ri].ob_dist_pct : 0.0);
         else if(feat_name == "OB_AgeBars")  v = (g_risklab_records[ri].ob_age_bars >= 0 ? g_risklab_records[ri].ob_age_bars : 0.0);
         else if(feat_name == "OB_Width_ATR") v = g_risklab_records[ri].ob_width_atr;
         else if(feat_name == "Signal_CLV")  v = g_risklab_records[ri].signal_clv;
         else if(feat_name == "Signal_BodyRatio") v = g_risklab_records[ri].signal_body_ratio;
         else if(feat_name == "TotalScore")  v = g_risklab_records[ri].total_score;
         else return false;
      }
      out_vals[i] = v;
   }
   return true;
}
// اجرای یک مدل با n_features
SRLLinearModel RL_RunModel(
   string side, ENUM_RL_TARGET target,
   string feat1, string tf1,
   string feat2, string tf2,
   string feat3, string tf3,
   int n_feat)
{
   SRLLinearModel mdl;
   mdl.Reset();
   mdl.side       = side;
   mdl.target     = RL_TargetName(target);
   mdl.n_features = n_feat;
   mdl.feature_names[0] = feat1; mdl.tf_names[0] = tf1;
   mdl.feature_names[1] = feat2; mdl.tf_names[1] = tf2;
   mdl.feature_names[2] = feat3; mdl.tf_names[2] = tf3;
   string key = feat1 + (tf1 != "" ? "_" + tf1 : "");
   if(n_feat >= 2) key += "+" + feat2 + (tf2 != "" ? "_" + tf2 : "");
   if(n_feat >= 3) key += "+" + feat3 + (tf3 != "" ? "_" + tf3 : "");
   mdl.model_name = side + "|" + RL_TargetName(target) + "|" + key;
   int dev_idx[], oos_idx[];
   ArrayResize(dev_idx, g_risklab_count);
   ArrayResize(oos_idx, g_risklab_count);
   int nd = 0, no = 0;
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].signal != side) continue;
      if(!g_risklab_records[i].is_oos)
         dev_idx[nd++] = i;
      else
         oos_idx[no++] = i;
   }
   mdl.n_dev = nd;
   mdl.n_oos = no;
   // بررسی حداقل تعداد نمونه‌های مثبت
   int pos_dev_check = 0;
   for(int i = 0; i < nd; i++)
   {
      int tv = 0;
      RL_GetTargetValue(g_risklab_records[dev_idx[i]], target, tv);
      if(tv == 1) pos_dev_check++;
   }
   if(nd < 30 || no < 10 || pos_dev_check < 8)
   {
      ArrayFree(dev_idx);
      ArrayFree(oos_idx);
      return mdl;
   }
   double X1_dev[], X2_dev[], X3_dev[];
   int Y_dev[];
   ArrayResize(Y_dev, nd);
   int tv = 0;
   // Feature 1
   if(!RL_GetFeatureValues(feat1, tf1, dev_idx, nd, X1_dev))
   {
      ArrayFree(dev_idx);
      ArrayFree(oos_idx);
      return mdl;
   }
   // Feature 2
   if(n_feat >= 2)
   {
      if(!RL_GetFeatureValues(feat2, tf2, dev_idx, nd, X2_dev))
      {
         ArrayFree(dev_idx);
         ArrayFree(oos_idx);
         return mdl;
      }
   }
   else
   {
      ArrayResize(X2_dev, nd);
      ArrayInitialize(X2_dev, 0);
   }
   // Feature 3
   if(n_feat >= 3)
   {
      if(!RL_GetFeatureValues(feat3, tf3, dev_idx, nd, X3_dev))
      {
         ArrayFree(dev_idx);
         ArrayFree(oos_idx);
         return mdl;
      }
   }
   else
   {
      ArrayResize(X3_dev, nd);
      ArrayInitialize(X3_dev, 0);
   }
   for(int i = 0; i < nd; i++)
   {
      RL_GetTargetValue(g_risklab_records[dev_idx[i]], target, tv);
      Y_dev[i] = tv;
      if(tv == 1) mdl.n_pos_dev++;
   }
   RL_Normalize(X1_dev, nd, mdl.feat_mean[0], mdl.feat_std[0]);
   if(n_feat >= 2) RL_Normalize(X2_dev, nd, mdl.feat_mean[1], mdl.feat_std[1]);
   if(n_feat >= 3) RL_Normalize(X3_dev, nd, mdl.feat_mean[2], mdl.feat_std[2]);
   RL_FitLogistic(X1_dev, X2_dev, X3_dev, Y_dev, nd, n_feat,
                  mdl.w0, mdl.w1, mdl.w2, mdl.w3);
   double preds_dev[];
   ArrayResize(preds_dev, nd);
   double p_min = 1.0, p_max = 0.0;
   for(int i = 0; i < nd; i++)
   {
      double z = mdl.w0 + mdl.w1 * X1_dev[i] + mdl.w2 * X2_dev[i] + mdl.w3 * X3_dev[i];
      preds_dev[i] = RL_Sigmoid(z);
      if(preds_dev[i] < p_min) p_min = preds_dev[i];
      if(preds_dev[i] > p_max) p_max = preds_dev[i];
   }
   // اگر مدل قدرت تفکیک ندارد، نادیده بگیر
   if((p_max - p_min) < 0.02)
   {
      ArrayFree(dev_idx);
      ArrayFree(oos_idx);
      mdl.n_dev = 0;
      return mdl;
   }
   mdl.dev_auc   = RL_AUCFromPreds(preds_dev, Y_dev, nd);
   mdl.dev_brier = RL_BrierScore(preds_dev, Y_dev, nd);
   RL_BootstrapAUC_CI(preds_dev, Y_dev, nd, mdl.dev_auc_ci_lower, mdl.dev_auc_ci_upper, 200);
   double tmp_calib_pred[10], tmp_calib_actual[10];
   int    tmp_calib_cnt[10];
   RL_Calibration(preds_dev, Y_dev, nd,
                  tmp_calib_pred, tmp_calib_actual, tmp_calib_cnt,
                  mdl.calib_ece);
   for(int b = 0; b < 10; b++)
   {
      mdl.calib_bin_pred[b]   = tmp_calib_pred[b];
      mdl.calib_bin_actual[b] = tmp_calib_actual[b];
      mdl.calib_bin_count[b]  = tmp_calib_cnt[b];
   }
   RL_FindBestThreshold(preds_dev, Y_dev, nd,
                        mdl.best_threshold,
                        mdl.threshold_precision,
                        mdl.threshold_recall,
                        mdl.threshold_f1,
                        2.0);
   // ===== OOS =====
   double X1_oos[], X2_oos[], X3_oos[];
   int Y_oos[];
   ArrayResize(Y_oos, no);
   if(!RL_GetFeatureValues(feat1, tf1, oos_idx, no, X1_oos))
   {
      ArrayFree(dev_idx);
      ArrayFree(oos_idx);
      return mdl;
   }
   if(n_feat >= 2)
   {
      RL_GetFeatureValues(feat2, tf2, oos_idx, no, X2_oos);
   }
   else
   {
      ArrayResize(X2_oos, no);
      ArrayInitialize(X2_oos, 0);
   }
   if(n_feat >= 3)
   {
      RL_GetFeatureValues(feat3, tf3, oos_idx, no, X3_oos);
   }
   else
   {
      ArrayResize(X3_oos, no);
      ArrayInitialize(X3_oos, 0);
   }
   for(int i = 0; i < no; i++)
   {
      RL_GetTargetValue(g_risklab_records[oos_idx[i]], target, tv);
      Y_oos[i] = tv;
      if(tv == 1) mdl.n_pos_oos++;
      X1_oos[i] = (X1_oos[i] - mdl.feat_mean[0]) / mdl.feat_std[0];
      if(n_feat >= 2) X2_oos[i] = (X2_oos[i] - mdl.feat_mean[1]) / mdl.feat_std[1];
      if(n_feat >= 3) X3_oos[i] = (X3_oos[i] - mdl.feat_mean[2]) / mdl.feat_std[2];
   }
   double preds_oos[];
   ArrayResize(preds_oos, no);
   for(int i = 0; i < no; i++)
   {
      double z = mdl.w0 + mdl.w1 * X1_oos[i] + mdl.w2 * X2_oos[i] + mdl.w3 * X3_oos[i];
      preds_oos[i] = RL_Sigmoid(z);
   }
   mdl.oos_auc   = RL_AUCFromPreds(preds_oos, Y_oos, no);
   mdl.oos_brier = RL_BrierScore(preds_oos, Y_oos, no);
   RL_BootstrapAUC_CI(preds_oos, Y_oos, no, mdl.oos_auc_ci_lower, mdl.oos_auc_ci_upper, 200);
   ArrayFree(dev_idx);
   ArrayFree(oos_idx);
   return mdl;
}
// اجرای کامل Incremental Analysis
void RL_RunIncrementalAnalysis()
{
   if(g_risklab_count < 50 || g_rl_feature_stat_count == 0)
   {
      Print("RL_RunIncrementalAnalysis: Not enough data.");
      return;
   }
   ArrayResize(g_rl_models, RL_MAX_MODELS);
   g_rl_model_count = 0;
   Print("Running Incremental Model Analysis (dynamic baselines)...");
   string buy_stop_f[8] = {
      "ATR",
      "ATR",
      "ATR",
      "ATR",
      "EMA200_Dist",
      "ATR_Regime",
      "OB_DistPct",
      "DI_Gap"
   };
   string buy_stop_t[8] = {
      g_tf[TF_IDX_M30].name,
      g_tf[TF_IDX_M15].name,
      g_tf[TF_IDX_M5].name,
      g_tf[TF_IDX_MAIN].name,
      g_tf[TF_IDX_MAIN].name,
      g_tf[TF_IDX_M5].name,
      "",
      g_tf[TF_IDX_MAIN].name
   };
   int n_buy_stop = 8;
   string sell_stop_f[8] = {
      "ATR",
      "ATR",
      "ATR",
      "ATR_Regime",
      "ATR_Regime",
      "EMA200_Dist",
      "DI_Gap",
      "OB_DistPct"
   };
   string sell_stop_t[8] = {
      g_tf[TF_IDX_MAIN].name,
      g_tf[TF_IDX_M5].name,
      g_tf[TF_IDX_M30].name,
      g_tf[TF_IDX_M5].name,
      g_tf[TF_IDX_MAIN].name,
      g_tf[TF_IDX_MAIN].name,
      g_tf[TF_IDX_MAIN].name,
      ""
   };
   int n_sell_stop = 8;
   string buy_s4_f[6] = {
      "PivotGapMin",
      "PivotSpan",
      "ATR_Regime",
      "DI_Gap",
      "EMA200_Dist",
      "TotalScore"
   };
   string buy_s4_t[6] = {
      "",
      "",
      g_tf[TF_IDX_M5].name,
      g_tf[TF_IDX_M5].name,
      g_tf[TF_IDX_H4].name,
      ""
   };
   int n_buy_s4 = 6;
   string sell_s4_f[6] = {
      "ATR_Regime",
      "DI_Agreement",
      "DI_Gap",
      "PivotGapMin",
      "CCI",
      "TotalScore"
   };
   string sell_s4_t[6] = {
      g_tf[TF_IDX_M5].name,
      "",
      g_tf[TF_IDX_H1].name,
      "",
      g_tf[TF_IDX_M30].name,
      ""
   };
   int n_sell_s4 = 6;
   // ===== Single feature models =====
   for(int i = 0; i < n_buy_stop && g_rl_model_count < RL_MAX_MODELS - 1; i++)
   {
      SRLLinearModel m = RL_RunModel("BUY", RL_TARGET_STOP,
         buy_stop_f[i], buy_stop_t[i], "", "", "", "", 1);
      m.incremental_auc_dev = m.dev_auc - 0.5;
      m.incremental_auc_oos = m.oos_auc - 0.5;
      if(m.n_dev > 0) g_rl_models[g_rl_model_count++] = m;
   }
   for(int i = 0; i < n_sell_stop && g_rl_model_count < RL_MAX_MODELS - 1; i++)
   {
      SRLLinearModel m = RL_RunModel("SELL", RL_TARGET_STOP,
         sell_stop_f[i], sell_stop_t[i], "", "", "", "", 1);
      m.incremental_auc_dev = m.dev_auc - 0.5;
      m.incremental_auc_oos = m.oos_auc - 0.5;
      if(m.n_dev > 0) g_rl_models[g_rl_model_count++] = m;
   }
   for(int i = 0; i < n_buy_s4 && g_rl_model_count < RL_MAX_MODELS - 1; i++)
   {
      SRLLinearModel m = RL_RunModel("BUY", RL_TARGET_STEP4,
         buy_s4_f[i], buy_s4_t[i], "", "", "", "", 1);
      m.incremental_auc_dev = m.dev_auc - 0.5;
      m.incremental_auc_oos = m.oos_auc - 0.5;
      if(m.n_dev > 0) g_rl_models[g_rl_model_count++] = m;
   }
   for(int i = 0; i < n_sell_s4 && g_rl_model_count < RL_MAX_MODELS - 1; i++)
   {
      SRLLinearModel m = RL_RunModel("SELL", RL_TARGET_STEP4,
         sell_s4_f[i], sell_s4_t[i], "", "", "", "", 1);
      m.incremental_auc_dev = m.dev_auc - 0.5;
      m.incremental_auc_oos = m.oos_auc - 0.5;
      if(m.n_dev > 0) g_rl_models[g_rl_model_count++] = m;
   }
   // ===== 2-feature combinations: use dynamic OOS baselines =====
   {
      int base = 0; // ATR_M30
      bool found_base = false;
      double base_buy_oos = RL_GetReferencedOOSAUC("BUY", "StopFlag",
                                                   buy_stop_f[base], buy_stop_t[base],
                                                   found_base);
      if(!found_base) base_buy_oos = 0.5;
      for(int j = 1; j < n_buy_stop && g_rl_model_count < RL_MAX_MODELS - 1; j++)
      {
         if(buy_stop_f[j] == buy_stop_f[base] &&
            buy_stop_t[j] == buy_stop_t[base]) continue;
         SRLLinearModel m2 = RL_RunModel("BUY", RL_TARGET_STOP,
            buy_stop_f[base], buy_stop_t[base],
            buy_stop_f[j], buy_stop_t[j],
            "", "", 2);
         m2.incremental_auc_dev = 0.0;
         m2.incremental_auc_oos = m2.oos_auc - base_buy_oos;
         if(m2.n_dev > 0) g_rl_models[g_rl_model_count++] = m2;
      }
      base = 3; // ATR_M1
      found_base = false;
      double base_buy_m1_oos = RL_GetReferencedOOSAUC("BUY", "StopFlag",
                                                      buy_stop_f[base], buy_stop_t[base],
                                                      found_base);
      if(!found_base) base_buy_m1_oos = 0.5;
      for(int j = 0; j < n_buy_stop && g_rl_model_count < RL_MAX_MODELS - 1; j++)
      {
         if(j == base) continue;
         SRLLinearModel m2 = RL_RunModel("BUY", RL_TARGET_STOP,
            buy_stop_f[base], buy_stop_t[base],
            buy_stop_f[j], buy_stop_t[j],
            "", "", 2);
         m2.incremental_auc_dev = 0.0;
         m2.incremental_auc_oos = m2.oos_auc - base_buy_m1_oos;
         if(m2.n_dev > 0) g_rl_models[g_rl_model_count++] = m2;
      }
   }
   {
      int base = 0; // ATR_M1
      bool found_base = false;
      double base_sell_oos = RL_GetReferencedOOSAUC("SELL", "StopFlag",
                                                    sell_stop_f[base], sell_stop_t[base],
                                                    found_base);
      if(!found_base) base_sell_oos = 0.5;
      for(int j = 1; j < n_sell_stop && g_rl_model_count < RL_MAX_MODELS - 1; j++)
      {
         if(sell_stop_f[j] == sell_stop_f[base] &&
            sell_stop_t[j] == sell_stop_t[base]) continue;
         SRLLinearModel m2 = RL_RunModel("SELL", RL_TARGET_STOP,
            sell_stop_f[base], sell_stop_t[base],
            sell_stop_f[j], sell_stop_t[j],
            "", "", 2);
         m2.incremental_auc_dev = 0.0;
         m2.incremental_auc_oos = m2.oos_auc - base_sell_oos;
         if(m2.n_dev > 0) g_rl_models[g_rl_model_count++] = m2;
      }
      base = 2; // ATR_M30
      found_base = false;
      double base_sell_m30_oos = RL_GetReferencedOOSAUC("SELL", "StopFlag",
                                                        sell_stop_f[base], sell_stop_t[base],
                                                        found_base);
      if(!found_base) base_sell_m30_oos = 0.5;
      for(int j = 0; j < n_sell_stop && g_rl_model_count < RL_MAX_MODELS - 1; j++)
      {
         if(j == base) continue;
         SRLLinearModel m2 = RL_RunModel("SELL", RL_TARGET_STOP,
            sell_stop_f[base], sell_stop_t[base],
            sell_stop_f[j], sell_stop_t[j],
            "", "", 2);
         m2.incremental_auc_dev = 0.0;
         m2.incremental_auc_oos = m2.oos_auc - base_sell_m30_oos;
         if(m2.n_dev > 0) g_rl_models[g_rl_model_count++] = m2;
      }
   }
   // ===== 3-feature combinations =====
   {
      for(int k = 0; k < n_buy_stop && g_rl_model_count < RL_MAX_MODELS - 1; k++)
      {
         if(buy_stop_f[k] == "ATR" &&
            (buy_stop_t[k] == g_tf[TF_IDX_M30].name ||
             buy_stop_t[k] == g_tf[TF_IDX_MAIN].name)) continue;
         if(buy_stop_f[k] == "EMA200_Dist") continue;
         SRLLinearModel m3 = RL_RunModel("BUY", RL_TARGET_STOP,
            "ATR", g_tf[TF_IDX_M30].name,
            "EMA200_Dist", g_tf[TF_IDX_MAIN].name,
            buy_stop_f[k], buy_stop_t[k], 3);
         m3.incremental_auc_dev = 0.0;
         m3.incremental_auc_oos = 0.0;
         if(m3.n_dev > 0) g_rl_models[g_rl_model_count++] = m3;
      }
      for(int k = 0; k < n_sell_stop && g_rl_model_count < RL_MAX_MODELS - 1; k++)
      {
         if(sell_stop_f[k] == "ATR" &&
            sell_stop_t[k] == g_tf[TF_IDX_MAIN].name) continue;
         if(sell_stop_f[k] == "ATR_Regime" &&
            sell_stop_t[k] == g_tf[TF_IDX_M5].name) continue;
         SRLLinearModel m3 = RL_RunModel("SELL", RL_TARGET_STOP,
            "ATR", g_tf[TF_IDX_MAIN].name,
            "ATR_Regime", g_tf[TF_IDX_M5].name,
            sell_stop_f[k], sell_stop_t[k], 3);
         m3.incremental_auc_dev = 0.0;
         m3.incremental_auc_oos = 0.0;
         if(m3.n_dev > 0) g_rl_models[g_rl_model_count++] = m3;
      }
   }
   Print("Incremental Analysis complete: ", g_rl_model_count, " models.");
}
void RL_ExportIncrementalAnalysis()
{
   if(g_rl_model_count == 0)
   {
      Print("RL_ExportIncrementalAnalysis: No models.");
      return;
   }
   // ===== فایل اصلی =====
   string fn = "RiskLab_IncrementalModels_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot create"); return; }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ|FILE_WRITE|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot reopen"); return; }
   FileSeek(h, 0, SEEK_END);
   string hdr = "ModelName,Side,Target,N_Features,";
   hdr += "Feat1,TF1,Feat2,TF2,Feat3,TF3,";
   hdr += "W0,W1,W2,W3,";
   hdr += "Mean1,Std1,Mean2,Std2,Mean3,Std3,";
   hdr += "DEV_N,DEV_Pos,DEV_AUC,DEV_AUC_CI_Lo,DEV_AUC_CI_Hi,DEV_PRAUC,DEV_Brier,";
   hdr += "OOS_N,OOS_Pos,OOS_AUC,OOS_AUC_CI_Lo,OOS_AUC_CI_Hi,OOS_PRAUC,OOS_Brier,";
   hdr += "Incremental_AUC_DEV,Incremental_AUC_OOS,";
   hdr += "AUC_Gap(DEV-OOS),";
   hdr += "Calib_ECE,Best_Threshold,Thr_Precision,Thr_Recall,Thr_F2,";
   hdr += "OOS_Verdict";
   FileWriteString(h, hdr + "\r\n");
   for(int i = 0; i < g_rl_model_count; i++)
   {
      SRLLinearModel m = g_rl_models[i];
      if(m.n_dev == 0) continue;
      // Verdict
      string verdict = "";
      double oos_inc = m.incremental_auc_oos;
      double gap = m.dev_auc - m.oos_auc;
      if(m.n_features == 1)
      {
         // برای StopFlag: threshold بالاتر چون AUC‌های واقعی بالاتر هستند
         bool is_stop = (m.target == "StopFlag");
         double strong_th  = is_stop ? 0.70 : 0.60;
         double moderate_th= is_stop ? 0.62 : 0.55;
         double weak_th    = is_stop ? 0.55 : 0.52;
         if(m.oos_auc >= strong_th   && gap <= 0.08)  verdict = "STRONG";
         else if(m.oos_auc >= moderate_th && gap <= 0.10) verdict = "MODERATE";
         else if(m.oos_auc >= weak_th)                verdict = "WEAK";
         else                                          verdict = "NOISE";
         // اگر OOS از DEV بهتر بود — خیلی خوب
         if(m.oos_auc > m.dev_auc + 0.05 && m.oos_auc >= moderate_th)
            verdict = "STRONG_IMPROVING";
      }
      else
      {
         if(oos_inc >= 0.05 && gap <= 0.05)            verdict = "VALUE_ADD_STRONG";
         else if(oos_inc >= 0.02 && gap <= 0.08)       verdict = "VALUE_ADD";
         else if(oos_inc >= 0.005 && gap <= 0.10)      verdict = "MARGINAL";
         else if(oos_inc < -0.02)                       verdict = "OVERFIT";
         else                                           verdict = "NEGLIGIBLE";
      }
      string row = "";
      row += EscapeCSV(m.model_name) + ",";
      row += m.side + ",";
      row += m.target + ",";
      row += IntegerToString(m.n_features) + ",";
      for(int f = 0; f < 3; f++)
      {
         row += EscapeCSV(m.feature_names[f]) + ",";
         row += EscapeCSV(m.tf_names[f]) + ",";
      }
      row += DoubleToString(m.w0, 4) + ",";
      row += DoubleToString(m.w1, 4) + ",";
      row += DoubleToString(m.w2, 4) + ",";
      row += DoubleToString(m.w3, 4) + ",";
      for(int f = 0; f < 3; f++)
      {
         row += DoubleToString(m.feat_mean[f], 6) + ",";
         row += DoubleToString(m.feat_std[f],  6) + ",";
      }
      row += IntegerToString(m.n_dev)          + ",";
      row += IntegerToString(m.n_pos_dev)       + ",";
      row += DoubleToString(m.dev_auc,        4) + ",";
      row += DoubleToString(m.dev_auc_ci_lower,4) + ",";
      row += DoubleToString(m.dev_auc_ci_upper,4) + ",";
      row += DoubleToString(m.dev_pr_auc,     4) + ",";
      row += DoubleToString(m.dev_brier,      4) + ",";
      row += IntegerToString(m.n_oos)          + ",";
      row += IntegerToString(m.n_pos_oos)       + ",";
      row += DoubleToString(m.oos_auc,        4) + ",";
      row += DoubleToString(m.oos_auc_ci_lower,4) + ",";
      row += DoubleToString(m.oos_auc_ci_upper,4) + ",";
      row += DoubleToString(m.oos_pr_auc,     4) + ",";
      row += DoubleToString(m.oos_brier,      4) + ",";
      row += DoubleToString(m.incremental_auc_dev, 4) + ",";
      row += DoubleToString(m.incremental_auc_oos, 4) + ",";
      row += DoubleToString(gap, 4) + ",";
      row += DoubleToString(m.calib_ece,          4) + ",";
      row += DoubleToString(m.best_threshold,      3) + ",";
      row += DoubleToString(m.threshold_precision, 3) + ",";
      row += DoubleToString(m.threshold_recall,    3) + ",";
      row += DoubleToString(m.threshold_f1,        3) + ",";
      row += verdict;
      FileWriteString(h, row + "\r\n");
   }
   FileFlush(h);
   FileClose(h);
   // ===== فایل Calibration جداگانه =====
   string fn_cal = "RiskLab_Calibration_" + _Symbol + ".csv";
   if(FileIsExist(fn_cal, FILE_COMMON)) FileDelete(fn_cal, FILE_COMMON);
   int hc = FileOpen(fn_cal, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(hc == INVALID_HANDLE) { Print("ERROR: Cannot create Calibration CSV"); return; }
   FileWriteArray(hc, bom, 0, 3);
   FileClose(hc);
   hc = OpenTextUTF8(fn_cal, FILE_READ|FILE_WRITE|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(hc == INVALID_HANDLE) return;
   FileSeek(hc, 0, SEEK_END);
   FileWriteString(hc, "ModelName,Side,Target,Bin,Bin_Pred_Avg,Bin_Actual_Rate,Bin_Count,Gap\r\n");
   for(int i = 0; i < g_rl_model_count; i++)
   {
      SRLLinearModel m = g_rl_models[i];
      if(m.n_dev == 0) continue;
      if(m.calib_ece < 0.0001) continue; // بدون داده
      for(int b = 0; b < 10; b++)
      {
         if(m.calib_bin_count[b] == 0) continue;
         string row = "";
         row += EscapeCSV(m.model_name) + ",";
         row += m.side + ",";
         row += m.target + ",";
         row += IntegerToString(b) + ",";
         row += DoubleToString(m.calib_bin_pred[b],   4) + ",";
         row += DoubleToString(m.calib_bin_actual[b], 4) + ",";
         row += IntegerToString(m.calib_bin_count[b]) + ",";
         row += DoubleToString(m.calib_bin_pred[b] - m.calib_bin_actual[b], 4);
         FileWriteString(hc, row + "\r\n");
      }
   }
   FileFlush(hc);
   FileClose(hc);
   Print("RiskLab_IncrementalModels exported: ", fn,
         " (", g_rl_model_count, " models)");
   Print("RiskLab_Calibration exported: ", fn_cal);
}
//|FEATURE DIFFERENCE|
struct SFeatureDiff
{
   string   feature_name;
   string   tf_name;
   double   safe_value;
   double   risky_value;
   double   difference;
   double   diff_percent;
   string   impact;           //HIGH, MEDIUM, LOW
   double   predictive_power; //0-100
   string   suggested_rule;
   string   rule_action;      //SKIP_ENTRY, CLOSE_TP1, CLOSE_TP2
   void Reset()
   {
      feature_name = tf_name = "";
      safe_value = risky_value = difference = diff_percent = 0;
      impact = "LOW";
      predictive_power = 0;
      suggested_rule = rule_action = "";
   }
   void Calculate(string name, string tf, double safe_val, double risky_val, bool is_buy_context)
   {
      feature_name = name;
      tf_name = tf;
      safe_value = safe_val;
      risky_value = risky_val;
      difference = MathAbs(safe_val - risky_val);
      double avg = (MathAbs(safe_val) + MathAbs(risky_val)) / 2.0;
      diff_percent = (avg > 0.001) ? (difference * 100.0 / avg) : 0;
      //Determine Impact
      if(diff_percent >= 25)
      {
         impact = "HIGH";
         predictive_power = 70 + MathMin(30, (diff_percent - 25) * 1.2);
      }
      else if(diff_percent >= 12)
      {
         impact = "MEDIUM";
         predictive_power = 40 + (diff_percent - 12) * 2.3;
      }
      else
      {
         impact = "LOW";
         predictive_power = diff_percent * 3.3;
      }
      predictive_power = MathMin(100, predictive_power);
      //Generate Rule
      GenerateRule(name, tf, safe_val, risky_val, is_buy_context);
   }
   void GenerateRule(string name, string tf, double safe_val, double risky_val, bool is_buy)
   {
      suggested_rule = "";
      rule_action = "";
      if(impact != "HIGH") return;
      if(StringFind(name, "RSI") >= 0)
      {
         double threshold = (safe_val + risky_val) / 2.0;
         if(is_buy && risky_val > safe_val)
         {
            suggested_rule = "IF RSI(" + tf + ") > " + DoubleToString(threshold, 0) + " AND Signal=BUY";
            rule_action = "CLOSE_TP1";
         }
         else if(!is_buy && risky_val < safe_val)
         {
            suggested_rule = "IF RSI(" + tf + ") < " + DoubleToString(threshold, 0) + " AND Signal=SELL";
            rule_action = "CLOSE_TP1";
         }
      }
      else if(StringFind(name, "ADX") >= 0)
      {
         double threshold = (safe_val + risky_val) / 2.0;
         if(risky_val < safe_val)
         {
            suggested_rule = "IF ADX(" + tf + ") < " + DoubleToString(threshold, 0);
            rule_action = "CLOSE_TP2";
         }
      }
      else if(StringFind(name, "DI_Gap") >= 0)
      {
         double threshold = (safe_val + risky_val) / 2.0;
         if(risky_val < safe_val)
         {
            suggested_rule = "IF DI_Gap(" + tf + ") < " + DoubleToString(threshold, 1) + " (weak trend)";
            rule_action = "CLOSE_TP1";
         }
      }
      else if(StringFind(name, "EMA200_Dist") >= 0)
      {
         if(risky_val > safe_val * 1.3)
         {
            suggested_rule = "IF EMA200_Dist(" + tf + ") > " + DoubleToString(safe_val * 1.2, 0);
            rule_action = "USE_TP2_TARGET";
         }
      }
      else if(StringFind(name, "HTF_Conflict") >= 0)
      {
         if(risky_val > safe_val * 1.5)
         {
            suggested_rule = "IF HTF_Conflict = TRUE";
            rule_action = "CLOSE_TP1";
         }
      }
      else if(StringFind(name, "Stability") >= 0)
      {
         double threshold = (safe_val + risky_val) / 2.0;
         if(risky_val < safe_val)
         {
            suggested_rule = "IF Stability < " + DoubleToString(threshold, 0);
            rule_action = "CLOSE_TP2";
         }
      }
   }
   bool IsSignificant() { return (impact == "HIGH"|| impact == "MEDIUM"); }
   string GetImpactEmoji()
   {
      if(impact == "HIGH") return "🔴";
      if(impact == "MEDIUM") return "🟡";
      return "🟢";
   }
};
//|STEP PREDICTION|
struct SStepPrediction
{
   int      predicted_step;
   double   confidence;
   string   reasoning;
   string   recommended_target;
   bool     should_skip_entry;
   int      risk_score;
   int      max_risk_score;
   int      risk_factors_count;
   string   risk_factors[15];
   void Reset()
   {
      predicted_step = 1;
      confidence = 50;
      reasoning = "";
      recommended_target = "EMA200";
      should_skip_entry = false;
      risk_score = 0;
      max_risk_score = 0;
      risk_factors_count = 0;
   }
   void AddRiskFactor(string factor, int points)
   {
      if(risk_factors_count < 15)
      {
         risk_factors[risk_factors_count] = factor + " (+" + IntegerToString(points) + ")";
         risk_factors_count++;
      }
      risk_score += points;
   }
   void Finalize()
   {
      if(max_risk_score == 0) max_risk_score = 100;
      double risk_pct = (risk_score * 100.0) / max_risk_score;
      risk_pct = MathMin(100, risk_pct);
      //Determine predicted step
      if(risk_pct >= 75)
      {
         predicted_step = 5;
         recommended_target = "TP1";
         should_skip_entry = (risk_pct >= 90);
      }
      else if(risk_pct >= 55)
      {
         predicted_step = 4;
         recommended_target = "TP1";
      }
      else if(risk_pct >= 40)
      {
         predicted_step = 3;
         recommended_target = "TP2";
      }
      else if(risk_pct >= 25)
      {
         predicted_step = 2;
         recommended_target = "EMA200";
      }
      else
      {
         predicted_step = 1;
         recommended_target = "EMA200";
      }
      //Calculate confidence
      confidence = 100 - (risk_pct * 0.4);
      confidence = MathMax(20, MathMin(95, confidence));
      //Build reasoning
      reasoning = StringFormat("Risk: %.0f%% (%d/%d)| Factors: %d",
                               risk_pct, risk_score, max_risk_score, risk_factors_count);
   }
   string GetPredictionBadge()
   {
      if(predicted_step <= 2) return "🟢 SAFE";
      if(predicted_step == 3) return "🟡 MODERATE";
      return "🔴 RISKY";
   }
   string GetTargetEmoji()
   {
      if(recommended_target == "EMA200") return "🎯";
      if(recommended_target == "TP1") return "⚡";
      if(recommended_target == "TP2") return "💫";
      return "❓";
   }
};
//|SMART TARGET SYSTEM|
enum ENUM_SMART_TARGET
{
   TARGET_EMA200,
   TARGET_TP1,
   TARGET_TP2,
   TARGET_TP3,
   TARGET_ADAPTIVE
};
struct SSmartTarget
{
   ENUM_SMART_TARGET initial_target;
   ENUM_SMART_TARGET current_target;
   double   tp1_price;
   double   tp2_price;
   double   tp3_price;
   double   ema200_price;
   double   entry_price;
   bool     tp1_reached;
   bool     tp2_reached;
   datetime tp1_time;
   datetime tp2_time;
   double   max_favorable;
   double   max_adverse;
   int      current_step;
   bool     should_close;
   string   close_reason;
   void Initialize(double entry, double tp1, double tp2, double tp3, double ema200, ENUM_SMART_TARGET init_target)
   {
      entry_price = entry;
      tp1_price = tp1;
      tp2_price = tp2;
      tp3_price = tp3;
      ema200_price = ema200;
      initial_target = init_target;
      current_target = init_target;
      tp1_reached = tp2_reached = false;
      tp1_time = tp2_time = 0;
      max_favorable = entry;
      max_adverse = entry;
      current_step = 1;
      should_close = false;
      close_reason = "";
   }
   void UpdateOnTick(double current_price, bool is_bull, int step)
   {
      current_step = step;
      //Track max favorable/adverse
      if(is_bull)
      {
         if(current_price > max_favorable) max_favorable = current_price;
         if(current_price < max_adverse) max_adverse = current_price;
      }
      else
      {
         if(current_price < max_favorable) max_favorable = current_price;
         if(current_price > max_adverse) max_adverse = current_price;
      }
      //Check TP1 hit
      if(!tp1_reached)
      {
         bool hit = is_bull ? (current_price >= tp1_price) : (current_price <= tp1_price);
         if(hit)
         {
            tp1_reached = true;
            tp1_time = TimeCurrent();
         }
      }
      //Check TP2 hit
      if(!tp2_reached)
      {
         bool hit = is_bull ? (current_price >= tp2_price) : (current_price <= tp2_price);
         if(hit)
         {
            tp2_reached = true;
            tp2_time = TimeCurrent();
         }
      }
      //=== ADAPTIVE LOGIC ===
      ApplyAdaptiveLogic(current_price, is_bull);
   }
   void ApplyAdaptiveLogic(double current_price, bool is_bull)
   {
      if(should_close)
         return;
      //Rule 1: اگر Step >= 2 و TP1 زده شده و قیمت برگشته
      if(current_step >= 2 && tp1_reached)
      {
         bool price_retreated = is_bull ?
            (current_price < tp1_price * 0.997) :
            (current_price > tp1_price * 1.003);
         if(price_retreated)
         {
            current_target = TARGET_TP1;
            bool back_to_tp1 = is_bull ?
               (current_price >= tp1_price * 0.999) :
               (current_price <= tp1_price * 1.001);
            if(back_to_tp1)
            {
               should_close = true;
               close_reason = "ADAPTIVE_TP1_RETURN";
               return;
            }
         }
      }
      //Rule 2: اگر Step >= 3 و TP2 زده شده و قیمت برگشته
      if(current_step >= 3 && tp2_reached)
      {
         bool price_retreated = is_bull ?
            (current_price < tp2_price * 0.997) :
            (current_price > tp2_price * 1.003);
         if(price_retreated)
         {
            current_target = TARGET_TP2;
            bool back_to_tp2 = is_bull ?
               (current_price >= tp2_price * 0.999) :
               (current_price <= tp2_price * 1.001);
            if(back_to_tp2)
            {
               should_close = true;
               close_reason = "ADAPTIVE_TP2_RETURN";
               return;
            }
         }
      }
      //Rule 3: اگر Step >= 4 و قیمت هیچ TP نزده و برگشته
      if(current_step >= 4 && !tp1_reached && !tp2_reached)
      {
         double favorable_dist = MathAbs(max_favorable - entry_price);
         double current_dist = is_bull ?
            (current_price - entry_price) :
            (entry_price - current_price);
         if(favorable_dist > 0 && current_dist < favorable_dist * 0.5 && current_dist > 0)
         {
            should_close = true;
            close_reason = "STEP4_PROFIT_PROTECT";
            return;
         }
      }
   }
   bool ShouldCloseNow() { return should_close; }
   string GetCurrentTargetName()
   {
      switch(current_target)
      {
         case TARGET_EMA200:   return "EMA200";
         case TARGET_TP1:      return "TP1";
         case TARGET_TP2:      return "TP2";
         case TARGET_TP3:      return "TP3";
         case TARGET_ADAPTIVE: return "ADAPTIVE";
      }
      return "UNKNOWN";
   }
   double GetCurrentTargetPrice(bool is_bull)
   {
      switch(current_target)
      {
         case TARGET_EMA200:   return ema200_price;
         case TARGET_TP1:      return tp1_price;
         case TARGET_TP2:      return tp2_price;
         case TARGET_TP3:      return tp3_price;
         default:              return is_bull ? tp1_price : tp1_price;
      }
   }
};
//|Get Sample Text - LOCALIZED|
string GetSampleTextLocal(int total)
{
   if(total == 0)                          return g_lang.no_data_word;
   if(total < inp_min_sample_display)      return g_lang.sample_insufficient + " (" + IntegerToString(total) + ")";
   if(total < inp_min_sample_reliable)     return g_lang.sample_low + " (" + IntegerToString(total) + ")";
   if(total < inp_min_sample_confident)    return g_lang.sample_moderate + " (" + IntegerToString(total) + ")";
   return g_lang.sample_good + " (" + IntegerToString(total) + ")";
}
//|Get Significance Text - LOCALIZED|
string GetSignificanceTextLocal(int sample_count)
{
   switch(GetStatSignificance(sample_count))
   {
      case SIG_INSUFFICIENT: return g_lang.not_reliable;
      case SIG_WEAK:         return g_lang.low_confidence;
      case SIG_MODERATE:     return g_lang.moderate;
      case SIG_GOOD:         return g_lang.good;
      case SIG_STRONG:       return g_lang.high_confidence;
   }
   return "";
}
string EscapeHTMLAttr(string s)
{
   // 1) Convert <br> variants to real newline first (while tags still exist)
   StringReplace(s, "<br>", "\n");
   StringReplace(s, "<br/>", "\n");
   StringReplace(s, "<br />", "\n");
   StringReplace(s, "<BR>", "\n");
   StringReplace(s, "<BR/>", "\n");
   StringReplace(s, "<BR />", "\n");
   // 2) Escape for HTML attribute context (title="...")
   StringReplace(s, "&", "&amp;");
   StringReplace(s, "\"", "&quot;");
   StringReplace(s, "<", "&lt;");
   StringReplace(s, ">", "&gt;");
   // 3) title attribute uses &#10; for new line
   StringReplace(s, "\r\n", "\n");
   StringReplace(s, "\r", "\n");
   StringReplace(s, "\n", "&#10;");
   return s;
}
//|Build HTML Tooltip Span - v8.1 COMPLETE|
string BuildTooltip(string text, string tooltip, string css_class = "")
{
   if(text == "") text = "";
   if(tooltip == "") return text;
   string safe_tooltip = EscapeHTMLAttr(tooltip);
   string cls = "has-tooltip";
   if(css_class != "") cls = css_class + " has-tooltip";
   return "<span class=\"" + cls + "\" title=\"" + safe_tooltip + "\">" + text + "</span>";
}
//|Build Help Icon with Tooltip - v8.1|
string BuildHelpIcon(string tooltip)
{
   if(tooltip == "") return "";
   string safe = EscapeHTMLAttr(tooltip);
   return " <span class=\"help-icon\" title=\"" + safe + "\">?</span>";
}
