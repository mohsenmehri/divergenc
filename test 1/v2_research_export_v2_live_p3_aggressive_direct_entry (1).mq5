      policy_rank = 0;
   }
};
struct SS2BWFMetrics
{
   bool     valid;
   string   invalid_reason;
   string   protocol_hash;
   string   fold_hash;
   string   feature_hash;
   string   dataset_hash;
   string   row_mask_hash;
   string   evaluator_version;
   string   target_name;
   string   target_definition;
   bool     higher_score_higher_positive;
   string   valid_row_policy;
   int      snapshot_count;
   int      risklab_count;
   datetime first_entry_time;
   datetime last_entry_time;
   string   feature_list;
   int      n_features;
   int      eligible_count;
   int      excluded_count;
   int      fold_count;
   int      valid_primary_folds;
   double   mean_auc;
   double   worst_auc;
   double   std_auc;
   double   mean_prauc;
   double   mean_mcc;
   double   mean_recall;
   double   mean_f2;
   int      sign_flips;
   int      large_drift;
   // Fold detail
   string   fold_name[S2B_MAX_FOLDS];
   int      fold_valid[S2B_MAX_FOLDS];
   int      fold_primary[S2B_MAX_FOLDS];
   datetime fold_train_from[S2B_MAX_FOLDS];
   datetime fold_train_to[S2B_MAX_FOLDS];
   datetime fold_val_from[S2B_MAX_FOLDS];
   datetime fold_val_to[S2B_MAX_FOLDS];
   int      fold_train_n[S2B_MAX_FOLDS];
   int      fold_train_pos[S2B_MAX_FOLDS];
   int      fold_train_neg[S2B_MAX_FOLDS];
   int      fold_val_n[S2B_MAX_FOLDS];
   int      fold_val_pos[S2B_MAX_FOLDS];
   int      fold_val_neg[S2B_MAX_FOLDS];
   double   fold_auc[S2B_MAX_FOLDS];
   double   fold_prauc[S2B_MAX_FOLDS];
   double   fold_mcc[S2B_MAX_FOLDS];
   double   fold_recall[S2B_MAX_FOLDS];
   double   fold_f2[S2B_MAX_FOLDS];
   // OOS audit
   string   normalization_hash;
   string   model_hash;
   string   threshold_source;
   double   oos_auc;
   double   oos_prauc;
   double   oos_mcc;
   double   oos_recall;
   double   oos_f2;
   int      oos_n;
   int      oos_pos;
   int      oos_neg;
   void Reset()
   {
      valid = false;
      invalid_reason = "";
      protocol_hash = "";
      fold_hash = "";
      feature_hash = "";
      dataset_hash = "";
      row_mask_hash = "";
      evaluator_version = S2B_EVALUATOR_VERSION;
      target_name = "";
      target_definition = "";
      higher_score_higher_positive = true;
      valid_row_policy = "";
      snapshot_count = 0;
      risklab_count = 0;
      first_entry_time = 0;
      last_entry_time  = 0;
      feature_list = "";
      n_features = 0;
      eligible_count = 0;
      excluded_count = 0;
      fold_count = 0;
      valid_primary_folds = 0;
      mean_auc = 0.0;
      worst_auc = 0.0;
      std_auc = 0.0;
      mean_prauc = 0.0;
      mean_mcc = 0.0;
      mean_recall = 0.0;
      mean_f2 = 0.0;
      sign_flips = 0;
      large_drift = 0;
      for(int i = 0; i < S2B_MAX_FOLDS; i++)
      {
         fold_name[i] = "";
         fold_valid[i] = 0;
         fold_primary[i] = 0;
         fold_train_from[i] = 0;
         fold_train_to[i]   = 0;
         fold_val_from[i]   = 0;
         fold_val_to[i]     = 0;
         fold_train_n[i]   = 0;
         fold_train_pos[i] = 0;
         fold_train_neg[i] = 0;
         fold_val_n[i]   = 0;
         fold_val_pos[i] = 0;
         fold_val_neg[i] = 0;
         fold_auc[i]    = 0.0;
         fold_prauc[i]  = 0.0;
         fold_mcc[i]    = 0.0;
         fold_recall[i] = 0.0;
         fold_f2[i]     = 0.0;
      }
      normalization_hash = "";
      model_hash = "";
      threshold_source = "";
      oos_auc = 0.0;
      oos_prauc = 0.0;
      oos_mcc = 0.0;
      oos_recall = 0.0;
      oos_f2 = 0.0;
      oos_n = 0;
      oos_pos = 0;
      oos_neg = 0;
   }
