#define MAX_LOOKBACK_BARS       30000
#define BUFFER_COPY_SIZE        500
#define MIN_BARS_REQUIRED       300
#define BUFFER_MARGIN           10
#define ERROR_COOLDOWN_SECONDS  60
#define MAINTENANCE_INTERVAL    3600
#define MAX_TRADE_ATTEMPTS      3
#define MAX_MTF_PATTERNS        500
#define MAX_SIGNATURES          100
// --- bin configs ---
#define OS_RSI_BIN          5
#define OS_RSI_BINS         20
#define OS_ADX_BIN          5
#define OS_ADX_BINS         20
