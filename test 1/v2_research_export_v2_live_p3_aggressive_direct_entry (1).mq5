      int cnt = is_buy ? g_adx_buy[tf][step].adx_ranges[0].count : g_adx_sell[tf][step].adx_ranges[0].count;
      result.Analyze(cnt, 0, total, "[" + IntegerToString(rs) + "-" + IntegerToString(rs+5) + "]", "");
      return result;
   }
   SSortedView sv;
   if(is_buy) sv.BuildFromRanges(g_adx_buy[tf][step].adx_ranges, adx_count);
