void S2B_FU_SeedRng(uint s){ g_fu_rng_state=(s==0?1u:s); }
uint S2B_FU_NextRng(){ g_fu_rng_state=g_fu_rng_state*1664525u+1013904223u; return g_fu_rng_state; }
int  S2B_FU_RandInt(int n){ if(n<=1) return 0; return (int)((S2B_FU_NextRng()>>1)%(uint)n); }
double S2B_FU_Sig(double z){ if(z>30.0) return 1.0; if(z<-30.0) return 0.0; return 1.0/(1.0+MathExp(-z)); }
uint S2B_FU_Mix(uint h,string s)
{
   uint x=S2B_HashString32(s);
   h ^= x + 0x9E3779B9 + (h<<6) + (h>>2);
   return h;
}
double S2B_FU_V(int r,int f){ return g_fu_val[r*g_fu_feat_count+f]; }
bool   S2B_FU_OK(int r,int f){ return (g_fu_ok[r*g_fu_feat_count+f]==1); }
