ENUM_EMA_SLOPE CalculateEMA200Slope(int tf_index = 0, int lookback = 20)
{
   if(tf_index < 0 || tf_index >= TF_COUNT)
      return SLOPE_FLAT;
   if(ArraySize(g_tf[tf_index].buffer_ema_200) < lookback + 1)
      return SLOPE_FLAT;
   double ema_now = g_tf[tf_index].buffer_ema_200[0];
   double ema_past = g_tf[tf_index].buffer_ema_200[lookback];
   if(MathAbs(ema_now) < 1e-12 || MathAbs(ema_past) < 1e-12)
      return SLOPE_FLAT;
   double slope = (ema_now - ema_past) / lookback;
   double slope_pips = slope / _Point;
   if(slope_pips > 5)       return SLOPE_STRONG_UP;
   if(slope_pips > 1)       return SLOPE_WEAK_UP;
   if(slope_pips > -1)      return SLOPE_FLAT;
   if(slope_pips > -5)      return SLOPE_WEAK_DOWN;
   return SLOPE_STRONG_DOWN;
}
//|Get Price vs EMA200 Position|
ENUM_PRICE_VS_EMA GetPriceVsEMA200(double price, double ema200)
{
   if(MathAbs(ema200) < 1e-12)
      return POS_AT_EMA;
   double dist_points = (price - ema200) / _Point;
   if(dist_points > 200)     return POS_ABOVE_FAR;
   if(dist_points > 50)      return POS_ABOVE_NEAR;
   if(dist_points > -50)     return POS_AT_EMA;
   if(dist_points > -200)    return POS_BELOW_NEAR;
   return POS_BELOW_FAR;
}
//|Calculate EMA200 Distance in Points|
double CalculateEMA200Distance(double price, double ema200)
{
   if(ema200 == 0)
      return 0;
   return MathAbs(price - ema200) / _Point;
}
//گروه‌بندی معاملات
enum ENUM_TRADE_GROUP
{
   GROUP_SAFE,       //MaxStep = 1 or 2
   GROUP_MODERATE,   //MaxStep = 3
   GROUP_RISKY       //MaxStep = 4 or 5
};
enum ENUM_PATH_CLASS
{
   PATH_UNKNOWN = 0,
   PATH_SAFE_TARGET,   // Step1/2 + Target
   PATH_SAFE_STOP,     // Step1/2 + Stop
   PATH_MID_TARGET,    // Step3 + Target
   PATH_MID_STOP,      // Step3 + Stop
   PATH_DEEP_TARGET,   // Step4/5 + Target
   PATH_DEEP_STOP      // Step4/5 + Stop
};
//|RAW FEATURE ANALYSIS STRUCTURES|
// سه Target که بررسی می‌کنیم
enum ENUM_RL_TARGET
{
   RL_TARGET_STEP3 = 0,   // HitStep3Plus
   RL_TARGET_STEP4 = 1,   // HitStep4Plus
   RL_TARGET_STOP  = 2    // StopFlag
};
// نتیجه تحلیل یک Feature برای یک Target
struct SRLFeatureStat
{
   // شناسه
   string   feature_name;
   string   tf_name;
   string   side;
   string   target_name;
   string   split;
   // تعداد
   int      n_total;
   int      n_positive;
   int      n_negative;
   double   base_rate;
   // آمار گروه positive و negative
   double   mean_pos;
   double   std_pos;
   double   mean_neg;
   double   std_neg;
   // Effect Size
   double   cohens_d;
   string   effect_label;
   // AUC
   double   auc;
   // PR-AUC
   double   pr_auc;
   // Lift در کوارتیل‌ها
   double   lift_q1;
   double   lift_q4;
   // CI
   double   ci_lower_95;
   double   ci_upper_95;
   // === جدید ===
   double   odds_ratio;     // OR = (pos_high/pos_low) / (neg_high/neg_low)
   double   risk_ratio;     // RR = rate_high / rate_low
   double   or_ci_lower;    // CI برای OR (log scale, approx)
   double   or_ci_upper;
   // Decile Analysis — نرخ Target در هر decile
   double   decile_rate[10];   // decile_rate[0] = کمترین مقدار feature
   int      decile_count[10];
   void Reset()
   {
      feature_name = tf_name = side = target_name = split = "";
      n_total = n_positive = n_negative = 0;
      base_rate = 0.0;
      mean_pos = std_pos = mean_neg = std_neg = 0.0;
      cohens_d = 0.0;
      effect_label = "negligible";
      auc = 0.5;
      pr_auc = 0.0;
      lift_q1 = lift_q4 = 1.0;
      ci_lower_95 = ci_upper_95 = 0.0;
      odds_ratio = risk_ratio = 1.0;
      or_ci_lower = or_ci_upper = 0.0;
      for(int i = 0; i < 10; i++) { decile_rate[i] = 0.0; decile_count[i] = 0; }
   }
   string GetEffectLabel(double d)
   {
      double ad = MathAbs(d);
      if(ad >= 0.8) return "large";
      if(ad >= 0.5) return "medium";
      if(ad >= 0.2) return "small";
      return "negligible";
   }
};
//|INCREMENTAL MODEL STRUCTURES|
// یک مدل خطی ساده: score = w0 + w1*f1 + w2*f2 + w3*f3
struct SRLLinearModel
{
   string   model_name;
   string   side;
   string   target;
   int      n_features;
   string   feature_names[3];
   string   tf_names[3];
   // coefficients
   double   w0;
   double   w1;
   double   w2;
   double   w3;
   // normalization params (برای inference در EA)
   double   feat_mean[3];
   double   feat_std[3];
   // DEV performance
   double   dev_auc;
   double   dev_pr_auc;
   double   dev_brier;
   double   dev_auc_ci_lower;   // Bootstrap 95% CI
   double   dev_auc_ci_upper;
   // OOS performance
   double   oos_auc;
   double   oos_pr_auc;
   double   oos_brier;
   double   oos_auc_ci_lower;
   double   oos_auc_ci_upper;
   // Incremental vs previous
   double   incremental_auc_dev;
   double   incremental_auc_oos;
   // Calibration
   double   calib_bin_pred[10];    // میانگین prediction در هر bin
   double   calib_bin_actual[10];  // نرخ واقعی در هر bin
   int      calib_bin_count[10];
   double   calib_ece;             // Expected Calibration Error
   // Cost-based threshold
   double   best_threshold;        // بهترین threshold بر اساس F-beta
   double   threshold_precision;
   double   threshold_recall;
   double   threshold_f1;
   // Sample counts
   int      n_dev;
   int      n_oos;
   int      n_pos_dev;
   int      n_pos_oos;
   void Reset()
   {
      model_name = side = target = "";
      n_features = 0;
      for(int i = 0; i < 3; i++)
      {
         feature_names[i] = "";
         tf_names[i] = "";
         feat_mean[i] = 0.0;
         feat_std[i]  = 1.0;
      }
      w0 = w1 = w2 = w3 = 0.0;
      dev_auc = oos_auc = 0.5;
      dev_pr_auc = oos_pr_auc = 0.0;
      dev_brier = oos_brier = 0.25;
      dev_auc_ci_lower = dev_auc_ci_upper = 0.5;
      oos_auc_ci_lower = oos_auc_ci_upper = 0.5;
      incremental_auc_dev = incremental_auc_oos = 0.0;
      for(int i = 0; i < 10; i++)
      {
         calib_bin_pred[i]   = 0.0;
         calib_bin_actual[i] = 0.0;
         calib_bin_count[i]  = 0;
      }
      calib_ece = 0.0;
      best_threshold = 0.5;
      threshold_precision = threshold_recall = threshold_f1 = 0.0;
      n_dev = n_oos = n_pos_dev = n_pos_oos = 0;
   }
   string GetFeatureKey(int idx)
   {
      if(idx < 0 || idx >= n_features) return "";
      return feature_names[idx] + (tf_names[idx] != "" ? "_" + tf_names[idx] : "");
   }
};
//================================================================
// Stage 2A v1.1: Feature Importance Row
//================================================================
struct SFeatureImportanceRow
{
   // شناسایی
   string   feature_name;
   string   feature_group;
   string   tf_name;
   // ---- Target 1: StopFlag ----
   double   stop_auc;
   double   stop_auc_ci_lo;   // Bootstrap CI — فقط اگر status==OK، وگرنه -1
   double   stop_auc_ci_hi;
   double   stop_cohen_d;
   int      stop_n;
   int      stop_positive_n;
   int      stop_negative_n;
   double   stop_dev_auc;
   double   stop_oos_auc;
   double   stop_auc_decay_pct;
   string   stop_status;      // OK / LOW_CONFIDENCE / LOW_SAMPLE
   // ---- Target 2: HitStep4Plus ----
   double   step4_auc;
   double   step4_auc_ci_lo;
   double   step4_auc_ci_hi;
   double   step4_cohen_d;
   int      step4_n;
   int      step4_positive_n;
   int      step4_negative_n;
   double   step4_dev_auc;
   double   step4_oos_auc;
   double   step4_auc_decay_pct;
   string   step4_status;
   // ---- Target 3: DeepStop (row-level, از g_risklab_records[]) ----
   double   deepstop_auc;
   double   deepstop_auc_ci_lo;
   double   deepstop_auc_ci_hi;
   double   deepstop_cohen_d;
   int      deepstop_n;
   int      deepstop_positive_n;
   int      deepstop_negative_n;
   double   deepstop_dev_auc;
   double   deepstop_oos_auc;
   double   deepstop_auc_decay_pct;
   string   deepstop_status;
   // ---- Composite / Verdict ----
   double   composite_score;
   string   verdict;            // STRONG / MODERATE / WEAK / NOISE / LOW_SAMPLE
   string   best_target;
   string   direction;          // HIGH_RISK / LOW_RISK / NO_SIGNAL
   bool     oos_stable;
   string   oos_stability_label; // STABLE / MILD_DEGRADATION / UNSTABLE / REVERSED
   void Reset()
   {
      feature_name      = "";
      feature_group     = "OTHER";
      tf_name           = "GLOBAL";
      stop_auc           = 0.0;
      stop_auc_ci_lo     = -1.0;
      stop_auc_ci_hi     = -1.0;
      stop_cohen_d       = 0.0;
      stop_n             = 0;
      stop_positive_n    = 0;
      stop_negative_n    = 0;
      stop_dev_auc       = 0.0;
      stop_oos_auc       = 0.0;
      stop_auc_decay_pct = 0.0;
      stop_status        = "LOW_SAMPLE";
      step4_auc           = 0.0;
      step4_auc_ci_lo     = -1.0;
      step4_auc_ci_hi     = -1.0;
      step4_cohen_d       = 0.0;
      step4_n             = 0;
      step4_positive_n    = 0;
      step4_negative_n    = 0;
      step4_dev_auc       = 0.0;
