// ---------------------------------------------------------------
// Globals — Stage2B protocol / fold source / pipeline state
// ---------------------------------------------------------------
SS2BProtocol  g_s2b_protocol;
SS2BFold      g_s2b_folds[];
int           g_s2b_fold_count = 0;
SS2BWFMetrics g_s2b_baseline_wf;
SS2BWFMetrics g_s2b_selected_candidate_wf;
bool   g_s2b_selected_candidate_valid = false;
// ================================================================
// Stage 2B — Pipeline State Flags (separated per concern)
// ================================================================
bool   g_s2b_alignment_valid          = false;  // protocol + fold + selftest
bool   g_s2b_search_allowed          = false;  // search on DEV/WF
bool   g_s2b_candidate_selected      = false;  // one candidate passed gate
bool   g_s2b_oos_allowed             = false;  // OOS eval for final candidate
bool   g_s2b_winner_confirmed        = false;  // winner confirmation done
bool   g_s2b_freeze_allowed          = false;  // frozen package may be exported
bool   g_s2b_frozen_generated_this_run = false;
string g_s2b_block_reason            = "";
// Legacy compatibility alias
bool   g_s2b_pipeline_valid          = false;
void S2B_ResetPipelineState()
{
   g_s2b_alignment_valid = false;
   g_s2b_search_allowed = false;
   g_s2b_candidate_selected = false;
   g_s2b_oos_allowed = false;
   g_s2b_winner_confirmed = false;
   g_s2b_freeze_allowed = false;
   g_s2b_frozen_generated_this_run = false;
   g_s2b_block_reason = "";
   g_s2b_pipeline_valid = false;
   g_s2b_baseline_wf.Reset();
   g_s2b_selected_candidate_wf.Reset();
   g_s2b_selected_candidate_valid = false;
   g_s2b_selftest_passed = false;
   g_s2b_oos_used_this_run = false;
   g_s2b_baseline_final_eval.Reset();
   g_s2b_candidate_final_eval.Reset();
   g_s2b_alignment_protocol_fold_status = "UNKNOWN";
   g_s2b_alignment_baseline_eval_status = "UNKNOWN";
   g_s2b_alignment_cross_component_status = "NOT_YET_VERIFIED";
   g_s2b_alignment_selftest_status = "NOT_RUN";
}
void S2B_BlockPipeline(string reason)
{
   g_s2b_pipeline_valid = false;
   g_s2b_alignment_valid = false;
   g_s2b_search_allowed = false;
   g_s2b_candidate_selected = false;
   g_s2b_oos_allowed = false;
   g_s2b_winner_confirmed = false;
   g_s2b_freeze_allowed = false;
   g_s2b_frozen_generated_this_run = false;
   g_s2b_block_reason = reason;
}
bool S2B_IsAlignmentAuditOnly()
{
   return (inp_s2d_run_mode == MODE_TRAIN_EXPORT && inp_s2b_alignment_audit_only);
}
void S2B_FillCompactPoolFeatures(int &pool_feats[])
{
   ArrayResize(pool_feats, S2B_COMPACT_POOL_SIZE);
   pool_feats[0] = S2B_F_EMA200_DIST_M1;
   pool_feats[1] = S2B_F_DI_GAP_M5;
   pool_feats[2] = S2B_F_ADX_SLOPE_H1;
   pool_feats[3] = S2B_F_ADX_M30;
   pool_feats[4] = S2B_F_ADX_SLOPE_M15;
   pool_feats[5] = S2B_F_SIGNAL_CLV;
   pool_feats[6] = S2B_F_EMA_COMP_H4;
   pool_feats[7] = S2B_F_OB_DIST_PCT;
}
string S2B_BuildFeatureListString(int &feat_idx[], int n_feat)
{
   string s = "";
   for(int k = 0; k < n_feat; k++)
   {
      if(k > 0) s += "|";
      s += S2B_FeatureName(feat_idx[k]);
   }
   return s;
}
string S2B_BuildFeatureHash(int &feat_idx[], int n_feat)
{
   string s = "N=" + IntegerToString(n_feat) + "|";
   for(int k = 0; k < n_feat; k++)
      s += S2B_FeatureName(feat_idx[k]) + "|";
   return S2B_HashToString(S2B_HashString32(s));
}
// ---------------------------------------------------------------
// Time window helpers
// ---------------------------------------------------------------
bool S2B_IsInRange(datetime t, datetime from_t, datetime to_t)
{
   return (t >= from_t && t < to_t);
}
datetime S2B_YearStart(int year); // existing later, used elsewhere
// ---------------------------------------------------------------
// Dataset identity
// ---------------------------------------------------------------
void S2B_GetDatasetIdentity(datetime &first_t,
                            datetime &last_t,
                            int &snap_cnt,
                            int &rl_cnt)
{
   first_t = 0;
   last_t  = 0;
   snap_cnt = g_snapshot_count;
   rl_cnt   = g_risklab_count;
   bool first_set = false;
   for(int i = 0; i < g_risklab_count; i++)
   {
      datetime t = g_risklab_records[i].entry_time;
      if(t <= 0) continue;
      if(!first_set)
      {
         first_t = t;
         last_t  = t;
         first_set = true;
      }
      else
      {
         if(t < first_t) first_t = t;
         if(t > last_t)  last_t  = t;
      }
   }
   if(!first_set && g_snapshot_count > 0)
   {
      first_t = g_snapshots[0].entry_time;
      last_t  = g_snapshots[0].entry_time;
      for(int i = 1; i < g_snapshot_count; i++)
      {
         if(g_snapshots[i].entry_time < first_t) first_t = g_snapshots[i].entry_time;
         if(g_snapshots[i].entry_time > last_t)  last_t  = g_snapshots[i].entry_time;
      }
   }
}
string S2B_BuildDatasetHash(datetime first_t,
                            datetime last_t,
                            int snap_cnt,
                            int rl_cnt)
{
   string s = "";
   s += "SYMBOL=" + _Symbol + "|";
   s += "SNAP=" + IntegerToString(snap_cnt) + "|";
   s += "RL=" + IntegerToString(rl_cnt) + "|";
   s += "FIRST=" + S2B_TimeKey(first_t) + "|";
   s += "LAST=" + S2B_TimeKey(last_t);
   return S2B_HashToString(S2B_HashString32(s));
}
bool S2B_RowEligible_CommonPool(int rec_idx, string &why)
{
   why = "";
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
   {
      why = "REC_IDX_OOB";
      return false;
   }
   SRiskLabRecord rec = g_risklab_records[rec_idx];
   if(rec.entry_time <= 0)
   {
      why = "NO_ENTRY_TIME";
      g_s2b_exclusion.no_entry_time++;
      return false;
   }
   if(rec.max_step_reached < 1 || rec.max_step_reached > 5)
   {
      why = "MAXSTEP_OUT_OF_RANGE";
      g_s2b_exclusion.invalid_maxstep++;
      return false;
   }
   if(!S2B_IsInRange(rec.entry_time, g_s2b_protocol.development_from, g_s2b_protocol.oos_to))
   {
      why = "OUTSIDE_PROTOCOL_WINDOW";
      g_s2b_exclusion.outside_protocol++;
      return false;
   }
   int pool_feats[];
   S2B_FillCompactPoolFeatures(pool_feats);
   for(int k = 0; k < ArraySize(pool_feats); k++)
   {
      double v = 0.0;
      if(!S2B_GetFeatureValue(rec_idx, pool_feats[k], v))
      {
         why = "MISSING_" + S2B_FeatureName(pool_feats[k]);
         if(k < S2B_COMPACT_POOL_SIZE)
            g_s2b_exclusion.missing_feature[k]++;
         g_s2b_exclusion.missing_feature_total++;
         ArrayFree(pool_feats);
         return false;
      }
   }
   ArrayFree(pool_feats);
   return true;
}
string S2B_BuildRowMaskHash(int &eligible_rec_idx[], int n)
{
   string s = "ROWMASK|N=" + IntegerToString(n) + "|";
   for(int i = 0; i < n; i++)
   {
      int ri = eligible_rec_idx[i];
      if(ri < 0 || ri >= g_risklab_count) continue;
      s += IntegerToString(g_risklab_records[ri].setup_id) + "@";
      s += S2B_TimeKey(g_risklab_records[ri].entry_time) + "|";
   }
   return S2B_HashToString(S2B_HashString32(s));
}
string S2B_BuildProtocolHash(SS2BProtocol &proto)
{
   string s = "";
   s += "VER=" + proto.protocol_version + "|";
   s += "SYMBOL=" + proto.symbol_name + "|";
   s += "TARGET=" + proto.target_name + "|";
   s += "TARGET_DEF=" + proto.target_definition + "|";
   s += "DEV_FROM=" + S2B_TimeKey(proto.development_from) + "|";
   s += "DEV_TO="   + S2B_TimeKey(proto.development_to)   + "|";
   s += "OOS_FROM=" + S2B_TimeKey(proto.oos_from) + "|";
   s += "OOS_TO="   + S2B_TimeKey(proto.oos_to)   + "|";
   s += "ROWPOL="   + proto.valid_row_policy + "|";
   s += "DATASET="  + proto.dataset_hash + "|";
   s += "ROWMASK="  + proto.row_mask_hash + "|";
   s += "POOL="     + S2B_BuildFeatureListString(proto.compact_pool_feature_idx, proto.compact_pool_count) + "|";
   s += "ALLOW_OOS_SELECTION=" + IntegerToString(proto.allow_oos_for_selection ? 1 : 0);
   return S2B_HashToString(S2B_HashString32(s));
}
string S2B_BuildFoldHash(SS2BFold &folds[], int fold_count)
{
   string s = "FOLDS|COUNT=" + IntegerToString(fold_count) + "|";
   for(int i = 0; i < fold_count; i++)
   {
      s += folds[i].name + "|";
      s += S2B_TimeKey(folds[i].train_from) + "|";
      s += S2B_TimeKey(folds[i].train_to)   + "|";
      s += S2B_TimeKey(folds[i].val_from)   + "|";
      s += S2B_TimeKey(folds[i].val_to)     + "|";
      s += IntegerToString(folds[i].is_primary ? 1 : 0) + "|";
      s += IntegerToString(folds[i].is_warmup  ? 1 : 0) + "|";
   }
   return S2B_HashToString(S2B_HashString32(s));
}
bool S2B_InitProtocol()
{
   S2B_ResetPipelineState();
   g_s2b_protocol.Reset();
   g_s2b_exclusion.Reset();
   g_s2b_protocol.symbol_name = _Symbol;
   g_s2b_protocol.target_name = "HitStep4Plus";
   g_s2b_protocol.target_definition = "actual_max_step >= 4";
   g_s2b_protocol.higher_score_higher_positive = true;
   g_s2b_protocol.development_from = StringToTime("2018.01.01");
   g_s2b_protocol.development_to   = StringToTime("2023.01.01");
   g_s2b_protocol.dev_from = g_s2b_protocol.development_from;
   g_s2b_protocol.dev_to   = g_s2b_protocol.development_to;
   g_s2b_protocol.oos_from = StringToTime("2023.01.01");
   g_s2b_protocol.oos_to   = StringToTime("2024.01.01");
   g_s2b_protocol.allow_oos_for_selection = false;
   g_s2b_protocol.evaluate_oos_after_final_selection_only = true;
   int pool_feats[];
   S2B_FillCompactPoolFeatures(pool_feats);
   g_s2b_protocol.compact_pool_count = ArraySize(pool_feats);
   for(int i = 0; i < g_s2b_protocol.compact_pool_count && i < S2B_COMPACT_POOL_SIZE; i++)
      g_s2b_protocol.compact_pool_feature_idx[i] = pool_feats[i];
   ArrayFree(pool_feats);
   S2B_GetDatasetIdentity(g_s2b_protocol.first_entry_time,
                          g_s2b_protocol.last_entry_time,
                          g_s2b_protocol.snapshot_count,
                          g_s2b_protocol.risklab_count);
   g_s2b_protocol.dataset_hash = S2B_BuildDatasetHash(
      g_s2b_protocol.first_entry_time,
      g_s2b_protocol.last_entry_time,
      g_s2b_protocol.snapshot_count,
      g_s2b_protocol.risklab_count);
   if(g_risklab_count <= 0)
   {
      g_s2b_protocol.valid = false;
      g_s2b_protocol.invalid_reason = "NO_RISKLAB_RECORDS";
      S2B_BlockPipeline("NO_RISKLAB_RECORDS");
      return false;
   }
   ArrayResize(g_s2b_protocol.row_mask_flags, g_risklab_count);
   ArrayInitialize(g_s2b_protocol.row_mask_flags, 0);
   ArrayResize(g_s2b_protocol.eligible_record_indices, g_risklab_count);
   int elig = 0;
   int protocol_total = 0;
   int dev_total = 0;
   int oos_total = 0;
   int excl = 0;
   int elig_dev = 0;
   int elig_oos = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      datetime t = g_risklab_records[r].entry_time;
      if(!S2B_IsInRange(t, g_s2b_protocol.development_from, g_s2b_protocol.oos_to))
      {
         g_s2b_exclusion.outside_protocol++;
         continue;
      }
      protocol_total++;
      if(S2B_IsInRange(t, g_s2b_protocol.development_from, g_s2b_protocol.development_to))
         dev_total++;
      else if(S2B_IsInRange(t, g_s2b_protocol.oos_from, g_s2b_protocol.oos_to))
         oos_total++;
      string why = "";
      bool ok = S2B_RowEligible_CommonPool(r, why);
      if(ok)
      {
         g_s2b_protocol.row_mask_flags[r] = 1;
         g_s2b_protocol.eligible_record_indices[elig] = r;
         elig++;
         if(S2B_IsInRange(t, g_s2b_protocol.development_from, g_s2b_protocol.development_to))
            elig_dev++;
         else if(S2B_IsInRange(t, g_s2b_protocol.oos_from, g_s2b_protocol.oos_to))
            elig_oos++;
      }
      else
      {
         excl++;
      }
   }
   ArrayResize(g_s2b_protocol.eligible_record_indices, elig);
   g_s2b_protocol.protocol_record_count    = protocol_total;
   g_s2b_protocol.development_record_count = dev_total;
   g_s2b_protocol.oos_record_count         = oos_total;
   g_s2b_protocol.eligible_count      = elig;
   g_s2b_protocol.excluded_count      = excl;
   g_s2b_protocol.eligible_dev_count  = elig_dev;
   g_s2b_protocol.eligible_oos_count  = elig_oos;
   g_s2b_exclusion.total_excluded = excl;
   g_s2b_exclusion.total_eligible = elig;
   g_s2b_exclusion.eligible_dev   = elig_dev;
   g_s2b_exclusion.eligible_oos   = elig_oos;
   g_s2b_exclusion.scope          = "DEV+OOS";
   g_s2b_protocol.row_mask_hash = S2B_BuildRowMaskHash(
      g_s2b_protocol.eligible_record_indices,
      g_s2b_protocol.eligible_count);
   g_s2b_protocol.protocol_hash = S2B_BuildProtocolHash(g_s2b_protocol);
   if(g_s2b_protocol.eligible_count <= 0)
   {
      g_s2b_protocol.valid = false;
      g_s2b_protocol.invalid_reason = "NO_ELIGIBLE_ROWS_COMMON_POOL";
      S2B_BlockPipeline("NO_ELIGIBLE_ROWS_COMMON_POOL");
      return false;
   }
   if(g_s2b_protocol.eligible_dev_count < g_s2b_protocol.min_train_n)
   {
      g_s2b_protocol.valid = false;
      g_s2b_protocol.invalid_reason = "TOO_FEW_DEV_ROWS_IN_COMMON_MASK";
      S2B_BlockPipeline("TOO_FEW_DEV_ROWS_IN_COMMON_MASK");
      return false;
   }
   g_s2b_protocol.valid = true;
   g_s2b_protocol.invalid_reason = "";
   g_s2b_pipeline_valid = true;
   g_s2b_block_reason = "";
   Print("S2B_InitProtocol: PASS",
         " | ProtocolHash=", g_s2b_protocol.protocol_hash,
         " | DatasetHash=", g_s2b_protocol.dataset_hash,
         " | RowMaskHash=", g_s2b_protocol.row_mask_hash,
         " | Eligible=", g_s2b_protocol.eligible_count,
         " | Excluded=", g_s2b_protocol.excluded_count,
         " | DEV=", g_s2b_protocol.eligible_dev_count,
         " | OOS=", g_s2b_protocol.eligible_oos_count);
   Print("S2B Exclusion Breakdown:",
         " OutsideProtocol=", g_s2b_exclusion.outside_protocol,
         " | InvalidMaxStep=", g_s2b_exclusion.invalid_maxstep,
         " | NoEntryTime=", g_s2b_exclusion.no_entry_time,
         " | MissingFeature=", g_s2b_exclusion.missing_feature_total,
         " | Scope=", g_s2b_exclusion.scope);
   int pf[];
   S2B_FillCompactPoolFeatures(pf);
   for(int k = 0; k < ArraySize(pf) && k < S2B_COMPACT_POOL_SIZE; k++)
   {
      if(g_s2b_exclusion.missing_feature[k] > 0)
         Print("  Missing_", S2B_FeatureName(pf[k]), "=", g_s2b_exclusion.missing_feature[k]);
   }
   ArrayFree(pf);
   return true;
}
//================================================================
// S2B_SelfTest_BaselineViaSearch
// Evaluates the full 8-feature baseline through the same
// S2B_EvaluateSubset_WF() path that candidates use.
// Compares all audit fields against g_s2b_baseline_wf.
// Must pass before any downstream component runs.
//================================================================
bool g_s2b_selftest_passed = false;
string g_s2b_alignment_protocol_fold_status = "UNKNOWN";
string g_s2b_alignment_baseline_eval_status = "UNKNOWN";
string g_s2b_alignment_cross_component_status = "NOT_YET_VERIFIED";
string g_s2b_alignment_selftest_status = "NOT_RUN";
bool S2B_SelfTest_BaselineViaSearch()
{
   g_s2b_selftest_passed = false;
   g_s2b_alignment_selftest_status = "NOT_RUN";
   if(!g_s2b_baseline_wf_valid)
   {
      Print("S2B SelfTest: baseline WF not valid. Cannot test.");
      g_s2b_alignment_selftest_status = "FAIL";
      return false;
   }
   int baseline_feats[8];
   for(int i = 0; i < 8; i++)
      baseline_feats[i] = g_s2b_protocol.compact_pool_feature_idx[i];
   SCompactResult test_res;
   bool ok = S2B_EvaluateSubset_WF(baseline_feats, 8, test_res);
   if(!ok)
   {
      Print("S2B SelfTest: FAIL — evaluator returned false for baseline feature set.");
      g_s2b_alignment_selftest_status = "FAIL";
      S2B_BlockPipeline("SELFTEST_EVALUATOR_FAILED");
      return false;
   }
   bool match = true;
   string mismatches = "";
   if(test_res.protocol_hash != g_s2b_baseline_wf.protocol_hash)
   { match = false; mismatches += "protocol_hash "; }
   if(test_res.fold_hash != g_s2b_baseline_wf.fold_hash)
   { match = false; mismatches += "fold_hash "; }
   if(test_res.dataset_hash != g_s2b_baseline_wf.dataset_hash)
   { match = false; mismatches += "dataset_hash "; }
   if(test_res.row_mask_hash != g_s2b_baseline_wf.row_mask_hash)
   { match = false; mismatches += "row_mask_hash "; }
   if(test_res.feature_hash != g_s2b_baseline_wf.feature_hash)
   { match = false; mismatches += "feature_hash "; }
   if(test_res.valid_primary_folds != g_s2b_baseline_wf.valid_primary_folds)
   { match = false; mismatches += "valid_primary_folds "; }
   for(int f = 0; f < test_res.fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(test_res.fold_train_n[f] != g_s2b_baseline_wf.fold_train_n[f])
      { match = false; mismatches += "fold_train_n[" + IntegerToString(f) + "] "; }
      if(test_res.fold_train_pos[f] != g_s2b_baseline_wf.fold_train_pos[f])
      { match = false; mismatches += "fold_train_pos[" + IntegerToString(f) + "] "; }
      if(test_res.fold_train_neg[f] != g_s2b_baseline_wf.fold_train_neg[f])
      { match = false; mismatches += "fold_train_neg[" + IntegerToString(f) + "] "; }
      if(test_res.fold_val_n[f] != g_s2b_baseline_wf.fold_val_n[f])
      { match = false; mismatches += "fold_val_n[" + IntegerToString(f) + "] "; }
      if(test_res.fold_val_pos[f] != g_s2b_baseline_wf.fold_val_pos[f])
      { match = false; mismatches += "fold_val_pos[" + IntegerToString(f) + "] "; }
      if(test_res.fold_val_neg[f] != g_s2b_baseline_wf.fold_val_neg[f])
      { match = false; mismatches += "fold_val_neg[" + IntegerToString(f) + "] "; }
      if(MathAbs(test_res.fold_auc[f] - g_s2b_baseline_wf.fold_auc[f]) > 0.0001)
      { match = false; mismatches += "fold_auc[" + IntegerToString(f) + "] "; }
      if(MathAbs(test_res.fold_prauc[f] - g_s2b_baseline_wf.fold_prauc[f]) > 0.0001)
      { match = false; mismatches += "fold_prauc[" + IntegerToString(f) + "] "; }
      if(MathAbs(test_res.fold_mcc[f] - g_s2b_baseline_wf.fold_mcc[f]) > 0.0001)
      { match = false; mismatches += "fold_mcc[" + IntegerToString(f) + "] "; }
      if(MathAbs(test_res.fold_recall[f] - g_s2b_baseline_wf.fold_recall[f]) > 0.0001)
      { match = false; mismatches += "fold_recall[" + IntegerToString(f) + "] "; }
      if(MathAbs(test_res.fold_f2[f] - g_s2b_baseline_wf.fold_f2[f]) > 0.0001)
      { match = false; mismatches += "fold_f2[" + IntegerToString(f) + "] "; }
   }
   if(MathAbs(test_res.wf_mean_auc - g_s2b_baseline_wf.mean_auc) > 0.0001)
   { match = false; mismatches += "wf_mean_auc "; }
   if(MathAbs(test_res.wf_worst_auc - g_s2b_baseline_wf.worst_auc) > 0.0001)
   { match = false; mismatches += "wf_worst_auc "; }
   if(MathAbs(test_res.wf_std_auc - g_s2b_baseline_wf.std_auc) > 0.0010)
   { match = false; mismatches += "wf_std_auc "; }
   if(MathAbs(test_res.wf_mean_prauc - g_s2b_baseline_wf.mean_prauc) > 0.0001)
   { match = false; mismatches += "wf_mean_prauc "; }
   if(MathAbs(test_res.wf_mean_mcc - g_s2b_baseline_wf.mean_mcc) > 0.0001)
   { match = false; mismatches += "wf_mean_mcc "; }
   if(MathAbs(test_res.wf_mean_recall - g_s2b_baseline_wf.mean_recall) > 0.0001)
   { match = false; mismatches += "wf_mean_recall "; }
   if(MathAbs(test_res.wf_mean_f2 - g_s2b_baseline_wf.mean_f2) > 0.0001)
   { match = false; mismatches += "wf_mean_f2 "; }
   if(match)
   {
      g_s2b_selftest_passed = true;
      g_s2b_alignment_selftest_status = "PASS";
      Print("S2B SelfTest: PASS — baseline via search path matches baseline via WF path exactly.");
      return true;
   }
   else
   {
      g_s2b_selftest_passed = false;
      g_s2b_alignment_selftest_status = "FAIL";
      Print("S2B SelfTest: ALIGNMENT_ERROR — mismatched fields: ", mismatches);
      S2B_BlockPipeline("SELFTEST_ALIGNMENT_ERROR|" + mismatches);
      return false;
   }
}
struct SS2BFoldDiagnostic
{
   double train_auc;
   double val_auc;
   double train_mean_score_pos;
   double train_mean_score_neg;
   double val_mean_score_pos;
   double val_mean_score_neg;
   double coeff_signs[S2B_COMPACT_POOL_SIZE];
   int    n_coeff;
   void Reset()
   {
      train_auc = 0.0;
      val_auc = 0.0;
      train_mean_score_pos = 0.0;
      train_mean_score_neg = 0.0;
      val_mean_score_pos = 0.0;
      val_mean_score_neg = 0.0;
      n_coeff = 0;
      for(int i = 0; i < S2B_COMPACT_POOL_SIZE; i++)
         coeff_signs[i] = 0.0;
   }
};
//================================================================
// Stage 2B D-1 — Final DEV->OOS Evaluation Metrics (inactive infra)
// INSERTION POINT:
//   After struct SS2BWFMetrics
//================================================================
struct SS2BFinalEvalMetrics
{
   bool     valid;
   string   invalid_reason;
   // Audit identity
   string   protocol_hash;
   string   dataset_hash;
   string   row_mask_hash;
   string   feature_hash;
   string   evaluator_version;
   // Window identity
   string   dev_window_hash;
   string   oos_window_hash;
   string   model_fit_window;
   string   evaluation_window;
   // Model identity
   string   normalization_hash;
   string   model_hash;
   // Feature identity
   string   feature_list;
   int      n_features;
   // Threshold identity
   double   threshold;
   string   threshold_source;
   // Row policy / usage
   string   valid_row_policy;
   bool     oos_used;
   // Windows
   datetime dev_from;
   datetime dev_to;
   datetime oos_from;
   datetime oos_to;
   // DEV stats
   int      dev_n;
   int      dev_pos;
   int      dev_neg;
   double   dev_prevalence;
   double   dev_auc;
   double   dev_prauc;
   double   dev_brier;
   double   dev_mcc;
   double   dev_precision;
   double   dev_recall;
   double   dev_f2;
   double   dev_mean_score_pos;
   double   dev_mean_score_neg;
   // OOS stats
   int      oos_n;
   int      oos_pos;
   int      oos_neg;
   double   oos_prevalence;
   double   oos_auc;
   double   oos_prauc;
   double   oos_brier;
   double   oos_mcc;
   double   oos_precision;
   double   oos_recall;
   double   oos_f2;
   double   oos_mean_score_pos;
   double   oos_mean_score_neg;
   double   oos_pr_lift;
   // Degradation
   double   auc_degradation;
   double   prauc_degradation;
   // Stored trained model params for audit only
   double   intercept;
   double   weights[20];
   double   feat_mean[20];
   double   feat_std[20];
   void Reset()
   {
      valid = false;
      invalid_reason = "";
      protocol_hash = "";
      dataset_hash = "";
      row_mask_hash = "";
      feature_hash = "";
      evaluator_version = "";
      dev_window_hash = "";
      oos_window_hash = "";
      model_fit_window = "";
      evaluation_window = "";
      normalization_hash = "";
      model_hash = "";
      feature_list = "";
      n_features = 0;
      threshold = 0.5;
      threshold_source = "";
      valid_row_policy = "";
      oos_used = false;
      dev_from = 0;
      dev_to   = 0;
      oos_from = 0;
      oos_to   = 0;
      dev_n = 0;
      dev_pos = 0;
      dev_neg = 0;
      dev_prevalence = 0.0;
      dev_auc = 0.0;
      dev_prauc = 0.0;
      dev_brier = 0.0;
      dev_mcc = 0.0;
      dev_precision = 0.0;
      dev_recall = 0.0;
      dev_f2 = 0.0;
      dev_mean_score_pos = 0.0;
      dev_mean_score_neg = 0.0;
      oos_n = 0;
      oos_pos = 0;
      oos_neg = 0;
      oos_prevalence = 0.0;
      oos_auc = 0.0;
      oos_prauc = 0.0;
      oos_brier = 0.0;
      oos_mcc = 0.0;
      oos_precision = 0.0;
      oos_recall = 0.0;
      oos_f2 = 0.0;
      oos_mean_score_pos = 0.0;
      oos_mean_score_neg = 0.0;
      oos_pr_lift = 0.0;
      auc_degradation = 0.0;
      prauc_degradation = 0.0;
      intercept = 0.0;
      for(int i = 0; i < 20; i++)
      {
         weights[i] = 0.0;
         feat_mean[i] = 0.0;
         feat_std[i] = 1.0;
      }
   }
};
// inactive infrastructure globals
SS2BFinalEvalMetrics g_s2b_baseline_final_eval;
SS2BFinalEvalMetrics g_s2b_candidate_final_eval;
bool g_s2b_oos_used_this_run = false;
bool S2B_BuildFolds(SS2BProtocol &proto)
{
   ArrayResize(g_s2b_folds, 0);
   g_s2b_fold_count = 0;
   proto.fold_hash = "";
   if(!proto.valid)
   {
      S2B_BlockPipeline("PROTOCOL_INVALID_BEFORE_FOLD_BUILD");
      return false;
   }
   // Revised Stage2B internal selection folds:
   // Fold 1: Train 2018-2020, Validate 2021
   // Fold 2: Train 2018-2021, Validate 2022
   // Independent OOS 2023 is NOT part of search folds
   ArrayResize(g_s2b_folds, 2);
   for(int i = 0; i < 2; i++) g_s2b_folds[i].Reset();
   g_s2b_folds[0].name       = "WF_F1_Train2018_2020_Val2021";
   g_s2b_folds[0].train_from = proto.development_from;
   g_s2b_folds[0].train_to   = StringToTime("2021.01.01");
   g_s2b_folds[0].val_from   = StringToTime("2021.01.01");
   g_s2b_folds[0].val_to     = StringToTime("2022.01.01");
   g_s2b_folds[0].is_primary = true;
   g_s2b_folds[0].is_warmup  = false;
   g_s2b_folds[1].name       = "WF_F2_Train2018_2021_Val2022";
   g_s2b_folds[1].train_from = proto.development_from;
   g_s2b_folds[1].train_to   = StringToTime("2022.01.01");
   g_s2b_folds[1].val_from   = StringToTime("2022.01.01");
   g_s2b_folds[1].val_to     = proto.development_to; // 2023.01.01
   g_s2b_folds[1].is_primary = true;
   g_s2b_folds[1].is_warmup  = false;
   g_s2b_fold_count = 2;
   // Hard protocol validations
   for(int i = 0; i < g_s2b_fold_count; i++)
   {
      if(!(g_s2b_folds[i].train_from < g_s2b_folds[i].train_to))
      {
         S2B_BlockPipeline("INVALID_FOLD_TRAIN_RANGE_" + IntegerToString(i));
         return false;
      }
      if(!(g_s2b_folds[i].val_from < g_s2b_folds[i].val_to))
      {
         S2B_BlockPipeline("INVALID_FOLD_VAL_RANGE_" + IntegerToString(i));
         return false;
      }
      if(!(g_s2b_folds[i].train_to <= g_s2b_folds[i].val_from))
      {
         S2B_BlockPipeline("TRAIN_VAL_OVERLAP_IN_FOLD_" + IntegerToString(i));
         return false;
      }
      if(!S2B_IsInRange(g_s2b_folds[i].train_from, proto.development_from, proto.oos_to))
      {
         S2B_BlockPipeline("FOLD_TRAIN_FROM_OUTSIDE_PROTOCOL_" + IntegerToString(i));
         return false;
      }
      if(!(g_s2b_folds[i].val_to <= proto.development_to))
      {
         S2B_BlockPipeline("FOLD_VAL_TOUCHES_OOS_" + IntegerToString(i));
         return false;
      }
   }
   proto.fold_hash = S2B_BuildFoldHash(g_s2b_folds, g_s2b_fold_count);
   Print("S2B_BuildFolds: PASS",
         " | FoldHash=", proto.fold_hash,
         " | FoldCount=", g_s2b_fold_count);
   for(int i = 0; i < g_s2b_fold_count; i++)
   {
      Print("  ", g_s2b_folds[i].name,
            " | Train=[", TimeToString(g_s2b_folds[i].train_from, TIME_DATE),
            " -> ", TimeToString(g_s2b_folds[i].train_to, TIME_DATE), ")",
            " | Val=[", TimeToString(g_s2b_folds[i].val_from, TIME_DATE),
            " -> ", TimeToString(g_s2b_folds[i].val_to, TIME_DATE), ")");
   }
   return true;
}
#define S2B_FEATURE_COUNT 21
enum ENUM_S2B_FEATURE
{
   S2B_F_EMA200_DIST_M1 = 0,
   S2B_F_DI_GAP_M5      = 1,
   S2B_F_ADX_SLOPE_H1   = 2,
   S2B_F_ADX_M30        = 3,
   S2B_F_ADX_SLOPE_M15  = 4,
   S2B_F_SIGNAL_CLV     = 5,
   S2B_F_EMA_COMP_H4    = 6,
   S2B_F_OB_DIST_PCT    = 7,
   // expansion
   S2B_F_ADX_SLOPE_M5   = 8,
   S2B_F_DI_GAP_M15     = 9,
   S2B_F_EMA200_DIST_H4 = 10,
   S2B_F_ATR_REGIME_M1  = 11,
   // optional divergence (legacy step4 pool)
   S2B_F_PIVOT_RSI_P3   = 12,
   S2B_F_DIV_PRICE_SLOPE= 13,
   // StopFlag independent pool
   S2B_F_ATR_M5                  = 14,
   S2B_F_ATR_REGIME_M5           = 15,
   S2B_F_PRICE_DIV_STRENGTH      = 16,
   S2B_F_TICKVOL_RATIO20         = 17,
   S2B_F_TICKVOL_Z20             = 18,
   S2B_F_DIST_PRIOR_DAY_HIGH_ATR = 19,
   S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE = 20
};
string S2B_FeatureName(int idx)
{
   switch(idx)
   {
      case S2B_F_EMA200_DIST_M1:   return "EMA200_Dist_M1";
      case S2B_F_DI_GAP_M5:        return "DI_Gap_M5";
      case S2B_F_ADX_SLOPE_H1:     return "ADX_Slope_H1";
      case S2B_F_ADX_M30:          return "ADX_M30";
      case S2B_F_ADX_SLOPE_M15:    return "ADX_Slope_M15";
      case S2B_F_SIGNAL_CLV:       return "Signal_CLV";
      case S2B_F_EMA_COMP_H4:      return "EMA_Compression_H4";
      case S2B_F_OB_DIST_PCT:      return "OB_DistPct";
      case S2B_F_ADX_SLOPE_M5:     return "ADX_Slope_M5";
      case S2B_F_DI_GAP_M15:       return "DI_Gap_M15";
      case S2B_F_EMA200_DIST_H4:   return "EMA200_Dist_H4";
      case S2B_F_ATR_REGIME_M1:    return "ATR_Regime_M1";
      case S2B_F_PIVOT_RSI_P3:     return "Pivot_RSI_P3";
      case S2B_F_DIV_PRICE_SLOPE:  return "Div_Price_Slope";
      case S2B_F_ATR_M5:                  return "ATR_M5";
      case S2B_F_ATR_REGIME_M5:           return "ATR_Regime_M5";
      case S2B_F_PRICE_DIV_STRENGTH:      return "Price_Div_Strength";
      case S2B_F_TICKVOL_RATIO20:         return "TickVolumeRatio20";
      case S2B_F_TICKVOL_Z20:             return "TickVolumeZScore20";
      case S2B_F_DIST_PRIOR_DAY_HIGH_ATR: return "DistanceToPriorDayHighATR";
      case S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE: return "CloseBackInsidePriorRange";
   }
   return "UNKNOWN";
}
bool S2B_GetFeatureValue(int rec_idx, int feat_idx, double &out)
{
   out = 0.0;
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
      return false;
   SRiskLabRecord rec = g_risklab_records[rec_idx];
   switch(feat_idx)
   {
      case S2B_F_EMA200_DIST_M1:
         out = rec.ema200_dist[TF_IDX_MAIN];
         return (out > 0.0);
      case S2B_F_DI_GAP_M5:
         out = rec.di_gap[TF_IDX_M5];
         return (out >= 0.0);
      case S2B_F_ADX_SLOPE_H1:
         out = rec.adx_slope[TF_IDX_H1];
         return MathIsValidNumber(out);
      case S2B_F_ADX_M30:
         out = rec.adx[TF_IDX_M30];
         return (out > 0.0 && out <= 100.0);
      case S2B_F_ADX_SLOPE_M15:
         out = rec.adx_slope[TF_IDX_M15];
         return MathIsValidNumber(out);
      case S2B_F_SIGNAL_CLV:
         out = rec.signal_clv;
         return (out >= 0.0 && out <= 1.0);
      case S2B_F_EMA_COMP_H4:
         out = rec.ema_compression[TF_IDX_H4];
         return (out > 0.0);
      case S2B_F_OB_DIST_PCT:
         out = rec.ob_dist_pct;
         return (out >= 0.0);
      case S2B_F_ADX_SLOPE_M5:
         out = rec.adx_slope[TF_IDX_M5];
         return MathIsValidNumber(out);
      case S2B_F_DI_GAP_M15:
         out = rec.di_gap[TF_IDX_M15];
         return (out >= 0.0);
      case S2B_F_EMA200_DIST_H4:
         out = rec.ema200_dist[TF_IDX_H4];
         return (out > 0.0);
      case S2B_F_ATR_REGIME_M1:
         out = rec.atr_regime[TF_IDX_MAIN];
         return (out > 0.0);
      case S2B_F_ATR_M5:
         out = rec.atr[TF_IDX_M5];
         return (out > 0.0);
      case S2B_F_ATR_REGIME_M5:
         out = rec.atr_regime[TF_IDX_M5];
         return (out > 0.0);
      case S2B_F_PIVOT_RSI_P3:
      case S2B_F_DIV_PRICE_SLOPE:
      case S2B_F_PRICE_DIV_STRENGTH:
      case S2B_F_TICKVOL_RATIO20:
      case S2B_F_TICKVOL_Z20:
      case S2B_F_DIST_PRIOR_DAY_HIGH_ATR:
      case S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE:
      {
         int si = RL_FindSnapshotBySetupId_ForRL(rec.setup_id);
         if(si < 0 || si >= g_snapshot_count)
            return false;
         if(feat_idx == S2B_F_PIVOT_RSI_P3)
         {
            out = g_snapshots[si].pivot_rsi_p3;
            return (out > 0.0 && out <= 100.0);
         }
         if(feat_idx == S2B_F_DIV_PRICE_SLOPE)
         {
            out = g_snapshots[si].div_price_slope;
            return MathIsValidNumber(out);
         }
         if(feat_idx == S2B_F_PRICE_DIV_STRENGTH)
         {
            out = g_snapshots[si].price_div_strength;
            return MathIsValidNumber(out);
         }
         if(feat_idx == S2B_F_TICKVOL_RATIO20)
         {
            out = g_snapshots[si].tick_volume_ratio_20;
            return MathIsValidNumber(out);
         }
         if(feat_idx == S2B_F_TICKVOL_Z20)
         {
            out = g_snapshots[si].tick_volume_zscore_20;
            return MathIsValidNumber(out);
         }
         if(feat_idx == S2B_F_DIST_PRIOR_DAY_HIGH_ATR)
         {
            out = g_snapshots[si].distance_to_prior_day_high_atr;
            return MathIsValidNumber(out);
         }
         if(feat_idx == S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE)
         {
            out = g_snapshots[si].close_back_inside_prior_range ? 1.0 : 0.0;
            return true;
         }
         return false;
      }
   }
   return false;
}
//================================================================
// Stage 2B — Model Layer (Phase 1: HitStep4Plus)
//================================================================
// ====== Structs ======
struct SStage2B_ModelParams
{
   string model_name;
   string target_name;
   int    n_features;
   int    feature_idx[20];   // S2B feature indices
   double intercept;
   double weights[20];
   double feat_mean[20];
   double feat_std[20];
   double dev_auc;
   double oos_auc;
   double dev_brier;
   double oos_brier;
   double best_threshold;
   int    n_dev;
   int    n_oos;
   int    n_pos_dev;
   int    n_pos_oos;
   bool   trained;
   void Reset()
   {
      model_name = "";
      target_name = "";
      n_features = 0;
      intercept = 0.0;
      dev_auc = oos_auc = 0.5;
      dev_brier = oos_brier = 0.25;
      best_threshold = 0.5;
      n_dev = n_oos = n_pos_dev = n_pos_oos = 0;
      trained = false;
      for(int i = 0; i < 20; i++)
      {
         feature_idx[i] = -1;
         weights[i]     = 0.0;
         feat_mean[i]   = 0.0;
         feat_std[i]    = 1.0;
      }
   }
};
// Global models
SStage2B_ModelParams g_s2b_step4;
SStage2B_ModelParams g_s2b_stop;
SStage2B_ModelParams g_s2b_deepstop;
// ====== Helper: sigmoid ======
double S2B_Sigmoid(double z)
{
   if(z >  20.0) return 1.0;
   if(z < -20.0) return 0.0;
   return 1.0 / (1.0 + MathExp(-z));
}
// ====== Helper: get feature vector for one record ======
// fvec[] must be pre-allocated to at least mdl.n_features
bool S2B_BuildFeatureVector(int rec_idx,
                            SStage2B_ModelParams &mdl,
                            double &fvec[])
{
   for(int k = 0; k < mdl.n_features; k++)
   {
      double v = 0.0;
      if(!S2B_GetFeatureValue(rec_idx, mdl.feature_idx[k], v))
         return false;
      fvec[k] = v;
   }
   return true;
}
// ====== Compute normalization params from DEV only ======
void S2B_ComputeNormParams(SStage2B_ModelParams &mdl)
{
   int n = mdl.n_features;
   double sums[];
   double sum_sq[];
   int    cnts[];
   ArrayResize(sums,   n);
   ArrayResize(sum_sq, n);
   ArrayResize(cnts,   n);
   ArrayInitialize(sums,   0.0);
   ArrayInitialize(sum_sq, 0.0);
   ArrayInitialize(cnts,   0);
   double fvec[];
   ArrayResize(fvec, n);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_risklab_records[r].is_oos) continue;
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      for(int k = 0; k < n; k++)
      {
         sums[k]   += fvec[k];
         sum_sq[k] += fvec[k] * fvec[k];
         cnts[k]++;
      }
   }
   for(int k = 0; k < n; k++)
   {
      if(cnts[k] < 2)
      {
         mdl.feat_mean[k] = 0.0;
         mdl.feat_std[k]  = 1.0;
         continue;
      }
      double mean = sums[k] / cnts[k];
      double var  = sum_sq[k] / cnts[k] - mean * mean;
      mdl.feat_mean[k] = mean;
      mdl.feat_std[k]  = (var > 1e-12) ? MathSqrt(var) : 1.0;
   }
   ArrayFree(sums);
   ArrayFree(sum_sq);
   ArrayFree(cnts);
   ArrayFree(fvec);
}
// ====== Normalize one vector ======
void S2B_NormalizeVector(double &fvec[],
                         SStage2B_ModelParams &mdl,
                         double &fvec_norm[])
{
   int n = mdl.n_features;
   ArrayResize(fvec_norm, n);
   for(int k = 0; k < n; k++)
   {
      double s = mdl.feat_std[k];
      if(s < 1e-10) s = 1.0;
      fvec_norm[k] = (fvec[k] - mdl.feat_mean[k]) / s;
   }
}
// ====== Get target value ======
int S2B_GetTargetValue(int rec_idx, string target_name)
{
   SRiskLabRecord rec = g_risklab_records[rec_idx];
   if(target_name == "Step4")
      return rec.hit_step4_plus ? 1 : 0;
   if(target_name == "Stop")
      return rec.stop_flag ? 1 : 0;
   if(target_name == "DeepStop")
      return (rec.stop_flag && rec.max_step_reached >= 4) ? 1 : 0;
   return 0;
}
// ====== AUC from predictions ======
double S2B_AUCFromPreds(double &preds[], int &targets[], int n)
{
   if(n < 5) return 0.5;
   int n_pos = 0, n_neg = 0;
   for(int i = 0; i < n; i++)
   {
      if(targets[i] == 1) n_pos++;
      else                n_neg++;
   }
   if(n_pos == 0 || n_neg == 0) return 0.5;
   // Tie-aware AUC (average ranks inside equal-prediction groups).
   int idx[];
   ArrayResize(idx, n);
   for(int i = 0; i < n; i++) idx[i] = i;
   // Shell sort ascending by pred
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp = idx[i];
         int j = i;
         while(j >= gap && preds[idx[j - gap]] > preds[tmp])
         {
            idx[j] = idx[j - gap];
            j -= gap;
         }
         idx[j] = tmp;
      }
      gap /= 2;
   }
   double rank_sum = 0.0;
   int ii = 0;
   while(ii < n)
   {
      int jj = ii;
      while(jj < n - 1 && preds[idx[jj]] == preds[idx[jj + 1]]) jj++;
      double avg_rank = (ii + 1 + jj + 1) / 2.0;
      for(int k = ii; k <= jj; k++)
      {
         if(targets[idx[k]] == 1)
            rank_sum += avg_rank;
      }
      ii = jj + 1;
   }
   double u = rank_sum - (double)n_pos * (n_pos + 1) / 2.0;
   double auc = u / ((double)n_pos * n_neg);
   ArrayFree(idx);
   return auc;
}
// ====== Brier score ======
double S2B_BrierScore(double &preds[], int &targets[], int n)
{
   if(n <= 0) return 0.25;
   double b = 0.0;
   for(int i = 0; i < n; i++)
      b += (preds[i] - targets[i]) * (preds[i] - targets[i]);
   return b / n;
}
// ====== Best threshold (F2 score) ======
double S2B_BestThreshold(double &preds[], int &targets[], int n)
{
   double best_f  = 0.0;
   double best_th = 0.5;
   for(int t = 1; t <= 20; t++)
   {
      double th = t / 21.0;
      int tp=0, fp=0, fn=0;
      for(int i = 0; i < n; i++)
      {
         bool pred_pos = (preds[i] >= th);
         bool act_pos  = (targets[i] == 1);
         if(pred_pos && act_pos)  tp++;
         if(pred_pos && !act_pos) fp++;
         if(!pred_pos && act_pos) fn++;
      }
      double prec = (tp+fp > 0) ? (double)tp/(tp+fp) : 0.0;
      double rec  = (tp+fn > 0) ? (double)tp/(tp+fn) : 0.0;
      // F2: recall more important
      double f2 = (prec+rec > 0) ?
         (5.0 * prec * rec) / (4.0 * prec + rec) : 0.0;
      if(f2 > best_f) { best_f = f2; best_th = th; }
   }
   return best_th;
}
// ================================================================
// S2B_TrainLogistic — core training function
// ================================================================
void S2B_TrainLogistic(SStage2B_ModelParams &mdl,
                       int epochs    = 5000,
                       double lr     = 0.05,
                       double lambda = 0.01)
{
   int n = mdl.n_features;
   // 1) Compute norm params from DEV
   S2B_ComputeNormParams(mdl);
   // 2) Build DEV dataset
   int n_dev_max = g_risklab_count;
   double X_dev[];
   int    Y_dev[];
   ArrayResize(X_dev, n_dev_max * n);
   ArrayResize(Y_dev, n_dev_max);
   int nd = 0;
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      n);
   ArrayResize(fvec_norm, n);
   int pos_cnt = 0, neg_cnt = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_risklab_records[r].is_oos) continue;
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      S2B_NormalizeVector(fvec, mdl, fvec_norm);
      int y = S2B_GetTargetValue(r, mdl.target_name);
      for(int k = 0; k < n; k++)
         X_dev[nd * n + k] = fvec_norm[k];
      Y_dev[nd] = y;
      nd++;
      if(y == 1) pos_cnt++;
      else       neg_cnt++;
   }
   mdl.n_dev     = nd;
   mdl.n_pos_dev = pos_cnt;
   if(nd < 20 || pos_cnt < 5)
   {
      Print("S2B_TrainLogistic: Not enough DEV samples. N=", nd, " Pos=", pos_cnt);
      ArrayFree(X_dev); ArrayFree(Y_dev);
      ArrayFree(fvec);  ArrayFree(fvec_norm);
      return;
   }
   // 3) Class weights
   double w_pos = (neg_cnt > 0 && pos_cnt > 0) ?
      MathMin(20.0, (double)neg_cnt / pos_cnt) : 1.0;
   double w_neg = 1.0;
   // 4) SGD
   mdl.intercept = 0.0;
   for(int k = 0; k < n; k++)
      mdl.weights[k] = 0.0;
   double cur_lr = lr;
   for(int ep = 0; ep < epochs; ep++)
   {
      double g0 = 0.0;
      double gw[];
      ArrayResize(gw, n);
      ArrayInitialize(gw, 0.0);
      for(int i = 0; i < nd; i++)
      {
         double z = mdl.intercept;
         for(int k = 0; k < n; k++)
            z += mdl.weights[k] * X_dev[i * n + k];
         double pred = S2B_Sigmoid(z);
         double err  = pred - Y_dev[i];
         double cw   = (Y_dev[i] == 1) ? w_pos : w_neg;
         err *= cw;
         g0  += err;
         for(int k = 0; k < n; k++)
            gw[k] += err * X_dev[i * n + k];
      }
      double inv_n = cur_lr / nd;
      mdl.intercept -= inv_n * g0;
      for(int k = 0; k < n; k++)
         mdl.weights[k] -= inv_n * (gw[k] + lambda * mdl.weights[k]);
      // LR decay
      if(ep > 0 && ep % 1000 == 0)
         cur_lr *= 0.7;
      ArrayFree(gw);
   }
   // 5) DEV evaluation
   double preds_dev[];
   int    tgts_dev[];
   ArrayResize(preds_dev, nd);
   ArrayResize(tgts_dev,  nd);
   for(int i = 0; i < nd; i++)
   {
      double z = mdl.intercept;
      for(int k = 0; k < n; k++)
         z += mdl.weights[k] * X_dev[i * n + k];
      preds_dev[i] = S2B_Sigmoid(z);
      tgts_dev[i]  = Y_dev[i];
   }
   mdl.dev_auc   = S2B_AUCFromPreds(preds_dev, tgts_dev, nd);
   mdl.dev_brier = S2B_BrierScore(preds_dev, tgts_dev, nd);
   mdl.best_threshold = S2B_BestThreshold(preds_dev, tgts_dev, nd);
   // 6) OOS evaluation
   double preds_oos[];
   int    tgts_oos[];
   ArrayResize(preds_oos, g_risklab_count);
   ArrayResize(tgts_oos,  g_risklab_count);
   int no = 0;
   int oos_pos = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      S2B_NormalizeVector(fvec, mdl, fvec_norm);
      double z = mdl.intercept;
      for(int k = 0; k < n; k++)
         z += mdl.weights[k] * fvec_norm[k];
      preds_oos[no] = S2B_Sigmoid(z);
      tgts_oos[no]  = S2B_GetTargetValue(r, mdl.target_name);
      if(tgts_oos[no] == 1) oos_pos++;
      no++;
   }
   mdl.n_oos     = no;
   mdl.n_pos_oos = oos_pos;
   mdl.oos_auc   = S2B_AUCFromPreds(preds_oos, tgts_oos, no);
   mdl.oos_brier = S2B_BrierScore(preds_oos, tgts_oos, no);
   mdl.trained = true;
   // Cleanup
   ArrayFree(X_dev);    ArrayFree(Y_dev);
   ArrayFree(fvec);     ArrayFree(fvec_norm);
   ArrayFree(preds_dev);ArrayFree(tgts_dev);
   ArrayFree(preds_oos);ArrayFree(tgts_oos);
}
// ================================================================
// S2B_ExportTrainingReport — TXT report
// ================================================================
void S2B_ExportTrainingReport(SStage2B_ModelParams &mdl)
{
   string fn = "Stage2B_" + mdl.target_name + "_Report_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create Stage2B report: ", fn);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2B MODEL REPORT\n");
   FileWriteString(h, "Model   : " + mdl.model_name + "\n");
   FileWriteString(h, "Target  : " + mdl.target_name + "\n");
   FileWriteString(h, "Symbol  : " + _Symbol + "\n");
   FileWriteString(h, "Time    : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   // Samples
   FileWriteString(h, "\n[SAMPLES]\n" + sep);
   FileWriteString(h, StringFormat("  DEV     : %d  (Pos=%d  Neg=%d  Rate=%.1f%%)\n",
      mdl.n_dev, mdl.n_pos_dev, mdl.n_dev - mdl.n_pos_dev,
      (mdl.n_dev > 0 ? mdl.n_pos_dev * 100.0 / mdl.n_dev : 0)));
   FileWriteString(h, StringFormat("  OOS     : %d  (Pos=%d  Neg=%d  Rate=%.1f%%)\n",
      mdl.n_oos, mdl.n_pos_oos, mdl.n_oos - mdl.n_pos_oos,
      (mdl.n_oos > 0 ? mdl.n_pos_oos * 100.0 / mdl.n_oos : 0)));
   // Performance
   FileWriteString(h, "\n[PERFORMANCE]\n" + sep);
   FileWriteString(h, StringFormat("  DEV AUC   : %.4f\n", mdl.dev_auc));
   FileWriteString(h, StringFormat("  OOS AUC   : %.4f\n", mdl.oos_auc));
   FileWriteString(h, StringFormat("  Decay     : %.4f  (DEV-OOS)\n", mdl.dev_auc - mdl.oos_auc));
   FileWriteString(h, StringFormat("  DEV Brier : %.4f\n", mdl.dev_brier));
   FileWriteString(h, StringFormat("  OOS Brier : %.4f\n", mdl.oos_brier));
   FileWriteString(h, StringFormat("  Best Thr  : %.3f  (from DEV F2)\n", mdl.best_threshold));
   // Stability label
   double decay = mdl.dev_auc - mdl.oos_auc;
   string stab = "";
   if(mdl.oos_auc > mdl.dev_auc + 0.02)       stab = "IMPROVING";
   else if(MathAbs(decay) <= 0.03)             stab = "STABLE";
   else if(MathAbs(decay) <= 0.08)             stab = "MILD_DEGRADATION";
   else                                         stab = "UNSTABLE";
   FileWriteString(h, "  Stability : " + stab + "\n");
   // Verdict
   string verdict = "";
   if(mdl.oos_auc >= 0.65 && MathAbs(decay) <= 0.08)      verdict = "STRONG";
   else if(mdl.oos_auc >= 0.58 && MathAbs(decay) <= 0.12) verdict = "MODERATE";
   else if(mdl.oos_auc >= 0.52)                            verdict = "WEAK";
   else                                                     verdict = "NOISE";
   FileWriteString(h, "  Verdict   : " + verdict + "\n");
   // Feature importance
   FileWriteString(h, "\n[FEATURE COEFFICIENTS]\n" + sep);
   FileWriteString(h, StringFormat("  %-30s  %10s\n", "Feature", "Coefficient"));
   FileWriteString(h, sep);
   FileWriteString(h, StringFormat("  %-30s  %10.6f\n", "Intercept", mdl.intercept));
   for(int k = 0; k < mdl.n_features; k++)
   {
      string fname = S2B_FeatureName(mdl.feature_idx[k]);
      FileWriteString(h, StringFormat("  %-30s  %10.6f  (mean=%.4f std=%.4f)\n",
         fname, mdl.weights[k], mdl.feat_mean[k], mdl.feat_std[k]));
   }
   // Sorted importance
   FileWriteString(h, "\n[FEATURE IMPORTANCE — sorted by |weight|]\n" + sep);
   int ord[];
   ArrayResize(ord, mdl.n_features);
   for(int k = 0; k < mdl.n_features; k++) ord[k] = k;
   // Shell sort descending by |weight|
   int gap = mdl.n_features / 2;
   while(gap > 0)
   {
      for(int i = gap; i < mdl.n_features; i++)
      {
         int tmp = ord[i];
         int j = i;
         while(j >= gap &&
               MathAbs(mdl.weights[ord[j-gap]]) < MathAbs(mdl.weights[tmp]))
         {
            ord[j] = ord[j-gap];
            j -= gap;
         }
         ord[j] = tmp;
      }
      gap /= 2;
   }
   for(int k = 0; k < mdl.n_features; k++)
   {
      int ki = ord[k];
      FileWriteString(h, StringFormat("  %2d. %-30s  %+.6f\n",
         k+1, S2B_FeatureName(mdl.feature_idx[ki]), mdl.weights[ki]));
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2B report: ", fn,
         " | DEV_AUC=", DoubleToString(mdl.dev_auc, 4),
         " | OOS_AUC=", DoubleToString(mdl.oos_auc, 4),
         " | Verdict=", verdict);
}
// ================================================================
// S2B_RunAll — اجرای کامل Stage 2B
// ================================================================
void S2B_RunAll()
{
   if(g_risklab_count < 50)
   {
      Print("S2B_RunAll: Not enough records.");
      return;
   }
   Print("=== Stage 2B START ===");
   // ----- 8 Core features برای همه مدل‌ها -----
   int core_feats[8] = {
      S2B_F_EMA200_DIST_M1,
      S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,
      S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15,
      S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,
      S2B_F_OB_DIST_PCT
   };
   // ==================== MODEL 1: Step4 ====================
   g_s2b_step4.Reset();
   g_s2b_step4.model_name  = "Step4_Baseline";
   g_s2b_step4.target_name = "Step4";
   g_s2b_step4.n_features  = 8;
   for(int k = 0; k < 8; k++)
      g_s2b_step4.feature_idx[k] = core_feats[k];
   Print("Training Step4 model...");
   S2B_TrainLogistic(g_s2b_step4, 5000, 0.05, 0.01);
   S2B_ExportTrainingReport(g_s2b_step4);
   // ==================== MODEL 2: Stop ====================
   g_s2b_stop.Reset();
   g_s2b_stop.model_name  = "Stop_Baseline";
   g_s2b_stop.target_name = "Stop";
   g_s2b_stop.n_features  = 8;
   for(int k = 0; k < 8; k++)
      g_s2b_stop.feature_idx[k] = core_feats[k];
   Print("Training Stop model...");
   S2B_TrainLogistic(g_s2b_stop, 5000, 0.05, 0.01);
   S2B_ExportTrainingReport(g_s2b_stop);
   // ==================== MODEL 3: DeepStop ====================
   g_s2b_deepstop.Reset();
   g_s2b_deepstop.model_name  = "DeepStop_Baseline";
   g_s2b_deepstop.target_name = "DeepStop";
   g_s2b_deepstop.n_features  = 8;
   for(int k = 0; k < 8; k++)
      g_s2b_deepstop.feature_idx[k] = core_feats[k];
   Print("Training DeepStop model...");
   S2B_TrainLogistic(g_s2b_deepstop, 5000, 0.05, 0.01);
   S2B_ExportTrainingReport(g_s2b_deepstop);
   Print("=== Stage 2B DONE ===");
   Print("Step4:    DEV=", DoubleToString(g_s2b_step4.dev_auc, 4),
         " OOS=", DoubleToString(g_s2b_step4.oos_auc, 4));
   Print("Stop:     DEV=", DoubleToString(g_s2b_stop.dev_auc, 4),
         " OOS=", DoubleToString(g_s2b_stop.oos_auc, 4));
   Print("DeepStop: DEV=", DoubleToString(g_s2b_deepstop.dev_auc, 4),
         " OOS=", DoubleToString(g_s2b_deepstop.oos_auc, 4));
}
//================================================================
// Stage 2B — Phase 2: Ablation + Expanded + Calibration
//================================================================
// ================================================================
// S2B_TrainLogistic_WithFeatureSet
// مدل logistic با feature set دلخواه — re-usable
// ================================================================
void S2B_TrainLogistic_WithFeatureSet(
   SStage2B_ModelParams &mdl,
   string model_name,
   string target_name,
   int &feat_indices[],
   int n_feat,
   int epochs    = 5000,
   double lr     = 0.05,
   double lambda = 0.01)
{
   mdl.Reset();
   mdl.model_name  = model_name;
   mdl.target_name = target_name;
   mdl.n_features  = n_feat;
   for(int k = 0; k < n_feat; k++)
      mdl.feature_idx[k] = feat_indices[k];
   S2B_TrainLogistic(mdl, epochs, lr, lambda);
}
// ================================================================
// S2B_RunAblation_Step4
// Remove-one-feature ablation for Step4 model
// ================================================================
void S2B_RunAblation_Step4()
{
   Print("=== Step4 Ablation START ===");
   int core_feats[8] = {
      S2B_F_EMA200_DIST_M1,
      S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,
      S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15,
      S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,
      S2B_F_OB_DIST_PCT
   };
   double full_oos_auc = g_s2b_step4.oos_auc;
   double full_dev_auc = g_s2b_step4.dev_auc;
   // Export file
   string fn = "Stage2B_Ablation_Step4_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create ablation CSV");
      return;
   }
   FileWriteString(h, "Removed_Feature,N_Features,DEV_AUC,OOS_AUC,Delta_OOS,Impact\r\n");
   // Row 0: full model
   FileWriteString(h,
      "NONE (Full Model),8," +
      DoubleToString(full_dev_auc, 4) + "," +
      DoubleToString(full_oos_auc, 4) + "," +
      "0.0000,BASELINE\r\n");
   Print("  Full Model: DEV=", DoubleToString(full_dev_auc, 4),
         " OOS=", DoubleToString(full_oos_auc, 4));
   // Remove-one
   for(int remove = 0; remove < 8; remove++)
   {
      int reduced_feats[7];
      int idx = 0;
      for(int k = 0; k < 8; k++)
      {
         if(k == remove) continue;
         reduced_feats[idx++] = core_feats[k];
      }
      string removed_name = S2B_FeatureName(core_feats[remove]);
      SStage2B_ModelParams ablation_mdl;
      S2B_TrainLogistic_WithFeatureSet(
         ablation_mdl,
         "Step4_Without_" + removed_name,
         "Step4",
         reduced_feats, 7,
         5000, 0.05, 0.01);
      double delta = ablation_mdl.oos_auc - full_oos_auc;
      string impact = "NEGLIGIBLE";
      if(delta < -0.03)      impact = "CRITICAL";
      else if(delta < -0.015) impact = "IMPORTANT";
      else if(delta < -0.005) impact = "USEFUL";
      else if(delta > 0.01)  impact = "REDUNDANT";
      FileWriteString(h,
         EscapeCSV(removed_name) + ",7," +
         DoubleToString(ablation_mdl.dev_auc, 4) + "," +
         DoubleToString(ablation_mdl.oos_auc, 4) + "," +
         DoubleToString(delta, 4) + "," +
         impact + "\r\n");
      Print("  Without ", removed_name, ": OOS=",
            DoubleToString(ablation_mdl.oos_auc, 4),
            " Delta=", DoubleToString(delta, 4),
            " [", impact, "]");
   }
   // === Minimal models: top 3 combinations ===
   FileWriteString(h, "\r\n");
   FileWriteString(h, "Combo_Name,N_Features,DEV_AUC,OOS_AUC,Delta_OOS,Note\r\n");
   // Combo A: top 3 by weight
   {
      int combo_a[3] = {S2B_F_ADX_SLOPE_H1, S2B_F_ADX_SLOPE_M15, S2B_F_DI_GAP_M5};
      SStage2B_ModelParams mdl_a;
      S2B_TrainLogistic_WithFeatureSet(mdl_a, "Top3_ByWeight", "Step4", combo_a, 3);
      double delta = mdl_a.oos_auc - full_oos_auc;
      FileWriteString(h, "Top3_ByWeight,3," +
         DoubleToString(mdl_a.dev_auc,4) + "," +
         DoubleToString(mdl_a.oos_auc,4) + "," +
         DoubleToString(delta,4) + ",ADX_Slope_H1+ADX_Slope_M15+DI_Gap_M5\r\n");
      Print("  Top3_ByWeight: OOS=", DoubleToString(mdl_a.oos_auc, 4),
            " Delta=", DoubleToString(delta, 4));
   }
   // Combo B: mixed family
   {
      int combo_b[3] = {S2B_F_EMA200_DIST_M1, S2B_F_DI_GAP_M5, S2B_F_ADX_SLOPE_H1};
      SStage2B_ModelParams mdl_b;
      S2B_TrainLogistic_WithFeatureSet(mdl_b, "Mixed_Family_3", "Step4", combo_b, 3);
      double delta = mdl_b.oos_auc - full_oos_auc;
      FileWriteString(h, "Mixed_Family_3,3," +
         DoubleToString(mdl_b.dev_auc,4) + "," +
         DoubleToString(mdl_b.oos_auc,4) + "," +
         DoubleToString(delta,4) + ",EMA200_Dist_M1+DI_Gap_M5+ADX_Slope_H1\r\n");
      Print("  Mixed_Family_3: OOS=", DoubleToString(mdl_b.oos_auc, 4),
            " Delta=", DoubleToString(delta, 4));
   }
   // Combo C: top 5
   {
      int combo_c[5] = {S2B_F_ADX_SLOPE_H1, S2B_F_ADX_SLOPE_M15,
                         S2B_F_DI_GAP_M5, S2B_F_OB_DIST_PCT,
                         S2B_F_EMA200_DIST_M1};
      SStage2B_ModelParams mdl_c;
      S2B_TrainLogistic_WithFeatureSet(mdl_c, "Top5_Features", "Step4", combo_c, 5);
      double delta = mdl_c.oos_auc - full_oos_auc;
      FileWriteString(h, "Top5_Features,5," +
         DoubleToString(mdl_c.dev_auc,4) + "," +
         DoubleToString(mdl_c.oos_auc,4) + "," +
         DoubleToString(delta,4) + ",ADX_Slope_H1+M15+DI_Gap_M5+OB+EMA200\r\n");
      Print("  Top5_Features: OOS=", DoubleToString(mdl_c.oos_auc, 4),
            " Delta=", DoubleToString(delta, 4));
   }
   FileFlush(h);
   FileClose(h);
   Print("Step4 Ablation exported: ", fn);
   Print("=== Step4 Ablation DONE ===");
}
// ================================================================
// S2B_TrainLogistic_Step4_Expanded
// 11-feature expanded model
// ================================================================
void S2B_TrainLogistic_Step4_Expanded()
{
   Print("=== Step4 Expanded Model START ===");
   int expanded_feats[11] = {
      S2B_F_EMA200_DIST_M1,
      S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,
      S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15,
      S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,
      S2B_F_OB_DIST_PCT,
      // expansion
      S2B_F_ADX_SLOPE_M5,
      S2B_F_DI_GAP_M15,
      S2B_F_ATR_REGIME_M1
   };
   SStage2B_ModelParams expanded_mdl;
   S2B_TrainLogistic_WithFeatureSet(
      expanded_mdl,
      "Step4_Expanded_11",
      "Step4",
      expanded_feats, 11,
      5000, 0.05, 0.01);
   S2B_ExportTrainingReport(expanded_mdl);
   // Comparison
   string fn = "Stage2B_BaselineVsExpanded_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h != INVALID_HANDLE)
   {
      string line = "================================================================\n";
      string sep  = "----------------------------------------------------------------\n";
      FileWriteString(h, line);
      FileWriteString(h, "BASELINE vs EXPANDED MODEL COMPARISON\n");
      FileWriteString(h, "Symbol: " + _Symbol + "\n");
      FileWriteString(h, "Time  : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
      FileWriteString(h, line);
      FileWriteString(h, "\n[COMPARISON]\n" + sep);
      FileWriteString(h, StringFormat("  %-25s  %10s  %10s  %10s\n",
         "Metric", "Baseline(8)", "Expanded(11)", "Delta"));
      FileWriteString(h, sep);
      FileWriteString(h, StringFormat("  %-25s  %10.4f  %10.4f  %+10.4f\n",
         "DEV AUC", g_s2b_step4.dev_auc, expanded_mdl.dev_auc,
         expanded_mdl.dev_auc - g_s2b_step4.dev_auc));
      FileWriteString(h, StringFormat("  %-25s  %10.4f  %10.4f  %+10.4f\n",
         "OOS AUC", g_s2b_step4.oos_auc, expanded_mdl.oos_auc,
         expanded_mdl.oos_auc - g_s2b_step4.oos_auc));
      FileWriteString(h, StringFormat("  %-25s  %10.4f  %10.4f  %+10.4f\n",
         "DEV Brier", g_s2b_step4.dev_brier, expanded_mdl.dev_brier,
         expanded_mdl.dev_brier - g_s2b_step4.dev_brier));
      FileWriteString(h, StringFormat("  %-25s  %10.4f  %10.4f  %+10.4f\n",
         "OOS Brier", g_s2b_step4.oos_brier, expanded_mdl.oos_brier,
         expanded_mdl.oos_brier - g_s2b_step4.oos_brier));
      double oos_delta = expanded_mdl.oos_auc - g_s2b_step4.oos_auc;
      string decision = "KEEP_BASELINE";
      if(oos_delta >= 0.02)       decision = "UPGRADE_TO_EXPANDED";
      else if(oos_delta >= 0.005) decision = "MARGINAL_IMPROVEMENT";
      else if(oos_delta > -0.01)  decision = "NO_DIFFERENCE";
      else                        decision = "EXPANSION_HURTS";
      FileWriteString(h, "\n[DECISION]\n" + sep);
      FileWriteString(h, "  OOS Delta  : " + DoubleToString(oos_delta, 4) + "\n");
      FileWriteString(h, "  Decision   : " + decision + "\n");
      if(decision == "UPGRADE_TO_EXPANDED")
         FileWriteString(h, "  → Use 11-feature model.\n");
      else if(decision == "EXPANSION_HURTS")
         FileWriteString(h, "  → Extra features add noise. Keep 8-feature baseline.\n");
      else
         FileWriteString(h, "  → Keep 8-feature baseline (simpler, equally good).\n");
      FileWriteString(h, "\n" + line);
      FileFlush(h);
      FileClose(h);
      Print("Baseline vs Expanded: ", fn);
   }
   Print("  Baseline OOS=", DoubleToString(g_s2b_step4.oos_auc, 4),
         " | Expanded OOS=", DoubleToString(expanded_mdl.oos_auc, 4),
         " | Delta=", DoubleToString(expanded_mdl.oos_auc - g_s2b_step4.oos_auc, 4));
   Print("=== Step4 Expanded Model DONE ===");
}
// ================================================================
// S2B_BuildCalibrationBins
// 10-bin calibration for any model
// ================================================================
void S2B_BuildCalibrationBins(SStage2B_ModelParams &mdl,
                              string output_label)
{
   if(!mdl.trained)
   {
      Print("S2B_Calibration: Model not trained.");
      return;
   }
   Print("=== Calibration for ", mdl.model_name, " ===");
   int n_feat = mdl.n_features;
   double fvec[];
   double fvec_norm[];
   ArrayResize(fvec,      n_feat);
   ArrayResize(fvec_norm, n_feat);
   // bin arrays — DEV
   double dev_bin_sum_pred[10];
   double dev_bin_sum_actual[10];
   int    dev_bin_count[10];
   ArrayInitialize(dev_bin_sum_pred,   0.0);
   ArrayInitialize(dev_bin_sum_actual, 0.0);
   ArrayInitialize(dev_bin_count,      0);
   // bin arrays — OOS
   double oos_bin_sum_pred[10];
   double oos_bin_sum_actual[10];
   int    oos_bin_count[10];
   ArrayInitialize(oos_bin_sum_pred,   0.0);
   ArrayInitialize(oos_bin_sum_actual, 0.0);
   ArrayInitialize(oos_bin_count,      0);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      S2B_NormalizeVector(fvec, mdl, fvec_norm);
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
         z += mdl.weights[k] * fvec_norm[k];
      double pred = S2B_Sigmoid(z);
      int y = S2B_GetTargetValue(r, mdl.target_name);
      int bin = (int)MathFloor(pred * 10.0);
      if(bin > 9) bin = 9;
      if(bin < 0) bin = 0;
      if(!g_risklab_records[r].is_oos)
      {
         dev_bin_sum_pred[bin]   += pred;
         dev_bin_sum_actual[bin] += y;
         dev_bin_count[bin]++;
      }
      else
      {
         oos_bin_sum_pred[bin]   += pred;
         oos_bin_sum_actual[bin] += y;
         oos_bin_count[bin]++;
      }
   }
   ArrayFree(fvec);
   ArrayFree(fvec_norm);
   // Export
   string fn = "Stage2B_Calibration_" + output_label + "_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE) return;
   FileWriteString(h, "Split,Bin_Low,Bin_High,Pred_Mean,Actual_Rate,Count,Gap\r\n");
   double dev_ece = 0.0;
   int    dev_total = 0;
   double oos_ece = 0.0;
   int    oos_total = 0;
   for(int b = 0; b < 10; b++)
   {
      double lo = b * 0.1;
      double hi = lo + 0.1;
      // DEV
      if(dev_bin_count[b] > 0)
      {
         double pm = dev_bin_sum_pred[b]   / dev_bin_count[b];
         double ar = dev_bin_sum_actual[b] / dev_bin_count[b];
         double gap = pm - ar;
         FileWriteString(h,
            "DEV," + DoubleToString(lo, 1) + "," + DoubleToString(hi, 1) + "," +
            DoubleToString(pm, 4) + "," + DoubleToString(ar, 4) + "," +
            IntegerToString(dev_bin_count[b]) + "," +
            DoubleToString(gap, 4) + "\r\n");
         dev_ece += (double)dev_bin_count[b] * MathAbs(gap);
         dev_total += dev_bin_count[b];
      }
      // OOS
      if(oos_bin_count[b] > 0)
      {
         double pm = oos_bin_sum_pred[b]   / oos_bin_count[b];
         double ar = oos_bin_sum_actual[b] / oos_bin_count[b];
         double gap = pm - ar;
         FileWriteString(h,
            "OOS," + DoubleToString(lo, 1) + "," + DoubleToString(hi, 1) + "," +
            DoubleToString(pm, 4) + "," + DoubleToString(ar, 4) + "," +
            IntegerToString(oos_bin_count[b]) + "," +
            DoubleToString(gap, 4) + "\r\n");
         oos_ece += (double)oos_bin_count[b] * MathAbs(gap);
         oos_total += oos_bin_count[b];
      }
   }
   if(dev_total > 0) dev_ece /= dev_total;
   if(oos_total > 0) oos_ece /= oos_total;
   FileWriteString(h, "\r\nSummary,DEV_ECE," + DoubleToString(dev_ece, 4) +
                      ",OOS_ECE," + DoubleToString(oos_ece, 4) + "\r\n");
   FileFlush(h);
   FileClose(h);
   Print("  Calibration: DEV_ECE=", DoubleToString(dev_ece, 4),
         " OOS_ECE=", DoubleToString(oos_ece, 4));
   Print("  Exported: ", fn);
   // === TXT report ===
   string fn_txt = "Stage2B_Calibration_" + output_label + "_" + _Symbol + ".txt";
   int ht = FileOpen(fn_txt, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(ht == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(ht, line);
   FileWriteString(ht, "STAGE 2B CALIBRATION REPORT\n");
   FileWriteString(ht, "Model  : " + mdl.model_name + "\n");
   FileWriteString(ht, "Target : " + mdl.target_name + "\n");
   FileWriteString(ht, "Symbol : " + _Symbol + "\n");
   FileWriteString(ht, line);
   FileWriteString(ht, "\n[DEV CALIBRATION]\n" + sep);
   FileWriteString(ht, StringFormat("  %-10s  %10s  %10s  %8s  %10s\n",
      "Bin", "PredMean", "ActualRate", "Count", "Gap"));
   FileWriteString(ht, sep);
   for(int b = 0; b < 10; b++)
   {
      if(dev_bin_count[b] > 0)
      {
         double pm = dev_bin_sum_pred[b]   / dev_bin_count[b];
         double ar = dev_bin_sum_actual[b] / dev_bin_count[b];
         FileWriteString(ht, StringFormat("  [%.1f-%.1f]  %10.4f  %10.4f  %8d  %+10.4f\n",
            b*0.1, b*0.1+0.1, pm, ar, dev_bin_count[b], pm - ar));
      }
   }
   FileWriteString(ht, "  DEV ECE = " + DoubleToString(dev_ece, 4) + "\n");
   FileWriteString(ht, "\n[OOS CALIBRATION]\n" + sep);
   FileWriteString(ht, StringFormat("  %-10s  %10s  %10s  %8s  %10s\n",
      "Bin", "PredMean", "ActualRate", "Count", "Gap"));
   FileWriteString(ht, sep);
   for(int b = 0; b < 10; b++)
   {
      if(oos_bin_count[b] > 0)
      {
         double pm = oos_bin_sum_pred[b]   / oos_bin_count[b];
         double ar = oos_bin_sum_actual[b] / oos_bin_count[b];
         FileWriteString(ht, StringFormat("  [%.1f-%.1f]  %10.4f  %10.4f  %8d  %+10.4f\n",
            b*0.1, b*0.1+0.1, pm, ar, oos_bin_count[b], pm - ar));
      }
   }
   FileWriteString(ht, "  OOS ECE = " + DoubleToString(oos_ece, 4) + "\n");
   // Interpretation
   FileWriteString(ht, "\n[INTERPRETATION]\n" + sep);
   string calib_verdict = "";
   if(oos_ece <= 0.02)       calib_verdict = "WELL_CALIBRATED";
   else if(oos_ece <= 0.05)  calib_verdict = "ACCEPTABLE";
   else if(oos_ece <= 0.10)  calib_verdict = "NEEDS_CALIBRATION";
   else                      calib_verdict = "POORLY_CALIBRATED";
   FileWriteString(ht, "  OOS ECE      : " + DoubleToString(oos_ece, 4) + "\n");
   FileWriteString(ht, "  Verdict      : " + calib_verdict + "\n");
   if(calib_verdict == "WELL_CALIBRATED" || calib_verdict == "ACCEPTABLE")
      FileWriteString(ht, "  → Scores can be used as approximate probabilities.\n");
   else
      FileWriteString(ht, "  → Scores should be used as ranking only, not as probabilities.\n");
   FileWriteString(ht, "\n" + line);
   FileFlush(ht);
   FileClose(ht);
   Print("  Calibration TXT: ", fn_txt);
}
// ================================================================
// S2B_RunPhase2 — اجرای کامل Phase 2B.2
// ================================================================
void S2B_RunPhase2()
{
   if(!g_s2b_step4.trained)
   {
      Print("S2B_RunPhase2: Step4 baseline not trained. Run S2B_RunAll() first.");
      return;
   }
   Print("=== Stage 2B Phase 2 START ===");
   // 1) Ablation
   S2B_RunAblation_Step4();
   // 2) Expanded model
   S2B_TrainLogistic_Step4_Expanded();
   // 3) Calibration — Step4
   S2B_BuildCalibrationBins(g_s2b_step4, "Step4");
   // 4) Calibration — Stop
   if(g_s2b_stop.trained)
      S2B_BuildCalibrationBins(g_s2b_stop, "Stop");
   // 5) Calibration — DeepStop
   if(g_s2b_deepstop.trained)
      S2B_BuildCalibrationBins(g_s2b_deepstop, "DeepStop");
   Print("=== Stage 2B Phase 2 DONE ===");
}
//================================================================
// Stage 2B — Phase 3: Correlation + Walk-Forward + Validation
//================================================================
// ================================================================
// S2B_ExportCorrelationMatrix
// Pearson + Spearman correlation between all features (DEV only)
// ================================================================
void S2B_ExportCorrelationMatrix()
{
   Print("=== Correlation Matrix START ===");
   int n_feat = S2B_FEATURE_COUNT;
   if(n_feat <= 0)
   {
      Print("S2B_ExportCorrelationMatrix: invalid feature count.");
      return;
   }
   // Collect DEV feature vectors
   double feat_vals[];
   int n_valid = 0;
   double tmp_fvec[];
   ArrayResize(tmp_fvec, n_feat);
   // First pass: count valid DEV records
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_risklab_records[r].is_oos) continue;
      bool all_ok = true;
      for(int f = 0; f < n_feat; f++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(r, f, v))
         {
            all_ok = false;
            break;
         }
         tmp_fvec[f] = v;
      }
      if(all_ok) n_valid++;
   }
   if(n_valid < 20)
   {
      Print("S2B_ExportCorrelationMatrix: Not enough valid DEV records: ", n_valid);
      ArrayFree(tmp_fvec);
      return;
   }
   // Build matrix: rows=records, cols=features
   ArrayResize(feat_vals, n_valid * n_feat);
   int row = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_risklab_records[r].is_oos) continue;
      bool all_ok = true;
      for(int f = 0; f < n_feat; f++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(r, f, v))
         {
            all_ok = false;
            break;
         }
         tmp_fvec[f] = v;
      }
      if(!all_ok) continue;
      for(int f = 0; f < n_feat; f++)
         feat_vals[row * n_feat + f] = tmp_fvec[f];
      row++;
   }
   n_valid = row;
   if(n_valid < 20)
   {
      Print("S2B_ExportCorrelationMatrix: No enough fully valid rows after materialization: ", n_valid);
      ArrayFree(tmp_fvec);
      ArrayFree(feat_vals);
      return;
   }
   // Compute means
   double means[];
   ArrayResize(means, n_feat);
   ArrayInitialize(means, 0.0);
   for(int i = 0; i < n_valid; i++)
      for(int f = 0; f < n_feat; f++)
         means[f] += feat_vals[i * n_feat + f];
   for(int f = 0; f < n_feat; f++)
      means[f] /= n_valid;
   // Compute std
   double stds[];
   ArrayResize(stds, n_feat);
   ArrayInitialize(stds, 0.0);
   for(int i = 0; i < n_valid; i++)
      for(int f = 0; f < n_feat; f++)
         stds[f] += MathPow(feat_vals[i * n_feat + f] - means[f], 2);
   for(int f = 0; f < n_feat; f++)
      stds[f] = MathSqrt(stds[f] / n_valid);
   // Pearson matrix
   double pearson[];
   ArrayResize(pearson, n_feat * n_feat);
   ArrayInitialize(pearson, 0.0);
   for(int a = 0; a < n_feat; a++)
   {
      for(int b = a; b < n_feat; b++)
      {
         if(a == b)
         {
            pearson[a * n_feat + b] = 1.0;
            continue;
         }
         double num = 0.0;
         for(int i = 0; i < n_valid; i++)
         {
            num += (feat_vals[i * n_feat + a] - means[a]) *
                   (feat_vals[i * n_feat + b] - means[b]);
         }
         double denom = stds[a] * stds[b] * n_valid;
         double r_val = (denom > 1e-10) ? (num / denom) : 0.0;
         r_val = MathMax(-1.0, MathMin(1.0, r_val));
         pearson[a * n_feat + b] = r_val;
         pearson[b * n_feat + a] = r_val;
      }
   }
   // Spearman — convert to ranks first
   double spearman[];
   ArrayResize(spearman, n_feat * n_feat);
   ArrayInitialize(spearman, 0.0);
   // rank matrix
   double rank_mat[];
   ArrayResize(rank_mat, n_valid * n_feat);
   for(int f = 0; f < n_feat; f++)
   {
      double col[];
      ArrayResize(col, n_valid);
      for(int i = 0; i < n_valid; i++)
         col[i] = feat_vals[i * n_feat + f];
      int idx[];
      ArrayResize(idx, n_valid);
      for(int i = 0; i < n_valid; i++) idx[i] = i;
      int gap = n_valid / 2;
      while(gap > 0)
      {
         for(int i = gap; i < n_valid; i++)
         {
            int tmp = idx[i];
            int j = i;
            while(j >= gap && col[idx[j-gap]] > col[tmp])
            {
               idx[j] = idx[j-gap];
               j -= gap;
            }
            idx[j] = tmp;
         }
         gap /= 2;
      }
      for(int i = 0; i < n_valid; i++)
         rank_mat[idx[i] * n_feat + f] = (double)(i + 1);
      ArrayFree(col);
      ArrayFree(idx);
   }
   double rank_means[];
   ArrayResize(rank_means, n_feat);
   ArrayInitialize(rank_means, 0.0);
   for(int i = 0; i < n_valid; i++)
      for(int f = 0; f < n_feat; f++)
         rank_means[f] += rank_mat[i * n_feat + f];
   for(int f = 0; f < n_feat; f++)
      rank_means[f] /= n_valid;
   double rank_stds[];
   ArrayResize(rank_stds, n_feat);
   ArrayInitialize(rank_stds, 0.0);
   for(int i = 0; i < n_valid; i++)
      for(int f = 0; f < n_feat; f++)
         rank_stds[f] += MathPow(rank_mat[i * n_feat + f] - rank_means[f], 2);
   for(int f = 0; f < n_feat; f++)
      rank_stds[f] = MathSqrt(rank_stds[f] / n_valid);
   for(int a = 0; a < n_feat; a++)
   {
      for(int b = a; b < n_feat; b++)
      {
         if(a == b)
         {
            spearman[a * n_feat + b] = 1.0;
            continue;
         }
         double num = 0.0;
         for(int i = 0; i < n_valid; i++)
         {
            num += (rank_mat[i * n_feat + a] - rank_means[a]) *
                   (rank_mat[i * n_feat + b] - rank_means[b]);
         }
         double denom = rank_stds[a] * rank_stds[b] * n_valid;
         double r_val = (denom > 1e-10) ? (num / denom) : 0.0;
         r_val = MathMax(-1.0, MathMin(1.0, r_val));
         spearman[a * n_feat + b] = r_val;
         spearman[b * n_feat + a] = r_val;
      }
   }
   // === Export Pearson CSV ===
   string fn_p = "Stage2B_Correlation_Pearson_" + _Symbol + ".csv";
   int hp = SafeOpenCSV(fn_p);
   if(hp != INVALID_HANDLE)
   {
      string hdr = "Feature";
      for(int f = 0; f < n_feat; f++) hdr += "," + S2B_FeatureName(f);
      FileWriteString(hp, hdr + "\r\n");
      for(int a = 0; a < n_feat; a++)
      {
         string row_s = S2B_FeatureName(a);
         for(int b = 0; b < n_feat; b++)
            row_s += "," + DoubleToString(pearson[a * n_feat + b], 4);
         FileWriteString(hp, row_s + "\r\n");
      }
      FileFlush(hp);
      FileClose(hp);
      Print("  Pearson matrix exported: ", fn_p);
   }
   // === Export Spearman CSV ===
   string fn_s = "Stage2B_Correlation_Spearman_" + _Symbol + ".csv";
   int hs = SafeOpenCSV(fn_s);
   if(hs != INVALID_HANDLE)
   {
      string hdr = "Feature";
      for(int f = 0; f < n_feat; f++) hdr += "," + S2B_FeatureName(f);
      FileWriteString(hs, hdr + "\r\n");
      for(int a = 0; a < n_feat; a++)
      {
         string row_s = S2B_FeatureName(a);
         for(int b = 0; b < n_feat; b++)
            row_s += "," + DoubleToString(spearman[a * n_feat + b], 4);
         FileWriteString(hs, row_s + "\r\n");
      }
      FileFlush(hs);
      FileClose(hs);
      Print("  Spearman matrix exported: ", fn_s);
   }
   // === Collinearity Alert TXT ===
   string fn_alert = "Stage2B_Collinearity_Alert_" + _Symbol + ".txt";
   int ha = FileOpen(fn_alert, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(ha != INVALID_HANDLE)
   {
      string line = "================================================================\n";
      string sep  = "----------------------------------------------------------------\n";
      FileWriteString(ha, line);
      FileWriteString(ha, "FEATURE COLLINEARITY ALERT\n");
      FileWriteString(ha, "Symbol: " + _Symbol + "\n");
      FileWriteString(ha, "N_DEV_Records: " + IntegerToString(n_valid) + "\n");
      FileWriteString(ha, line);
      FileWriteString(ha, "\n[HIGH COLLINEARITY PAIRS — |Pearson| > 0.70]\n" + sep);
      bool any_high = false;
      for(int a = 0; a < n_feat; a++)
      {
         for(int b = a + 1; b < n_feat; b++)
         {
            double p = MathAbs(pearson[a * n_feat + b]);
            double s = MathAbs(spearman[a * n_feat + b]);
            if(p > 0.70)
            {
               string risk = (p > 0.90) ? "SEVERE" : (p > 0.80) ? "HIGH" : "MODERATE";
               FileWriteString(ha, StringFormat(
                  "  %-30s  <->  %-30s  P=%.3f  S=%.3f  [%s]\n",
                  S2B_FeatureName(a), S2B_FeatureName(b), p, s, risk));
               any_high = true;
            }
         }
      }
      if(!any_high)
         FileWriteString(ha, "  No high collinearity pairs found (|Pearson| < 0.70).\n");
      FileWriteString(ha, "\n" + line);
      FileFlush(ha);
      FileClose(ha);
      Print("  Collinearity alert: ", fn_alert);
   }
   ArrayFree(tmp_fvec);
   ArrayFree(feat_vals);
   ArrayFree(means);
   ArrayFree(stds);
   ArrayFree(pearson);
   ArrayFree(rank_mat);
   ArrayFree(rank_means);
   ArrayFree(rank_stds);
   ArrayFree(spearman);
   Print("=== Correlation Matrix DONE ===");
}
//================================================================
// S2B_EvalModelOnSubset — v2
// AUC + PR-AUC + MCC + F2 + Precision + Recall
//================================================================
void S2B_EvalModelOnSubset(SStage2B_ModelParams &mdl,
                           datetime t_from,
                           datetime t_to,
                           double &out_auc,
                           double &out_prauc,
                           double &out_mcc,
                           double &out_prec,
                           double &out_rec,
                           double &out_f2,
                           int &out_n,
                           int &out_n_pos)
{
   out_auc   = 0.5;
   out_prauc = 0.0;
   out_mcc   = 0.0;
   out_prec  = 0.0;
   out_rec   = 0.0;
   out_f2    = 0.0;
   out_n     = 0;
   out_n_pos = 0;
   double preds[];
   int    tgts[];
   ArrayResize(preds, g_risklab_count);
   ArrayResize(tgts,  g_risklab_count);
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      mdl.n_features);
   ArrayResize(fvec_norm, mdl.n_features);
   for(int r = 0; r < g_risklab_count; r++)
   {
      datetime t = g_risklab_records[r].entry_time;
      if(t < t_from || t >= t_to) continue;
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      S2B_NormalizeVector(fvec, mdl, fvec_norm);
      double z = mdl.intercept;
      for(int k = 0; k < mdl.n_features; k++)
         z += mdl.weights[k] * fvec_norm[k];
      preds[out_n] = S2B_Sigmoid(z);
      tgts[out_n]  = S2B_GetTargetValue(r, mdl.target_name);
      if(tgts[out_n] == 1) out_n_pos++;
      out_n++;
   }
   if(out_n < 10 || out_n_pos < 3)
   {
      ArrayFree(preds); ArrayFree(fvec); ArrayFree(fvec_norm); ArrayFree(tgts);
      return;
   }
   ArrayResize(preds, out_n);
   ArrayResize(tgts,  out_n);
   // AUC (ROC)
   out_auc = S2B_AUCFromPreds(preds, tgts, out_n);
   // PR-AUC — Average Precision (area under precision-recall curve)
   // Sort by pred descending
   int idx[];
   ArrayResize(idx, out_n);
   for(int i = 0; i < out_n; i++) idx[i] = i;
   int gap = out_n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < out_n; i++)
      {
         int tmp = idx[i];
         int j = i;
         while(j >= gap && preds[idx[j-gap]] < preds[tmp])
         {
            idx[j] = idx[j-gap];
            j -= gap;
         }
         idx[j] = tmp;
      }
      gap /= 2;
   }
   double ap = 0.0;
   int tp_so_far = 0;
   double prev_rec = 0.0;
   for(int i = 0; i < out_n; i++)
   {
      if(tgts[idx[i]] == 1)
      {
         tp_so_far++;
         double prec_i = (double)tp_so_far / (i + 1);
         double rec_i  = (double)tp_so_far / out_n_pos;
         ap += prec_i * (rec_i - prev_rec);
         prev_rec = rec_i;
      }
   }
   out_prauc = ap;
   ArrayFree(idx);
   // F2 + Precision + Recall at DEV threshold
   double thr = mdl.best_threshold;
   int tp = 0, fp = 0, fn = 0, tn = 0;
   for(int i = 0; i < out_n; i++)
   {
      bool pp = (preds[i] >= thr);
      bool ap2 = (tgts[i] == 1);
      if(pp && ap2)  tp++;
      if(pp && !ap2) fp++;
      if(!pp && ap2) fn++;
      if(!pp && !ap2) tn++;
   }
   out_prec = (tp+fp > 0) ? (double)tp/(tp+fp) : 0.0;
   out_rec  = (tp+fn > 0) ? (double)tp/(tp+fn) : 0.0;
   if(out_prec + out_rec > 0)
      out_f2 = (5.0 * out_prec * out_rec) / (4.0 * out_prec + out_rec);
   // MCC
   double mcc_denom = MathSqrt(
      (double)(tp+fp) * (tp+fn) * (tn+fp) * (tn+fn));
   out_mcc = (mcc_denom > 0.0) ?
      ((double)(tp * tn - fp * fn) / mcc_denom) : 0.0;
   ArrayFree(preds); ArrayFree(tgts);
   ArrayFree(fvec); ArrayFree(fvec_norm);
}
//================================================================
// Compatibility wrapper for old calls
// Old signature: without PR-AUC and MCC
//================================================================
void S2B_EvalModelOnSubset(SStage2B_ModelParams &mdl,
                           datetime t_from,
                           datetime t_to,
                           double &out_auc,
                           double &out_prec,
                           double &out_rec,
                           double &out_f2,
                           int &out_n,
                           int &out_n_pos)
{
   double dummy_prauc = 0.0;
   double dummy_mcc   = 0.0;
   S2B_EvalModelOnSubset(mdl,
                         t_from,
                         t_to,
                         out_auc,
                         dummy_prauc,
                         dummy_mcc,
                         out_prec,
                         out_rec,
                         out_f2,
                         out_n,
                         out_n_pos);
}
// ================================================================
// S2B_TrainOnSubset
// train a fresh model on a time slice
// ================================================================
SStage2B_ModelParams S2B_TrainOnSubset(
   string target_name,
   int &feat_indices[],
   int n_feat,
   datetime t_from,
   datetime t_to,
   int epochs    = 5000,
   double lr     = 0.05,
   double lambda = 0.01)
{
   SStage2B_ModelParams mdl;
   mdl.Reset();
   mdl.model_name  = "WF_Temp";
   mdl.target_name = target_name;
   mdl.n_features  = n_feat;
   for(int k = 0; k < n_feat; k++)
      mdl.feature_idx[k] = feat_indices[k];
   // --- Compute norm params from this train slice ---
   {
      double sums[];
      double sum_sq[];
      int    cnts[];
      ArrayResize(sums,   n_feat);
      ArrayResize(sum_sq, n_feat);
      ArrayResize(cnts,   n_feat);
      ArrayInitialize(sums,   0.0);
      ArrayInitialize(sum_sq, 0.0);
      ArrayInitialize(cnts,   0);
      double fvec[], fvec_norm[];
      ArrayResize(fvec,      n_feat);
      ArrayResize(fvec_norm, n_feat);
      for(int r = 0; r < g_risklab_count; r++)
      {
         datetime t = g_risklab_records[r].entry_time;
         if(t < t_from || t >= t_to) continue;
         if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
         for(int k = 0; k < n_feat; k++)
         {
            sums[k]   += fvec[k];
            sum_sq[k] += fvec[k] * fvec[k];
            cnts[k]++;
         }
      }
      for(int k = 0; k < n_feat; k++)
      {
         if(cnts[k] < 2) { mdl.feat_mean[k]=0; mdl.feat_std[k]=1; continue; }
         double m = sums[k] / cnts[k];
         double v = sum_sq[k] / cnts[k] - m*m;
         mdl.feat_mean[k] = m;
         mdl.feat_std[k]  = (v > 1e-12) ? MathSqrt(v) : 1.0;
      }
      ArrayFree(sums); ArrayFree(sum_sq); ArrayFree(cnts);
      ArrayFree(fvec); ArrayFree(fvec_norm);
   }
   // --- Build training set ---
   double X[];
   int    Y[];
   ArrayResize(X, g_risklab_count * n_feat);
   ArrayResize(Y, g_risklab_count);
   int nd = 0;
   int pos_cnt = 0, neg_cnt = 0;
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      n_feat);
   ArrayResize(fvec_norm, n_feat);
   for(int r = 0; r < g_risklab_count; r++)
   {
      datetime t = g_risklab_records[r].entry_time;
      if(t < t_from || t >= t_to) continue;
      if(!S2B_BuildFeatureVector(r, mdl, fvec)) continue;
      S2B_NormalizeVector(fvec, mdl, fvec_norm);
      int y = S2B_GetTargetValue(r, target_name);
      for(int k = 0; k < n_feat; k++)
         X[nd * n_feat + k] = fvec_norm[k];
      Y[nd] = y;
      nd++;
      if(y==1) pos_cnt++; else neg_cnt++;
   }
   mdl.n_dev = nd;
   mdl.n_pos_dev = pos_cnt;
   if(nd < 20 || pos_cnt < 5)
   {
      ArrayFree(X); ArrayFree(Y);
      ArrayFree(fvec); ArrayFree(fvec_norm);
      return mdl;
   }
   double w_pos = (neg_cnt > 0 && pos_cnt > 0) ?
      MathMin(20.0, (double)neg_cnt / pos_cnt) : 1.0;
   // SGD
   mdl.intercept = 0.0;
   for(int k = 0; k < n_feat; k++) mdl.weights[k] = 0.0;
   double cur_lr = lr;
   for(int ep = 0; ep < epochs; ep++)
   {
      double g0 = 0.0;
      double gw[];
      ArrayResize(gw, n_feat);
      ArrayInitialize(gw, 0.0);
      for(int i = 0; i < nd; i++)
      {
         double z = mdl.intercept;
         for(int k = 0; k < n_feat; k++)
            z += mdl.weights[k] * X[i * n_feat + k];
         double pred = S2B_Sigmoid(z);
         double err  = pred - Y[i];
         double cw   = (Y[i] == 1) ? w_pos : 1.0;
         err *= cw;
         g0  += err;
         for(int k = 0; k < n_feat; k++)
            gw[k] += err * X[i * n_feat + k];
      }
      double inv_n = cur_lr / nd;
      mdl.intercept -= inv_n * g0;
      for(int k = 0; k < n_feat; k++)
         mdl.weights[k] -= inv_n * (gw[k] + lambda * mdl.weights[k]);
      if(ep > 0 && ep % 1000 == 0) cur_lr *= 0.7;
      ArrayFree(gw);
   }
   // Best threshold on train
   double preds_tr[];
   int    tgts_tr[];
   ArrayResize(preds_tr, nd);
   ArrayResize(tgts_tr,  nd);
   for(int i = 0; i < nd; i++)
   {
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
         z += mdl.weights[k] * X[i * n_feat + k];
      preds_tr[i] = S2B_Sigmoid(z);
      tgts_tr[i]  = Y[i];
   }
   mdl.best_threshold = S2B_BestThreshold(preds_tr, tgts_tr, nd);
   mdl.trained = true;
   ArrayFree(X); ArrayFree(Y);
   ArrayFree(fvec); ArrayFree(fvec_norm);
   ArrayFree(preds_tr); ArrayFree(tgts_tr);
   return mdl;
}
// ================================================================
// S2B_RunWalkForward_Step4
// 3-Fold time-based Walk-Forward for Step4 baseline
// ================================================================
void S2B_RunWalkForward_Step4()
{
   Print("=== Walk-Forward Step4 START ===");
   if(g_risklab_count <= 0)
   {
      Print("S2B_RunWalkForward_Step4: no RiskLab records — abort.");
      return;
   }
   // Find date range
   datetime t_min = INT_MAX, t_max = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_risklab_records[r].entry_time < t_min)
         t_min = g_risklab_records[r].entry_time;
      if(g_risklab_records[r].entry_time > t_max)
         t_max = g_risklab_records[r].entry_time;
   }
   long total_secs = (long)(t_max - t_min);
   long fold_secs  = total_secs / 3;
   // 3-Fold expanding window
   datetime fold_starts[4];
   for(int i = 0; i <= 3; i++)
      fold_starts[i] = t_min + (datetime)((long)fold_secs * i);
   // Baseline 8 features
   int core_feats[8] = {
      S2B_F_EMA200_DIST_M1, S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,  S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15, S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,   S2B_F_OB_DIST_PCT
   };
   // Export file
   string fn = "Stage2B_WalkForward_Step4_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create WF report: ", fn);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "WALK-FORWARD VALIDATION — Step4 Baseline\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Method : 3-Fold Expanding Window\n");
   FileWriteString(h, "Range  : " + TimeToString(t_min, TIME_DATE) +
                      " → " + TimeToString(t_max, TIME_DATE) + "\n");
   FileWriteString(h, line);
   double fold_auc[3];
   double fold_prec[3];
   double fold_rec[3];
   double fold_f2[3];
   int    fold_n[3];
   int    fold_pos[3];
   FileWriteString(h, "\n[FOLD RESULTS]\n" + sep);
   for(int fold = 0; fold < 3; fold++)
   {
      datetime train_from = t_min;
      datetime train_to   = fold_starts[fold + 1];
      datetime val_from   = fold_starts[fold + 1];
      datetime val_to     = (fold == 2) ? t_max : fold_starts[fold + 2];
      FileWriteString(h, "\nFold " + IntegerToString(fold + 1) + ":\n");
      FileWriteString(h, "  Train: " + TimeToString(train_from, TIME_DATE) +
                         " → " + TimeToString(train_to, TIME_DATE) + "\n");
      FileWriteString(h, "  Val  : " + TimeToString(val_from, TIME_DATE) +
                         " → " + TimeToString(val_to, TIME_DATE) + "\n");
      // Train model on this fold
      SStage2B_ModelParams fold_mdl = S2B_TrainOnSubset(
         "Step4", core_feats, 8,
         train_from, train_to,
         3000, 0.05, 0.01);
      if(!fold_mdl.trained || fold_mdl.n_pos_dev < 5)
      {
         FileWriteString(h, "  SKIPPED (insufficient train positive samples=" +
                            IntegerToString(fold_mdl.n_pos_dev) + ")\n");
         fold_auc[fold] = 0.5;
         fold_prec[fold] = fold_rec[fold] = fold_f2[fold] = 0.0;
         fold_n[fold] = fold_pos[fold] = 0;
         continue;
      }
      FileWriteString(h, "  Train: N=" + IntegerToString(fold_mdl.n_dev) +
                         " Pos=" + IntegerToString(fold_mdl.n_pos_dev) + "\n");
      // Evaluate on val slice
      S2B_EvalModelOnSubset(fold_mdl,
         val_from, val_to,
         fold_auc[fold], fold_prec[fold],
         fold_rec[fold], fold_f2[fold],
         fold_n[fold], fold_pos[fold]);
      if(fold_n[fold] < 10)
      {
         FileWriteString(h, "  Val: INSUFFICIENT SAMPLES (" +
                            IntegerToString(fold_n[fold]) + ")\n");
         fold_auc[fold] = 0.5;
         continue;
      }
      FileWriteString(h, "  Val : N=" + IntegerToString(fold_n[fold]) +
                         " Pos=" + IntegerToString(fold_pos[fold]) + "\n");
      FileWriteString(h, "  AUC   = " + DoubleToString(fold_auc[fold], 4) + "\n");
      FileWriteString(h, "  Prec  = " + DoubleToString(fold_prec[fold], 4) + "\n");
      FileWriteString(h, "  Rec   = " + DoubleToString(fold_rec[fold], 4) + "\n");
      FileWriteString(h, "  F2    = " + DoubleToString(fold_f2[fold], 4) + "\n");
      Print("  Fold ", fold+1, ": AUC=", DoubleToString(fold_auc[fold], 4),
            " Rec=", DoubleToString(fold_rec[fold], 4),
            " F2=", DoubleToString(fold_f2[fold], 4));
   }
   // Stability summary
   double valid_aucs[];
   int n_valid_folds = 0;
   ArrayResize(valid_aucs, 3);
   for(int f = 0; f < 3; f++)
      if(fold_n[f] >= 10)
         valid_aucs[n_valid_folds++] = fold_auc[f];
   FileWriteString(h, "\n[STABILITY SUMMARY]\n" + sep);
   if(n_valid_folds > 0)
   {
      double auc_sum = 0.0, auc_min = 9999.0, auc_max = -9999.0;
      for(int f = 0; f < n_valid_folds; f++)
      {
         auc_sum += valid_aucs[f];
         if(valid_aucs[f] < auc_min) auc_min = valid_aucs[f];
         if(valid_aucs[f] > auc_max) auc_max = valid_aucs[f];
      }
      double auc_mean = auc_sum / n_valid_folds;
      double auc_var = 0.0;
      for(int f = 0; f < n_valid_folds; f++)
         auc_var += MathPow(valid_aucs[f] - auc_mean, 2);
      double auc_std = (n_valid_folds > 1) ? MathSqrt(auc_var / n_valid_folds) : 0.0;
      FileWriteString(h, StringFormat("  Valid Folds : %d\n", n_valid_folds));
      FileWriteString(h, StringFormat("  Mean AUC   : %.4f\n", auc_mean));
      FileWriteString(h, StringFormat("  Std AUC    : %.4f\n", auc_std));
      FileWriteString(h, StringFormat("  Min AUC    : %.4f\n", auc_min));
      FileWriteString(h, StringFormat("  Max AUC    : %.4f\n", auc_max));
      // Acceptance criteria
      string accept = "ACCEPT";
      string reason = "";
      if(auc_mean < 0.55)
      { accept = "REJECT"; reason = "Mean AUC < 0.55"; }
      else if(auc_min < 0.52)
      { accept = "CAUTION"; reason = "Worst fold < 0.52"; }
      else if(auc_std > 0.04)
      { accept = "CAUTION"; reason = "Std AUC > 0.04 (unstable)"; }
      FileWriteString(h, "  Verdict    : " + accept + "\n");
      if(reason != "")
         FileWriteString(h, "  Reason     : " + reason + "\n");
      // OOS single vs WF comparison
      FileWriteString(h, "\n[COMPARISON: Single OOS vs Walk-Forward]\n" + sep);
      FileWriteString(h, StringFormat("  Single OOS AUC  : %.4f\n", g_s2b_step4.oos_auc));
      FileWriteString(h, StringFormat("  WF Mean AUC     : %.4f\n", auc_mean));
      FileWriteString(h, StringFormat("  Delta           : %+.4f\n", auc_mean - g_s2b_step4.oos_auc));
      if(MathAbs(auc_mean - g_s2b_step4.oos_auc) <= 0.03)
         FileWriteString(h, "  → Consistent. Single OOS result is reliable.\n");
      else if(auc_mean > g_s2b_step4.oos_auc)
         FileWriteString(h, "  → WF better than single OOS — good generalization.\n");
      else
         FileWriteString(h, "  → Single OOS may have been lucky. Use WF mean.\n");
      Print("  WF Summary: Mean=", DoubleToString(auc_mean, 4),
            " Std=", DoubleToString(auc_std, 4),
            " Min=", DoubleToString(auc_min, 4),
            " Verdict=", accept);
   }
   else
   {
      FileWriteString(h, "  Insufficient valid folds for stability assessment.\n");
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(valid_aucs);
   Print("Walk-Forward report: ", fn);
   Print("=== Walk-Forward Step4 DONE ===");
}
// ================================================================
// S2B_RunPhase3 — اجرای کامل Phase 2B.3
// ================================================================
void S2B_RunPhase3()
{
   Print("=== Stage 2B Phase 3 START ===");
   // 1) Correlation Matrix
   S2B_ExportCorrelationMatrix();
   // 2) Walk-Forward
   if(g_s2b_step4.trained)
      S2B_RunWalkForward_Step4();
   else
      Print("S2B_RunPhase3: Step4 not trained. Run S2B_RunAll() first.");
   Print("=== Stage 2B Phase 3 DONE ===");
}
//================================================================
// Stage 2B D-1 Helpers
// INSERTION POINT:
//   After Stage2B helper functions
//   Before any automatic runner / phase function
//================================================================
string S2B_BuildWindowHash(datetime from_t, datetime to_t, string label)
{
   string s = label + "|" + S2B_TimeKey(from_t) + "|" + S2B_TimeKey(to_t);
   return S2B_HashToString(S2B_HashString32(s));
}
string S2B_BuildNormalizationHash(SStage2B_ModelParams &mdl)
{
   string s = "NORM|N=" + IntegerToString(mdl.n_features) + "|";
   for(int k = 0; k < mdl.n_features; k++)
   {
      s += "F=" + S2B_FeatureName(mdl.feature_idx[k]) + "|";
      s += "M=" + DoubleToString(mdl.feat_mean[k], 10) + "|";
      s += "S=" + DoubleToString(mdl.feat_std[k], 10) + "|";
   }
   return S2B_HashToString(S2B_HashString32(s));
}
string S2B_BuildModelHash(SStage2B_ModelParams &mdl)
{
   string s = "MODEL|N=" + IntegerToString(mdl.n_features) + "|";
   s += "I=" + DoubleToString(mdl.intercept, 10) + "|";
   for(int k = 0; k < mdl.n_features; k++)
   {
      s += "F=" + S2B_FeatureName(mdl.feature_idx[k]) + "|";
      s += "W=" + DoubleToString(mdl.weights[k], 10) + "|";
   }
   s += "THR=" + DoubleToString(mdl.best_threshold, 10);
   return S2B_HashToString(S2B_HashString32(s));
}
double S2B_CalcPRLift(double prauc, double prevalence)
{
   if(prevalence <= 0.0) return 0.0;
   return prauc / prevalence;
}
bool S2B_IsSelectedCandidateFeatureHashLocked(int &feat_indices[], int n_feat, string &out_input_hash)
{
   out_input_hash = S2B_BuildFeatureHash(feat_indices, n_feat);
   if(!g_s2b_candidate_selected || !g_s2b_selected_candidate_valid)
      return false;
   return (out_input_hash == g_s2b_selected_candidate_wf.feature_hash);
}
bool S2B_IsCrossComponentAlignmentPassed()
{
   return (g_s2b_alignment_cross_component_status == "PASS");
}
//================================================================
// S2B_EvaluateFinalCandidate_DevToOOS
//
// INACTIVE INFRA ONLY
// - no automatic call sites
// - fail-closed
// - OOS single-use protected
// - fit only on DEV [2018,2023)
// - evaluate only on OOS [2023,2024) without refit
// - no threshold optimization on OOS
//================================================================
bool S2B_EvaluateFinalCandidate_DevToOOS(
   int &feat_indices[],
   int n_feat,
   SS2BFinalEvalMetrics &out)
{
   out.Reset();
   // ------------------------------------------------------------
   // Hard fail-closed pre-gates (BEFORE any OOS access)
   // ------------------------------------------------------------
   if(!g_s2b_selftest_passed)
   {
      out.invalid_reason = "SELFTEST_NOT_PASSED";
      return false;
   }
   if(!S2B_IsCrossComponentAlignmentPassed())
   {
      out.invalid_reason = "CROSS_COMPONENT_ALIGNMENT_NOT_PASSED";
      return false;
   }
   if(!g_s2b_selected_candidate_valid || !g_s2b_candidate_selected)
   {
      out.invalid_reason = "NO_LOCKED_SELECTED_CANDIDATE";
      return false;
   }
   // selected candidate must itself have passed absolute gate
   if(g_s2b_selected_candidate_wf.feature_hash == "" ||
      g_s2b_selected_candidate_wf.valid != true)
   {
      out.invalid_reason = "LOCKED_CANDIDATE_WF_INVALID";
      return false;
   }
   // We additionally require that search path is still valid
   if(!g_s2b_search_allowed || !g_s2b_alignment_valid || !g_s2b_pipeline_valid)
   {
      out.invalid_reason = "PIPELINE_BLOCKED_OR_SEARCH_NOT_ALLOWED";
      return false;
   }
   if(g_s2b_oos_used_this_run)
   {
      out.invalid_reason = "OOS_ALREADY_USED_THIS_RUN";
      return false;
   }
   string input_feature_hash = "";
   if(!S2B_IsSelectedCandidateFeatureHashLocked(feat_indices, n_feat, input_feature_hash))
   {
      out.invalid_reason = "INPUT_FEATURE_HASH_NOT_EQUAL_TO_LOCKED_SELECTED_CANDIDATE";
      return false;
   }
   if(!S2B_EnsureProtocolAndFoldsReady())
   {
      out.invalid_reason = "PROTOCOL_OR_FOLDS_NOT_READY";
      return false;
   }
   if(n_feat <= 0 || n_feat > S2B_COMPACT_POOL_SIZE)
   {
      out.invalid_reason = "INVALID_FEATURE_COUNT";
      return false;
   }
   // ------------------------------------------------------------
   // Metadata
   // ------------------------------------------------------------
   out.protocol_hash = g_s2b_protocol.protocol_hash;
   out.dataset_hash  = g_s2b_protocol.dataset_hash;
   out.row_mask_hash = g_s2b_protocol.row_mask_hash;
   out.feature_hash  = input_feature_hash;
   out.evaluator_version = S2B_EVALUATOR_VERSION;
   out.feature_list = S2B_BuildFeatureListString(feat_indices, n_feat);
   out.n_features   = n_feat;
   out.valid_row_policy = g_s2b_protocol.valid_row_policy;
   out.dev_from = g_s2b_protocol.dev_from;
   out.dev_to   = g_s2b_protocol.dev_to;
   out.oos_from = g_s2b_protocol.oos_from;
   out.oos_to   = g_s2b_protocol.oos_to;
   out.dev_window_hash = S2B_BuildWindowHash(out.dev_from, out.dev_to, "DEV");
   out.oos_window_hash = S2B_BuildWindowHash(out.oos_from, out.oos_to, "OOS");
   out.model_fit_window = "[" + TimeToString(out.dev_from, TIME_DATE) + " -> " + TimeToString(out.dev_to, TIME_DATE) + ")";
   out.evaluation_window = "[" + TimeToString(out.oos_from, TIME_DATE) + " -> " + TimeToString(out.oos_to, TIME_DATE) + ")";
   out.threshold_source = "DEV_ONLY_F2";
   out.oos_used = false;
   // ------------------------------------------------------------
   // Collect DEV rows from protocol common mask
   // ------------------------------------------------------------
   int dev_rows[];
   int dev_count = S2B_CollectProtocolMaskedRows(out.dev_from, out.dev_to, dev_rows);
   if(dev_count < g_s2b_protocol.min_train_n)
   {
      out.invalid_reason = "INSUFFICIENT_DEV_ROWS";
      ArrayFree(dev_rows);
      return false;
   }
   // ------------------------------------------------------------
   // Fit model on DEV only
   // ------------------------------------------------------------
   SStage2B_ModelParams mdl;
   bool trained = S2B_TrainLogistic_OnRows(
      feat_indices,
      n_feat,
      dev_rows,
      dev_count,
      mdl,
      5000, 0.05, 0.01);
   if(!trained || !mdl.trained)
   {
      out.invalid_reason = "DEV_MODEL_FIT_FAILED";
      ArrayFree(dev_rows);
      return false;
   }
   out.intercept = mdl.intercept;
   for(int k = 0; k < mdl.n_features; k++)
   {
      out.weights[k]   = mdl.weights[k];
      out.feat_mean[k] = mdl.feat_mean[k];
      out.feat_std[k]  = mdl.feat_std[k];
   }
   out.threshold = mdl.best_threshold;
   out.normalization_hash = S2B_BuildNormalizationHash(mdl);
   out.model_hash         = S2B_BuildModelHash(mdl);
   // ------------------------------------------------------------
   // Evaluate on DEV (no refit issue here; same fitted model)
   // ------------------------------------------------------------
   double dev_auc=0.5, dev_prauc=0.0, dev_mcc=0.0, dev_prec=0.0, dev_rec=0.0, dev_f2=0.0;
   int dev_n=0, dev_pos=0;
   double dev_mean_pos=0.0, dev_mean_neg=0.0;
   bool dev_eval_ok = S2B_EvalModel_OnRows(
      mdl,
      dev_rows, dev_count,
      dev_auc, dev_prauc, dev_mcc, dev_prec, dev_rec, dev_f2,
      dev_n, dev_pos,
      dev_mean_pos, dev_mean_neg);
   ArrayFree(dev_rows);
   if(!dev_eval_ok || dev_n <= 0)
   {
      out.invalid_reason = "DEV_EVALUATION_FAILED";
      return false;
   }
   out.dev_n  = dev_n;
   out.dev_pos = dev_pos;
   out.dev_neg = dev_n - dev_pos;
   out.dev_prevalence = (dev_n > 0 ? (double)dev_pos / dev_n : 0.0);
   out.dev_auc   = dev_auc;
   out.dev_prauc = dev_prauc;
   out.dev_brier = mdl.dev_brier;
   out.dev_mcc   = dev_mcc;
   out.dev_precision = dev_prec;
   out.dev_recall    = dev_rec;
   out.dev_f2        = dev_f2;
   out.dev_mean_score_pos = dev_mean_pos;
   out.dev_mean_score_neg = dev_mean_neg;
   // ------------------------------------------------------------
   // Collect OOS rows — still BEFORE marking OOS used
   // ------------------------------------------------------------
   int oos_rows[];
   int oos_count = S2B_CollectProtocolMaskedRows(out.oos_from, out.oos_to, oos_rows);
   if(oos_count < g_s2b_protocol.min_val_n)
   {
      out.invalid_reason = "INSUFFICIENT_OOS_ROWS";
      ArrayFree(oos_rows);
      return false;
   }
   int oos_pos_check = 0;
   for(int i = 0; i < oos_count; i++)
      if(S2B_GetStep4TargetAligned(oos_rows[i]) == 1)
         oos_pos_check++;
   if(oos_pos_check < g_s2b_protocol.min_val_pos)
   {
      out.invalid_reason = "INSUFFICIENT_OOS_POSITIVES";
      ArrayFree(oos_rows);
      return false;
   }
   // ------------------------------------------------------------
   // REAL OOS EVALUATION STARTS HERE
   // Only now OOS is considered consumed for this run
   // ------------------------------------------------------------
   g_s2b_oos_used_this_run = true;
   out.oos_used = true;
   double oos_auc=0.5, oos_prauc=0.0, oos_mcc=0.0, oos_prec=0.0, oos_rec=0.0, oos_f2=0.0;
   int oos_n=0, oos_pos=0;
   double oos_mean_pos=0.0, oos_mean_neg=0.0;
   bool oos_eval_ok = S2B_EvalModel_OnRows(
      mdl,
      oos_rows, oos_count,
      oos_auc, oos_prauc, oos_mcc, oos_prec, oos_rec, oos_f2,
      oos_n, oos_pos,
      oos_mean_pos, oos_mean_neg);
   ArrayFree(oos_rows);
   if(!oos_eval_ok || oos_n <= 0)
   {
      out.invalid_reason = "OOS_EVALUATION_FAILED_AFTER_OOS_CONSUMPTION";
      return false;
   }
   out.oos_n   = oos_n;
   out.oos_pos = oos_pos;
   out.oos_neg = oos_n - oos_pos;
   out.oos_prevalence = (oos_n > 0 ? (double)oos_pos / oos_n : 0.0);
   out.oos_auc   = oos_auc;
   out.oos_prauc = oos_prauc;
   out.oos_mcc   = oos_mcc;
   out.oos_precision = oos_prec;
   out.oos_recall    = oos_rec;
   out.oos_f2        = oos_f2;
   out.oos_mean_score_pos = oos_mean_pos;
   out.oos_mean_score_neg = oos_mean_neg;
   // OOS Brier
   // Recompute via direct row loop using same frozen DEV params
   {
      double brier_sum = 0.0;
      int brier_n = 0;
      int tmp_rows[];
      int tmp_n = S2B_CollectProtocolMaskedRows(out.oos_from, out.oos_to, tmp_rows);
      for(int i = 0; i < tmp_n; i++)
      {
         int rec_idx = tmp_rows[i];
         if(rec_idx < 0 || rec_idx >= g_risklab_count)
            continue;
         double z = mdl.intercept;
         bool row_ok = true;
         for(int k = 0; k < mdl.n_features; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, mdl.feature_idx[k], v))
            {
               // Missing feature must never silently produce a wrong
               // probability — exclude the whole row instead.
               row_ok = false;
               break;
            }
            double s = mdl.feat_std[k];
            if(s < 1e-10) s = 1.0;
            double vn = (v - mdl.feat_mean[k]) / s;
            z += mdl.weights[k] * vn;
         }
         if(!row_ok)
            continue;
         double p = S2B_Sigmoid(z);
         int y = S2B_GetStep4TargetAligned(rec_idx);
         brier_sum += (p - y) * (p - y);
         brier_n++;
      }
      ArrayFree(tmp_rows);
      out.oos_brier = (brier_n > 0 ? brier_sum / brier_n : 0.0);
   }
   out.oos_pr_lift = S2B_CalcPRLift(out.oos_prauc, out.oos_prevalence);
   out.auc_degradation   = out.dev_auc   - out.oos_auc;
   out.prauc_degradation = out.dev_prauc - out.oos_prauc;
   // 1-AUC is diagnostic only; no automatic inversion
   out.valid = true;
   out.invalid_reason = "";
   return true;
}
void S2B_RunWalkForward_Step4_v2()
{
   Print("=== Walk-Forward v2 Step4 START ===");
   bool audit_only = S2B_IsAlignmentAuditOnly();
   g_s2b_baseline_wf_valid = false;
   g_s2b_baseline_wf_mean_auc = 0.0;
   g_s2b_baseline_wf_worst_auc = 0.0;
   g_s2b_baseline_wf_std_auc = 0.0;
   g_s2b_baseline_wf_mean_prauc = 0.0;
   g_s2b_baseline_wf_mean_mcc = 0.0;
   g_s2b_baseline_wf_mean_recall = 0.0;
   g_s2b_baseline_wf_mean_f2 = 0.0;
   g_s2b_baseline_wf.Reset();
   g_s2b_alignment_protocol_fold_status = "PASS";
   g_s2b_alignment_baseline_eval_status = "PASS";
   g_s2b_alignment_cross_component_status = "NOT_YET_VERIFIED";
   g_s2b_alignment_selftest_status = "NOT_RUN";
   if(!S2B_EnsureProtocolAndFoldsReady())
   {
      S2B_BlockPipeline("WFV2_PROTOCOL_OR_FOLDS_NOT_READY");
      g_s2b_alignment_protocol_fold_status = "FAIL";
      Print("ERROR: S2B_RunWalkForward_Step4_v2: protocol/folds not ready.");
      return;
   }
   int baseline_feats[8];
   for(int i = 0; i < 8; i++)
      baseline_feats[i] = g_s2b_protocol.compact_pool_feature_idx[i];
   SCompactResult baseline_res;
   bool ok = S2B_EvaluateSubset_WF(baseline_feats, 8, baseline_res);
   string fn = "Stage2B_WalkForward_v2_Step4_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create WF v2 report.");
      if(!ok)
         S2B_BlockPipeline("WFV2_REPORT_CREATE_FAILED");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "WALK-FORWARD v2 — Step4 Baseline via Unified Evaluator\n");
   FileWriteString(h, "Symbol           : " + _Symbol + "\n");
   FileWriteString(h, "Evaluator        : " + S2B_EVALUATOR_VERSION + "\n");
   FileWriteString(h, "Time             : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   if(audit_only)
   {
      FileWriteString(h, "\n[AUDIT MODE]\n" + sep);
      FileWriteString(h, "ALIGNMENT AUDIT ONLY\n");
      FileWriteString(h, "DOWNSTREAM BLOCKED\n");
      FileWriteString(h, "FROZEN GENERATED THIS RUN = NO\n");
   }
   FileWriteString(h, "\n[ALIGNMENT STATUS]\n" + sep);
   FileWriteString(h, "Protocol/Fold Alignment      = PASS\n");
   FileWriteString(h, "Baseline Unified Evaluation  = " + string(ok ? "PASS" : "FAIL") + "\n");
   FileWriteString(h, "Cross-component Alignment    = NOT YET VERIFIED\n");
   FileWriteString(h, "\n[PROTOCOL]\n" + sep);
   FileWriteString(h, "ProtocolVersion  : " + g_s2b_protocol.protocol_version + "\n");
   FileWriteString(h, "Target           : HitStep4Plus\n");
   FileWriteString(h, "TargetDefinition : actual_max_step >= 4\n");
   FileWriteString(h, "HigherScoreMeans : Higher probability of positive class\n");
   FileWriteString(h, "DEV Window       : [" + TimeToString(g_s2b_protocol.dev_from, TIME_DATE) +
                         " -> " + TimeToString(g_s2b_protocol.dev_to, TIME_DATE) + ")\n");
   FileWriteString(h, "OOS Window       : [" + TimeToString(g_s2b_protocol.oos_from, TIME_DATE) +
                         " -> " + TimeToString(g_s2b_protocol.oos_to, TIME_DATE) + ")\n");
   FileWriteString(h, "ValidRowPolicy   : " + g_s2b_protocol.valid_row_policy + "\n");
   FileWriteString(h, "ProtocolHash     : " + g_s2b_protocol.protocol_hash + "\n");
   FileWriteString(h, "FoldHash         : " + g_s2b_protocol.fold_hash + "\n");
   FileWriteString(h, "DatasetHash      : " + g_s2b_protocol.dataset_hash + "\n");
   FileWriteString(h, "RowMaskHash      : " + g_s2b_protocol.row_mask_hash + "\n");
   FileWriteString(h, "SnapshotCount    : " + IntegerToString(g_s2b_protocol.snapshot_count) + "\n");
   FileWriteString(h, "RiskLabCount     : " + IntegerToString(g_s2b_protocol.risklab_count) + "\n");
   FileWriteString(h, "EligibleCount    : " + IntegerToString(g_s2b_protocol.eligible_count) + "\n");
   FileWriteString(h, "ExcludedCount    : " + IntegerToString(g_s2b_protocol.excluded_count) + "\n");
   FileWriteString(h, "\n[ROW MASK AUDIT]\n" + sep);
   FileWriteString(h, "Eligible Scope            : " + g_s2b_exclusion.scope + "\n");
   FileWriteString(h, "Excluded_InvalidTarget    : 0\n");
   FileWriteString(h, "Excluded_IncompleteOutcome: 0\n");
   FileWriteString(h, "Excluded_MissingFeature   : " + IntegerToString(g_s2b_exclusion.missing_feature_total) + "\n");
   FileWriteString(h, "Excluded_InvalidNumber    : 0\n");
   FileWriteString(h, "Excluded_OutsideProtocol  : " + IntegerToString(g_s2b_exclusion.outside_protocol) + "\n");
   FileWriteString(h, "Excluded_QC              : 0\n");
   FileWriteString(h, "Excluded_InvalidMaxStep  : " + IntegerToString(g_s2b_exclusion.invalid_maxstep) + "\n");
   FileWriteString(h, "Excluded_NoEntryTime     : " + IntegerToString(g_s2b_exclusion.no_entry_time) + "\n");
   int pf[];
   S2B_FillCompactPoolFeatures(pf);
   for(int k = 0; k < ArraySize(pf) && k < S2B_COMPACT_POOL_SIZE; k++)
   {
      FileWriteString(h, "Missing_" + S2B_FeatureName(pf[k]) + " = " +
                         IntegerToString(g_s2b_exclusion.missing_feature[k]) + "\n");
   }
   ArrayFree(pf);
   FileWriteString(h, "\n[FOLD SOURCE]\n" + sep);
   for(int f = 0; f < g_s2b_fold_count; f++)
   {
      FileWriteString(h,
         "  " + g_s2b_folds[f].name +
         " | Train=[" + TimeToString(g_s2b_folds[f].train_from, TIME_DATE) +
         " -> " + TimeToString(g_s2b_folds[f].train_to, TIME_DATE) + ")" +
         " | Val=[" + TimeToString(g_s2b_folds[f].val_from, TIME_DATE) +
         " -> " + TimeToString(g_s2b_folds[f].val_to, TIME_DATE) + ")" +
         " | Primary=" + (g_s2b_folds[f].is_primary ? "YES" : "NO") + "\n");
   }
   FileWriteString(h, "  Confirmed: No fold validates OOS [2023-01-01, 2024-01-01).\n");
   if(!ok)
   {
      g_s2b_alignment_baseline_eval_status = "FAIL";
      FileWriteString(h, "\n[RESULT]\n" + sep);
      FileWriteString(h, "Baseline evaluation failed.\n");
      FileWriteString(h, "Action: Pipeline blocked.\n");
      if(audit_only)
      {
         FileWriteString(h, "\n[AUDIT STATUS]\n" + sep);
         FileWriteString(h, "ALIGNMENT AUDIT ONLY\n");
         FileWriteString(h, "DOWNSTREAM BLOCKED\n");
         FileWriteString(h, "FROZEN GENERATED THIS RUN = NO\n");
      }
      FileWriteString(h, "\n" + line);
      FileFlush(h);
      FileClose(h);
      S2B_BlockPipeline("WFV2_BASELINE_EVALUATION_FAILED");
      Print("ERROR: Baseline unified evaluator failed.");
      return;
   }
   S2B_CopyCompactResultToWFMetrics(baseline_res, g_s2b_baseline_wf);
   g_s2b_baseline_wf_valid       = g_s2b_baseline_wf.valid;
   g_s2b_baseline_wf_mean_auc    = g_s2b_baseline_wf.mean_auc;
   g_s2b_baseline_wf_worst_auc   = g_s2b_baseline_wf.worst_auc;
   g_s2b_baseline_wf_std_auc     = g_s2b_baseline_wf.std_auc;
   g_s2b_baseline_wf_mean_prauc  = g_s2b_baseline_wf.mean_prauc;
   g_s2b_baseline_wf_mean_mcc    = g_s2b_baseline_wf.mean_mcc;
   g_s2b_baseline_wf_mean_recall = g_s2b_baseline_wf.mean_recall;
   g_s2b_baseline_wf_mean_f2     = g_s2b_baseline_wf.mean_f2;
   FileWriteString(h, "\n[BASELINE FEATURE SET]\n" + sep);
   FileWriteString(h, "FeatureList      : " + baseline_res.feat_names + "\n");
   FileWriteString(h, "FeatureHash      : " + baseline_res.feature_hash + "\n");
   FileWriteString(h, "N_Features       : " + IntegerToString(baseline_res.n_feat) + "\n");
   FileWriteString(h, "\n[FOLD DIAGNOSTIC — BASELINE]\n" + sep);
   FileWriteString(h, StringFormat(
      "  %-28s | %6s | %6s | %6s | %6s | %6s | %6s | %8s | %8s | %8s | %8s | %8s\n",
      "Fold",
      "TrN","TrPos","TrNeg","VaN","VaPos","VaNeg",
      "AUC","PRAUC","MCC","Recall","F2"));
   FileWriteString(h, sep);
   for(int f = 0; f < baseline_res.fold_count && f < S2B_MAX_FOLDS; f++)
   {
      FileWriteString(h, StringFormat(
         "  %-28s | %6d | %6d | %6d | %6d | %6d | %6d | %8.4f | %8.4f | %8.4f | %8.4f | %8.4f\n",
         baseline_res.fold_name[f],
         baseline_res.fold_train_n[f],
         baseline_res.fold_train_pos[f],
         baseline_res.fold_train_neg[f],
         baseline_res.fold_val_n[f],
         baseline_res.fold_val_pos[f],
         baseline_res.fold_val_neg[f],
         baseline_res.fold_auc[f],
         baseline_res.fold_prauc[f],
         baseline_res.fold_mcc[f],
         baseline_res.fold_recall[f],
         baseline_res.fold_f2[f]));
   }
   FileWriteString(h, "\n[FOLD DIAGNOSTIC — EXTENDED]\n" + sep);
   for(int f = 0; f < baseline_res.fold_count && f < S2B_MAX_FOLDS; f++)
   {
      FileWriteString(h, "  " + baseline_res.fold_name[f] + "\n");
      FileWriteString(h, StringFormat("    Train AUC            : %.4f\n", baseline_res.fold_train_auc[f]));
      FileWriteString(h, StringFormat("    Validation AUC       : %.4f\n", baseline_res.fold_auc[f]));
      FileWriteString(h, StringFormat("    Train Mean Score Pos : %.4f\n", baseline_res.fold_train_mean_score_pos[f]));
      FileWriteString(h, StringFormat("    Train Mean Score Neg : %.4f\n", baseline_res.fold_train_mean_score_neg[f]));
      FileWriteString(h, StringFormat("    Val Mean Score Pos   : %.4f\n", baseline_res.fold_val_mean_score_pos[f]));
      FileWriteString(h, StringFormat("    Val Mean Score Neg   : %.4f\n", baseline_res.fold_val_mean_score_neg[f]));
      FileWriteString(h, "    Coefficient Signs    : " + baseline_res.fold_coeff_signs[f] + "\n");
   }
   for(int f = 0; f < baseline_res.fold_count && f < S2B_MAX_FOLDS; f++)
   {
      Print("S2B Baseline Fold Diagnostic | ",
            baseline_res.fold_name[f],
            " | Train N/Pos/Neg=",
            baseline_res.fold_train_n[f], "/",
            baseline_res.fold_train_pos[f], "/",
            baseline_res.fold_train_neg[f],
            " | Val N/Pos/Neg=",
            baseline_res.fold_val_n[f], "/",
            baseline_res.fold_val_pos[f], "/",
            baseline_res.fold_val_neg[f],
            " | TrainAUC=", DoubleToString(baseline_res.fold_train_auc[f], 4),
            " | ValAUC=", DoubleToString(baseline_res.fold_auc[f], 4));
   }
   FileWriteString(h, "\n[WF SUMMARY — PRIMARY FOLDS ONLY]\n" + sep);
   FileWriteString(h, StringFormat("  Valid Primary Folds : %d\n", baseline_res.valid_primary_folds));
   FileWriteString(h, StringFormat("  Mean AUC            : %.4f\n", baseline_res.wf_mean_auc));
   FileWriteString(h, StringFormat("  Worst AUC           : %.4f\n", baseline_res.wf_worst_auc));
   FileWriteString(h, StringFormat("  Std AUC             : %.4f\n", baseline_res.wf_std_auc));
   FileWriteString(h, StringFormat("  Mean PR-AUC         : %.4f\n", baseline_res.wf_mean_prauc));
   FileWriteString(h, StringFormat("  Mean MCC            : %.4f\n", baseline_res.wf_mean_mcc));
   FileWriteString(h, StringFormat("  Mean Recall         : %.4f\n", baseline_res.wf_mean_recall));
   FileWriteString(h, StringFormat("  Mean F2             : %.4f\n", baseline_res.wf_mean_f2));
   FileWriteString(h, StringFormat("  Sign Flips          : %d\n", baseline_res.sign_flip_count));
   FileWriteString(h, StringFormat("  Large Drift         : %d\n", baseline_res.large_drift_count));
   FileWriteString(h, StringFormat("  DEV AUC (2018-2022) : %.4f\n", baseline_res.dev_auc));
   double sanity_auc = baseline_res.wf_mean_auc;
   double sanity_inv = 1.0 - sanity_auc;
   string sanity_note = "OK";
   if(sanity_auc < 0.50 && sanity_inv > sanity_auc)
      sanity_note = "WARNING: score/label direction may be inverted";
   else if(sanity_auc < 0.55)
      sanity_note = "WEAK_SIGNAL";
   else
      sanity_note = "CONSISTENT_WITH_TARGET_DIRECTION";
   FileWriteString(h, "\n[TARGET / AUC SANITY]\n" + sep);
   FileWriteString(h, "  Target                 : HitStep4Plus\n");
   FileWriteString(h, "  Positive Definition    : actual_max_step >= 4\n");
   FileWriteString(h, "  Score Direction        : higher score => higher probability of positive class\n");
   FileWriteString(h, StringFormat("  WF Mean AUC            : %.4f\n", sanity_auc));
   FileWriteString(h, StringFormat("  1 - WF Mean AUC        : %.4f\n", sanity_inv));
   FileWriteString(h, "  Sanity Verdict         : " + sanity_note + "\n");
   FileWriteString(h, "\n[BASELINE STATUS]\n" + sep);
   string auc_verdict   = (baseline_res.wf_mean_auc >= 0.58 ? "GOOD" : (baseline_res.wf_mean_auc >= 0.55 ? "ACCEPTABLE" : "WEAK"));
   string worst_verdict = (baseline_res.wf_worst_auc >= 0.55 ? "STABLE" : (baseline_res.wf_worst_auc >= 0.52 ? "WARNING" : "INVESTIGATE"));
   string std_verdict   = (baseline_res.wf_std_auc <= 0.04 ? "OK" : "HIGH_VARIANCE");
   FileWriteString(h, StringFormat("  Mean AUC verdict      : %s\n", auc_verdict));
   FileWriteString(h, StringFormat("  Worst Fold verdict    : %s\n", worst_verdict));
   FileWriteString(h, StringFormat("  Std verdict           : %s\n", std_verdict));
   string base_gate_reason = "";
   bool base_abs_gate = S2B_PassAbsoluteGate(baseline_res, base_gate_reason);
   FileWriteString(h, "  Baseline Absolute Gate: " + string(base_abs_gate ? "PASS" : "FAIL") + "\n");
   if(!base_abs_gate)
      FileWriteString(h, "  Baseline Gate Reason  : " + base_gate_reason + "\n");
   // Baseline valid but weak does NOT invalidate evaluator or search
   g_s2b_alignment_valid = true;
   g_s2b_search_allowed = true;
   g_s2b_pipeline_valid = true;
   g_s2b_block_reason = "";
   bool self_ok = S2B_SelfTest_BaselineViaSearch();
   FileWriteString(h, "\n[SELF-TEST]\n" + sep);
   FileWriteString(h, "  Baseline-via-Search Self-Test = " + string(self_ok ? "PASS" : "FAIL") + "\n");
   FileWriteString(h, "\n[ALIGNMENT STATUS — FINAL FOR THIS RUN]\n" + sep);
   FileWriteString(h, "  Protocol/Fold Alignment      = PASS\n");
   FileWriteString(h, "  Baseline Unified Evaluation  = PASS\n");
   FileWriteString(h, "  Cross-component Alignment    = NOT YET VERIFIED\n");
   FileWriteString(h, "  Baseline-via-Search SelfTest = " + string(self_ok ? "PASS" : "FAIL") + "\n");
   if(audit_only)
   {
      FileWriteString(h, "\n[AUDIT STATUS]\n" + sep);
      FileWriteString(h, "ALIGNMENT AUDIT ONLY\n");
      FileWriteString(h, "DOWNSTREAM BLOCKED\n");
      FileWriteString(h, "FROZEN GENERATED THIS RUN = NO\n");
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   if(self_ok)
   {
      g_s2b_alignment_protocol_fold_status = "PASS";
      g_s2b_alignment_baseline_eval_status = "PASS";
      g_s2b_alignment_cross_component_status = "NOT_YET_VERIFIED";
   }
   else
   {
      g_s2b_alignment_protocol_fold_status = "FAIL";
      g_s2b_alignment_baseline_eval_status = "FAIL";
      g_s2b_alignment_cross_component_status = "SELFTEST_FAILED";
   }
   Print("Walk-Forward v2 report: ", fn,
         " | Mean=", DoubleToString(g_s2b_baseline_wf_mean_auc, 4),
         " | Worst=", DoubleToString(g_s2b_baseline_wf_worst_auc, 4),
         " | Std=", DoubleToString(g_s2b_baseline_wf_std_auc, 4),
         " | ValidPrimary=", baseline_res.valid_primary_folds,
         " | SelfTest=", (self_ok ? "PASS" : "FAIL"));
   if(audit_only)
   {
      Print("ALIGNMENT AUDIT ONLY");
      Print("DOWNSTREAM BLOCKED");
      Print("FROZEN GENERATED THIS RUN = NO");
   }
   Print("=== Walk-Forward v2 Step4 DONE ===");
}
void S2B_RunWalkForward_Stop_v2()
{
   Print("=== Walk-Forward v2 StopFlag Phase A START ===");
   g_s2b_stop_baseline_wf.Reset();
   g_s2b_stop_search_allowed = false;
   g_s2b_stop_candidate_selected = false;
   g_s2b_stop_oos_allowed = false;
   g_s2b_stop_winner_confirmed = false;
   g_s2b_stop_freeze_allowed = false;
   g_s2b_stop_frozen_generated_this_run = false;
   g_s2b_stop_block_reason = "";
   g_s2b_stop_context.Reset();
   g_s2b_stop_selected_result_index = -1;
   if(!S2B_InitStopEvaluationContext())
   {
      g_s2b_stop_block_reason = "STOP_CONTEXT_INVALID|" + g_s2b_stop_context.invalid_reason;
      Print("STOP_CONTEXT|FAIL|Reason=", g_s2b_stop_block_reason);
      return;
   }
   int baseline_feats[];
   S2B_FillStopCompactPoolFeatures(baseline_feats);
   SCompactResult baseline_res;
   bool ok = S2B_EvaluateSubset_WF_Stop(
      baseline_feats, ArraySize(baseline_feats), baseline_res);
   string fn = "Stage2B_WalkForward_v2_Stop_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(baseline_feats);
      g_s2b_stop_block_reason = "BASELINE_REPORT_OPEN_FAILED";
      return;
   }
   string line = "================================================================\n";
   string sep = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "WALK-FORWARD v2 — StopFlag Baseline — PHASE A DEV ONLY\n");
   FileWriteString(h, "Symbol           : " + _Symbol + "\n");
   FileWriteString(h, "Evaluator        : " + S2B_EVALUATOR_VERSION + "\n");
   FileWriteString(h, "Time             : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[STOP-SPECIFIC EVALUATION CONTEXT]\n" + sep);
   FileWriteString(h, "SharedProtocolHash    : " + g_s2b_stop_context.shared_protocol_hash + "\n");
   FileWriteString(h, "FoldHash              : " + g_s2b_stop_context.fold_hash + "\n");
   FileWriteString(h, "DatasetHash           : " + g_s2b_stop_context.dataset_hash + "\n");
   FileWriteString(h, "TargetName            : " + g_s2b_stop_context.target_name + "\n");
   FileWriteString(h, "TargetDefinition      : " + g_s2b_stop_context.target_definition + "\n");
   FileWriteString(h, "ValidRowPolicy        : " + g_s2b_stop_context.valid_row_policy + "\n");
   FileWriteString(h, "TargetHash            : " + g_s2b_stop_context.target_hash + "\n");
   FileWriteString(h, "PoolHash              : " + g_s2b_stop_context.pool_hash + "\n");
   FileWriteString(h, "RowPolicyHash         : " + g_s2b_stop_context.row_policy_hash + "\n");
   FileWriteString(h, "RowMaskHash           : " + g_s2b_stop_context.row_mask_hash + "\n");
   FileWriteString(h, "EvaluationContextHash : " + g_s2b_stop_context.evaluation_context_hash + "\n");
   FileWriteString(h, "EligibleCount         : " + IntegerToString(g_s2b_stop_context.eligible_count) + "\n");
   FileWriteString(h, "ExcludedCount         : " + IntegerToString(g_s2b_stop_context.excluded_count) + "\n");
   FileWriteString(h, "StopPositives         : " + IntegerToString(g_s2b_stop_context.positive_count) + "\n");
   FileWriteString(h, "StopNegatives         : " + IntegerToString(g_s2b_stop_context.negative_count) + "\n");
   FileWriteString(h, "\n[ROW MASK AUDIT]\n" + sep);
   FileWriteString(h, "OutcomeCompletionRule : final_event non-empty AND max_step_reached in [1,5]\n");
   FileWriteString(h, "MaskWindow            : DEV [2018.01.01,2023.01.01) only\n");
   FileWriteString(h, "ExcludedNoEntryTime   : " + IntegerToString(g_s2b_stop_context.excluded_no_entry_time) + "\n");
   FileWriteString(h, "ExcludedIncomplete    : " + IntegerToString(g_s2b_stop_context.excluded_incomplete_outcome) + "\n");
   FileWriteString(h, "ExcludedInvalidStep   : " + IntegerToString(g_s2b_stop_context.excluded_invalid_maxstep) + "\n");
   FileWriteString(h, "ExcludedMissingTotal  : " + IntegerToString(g_s2b_stop_context.excluded_missing_feature_total) + "\n");
   for(int k = 0; k < g_s2b_stop_context.pool_feature_count; k++)
      FileWriteString(h, "Missing_" + S2B_FeatureName(g_s2b_stop_context.pool_feature_idx[k]) +
                         " : " + IntegerToString(g_s2b_stop_context.excluded_missing_feature[k]) + "\n");
   if(!ok)
   {
      FileWriteString(h, "\n[RESULT]\n" + sep);
      FileWriteString(h, "Stop baseline evaluation failed.\n");
      FileWriteString(h, "\n" + line);
      FileFlush(h);
      FileClose(h);
      ArrayFree(baseline_feats);
      g_s2b_stop_block_reason = "BASELINE_EVAL_FAILED";
      return;
   }
   S2B_CopyCompactResultToWFMetrics_CustomTarget(
      baseline_res, g_s2b_stop_baseline_wf,
      "StopFlag", "rec.stop_flag == true");
   FileWriteString(h, "\n[BASELINE FEATURE SET]\n" + sep);
   FileWriteString(h, "FeatureList      : " + baseline_res.feat_names + "\n");
   FileWriteString(h, "FeatureHash      : " + baseline_res.feature_hash + "\n");
   FileWriteString(h, "N_Features       : " + IntegerToString(baseline_res.n_feat) + "\n");
   FileWriteString(h, "\n[WF SUMMARY — PRIMARY FOLDS ONLY]\n" + sep);
   FileWriteString(h, StringFormat("Valid Primary Folds : %d\n", baseline_res.valid_primary_folds));
   FileWriteString(h, StringFormat("Mean AUC            : %.6f\n", baseline_res.wf_mean_auc));
   FileWriteString(h, StringFormat("Worst AUC           : %.6f\n", baseline_res.wf_worst_auc));
   FileWriteString(h, StringFormat("Std AUC             : %.6f\n", baseline_res.wf_std_auc));
   FileWriteString(h, StringFormat("Mean PR-AUC         : %.6f\n", baseline_res.wf_mean_prauc));
   FileWriteString(h, StringFormat("Mean PR Lift        : %.6f\n", baseline_res.wf_mean_pr_lift));
   FileWriteString(h, StringFormat("Mean MCC            : %.6f\n", baseline_res.wf_mean_mcc));
   FileWriteString(h, StringFormat("Mean Recall         : %.6f\n", baseline_res.wf_mean_recall));
   FileWriteString(h, StringFormat("Mean F2             : %.6f\n", baseline_res.wf_mean_f2));
   FileWriteString(h, StringFormat("Sign Flips          : %d\n", baseline_res.sign_flip_count));
   FileWriteString(h, StringFormat("Large Drift         : %d\n", baseline_res.large_drift_count));
   string gate_reason = "";
   bool gate_pass = S2B_PassAbsoluteGate(baseline_res, gate_reason);
   FileWriteString(h, "\n[BASELINE STATUS]\n" + sep);
   FileWriteString(h, "AbsoluteGate : " + string(gate_pass ? "PASS" : "FAIL") + "\n");
   FileWriteString(h, "GateReason   : " + string(gate_pass ? "PASS" : gate_reason) + "\n");
   S2B_WriteStopFoldDiagnostics(h, baseline_res, "STOP BASELINE");
   g_s2b_stop_search_allowed = true;
   g_s2b_stop_block_reason = "";
   FileWriteString(h, "\n[PHASE A STATUS GUARD]\n" + sep);
   FileWriteString(h, "2023 Status             : Historical Confirmation — Selection-aware validation, not blind OOS — NOT ACCESSED IN PHASE A\n");
   FileWriteString(h, "2024+ Status            : Reserved / Untouched true holdout\n");
   FileWriteString(h, "Threshold Selected      : NO\n");
   FileWriteString(h, "Winner Confirmation     : BLOCKED\n");
   FileWriteString(h, "Frozen Export           : BLOCKED\n");
   FileWriteString(h, "Stage 2C                : BLOCKED\n");
   FileWriteString(h, "Stage 2D                : BLOCKED\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(baseline_feats);
   Print("STOP_BASELINE|PASS|Report=", fn,
         "|MeanAUC=", DoubleToString(g_s2b_stop_baseline_wf.mean_auc, 6),
         "|WorstAUC=", DoubleToString(g_s2b_stop_baseline_wf.worst_auc, 6),
         "|HistoricalConfirmationUsed=NO",
         "|ThresholdSelected=NO");
}
void S2B_RunPhase4()
{
   if(!g_s2b_step4.trained)
   {
      Print("S2B_RunPhase4: Step4 not trained.");
      return;
   }
   Print("=== Stage 2B Phase 4 START ===");
   S2B_RunWalkForward_Step4_v2();
   Print("=== Stage 2B Phase 4 DONE ===");
}
