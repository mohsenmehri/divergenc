//|EARLY TP FAILURE STATS - v7.9|
struct SEarlyTPStats
{
   //Counts
   int total_cases;
   int buy_cases;
   int sell_cases;
   //Sums for averages (at Step1 entry)
   double sum_rsi;
   double sum_adx;
   double sum_cci;
   double sum_atr;
   //Distribution counts
   int rsi_above_70;
   int rsi_above_65;
   int rsi_below_30;
   int rsi_below_35;
   int adx_below_20;
   int adx_below_25;
   int adx_above_30;
   int di_wrong_direction;
   int mtf_conflict;
   //Profit tracking
   double total_final_profit;
   double total_potential_profit;
   int win_count;
   int loss_count;
   //Step distribution
   int reached_step3;
   int reached_step4;
   int reached_step5;
   void Reset()
   {
      total_cases = buy_cases = sell_cases = 0;
      sum_rsi = sum_adx = sum_cci = sum_atr = 0;
      rsi_above_70 = rsi_above_65 = rsi_below_30 = rsi_below_35 = 0;
      adx_below_20 = adx_below_25 = adx_above_30 = 0;
      di_wrong_direction = mtf_conflict = 0;
      total_final_profit = total_potential_profit = 0;
      win_count = loss_count = 0;
      reached_step3 = reached_step4 = reached_step5 = 0;
   }
   //Getters
   double GetAvgRSI() { return (total_cases > 0) ? sum_rsi / total_cases : 0; }
   double GetAvgADX() { return (total_cases > 0) ? sum_adx / total_cases : 0; }
   double GetAvgCCI() { return (total_cases > 0) ? sum_cci / total_cases : 0; }
   double GetAvgATR() { return (total_cases > 0) ? sum_atr / total_cases : 0; }
   double GetPctRSIAbove70() { return (total_cases > 0) ? rsi_above_70 * 100.0 / total_cases : 0; }
   double GetPctRSIAbove65() { return (total_cases > 0) ? rsi_above_65 * 100.0 / total_cases : 0; }
   double GetPctRSIBelow30() { return (total_cases > 0) ? rsi_below_30 * 100.0 / total_cases : 0; }
   double GetPctRSIBelow35() { return (total_cases > 0) ? rsi_below_35 * 100.0 / total_cases : 0; }
   double GetPctADXBelow20() { return (total_cases > 0) ? adx_below_20 * 100.0 / total_cases : 0; }
   double GetPctADXBelow25() { return (total_cases > 0) ? adx_below_25 * 100.0 / total_cases : 0; }
   double GetPctADXAbove30() { return (total_cases > 0) ? adx_above_30 * 100.0 / total_cases : 0; }
   double GetPctDIWrong() { return (total_cases > 0) ? di_wrong_direction * 100.0 / total_cases : 0; }
   double GetPctMTFConflict() { return (total_cases > 0) ? mtf_conflict * 100.0 / total_cases : 0; }
   double GetWinRate() { return (total_cases > 0) ? win_count * 100.0 / total_cases : 0; }
   double GetAvgProfit() { return (total_cases > 0) ? total_final_profit / total_cases : 0; }
   double GetLostProfit() { return total_potential_profit - total_final_profit; }
};
//Global Early TP instances - BUY and SELL separate
SEarlyTPStats g_early_tp_buy;
SEarlyTPStats g_early_tp_sell;
//|Filter Item Structure - v8.2 FIXED WEIGHT|
struct SFilterItem
{
   string indicator;
   string condition;
   double coverage_pct;
   double win_rate;
   int    sample_count;
   double weight;
   void Reset()
   {
      indicator = "";
      condition = "";
      coverage_pct = 0;
      win_rate = 0;
      sample_count = 0;
      weight = 0;
   }
   void Set(string ind, string cond, double cov, double wr, int samples = 0)
   {
      indicator = ind;
      condition = cond;
      coverage_pct = cov;
      win_rate = wr;
      sample_count = samples;
      //? NEW: Weight with log(sample) to prevent small sample overfitting
      double log_factor = 0;
      if(samples > 0)
      {
         log_factor = MathLog(samples + 1) / MathLog(100);
         log_factor = MathMin(1.0, log_factor);  //Cap at 1.0
      }
      //Weight = Coverage × WinRate × LogFactor
      weight = (cov / 100.0) * (wr / 100.0) * log_factor * 100.0;
   }
   string ToString()
   {
      string sig_badge = GetSignificanceBadge(sample_count);
      return indicator + "=" + condition +
             " [Cov:" + DoubleToString(coverage_pct, 1) + "%" +
             " WR:" + DoubleToString(win_rate, 1) + "%" +
             " n=" + IntegerToString(sample_count) + sig_badge +
             " W:" + DoubleToString(weight, 1) + "]";
   }
   //? NEW: Get reliability level
   string GetReliability()
   {
      if(sample_count < 10) return "❌ Unreliable";
      if(sample_count < 30) return "⚠️ Low";
      if(sample_count < 60) return "📊 Moderate";
      return "✅ Good";
   }
};
//==================== REJECT / SHADOW / LIFECYCLE TRACKING ====================
#define MAX_SHADOW_SIGNALS 50000
#define MAX_REJECT_COMBOS  200
#define RJF_COUNT          16
string RejectFilterName(int id);
//-------------------- Reject Filter IDs --------------------
enum ENUM_REJECT_FILTER
{
   RJF_TREND_PULLBACK = 0,
   RJF_ATR_REGIME_M1,
   RJF_SELL_ATR_M1,
   RJF_BUY_H4_ADX,
   RJF_BUY_SIGNAL_BODY,
   RJF_BUY_M5_EMA_COMP,
   RJF_SELL_M15_ATR_REGIME,
   RJF_SELL_H4_CCI,
   RJF_SELL_M30_ATR_STEP4,
   RJF_SELL_M1_EMA200_STEP4,
   RJF_SELL_M1_ADX_STEP4,
   RJF_SELL_H4_ADX_STEP4,
   RJF_PREDICTION_SKIP,
   RJF_STABILITY_GATE,
   RJF_SELL_SIGNAL_CLV,
   RJF_SELL_ATR_REGIME_H1
};
//-------------------- Reject Info --------------------
struct SRejectInfo
{
   bool   flags[RJF_COUNT];
   string details[RJF_COUNT];
   void Reset()
   {
      for(int i = 0; i < RJF_COUNT; i++)
      {
         flags[i] = false;
         details[i] = "";
      }
   }
   void Mark(int id, string detail = "")
   {
      if(id < 0 || id >= RJF_COUNT) return;
      flags[id] = true;
      if(detail != "")
         details[id] = detail;
   }
   bool HasAny()
   {
      for(int i = 0; i < RJF_COUNT; i++)
         if(flags[i]) return true;
      return false;
   }
   string BuildMaskString()
   {
      string out = "";
      for(int i = 0; i < RJF_COUNT; i++)
      {
         if(!flags[i]) continue;
         if(out != "") out += "|";
         out += RejectFilterName(i);
      }
      return out;
   }
   string BuildVerboseString()
   {
      string out = "";
      for(int i = 0; i < RJF_COUNT; i++)
      {
         if(!flags[i]) continue;
         if(out != "") out += " ; ";
         out += RejectFilterName(i);
         if(details[i] != "")
            out += "{" + details[i] + "}";
      }
      return out;
   }
   string GetBool01(int id)
   {
      if(id < 0 || id >= RJF_COUNT) return "0";
      return (flags[id] ? "1" : "0");
   }
};
//-------------------- Trade Lifecycle --------------------
struct STradeLifecycle
{
   int      bars_alive;
   int      ticks_alive;
   double   max_profit_money;
   double   max_loss_money;     // negative or zero
   double   mfe_points;
   double   mae_points;
   void Reset()
   {
      bars_alive = 0;
      ticks_alive = 0;
      max_profit_money = 0.0;
      max_loss_money = 0.0;
      mfe_points = 0.0;
      mae_points = 0.0;
   }
};
