struct SFUUniStat
{
   int    fi;
   int    n_valid;
   double coverage_pct;
   int    pos_valid;
   int    neg_valid;
   double prevalence;
   double mean_pos;
   double mean_neg;
   double std_pos;
   double std_neg;
   double cohens_d;
   double auc;
   double auc_abs_dev;
   double mw_u;
   double mw_z;
   double mw_p;
   int    usable;
   // --- v2: multiplicity control and temporal stability ---
   int    bh_rank;
   double fdr_q_value;
   int    fdr_pass;
   string fdr_class;
   string effect_size_class;
   double auc_fold[3];
   int    dir_fold[3];
   int    folds_evaluated;
   int    fold_dir_consistent;
   int    fold_reversal_flag;
   void Reset()
   {
      fi=-1; n_valid=0; coverage_pct=0.0; pos_valid=0; neg_valid=0; prevalence=0.0;
      mean_pos=0.0; mean_neg=0.0; std_pos=0.0; std_neg=0.0; cohens_d=0.0;
      auc=0.5; auc_abs_dev=0.0; mw_u=0.0; mw_z=0.0; mw_p=1.0; usable=0;
      bh_rank=0; fdr_q_value=1.0; fdr_pass=0; fdr_class="NOT_SIGNIFICANT";
      effect_size_class="NA"; folds_evaluated=0; fold_dir_consistent=0; fold_reversal_flag=0;
      for(int i=0;i<3;i++){ auc_fold[i]=0.5; dir_fold[i]=0; }
   }
};
