//================================================================
// SResearchSummary — Central Summary Layer
//================================================================
struct SResearchSummary
{
   // Data
   int    snap_total;
   int    snap_buy;
   int    snap_sell;
   int    snap_stop;
   int    snap_target;
   int    snap_step4plus;
   int    snap_with_div;
   int    risklab_total;
   double stop_rate_pct;
   double s4_rate_pct;
   // Research
   int    rsch_total;
   int    rsch_strong;
   int    rsch_moderate;
   int    rsch_weak;
   int    rsch_noise;
   string rsch_best_feature;
   double rsch_best_score;
   string rsch_best_verdict;
   // OOS
   int    oos_total;
   int    oos_stable;
   int    oos_mild;
   int    oos_unstable;
   double oos_best_reduction;
   string oos_best_feature;
   double oos_best_auc;
   string oos_best_auc_feature;
   // Threshold
   int    thr_exec_ready;
   int    thr_exec_selected;
   int    thr_stat_selected;
   double thr_best_reduction;
   string thr_best_name;
   string thr_best_rule;
   // Operational
   int    op_total;
   int    op_ready;
   int    op_watchlist;
   int    op_pilot;
   double op_best_score;
   string op_best_feature;
   string op_best_context;
   // Deployment
   int    dep_production_enabled;
   int    dep_pilot;
   int    dep_monitor;
   string dep_best_feature;
   string dep_best_context;
   string dep_best_rule;
   // Pipeline score
   double pipeline_score;
   void Reset()
   {
      snap_total = snap_buy = snap_sell = 0;
      snap_stop = snap_target = snap_step4plus = 0;
      snap_with_div = risklab_total = 0;
      stop_rate_pct = s4_rate_pct = 0.0;
      rsch_total = rsch_strong = rsch_moderate = 0;
      rsch_weak = rsch_noise = 0;
      rsch_best_feature = "N/A";
      rsch_best_score = 0.0;
      rsch_best_verdict = "N/A";
      oos_total = oos_stable = oos_mild = oos_unstable = 0;
      oos_best_reduction = 0.0;
      oos_best_feature = "N/A";
      oos_best_auc = 0.0;
      oos_best_auc_feature = "N/A";
      thr_exec_ready = thr_exec_selected = thr_stat_selected = 0;
      thr_best_reduction = 0.0;
      thr_best_name = "N/A";
      thr_best_rule = "N/A";
      op_total = op_ready = op_watchlist = op_pilot = 0;
      op_best_score = 0.0;
      op_best_feature = "N/A";
      op_best_context = "N/A";
      dep_production_enabled = dep_pilot = dep_monitor = 0;
      dep_best_feature = "N/A";
      dep_best_context = "N/A";
      dep_best_rule = "N/A";
      pipeline_score = 0.0;
   }
};
SResearchSummary g_research_summary;
//================================================================
// Fill Data Summary
//================================================================
void ResearchSummary_FillData()
{
   g_research_summary.snap_total     = g_snapshot_count;
   g_research_summary.risklab_total  = g_risklab_count;
   g_research_summary.snap_buy       = 0;
   g_research_summary.snap_sell      = 0;
   g_research_summary.snap_stop      = 0;
   g_research_summary.snap_target    = 0;
   g_research_summary.snap_step4plus = 0;
   g_research_summary.snap_with_div  = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_snapshots[i].is_bullish) g_research_summary.snap_buy++;
      else                          g_research_summary.snap_sell++;
      string ft = OS_GetFinalToken(g_snapshots[i].close_event);
      if(OS_IsStopToken(ft))   g_research_summary.snap_stop++;
      if(OS_IsTargetToken(ft)) g_research_summary.snap_target++;
      if(g_snapshots[i].actual_max_step >= 4) g_research_summary.snap_step4plus++;
      if(MathAbs(g_snapshots[i].price_div_strength) > 0.0001 ||
         MathAbs(g_snapshots[i].rsi_div_strength)   > 0.0001)
      {
         g_research_summary.snap_with_div++;
      }
   }
   if(g_research_summary.snap_total > 0)
   {
      g_research_summary.stop_rate_pct =
         g_research_summary.snap_stop * 100.0 / g_research_summary.snap_total;
      g_research_summary.s4_rate_pct =
         g_research_summary.snap_step4plus * 100.0 / g_research_summary.snap_total;
   }
   else
   {
      g_research_summary.stop_rate_pct = 0.0;
      g_research_summary.s4_rate_pct   = 0.0;
   }
}
//================================================================
// Fill Research Summary
//================================================================
void ResearchSummary_FillResearch()
{
   g_research_summary.rsch_total        = g_rsch_result_count;
   g_research_summary.rsch_strong       = 0;
   g_research_summary.rsch_moderate     = 0;
   g_research_summary.rsch_weak         = 0;
   g_research_summary.rsch_noise        = 0;
   g_research_summary.rsch_best_feature = "N/A";
   g_research_summary.rsch_best_score   = 0.0;
   g_research_summary.rsch_best_verdict = "N/A";
   for(int i = 0; i < g_rsch_result_count; i++)
   {
      string v = g_rsch_results[i].verdict;
      if(v == "STRONG")        g_research_summary.rsch_strong++;
      else if(v == "MODERATE") g_research_summary.rsch_moderate++;
      else if(v == "WEAK")     g_research_summary.rsch_weak++;
      else                     g_research_summary.rsch_noise++;
      if(g_rsch_results[i].research_score > g_research_summary.rsch_best_score)
      {
         g_research_summary.rsch_best_score   = g_rsch_results[i].research_score;
         g_research_summary.rsch_best_feature = g_rsch_meta[(int)g_rsch_results[i].feature].name;
         g_research_summary.rsch_best_verdict = g_rsch_results[i].verdict;
      }
   }
}
//================================================================
// Fill OOS Summary
//================================================================
void ResearchSummary_FillOOS()
{
   g_research_summary.oos_total          = g_oos_result_count;
   g_research_summary.oos_stable         = 0;
   g_research_summary.oos_mild           = 0;
   g_research_summary.oos_unstable       = 0;
   g_research_summary.oos_best_reduction = 0.0;
   g_research_summary.oos_best_feature   = "N/A";
   g_research_summary.oos_best_auc       = 0.0;
   g_research_summary.oos_best_auc_feature = "N/A";
   for(int i = 0; i < g_oos_result_count; i++)
   {
      string sl = g_oos_results[i].stability_label;
      if(sl == "STABLE")                g_research_summary.oos_stable++;
      else if(sl == "MILD_DEGRADATION") g_research_summary.oos_mild++;
      else                              g_research_summary.oos_unstable++;
      if(g_oos_results[i].oos_stop_removed_pct > g_research_summary.oos_best_reduction)
      {
         g_research_summary.oos_best_reduction = g_oos_results[i].oos_stop_removed_pct;
         g_research_summary.oos_best_feature   = g_oos_results[i].feature_name;
      }
   }
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      if(g_rl_feature_stats[i].split != "OOS") continue;
      if(g_rl_feature_stats[i].auc > g_research_summary.oos_best_auc)
      {
         g_research_summary.oos_best_auc = g_rl_feature_stats[i].auc;
         g_research_summary.oos_best_auc_feature = g_rl_feature_stats[i].feature_name;
         if(g_rl_feature_stats[i].tf_name != "")
            g_research_summary.oos_best_auc_feature += " (" + g_rl_feature_stats[i].tf_name + ")";
      }
   }
}
//================================================================
// Fill Threshold Summary
//================================================================
void ResearchSummary_FillThreshold()
{
   g_research_summary.thr_exec_ready     = 0;
   g_research_summary.thr_exec_selected  = 0;
   g_research_summary.thr_stat_selected  = 0;
   g_research_summary.thr_best_reduction = 0.0;
   g_research_summary.thr_best_name      = "N/A";
   g_research_summary.thr_best_rule      = "N/A";
   for(int i = 0; i < g_sens_threshold_row_count; i++)
   {
      if(g_sens_threshold_rows[i].execution_ready)  g_research_summary.thr_exec_ready++;
      if(g_sens_threshold_rows[i].selected_as_exec) g_research_summary.thr_exec_selected++;
      if(g_sens_threshold_rows[i].selected_as_stat) g_research_summary.thr_stat_selected++;
      if(g_sens_threshold_rows[i].execution_ready &&
         g_sens_threshold_rows[i].oos_reduction > g_research_summary.thr_best_reduction)
      {
         g_research_summary.thr_best_reduction = g_sens_threshold_rows[i].oos_reduction;
         g_research_summary.thr_best_name      = g_sens_threshold_rows[i].family_name;
         g_research_summary.thr_best_rule      =
            (g_sens_threshold_rows[i].direction == "LE" ? "<=" : ">=") +
            DoubleToString(g_sens_threshold_rows[i].threshold, 4);
      }
   }
}
//================================================================
// Fill Deployment Summary
//================================================================
void ResearchSummary_FillDeployment()
{
   g_research_summary.op_total      = g_op_entry_count;
   g_research_summary.op_ready      = 0;
   g_research_summary.op_watchlist  = 0;
   g_research_summary.op_pilot      = 0;
   g_research_summary.op_best_score = 0.0;
   g_research_summary.op_best_feature = "N/A";
   g_research_summary.op_best_context = "N/A";
   g_research_summary.dep_production_enabled = 0;
   g_research_summary.dep_pilot   = 0;
   g_research_summary.dep_monitor = 0;
   g_research_summary.dep_best_feature = "N/A";
   g_research_summary.dep_best_context = "N/A";
   g_research_summary.dep_best_rule    = "N/A";
   for(int i = 0; i < g_op_entry_count; i++)
   {
      string d = g_op_entries[i].deployment;
      if(d == "READY")          g_research_summary.op_ready++;
      else if(d == "WATCHLIST") g_research_summary.op_watchlist++;
      else if(d == "PILOT")     g_research_summary.op_pilot++;
      if(g_op_entries[i].op_score > g_research_summary.op_best_score &&
         d == "READY")
      {
         g_research_summary.op_best_score   = g_op_entries[i].op_score;
         g_research_summary.op_best_feature = g_op_entries[i].feature_name;
         g_research_summary.op_best_context = g_op_entries[i].context;
      }
      if(g_op_entries[i].production_enabled)
      {
         g_research_summary.dep_production_enabled++;
         if(g_research_summary.dep_best_feature == "N/A")
         {
            g_research_summary.dep_best_feature = g_op_entries[i].feature_name;
            g_research_summary.dep_best_context = g_op_entries[i].context;
            g_research_summary.dep_best_rule    = g_op_entries[i].threshold_or_rule;
         }
      }
      else if(d == "PILOT")
         g_research_summary.dep_pilot++;
      else if(d == "WATCHLIST")
         g_research_summary.dep_monitor++;
   }
}
//================================================================
// Pipeline Score
//================================================================
void ResearchSummary_CalcPipelineScore()
{
   double score = 0.0;
   // Data gate (20)
   if(g_research_summary.snap_total >= DE_MIN_SAMPLES_FOR_REPORT &&
      g_research_summary.snap_stop > 0)
   {
      score += (g_research_summary.snap_total == g_research_summary.risklab_total) ? 20.0 : 15.0;
   }
   else if(g_research_summary.snap_total > 0)
      score += 5.0;
   // Research gate (20)
   if(g_research_summary.rsch_strong >= 3)         score += 20.0;
   else if(g_research_summary.rsch_strong >= 1)    score += 16.0;
   else if(g_research_summary.rsch_moderate >= 3)  score += 12.0;
   else if(g_research_summary.rsch_moderate >= 1)  score += 8.0;
   else if(g_research_summary.rsch_total > 0)      score += 3.0;
   // OOS gate (25)
   if(g_research_summary.oos_stable >= 3)         score += 25.0;
   else if(g_research_summary.oos_stable >= 1)    score += 20.0;
   else if(g_research_summary.oos_mild >= 2)      score += 12.0;
   else if(g_research_summary.oos_mild >= 1)      score += 8.0;
   else if(g_research_summary.oos_total > 0)      score += 3.0;
   // Threshold gate (15)
   if(g_research_summary.thr_exec_selected > 0 &&
      g_research_summary.thr_stat_selected > 0)
      score += 15.0;
   else if(g_research_summary.thr_exec_selected > 0)
      score += 10.0;
   else if(g_research_summary.thr_exec_ready > 0)
      score += 5.0;
   // Deployment gate (20)
   if(g_research_summary.dep_production_enabled > 0) score += 20.0;
   else if(g_research_summary.dep_pilot > 0)         score += 12.0;
   else if(g_research_summary.dep_monitor > 0)       score += 6.0;
   g_research_summary.pipeline_score = MathMin(100.0, score);
}
//================================================================
// Dash Gate Status
//================================================================
string DashGateStatus(int gate_num, string &out_reason, string &out_action, bool prev_critical_fail)
{
   out_reason = "";
   out_action = "";
   if(prev_critical_fail)
   {
      out_reason = "Blocked by upstream gate failure";
      return DASH_BLOCKED;
   }
   switch(gate_num)
   {
      case 1:
         if(g_research_summary.snap_total < DE_MIN_SAMPLES_FOR_REPORT)
         {
            out_reason = StringFormat("Snapshots=%d < required %d",
                                      g_research_summary.snap_total, DE_MIN_SAMPLES_FOR_REPORT);
            out_action = StringFormat("Run backtest with >=%d trades.", DE_MIN_SAMPLES_FOR_REPORT);
            return DASH_FAIL;
         }
         if(g_research_summary.snap_stop == 0)
         {
            out_reason = "STOP group = 0";
            out_action = "Check close event mapping and stop detection.";
            return DASH_FAIL;
         }
         if(g_research_summary.snap_total != g_research_summary.risklab_total &&
            g_research_summary.risklab_total > 0)
         {
            out_reason = StringFormat("Snapshot/RiskLab mismatch: %d vs %d",
                                      g_research_summary.snap_total,
                                      g_research_summary.risklab_total);
            out_action = "Check RL_BuildRecord() and FinalizeSnapshot().";
            return DASH_WARN;
         }
         if(g_research_summary.snap_with_div < DE_MIN_DIV_SAMPLES)
         {
            out_reason = StringFormat("Only %d/%d snapshots have divergence features",
                                      g_research_summary.snap_with_div,
                                      DE_MIN_DIV_SAMPLES);
            out_action = "Run fresh backtest with updated snapshot schema.";
            return DASH_WARN;
         }
         return DASH_PASS;
      case 2:
         if(g_research_summary.rsch_total == 0)
         {
            out_reason = "No research results";
            out_action = "Ensure RschRunThresholdResearch() completed.";
            return DASH_FAIL;
         }
         if(g_research_summary.rsch_strong == 0 &&
            g_research_summary.rsch_moderate == 0)
         {
            out_reason = StringFormat("No STRONG/MODERATE features (WEAK=%d NOISE=%d)",
                                      g_research_summary.rsch_weak,
                                      g_research_summary.rsch_noise);
            out_action = "Collect more data or improve feature engineering.";
            return DASH_WARN;
         }
         if(g_research_summary.rsch_strong == 0)
         {
            out_reason = StringFormat("No STRONG features — MODERATE=%d",
                                      g_research_summary.rsch_moderate);
            out_action = "Results are preliminary. Collect more trades.";
            return DASH_WARN;
         }
         return DASH_PASS;
      case 3:
         if(g_research_summary.oos_total == 0)
         {
            out_reason = "No OOS validation results";
            out_action = "Ensure OOS validation completed successfully.";
            return DASH_FAIL;
         }
         if(g_research_summary.oos_stable == 0 &&
            g_research_summary.oos_mild == 0)
         {
            out_reason = StringFormat("No stable rules (Unstable=%d)",
                                      g_research_summary.oos_unstable);
            out_action = "Do NOT continue to deployment. Collect more OOS data.";
            return DASH_FAIL;
         }
         if(g_research_summary.oos_stable == 0)
         {
            out_reason = StringFormat("No STABLE rules — MILD=%d",
                                      g_research_summary.oos_mild);
            out_action = "Proceed only for analysis, not execution.";
            return DASH_WARN;
         }
         return DASH_PASS;
      case 4:
         if(g_research_summary.thr_exec_ready == 0)
         {
            out_reason = "No execution-ready thresholds";
            out_action = "Review ThresholdSelection and collect more data.";
            return DASH_FAIL;
         }
         if(g_research_summary.thr_exec_selected == 0)
         {
            out_reason = StringFormat("Ready=%d but none Selected_As_Execution",
                                      g_research_summary.thr_exec_ready);
            out_action = "Selection criteria may be too strict.";
            return DASH_WARN;
         }
         if(g_research_summary.thr_stat_selected == 0)
         {
            out_reason = StringFormat("Exec selected=%d but no statistical confirmation",
                                      g_research_summary.thr_exec_selected);
            out_action = "Use only for monitoring.";
            return DASH_WARN;
         }
         return DASH_PASS;
      case 5:
         if(g_research_summary.op_total == 0)
         {
            out_reason = "No operational entries";
            out_action = "Ensure OperationalRanking ran.";
            return DASH_WARN;
         }
         if(g_research_summary.op_ready == 0 &&
            g_research_summary.op_watchlist == 0)
         {
            out_reason = StringFormat("No READY/WATCHLIST (Pilot=%d)",
                                      g_research_summary.op_pilot);
            out_action = "Check ranking criteria.";
            return DASH_WARN;
         }
         return DASH_PASS;
      case 6:
         if(g_research_summary.dep_production_enabled == 0 &&
            g_research_summary.dep_pilot == 0)
         {
            out_reason = StringFormat("No READY/PILOT (Monitor=%d)",
                                      g_research_summary.dep_monitor);
            out_action = "Collect more trades before deployment.";
            return DASH_WARN;
         }
         if(g_research_summary.dep_production_enabled == 0)
         {
            out_reason = StringFormat("No production rules — Pilot=%d available",
                                      g_research_summary.dep_pilot);
            out_action = "Run pilot rules on demo.";
            return DASH_WARN;
         }
         return DASH_PASS;
   }
   out_reason = "Unknown gate number";
   out_action = "Internal error: gate_num outside [1,6].";
   return DASH_FAIL;
}
//================================================================
// Dashboard Verdict
//================================================================
string DashBuildVerdict(string &statuses[])
{
   int status_n = ArraySize(statuses);
   if(status_n < 6)
   {
      Print("DashBuildVerdict: expected >=6 gate statuses, got ", status_n);
      return "🟠 BLOCKED";
   }
   bool data_fail     = (statuses[0] == DASH_FAIL);
   bool critical_fail = (statuses[1] == DASH_FAIL || statuses[2] == DASH_FAIL);
   bool any_blocked   = false;
   int  warn_count    = 0;
   bool dep_ready     = (statuses[5] == DASH_PASS);
   for(int i = 0; i < ArraySize(statuses); i++)
   {
      if(statuses[i] == DASH_BLOCKED) any_blocked = true;
      if(statuses[i] == DASH_WARN)    warn_count++;
   }
   if(data_fail)        return "🔴 DATA FAIL";
   if(critical_fail)    return "🔴 RESEARCH FAIL";
   if(any_blocked && warn_count >= 2) return "🟠 BLOCKED";
   if(any_blocked)      return "🟡 PARTIALLY BLOCKED";
   if(warn_count >= 3)  return "🟡 CAUTION";
   if(warn_count >= 1 && !dep_ready) return "🟡 PROMISING";
   if(dep_ready)        return "🟢 PRODUCTION READY";
   return "🟢 GOOD";
}
