   string fn=S2B_StopD2024_File("LockManifest")+".txt";int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE)return;string ch="NONE",fl="NONE";int nf=0;if(g_s2b_stop_d2024_candidate_locked){SCompactResult r=g_s2b_stop_d2024_candidates[g_s2b_stop_d2024_selected_index];ch=r.feature_hash;fl=r.feat_names;nf=r.n_feat;}FileWriteString(h,"CycleId="+S2B_STOP_D2024_CYCLE_ID+"\nProtocolVersion="+S2B_STOP_D2024_PROTOCOL_VERSION+"\nGateVersion="+S2B_STOP_THRESHOLD_GATE_VERSION+"\nDatasetHash="+g_s2b_stop_d2024_protocol.dataset_hash+"\nFeatureMatrixHash="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"\nRowMaskHash="+g_s2b_stop_d2024_protocol.row_mask_hash+"\nFoldHash="+g_s2b_stop_d2024_protocol.fold_hash+"\nProtocolHash="+g_s2b_stop_d2024_protocol.protocol_hash+"\nContextHash="+g_s2b_stop_d2024_context.evaluation_context_hash+"\nEligibleCount="+IntegerToString(g_s2b_stop_d2024_context.eligible_count)+"\nStopPositives="+IntegerToString(g_s2b_stop_d2024_context.positive_count)+"\nCandidateLocked="+string(g_s2b_stop_d2024_candidate_locked?"YES":"NO")+"\nCandidateHash="+ch+"\nCandidateFeatureCount="+IntegerToString(nf)+"\nCandidateFeatureList="+fl+"\nThresholdEngineExecuted=NO\nHoldoutAccessed=NO\n");FileClose(h);Print("STOP_D2024_LOCK_MANIFEST|",fn);
