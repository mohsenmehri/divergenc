void S2B_StopD2024_RunPhaseA()
{
   Print("STOP_D2024_RUN_MODE|ISOLATED_PHASE_A_SEARCH");Print("STOP_D2024_RUN_GUARD|LEGACY_STEP4_OOS=SKIPPED|RUN_PHASE7=SKIPPED|OLD_STOP_PIPELINE=SKIPPED|2023=DEVELOPMENT_VALIDATION|2024_2026=RESERVED_UNTOUCHED");S2B_StopD2024_ResetCycleState();string reason="";if(!S2B_StopD2024_ValidateRunBoundary(reason)){g_s2b_stop_d2024_block_reason=reason;Print("STOP_D2024_PHASEA|BLOCKED|Reason=",reason);return;}if(!S2B_StopD2024_InitProtocol(reason)){g_s2b_stop_d2024_block_reason=reason;Print("STOP_D2024_PHASEA|BLOCKED|Reason=",reason);S2B_StopD2024_ExportProtocolReport();return;}S2B_StopD2024_ExportProtocolReport();int pool[];S2B_FillStopCompactPoolFeatures(pool);bool bok=S2B_StopD2024_EvaluateSubsetWF(pool,ArraySize(pool),g_s2b_stop_d2024_baseline);ArrayFree(pool);S2B_StopD2024_ExportWalkForward();if(!S2B_StopD2024_ValidateFoldCardinalities(reason)){g_s2b_stop_d2024_block_reason="INSUFFICIENT_FOLD_CLASS_CARDINALITY";g_s2b_stop_d2024_search_executed=false;g_s2b_stop_d2024_candidate_locked=false;Print("STOP_D2024_PHASEA|BLOCKED|Reason=",reason);S2B_StopD2024_ExportCandidateLock();S2B_StopD2024_ExportLockManifest();return;}if(!bok){g_s2b_stop_d2024_block_reason="BASELINE_EVALUATION_FAILED";S2B_StopD2024_ExportCandidateLock();S2B_StopD2024_ExportLockManifest();return;}S2B_StopD2024_RunCompactSearch();S2B_StopD2024_ExportSearchReports();S2B_StopD2024_ExportCandidateLock();S2B_StopD2024_ExportLockManifest();Print("STOP_D2024_PHASEA_SUMMARY|Protocol=",g_s2b_stop_d2024_protocol.protocol_hash,"|Dataset=",g_s2b_stop_d2024_protocol.dataset_hash,"|Fold=",g_s2b_stop_d2024_protocol.fold_hash,"|Context=",g_s2b_stop_d2024_context.evaluation_context_hash,"|CandidateLocked=",(g_s2b_stop_d2024_candidate_locked?"YES":"NO"),"|ThresholdEngine=BLOCKED|Holdout=BLOCKED|Frozen=BLOCKED|Stage2C=BLOCKED|Stage2D=BLOCKED");
}
