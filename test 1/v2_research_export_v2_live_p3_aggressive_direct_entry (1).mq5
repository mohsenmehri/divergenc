      hdr += "EMA20Slope_" + t + ",";
      hdr += "EMA50Slope_" + t + ",";
      hdr += "EMA200Slope_" + t + ",";
      hdr += "EMAGap20_50_" + t + ",";
      hdr += "EMAGap50_200_" + t + ",";
      hdr += "EMAComp_" + t + ",";
      hdr += "RSI_" + t + ",";
