   g_s2b_winner_confirmed = false;
   g_s2b_freeze_allowed = false;
   g_s2b_oos_allowed = false;
   Print("=== Stage 2B Phase 6 DONE ===");
}
double S2B7_Quantile(double &vals[], int n, double q)
{
   if(n <= 0) return 0.0;
   if(n == 1) return vals[0];
   double tmp[];
   ArrayResize(tmp, n);
   for(int i = 0; i < n; i++) tmp[i] = vals[i];
   ArraySort(tmp);
   if(q < 0.0) q = 0.0;
   if(q > 1.0) q = 1.0;
   double pos = (n - 1) * q;
   int lo = (int)MathFloor(pos);
   int hi = (int)MathCeil(pos);
   if(lo < 0) lo = 0;
   if(hi >= n) hi = n - 1;
   if(lo == hi)
   {
      double out = tmp[lo];
      ArrayFree(tmp);
      return out;
   }
   double frac = pos - lo;
   double out = tmp[lo] + (tmp[hi] - tmp[lo]) * frac;
   ArrayFree(tmp);
   return out;
}
void S2B7_Summarize(double &vals[], int n,
                    double &mean, double &median,
                    double &q25, double &q75,
                    double &minv, double &maxv)
{
   mean = median = q25 = q75 = minv = maxv = 0.0;
   if(n <= 0) return;
   double sum = 0.0;
   minv = vals[0];
   maxv = vals[0];
   for(int i = 0; i < n; i++)
   {
      sum += vals[i];
      if(vals[i] < minv) minv = vals[i];
      if(vals[i] > maxv) maxv = vals[i];
   }
   mean   = sum / n;
   median = S2B7_Quantile(vals, n, 0.50);
   q25    = S2B7_Quantile(vals, n, 0.25);
   q75    = S2B7_Quantile(vals, n, 0.75);
}
double S2B7_CohensD(double &a[], int na, double &b[], int nb)
{
   if(na < 2 || nb < 2) return 0.0;
   double ma=0.0, mb=0.0;
   for(int i=0;i<na;i++) ma += a[i];
   for(int i=0;i<nb;i++) mb += b[i];
   ma /= na;
   mb /= nb;
   double va=0.0, vb=0.0;
   for(int i=0;i<na;i++) va += (a[i]-ma)*(a[i]-ma);
   for(int i=0;i<nb;i++) vb += (b[i]-mb)*(b[i]-mb);
   double sda = MathSqrt(va / (na - 1));
   double sdb = MathSqrt(vb / (nb - 1));
   double pooled = (((na-1)*sda*sda) + ((nb-1)*sdb*sdb)) / (na + nb - 2.0);
   if(pooled <= 0.0) return 0.0;
   double sp = MathSqrt(pooled);
   if(sp <= 1e-10) return 0.0;
   return (ma - mb) / sp;
}
double S2B7_CliffsDelta(double &a[], int na, double &b[], int nb)
{
   if(na <= 0 || nb <= 0) return 0.0;
   long gt = 0, lt = 0;
   for(int i = 0; i < na; i++)
   {
      for(int j = 0; j < nb; j++)
      {
         if(a[i] > b[j]) gt++;
         else if(a[i] < b[j]) lt++;
      }
   }
   double denom = (double)na * (double)nb;
   if(denom <= 0.0) return 0.0;
   return ((double)gt - (double)lt) / denom;
}
void S2B7_MannWhitney(double &a[], int na, double &b[], int nb,
                      double &u_stat, double &z_score)
{
   u_stat = 0.0;
   z_score = 0.0;
   if(na <= 0 || nb <= 0) return;
   int n = na + nb;
   double vals[];
   int grp[];
   ArrayResize(vals, n);
   ArrayResize(grp,  n);
   int idx = 0;
   for(int i=0;i<na;i++){ vals[idx]=a[i]; grp[idx]=0; idx++; }
   for(int i=0;i<nb;i++){ vals[idx]=b[i]; grp[idx]=1; idx++; }
   int ord[];
   ArrayResize(ord, n);
   for(int i=0;i<n;i++) ord[i]=i;
   int gap = n/2;
   while(gap > 0)
   {
      for(int i=gap;i<n;i++)
      {
         int tmp=ord[i];
         int j=i;
         while(j>=gap && vals[ord[j-gap]] > vals[tmp])
         {
            ord[j]=ord[j-gap];
            j-=gap;
         }
         ord[j]=tmp;
      }
      gap/=2;
   }
   double rank_sum_a = 0.0;
   int i = 0;
   while(i < n)
   {
      int j = i;
      while(j < n-1 && vals[ord[j]] == vals[ord[j+1]]) j++;
      double avg_rank = (i + 1 + j + 1) / 2.0;
      for(int k=i;k<=j;k++)
         if(grp[ord[k]] == 0)
            rank_sum_a += avg_rank;
      i = j + 1;
   }
   u_stat = rank_sum_a - (double)na * (na + 1) / 2.0;
   double mu = (double)na * nb / 2.0;
   double sigma = MathSqrt((double)na * nb * (na + nb + 1) / 12.0);
   if(sigma > 1e-10)
      z_score = (u_stat - mu) / sigma;
   ArrayFree(vals);
   ArrayFree(grp);
   ArrayFree(ord);
}
double S2B7_Pearson(double &x[], double &y[], int n)
{
   if(n < 3) return 0.0;
   double mx=0.0, my=0.0;
   for(int i=0;i<n;i++){ mx += x[i]; my += y[i]; }
   mx /= n; my /= n;
   double num=0.0, vx=0.0, vy=0.0;
   for(int i=0;i<n;i++)
   {
      double dx = x[i] - mx;
      double dy = y[i] - my;
      num += dx * dy;
      vx  += dx * dx;
      vy  += dy * dy;
   }
   double den = MathSqrt(vx * vy);
   if(den <= 1e-10) return 0.0;
   double r = num / den;
   return MathMax(-1.0, MathMin(1.0, r));
}
void S2B7_GetRanks(double &vals[], int n, double &ranks[])
{
   ArrayResize(ranks, n);
   if(n <= 0) return;
   int ord[];
   ArrayResize(ord, n);
   for(int i=0;i<n;i++) ord[i] = i;
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i=gap;i<n;i++)
      {
         int tmp = ord[i];
         int j = i;
         while(j >= gap && vals[ord[j-gap]] > vals[tmp])
         {
            ord[j] = ord[j-gap];
            j -= gap;
         }
         ord[j] = tmp;
      }
      gap /= 2;
   }
   int i = 0;
   while(i < n)
   {
      int j = i;
      while(j < n-1 && vals[ord[j]] == vals[ord[j+1]]) j++;
      double avg_rank = (i + 1 + j + 1) / 2.0;
      for(int k=i;k<=j;k++)
         ranks[ord[k]] = avg_rank;
      i = j + 1;
   }
   ArrayFree(ord);
}
double S2B7_Spearman(double &x[], double &y[], int n)
{
   if(n < 3) return 0.0;
   double rx[], ry[];
   S2B7_GetRanks(x, n, rx);
   S2B7_GetRanks(y, n, ry);
   double r = S2B7_Pearson(rx, ry, n);
   ArrayFree(rx);
   ArrayFree(ry);
   return r;
}
//---------------------------------------------------------------
// Structs
//---------------------------------------------------------------
struct S2B7_OutcomeGroup
{
   string name;
   int    n;
   int    win_cnt;
   int    stop_cnt;
   int    deepstop_cnt;
   int    maxstep_sum;
   double pnl_vals[];
   double dd_vals[];
   double pnl_mean;
   double pnl_median;
   double pnl_q25;
   double pnl_q75;
   double pnl_min;
   double pnl_max;
   double dd_mean;
   double dd_median;
   double dd_q25;
   double dd_q75;
   double dd_min;
   double dd_max;
   void Reset(string nm)
   {
      name = nm;
      n = 0;
      win_cnt = 0;
      stop_cnt = 0;
      deepstop_cnt = 0;
      maxstep_sum = 0;
      ArrayResize(pnl_vals, 0);
      ArrayResize(dd_vals, 0);
      pnl_mean = pnl_median = pnl_q25 = pnl_q75 = pnl_min = pnl_max = 0.0;
      dd_mean  = dd_median  = dd_q25  = dd_q75  = dd_min  = dd_max  = 0.0;
   }
   void Add(double pnl, double maxdd, bool is_win, bool is_stop, bool is_deepstop, int maxstep)
   {
      int np = ArraySize(pnl_vals);
      ArrayResize(pnl_vals, np + 1);
      pnl_vals[np] = pnl;
      int nd = ArraySize(dd_vals);
      ArrayResize(dd_vals, nd + 1);
      dd_vals[nd] = maxdd;
      n++;
      if(is_win) win_cnt++;
      if(is_stop) stop_cnt++;
      if(is_deepstop) deepstop_cnt++;
      maxstep_sum += maxstep;
   }
   void Finalize()
   {
      if(n <= 0) return;
      S2B7_Summarize(pnl_vals, n, pnl_mean, pnl_median, pnl_q25, pnl_q75, pnl_min, pnl_max);
      S2B7_Summarize(dd_vals,  n, dd_mean,  dd_median,  dd_q25,  dd_q75,  dd_min,  dd_max);
   }
   double WinRate()    { return (n > 0 ? win_cnt * 100.0 / n : 0.0); }
   double StopRate()   { return (n > 0 ? stop_cnt * 100.0 / n : 0.0); }
   double DeepRate()   { return (n > 0 ? deepstop_cnt * 100.0 / n : 0.0); }
   double AvgMaxStep() { return (n > 0 ? (double)maxstep_sum / n : 0.0); }
};
struct S2B7_BandDiag
{
   string name;
   int    n;
   int    step4_cnt;
   int    profit_cnt;
   int    stop_cnt;
   int    deepstop_cnt;
   int    maxstep_sum;
   double pnl_vals[];
   double dd_vals[];
   double score_vals[];
   double mean_score;
   double mean_pnl;
   double median_pnl;
   double q25_pnl;
   double q75_pnl;
   double mean_dd;
   double median_dd;
   void Reset(string nm)
   {
      name = nm;
      n = step4_cnt = profit_cnt = stop_cnt = deepstop_cnt = maxstep_sum = 0;
      ArrayResize(pnl_vals, 0);
      ArrayResize(dd_vals, 0);
      ArrayResize(score_vals, 0);
      mean_score = mean_pnl = median_pnl = q25_pnl = q75_pnl = mean_dd = median_dd = 0.0;
   }
   void Add(double score, double pnl, double dd, bool step4, bool is_profit, bool is_stop, bool is_deep, int maxstep)
   {
      int np = ArraySize(pnl_vals);
      ArrayResize(pnl_vals, np + 1);
      pnl_vals[np] = pnl;
      int nd = ArraySize(dd_vals);
      ArrayResize(dd_vals, nd + 1);
      dd_vals[nd] = dd;
      int ns = ArraySize(score_vals);
      ArrayResize(score_vals, ns + 1);
      score_vals[ns] = score;
      n++;
      if(step4) step4_cnt++;
      if(is_profit) profit_cnt++;
      if(is_stop) stop_cnt++;
      if(is_deep) deepstop_cnt++;
      maxstep_sum += maxstep;
   }
   void Finalize()
   {
      if(n <= 0) return;
      double s_mean=0,s_med=0,s_q25=0,s_q75=0,s_min=0,s_max=0;
      S2B7_Summarize(score_vals, n, s_mean, s_med, s_q25, s_q75, s_min, s_max);
      mean_score = s_mean;
      double p_mean=0,p_med=0,p_q25=0,p_q75=0,p_min=0,p_max=0;
      S2B7_Summarize(pnl_vals, n, p_mean, p_med, p_q25, p_q75, p_min, p_max);
      mean_pnl = p_mean;
      median_pnl = p_med;
      q25_pnl = p_q25;
      q75_pnl = p_q75;
      double d_mean=0,d_med=0,d_q25=0,d_q75=0,d_min=0,d_max=0;
      S2B7_Summarize(dd_vals, n, d_mean, d_med, d_q25, d_q75, d_min, d_max);
      mean_dd = d_mean;
      median_dd = d_med;
   }
   double Step4Rate()  { return (n > 0 ? step4_cnt * 100.0 / n : 0.0); }
   double ProfitRate() { return (n > 0 ? profit_cnt * 100.0 / n : 0.0); }
   double StopRate()   { return (n > 0 ? stop_cnt * 100.0 / n : 0.0); }
   double DeepRate()   { return (n > 0 ? deepstop_cnt * 100.0 / n : 0.0); }
   double AvgMaxStep() { return (n > 0 ? (double)maxstep_sum / n : 0.0); }
};
//---------------------------------------------------------------
// Report 1 — Step4 Outcome Table
//---------------------------------------------------------------
void S2B_ExportStep4OutcomeTable()
{
   if(!g_s2b_compact_winner.trained) return;
   S2B7_OutcomeGroup gA, gB, gC, gD;
   gA.Reset("Step4+ & Profit");
   gB.Reset("Step4+ & Loss");
   gC.Reset("NoStep4 & Profit");
   gD.Reset("NoStep4 & Loss");
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      bool step4 = g_risklab_records[r].hit_step4_plus;
      bool prof  = (g_risklab_records[r].pnl > 0.0);
      bool stop  = g_risklab_records[r].stop_flag;
      bool deep  = (g_risklab_records[r].stop_flag && g_risklab_records[r].max_step_reached >= 4);
      double pnl   = g_risklab_records[r].pnl;
      double maxdd = g_risklab_records[r].max_dd;
      int    mstep = g_risklab_records[r].max_step_reached;
      if(step4 && prof)        gA.Add(pnl, maxdd, true,  stop, deep, mstep);
      else if(step4 && !prof)  gB.Add(pnl, maxdd, false, stop, deep, mstep);
      else if(!step4 && prof)  gC.Add(pnl, maxdd, true,  stop, deep, mstep);
      else                     gD.Add(pnl, maxdd, false, stop, deep, mstep);
   }
   gA.Finalize(); gB.Finalize(); gC.Finalize(); gD.Finalize();
   string fn = "Stage2B7_Step4OutcomeTable_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STEP4 × OUTCOME TABLE (OOS ONLY)\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-20s | %6s | %8s | %8s | %8s | %8s | %8s | %8s | %8s | %8s\n",
      "Group", "Count", "WinRate", "StopRate", "AvgPnL", "MedPnL", "Q25", "Q75", "AvgDD", "AvgStep"));
   FileWriteString(h, sep);
   S2B7_OutcomeGroup groups[4];
   groups[0] = gA; groups[1] = gB; groups[2] = gC; groups[3] = gD;
   for(int i = 0; i < 4; i++)
   {
      FileWriteString(h, StringFormat(
         "%-20s | %6d | %7.1f%% | %7.1f%% | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f\n",
         groups[i].name,
         groups[i].n,
         groups[i].WinRate(),
         groups[i].StopRate(),
         groups[i].pnl_mean,
         groups[i].pnl_median,
         groups[i].pnl_q25,
         groups[i].pnl_q75,
         groups[i].dd_mean,
         groups[i].AvgMaxStep()));
   }
   // Step4 aggregate vs NoStep4 aggregate
   double step4_pnl[];
   double nostep4_pnl[];
   ArrayResize(step4_pnl, gA.n + gB.n);
   ArrayResize(nostep4_pnl, gC.n + gD.n);
   int ns4 = 0, nns = 0;
   for(int i = 0; i < ArraySize(gA.pnl_vals); i++) step4_pnl[ns4++] = gA.pnl_vals[i];
   for(int i = 0; i < ArraySize(gB.pnl_vals); i++) step4_pnl[ns4++] = gB.pnl_vals[i];
   for(int i = 0; i < ArraySize(gC.pnl_vals); i++) nostep4_pnl[nns++] = gC.pnl_vals[i];
   for(int i = 0; i < ArraySize(gD.pnl_vals); i++) nostep4_pnl[nns++] = gD.pnl_vals[i];
   double d = 0.0, cd = 0.0, u = 0.0, z = 0.0;
   if(ns4 > 1 && nns > 1)
   {
      cd = S2B7_CohensD(step4_pnl, ns4, nostep4_pnl, nns);
      d  = S2B7_CliffsDelta(step4_pnl, ns4, nostep4_pnl, nns);
      S2B7_MannWhitney(step4_pnl, ns4, nostep4_pnl, nns, u, z);
   }
   FileWriteString(h, "\n[STEP4+ vs NO-STEP4 OUTCOME EFFECT]\n" + sep);
   FileWriteString(h, StringFormat("Cohen's d      : %.4f\n", cd));
   FileWriteString(h, StringFormat("Cliff's Delta  : %.4f\n", d));
   FileWriteString(h, StringFormat("Mann-Whitney U : %.2f  | z≈%.4f\n", u, z));
   ArrayFree(step4_pnl);
   ArrayFree(nostep4_pnl);
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2B7 Step4 Outcome Table: ", fn);
}
//---------------------------------------------------------------
// Report 2 — Band Outcome Diagnostics
//---------------------------------------------------------------
void S2B_ExportBandOutcomeDiagnostics()
{
   if(!g_s2b_compact_winner.trained) return;
   // ensure boundaries are current
   S2C_ComputeBandBoundaries();
   S2B7_BandDiag bands[5];
   for(int b = 0; b < 5; b++)
      bands[b].Reset(S2C_BandName(b));
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      double score = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(score);
      bool step4 = g_risklab_records[r].hit_step4_plus;
      bool prof  = (g_risklab_records[r].pnl > 0.0);
      bool stop  = g_risklab_records[r].stop_flag;
      bool deep  = (g_risklab_records[r].stop_flag && g_risklab_records[r].max_step_reached >= 4);
      bands[band].Add(score,
                      g_risklab_records[r].pnl,
                      g_risklab_records[r].max_dd,
                      step4, prof, stop, deep,
                      g_risklab_records[r].max_step_reached);
   }
   for(int b = 0; b < 5; b++)
      bands[b].Finalize();
   string fn = "Stage2B7_BandOutcomeDiagnostics_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "BAND OUTCOME DIAGNOSTICS (OOS ONLY)\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "%-12s | %5s | %7s | %7s | %8s | %8s | %8s | %8s | %8s | %8s | %7s | %7s\n",
      "Band","N","Step4%","Profit%","AvgPnL","MedPnL","Q25","Q75","AvgDD","MedDD","Stop%","Deep%"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      FileWriteString(h, StringFormat(
         "%-12s | %5d | %6.1f%% | %6.1f%% | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %8.2f | %6.1f%% | %6.1f%%\n",
         bands[b].name,
         bands[b].n,
         bands[b].Step4Rate(),
         bands[b].ProfitRate(),
         bands[b].mean_pnl,
         bands[b].median_pnl,
         bands[b].q25_pnl,
         bands[b].q75_pnl,
         bands[b].mean_dd,
         bands[b].median_dd,
         bands[b].StopRate(),
         bands[b].DeepRate()));
   }
   // A vs E effect sizes on PnL
   double a_pnl[];
   double e_pnl[];
   ArrayResize(a_pnl, ArraySize(bands[4].pnl_vals));
   ArrayResize(e_pnl, ArraySize(bands[0].pnl_vals));
   for(int i = 0; i < ArraySize(bands[4].pnl_vals); i++) a_pnl[i] = bands[4].pnl_vals[i];
   for(int i = 0; i < ArraySize(bands[0].pnl_vals); i++) e_pnl[i] = bands[0].pnl_vals[i];
   double coh = 0.0, cliff = 0.0, u = 0.0, z = 0.0;
   if(ArraySize(a_pnl) > 1 && ArraySize(e_pnl) > 1)
   {
      coh = S2B7_CohensD(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl));
      cliff = S2B7_CliffsDelta(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl));
      S2B7_MannWhitney(a_pnl, ArraySize(a_pnl), e_pnl, ArraySize(e_pnl), u, z);
   }
   FileWriteString(h, "\n[BAND A vs BAND E — PnL EFFECT]\n" + sep);
   FileWriteString(h, StringFormat("Band A Mean/Median PnL: %.2f / %.2f\n", bands[4].mean_pnl, bands[4].median_pnl));
   FileWriteString(h, StringFormat("Band E Mean/Median PnL: %.2f / %.2f\n", bands[0].mean_pnl, bands[0].median_pnl));
   FileWriteString(h, StringFormat("Cohen's d      : %.4f\n", coh));
   FileWriteString(h, StringFormat("Cliff's Delta  : %.4f\n", cliff));
   FileWriteString(h, StringFormat("Mann-Whitney U : %.2f  | z≈%.4f\n", u, z));
   ArrayFree(a_pnl);
   ArrayFree(e_pnl);
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Stage2B7 Band Diagnostics: ", fn);
}
//---------------------------------------------------------------
// Report 3 — Outcome Summary / Role of the model
//---------------------------------------------------------------
void S2B_ExportStep4OutcomeSummary()
{
   if(!g_s2b_compact_winner.trained) return;
   S2C_ComputeBandBoundaries();
   // OOS arrays
   double score_vals[];
   double pnl_vals[];
   double step_vals[];
   double stop_vals[];
   double profit_vals[];
   double dd_vals[];
   ArrayResize(score_vals,  g_risklab_count);
   ArrayResize(pnl_vals,    g_risklab_count);
   ArrayResize(step_vals,   g_risklab_count);
   ArrayResize(stop_vals,   g_risklab_count);
   ArrayResize(profit_vals, g_risklab_count);
   ArrayResize(dd_vals,     g_risklab_count);
   int n = 0;
   // band summaries
   int band_n[5], band_step4[5], band_profit[5], band_stop[5];
   double band_pnl_sum[5], band_dd_sum[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_step4, 0);
   ArrayInitialize(band_profit, 0);
   ArrayInitialize(band_stop, 0);
   ArrayInitialize(band_pnl_sum, 0.0);
   ArrayInitialize(band_dd_sum, 0.0);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      double sc = S2C_ScoreRiskLabRecord(r);
      int band = S2C_GetBand(sc);
      bool step4 = g_risklab_records[r].hit_step4_plus;
      bool stop  = g_risklab_records[r].stop_flag;
      bool prof  = (g_risklab_records[r].pnl > 0.0);
      score_vals[n]  = sc;
      pnl_vals[n]    = g_risklab_records[r].pnl;
      step_vals[n]   = step4 ? 1.0 : 0.0;
      stop_vals[n]   = stop  ? 1.0 : 0.0;
      profit_vals[n] = prof  ? 1.0 : 0.0;
      dd_vals[n]     = g_risklab_records[r].max_dd;
      n++;
      band_n[band]++;
      if(step4) band_step4[band]++;
      if(prof)  band_profit[band]++;
      if(stop)  band_stop[band]++;
      band_pnl_sum[band] += g_risklab_records[r].pnl;
      band_dd_sum[band]  += g_risklab_records[r].max_dd;
   }
   ArrayResize(score_vals,  n);
   ArrayResize(pnl_vals,    n);
   ArrayResize(step_vals,   n);
   ArrayResize(stop_vals,   n);
   ArrayResize(profit_vals, n);
   ArrayResize(dd_vals,     n);
   string fn = "Stage2B7_OutcomeSummary_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      ArrayFree(score_vals); ArrayFree(pnl_vals); ArrayFree(step_vals);
      ArrayFree(stop_vals); ArrayFree(profit_vals); ArrayFree(dd_vals);
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "STEP4 MODEL ROLE ANALYSIS (OOS ONLY)\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, line);
   // Correlations
   double p_score_pnl   = S2B7_Pearson(score_vals, pnl_vals, n);
   double s_score_pnl   = S2B7_Spearman(score_vals, pnl_vals, n);
   double p_score_step4 = S2B7_Pearson(score_vals, step_vals, n);
   double s_score_step4 = S2B7_Spearman(score_vals, step_vals, n);
   double p_score_stop  = S2B7_Pearson(score_vals, stop_vals, n);
   double s_score_stop  = S2B7_Spearman(score_vals, stop_vals, n);
   double p_score_prof  = S2B7_Pearson(score_vals, profit_vals, n);
   double s_score_prof  = S2B7_Spearman(score_vals, profit_vals, n);
   double p_score_dd    = S2B7_Pearson(score_vals, dd_vals, n);
   double s_score_dd    = S2B7_Spearman(score_vals, dd_vals, n);
   FileWriteString(h, "\n[OUTCOME ASSOCIATION]\n" + sep);
   FileWriteString(h, StringFormat("%-18s | %10s | %10s\n", "Relation", "Pearson", "Spearman"));
   FileWriteString(h, sep);
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs PnL",    p_score_pnl,   s_score_pnl));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Step4",  p_score_step4, s_score_step4));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Stop",   p_score_stop,  s_score_stop));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs Profit", p_score_prof,  s_score_prof));
   FileWriteString(h, StringFormat("%-18s | %10.4f | %10.4f\n", "Score vs MaxDD",  p_score_dd,    s_score_dd));
   // band high vs low diagnostic
   double top_step4_rate  = (band_n[4] > 0) ? (band_step4[4] * 100.0 / band_n[4]) : 0.0;
   double low_step4_rate  = (band_n[0] > 0) ? (band_step4[0] * 100.0 / band_n[0]) : 0.0;
   double top_profit_rate = (band_n[4] > 0) ? (band_profit[4] * 100.0 / band_n[4]) : 0.0;
   double low_profit_rate = (band_n[0] > 0) ? (band_profit[0] * 100.0 / band_n[0]) : 0.0;
   double top_stop_rate   = (band_n[4] > 0) ? (band_stop[4] * 100.0 / band_n[4]) : 0.0;
   double low_stop_rate   = (band_n[0] > 0) ? (band_stop[0] * 100.0 / band_n[0]) : 0.0;
   double top_avg_pnl     = (band_n[4] > 0) ? (band_pnl_sum[4] / band_n[4]) : 0.0;
   double low_avg_pnl     = (band_n[0] > 0) ? (band_pnl_sum[0] / band_n[0]) : 0.0;
   double top_avg_dd      = (band_n[4] > 0) ? (band_dd_sum[4] / band_n[4]) : 0.0;
   double low_avg_dd      = (band_n[0] > 0) ? (band_dd_sum[0] / band_n[0]) : 0.0;
   FileWriteString(h, "\n[BAND A vs BAND E SUMMARY]\n" + sep);
   FileWriteString(h, StringFormat("  Step4 Rate  : A=%.1f%%  vs E=%.1f%%\n", top_step4_rate, low_step4_rate));
   FileWriteString(h, StringFormat("  Profit Rate : A=%.1f%%  vs E=%.1f%%\n", top_profit_rate, low_profit_rate));
   FileWriteString(h, StringFormat("  Stop Rate   : A=%.1f%%  vs E=%.1f%%\n", top_stop_rate, low_stop_rate));
   FileWriteString(h, StringFormat("  Avg PnL     : A=%.2f    vs E=%.2f\n", top_avg_pnl, low_avg_pnl));
   FileWriteString(h, StringFormat("  Avg MaxDD   : A=%.2f    vs E=%.2f\n", top_avg_dd, low_avg_dd));
   // Recommendation logic
   string role = "AMBIGUOUS";
   string reason = "";
   bool strong_step4_signal = (top_step4_rate > low_step4_rate * 1.8) || (s_score_step4 > 0.15);
   bool pnl_negative_assoc  = (s_score_pnl < -0.05) || (top_avg_pnl < low_avg_pnl && top_profit_rate <= low_profit_rate);
   bool risk_positive_assoc = (s_score_stop > 0.05) || (top_stop_rate > low_stop_rate) || (top_avg_dd > low_avg_dd);
   if(strong_step4_signal && pnl_negative_assoc && risk_positive_assoc)
   {
      role = "DEPTH_RISK";
      reason = "Score rises with Step4 but degrades PnL / raises risk.";
   }
   else if(strong_step4_signal && !pnl_negative_assoc && top_profit_rate >= low_profit_rate)
   {
      role = "ENTRY_RANKING";
      reason = "Score rises with Step4 and does not harm economic outcome.";
   }
   else
   {
      role = "AMBIGUOUS";
      reason = "Score is associated with depth, but economic role is not cleanly separable.";
   }
   FileWriteString(h, "\n[DECISION RECOMMENDATION]\n" + sep);
   FileWriteString(h, "Recommendation : " + role + "\n");
   FileWriteString(h, "Reason         : " + reason + "\n\n");
   if(role == "DEPTH_RISK")
   {
      FileWriteString(h, "Interpretation:\n");
      FileWriteString(h, "  The model primarily predicts deep movement / path complexity.\n");
      FileWriteString(h, "  Use as a risk/depth flag, not as pure entry quality.\n");
   }
   else if(role == "ENTRY_RANKING")
   {
      FileWriteString(h, "Interpretation:\n");
      FileWriteString(h, "  The model behaves as a useful entry-quality ranking layer.\n");
      FileWriteString(h, "  Bands can be used directly in Stage 2C decision logic.\n");
   }
   else
   {
      FileWriteString(h, "Interpretation:\n");
      FileWriteString(h, "  The model has signal, but its economic meaning is mixed.\n");
      FileWriteString(h, "  Use with caution until a conditional outcome model is added.\n");
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   ArrayFree(score_vals);
   ArrayFree(pnl_vals);
   ArrayFree(step_vals);
   ArrayFree(stop_vals);
   ArrayFree(profit_vals);
   ArrayFree(dd_vals);
   Print("Stage2B7 Outcome Summary: ", fn,
         " | Recommendation=", role);
}
// ================================================================
// StopFlag D2024 independent Phase A cycle
// Development: [2018.01.01, 2024.01.01)
// Reserved untouched holdout: [2024.01.01, end of available 2026)
// ================================================================
struct SS2BStopD2024Protocol
{
   bool valid; string invalid_reason;
   string cycle_id, protocol_version, evaluator_version, row_policy_version, selection_policy_version;
   datetime development_from, development_to, reserved_holdout_from;
   string dataset_hash, feature_matrix_hash, row_mask_hash, fold_hash, protocol_hash;
   string pool_hash, row_policy_hash, target_hash;
   int snapshot_count, risklab_count, development_record_count;
   int eligible_count, excluded_count, positive_count, negative_count;
   datetime first_entry_time, last_entry_time;
   int min_train_n, min_train_pos, min_val_n, min_val_pos;
   int pool_feature_idx[S2B_COMPACT_POOL_SIZE]; int pool_feature_count;
   int eligible_record_indices[]; int row_mask_flags[];
   void Reset()
   {
      valid=false; invalid_reason=""; cycle_id=S2B_STOP_D2024_CYCLE_ID;
      protocol_version=S2B_STOP_D2024_PROTOCOL_VERSION; evaluator_version=S2B_STOP_D2024_EVALUATOR_VERSION;
      row_policy_version=S2B_STOP_D2024_ROW_POLICY_VERSION; selection_policy_version=S2B_STOP_D2024_SELECTION_VERSION;
      development_from=0; development_to=0; reserved_holdout_from=0;
      dataset_hash=""; feature_matrix_hash=""; row_mask_hash=""; fold_hash=""; protocol_hash="";
      pool_hash=""; row_policy_hash=""; target_hash="";
      snapshot_count=0; risklab_count=0; development_record_count=0; eligible_count=0; excluded_count=0;
      positive_count=0; negative_count=0; first_entry_time=0; last_entry_time=0;
      min_train_n=S2B_STOP_D2024_MIN_TRAIN_N; min_train_pos=S2B_STOP_D2024_MIN_TRAIN_POS;
      min_val_n=S2B_STOP_D2024_MIN_VAL_N; min_val_pos=S2B_STOP_D2024_MIN_VAL_POS;
      pool_feature_count=0; for(int i=0;i<S2B_COMPACT_POOL_SIZE;i++) pool_feature_idx[i]=-1;
      ArrayResize(eligible_record_indices,0); ArrayResize(row_mask_flags,0);
   }
};
struct SS2BStopD2024Context
{
   bool valid; string invalid_reason;
   string evaluator_version,target_name,target_definition,valid_row_policy;
   datetime development_from,development_to,historical_confirmation_from,historical_confirmation_to;
   string shared_protocol_hash,fold_hash,dataset_hash,row_mask_hash,target_hash,pool_hash,row_policy_hash,evaluation_context_hash;
   string feature_matrix_hash;
   int eligible_count,excluded_count,positive_count,negative_count;
   int pool_feature_idx[S2B_COMPACT_POOL_SIZE]; int pool_feature_count;
   int eligible_record_indices[]; int row_mask_flags[];
   bool historical_confirmation_used,threshold_selected;
   void Reset()
   {
      valid=false; invalid_reason=""; evaluator_version=S2B_STOP_D2024_EVALUATOR_VERSION;
      target_name="StopFlag"; target_definition="rec.stop_flag == true"; valid_row_policy=S2B_STOP_D2024_ROW_POLICY_VERSION;
      development_from=0; development_to=0; historical_confirmation_from=0; historical_confirmation_to=0;
      shared_protocol_hash=""; fold_hash=""; dataset_hash=""; row_mask_hash=""; target_hash=""; pool_hash="";
      row_policy_hash=""; evaluation_context_hash=""; feature_matrix_hash="";
      eligible_count=0; excluded_count=0; positive_count=0; negative_count=0; pool_feature_count=0;
      for(int i=0;i<S2B_COMPACT_POOL_SIZE;i++) pool_feature_idx[i]=-1;
      ArrayResize(eligible_record_indices,0); ArrayResize(row_mask_flags,0);
      historical_confirmation_used=false; threshold_selected=false;
   }
};
struct SS2BStopD2024HoldoutGuard
{
   bool tripped; datetime first_reserved_entry_time; string first_stage;
   int snapshot_attempts,risklab_attempts,rowset_attempts;
   void Reset(){tripped=false;first_reserved_entry_time=0;first_stage="";snapshot_attempts=0;risklab_attempts=0;rowset_attempts=0;}
};
SS2BStopD2024Protocol g_s2b_stop_d2024_protocol;
SS2BStopD2024Context g_s2b_stop_d2024_context;
SS2BStopD2024HoldoutGuard g_s2b_stop_d2024_holdout_guard;
SS2BFold g_s2b_stop_d2024_folds[]; int g_s2b_stop_d2024_fold_count=0;
SCompactResult g_s2b_stop_d2024_baseline;
SCompactResult g_s2b_stop_d2024_candidates[]; int g_s2b_stop_d2024_candidate_count=0; int g_s2b_stop_d2024_selected_index=-1;
bool g_s2b_stop_d2024_search_executed=false, g_s2b_stop_d2024_candidate_locked=false;
string g_s2b_stop_d2024_block_reason="NOT_RUN";
void S2B_StopD2024_TripLiveGuard(datetime entry_time,string stage)
{
   if(inp_s2b_stop_d2024_run_mode==STOP_D2024_DISABLED) return;
   datetime h0=StringToTime("2024.01.01"),h1=StringToTime("2027.01.01");
   if(inp_s2b_stop_d2024_run_mode==STOP_D2024_HOLDOUT_ONCE)
   {
      if(entry_time>=h0 && entry_time<h1) return;
      if(!g_s2b_stop_d2024_holdout_guard.tripped){g_s2b_stop_d2024_holdout_guard.first_reserved_entry_time=entry_time;g_s2b_stop_d2024_holdout_guard.first_stage=stage;}
      g_s2b_stop_d2024_holdout_guard.tripped=true;
      Print("STOP_D2024_HOLDOUT_WINDOW_GUARD|FAIL|Stage=",stage,"|Time=",TimeToString(entry_time,TIME_DATE|TIME_MINUTES));
      return;
   }
   if(entry_time<h0) return;
   if(!g_s2b_stop_d2024_holdout_guard.tripped){g_s2b_stop_d2024_holdout_guard.first_reserved_entry_time=entry_time;g_s2b_stop_d2024_holdout_guard.first_stage=stage;}
   g_s2b_stop_d2024_holdout_guard.tripped=true;
   if(stage=="SNAPSHOT_APPEND") g_s2b_stop_d2024_holdout_guard.snapshot_attempts++;
   else if(stage=="RISKLAB_APPEND") g_s2b_stop_d2024_holdout_guard.risklab_attempts++;
   Print("STOP_D2024_LIVE_HOLDOUT_GUARD|FAIL|Stage=",stage,"|Time=",TimeToString(entry_time,TIME_DATE|TIME_MINUTES));
}
void S2B_StopD2024_ResetCycleState()
{
   g_s2b_stop_d2024_protocol.Reset(); g_s2b_stop_d2024_context.Reset();
   ArrayResize(g_s2b_stop_d2024_folds,0); g_s2b_stop_d2024_fold_count=0;
   g_s2b_stop_d2024_baseline.Reset(); ArrayResize(g_s2b_stop_d2024_candidates,0);
   g_s2b_stop_d2024_candidate_count=0; g_s2b_stop_d2024_selected_index=-1;
   g_s2b_stop_d2024_search_executed=false; g_s2b_stop_d2024_candidate_locked=false; g_s2b_stop_d2024_block_reason="";
}
bool S2B_StopD2024_ValidateRunBoundary(string &reason)
{
   reason=""; datetime cut=StringToTime("2024.01.01");
   if(g_s2b_stop_d2024_holdout_guard.tripped){reason="LIVE_HOLDOUT_GUARD_TRIPPED|"+g_s2b_stop_d2024_holdout_guard.first_stage;return false;}
   for(int i=0;i<g_snapshot_count;i++) if(g_snapshots[i].entry_time>=cut){reason="SNAPSHOT_AT_OR_AFTER_2024";return false;}
   for(int i=0;i<g_risklab_count;i++) if(g_risklab_records[i].entry_time>=cut){reason="RISKLAB_AT_OR_AFTER_2024";return false;}
   if(inp_s2d_run_mode!=MODE_TRAIN_EXPORT){reason="RUN_MODE_NOT_TRAIN_EXPORT";return false;}
   if(!inp_enable_export){reason="EXPORT_DISABLED";return false;}
   if(g_risklab_count<=0){reason="NO_RISKLAB_RECORDS";return false;}
   return true;
}
bool S2B_StopD2024_BuildFolds(string &reason)
{
   reason=""; ArrayResize(g_s2b_stop_d2024_folds,3); for(int i=0;i<3;i++) g_s2b_stop_d2024_folds[i].Reset();
   datetime d0=StringToTime("2018.01.01"), d21=StringToTime("2021.01.01"), d22=StringToTime("2022.01.01"), d23=StringToTime("2023.01.01"), d24=StringToTime("2024.01.01");
   g_s2b_stop_d2024_folds[0].name="WF_F1_Train2018_2020_Val2021"; g_s2b_stop_d2024_folds[0].train_from=d0; g_s2b_stop_d2024_folds[0].train_to=d21; g_s2b_stop_d2024_folds[0].val_from=d21; g_s2b_stop_d2024_folds[0].val_to=d22;
   g_s2b_stop_d2024_folds[1].name="WF_F2_Train2018_2021_Val2022"; g_s2b_stop_d2024_folds[1].train_from=d0; g_s2b_stop_d2024_folds[1].train_to=d22; g_s2b_stop_d2024_folds[1].val_from=d22; g_s2b_stop_d2024_folds[1].val_to=d23;
   g_s2b_stop_d2024_folds[2].name="WF_F3_Train2018_2022_Val2023"; g_s2b_stop_d2024_folds[2].train_from=d0; g_s2b_stop_d2024_folds[2].train_to=d23; g_s2b_stop_d2024_folds[2].val_from=d23; g_s2b_stop_d2024_folds[2].val_to=d24;
   for(int i=0;i<3;i++){g_s2b_stop_d2024_folds[i].is_primary=true;g_s2b_stop_d2024_folds[i].is_warmup=false;if(g_s2b_stop_d2024_folds[i].val_to>d24){reason="FOLD_TOUCHES_HOLDOUT";return false;}}
   g_s2b_stop_d2024_fold_count=3; return true;
}
string S2B_StopD2024_BuildDevDatasetHash()
{
   string k="STOP_D2024_DATASET|"+_Symbol+"|";
   datetime a=StringToTime("2018.01.01"),b=StringToTime("2024.01.01"); int n=0;
   for(int i=0;i<g_risklab_count;i++){SRiskLabRecord r=g_risklab_records[i];if(r.entry_time<a||r.entry_time>=b)continue;n++;k+=IntegerToString(r.setup_id)+"@"+S2B_TimeKey(r.entry_time)+"@"+IntegerToString(r.stop_flag?1:0)+"@"+IntegerToString(r.target_flag?1:0)+"@"+IntegerToString(r.hit_step4_plus?1:0)+"@"+IntegerToString(r.max_step_reached)+"@"+DoubleToString(r.pnl,8)+"|";}
   return S2B_HashToString(S2B_HashString32("N="+IntegerToString(n)+"|"+k));
}
string S2B_StopD2024_BuildFeatureMatrixHash(int &rows[],int n,int &pool[],int np)
{
   string k="STOP_D2024_FEATURE_MATRIX|N="+IntegerToString(n)+"|P="+IntegerToString(np)+"|";
   for(int i=0;i<n;i++){int ri=rows[i];k+=IntegerToString(g_risklab_records[ri].setup_id)+"@"+S2B_TimeKey(g_risklab_records[ri].entry_time)+"@";for(int p=0;p<np;p++){double v=0.0;S2B_GetFeatureValue(ri,pool[p],v);k+=DoubleToString(v,12)+",";}k+="|";}
   return S2B_HashToString(S2B_HashString32(k));
}
string S2B_StopD2024_BuildRowMaskHash(int &rows[],int n)
{
   string k="STOP_D2024_ROWMASK_DEV_ONLY|N="+IntegerToString(n)+"|";for(int i=0;i<n;i++){int ri=rows[i];k+=IntegerToString(g_risklab_records[ri].setup_id)+"@"+S2B_TimeKey(g_risklab_records[ri].entry_time)+"@"+IntegerToString(g_risklab_records[ri].stop_flag?1:0)+"|";}return S2B_HashToString(S2B_HashString32(k));
}
bool S2B_StopD2024_InitProtocol(string &reason)
{
   reason=""; g_s2b_stop_d2024_protocol.Reset(); g_s2b_stop_d2024_context.Reset();
   datetime a=StringToTime("2018.01.01"),b=StringToTime("2024.01.01");
   g_s2b_stop_d2024_protocol.development_from=a;g_s2b_stop_d2024_protocol.development_to=b;g_s2b_stop_d2024_protocol.reserved_holdout_from=b;
   int pool[];S2B_FillStopCompactPoolFeatures(pool);g_s2b_stop_d2024_protocol.pool_feature_count=ArraySize(pool);for(int p=0;p<ArraySize(pool);p++)g_s2b_stop_d2024_protocol.pool_feature_idx[p]=pool[p];
   if(!S2B_StopD2024_BuildFolds(reason)){ArrayFree(pool);return false;}
   ArrayResize(g_s2b_stop_d2024_protocol.row_mask_flags,g_risklab_count);ArrayInitialize(g_s2b_stop_d2024_protocol.row_mask_flags,0);ArrayResize(g_s2b_stop_d2024_protocol.eligible_record_indices,g_risklab_count);
   int n=0,pos=0,exc=0;datetime first=0,last=0;
   for(int i=0;i<g_risklab_count;i++){SRiskLabRecord r=g_risklab_records[i];if(r.entry_time<a||r.entry_time>=b)continue;g_s2b_stop_d2024_protocol.development_record_count++;bool ok=(r.max_step_reached>=1&&r.max_step_reached<=5&&StringLen(r.final_event)>0);for(int p=0;p<ArraySize(pool)&&ok;p++){double v=0.0;if(!S2B_GetFeatureValue(i,pool[p],v))ok=false;}if(!ok){exc++;continue;}g_s2b_stop_d2024_protocol.row_mask_flags[i]=1;g_s2b_stop_d2024_protocol.eligible_record_indices[n++]=i;if(r.stop_flag)pos++;if(first==0||r.entry_time<first)first=r.entry_time;if(last==0||r.entry_time>last)last=r.entry_time;}
   ArrayResize(g_s2b_stop_d2024_protocol.eligible_record_indices,n);g_s2b_stop_d2024_protocol.eligible_count=n;g_s2b_stop_d2024_protocol.excluded_count=exc;g_s2b_stop_d2024_protocol.positive_count=pos;g_s2b_stop_d2024_protocol.negative_count=n-pos;g_s2b_stop_d2024_protocol.first_entry_time=first;g_s2b_stop_d2024_protocol.last_entry_time=last;g_s2b_stop_d2024_protocol.snapshot_count=g_snapshot_count;g_s2b_stop_d2024_protocol.risklab_count=g_risklab_count;
   g_s2b_stop_d2024_protocol.dataset_hash=S2B_StopD2024_BuildDevDatasetHash();g_s2b_stop_d2024_protocol.row_mask_hash=S2B_StopD2024_BuildRowMaskHash(g_s2b_stop_d2024_protocol.eligible_record_indices,n);g_s2b_stop_d2024_protocol.feature_matrix_hash=S2B_StopD2024_BuildFeatureMatrixHash(g_s2b_stop_d2024_protocol.eligible_record_indices,n,pool,ArraySize(pool));g_s2b_stop_d2024_protocol.pool_hash=S2B_BuildStopPoolHash(pool,ArraySize(pool));g_s2b_stop_d2024_protocol.target_hash=S2B_HashToString(S2B_HashString32("TARGET|StopFlag|rec.stop_flag == true"));g_s2b_stop_d2024_protocol.row_policy_hash=S2B_HashToString(S2B_HashString32(S2B_STOP_D2024_ROW_POLICY_VERSION));g_s2b_stop_d2024_protocol.fold_hash=S2B_BuildFoldHash(g_s2b_stop_d2024_folds,g_s2b_stop_d2024_fold_count);
   string pk="CYCLE="+S2B_STOP_D2024_CYCLE_ID+"|VER="+S2B_STOP_D2024_PROTOCOL_VERSION+"|DEV=2018.01.01/2024.01.01|HOLDOUT_FROM=2024.01.01|DATA="+g_s2b_stop_d2024_protocol.dataset_hash+"|FM="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"|MASK="+g_s2b_stop_d2024_protocol.row_mask_hash+"|FOLD="+g_s2b_stop_d2024_protocol.fold_hash+"|POOL="+g_s2b_stop_d2024_protocol.pool_hash+"|ALLOW_HOLDOUT=0";g_s2b_stop_d2024_protocol.protocol_hash=S2B_HashToString(S2B_HashString32(pk));
   g_s2b_stop_d2024_context.evaluator_version=S2B_STOP_D2024_EVALUATOR_VERSION;g_s2b_stop_d2024_context.development_from=a;g_s2b_stop_d2024_context.development_to=b;g_s2b_stop_d2024_context.historical_confirmation_from=b;g_s2b_stop_d2024_context.historical_confirmation_to=0;g_s2b_stop_d2024_context.shared_protocol_hash=g_s2b_stop_d2024_protocol.protocol_hash;g_s2b_stop_d2024_context.fold_hash=g_s2b_stop_d2024_protocol.fold_hash;g_s2b_stop_d2024_context.dataset_hash=g_s2b_stop_d2024_protocol.dataset_hash;g_s2b_stop_d2024_context.feature_matrix_hash=g_s2b_stop_d2024_protocol.feature_matrix_hash;g_s2b_stop_d2024_context.row_mask_hash=g_s2b_stop_d2024_protocol.row_mask_hash;g_s2b_stop_d2024_context.target_hash=g_s2b_stop_d2024_protocol.target_hash;g_s2b_stop_d2024_context.pool_hash=g_s2b_stop_d2024_protocol.pool_hash;g_s2b_stop_d2024_context.row_policy_hash=g_s2b_stop_d2024_protocol.row_policy_hash;g_s2b_stop_d2024_context.eligible_count=n;g_s2b_stop_d2024_context.excluded_count=exc;g_s2b_stop_d2024_context.positive_count=pos;g_s2b_stop_d2024_context.negative_count=n-pos;g_s2b_stop_d2024_context.pool_feature_count=ArraySize(pool);for(int p=0;p<ArraySize(pool);p++)g_s2b_stop_d2024_context.pool_feature_idx[p]=pool[p];ArrayResize(g_s2b_stop_d2024_context.row_mask_flags,g_risklab_count);ArrayCopy(g_s2b_stop_d2024_context.row_mask_flags,g_s2b_stop_d2024_protocol.row_mask_flags);ArrayResize(g_s2b_stop_d2024_context.eligible_record_indices,n);ArrayCopy(g_s2b_stop_d2024_context.eligible_record_indices,g_s2b_stop_d2024_protocol.eligible_record_indices);
   string ck="CTX|PROTO="+g_s2b_stop_d2024_protocol.protocol_hash+"|DATA="+g_s2b_stop_d2024_protocol.dataset_hash+"|FM="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"|MASK="+g_s2b_stop_d2024_protocol.row_mask_hash+"|FOLD="+g_s2b_stop_d2024_protocol.fold_hash+"|N="+IntegerToString(n)+"|POS="+IntegerToString(pos);g_s2b_stop_d2024_context.evaluation_context_hash=S2B_HashToString(S2B_HashString32(ck));
   ArrayFree(pool);if(n<S2B_STOP_D2024_MIN_TRAIN_N||pos<S2B_STOP_D2024_MIN_TRAIN_POS){reason="INSUFFICIENT_DEVELOPMENT_ROWS_OR_POSITIVES";return false;}g_s2b_stop_d2024_protocol.valid=true;g_s2b_stop_d2024_context.valid=true;return true;
}
int S2B_StopD2024_CollectMaskedRows(datetime from_t,datetime to_t,int &out_rows[])
{
   ArrayResize(out_rows,0);if(!g_s2b_stop_d2024_context.valid||from_t<g_s2b_stop_d2024_context.development_from||to_t>g_s2b_stop_d2024_context.development_to||from_t>=to_t){g_s2b_stop_d2024_block_reason="INVALID_OR_HOLDOUT_ROW_WINDOW";return 0;}ArrayResize(out_rows,g_s2b_stop_d2024_context.eligible_count);int n=0;for(int i=0;i<g_risklab_count;i++){if(g_s2b_stop_d2024_context.row_mask_flags[i]!=1)continue;datetime t=g_risklab_records[i].entry_time;if(t>=from_t&&t<to_t)out_rows[n++]=i;}ArrayResize(out_rows,n);return n;
}
bool S2B_StopD2024_ValidateRowSetDevelopmentOnly(int &rows[],int row_count,datetime expected_from,datetime expected_to,string stage_name,string &reason)
{
   reason="";datetime a=StringToTime("2018.01.01"),b=StringToTime("2024.01.01");if(expected_from<a||expected_to>b||expected_from>=expected_to){reason="INVALID_EXPECTED_WINDOW|"+stage_name;return false;}for(int i=0;i<row_count;i++){int ri=rows[i];if(ri<0||ri>=g_risklab_count){reason="REC_IDX_OOB|"+stage_name;return false;}datetime t=g_risklab_records[ri].entry_time;if(t<a||t>=b||t<expected_from||t>=expected_to||g_s2b_stop_d2024_context.row_mask_flags[ri]!=1){if(t>=b)g_s2b_stop_d2024_holdout_guard.rowset_attempts++;reason="ROW_OUTSIDE_DEVELOPMENT|"+stage_name+"|REC="+IntegerToString(ri);g_s2b_stop_d2024_holdout_guard.tripped=true;return false;}}return true;
}
bool S2B_StopD2024_ValidateRowsAnyDev(int &rows[],int count,string stage,string &reason){return S2B_StopD2024_ValidateRowSetDevelopmentOnly(rows,count,StringToTime("2018.01.01"),StringToTime("2024.01.01"),stage,reason);}
bool S2B_StopD2024_TrainValidated(int &fi[],int nf,int &rows[],int n,SStage2B_ModelParams &m,int ep=4000,double lr=0.05,double la=0.01){string r="";if(!S2B_StopD2024_ValidateRowsAnyDev(rows,n,"BEFORE_TRAIN",r)){g_s2b_stop_d2024_block_reason=r;return false;}return S2B_TrainLogistic_OnRows_Stop(fi,nf,rows,n,m,ep,lr,la);}
bool S2B_StopD2024_EvalValidated(SStage2B_ModelParams &m,int &rows[],int n,double &a,double &p,double &mc,double &pr,double &re,double &f2,int &on,int &op,double &sp,double &sn){string r="";if(!S2B_StopD2024_ValidateRowsAnyDev(rows,n,"BEFORE_EVAL",r)){g_s2b_stop_d2024_block_reason=r;return false;}return S2B_EvalModel_OnRows_Stop(m,rows,n,a,p,mc,pr,re,f2,on,op,sp,sn);}
bool S2B_StopD2024_PassAbsoluteGate(SCompactResult &r,string &why)
{
   why="";if(r.wf_mean_auc<0.55){why="WF_MEAN_AUC_BELOW_0.55";return false;}if(r.wf_worst_auc<0.52){why="WF_WORST_AUC_BELOW_0.52";return false;}if(r.wf_std_auc>0.04){why="WF_STD_AUC_ABOVE_0.04";return false;}if(r.valid_primary_folds<3){why="VALID_PRIMARY_FOLDS_BELOW_3";return false;}if(r.sign_flip_count>0){why="SIGN_FLIPS_DETECTED";return false;}if(r.large_drift_count>1){why="LARGE_DRIFT_ABOVE_1";return false;}return true;
}
bool S2B_StopD2024_EvaluateSubsetWF(int &feat_indices[], int n_feat,
                                SCompactResult &out)
{
   out.Reset();
   out.n_feat = n_feat;
   if(n_feat <= 0 || n_feat > S2B_COMPACT_POOL_SIZE)
      return false;
   for(int k = 0; k < n_feat; k++)
   {
      out.feat_idx[k] = feat_indices[k];
      if(!S2B_IsStopCompactPoolFeature(feat_indices[k]))
      {
         Print("S2B_EvaluateSubset_WF_Stop: feature outside Stop pool: ",
               S2B_FeatureName(feat_indices[k]));
         return false;
      }
   }
   out.feat_names = S2B_BuildFeatureListString(feat_indices, n_feat);
   if(!g_s2b_stop_d2024_context.valid)
   {
      if(!S2B_InitStopEvaluationContext())
         return false;
   }
   out.protocol_hash = g_s2b_stop_d2024_context.shared_protocol_hash;
   out.fold_hash = g_s2b_stop_d2024_context.fold_hash;
   out.row_mask_hash = g_s2b_stop_d2024_context.row_mask_hash;
   out.dataset_hash = g_s2b_stop_d2024_context.dataset_hash;
   out.evaluator_version = g_s2b_stop_d2024_context.evaluator_version;
   out.valid_row_policy = g_s2b_stop_d2024_context.valid_row_policy;
   out.feature_hash = S2B_BuildFeatureHash(feat_indices, n_feat);
   out.evaluation_context_hash = g_s2b_stop_d2024_context.evaluation_context_hash;
   out.target_hash = g_s2b_stop_d2024_context.target_hash;
   out.pool_hash = g_s2b_stop_d2024_context.pool_hash;
   out.row_policy_hash = g_s2b_stop_d2024_context.row_policy_hash;
   out.eligible_count = g_s2b_stop_d2024_context.eligible_count;
   out.excluded_count = g_s2b_stop_d2024_context.excluded_count;
   out.snapshot_count = g_s2b_stop_d2024_protocol.snapshot_count;
   out.risklab_count = g_s2b_stop_d2024_protocol.risklab_count;
   out.first_entry_time = g_s2b_stop_d2024_protocol.first_entry_time;
   out.last_entry_time = g_s2b_stop_d2024_protocol.last_entry_time;
   out.fold_count = g_s2b_stop_d2024_fold_count;
   double fold_auc[S2B_MAX_FOLDS];
   bool fold_valid_local[S2B_MAX_FOLDS];
   double fold_weights[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_std[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_val_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   for(int f = 0; f < S2B_MAX_FOLDS; f++)
   {
      fold_auc[f] = 0.0;
      fold_valid_local[f] = false;
      for(int k = 0; k < S2B_COMPACT_POOL_SIZE; k++)
      {
         fold_weights[f][k] = 0.0;
         fold_train_mean[f][k] = 0.0;
         fold_train_std[f][k] = 1.0;
         fold_val_mean[f][k] = 0.0;
      }
   }
   int valid_primary = 0;
   double auc_sum = 0.0;
   double pr_sum = 0.0;
   double pr_lift_sum = 0.0;
   double mcc_sum = 0.0;
   double rec_sum = 0.0;
   double f2_sum = 0.0;
   double auc_min = 9999.0;
   for(int f = 0; f < g_s2b_stop_d2024_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      out.fold_name[f] = g_s2b_stop_d2024_folds[f].name;
      out.fold_is_primary[f] = (g_s2b_stop_d2024_folds[f].is_primary ? 1 : 0);
      out.fold_train_from[f] = g_s2b_stop_d2024_folds[f].train_from;
      out.fold_train_to[f] = g_s2b_stop_d2024_folds[f].train_to;
      out.fold_val_from[f] = g_s2b_stop_d2024_folds[f].val_from;
      out.fold_val_to[f] = g_s2b_stop_d2024_folds[f].val_to;
      int train_rows[];
      int val_rows[];
      int n_tr = S2B_StopD2024_CollectMaskedRows(
         g_s2b_stop_d2024_folds[f].train_from, g_s2b_stop_d2024_folds[f].train_to, train_rows);
      int n_va = S2B_StopD2024_CollectMaskedRows(
         g_s2b_stop_d2024_folds[f].val_from, g_s2b_stop_d2024_folds[f].val_to, val_rows);
      int pos_tr = 0;
      int pos_va = 0;
      double tr_sum[S2B_COMPACT_POOL_SIZE];
      double tr_sumsq[S2B_COMPACT_POOL_SIZE];
      double va_sum[S2B_COMPACT_POOL_SIZE];
      ArrayInitialize(tr_sum, 0.0);
      ArrayInitialize(tr_sumsq, 0.0);
      ArrayInitialize(va_sum, 0.0);
      for(int i = 0; i < n_tr; i++)
      {
         int rec_idx = train_rows[i];
         if(S2B_GetStopTargetAligned(rec_idx) == 1) pos_tr++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("STOP_CONTEXT invariant failure in train row=", rec_idx);
               return false;
            }
            tr_sum[k] += v;
            tr_sumsq[k] += v * v;
         }
      }
      for(int i = 0; i < n_va; i++)
      {
         int rec_idx = val_rows[i];
         if(S2B_GetStopTargetAligned(rec_idx) == 1) pos_va++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("STOP_CONTEXT invariant failure in validation row=", rec_idx);
               return false;
            }
            va_sum[k] += v;
         }
      }
      out.fold_train_n[f] = n_tr;
      out.fold_train_pos[f] = pos_tr;
      out.fold_train_neg[f] = n_tr - pos_tr;
      out.fold_val_n[f] = n_va;
      out.fold_val_pos[f] = pos_va;
      out.fold_val_neg[f] = n_va - pos_va;
      out.fold_val_prevalence[f] = (n_va > 0 ? (double)pos_va / n_va : 0.0);
      out.fold_low_positive_sample[f] = ((pos_tr < 10 || pos_va < 5) ? 1 : 0);
      for(int k = 0; k < n_feat; k++)
      {
         fold_train_mean[f][k] = (n_tr > 0 ? tr_sum[k] / n_tr : 0.0);
         double var = (n_tr > 1
                       ? tr_sumsq[k] / n_tr - fold_train_mean[f][k] * fold_train_mean[f][k]
                       : 1.0);
         fold_train_std[f][k] = (var > 1e-12 ? MathSqrt(var) : 1.0);
         fold_val_mean[f][k] = (n_va > 0 ? va_sum[k] / n_va : 0.0);
      }
      if(n_tr < S2B_STOP_D2024_MIN_TRAIN_N ||
         pos_tr < S2B_STOP_D2024_MIN_TRAIN_POS ||
         n_va < S2B_STOP_D2024_MIN_VAL_N ||
         pos_va < S2B_STOP_D2024_MIN_VAL_POS ||
         (n_tr-pos_tr) <= 0 || (n_va-pos_va) <= 0)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      SStage2B_ModelParams fold_mdl;
      bool trained = S2B_StopD2024_TrainValidated(
         feat_indices, n_feat, train_rows, n_tr, fold_mdl, 4000, 0.05, 0.01);
      if(!trained || !fold_mdl.trained)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      for(int k = 0; k < n_feat; k++)
         fold_weights[f][k] = fold_mdl.weights[k];
      out.fold_coeff_signs[f] = S2B_BuildCoeffSignString(fold_mdl);
      double tr_auc=0.5, tr_prauc=0.0, tr_mcc=0.0, tr_prec=0.0, tr_rec=0.0, tr_f2=0.0;
      int tr_n=0, tr_pos_eval=0;
      double tr_mean_pos=0.0, tr_mean_neg=0.0;
      bool train_eval_ok = S2B_StopD2024_EvalValidated(
         fold_mdl, train_rows, n_tr,
         tr_auc, tr_prauc, tr_mcc, tr_prec, tr_rec, tr_f2,
         tr_n, tr_pos_eval, tr_mean_pos, tr_mean_neg);
      double va_auc=0.5, va_prauc=0.0, va_mcc=0.0, va_prec=0.0, va_rec=0.0, va_f2=0.0;
      int va_n=0, va_pos_eval=0;
      double va_mean_pos=0.0, va_mean_neg=0.0;
      bool eval_ok = S2B_StopD2024_EvalValidated(
         fold_mdl, val_rows, n_va,
         va_auc, va_prauc, va_mcc, va_prec, va_rec, va_f2,
         va_n, va_pos_eval, va_mean_pos, va_mean_neg);
      ArrayFree(train_rows);
      ArrayFree(val_rows);
      if(!train_eval_ok || !eval_ok ||
         va_n < S2B_STOP_D2024_MIN_VAL_N ||
         va_pos_eval < S2B_STOP_D2024_MIN_VAL_POS)
      {
         out.fold_valid[f] = 0;
         continue;
      }
      double prevalence = (va_n > 0 ? (double)va_pos_eval / va_n : 0.0);
      double pr_lift = (prevalence > 0.0 ? va_prauc / prevalence : 0.0);
      out.fold_train_auc[f] = tr_auc;
      out.fold_auc[f] = va_auc;
      out.fold_auc_gap[f] = tr_auc - va_auc;
      out.fold_prauc[f] = va_prauc;
      out.fold_pr_lift[f] = pr_lift;
      out.fold_precision[f] = va_prec;
      out.fold_mcc[f] = va_mcc;
      out.fold_recall[f] = va_rec;
      out.fold_f2[f] = va_f2;
      out.fold_val_prevalence[f] = prevalence;
      out.fold_train_mean_score_pos[f] = tr_mean_pos;
      out.fold_train_mean_score_neg[f] = tr_mean_neg;
      out.fold_val_mean_score_pos[f] = va_mean_pos;
      out.fold_val_mean_score_neg[f] = va_mean_neg;
      fold_auc[f] = va_auc;
      fold_valid_local[f] = true;
      out.fold_valid[f] = 1;
      if(g_s2b_stop_d2024_folds[f].is_primary)
      {
         valid_primary++;
         auc_sum += va_auc;
         pr_sum += va_prauc;
         pr_lift_sum += pr_lift;
         mcc_sum += va_mcc;
         rec_sum += va_rec;
         f2_sum += va_f2;
         if(va_auc < auc_min) auc_min = va_auc;
      }
   }
   out.valid_primary_folds = valid_primary;
   if(valid_primary < 1)
      return false;
   out.wf_mean_auc = auc_sum / valid_primary;
   out.wf_worst_auc = auc_min;
   out.wf_mean_prauc = pr_sum / valid_primary;
   out.wf_mean_pr_lift = pr_lift_sum / valid_primary;
   out.wf_mean_mcc = mcc_sum / valid_primary;
   out.wf_mean_recall = rec_sum / valid_primary;
   out.wf_mean_f2 = f2_sum / valid_primary;
   double auc_var = 0.0;
   for(int f = 0; f < g_s2b_stop_d2024_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(!fold_valid_local[f] || !g_s2b_stop_d2024_folds[f].is_primary) continue;
      auc_var += MathPow(fold_auc[f] - out.wf_mean_auc, 2);
   }
   out.wf_std_auc = (valid_primary > 1 ? MathSqrt(auc_var / valid_primary) : 0.0);
   out.sign_flip_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      bool first_set = false;
      bool first_pos = false;
      bool flip = false;
      for(int f = 0; f < g_s2b_stop_d2024_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f] || !g_s2b_stop_d2024_folds[f].is_primary) continue;
         bool is_pos = (fold_weights[f][k] >= 0.0);
         if(!first_set)
         {
            first_set = true;
            first_pos = is_pos;
         }
         else if(is_pos != first_pos)
         {
            flip = true;
            break;
         }
      }
      if(flip) out.sign_flip_count++;
   }
   out.large_drift_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      int drift_hits = 0;
      for(int f = 0; f < g_s2b_stop_d2024_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f] || !g_s2b_stop_d2024_folds[f].is_primary) continue;
         double std_tr = fold_train_std[f][k];
         if(std_tr < 1e-10) std_tr = 1.0;
         double drift_abs = MathAbs((fold_val_mean[f][k] - fold_train_mean[f][k]) / std_tr);
         if(drift_abs > 0.8) drift_hits++;
      }
      if(drift_hits > 0) out.large_drift_count++;
   }
   int dev_rows[];
   int n_dev = S2B_StopD2024_CollectMaskedRows(
      g_s2b_stop_d2024_context.development_from,
      g_s2b_stop_d2024_context.development_to,
      dev_rows);
   SStage2B_ModelParams dev_mdl;
   bool dev_fit_ok = false;
   if(n_dev >= 20)
      dev_fit_ok = S2B_StopD2024_TrainValidated(
         feat_indices, n_feat, dev_rows, n_dev, dev_mdl, 5000, 0.05, 0.01);
   ArrayFree(dev_rows);
   out.dev_auc = (dev_fit_ok && dev_mdl.trained ? dev_mdl.dev_auc : 0.0);
   out.oos_auc = 0.0;
   out.oos_gap = 0.0;
   string abs_reason = "";
   out.abs_gate_pass = S2B_StopD2024_PassAbsoluteGate(out, abs_reason);
   out.abs_gate_reason = (out.abs_gate_pass ? "PASS" : abs_reason);
   // Selection policy is applied only after all candidates are evaluated.
   out.relative_gate_pass = false;
   out.reject_reason = (out.abs_gate_pass
                        ? "PENDING_DETERMINISTIC_SELECTION_POLICY"
                        : "ABSOLUTE_GATE_FAILED|" + abs_reason);
   out.selected_by_policy = false;
   out.selection_rank = 0;
   out.selection_reason = "";
   out.accepted = false;
   // Informational only; never used for candidate ordering or locking.
   out.composite_score =
      100.0 * out.wf_mean_auc
      - 20.0 * out.wf_std_auc
      - 10.0 * out.sign_flip_count
      - 5.0 * out.large_drift_count
      - 0.7 * n_feat;
   return true;
}
bool S2B_StopD2024_ValidateFoldCardinalities(string &reason)
{
   reason="";for(int f=0;f<3;f++){int tr[],va[];int nt=S2B_StopD2024_CollectMaskedRows(g_s2b_stop_d2024_folds[f].train_from,g_s2b_stop_d2024_folds[f].train_to,tr);int nv=S2B_StopD2024_CollectMaskedRows(g_s2b_stop_d2024_folds[f].val_from,g_s2b_stop_d2024_folds[f].val_to,va);int pt=0,pv=0;for(int i=0;i<nt;i++)if(S2B_GetStopTargetAligned(tr[i])==1)pt++;for(int i=0;i<nv;i++)if(S2B_GetStopTargetAligned(va[i])==1)pv++;Print("STOP_D2024_FOLD_CARDINALITY|Fold=",f+1,"|TrainN=",nt,"|TrainPos=",pt,"|ValN=",nv,"|ValPos=",pv,"|Primary=YES");ArrayFree(tr);ArrayFree(va);if(nt<50||pt<10||nv<20||pv<5||(nt-pt)<=0||(nv-pv)<=0){reason="INSUFFICIENT_FOLD_CLASS_CARDINALITY|FOLD="+IntegerToString(f+1);return false;}}return true;
}
void S2B_StopD2024_ApplySelectionPolicy()
{
   g_s2b_stop_d2024_selected_index=-1;g_s2b_stop_d2024_candidate_locked=false;for(int i=0;i<g_s2b_stop_d2024_candidate_count;i++){g_s2b_stop_d2024_candidates[i].selected_by_policy=false;g_s2b_stop_d2024_candidates[i].selection_rank=0;g_s2b_stop_d2024_candidates[i].accepted=false;g_s2b_stop_d2024_candidates[i].reject_reason=(g_s2b_stop_d2024_candidates[i].abs_gate_pass?"NOT_SELECTED_BY_DETERMINISTIC_POLICY":"ABSOLUTE_GATE_FAILED|"+g_s2b_stop_d2024_candidates[i].abs_gate_reason);}int rank=0;for(int i=0;i<g_s2b_stop_d2024_candidate_count;i++)if(g_s2b_stop_d2024_candidates[i].abs_gate_pass)g_s2b_stop_d2024_candidates[i].selection_rank=++rank;if(rank<=0){g_s2b_stop_d2024_block_reason="NO_CANDIDATE_PASSED_ABSOLUTE_GATE";return;}g_s2b_stop_d2024_selected_index=0;g_s2b_stop_d2024_candidates[0].selected_by_policy=true;g_s2b_stop_d2024_candidates[0].selection_rank=1;g_s2b_stop_d2024_candidates[0].selection_reason="ABS_GATE>WORST_AUC>STD_AUC>MEAN_PR_LIFT>FEWER_FEATURES>MEAN_AUC>FEATURE_HASH";g_s2b_stop_d2024_candidates[0].relative_gate_pass=true;g_s2b_stop_d2024_candidates[0].reject_reason="NONE";g_s2b_stop_d2024_candidates[0].accepted=true;g_s2b_stop_d2024_candidate_locked=true;
}
void S2B_StopD2024_RunCompactSearch()
{
   int pool[];S2B_FillStopCompactPoolFeatures(pool);int ss[][8],sz[];ArrayResize(ss,256);ArrayResize(sz,256);for(int i=0;i<256;i++)for(int j=0;j<8;j++)ss[i][j]=-1;int total=S2B_GenerateSubsets(4,6,ss,sz,256);ArrayResize(g_s2b_stop_d2024_candidates,total);g_s2b_stop_d2024_candidate_count=0;g_s2b_stop_d2024_search_executed=true;for(int i=0;i<total;i++){int fi[8];for(int k=0;k<sz[i];k++)fi[k]=pool[ss[i][k]];SCompactResult r;bool ok=S2B_StopD2024_EvaluateSubsetWF(fi,sz[i],r);if(!ok){r.Reset();r.n_feat=sz[i];r.reject_reason="EVALUATION_FAILED";}g_s2b_stop_d2024_candidates[g_s2b_stop_d2024_candidate_count++]=r;}int gap=g_s2b_stop_d2024_candidate_count/2;while(gap>0){for(int i=gap;i<g_s2b_stop_d2024_candidate_count;i++){SCompactResult t=g_s2b_stop_d2024_candidates[i];int j=i;while(j>=gap&&S2B_StopCandidateBetter(t,g_s2b_stop_d2024_candidates[j-gap])){g_s2b_stop_d2024_candidates[j]=g_s2b_stop_d2024_candidates[j-gap];j-=gap;}g_s2b_stop_d2024_candidates[j]=t;}gap/=2;}S2B_StopD2024_ApplySelectionPolicy();ArrayFree(pool);
}
void S2B_StopD2024_WriteFoldDiagnostics(int h,SCompactResult &r)
{
   for(int f=0;f<3;f++){string why="NONE";if(r.fold_train_n[f]<50)why="TRAIN_N_BELOW_50";else if(r.fold_train_pos[f]<10)why="TRAIN_POS_BELOW_10";else if(r.fold_val_n[f]<20)why="VAL_N_BELOW_20";else if(r.fold_val_pos[f]<5)why="VAL_POS_BELOW_5";FileWriteString(h,StringFormat("Fold%d|Name=%s|Primary=YES|Valid=%s|TrainN=%d|TrainPos=%d|TrainNeg=%d|ValN=%d|ValPos=%d|ValNeg=%d|InvalidReason=%s|AUC=%.6f|PRAUC=%.6f|PRLift=%.6f|MCC=%.6f\n",f+1,r.fold_name[f],(r.fold_valid[f]==1?"YES":"NO"),r.fold_train_n[f],r.fold_train_pos[f],r.fold_train_neg[f],r.fold_val_n[f],r.fold_val_pos[f],r.fold_val_neg[f],why,r.fold_auc[f],r.fold_prauc[f],r.fold_pr_lift[f],r.fold_mcc[f]));}
}
