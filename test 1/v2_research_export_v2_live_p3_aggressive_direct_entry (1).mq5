// ==================== SENSITIVITY BEST RESULTS ====================
#define MAX_SENS_RESULTS 200
struct SSensitivityBestResult
{
   string family_name;
   string signal;
   string target;
   string direction;
   int    tf_idx;
   string feature;
   double threshold;
   double oos_reduction;
   double oos_cov;
   double oos_avgp;
   int    oos_accepted;
   int    oos_loss_trades;
   double oos_gross_loss;
   double composite_score;
   bool   pf_stable;
   void Reset()
   {
      family_name = signal = target = direction = feature = "";
      tf_idx = -1;
      threshold = oos_reduction = oos_cov = oos_avgp = 0.0;
      oos_accepted = oos_loss_trades = 0;
      oos_gross_loss = 0.0;
      composite_score = -999999.0;
      pf_stable = true;
   }
};
SSensitivityBestResult g_sens_best_results[];
int                    g_sens_best_count = 0;
void RL_StoreSensitivityBestResult(
   string family_name, string signal, string target, string direction, int tf_idx, string feature,
   double threshold, double oos_reduction, double oos_cov, double oos_avgp, int oos_accepted,
   int oos_loss_trades, double oos_gross_loss)
{
   if(g_sens_best_count >= MAX_SENS_RESULTS) return;
   if(oos_accepted < 15) return;
   if(oos_reduction <= 0.0) return;
   int existing_idx = -1;
   for(int i = 0; i < g_sens_best_count; i++) {
      if(g_sens_best_results[i].family_name == family_name && g_sens_best_results[i].signal == signal && g_sens_best_results[i].target == target) {
         existing_idx = i; break;
      }
   }
   double log_sample = (oos_accepted > 0) ? MathLog((double)oos_accepted + 1.0) : 0.0;
   double score = (oos_reduction * COMP_SCORE_WEIGHT_REDUCTION) + (MathMin(oos_cov, 50.0) * COMP_SCORE_WEIGHT_COVERAGE) + (log_sample * COMP_SCORE_WEIGHT_SAMPLE);
   bool pf_stable = true;
   if(oos_loss_trades < COMP_PF_MIN_LOSS_TRADES && oos_gross_loss < 0.01) pf_stable = false;
   if(existing_idx >= 0) {
      if(score > g_sens_best_results[existing_idx].composite_score) {
         g_sens_best_results[existing_idx].direction       = direction;
         g_sens_best_results[existing_idx].tf_idx          = tf_idx;
         g_sens_best_results[existing_idx].feature         = feature;
         g_sens_best_results[existing_idx].threshold       = threshold;
         g_sens_best_results[existing_idx].oos_reduction   = oos_reduction;
         g_sens_best_results[existing_idx].oos_cov         = oos_cov;
         g_sens_best_results[existing_idx].oos_avgp        = oos_avgp;
         g_sens_best_results[existing_idx].oos_accepted    = oos_accepted;
         g_sens_best_results[existing_idx].oos_loss_trades = oos_loss_trades;
         g_sens_best_results[existing_idx].oos_gross_loss  = oos_gross_loss;
         g_sens_best_results[existing_idx].composite_score = score;
         g_sens_best_results[existing_idx].pf_stable       = pf_stable;
      }
      return;
   }
   int idx = g_sens_best_count;
   g_sens_best_results[idx].Reset();
   g_sens_best_results[idx].family_name = family_name;
   g_sens_best_results[idx].signal = signal;
   g_sens_best_results[idx].target = target;
   g_sens_best_results[idx].direction = direction;
   g_sens_best_results[idx].tf_idx = tf_idx;
   g_sens_best_results[idx].feature = feature;
   g_sens_best_results[idx].threshold = threshold;
   g_sens_best_results[idx].oos_reduction = oos_reduction;
   g_sens_best_results[idx].oos_cov = oos_cov;
   g_sens_best_results[idx].oos_avgp = oos_avgp;
   g_sens_best_results[idx].oos_accepted = oos_accepted;
   g_sens_best_results[idx].oos_loss_trades = oos_loss_trades;
   g_sens_best_results[idx].oos_gross_loss = oos_gross_loss;
   g_sens_best_results[idx].composite_score = score;
   g_sens_best_results[idx].pf_stable = pf_stable;
   g_sens_best_count++;
}
double RL_Clamp01(double v)
{
   if(v < 0.0) return 0.0;
   if(v > 1.0) return 1.0;
   return v;
}
double RL_ReductionScore(double oos_reduction)
{
   return RL_Clamp01(oos_reduction / 3.0);
}
double RL_PnLScore(double avgp)
{
   double v = avgp / 3.0;
   if(v > 1.0) v = 1.0;
   if(v < -1.0) v = -1.0;
   return v;
}
double RL_SampleScore(int accepted)
{
   double v = MathSqrt((double)MathMax(1, accepted) / 100.0);
   if(v > 1.0) v = 1.0;
   return v;
}
double RL_CoverageScore(double cov_pct)
{
   double v = cov_pct / 30.0;
   if(v > 1.0) v = 1.0;
   if(v < 0.0) v = 0.0;
   return v;
}
string RL_GetConsistencyType(double dev_red, double oos_red)
{
   if(dev_red <= 0.0 && oos_red > 0.0)
      return "OOS_BETTER";
   if(dev_red > 0.0 && oos_red < 0.0)
      return "SIGN_REVERSAL";
   if(dev_red > 0.0 && oos_red > 0.0)
   {
      double ratio = oos_red / MathMax(MathAbs(dev_red), 0.000001);
      if(ratio >= 1.0)  return "OOS_BETTER";
      if(ratio >= 0.8)  return "STABLE";
      if(ratio >= 0.6)  return "MILD_DEGRADATION";
      if(ratio >= 0.0)  return "SEVERE_DEGRADATION";
   }
   if(oos_red > 0.0)
      return "STABLE";
   return "SIGN_REVERSAL";
}
double RL_GetConsistencyMultiplier(string ctype)
{
   if(ctype == "OOS_BETTER")         return 1.20;
   if(ctype == "STABLE")             return 1.00;
   if(ctype == "MILD_DEGRADATION")   return 0.90;
   if(ctype == "SEVERE_DEGRADATION") return 0.70;
   return 0.50; // SIGN_REVERSAL
}
void RL_AddSensitivityThresholdRow(
   string family_name,
   string signal,
   string target,
   string direction,
   int    tf_idx,
   string feature,
   double threshold,
   int    dev_total,
   int    dev_accepted,
   double dev_cov,
   double dev_bad_pct,
   double dev_baseline_bad_pct,
   double dev_reduction,
   double dev_avgp,
   double dev_delta_avgp,
   int    oos_total,
   int    oos_accepted,
   double oos_cov,
   double oos_bad_pct,
   double oos_baseline_bad_pct,
   double oos_reduction,
   double oos_avgp,
   double oos_delta_avgp,
   int    oos_loss_trades,
   double oos_gross_loss)
{
   if(g_sens_threshold_row_count >= MAX_SENS_THRESHOLD_ROWS)
      return;
   int idx = g_sens_threshold_row_count;
   g_sens_threshold_rows[idx].Reset();
   g_sens_threshold_rows[idx].family_name          = family_name;
   g_sens_threshold_rows[idx].signal               = signal;
   g_sens_threshold_rows[idx].target               = target;
   g_sens_threshold_rows[idx].direction            = direction;
   g_sens_threshold_rows[idx].tf_idx               = tf_idx;
   g_sens_threshold_rows[idx].feature              = feature;
   g_sens_threshold_rows[idx].threshold            = threshold;
   g_sens_threshold_rows[idx].dev_total            = dev_total;
   g_sens_threshold_rows[idx].dev_accepted         = dev_accepted;
   g_sens_threshold_rows[idx].dev_cov              = dev_cov;
   g_sens_threshold_rows[idx].dev_bad_pct          = dev_bad_pct;
   g_sens_threshold_rows[idx].dev_baseline_bad_pct = dev_baseline_bad_pct;
   g_sens_threshold_rows[idx].dev_reduction        = dev_reduction;
   g_sens_threshold_rows[idx].dev_avgp             = dev_avgp;
   g_sens_threshold_rows[idx].dev_delta_avgp       = dev_delta_avgp;
   g_sens_threshold_rows[idx].oos_total            = oos_total;
   g_sens_threshold_rows[idx].oos_accepted         = oos_accepted;
   g_sens_threshold_rows[idx].oos_cov              = oos_cov;
   g_sens_threshold_rows[idx].oos_bad_pct          = oos_bad_pct;
   g_sens_threshold_rows[idx].oos_baseline_bad_pct = oos_baseline_bad_pct;
   g_sens_threshold_rows[idx].oos_reduction        = oos_reduction;
   g_sens_threshold_rows[idx].oos_avgp             = oos_avgp;
   g_sens_threshold_rows[idx].oos_delta_avgp       = oos_delta_avgp;
   g_sens_threshold_rows[idx].oos_loss_trades      = oos_loss_trades;
   g_sens_threshold_rows[idx].oos_gross_loss       = oos_gross_loss;
   g_sens_threshold_rows[idx].oos_pf_stable        = !(oos_loss_trades < COMP_PF_MIN_LOSS_TRADES && oos_gross_loss < 0.01);
   string ctype = RL_GetConsistencyType(dev_reduction, oos_reduction);
   double cmult = RL_GetConsistencyMultiplier(ctype);
   g_sens_threshold_rows[idx].consistency_type     = ctype;
   g_sens_threshold_rows[idx].consistency_mult     = cmult;
   // Statistical threshold score: OOS reduction + consistency + sample
   double stat_score = (0.75 * RL_ReductionScore(oos_reduction)
                     +  0.15 * RL_SampleScore(oos_accepted)
                     +  0.10 * RL_CoverageScore(oos_cov)) * cmult;
   // Execution threshold score: OOS reduction + avg pnl + coverage + sample
   double exec_score = (0.50 * RL_ReductionScore(oos_reduction)
                     +  0.20 * RL_PnLScore(oos_avgp)
                     +  0.20 * RL_CoverageScore(oos_cov)
                     +  0.10 * RL_SampleScore(oos_accepted)) * cmult;
   g_sens_threshold_rows[idx].statistical_threshold_score = stat_score;
   g_sens_threshold_rows[idx].execution_threshold_score   = exec_score;
   g_sens_threshold_rows[idx].selected_as_stat = false;
   g_sens_threshold_rows[idx].selected_as_exec = false;
   g_sens_threshold_rows[idx].selection_why    = "";
   g_sens_threshold_rows[idx].execution_ready     = false;
   g_sens_threshold_rows[idx].execution_ready_why = "";
   g_sens_threshold_row_count++;
}
void RL_ExportSensitivity()
{
   g_sens_best_count = 0;
   g_sens_threshold_row_count = 0;
   g_sens_stat_threshold_count = 0;
   g_sens_exec_threshold_count = 0;
   if(ArraySize(g_sens_best_results) < MAX_SENS_RESULTS)
      ArrayResize(g_sens_best_results, MAX_SENS_RESULTS);
   if(ArraySize(g_sens_threshold_rows) < MAX_SENS_THRESHOLD_ROWS)
      ArrayResize(g_sens_threshold_rows, MAX_SENS_THRESHOLD_ROWS);
   if(ArraySize(g_sens_stat_thresholds) < MAX_SELECTED_THRESHOLDS)
      ArrayResize(g_sens_stat_thresholds, MAX_SELECTED_THRESHOLDS);
   if(ArraySize(g_sens_exec_thresholds) < MAX_SELECTED_THRESHOLDS)
      ArrayResize(g_sens_exec_thresholds, MAX_SELECTED_THRESHOLDS);
   for(int i = 0; i < MAX_SENS_RESULTS; i++)
      g_sens_best_results[i].Reset();
   for(int i = 0; i < MAX_SENS_THRESHOLD_ROWS; i++)
      g_sens_threshold_rows[i].Reset();
   for(int i = 0; i < MAX_SELECTED_THRESHOLDS; i++)
   {
      g_sens_stat_thresholds[i].Reset();
      g_sens_exec_thresholds[i].Reset();
   }
   string fn = "Sensitivity_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE)
   {
      Print("RL_ExportSensitivity: Cannot create file.");
      return;
   }
   FileWriteString(h, "Status,Reason,Action\r\n");
   FileWriteString(h,
      "BYPASSED,"
      "Contaminated selector chain disabled (OOS-informed threshold/rule selection),"
      "Use protocolized S2B selector islands only (S2B v2 / StopFlag D2024)\r\n");
   FileFlush(h);
   FileClose(h);
   Print("Sensitivity bypassed: ", fn,
         " | Reason=Contaminated selector chain disabled.");
}
bool RL_GetSensFeatureValue(SRiskLabRecord &rec, string feature, int tf_idx, double &out)
{
   out = 0.0;
   //================================================================
   // PER-TF FEATURES
   //================================================================
   if(tf_idx >= 0 && tf_idx < TF_COUNT)
   {
      if(feature == "ATR")
      {
         out = rec.atr[tf_idx];
         return (out > 0.0);
      }
      if(feature == "ATR_Regime")
      {
         out = rec.atr_regime[tf_idx];
         return (out > 0.0);
      }
      if(feature == "ADX")
      {
         out = rec.adx[tf_idx];
         return (out > 0.0);
      }
      if(feature == "ADX_Slope")
      {
         out = rec.adx_slope[tf_idx];
         return MathIsValidNumber(out);
      }
      if(feature == "EMA_Compression")
      {
         out = rec.ema_compression[tf_idx];
         return (out > 0.0);
      }
      if(feature == "EMA200_Dist")
      {
         out = rec.ema200_dist[tf_idx];
         return (out > 0.0);
      }
      if(feature == "RSI")
      {
         out = rec.rsi[tf_idx];
         return (out > 0.0 && out <= 100.0);
      }
      if(feature == "CCI")
      {
         out = rec.cci[tf_idx];
         return MathIsValidNumber(out);
      }
      if(feature == "DI_Gap")
      {
         out = rec.di_gap[tf_idx];
         return (out >= 0.0);
      }
   }
   //================================================================
   // GLOBAL FEATURES موجود در RiskLab
   //================================================================
   if(feature == "Signal_BodyRatio")
   {
      out = rec.signal_body_ratio;
      return (out >= 0.0);
   }
   if(feature == "Signal_CLV")
   {
      out = rec.signal_clv;
      return (out >= 0.0 && out <= 1.0);
   }
   if(feature == "Stability")
   {
      out = (double)rec.stability;
      return (out >= 0.0);
   }
   if(feature == "DI_Agreement")
   {
      out = (double)rec.di_agreement_count;
      return (out >= 0.0);
   }
   if(feature == "EMA_Bullish")
   {
      out = (double)rec.ema_bullish_count;
      return (out >= 0.0);
   }
   if(feature == "TotalScore")
   {
      out = (double)rec.total_score;
      return true;
   }
   if(feature == "OB_DistPct")
   {
      if(rec.ob_dist_pct < 0.0) return false;
      out = rec.ob_dist_pct;
      return true;
   }
   if(feature == "OB_AgeBars")
   {
      if(rec.ob_age_bars < 0) return false;
      out = (double)rec.ob_age_bars;
      return true;
   }
   if(feature == "OB_Width_ATR")
   {
      out = rec.ob_width_atr;
      return (out > 0.0);
   }
   if(feature == "Pivot1Dist")
   {
      out = (double)rec.pivot1_dist;
      return (out > 0.0);
   }
   if(feature == "PivotSpan")
   {
      out = (double)rec.pivot2_dist;
      return (out > 0.0);
   }
   if(feature == "PivotGapMin")
   {
      out = (double)rec.pivot_gap_min;
      return (out > 0.0);
   }
   if(feature == "PivotGapMax")
   {
      out = (double)rec.pivot_gap_max;
      return (out > 0.0);
   }
   //================================================================
   // SNAPSHOT-ONLY FEATURES (joined by setup_id)
   //================================================================
   int si = RL_FindSnapshotBySetupId_ForRL(rec.setup_id);
   if(si < 0 || si >= g_snapshot_count)
      return false;
   // ---- existing divergence features ----
   if(feature == "Price_Div_Strength")
   {
      out = g_snapshots[si].price_div_strength;
      return MathIsValidNumber(out);
   }
   if(feature == "RSI_Div_Strength")
   {
      out = g_snapshots[si].rsi_div_strength;
      return MathIsValidNumber(out);
   }
   if(feature == "Div_Price_Slope")
   {
      out = g_snapshots[si].div_price_slope;
      return MathIsValidNumber(out);
   }
   if(feature == "Div_RSI_Slope")
   {
      out = g_snapshots[si].div_rsi_slope;
      return MathIsValidNumber(out);
   }
   if(feature == "Div_Span_Bars")
   {
      out = (double)g_snapshots[si].div_span_bars;
      return (g_snapshots[si].div_span_bars > 0);
   }
   if(feature == "Pivot_Symmetry")
   {
      out = g_snapshots[si].pivot_symmetry;
      return (out >= 0.0 && out <= 1.0);
   }
   if(feature == "Time_Since_P3")
   {
      out = (double)g_snapshots[si].time_since_p3;
      return (g_snapshots[si].time_since_p3 >= 0);
   }
   if(feature == "Pivot_RSI_P1")
   {
      out = g_snapshots[si].pivot_rsi_p1;
      return (out > 0.0 && out <= 100.0);
   }
   if(feature == "Pivot_RSI_P2")
   {
      out = g_snapshots[si].pivot_rsi_p2;
      return (out > 0.0 && out <= 100.0);
   }
   if(feature == "Pivot_RSI_P3")
   {
      out = g_snapshots[si].pivot_rsi_p3;
      return (out > 0.0 && out <= 100.0);
   }
   if(feature == "Price_Leg_Ratio")
   {
      out = g_snapshots[si].price_leg_ratio;
      return (out >= 0.0);
   }
   if(feature == "RSI_Acceleration")
   {
      out = g_snapshots[si].rsi_acceleration;
      return MathIsValidNumber(out);
   }
   if(feature == "Divergence_Angle")
   {
      out = g_snapshots[si].divergence_angle;
      return MathIsValidNumber(out);
   }
   // ---- Cycle 3A ----
   if(feature == "PivotGap12")
   {
      out = (double)g_snapshots[si].pivot_gap_12;
      return (g_snapshots[si].pivot_gap_12 > 0);
   }
   if(feature == "PivotGap23")
   {
      out = (double)g_snapshots[si].pivot_gap_23;
      return (g_snapshots[si].pivot_gap_23 > 0);
   }
   if(feature == "PivotGapRatio")
   {
      out = g_snapshots[si].pivot_gap_ratio;
      return (out > 0.0);
   }
   if(feature == "PriceLeg12_ATR")
   {
      out = g_snapshots[si].price_leg_12_atr;
      return (out >= 0.0);
   }
   if(feature == "PriceLeg23_ATR")
   {
      out = g_snapshots[si].price_leg_23_atr;
      return (out >= 0.0);
   }
   if(feature == "ConfirmationAfterP3")
   {
      out = g_snapshots[si].confirmation_after_p3 ? 1.0 : 0.0;
      return true;
   }
   if(feature == "RSIReclaimAfterP3")
   {
      out = g_snapshots[si].rsi_reclaim_after_p3 ? 1.0 : 0.0;
      return true;
   }
   if(feature == "TickVolumeRatio20")
   {
      out = g_snapshots[si].tick_volume_ratio_20;
      return MathIsValidNumber(out);
   }
   if(feature == "TickVolumeZScore20")
   {
      out = g_snapshots[si].tick_volume_zscore_20;
      return MathIsValidNumber(out);
   }
   // ---- Cycle 3B ----
   if(feature == "BarsSinceSwingHigh")
   {
      out = (double)g_snapshots[si].bars_since_swing_high;
      return (g_snapshots[si].bars_since_swing_high >= 0);
   }
   if(feature == "BarsSinceSwingLow")
   {
      out = (double)g_snapshots[si].bars_since_swing_low;
      return (g_snapshots[si].bars_since_swing_low >= 0);
   }
   if(feature == "DistanceToSwingHighATR")
   {
      out = g_snapshots[si].distance_to_swing_high_atr;
      return MathIsValidNumber(out);
   }
   if(feature == "DistanceToSwingLowATR")
   {
      out = g_snapshots[si].distance_to_swing_low_atr;
      return MathIsValidNumber(out);
   }
   // ---- Cycle 3C ----
   if(feature == "SweptPriorHigh")
   {
      out = g_snapshots[si].swept_prior_high ? 1.0 : 0.0;
      return true;
   }
   if(feature == "SweptPriorLow")
   {
      out = g_snapshots[si].swept_prior_low ? 1.0 : 0.0;
      return true;
   }
   if(feature == "SweepDepthATR")
   {
      out = g_snapshots[si].sweep_depth_atr;
      return MathIsValidNumber(out);
   }
   if(feature == "CloseBackInsidePriorRange")
   {
      out = g_snapshots[si].close_back_inside_prior_range ? 1.0 : 0.0;
      return true;
   }
   if(feature == "SweepRejectionWickRatio")
   {
      out = g_snapshots[si].sweep_rejection_wick_ratio;
      return MathIsValidNumber(out);
   }
   if(feature == "DistanceToPriorDayHighATR")
   {
      out = g_snapshots[si].distance_to_prior_day_high_atr;
      return MathIsValidNumber(out);
   }
   if(feature == "DistanceToPriorDayLowATR")
   {
      out = g_snapshots[si].distance_to_prior_day_low_atr;
      return MathIsValidNumber(out);
   }
   // ---- Cycle 3D ----
   if(feature == "BreakOfStructureFlag")
   {
      out = g_snapshots[si].break_of_structure_flag ? 1.0 : 0.0;
      return true;
   }
   if(feature == "ChangeOfCharacterFlag")
   {
      out = g_snapshots[si].change_of_character_flag ? 1.0 : 0.0;
      return true;
   }
   if(feature == "BarsSinceBOS")
   {
      out = (double)g_snapshots[si].bars_since_bos;
      return (g_snapshots[si].bars_since_bos >= 0);
   }
   if(feature == "BarsSinceCHOCH")
   {
      out = (double)g_snapshots[si].bars_since_choch;
      return (g_snapshots[si].bars_since_choch >= 0);
   }
   if(feature == "RangePositionLastN")
   {
      out = g_snapshots[si].range_position_last_n;
      return MathIsValidNumber(out);
   }
   // ---- Cycle 3E ----
   if(feature == "BOSBreakDistanceATR")
   {
      out = g_snapshots[si].bos_break_distance_atr;
      return MathIsValidNumber(out);
   }
   if(feature == "BarsBetweenSwingAndBOS")
   {
      out = (double)g_snapshots[si].bars_between_swing_and_bos;
      return (g_snapshots[si].bars_between_swing_and_bos >= 0);
   }
   if(feature == "LastStructureEventType")
   {
      out = (double)g_snapshots[si].last_structure_event_type;
      return true;
   }
   if(feature == "StructureEventDirectionMatch")
   {
      out = g_snapshots[si].structure_event_direction_match ? 1.0 : 0.0;
      return true;
   }
   if(feature == "RangePositionSinceBOS")
   {
      out = g_snapshots[si].range_position_since_bos;
      return (g_snapshots[si].range_position_since_bos >= 0.0);
   }
   if(feature == "CHOCHBreakDistanceATR")
   {
      out = g_snapshots[si].choch_break_distance_atr;
      return MathIsValidNumber(out);
   }
   return false;
}
bool RL_FindBestSingleForContext(string signal, string target, SSensitivityBestResult &out_best)
{
   out_best.Reset();
   double best_score = -999999.0;
   bool found = false;
   for(int i = 0; i < g_sens_stat_threshold_count; i++)
   {
      if(g_sens_stat_thresholds[i].signal != signal) continue;
      if(g_sens_stat_thresholds[i].target != target) continue;
      if(g_sens_stat_thresholds[i].stat_score > best_score)
      {
         best_score = g_sens_stat_thresholds[i].stat_score;
         found = true;
         out_best.family_name     = g_sens_stat_thresholds[i].family_name;
         out_best.signal          = g_sens_stat_thresholds[i].signal;
         out_best.target          = g_sens_stat_thresholds[i].target;
         out_best.direction       = g_sens_stat_thresholds[i].direction;
         out_best.tf_idx          = g_sens_stat_thresholds[i].tf_idx;
         out_best.feature         = g_sens_stat_thresholds[i].feature;
         out_best.threshold       = g_sens_stat_thresholds[i].threshold;
         out_best.oos_reduction   = g_sens_stat_thresholds[i].oos_reduction;
         out_best.oos_cov         = g_sens_stat_thresholds[i].oos_cov;
         out_best.oos_avgp        = g_sens_stat_thresholds[i].oos_avgp;
         out_best.oos_accepted    = g_sens_stat_thresholds[i].oos_accepted;
         out_best.oos_loss_trades = g_sens_stat_thresholds[i].oos_loss_trades;
         out_best.oos_gross_loss  = g_sens_stat_thresholds[i].oos_gross_loss;
         out_best.composite_score = g_sens_stat_thresholds[i].stat_score;
         out_best.pf_stable       = g_sens_stat_thresholds[i].pf_stable;
      }
   }
   return found;
}
string RL_ComboComplementarityVerdict(double inc_reduction, double inc_expectancy, double cov_cost, double combo_cov, int combo_oos_acc)
{
   if(combo_oos_acc < 20) return "LOW_SAMPLE";
   if(inc_reduction >= COMP_MIN_INCREMENTAL_REDUCTION * 2.0 && cov_cost <= COMP_MAX_COVERAGE_COST * 0.5) {
      if(inc_expectancy >= COMP_MIN_INCREMENTAL_EXPECTANCY) return "ADDS_VALUE_STRONG";
   }
   if(inc_reduction >= COMP_MIN_INCREMENTAL_REDUCTION && cov_cost <= COMP_MAX_COVERAGE_COST) {
      if(inc_expectancy >= COMP_MIN_INCREMENTAL_EXPECTANCY) return "ADDS_VALUE";
      return "MARGINAL";
   }
   if(inc_reduction > 0.0 && cov_cost > COMP_MAX_COVERAGE_COST) return "TIGHTER_ONLY";
   if(MathAbs(inc_reduction) < 0.25) return "NO_REAL_ADD";
   if(inc_reduction < 0.0) return "WORSE_THAN_SINGLE";
   return "MARGINAL";
}
string RL_ComboDecisionFromComplementarity(string comp_verdict, double oos_cov, int oos_acc, bool pf_stable_single, double oos_pf_combo, int combo_loss_trades)
{
   bool combo_pf_ok = true;
   if(oos_pf_combo > COMP_PF_UNSTABLE_THRESHOLD && combo_loss_trades < COMP_PF_MIN_LOSS_TRADES) combo_pf_ok = false;
   if(comp_verdict == "ADDS_VALUE_STRONG" && oos_acc >= 30 && combo_pf_ok) return "KEEP";
   if(comp_verdict == "ADDS_VALUE" && oos_cov >= 12.0 && oos_acc >= 30) return "KEEP";
   if(comp_verdict == "ADDS_VALUE" && oos_acc >= 20) return "WATCHLIST";
   if(comp_verdict == "MARGINAL" || comp_verdict == "TIGHTER_ONLY") return "WATCHLIST";
   if(comp_verdict == "NO_REAL_ADD" || comp_verdict == "WORSE_THAN_SINGLE") return "KILL";
   if(comp_verdict == "LOW_SAMPLE") return "WATCHLIST";
   return "WATCHLIST";
}
// ==================== THRESHOLD SELECTION RULES ====================
#define THSEL_STAT_MIN_OOS_ACCEPTED   30
#define THSEL_EXEC_MIN_OOS_ACCEPTED   30
#define THSEL_EXEC_MIN_OOS_COV        15.0
#define THSEL_PLATEAU_RATIO           0.90
bool RL_IsStatThresholdCandidate(const SSensitivityThresholdRow &row)
{
   if(row.oos_accepted < THSEL_STAT_MIN_OOS_ACCEPTED)
      return false;
   if(row.oos_reduction <= 0.0)
      return false;
   return true;
}
bool RL_IsExecThresholdCandidate(const SSensitivityThresholdRow &row,
                                  string &why)
{
   why = "";
   if(row.oos_accepted < THSEL_EXEC_MIN_OOS_ACCEPTED)
   {
      why = "LOW_OOS_SAMPLE";
      return false;
   }
   if(row.oos_cov < THSEL_EXEC_MIN_OOS_COV)
   {
      why = "LOW_COVERAGE";
      return false;
   }
   if(row.oos_reduction <= 1.0)
   {
      why = "LOW_REDUCTION";
      return false;
   }
   // ===== FIX: برای HitStep4Plus، NEGATIVE_AVGP قابل قبول است
   // چون هدف کاهش نرخ Step4+ است نه افزایش سود =====
   bool is_step4_target = (StringFind(row.target, "Step4") >= 0 ||
                           StringFind(row.target, "HitStep4") >= 0);
   if(!is_step4_target && row.oos_avgp <= 0.0)
   {
      why = "NEGATIVE_AVGP";
      return false;
   }
   if(row.consistency_type == "SIGN_REVERSAL")
   {
      why = "SIGN_REVERSAL";
      return false;
   }
   if(row.consistency_type == "SEVERE_DEGRADATION")
   {
      why = "SEVERE_DEGRADATION";
      return false;
   }
   if(!row.oos_pf_stable)
   {
      why = "PF_UNSTABLE";
      return false;
   }
   why = "PASS_ALL";
   return true;
}
int RL_CountExecReady()
{
   int cnt = 0;
   for(int i = 0; i < g_sens_threshold_row_count; i++)
      if(g_sens_threshold_rows[i].execution_ready)
         cnt++;
   return cnt;
}
//|COMBO VALIDATION EXPORT — Phase 5|
void RL_ExportComboValidation()
{
   if(g_risklab_count < 50)
      return;
   if(g_sens_best_count == 0)
      Print("WARNING: RL_ExportComboValidation() called but g_sens_best_count == 0. "
            "Run RL_ExportSensitivity() first.");
   // reset combo results cache
   g_combo_result_count = 0;
   for(int i = 0; i < MAX_COMBO_RESULTS; i++)
      g_combo_results[i].Reset();
   // ==================== BASELINE ====================
   double dev_base_stop_buy  = 0.0, oos_base_stop_buy  = 0.0;
   double dev_base_s4_buy    = 0.0, oos_base_s4_buy    = 0.0;
   double dev_base_stop_sell = 0.0, oos_base_stop_sell = 0.0;
   double dev_base_s4_sell   = 0.0, oos_base_s4_sell   = 0.0;
   double dev_base_pnl_buy   = 0.0, oos_base_pnl_buy   = 0.0;
   double dev_base_pnl_sell  = 0.0, oos_base_pnl_sell  = 0.0;
   int dev_cnt_buy = 0, oos_cnt_buy = 0;
   int dev_cnt_sell = 0, oos_cnt_sell = 0;
   int dev_stop_buy = 0, oos_stop_buy = 0;
   int dev_s4_buy   = 0, oos_s4_buy   = 0;
   int dev_stop_sell = 0, oos_stop_sell = 0;
   int dev_s4_sell   = 0, oos_s4_sell   = 0;
   for(int i = 0; i < g_risklab_count; i++)
   {
      bool is_buy = (g_risklab_records[i].signal == "BUY");
      bool is_dev = !g_risklab_records[i].is_oos;
      double pnl  = g_risklab_records[i].pnl;
      if(is_buy) {
         if(is_dev) { dev_cnt_buy++; dev_base_pnl_buy += pnl; if(g_risklab_records[i].stop_flag) dev_stop_buy++; if(g_risklab_records[i].hit_step4_plus) dev_s4_buy++; }
         else       { oos_cnt_buy++; oos_base_pnl_buy += pnl; if(g_risklab_records[i].stop_flag) oos_stop_buy++; if(g_risklab_records[i].hit_step4_plus) oos_s4_buy++; }
      } else {
         if(is_dev) { dev_cnt_sell++; dev_base_pnl_sell += pnl; if(g_risklab_records[i].stop_flag) dev_stop_sell++; if(g_risklab_records[i].hit_step4_plus) dev_s4_sell++; }
         else       { oos_cnt_sell++; oos_base_pnl_sell += pnl; if(g_risklab_records[i].stop_flag) oos_stop_sell++; if(g_risklab_records[i].hit_step4_plus) oos_s4_sell++; }
      }
   }
   if(dev_cnt_buy  > 0) { dev_base_stop_buy  = dev_stop_buy  * 100.0 / dev_cnt_buy;  dev_base_s4_buy  = dev_s4_buy  * 100.0 / dev_cnt_buy;  dev_base_pnl_buy  /= dev_cnt_buy;  }
   if(oos_cnt_buy  > 0) { oos_base_stop_buy  = oos_stop_buy  * 100.0 / oos_cnt_buy;  oos_base_s4_buy  = oos_s4_buy  * 100.0 / oos_cnt_buy;  oos_base_pnl_buy  /= oos_cnt_buy;  }
   if(dev_cnt_sell > 0) { dev_base_stop_sell = dev_stop_sell * 100.0 / dev_cnt_sell; dev_base_s4_sell = dev_s4_sell * 100.0 / dev_cnt_sell; dev_base_pnl_sell /= dev_cnt_sell; }
   if(oos_cnt_sell > 0) { oos_base_stop_sell = oos_stop_sell * 100.0 / oos_cnt_sell; oos_base_s4_sell = oos_s4_sell * 100.0 / oos_cnt_sell; oos_base_pnl_sell /= oos_cnt_sell; }
   // ==================== CSV ====================
   string fn = "ComboValidation_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot create ComboValidation CSV"); return; }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot reopen ComboValidation CSV"); return; }
   FileSeek(h, 0, SEEK_END);
   string hdr = "Combo,Signal,Target,";
   hdr += "DEV_Total,DEV_Accepted,DEV_Cov%,DEV_Rejected,DEV_Bad%,DEV_Baseline_Bad%,DEV_Delta_Bad%,DEV_AvgPnL,DEV_DeltaAvgPnL,DEV_PF,DEV_WinRate%,DEV_LossTrades,DEV_GrossLoss,DEV_PF_Stable,";
   hdr += "OOS_Total,OOS_Accepted,OOS_Cov%,OOS_Rejected,OOS_Bad%,OOS_Baseline_Bad%,OOS_Delta_Bad%,OOS_AvgPnL,OOS_DeltaAvgPnL,OOS_PF,OOS_WinRate%,OOS_LossTrades,OOS_GrossLoss,OOS_PF_Stable,";
   hdr += "BestSingle_Name,BestSingle_Threshold,BestSingle_Score,BestSingle_OOS_Reduction,BestSingle_OOS_Cov,BestSingle_OOS_AvgPnL,";
   hdr += "Incremental_Reduction,Incremental_Expectancy,Incremental_Coverage_Cost,";
   hdr += "Sample_OK,Base_Verdict,Complementarity,Decision";
   FileWriteString(h, hdr + "\r\n");
   // ==================== COMBO DEFINITION ====================
   struct SComboNew { string name; string signal; string target; string feat_a; string dir_a; int tf_a; double thr_a; string feat_b; string dir_b; int tf_b; double thr_b; };
   SComboNew combos[12];
   int combo_count = 0;
   combos[combo_count].name="M15_ATR_Regime+M5_EMA_Comp"; combos[combo_count].signal="BUY"; combos[combo_count].target="StopFlag"; combos[combo_count].feat_a="ATR_Regime"; combos[combo_count].dir_a="LE"; combos[combo_count].tf_a=TF_IDX_M15; combos[combo_count].thr_a=0.72; combos[combo_count].feat_b="EMA_Compression"; combos[combo_count].dir_b="GE"; combos[combo_count].tf_b=TF_IDX_M5; combos[combo_count].thr_b=4.4; combo_count++;
   combos[combo_count].name="H4_ADX+Signal_BodyRatio"; combos[combo_count].signal="BUY"; combos[combo_count].target="HitStep4Plus"; combos[combo_count].feat_a="ADX"; combos[combo_count].dir_a="GE"; combos[combo_count].tf_a=TF_IDX_H4; combos[combo_count].thr_a=40.0; combos[combo_count].feat_b="Signal_BodyRatio"; combos[combo_count].dir_b="LE"; combos[combo_count].tf_b=-1; combos[combo_count].thr_b=0.35; combo_count++;
   combos[combo_count].name="M5_ATR_Regime+M1_EMA_Comp"; combos[combo_count].signal="SELL"; combos[combo_count].target="StopFlag"; combos[combo_count].feat_a="ATR_Regime"; combos[combo_count].dir_a="LE"; combos[combo_count].tf_a=TF_IDX_M5; combos[combo_count].thr_a=0.82; combos[combo_count].feat_b="EMA_Compression"; combos[combo_count].dir_b="GE"; combos[combo_count].tf_b=TF_IDX_MAIN; combos[combo_count].thr_b=3.0; combo_count++;
   combos[combo_count].name="M1_ATR+M1_EMA_Comp"; combos[combo_count].signal="SELL"; combos[combo_count].target="StopFlag"; combos[combo_count].feat_a="ATR"; combos[combo_count].dir_a="LE"; combos[combo_count].tf_a=TF_IDX_MAIN; combos[combo_count].thr_a=0.94; combos[combo_count].feat_b="EMA_Compression"; combos[combo_count].dir_b="GE"; combos[combo_count].tf_b=TF_IDX_MAIN; combos[combo_count].thr_b=3.0; combo_count++;
   combos[combo_count].name="M1_ATR_Regime_SINGLE"; combos[combo_count].signal="SELL"; combos[combo_count].target="HitStep4Plus"; combos[combo_count].feat_a="ATR_Regime"; combos[combo_count].dir_a="GE"; combos[combo_count].tf_a=TF_IDX_MAIN; combos[combo_count].thr_a=1.2; combos[combo_count].feat_b=""; combos[combo_count].dir_b=""; combos[combo_count].tf_b=-1; combos[combo_count].thr_b=0.0; combo_count++;
   combos[combo_count].name="M30_ATR+M1_ATR_Regime"; combos[combo_count].signal="SELL"; combos[combo_count].target="HitStep4Plus"; combos[combo_count].feat_a="ATR"; combos[combo_count].dir_a="GE"; combos[combo_count].tf_a=TF_IDX_M30; combos[combo_count].thr_a=8.5; combos[combo_count].feat_b="ATR_Regime"; combos[combo_count].dir_b="GE"; combos[combo_count].tf_b=TF_IDX_MAIN; combos[combo_count].thr_b=1.2; combo_count++;
   // ==================== CALCULATION ====================
   for(int c = 0; c < combo_count; c++)
   {
      SComboNew co = combos[c];
      bool use_b = (co.feat_b != "");
      double bl_bad_dev = 0.0, bl_bad_oos = 0.0, bl_pnl_dev = 0.0, bl_pnl_oos = 0.0;
      int bl_tot_dev = 0, bl_tot_oos = 0;
      if(co.signal == "BUY") { bl_bad_dev=(co.target=="StopFlag")?dev_base_stop_buy:dev_base_s4_buy; bl_bad_oos=(co.target=="StopFlag")?oos_base_stop_buy:oos_base_s4_buy; bl_pnl_dev=dev_base_pnl_buy; bl_pnl_oos=oos_base_pnl_buy; bl_tot_dev=dev_cnt_buy; bl_tot_oos=oos_cnt_buy; }
      else { bl_bad_dev=(co.target=="StopFlag")?dev_base_stop_sell:dev_base_s4_sell; bl_bad_oos=(co.target=="StopFlag")?oos_base_stop_sell:oos_base_s4_sell; bl_pnl_dev=dev_base_pnl_sell; bl_pnl_oos=oos_base_pnl_sell; bl_tot_dev=dev_cnt_sell; bl_tot_oos=oos_cnt_sell; }
      int dev_acc=0,oos_acc=0,dev_bad=0,oos_bad=0,dev_win=0,oos_win=0,dev_loss_cnt=0,oos_loss_cnt=0;
      double dev_pnl=0.0,oos_pnl=0.0,dev_pf_pos=0.0,dev_pf_neg=0.0,oos_pf_pos=0.0,oos_pf_neg=0.0,dev_gross_l=0.0,oos_gross_l=0.0;
      for(int i = 0; i < g_risklab_count; i++)
      {
         if(g_risklab_records[i].signal != co.signal) continue;
         double va=0.0; if(!RL_GetSensFeatureValue(g_risklab_records[i],co.feat_a,co.tf_a,va)) continue;
         bool pass_a=(co.dir_a=="LE")?(va<=co.thr_a):(va>=co.thr_a); if(!pass_a) continue;
         if(use_b) { double vb=0.0; if(!RL_GetSensFeatureValue(g_risklab_records[i],co.feat_b,co.tf_b,vb)) continue; bool pass_b=(co.dir_b=="LE")?(vb<=co.thr_b):(vb>=co.thr_b); if(!pass_b) continue; }
         bool is_bad=(co.target=="StopFlag")?g_risklab_records[i].stop_flag:g_risklab_records[i].hit_step4_plus;
         bool is_dev=!g_risklab_records[i].is_oos; double pnl=g_risklab_records[i].pnl;
         if(is_dev) { dev_acc++; if(is_bad) dev_bad++; dev_pnl+=pnl; if(pnl>0.0){dev_win++;dev_pf_pos+=pnl;}else{dev_pf_neg+=MathAbs(pnl);dev_loss_cnt++;dev_gross_l+=MathAbs(pnl);} }
         else { oos_acc++; if(is_bad) oos_bad++; oos_pnl+=pnl; if(pnl>0.0){oos_win++;oos_pf_pos+=pnl;}else{oos_pf_neg+=MathAbs(pnl);oos_loss_cnt++;oos_gross_l+=MathAbs(pnl);} }
      }
      double dev_cov=(bl_tot_dev>0)?(dev_acc*100.0/bl_tot_dev):0.0; double dev_bad_r=(dev_acc>0)?(dev_bad*100.0/dev_acc):0.0; double dev_delta_bad=bl_bad_dev-dev_bad_r; double dev_avgp=(dev_acc>0)?(dev_pnl/dev_acc):0.0; double dev_delta_p=dev_avgp-bl_pnl_dev; double dev_pf=(dev_pf_neg>0.0)?(dev_pf_pos/dev_pf_neg):0.0; double dev_wr=(dev_acc>0)?(dev_win*100.0/dev_acc):0.0; int dev_rej=bl_tot_dev-dev_acc; bool dev_pf_stable=!(dev_pf>COMP_PF_UNSTABLE_THRESHOLD&&dev_loss_cnt<COMP_PF_MIN_LOSS_TRADES);
      double oos_cov=(bl_tot_oos>0)?(oos_acc*100.0/bl_tot_oos):0.0; double oos_bad_r=(oos_acc>0)?(oos_bad*100.0/oos_acc):0.0; double oos_delta_bad=bl_bad_oos-oos_bad_r; double oos_avgp=(oos_acc>0)?(oos_pnl/oos_acc):0.0; double oos_delta_p=oos_avgp-bl_pnl_oos; double oos_pf=(oos_pf_neg>0.0)?(oos_pf_pos/oos_pf_neg):0.0; double oos_wr=(oos_acc>0)?(oos_win*100.0/oos_acc):0.0; int oos_rej=bl_tot_oos-oos_acc; bool oos_pf_stable=!(oos_pf>COMP_PF_UNSTABLE_THRESHOLD&&oos_loss_cnt<COMP_PF_MIN_LOSS_TRADES);
      string sample_ok=(oos_acc>=100)?"Strong":(oos_acc>=50)?"Acceptable":(oos_acc>=30)?"Borderline":"Weak";
      string base_verdict=(oos_delta_bad>0.0&&oos_acc>=20)?"Good":(oos_delta_bad>0.0&&oos_acc>=15)?"Partial":"Fail";
      SSensitivityBestResult best_single;
      bool has_best_single=RL_FindBestSingleForContext(co.signal,co.target,best_single);
      double inc_reduction=0.0,inc_expectancy=0.0,inc_cov_cost=0.0;
      string comp_verdict="NO_SINGLE_REFERENCE", decision="WATCHLIST";
      if(has_best_single) { inc_reduction=oos_delta_bad-best_single.oos_reduction; inc_expectancy=oos_avgp-best_single.oos_avgp; inc_cov_cost=best_single.oos_cov-oos_cov; comp_verdict=RL_ComboComplementarityVerdict(inc_reduction,inc_expectancy,inc_cov_cost,oos_cov,oos_acc); decision=RL_ComboDecisionFromComplementarity(comp_verdict,oos_cov,oos_acc,best_single.pf_stable,oos_pf,oos_loss_cnt); }
      else { if(base_verdict=="Good"||base_verdict=="Partial") decision="WATCHLIST"; else decision="KILL"; }
      // ---------- ذخیره در g_combo_results ----------
      if(g_combo_result_count < MAX_COMBO_RESULTS)
      {
         int idx = g_combo_result_count;
         g_combo_results[idx].Reset();
         g_combo_results[idx].context    = co.signal + "|" + co.target;
         g_combo_results[idx].signal     = co.signal;
         g_combo_results[idx].target     = co.target;
         g_combo_results[idx].combo_name = co.name;
         g_combo_results[idx].complexity = use_b ? 2 : 1;
         g_combo_results[idx].oos_reduction  = oos_delta_bad;
         g_combo_results[idx].oos_avgp       = oos_avgp;
         g_combo_results[idx].oos_cov        = oos_cov;
         g_combo_results[idx].oos_accepted   = oos_acc;
         g_combo_results[idx].oos_pf_stable  = oos_pf_stable;
         g_combo_results[idx].dev_reduction  = dev_delta_bad;
         g_combo_results[idx].dev_avgp       = dev_avgp;
         g_combo_results[idx].dev_cov        = dev_cov;
         g_combo_results[idx].dev_accepted   = dev_acc;
         g_combo_results[idx].best_single_name    = has_best_single ? best_single.family_name : "N/A";
         g_combo_results[idx].inc_reduction       = inc_reduction;
         g_combo_results[idx].inc_avgp            = inc_expectancy;
         g_combo_results[idx].inc_cov_cost        = inc_cov_cost;
         g_combo_results[idx].complementarity     = comp_verdict;
         g_combo_results[idx].statistical_decision = decision;
         g_combo_result_count++;
      }
      // ---------- Write CSV row ----------
      string row = EscapeCSV(co.name)+","+co.signal+","+co.target+",";
      row+=IntegerToString(bl_tot_dev)+","+IntegerToString(dev_acc)+","+DoubleToString(dev_cov,2)+","+IntegerToString(dev_rej)+",";
      row+=DoubleToString(dev_bad_r,4)+","+DoubleToString(bl_bad_dev,4)+","+DoubleToString(dev_delta_bad,4)+",";
      row+=DoubleToString(dev_avgp,2)+","+DoubleToString(dev_delta_p,2)+","+DoubleToString(dev_pf,3)+","+DoubleToString(dev_wr,1)+",";
      row+=IntegerToString(dev_loss_cnt)+","+DoubleToString(dev_gross_l,2)+","+(dev_pf_stable?"YES":"NO_UNSTABLE")+",";
      row+=IntegerToString(bl_tot_oos)+","+IntegerToString(oos_acc)+","+DoubleToString(oos_cov,2)+","+IntegerToString(oos_rej)+",";
      row+=DoubleToString(oos_bad_r,4)+","+DoubleToString(bl_bad_oos,4)+","+DoubleToString(oos_delta_bad,4)+",";
      row+=DoubleToString(oos_avgp,2)+","+DoubleToString(oos_delta_p,2)+","+DoubleToString(oos_pf,3)+","+DoubleToString(oos_wr,1)+",";
      row+=IntegerToString(oos_loss_cnt)+","+DoubleToString(oos_gross_l,2)+","+(oos_pf_stable?"YES":"NO_UNSTABLE")+",";
      if(has_best_single) { row+=EscapeCSV(best_single.family_name)+","+DoubleToString(best_single.threshold,4)+","+DoubleToString(best_single.composite_score,3)+","+DoubleToString(best_single.oos_reduction,4)+","+DoubleToString(best_single.oos_cov,2)+","+DoubleToString(best_single.oos_avgp,2)+","; }
      else { row+="N/A,0,0,0,0,0,"; }
      row+=DoubleToString(inc_reduction,4)+","+DoubleToString(inc_expectancy,2)+","+DoubleToString(inc_cov_cost,2)+",";
      row+=EscapeCSV(sample_ok)+","+EscapeCSV(base_verdict)+","+EscapeCSV(comp_verdict)+","+EscapeCSV(decision);
      FileWriteString(h, row+"\r\n");
   }
   FileFlush(h);
   FileClose(h);
   Print("ComboValidation exported: ", fn, " | Cached ", g_combo_result_count, " combo results");
}
bool RL_BuildOperationalCache()
{
   // هدف:
   // - فقط داده‌های لایه‌های قبلی را جمع کند
   // - هیچ تصمیم جدیدی اختراع نکند
   // - ranking عملیاتی فقط روی execution candidateها انجام شود
   if(g_sens_threshold_row_count == 0 && g_combo_result_count == 0)
      return false;
   if(ArraySize(g_op_entries) < MAX_OP_ENTRIES)
      ArrayResize(g_op_entries, MAX_OP_ENTRIES);
   g_op_entry_count = 0;
   for(int i = 0; i < MAX_OP_ENTRIES; i++)
      g_op_entries[i].Reset();
   // ============================================================
   // 1) Singles from ThresholdSelection
   // هر thresholdی که برای audit relevant است وارد cache شود:
   //   execution_ready OR selected_as_exec OR selected_as_stat
   // اما decision جدیدی اینجا ساخته نشود
   // ============================================================
   for(int i = 0; i < g_sens_threshold_row_count && g_op_entry_count < MAX_OP_ENTRIES; i++)
   {
      bool keep_row =
         g_sens_threshold_rows[i].execution_ready ||
         g_sens_threshold_rows[i].selected_as_exec ||
         g_sens_threshold_rows[i].selected_as_stat;
      if(!keep_row)
         continue;
      int idx = g_op_entry_count;
      g_op_entries[idx].Reset();
      g_op_entries[idx].context            = g_sens_threshold_rows[i].signal + "|" + g_sens_threshold_rows[i].target;
      g_op_entries[idx].signal             = g_sens_threshold_rows[i].signal;
      g_op_entries[idx].target             = g_sens_threshold_rows[i].target;
      g_op_entries[idx].feature_name       = g_sens_threshold_rows[i].family_name;
      g_op_entries[idx].threshold_or_rule  =
         (g_sens_threshold_rows[i].direction == "LE" ? "<=" : ">=") +
         DoubleToString(g_sens_threshold_rows[i].threshold, 4);
      g_op_entries[idx].complexity         = 1;
      // ---- OOS ----
      g_op_entries[idx].oos_reduction      = g_sens_threshold_rows[i].oos_reduction;
      g_op_entries[idx].oos_avgp           = g_sens_threshold_rows[i].oos_avgp;
      g_op_entries[idx].oos_cov            = g_sens_threshold_rows[i].oos_cov;
      g_op_entries[idx].oos_accepted       = g_sens_threshold_rows[i].oos_accepted;
      g_op_entries[idx].oos_pf_stable      = g_sens_threshold_rows[i].oos_pf_stable;
      // ---- DEV ----
      g_op_entries[idx].dev_reduction      = g_sens_threshold_rows[i].dev_reduction;
      g_op_entries[idx].dev_avgp           = g_sens_threshold_rows[i].dev_avgp;
      g_op_entries[idx].dev_cov            = g_sens_threshold_rows[i].dev_cov;
      g_op_entries[idx].dev_accepted       = g_sens_threshold_rows[i].dev_accepted;
      // ---- single specific ----
      g_op_entries[idx].best_single_name   = "SELF";
      g_op_entries[idx].inc_reduction      = 0.0;
      g_op_entries[idx].inc_avgp           = 0.0;
      g_op_entries[idx].inc_cov_cost       = 0.0;
      g_op_entries[idx].complementarity    = "SINGLE";
      // ===== فقط کپی مستقیم از ThresholdSelection =====
      g_op_entries[idx].execution_ready         = g_sens_threshold_rows[i].execution_ready;
      g_op_entries[idx].selected_as_execution   = g_sens_threshold_rows[i].selected_as_exec;
      g_op_entries[idx].selected_as_statistical = g_sens_threshold_rows[i].selected_as_stat;
      // این فیلدها نباید دوباره‌سازی شوند
      // برای singleها فقط یک label کمکی:
      if(g_op_entries[idx].selected_as_statistical)
         g_op_entries[idx].statistical_decision = "KEEP";
      else if(g_op_entries[idx].selected_as_execution)
         g_op_entries[idx].statistical_decision = "WATCHLIST";
      else
         g_op_entries[idx].statistical_decision = "OFF";
      g_op_entries[idx].stat_score = g_sens_threshold_rows[i].statistical_threshold_score;
      g_op_entries[idx].rank_stat  = 0;
      // execution candidate فقط وقتی:
      // execution_ready = YES AND selected_as_execution = YES
      g_op_entries[idx].execution_candidate =
         (g_op_entries[idx].execution_ready && g_op_entries[idx].selected_as_execution);
      g_op_entries[idx].production_enabled = false;
      g_op_entries[idx].execution_candidate_why =
         g_sens_threshold_rows[i].execution_ready_why;
      // sanity checks
      if(g_op_entries[idx].selected_as_execution && !g_op_entries[idx].execution_ready)
      {
         Print("INVARIANT VIOLATION: SelectedExec=YES but Ready=NO | ",
               g_op_entries[idx].context, " | ",
               g_op_entries[idx].feature_name, " | ",
               g_op_entries[idx].threshold_or_rule);
      }
      if(g_op_entries[idx].production_enabled &&
         (!g_op_entries[idx].execution_ready || !g_op_entries[idx].selected_as_execution))
      {
         Print("INVARIANT VIOLATION: ProductionEnabled=YES but upstream gate is false");
      }
      g_op_entry_count++;
   }
   // ============================================================
   // 2) Combos from ComboValidation
   // Comboها فعلاً selected_as_execution ندارند
   // ============================================================
   for(int i = 0; i < g_combo_result_count && g_op_entry_count < MAX_OP_ENTRIES; i++)
   {
      int idx = g_op_entry_count;
      g_op_entries[idx].Reset();
      g_op_entries[idx].context            = g_combo_results[i].context;
      g_op_entries[idx].signal             = g_combo_results[i].signal;
      g_op_entries[idx].target             = g_combo_results[i].target;
      g_op_entries[idx].feature_name       = g_combo_results[i].combo_name;
      g_op_entries[idx].threshold_or_rule  = "COMBO";
      g_op_entries[idx].complexity         = g_combo_results[i].complexity;
      g_op_entries[idx].oos_reduction      = g_combo_results[i].oos_reduction;
      g_op_entries[idx].oos_avgp           = g_combo_results[i].oos_avgp;
      g_op_entries[idx].oos_cov            = g_combo_results[i].oos_cov;
      g_op_entries[idx].oos_accepted       = g_combo_results[i].oos_accepted;
      g_op_entries[idx].oos_pf_stable      = g_combo_results[i].oos_pf_stable;
      g_op_entries[idx].dev_reduction      = g_combo_results[i].dev_reduction;
      g_op_entries[idx].dev_avgp           = g_combo_results[i].dev_avgp;
      g_op_entries[idx].dev_cov            = g_combo_results[i].dev_cov;
      g_op_entries[idx].dev_accepted       = g_combo_results[i].dev_accepted;
      g_op_entries[idx].best_single_name   = g_combo_results[i].best_single_name;
      g_op_entries[idx].inc_reduction      = g_combo_results[i].inc_reduction;
      g_op_entries[idx].inc_avgp           = g_combo_results[i].inc_avgp;
      g_op_entries[idx].inc_cov_cost       = g_combo_results[i].inc_cov_cost;
      g_op_entries[idx].complementarity    = g_combo_results[i].complementarity;
      g_op_entries[idx].statistical_decision = g_combo_results[i].statistical_decision;
      g_op_entries[idx].stat_score = 0.0;
      g_op_entries[idx].rank_stat  = 0;
      g_op_entries[idx].execution_ready         = false;
      g_op_entries[idx].selected_as_execution   = false;
      g_op_entries[idx].selected_as_statistical = false;
      if(g_combo_results[i].statistical_decision == "KEEP" &&
         (g_combo_results[i].complementarity == "ADDS_VALUE" ||
          g_combo_results[i].complementarity == "ADDS_VALUE_STRONG"))
      {
         g_op_entries[idx].execution_candidate = true;
         g_op_entries[idx].execution_candidate_why = "COMBO_VALIDATED";
      }
      else
      {
         g_op_entries[idx].execution_candidate = false;
         g_op_entries[idx].execution_candidate_why = "COMBO_NOT_VALIDATED";
      }
      g_op_entries[idx].production_enabled = false;
      g_op_entry_count++;
   }
   // ============================================================
   // 3) Build unique contexts
   // ============================================================
   string contexts[16];
   int ctx_count = 0;
   for(int i = 0; i < g_op_entry_count; i++)
   {
      bool found = false;
      for(int j = 0; j < ctx_count; j++)
      {
         if(contexts[j] == g_op_entries[i].context)
         {
            found = true;
            break;
         }
      }
      if(!found && ctx_count < 16)
         contexts[ctx_count++] = g_op_entries[i].context;
   }
   // ============================================================
   // 4) Rank statistical singles inside each context
   // ============================================================
   for(int c = 0; c < ctx_count; c++)
   {
      string ctx = contexts[c];
      for(int i = 0; i < g_op_entry_count - 1; i++)
      {
         if(g_op_entries[i].context != ctx || g_op_entries[i].complexity != 1)
            continue;
         for(int j = i + 1; j < g_op_entry_count; j++)
         {
            if(g_op_entries[j].context != ctx || g_op_entries[j].complexity != 1)
               continue;
            if(g_op_entries[j].stat_score > g_op_entries[i].stat_score)
            {
               SOperationalEntry tmp = g_op_entries[i];
               g_op_entries[i] = g_op_entries[j];
               g_op_entries[j] = tmp;
            }
         }
      }
      int rank = 1;
      for(int i = 0; i < g_op_entry_count; i++)
      {
         if(g_op_entries[i].context != ctx || g_op_entries[i].complexity != 1)
            continue;
         g_op_entries[i].rank_stat = rank++;
      }
   }
   // ============================================================
   // 5) Operational score
   // ============================================================
   for(int i = 0; i < g_op_entry_count; i++)
   {
      double reduction_score = RL_ReductionScore(g_op_entries[i].oos_reduction);
      double pnl_score       = RL_PnLScore(g_op_entries[i].oos_avgp);
      double sample_score    = RL_SampleScore(g_op_entries[i].oos_accepted);
      double stability_factor = g_op_entries[i].oos_pf_stable ? 1.0 : 0.7;
      double reliability = sample_score * stability_factor;
      double benefit = 0.60 * reduction_score
                     + 0.25 * pnl_score
                     + 0.15 * reliability;
      double coverage_fraction = g_op_entries[i].oos_cov / 100.0;
      double coverage_cost = MathMax(0.0, 0.30 - coverage_fraction) / 0.30;
      double sample_risk = 1.0 - sample_score;
      double complexity_penalty = (g_op_entries[i].complexity - 1) * 0.10;
      double cost = 0.50 * coverage_cost
                  + 0.30 * sample_risk
                  + 0.20 * complexity_penalty;
      double raw_score = benefit - cost;
      double consistency_mult = 1.0;
      if(g_op_entries[i].dev_reduction > 0.001 && g_op_entries[i].oos_reduction > 0.001)
      {
         double ratio = g_op_entries[i].oos_reduction / g_op_entries[i].dev_reduction;
         if(ratio >= 1.0)       consistency_mult = 1.20;
         else if(ratio >= 0.80) consistency_mult = 1.00;
         else if(ratio >= 0.60) consistency_mult = 0.90;
         else if(ratio >= 0.0)  consistency_mult = 0.70;
         else                   consistency_mult = 0.50;
      }
      else if(g_op_entries[i].oos_reduction < 0.0)
      {
         consistency_mult = 0.50;
      }
      double adjusted = raw_score * consistency_mult;
      double op_score = 50.0 + adjusted * 50.0;
      if(op_score > 100.0) op_score = 100.0;
      if(op_score < 0.0)   op_score = 0.0;
      g_op_entries[i].benefit          = benefit;
      g_op_entries[i].cost             = cost;
      g_op_entries[i].op_score         = op_score;
      g_op_entries[i].consistency_mult = consistency_mult;
   }
   // ============================================================
   // 6) Operational rank
   // مهم: فقط execution candidates rank بگیرند
   // نه همه‌ی rows
   // ============================================================
   for(int c = 0; c < ctx_count; c++)
   {
      string ctx = contexts[c];
      for(int i = 0; i < g_op_entry_count - 1; i++)
      {
         if(g_op_entries[i].context != ctx)
            continue;
         bool cand_i = (g_op_entries[i].complexity == 1)
                     ? (g_op_entries[i].execution_ready && g_op_entries[i].selected_as_execution)
                     : g_op_entries[i].execution_candidate;
         if(!cand_i)
            continue;
         for(int j = i + 1; j < g_op_entry_count; j++)
         {
            if(g_op_entries[j].context != ctx)
               continue;
            bool cand_j = (g_op_entries[j].complexity == 1)
                        ? (g_op_entries[j].execution_ready && g_op_entries[j].selected_as_execution)
                        : g_op_entries[j].execution_candidate;
            if(!cand_j)
               continue;
            if(g_op_entries[j].op_score > g_op_entries[i].op_score)
            {
               SOperationalEntry tmp = g_op_entries[i];
               g_op_entries[i] = g_op_entries[j];
               g_op_entries[j] = tmp;
            }
         }
      }
      int rank = 1;
      for(int i = 0; i < g_op_entry_count; i++)
      {
         if(g_op_entries[i].context != ctx)
            continue;
         bool cand = (g_op_entries[i].complexity == 1)
                  ? (g_op_entries[i].execution_ready && g_op_entries[i].selected_as_execution)
                  : g_op_entries[i].execution_candidate;
         if(cand)
            g_op_entries[i].rank_op = rank++;
         else
            g_op_entries[i].rank_op = 0;
      }
   }
   // ============================================================
   // 7) Operational Recommended and Deployment
   // ============================================================
   for(int i = 0; i < g_op_entry_count; i++)
   {
      bool op_rec = false;
      if(g_op_entries[i].complexity == 1)
      {
         op_rec = (g_op_entries[i].execution_ready &&
                   g_op_entries[i].selected_as_execution &&
                   g_op_entries[i].rank_op > 0 &&
                   g_op_entries[i].rank_op <= 3);
      }
      else
      {
         op_rec = (g_op_entries[i].execution_candidate &&
                   g_op_entries[i].rank_op > 0 &&
                   g_op_entries[i].rank_op <= 2 &&
                   g_op_entries[i].op_score >= 75.0);
      }
      g_op_entries[i].op_recommended = op_rec;
      string deploy = "REJECT";
      if(g_op_entries[i].complexity == 1)
      {
         if(g_op_entries[i].execution_ready &&
            g_op_entries[i].selected_as_execution)
         {
            if(g_op_entries[i].selected_as_statistical && op_rec)
               deploy = "READY";
            else if(!g_op_entries[i].selected_as_statistical && op_rec)
               deploy = "WATCHLIST";
            else
               deploy = "REJECT";
         }
         else
         {
            deploy = "REJECT";
         }
      }
      else
      {
         if(g_op_entries[i].statistical_decision == "KEEP" &&
            (g_op_entries[i].complementarity == "ADDS_VALUE" ||
             g_op_entries[i].complementarity == "ADDS_VALUE_STRONG") &&
            op_rec)
         {
            deploy = "WATCHLIST";
         }
         else if(g_op_entries[i].statistical_decision == "KILL" &&
                 g_op_entries[i].op_score >= 60.0)
         {
            deploy = "MONITOR";
         }
         else
         {
            deploy = "REJECT";
         }
      }
      g_op_entries[i].deployment = deploy;
      g_op_entries[i].production_enabled =
         (g_op_entries[i].complexity == 1 && g_op_entries[i].deployment == "READY");
   }
   return true;
}
//|Operational Ranking Export|
void RL_ResolveExecutionPolicy(const SOperationalEntry &op_entry,
                               string &out_policy,
                               string &out_stage,
                               int &out_priority,
                               string &out_why,
                               string &out_execution_enabled)
{
   out_policy = "DISABLED";
   out_stage = "OFF";
   out_priority = 0;
   out_why = "OFF_BY_DEFAULT";
   out_execution_enabled = "NO";
   // ----------------------------------------------------
   // Rule 1: اگر execution-ready نیست → OFF
   // ----------------------------------------------------
   if(!op_entry.execution_ready)
   {
      out_policy = "DISABLED";
      out_stage = "OFF";
      out_priority = 0;
      out_why = "NOT_EXECUTION_READY";
      out_execution_enabled = "NO";
      return;
   }
   // ----------------------------------------------------
   // Rule 2: اگر selected as execution نیست → OFF
   // ----------------------------------------------------
   if(!op_entry.selected_as_execution)
   {
      out_policy = "DISABLED";
      out_stage = "OFF";
      out_priority = 0;
      out_why = "NOT_SELECTED_AS_EXECUTION";
      out_execution_enabled = "NO";
      return;
   }
   // ----------------------------------------------------
   // Rule 3: اگر operationally recommended نیست → OFF
   // ----------------------------------------------------
   if(!op_entry.op_recommended)
   {
      out_policy = "DISABLED";
      out_stage = "OFF";
      out_priority = 0;
      out_why = "NOT_OPERATIONALLY_RECOMMENDED";
      out_execution_enabled = "NO";
      return;
   }
   // ----------------------------------------------------
   // Rule 4: Comboها فعلاً LIVE نمی‌شوند
   // ----------------------------------------------------
   if(op_entry.complexity >= 2)
   {
      if(op_entry.statistical_decision == "KEEP")
      {
         out_policy = "MONITOR_ONLY";
         out_stage = "PILOT";
         out_priority = 0;
         out_why = "COMBO_KEEP_BUT_NOT_LIVE";
         out_execution_enabled = "NO";
         return;
      }
      if(op_entry.statistical_decision == "WATCHLIST")
      {
         out_policy = "MONITOR_ONLY";
         out_stage = "PILOT";
         out_priority = 0;
         out_why = "COMBO_WATCHLIST_PILOT";
         out_execution_enabled = "NO";
         return;
      }
      out_policy = "DISABLED";
      out_stage = "OFF";
      out_priority = 0;
      out_why = "COMBO_NOT_DEPLOYABLE";
      out_execution_enabled = "NO";
      return;
   }
   // ----------------------------------------------------
   // Singles
   // ----------------------------------------------------
   // LIVE:
   // execution_ready=YES
   // selected_as_execution=YES
   // selected_as_statistical=YES
   // op_recommended=YES
   if(op_entry.selected_as_statistical)
   {
      if(op_entry.target == "StopFlag" && op_entry.rank_op == 1)
      {
         out_policy = "MANDATORY";
         out_stage = "LIVE";
         out_priority = 1;
         out_why = "LIVE_PRIMARY";
         out_execution_enabled = "YES";
         return;
      }
      if(op_entry.target == "StopFlag")
      {
         out_policy = "OPTIONAL";
         out_stage = "LIVE";
         out_priority = op_entry.rank_op;
         out_why = "LIVE_SECONDARY";
         out_execution_enabled = "YES";
         return;
      }
      if(op_entry.target == "HitStep4Plus")
      {
         out_policy = "OPTIONAL";
         out_stage = "LIVE";
         out_priority = op_entry.rank_op;
         out_why = "LIVE_STEP4_PROTECTION";
         out_execution_enabled = "YES";
         return;
      }
   }
   // PILOT:
   // execution_ready=YES
   // selected_as_execution=YES
   // selected_as_statistical=NO
   // op_recommended=YES
   if(!op_entry.selected_as_statistical)
   {
      if(op_entry.target == "StopFlag")
      {
         out_policy = "OPTIONAL";
         out_stage = "PILOT";
         out_priority = op_entry.rank_op;
         out_why = "PILOT_EXECUTION_CANDIDATE";
         out_execution_enabled = "NO";
         return;
      }
      if(op_entry.target == "HitStep4Plus")
      {
         out_policy = "MONITOR_ONLY";
         out_stage = "PILOT";
         out_priority = 0;
         out_why = "PILOT_STEP4_CANDIDATE";
         out_execution_enabled = "NO";
         return;
      }
   }
   // fallback
   out_policy = "DISABLED";
   out_stage = "OFF";
   out_priority = 0;
   out_why = "NOT_DEPLOYABLE";
   out_execution_enabled = "NO";
}
bool RL_GetTargetValue(SRiskLabRecord &rec, ENUM_RL_TARGET target, int &out)
{
   switch(target)
   {
      case RL_TARGET_STEP3: out = rec.hit_step3_plus ? 1 : 0; return true;
      case RL_TARGET_STEP4: out = rec.hit_step4_plus ? 1 : 0; return true;
      case RL_TARGET_STOP:  out = rec.stop_flag      ? 1 : 0; return true;
   }
   return false;
}
string RL_TargetName(ENUM_RL_TARGET t)
{
   switch(t)
   {
      case RL_TARGET_STEP3: return "HitStep3Plus";
      case RL_TARGET_STEP4: return "HitStep4Plus";
      case RL_TARGET_STOP:  return "StopFlag";
   }
   return "Unknown";
}
// مرتب‌سازی index بر اساس vals — ascending — Shell Sort O(n log^2 n)
void RL_ArgSort(double &vals[], int &idx[], int n)
{
   for(int i = 0; i < n; i++) idx[i] = i;
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp = idx[i];
         int j = i;
         while(j >= gap && vals[idx[j - gap]] > vals[tmp])
         {
            idx[j] = idx[j - gap];
            j -= gap;
         }
         idx[j] = tmp;
      }
      gap /= 2;
   }
}
// AUC با Wilcoxon — O(n log n)
double RL_CalcAUC(double &vals[], int &targets[], int n)
{
   if(n < 10) return 0.5;
   int idx[];
   ArrayResize(idx, n);
   RL_ArgSort(vals, idx, n);
   // rank sum برای class positive
   double rank_sum = 0.0;
   int n_pos = 0, n_neg = 0;
   // محاسبه rank با tie handling
   int i = 0;
   while(i < n)
   {
      int j = i;
      // پیدا کردن گروه tie
      while(j < n - 1 && vals[idx[j]] == vals[idx[j + 1]]) j++;
      // rank میانگین برای ties
      double avg_rank = (i + 1 + j + 1) / 2.0;
      for(int k = i; k <= j; k++)
      {
         if(targets[idx[k]] == 1)
         {
            rank_sum += avg_rank;
            n_pos++;
         }
         else
            n_neg++;
      }
      i = j + 1;
   }
   if(n_pos == 0 || n_neg == 0) return 0.5;
   double u = rank_sum - (double)n_pos * (n_pos + 1) / 2.0;
   return u / ((double)n_pos * n_neg);
}
// PR-AUC با trapezoid — O(n log n)
double RL_CalcPRAUC(double &vals[], int &targets[], int n, bool higher_is_positive)
{
   if(n < 15) return 0.0;
   int total_pos = 0;
   for(int i = 0; i < n; i++) total_pos += targets[i];
   if(total_pos == 0) return 0.0;
   int idx[];
   ArrayResize(idx, n);
   RL_ArgSort(vals, idx, n);
   // اگر higher = positive باید از آخر به اول برویم
   double pr_auc = 0.0;
   double prev_recall    = 0.0;
   double prev_precision = 1.0;
   int tp = 0;
   for(int k = 0; k < n; k++)
   {
      int i = higher_is_positive ? (n - 1 - k) : k;
      if(targets[idx[i]] == 1) tp++;
      double precision = (double)tp / (k + 1);
      double recall    = (double)tp / total_pos;
      pr_auc += (recall - prev_recall) * (precision + prev_precision) / 2.0;
      prev_recall    = recall;
      prev_precision = precision;
   }
   ArrayFree(idx);
   return pr_auc;
}
// CI Wilson
void RL_WilsonCI(int pos, int total, double &lower, double &upper)
{
   lower = 0.0;
   upper = 1.0;
   if(total <= 0) return;
   double p = (double)pos / total;
   double z = 1.96;
   double n = total;
   double center = (p + z * z / (2.0 * n)) / (1.0 + z * z / n);
   double margin  = z * MathSqrt(p * (1.0 - p) / n + z * z / (4.0 * n * n))
                    / (1.0 + z * z / n);
   lower = MathMax(0.0, center - margin);
   upper = MathMin(1.0, center + margin);
}
// Cohen's d
double RL_CohensD(double m1, double s1, int n1,
                  double m2, double s2, int n2)
{
   if(n1 < 2 || n2 < 2) return 0.0;
   double pooled = ((n1 - 1) * s1 * s1 + (n2 - 1) * s2 * s2) / (n1 + n2 - 2.0);
   double sd = MathSqrt(pooled);
   if(sd < 1e-10) return 0.0;
   return (m1 - m2) / sd;
}
// Odds Ratio و Risk Ratio بر اساس median split
void RL_CalcORRR(double &vals[], int &targets[], int n,
                 double &odds_ratio, double &risk_ratio,
                 double &or_ci_lower, double &or_ci_upper)
{
   odds_ratio = 1.0;
   risk_ratio = 1.0;
   or_ci_lower = or_ci_upper = 0.0;
   if(n < 20) return;
   // median
   int idx[];
   ArrayResize(idx, n);
   RL_ArgSort(vals, idx, n);
   double median = vals[idx[n / 2]];
   int a = 0, b = 0, c = 0, d = 0;
   // a = high feature + positive
   // b = high feature + negative
   // c = low feature + positive
   // d = low feature + negative
   for(int i = 0; i < n; i++)
   {
      bool high = (vals[i] > median);
      bool pos  = (targets[i] == 1);
      if(high && pos)  a++;
      if(high && !pos) b++;
      if(!high && pos) c++;
      if(!high && !pos) d++;
   }
   // جلوگیری از تقسیم بر صفر — continuity correction
   if(a == 0 || b == 0 || c == 0 || d == 0)
   {
      a++; b++; c++; d++;
   }
   odds_ratio = ((double)a * d) / ((double)b * c);
   double rate_high = (double)a / (a + b);
   double rate_low  = (double)c / (c + d);
   risk_ratio = (rate_low > 1e-10) ? (rate_high / rate_low) : 0.0;
   // CI برای OR در log scale
   double log_or = MathLog(odds_ratio);
   double se_log  = MathSqrt(1.0/a + 1.0/b + 1.0/c + 1.0/d);
   or_ci_lower = MathExp(log_or - 1.96 * se_log);
   or_ci_upper = MathExp(log_or + 1.96 * se_log);
   ArrayFree(idx);
}
// Decile Analysis
void RL_CalcDeciles(double &vals[], int &targets[], int n,
                    double &decile_rate[], int &decile_count[])
{
   for(int i = 0; i < 10; i++) { decile_rate[i] = 0.0; decile_count[i] = 0; }
   if(n < 20) return;
   int idx[];
   ArrayResize(idx, n);
   RL_ArgSort(vals, idx, n);
   for(int i = 0; i < n; i++)
   {
      int d = (int)MathFloor(i * 10.0 / n);
      if(d > 9) d = 9;
      decile_count[d]++;
      if(targets[idx[i]] == 1) decile_rate[d] += 1.0;
   }
   for(int i = 0; i < 10; i++)
      if(decile_count[i] > 0)
         decile_rate[i] /= decile_count[i];
   ArrayFree(idx);
}
SRLFeatureStat RL_AnalyzeNumericFeature(
   string feat_name, string tf_name, string side,
   ENUM_RL_TARGET target, bool want_oos,
   double &feature_values[], int &target_values[], int n)
{
   SRLFeatureStat st;
   st.Reset();
   st.feature_name = feat_name;
   st.tf_name      = tf_name;
   st.side         = side;
   st.target_name  = RL_TargetName(target);
   st.split        = want_oos ? "OOS" : "DEV";
   st.n_total      = n;
   if(n < 15) return st;
   // relaxed threshold for small OOS slices in 1-year dataset
   int np_check = 0;
   for(int i=0; i<n; i++)
      if(target_values[i] == 1) np_check++;
   if(np_check < 3) return st;
   double vals_pos[]; double vals_neg[];
   ArrayResize(vals_pos, n); ArrayResize(vals_neg, n);
   int np = 0, nn = 0; double sum_pos = 0.0, sum_neg = 0.0;
   for(int i = 0; i < n; i++) {
      if(target_values[i] == 1) { vals_pos[np++] = feature_values[i]; sum_pos += feature_values[i]; }
      else                       { vals_neg[nn++] = feature_values[i]; sum_neg += feature_values[i]; }
   }
   st.n_positive = np;
   st.n_negative = nn;
   st.base_rate = (double)np / n;
   st.mean_pos = sum_pos / np;
   st.mean_neg = sum_neg / nn;
   double var_pos = 0.0, var_neg = 0.0;
   for(int i = 0; i < np; i++) var_pos += (vals_pos[i]-st.mean_pos)*(vals_pos[i]-st.mean_pos);
   for(int i = 0; i < nn; i++) var_neg += (vals_neg[i]-st.mean_neg)*(vals_neg[i]-st.mean_neg);
   st.std_pos = MathSqrt(var_pos / MathMax(1, np-1));
   st.std_neg = MathSqrt(var_neg / MathMax(1, nn-1));
   st.cohens_d = RL_CohensD(st.mean_pos, st.std_pos, np, st.mean_neg, st.std_neg, nn);
   st.effect_label = st.GetEffectLabel(st.cohens_d);
   st.auc = RL_CalcAUC(feature_values, target_values, n);
   st.pr_auc = RL_CalcPRAUC(feature_values, target_values, n, (st.cohens_d > 0));
   RL_CalcORRR(feature_values, target_values, n, st.odds_ratio, st.risk_ratio, st.or_ci_lower, st.or_ci_upper);
   RL_CalcDeciles(feature_values, target_values, n, st.decile_rate, st.decile_count);
   if(st.base_rate > 1e-6) { st.lift_q1 = st.decile_rate[0] / st.base_rate; st.lift_q4 = st.decile_rate[9] / st.base_rate; }
   RL_WilsonCI(np, n, st.ci_lower_95, st.ci_upper_95);
   ArrayFree(vals_pos); ArrayFree(vals_neg);
   return st;
}
bool RL_FeatureStatExists(string feature_name, string tf_name, string side, string target_name, string split_name)
{
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      if(g_rl_feature_stats[i].feature_name != feature_name) continue;
      if(g_rl_feature_stats[i].tf_name      != tf_name)      continue;
      if(g_rl_feature_stats[i].side         != side)         continue;
      if(g_rl_feature_stats[i].target_name  != target_name)  continue;
      if(g_rl_feature_stats[i].split        != split_name)   continue;
      return true;
   }
   return false;
}
void RL_AppendCycle3SnapshotFeaturesToStats()
{
   if(g_risklab_count < 15) return;
   if(g_rl_feature_stat_count <= 0) return;
   // 9 (3A) + 4 (3B) + 7 (3C) + 5 (3D) + 6 (3E) = 31
   string feat_names[31] =
   {
      "PivotGap12",
      "PivotGap23",
      "PivotGapRatio",
      "PriceLeg12_ATR",
      "PriceLeg23_ATR",
      "ConfirmationAfterP3",
      "RSIReclaimAfterP3",
      "TickVolumeRatio20",
      "TickVolumeZScore20",
      "BarsSinceSwingHigh",
      "BarsSinceSwingLow",
      "DistanceToSwingHighATR",
      "DistanceToSwingLowATR",
      "SweptPriorHigh",
      "SweptPriorLow",
      "SweepDepthATR",
      "CloseBackInsidePriorRange",
      "SweepRejectionWickRatio",
      "DistanceToPriorDayHighATR",
      "DistanceToPriorDayLowATR",
      "BreakOfStructureFlag",
      "ChangeOfCharacterFlag",
      "BarsSinceBOS",
      "BarsSinceCHOCH",
      "RangePositionLastN",
      "BOSBreakDistanceATR",
      "BarsBetweenSwingAndBOS",
      "LastStructureEventType",
      "StructureEventDirectionMatch",
      "RangePositionSinceBOS",
      "CHOCHBreakDistanceATR"
   };
   string sides[2] = {"BUY", "SELL"};
   bool splits[2] = {false, true};
   for(int si = 0; si < 2; si++)
   {
      string side = sides[si];
      for(int sp = 0; sp < 2; sp++)
      {
         bool want_oos = splits[sp];
         string split_name = want_oos ? "OOS" : "DEV";
         int filtered_idx[];
         ArrayResize(filtered_idx, g_risklab_count);
         int nf = 0;
         for(int i = 0; i < g_risklab_count; i++)
         {
            if(g_risklab_records[i].signal != side) continue;
            if(g_risklab_records[i].is_oos != want_oos) continue;
            filtered_idx[nf++] = i;
         }
         if(nf < 15)
         {
            ArrayFree(filtered_idx);
            continue;
         }
         for(int tg = 0; tg < 3; tg++)
         {
            ENUM_RL_TARGET target = (ENUM_RL_TARGET)tg;
            string target_name = RL_TargetName(target);
            for(int f = 0; f < 31; f++)
            {
               if(RL_FeatureStatExists(feat_names[f], "", side, target_name, split_name))
                  continue;
               double fv[];
               int tv[];
               ArrayResize(fv, nf);
               ArrayResize(tv, nf);
               int t = 0;
               int nvalid = 0;
               for(int i = 0; i < nf; i++)
               {
                  int ri = filtered_idx[i];
                  double v = 0.0;
                  if(!RL_GetSensFeatureValue(g_risklab_records[ri], feat_names[f], -1, v))
                     continue;
                  fv[nvalid] = v;
                  RL_GetTargetValue(g_risklab_records[ri], target, t);
                  tv[nvalid] = t;
                  nvalid++;
               }
               if(nvalid >= 15 && g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature(feat_names[f], "", side, target, want_oos, fv, tv, nvalid);
               }
               ArrayFree(fv);
               ArrayFree(tv);
            }
         }
         ArrayFree(filtered_idx);
      }
   }
}
void RL_RunFullFeatureAnalysis()
{
   if(g_risklab_count < 30)
   {
      Print("RL_RunFullFeatureAnalysis: Not enough records (", g_risklab_count, ")");
      return;
   }
   ArrayResize(g_rl_feature_stats, RL_FA_MAX_FEATURES);
   g_rl_feature_stat_count = 0;
   Print("Running Raw Feature Analysis on ", g_risklab_count, " records...");
   string sides[2]  = {"BUY", "SELL"};
   bool   splits[2] = {false, true};   // false=DEV, true=OOS
   for(int si = 0; si < 2; si++)
   {
      string side = sides[si];
      for(int sp = 0; sp < 2; sp++)
      {
         bool want_oos = splits[sp];
         // فیلتر رکوردها
         int filtered_idx[];
         ArrayResize(filtered_idx, g_risklab_count);
         int nf = 0;
         for(int i = 0; i < g_risklab_count; i++)
         {
            if(g_risklab_records[i].signal != side) continue;
            if(g_risklab_records[i].is_oos != want_oos) continue;
            filtered_idx[nf++] = i;
         }
         if(nf < 15)
         {
            ArrayFree(filtered_idx);
            continue;
         }
         for(int tg = 0; tg < 3; tg++)
         {
            ENUM_RL_TARGET target = (ENUM_RL_TARGET)tg;
            // ===== Global Features =====
            // Stability
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].stability;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("Stability", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // DI_Agreement
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].di_agreement_count;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("DI_Agreement", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // EMA_Bullish_Count
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].ema_bullish_count;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("EMA_Bullish", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // Pivot1Dist
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].pivot1_dist;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("Pivot1Dist", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // PivotSpan (Pivot2Dist)
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].pivot2_dist;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("PivotSpan", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // PivotGapMin
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].pivot_gap_min;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("PivotGapMin", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // PivotGapMax
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].pivot_gap_max;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("PivotGapMax", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // OB_DistPct — فقط مقادیر معتبر
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0; int nvalid = 0;
               for(int i = 0; i < nf; i++)
               {
                  if(g_risklab_records[filtered_idx[i]].ob_dist_pct < 0) continue;
                  fv[nvalid] = g_risklab_records[filtered_idx[i]].ob_dist_pct;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[nvalid] = t;
                  nvalid++;
               }
               if(nvalid >= 15)
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("OB_DistPct", "", side, target, want_oos, fv, tv, nvalid);
               ArrayFree(fv); ArrayFree(tv);
            }
            // OB_AgeBars — فقط مقادیر معتبر
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0; int nvalid = 0;
               for(int i = 0; i < nf; i++)
               {
                  if(g_risklab_records[filtered_idx[i]].ob_age_bars < 0) continue;
                  fv[nvalid] = g_risklab_records[filtered_idx[i]].ob_age_bars;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[nvalid] = t;
                  nvalid++;
               }
               if(nvalid >= 15)
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("OB_AgeBars", "", side, target, want_oos, fv, tv, nvalid);
               ArrayFree(fv); ArrayFree(tv);
            }
            // OB_Width_ATR
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].ob_width_atr;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("OB_Width_ATR", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // Signal_CLV
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].signal_clv;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("Signal_CLV", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // Signal_BodyRatio
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].signal_body_ratio;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("Signal_BodyRatio", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // TotalScore
            if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
            {
               double fv[]; int tv[];
               ArrayResize(fv, nf); ArrayResize(tv, nf);
               int t = 0;
               for(int i = 0; i < nf; i++)
               {
                  fv[i] = g_risklab_records[filtered_idx[i]].total_score;
                  RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                  tv[i] = t;
               }
               g_rl_feature_stats[g_rl_feature_stat_count++] =
                  RL_AnalyzeNumericFeature("TotalScore", "", side, target, want_oos, fv, tv, nf);
               ArrayFree(fv); ArrayFree(tv);
            }
            // ===== Divergence Quality Features =====
            // NOTE: These features are stored in g_snapshots[], not g_risklab_records[].
            // We join via setup_id. Records with no matching snapshot are skipped.
            {
               struct SDivFeatDef { string name; int field_id; };
               SDivFeatDef div_feats[12];
               div_feats[0].name  = "Price_Div_Strength";  div_feats[0].field_id  = 0;
               div_feats[1].name  = "RSI_Div_Strength";    div_feats[1].field_id  = 1;
               div_feats[2].name  = "Div_Price_Slope";     div_feats[2].field_id  = 2;
               div_feats[3].name  = "Div_RSI_Slope";       div_feats[3].field_id  = 3;
               div_feats[4].name  = "Div_Span_Bars";       div_feats[4].field_id  = 4;
               div_feats[5].name  = "Pivot_Symmetry";      div_feats[5].field_id  = 5;
               div_feats[6].name  = "Time_Since_P3";       div_feats[6].field_id  = 6;
               div_feats[7].name  = "Pivot_RSI_P1";        div_feats[7].field_id  = 7;
               div_feats[8].name  = "Pivot_RSI_P2";        div_feats[8].field_id  = 8;
               div_feats[9].name  = "Pivot_RSI_P3";        div_feats[9].field_id  = 9;
               div_feats[10].name = "Price_Leg_Ratio";     div_feats[10].field_id = 10;
               div_feats[11].name = "RSI_Acceleration";    div_feats[11].field_id = 11;
               for(int df = 0; df < 12 && g_rl_feature_stat_count < RL_FA_MAX_FEATURES; df++)
               {
                  // Pre-allocate at max possible size
                  double fv[]; int tv[];
                  ArrayResize(fv, nf);
                  ArrayResize(tv, nf);
                  int t = 0;
                  int nvalid = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     int ri = filtered_idx[i];
                     int setup_id = g_risklab_records[ri].setup_id;
                     // Join to snapshot
                     int si = RL_FindSnapshotBySetupId_ForRL(setup_id);
                     if(si < 0) continue;
                     double v = 0.0;
                     bool   ok = true;
                     switch(div_feats[df].field_id)
                     {
                        case 0:
                           v = g_snapshots[si].price_div_strength;
                           ok = MathIsValidNumber(v);
                           break;
                        case 1:
                           v = g_snapshots[si].rsi_div_strength;
                           ok = MathIsValidNumber(v);
                           break;
                        case 2:
                           v = g_snapshots[si].div_price_slope;
                           ok = MathIsValidNumber(v);
                           break;
                        case 3:
                           v = g_snapshots[si].div_rsi_slope;
                           ok = MathIsValidNumber(v);
                           break;
                        case 4:
                           v = (double)g_snapshots[si].div_span_bars;
                           ok = (g_snapshots[si].div_span_bars > 0);
                           break;
                        case 5:
                           v = g_snapshots[si].pivot_symmetry;
                           ok = (v >= 0.0 && v <= 1.0);
                           break;
                        case 6:
                           v = (double)g_snapshots[si].time_since_p3;
                           ok = (g_snapshots[si].time_since_p3 >= 0);
                           break;
                        case 7:
                           v = g_snapshots[si].pivot_rsi_p1;
                           ok = (v > 0.0 && v <= 100.0);
                           break;
                        case 8:
                           v = g_snapshots[si].pivot_rsi_p2;
                           ok = (v > 0.0 && v <= 100.0);
                           break;
                        case 9:
                           v = g_snapshots[si].pivot_rsi_p3;
                           ok = (v > 0.0 && v <= 100.0);
                           break;
                        case 10:
                           v = g_snapshots[si].price_leg_ratio;
                           ok = (v >= 0.0);
                           break;
                        case 11:
                           v = g_snapshots[si].rsi_acceleration;
                           ok = MathIsValidNumber(v);
                           break;
                        default:
                           ok = false;
                           break;
                     }
                     if(!ok) continue;
                     fv[nvalid] = v;
                     RL_GetTargetValue(g_risklab_records[ri], target, t);
                     tv[nvalid] = t;
                     nvalid++;
                  }
                  if(nvalid >= 15)
                  {
                     g_rl_feature_stats[g_rl_feature_stat_count++] =
                        RL_AnalyzeNumericFeature(div_feats[df].name, "", side, target,
                                                 want_oos, fv, tv, nvalid);
                  }
                  ArrayFree(fv);
                  ArrayFree(tv);
               }
            }
            // ===== Per-TF Features =====
            for(int tf = 0; tf < TF_COUNT; tf++)
            {
               string tfn = g_tf[tf].name;
               // RSI
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].rsi[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("RSI", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // ADX
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].adx[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("ADX", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // CCI
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].cci[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("CCI", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // ATR
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].atr[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("ATR", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // ATR_Regime
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].atr_regime[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("ATR_Regime", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // ADX_Slope
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].adx_slope[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("ADX_Slope", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // EMA_Compression
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].ema_compression[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("EMA_Compression", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // EMA200_Dist
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].ema200_dist[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("EMA200_Dist", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
               // DI_Gap
               if(g_rl_feature_stat_count < RL_FA_MAX_FEATURES)
               {
                  double fv[]; int tv[];
                  ArrayResize(fv, nf); ArrayResize(tv, nf);
                  int t = 0;
                  for(int i = 0; i < nf; i++)
                  {
                     fv[i] = g_risklab_records[filtered_idx[i]].di_gap[tf];
                     RL_GetTargetValue(g_risklab_records[filtered_idx[i]], target, t);
                     tv[i] = t;
                  }
                  g_rl_feature_stats[g_rl_feature_stat_count++] =
                     RL_AnalyzeNumericFeature("DI_Gap", tfn, side, target, want_oos, fv, tv, nf);
                  ArrayFree(fv); ArrayFree(tv);
               }
            } // end TF loop
         } // end target loop
         ArrayFree(filtered_idx);
      } // end split loop
   } // end side loop
   Print("Raw Feature Analysis complete: ", g_rl_feature_stat_count, " stats computed.");
}
void RL_ExportFeatureAnalysis()
{
   if(g_rl_feature_stat_count == 0)
   {
      Print("RL_ExportFeatureAnalysis: No stats.");
      return;
   }
   // Ensure Cycle 3A snapshot-only features are appended
   RL_AppendCycle3SnapshotFeaturesToStats();
   string fn = "RiskLab_FeatureAnalysis_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON)) FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot create"); return; }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ|FILE_WRITE|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("ERROR: Cannot reopen"); return; }
   FileSeek(h, 0, SEEK_END);
   string hdr = "Feature,TF,Side,Target,Split,";
   hdr += "N_Total,N_Positive,N_Negative,BaseRate,";
   hdr += "Mean_Pos,Mean_Neg,Std_Pos,Std_Neg,";
   hdr += "CohensD,EffectLabel,";
   hdr += "AUC,PR_AUC,";
   hdr += "OddsRatio,RiskRatio,OR_CI_Lower,OR_CI_Upper,";
   hdr += "Lift_Q1,Lift_Q4,";
   hdr += "CI_Lower95,CI_Upper95,";
   hdr += "OOS_Stable,";
   for(int d = 0; d < 10; d++)
      hdr += "D" + IntegerToString(d) + "_Rate,D" + IntegerToString(d) + "_N" + (d < 9 ? "," : "");
   FileWriteString(h, hdr + "\r\n");
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      SRLFeatureStat st = g_rl_feature_stats[i];
      if(st.n_total < 15) continue;
      string oos_stable = "-";
      if(st.split == "DEV")
      {
         for(int j = 0; j < g_rl_feature_stat_count; j++)
         {
            if(i == j) continue;
            SRLFeatureStat st2 = g_rl_feature_stats[j];
            if(st2.feature_name != st.feature_name) continue;
            if(st2.tf_name      != st.tf_name)      continue;
            if(st2.side         != st.side)         continue;
            if(st2.target_name  != st.target_name)  continue;
            if(st2.split        != "OOS")           continue;
            bool same_dir  = (st.cohens_d * st2.cohens_d > 0);
            bool oos_info  = (MathAbs(st2.auc - 0.5) > 0.05);
            if(same_dir && oos_info)      oos_stable = "YES";
            else if(!same_dir)            oos_stable = "NO";
            else                          oos_stable = "WEAK";
            break;
         }
      }
      string row = "";
      row += EscapeCSV(st.feature_name)  + ",";
      row += EscapeCSV(st.tf_name)        + ",";
      row += st.side                      + ",";
      row += st.target_name               + ",";
      row += st.split                     + ",";
      row += IntegerToString(st.n_total)    + ",";
      row += IntegerToString(st.n_positive) + ",";
      row += IntegerToString(st.n_negative) + ",";
      row += DoubleToString(st.base_rate, 4)   + ",";
      row += DoubleToString(st.mean_pos,  4)   + ",";
      row += DoubleToString(st.mean_neg,  4)   + ",";
      row += DoubleToString(st.std_pos,   4)   + ",";
      row += DoubleToString(st.std_neg,   4)   + ",";
      row += DoubleToString(st.cohens_d,  4)   + ",";
      row += st.effect_label                   + ",";
      row += DoubleToString(st.auc,       4)   + ",";
      row += DoubleToString(st.pr_auc,    4)   + ",";
      row += DoubleToString(st.odds_ratio,  3) + ",";
      row += DoubleToString(st.risk_ratio,  3) + ",";
      row += DoubleToString(st.or_ci_lower, 3) + ",";
      row += DoubleToString(st.or_ci_upper, 3) + ",";
      row += DoubleToString(st.lift_q1,   3)   + ",";
      row += DoubleToString(st.lift_q4,   3)   + ",";
      row += DoubleToString(st.ci_lower_95, 4) + ",";
      row += DoubleToString(st.ci_upper_95, 4) + ",";
      row += oos_stable                        + ",";
      for(int d = 0; d < 10; d++)
      {
         row += DoubleToString(st.decile_rate[d], 4) + ",";
         row += IntegerToString(st.decile_count[d]);
         if(d < 9) row += ",";
      }
      FileWriteString(h, row + "\r\n");
   }
   FileFlush(h);
   FileClose(h);
   Print("RiskLab_FeatureAnalysis exported: ", fn, " (", g_rl_feature_stat_count, " rows)");
}
int RL_FindFeatureStatIndex(string feature_name, string tf_name, string side, string target_name, string split_name)
{
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      if(g_rl_feature_stats[i].feature_name != feature_name) continue;
      if(g_rl_feature_stats[i].tf_name      != tf_name)      continue;
      if(g_rl_feature_stats[i].side         != side)         continue;
      if(g_rl_feature_stats[i].target_name  != target_name)  continue;
      if(g_rl_feature_stats[i].split        != split_name)   continue;
      return i;
   }
   return -1;
}
string RL_SingleFeatureVerdict(string target_name,
                               double dev_auc, double oos_auc,
                               double dev_d,   double oos_d,
                               int n_oos, int pos_oos)
{
   bool same_direction = false;
   if(MathAbs(dev_d) < 0.0000001 && MathAbs(oos_d) < 0.0000001)
      same_direction = true;
   else if(dev_d * oos_d > 0.0)
      same_direction = true;
   double gap = MathAbs(dev_auc - oos_auc);
   double strong_th = 0.65;
   double moderate_th = 0.58;
   double weak_th = 0.53;
   if(target_name == "HitStep4Plus")
   {
      strong_th   = 0.60;
      moderate_th = 0.56;
      weak_th     = 0.53;
   }
   else if(target_name == "HitStep3Plus")
   {
      strong_th   = 0.58;
      moderate_th = 0.55;
      weak_th     = 0.52;
   }
   else if(target_name == "StopFlag")
   {
      strong_th   = 0.65;
      moderate_th = 0.58;
      weak_th     = 0.53;
   }
   if(!same_direction && MathAbs(oos_auc - 0.5) > 0.03)
      return "REVERSED";
   if(pos_oos < 8)
   {
      if(oos_auc >= strong_th)   return "LOW_POS_BUT_STRONG";
      if(oos_auc >= moderate_th) return "LOW_POS_MODERATE";
      return "LOW_POS_NOISE";
   }
   if(oos_auc >= strong_th && gap <= 0.08)
   {
      if(oos_auc > dev_auc + 0.05)
         return "STRONG_IMPROVING";
      return "STRONG";
   }
   if(oos_auc >= moderate_th && gap <= 0.10)
      return "MODERATE";
   if(oos_auc >= weak_th)
      return "WEAK";
   return "NOISE";
}
void RL_ExportSingleFeatureLeaderboard()
{
   if(g_rl_feature_stat_count <= 0)
   {
      Print("RL_ExportSingleFeatureLeaderboard: No feature stats found.");
      return;
   }
   string fn = "RiskLab_SingleFeatureLeaderboard_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create ", fn);
      return;
   }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot reopen ", fn);
      return;
   }
   FileSeek(h, 0, SEEK_END);
   string hdr = "Side,Target,Rank,Feature,TF,";
   hdr += "DEV_N,DEV_Pos,DEV_BaseRate,DEV_AUC,DEV_PR_AUC,DEV_CohensD,";
   hdr += "OOS_N,OOS_Pos,OOS_BaseRate,OOS_AUC,OOS_PR_AUC,OOS_CohensD,";
   hdr += "AUC_Gap(OOS-DEV),SameDirection,";
   hdr += "Lift_Q1_OOS,Lift_Q4_OOS,";
   hdr += "OR_OOS,RR_OOS,";
   hdr += "Effect_OOS,Verdict";
   FileWriteString(h, hdr + "\r\n");
   string sides[2]   = {"BUY", "SELL"};
   string targets[3] = {"HitStep3Plus", "HitStep4Plus", "StopFlag"};
   for(int s = 0; s < 2; s++)
   {
      for(int t = 0; t < 3; t++)
      {
         // جمع کردن فقط OOS rows برای این context
         int oos_idx[];
         ArrayResize(oos_idx, g_rl_feature_stat_count);
         int cnt = 0;
         for(int i = 0; i < g_rl_feature_stat_count; i++)
         {
            if(g_rl_feature_stats[i].side != sides[s]) continue;
            if(g_rl_feature_stats[i].target_name != targets[t]) continue;
            if(g_rl_feature_stats[i].split != "OOS") continue;
            if(g_rl_feature_stats[i].n_total < 15) continue;
            oos_idx[cnt++] = i;
         }
         if(cnt <= 0)
            continue;
         // Sort by OOS AUC descending, then smaller abs gap, then bigger |OOS d|
         for(int i = 0; i < cnt - 1; i++)
         {
            int best = i;
            for(int j = i + 1; j < cnt; j++)
            {
               int idxA = oos_idx[best];
               int idxB = oos_idx[j];
               double aucA = g_rl_feature_stats[idxA].auc;
               double aucB = g_rl_feature_stats[idxB].auc;
               int devA = RL_FindFeatureStatIndex(
                  g_rl_feature_stats[idxA].feature_name,
                  g_rl_feature_stats[idxA].tf_name,
                  sides[s], targets[t], "DEV"
               );
               int devB = RL_FindFeatureStatIndex(
                  g_rl_feature_stats[idxB].feature_name,
                  g_rl_feature_stats[idxB].tf_name,
                  sides[s], targets[t], "DEV"
               );
               double gapA = 999.0;
               double gapB = 999.0;
               if(devA >= 0) gapA = MathAbs(g_rl_feature_stats[idxA].auc - g_rl_feature_stats[devA].auc);
               if(devB >= 0) gapB = MathAbs(g_rl_feature_stats[idxB].auc - g_rl_feature_stats[devB].auc);
               double dA = MathAbs(g_rl_feature_stats[idxA].cohens_d);
               double dB = MathAbs(g_rl_feature_stats[idxB].cohens_d);
               bool takeB = false;
               if(aucB > aucA + 0.0000001)
                  takeB = true;
               else if(MathAbs(aucB - aucA) <= 0.0000001 && gapB < gapA - 0.0000001)
                  takeB = true;
               else if(MathAbs(aucB - aucA) <= 0.0000001 && MathAbs(gapB - gapA) <= 0.0000001 && dB > dA + 0.0000001)
                  takeB = true;
               if(takeB)
                  best = j;
            }
            if(best != i)
            {
               int tmp = oos_idx[i];
               oos_idx[i] = oos_idx[best];
               oos_idx[best] = tmp;
            }
         }
         // write rows
         for(int r = 0; r < cnt; r++)
         {
            int ioos = oos_idx[r];
            string feat = g_rl_feature_stats[ioos].feature_name;
            string tfn  = g_rl_feature_stats[ioos].tf_name;
            int idev = RL_FindFeatureStatIndex(feat, tfn, sides[s], targets[t], "DEV");
            double dev_n       = 0;
            double dev_pos     = 0;
            double dev_rate    = 0.0;
            double dev_auc     = 0.5;
            double dev_pr      = 0.0;
            double dev_d       = 0.0;
            if(idev >= 0)
            {
               dev_n    = g_rl_feature_stats[idev].n_total;
               dev_pos  = g_rl_feature_stats[idev].n_positive;
               dev_rate = g_rl_feature_stats[idev].base_rate;
               dev_auc  = g_rl_feature_stats[idev].auc;
               dev_pr   = g_rl_feature_stats[idev].pr_auc;
               dev_d    = g_rl_feature_stats[idev].cohens_d;
            }
            double oos_n       = g_rl_feature_stats[ioos].n_total;
            double oos_pos     = g_rl_feature_stats[ioos].n_positive;
            double oos_rate    = g_rl_feature_stats[ioos].base_rate;
            double oos_auc     = g_rl_feature_stats[ioos].auc;
            double oos_pr      = g_rl_feature_stats[ioos].pr_auc;
            double oos_d       = g_rl_feature_stats[ioos].cohens_d;
            double lift_q1     = g_rl_feature_stats[ioos].lift_q1;
            double lift_q4     = g_rl_feature_stats[ioos].lift_q4;
            double or_oos      = g_rl_feature_stats[ioos].odds_ratio;
            double rr_oos      = g_rl_feature_stats[ioos].risk_ratio;
            double auc_gap = oos_auc - dev_auc;
            string same_dir = "NO";
            if((MathAbs(dev_d) < 0.0000001 && MathAbs(oos_d) < 0.0000001) || (dev_d * oos_d > 0.0))
               same_dir = "YES";
            string verdict = RL_SingleFeatureVerdict(targets[t], dev_auc, oos_auc, dev_d, oos_d, (int)oos_n, (int)oos_pos);
            string row = "";
            row += sides[s] + ",";
            row += targets[t] + ",";
            row += IntegerToString(r + 1) + ",";
            row += EscapeCSV(feat) + ",";
            row += EscapeCSV(tfn) + ",";
            row += IntegerToString((int)dev_n) + ",";
            row += IntegerToString((int)dev_pos) + ",";
            row += DoubleToString(dev_rate, 4) + ",";
            row += DoubleToString(dev_auc, 4) + ",";
            row += DoubleToString(dev_pr, 4) + ",";
            row += DoubleToString(dev_d, 4) + ",";
            row += IntegerToString((int)oos_n) + ",";
            row += IntegerToString((int)oos_pos) + ",";
            row += DoubleToString(oos_rate, 4) + ",";
            row += DoubleToString(oos_auc, 4) + ",";
            row += DoubleToString(oos_pr, 4) + ",";
            row += DoubleToString(oos_d, 4) + ",";
            row += DoubleToString(auc_gap, 4) + ",";
            row += same_dir + ",";
            row += DoubleToString(lift_q1, 3) + ",";
            row += DoubleToString(lift_q4, 3) + ",";
            row += DoubleToString(or_oos, 3) + ",";
            row += DoubleToString(rr_oos, 3) + ",";
            row += g_rl_feature_stats[ioos].effect_label + ",";
            row += verdict;
            FileWriteString(h, row + "\r\n");
         }
      }
   }
   FileFlush(h);
   FileClose(h);
   Print("RiskLab_SingleFeatureLeaderboard exported: ", fn);
}
//================================================================
// RL_BuildDeepStopFeatureStats
// Stage 2A v1.1 — DeepStop target
//
// برای هر (feature_name, tf_name) که در g_rl_feature_stats[] موجود است،
// آمار DeepStop را مستقیماً از g_risklab_records[] محاسبه می‌کند.
//
// DeepStop = (max_step_reached >= 4) AND (stop_flag == true)
//================================================================
void RL_BuildDeepStopFeatureStats(string feat_name, string tf_name, int tf_idx,
                                   bool is_buy,
                                   double &dev_auc_out, double &oos_auc_out,
                                   double &cohen_d_out,
                                   double &ci_lo_out, double &ci_hi_out,
                                   int &total_n_out,
                                   int &positive_n_out, int &negative_n_out,
                                   string &status_out)
{
   // مقادیر اولیه
   dev_auc_out = 0.0;
   oos_auc_out = 0.0;
   cohen_d_out = 0.0;
   ci_lo_out   = -1.0;
   ci_hi_out   = -1.0;
   total_n_out = 0;
   positive_n_out = 0;
   negative_n_out = 0;
   status_out = "LOW_SAMPLE";
   // ---- ساخت vector برای DEV ----
   double dev_feat_vals[];
   int    dev_target_vals[];
   ArrayResize(dev_feat_vals, g_risklab_count);
   ArrayResize(dev_target_vals, g_risklab_count);
   int dev_n = 0;
   // ---- ساخت vector برای OOS ----
   double oos_feat_vals[];
   int    oos_target_vals[];
   ArrayResize(oos_feat_vals, g_risklab_count);
   ArrayResize(oos_target_vals, g_risklab_count);
   int oos_n = 0;
   for(int i = 0; i < g_risklab_count; i++)
   {
      SRiskLabRecord rec = g_risklab_records[i];
      // side filter
      if(is_buy && rec.signal != "BUY")  continue;
      if(!is_buy && rec.signal != "SELL") continue;
      // feature value
      double fval = 0.0;
      if(!RL_GetSensFeatureValue(rec, feat_name, tf_idx, fval))
         continue;
      // DeepStop target
      bool is_deepstop = (rec.max_step_reached >= 4) && rec.stop_flag;
      int target_val = is_deepstop ? 1 : 0;
      // DEV/OOS split
      bool is_oos = rec.is_oos;
      if(!is_oos)
      {
         dev_feat_vals[dev_n]   = fval;
         dev_target_vals[dev_n] = target_val;
         dev_n++;
      }
      else
      {
         oos_feat_vals[oos_n]   = fval;
         oos_target_vals[oos_n] = target_val;
         oos_n++;
      }
   }
   ArrayResize(dev_feat_vals, dev_n);
   ArrayResize(dev_target_vals, dev_n);
   ArrayResize(oos_feat_vals, oos_n);
   ArrayResize(oos_target_vals, oos_n);
   total_n_out = dev_n + oos_n;
   // count positives
   int pos_dev = 0, pos_oos = 0;
   for(int i = 0; i < dev_n; i++) if(dev_target_vals[i] == 1) pos_dev++;
   for(int i = 0; i < oos_n; i++) if(oos_target_vals[i] == 1) pos_oos++;
   positive_n_out = pos_dev + pos_oos;
   negative_n_out = total_n_out - positive_n_out;
   status_out = FI_GetTargetStatus(positive_n_out);
   // ---- محاسبه DEV AUC ----
   if(dev_n >= 20 && pos_dev >= 5)
      dev_auc_out = RL_CalcAUC(dev_feat_vals, dev_target_vals, dev_n);
   // ---- محاسبه OOS AUC ----
   if(oos_n >= 20 && pos_oos >= 5)
      oos_auc_out = RL_CalcAUC(oos_feat_vals, oos_target_vals, oos_n);
   // ---- Cohen's d (روی کل DEV) ----
   if(dev_n >= 20 && pos_dev >= 5)
   {
      double mean_pos = 0.0, mean_neg = 0.0;
      double var_pos = 0.0, var_neg = 0.0;
      int n_pos = 0, n_neg = 0;
      for(int i = 0; i < dev_n; i++)
      {
         if(dev_target_vals[i] == 1) { mean_pos += dev_feat_vals[i]; n_pos++; }
         else                         { mean_neg += dev_feat_vals[i]; n_neg++; }
      }
      if(n_pos > 1 && n_neg > 1)
      {
         mean_pos /= n_pos;
         mean_neg /= n_neg;
         for(int i = 0; i < dev_n; i++)
         {
            if(dev_target_vals[i] == 1)
               var_pos += (dev_feat_vals[i] - mean_pos) * (dev_feat_vals[i] - mean_pos);
            else
               var_neg += (dev_feat_vals[i] - mean_neg) * (dev_feat_vals[i] - mean_neg);
         }
         double sp = MathSqrt(((n_pos - 1) * var_pos / n_pos +
                                (n_neg - 1) * var_neg / n_neg) / (n_pos + n_neg - 2.0));
         if(sp > 0.0001)
            cohen_d_out = (mean_pos - mean_neg) / sp;
      }
   }
   // ---- Bootstrap CI (فقط اگر OK) ----
   if(status_out == "OK" && dev_n >= 30)
   {
      RL_BootstrapAUC_CI(dev_feat_vals, dev_target_vals, dev_n,
                         ci_lo_out, ci_hi_out, 200);
   }
   ArrayFree(dev_feat_vals);
   ArrayFree(dev_target_vals);
   ArrayFree(oos_feat_vals);
   ArrayFree(oos_target_vals);
}
//================================================================
// RL_BuildFeatureImportanceMatrix v1.2
// Stage 2A — Full Row-Level Target Reconstruction
//
// Source of Truth:
//   Feature Universe: g_rl_feature_stats[] unique(feature, tf)
//   Feature Values:   RL_GetSensFeatureValue()
//   Target Values:    g_risklab_records[] row-level
//
// Targets:
//   StopFlag    = rec.stop_flag
//   HitStep4Plus= rec.hit_step4_plus
//   DeepStop    = rec.stop_flag && rec.max_step_reached >= 4
//
// IMPORTANT:
//   g_rl_feature_stats[] is used ONLY for feature universe.
//   No AUC / Cohen / CI / Positive_N is read from it.
//================================================================
void RL_BuildFeatureImportanceMatrix()
{
   if(g_rl_feature_stat_count <= 0)
   {
      Print("RL_BuildFeatureImportanceMatrix v1.4: No feature stats for universe.");
      return;
   }
   if(g_risklab_count <= 0)
   {
      Print("RL_BuildFeatureImportanceMatrix v1.4: No risklab records.");
      return;
   }
   if(ArraySize(g_feature_importance) < FI_MAX_ROWS)
      ArrayResize(g_feature_importance, FI_MAX_ROWS);
   g_feature_importance_count = 0;
   //================================================================
   // Step 1: Build unique (feature_name, tf_name) universe
   //================================================================
   string uniq_feat[FI_MAX_ROWS];
   string uniq_tf[FI_MAX_ROWS];
   int    uniq_tf_idx[FI_MAX_ROWS];
   int    uniq_count = 0;
   for(int i = 0; i < g_rl_feature_stat_count; i++)
   {
      string fn = g_rl_feature_stats[i].feature_name;
      string tn = g_rl_feature_stats[i].tf_name;
      bool found = false;
      for(int u = 0; u < uniq_count; u++)
      {
         if(uniq_feat[u] == fn && uniq_tf[u] == tn)
         {
            found = true;
            break;
         }
      }
      if(!found && uniq_count < FI_MAX_ROWS)
      {
         uniq_feat[uniq_count] = fn;
         uniq_tf[uniq_count]   = tn;
         int tidx = -1;
         for(int t = 0; t < TF_COUNT; t++)
         {
            if(g_tf[t].name == tn)
            {
               tidx = t;
               break;
            }
         }
         uniq_tf_idx[uniq_count] = tidx;
         uniq_count++;
      }
   }
   Print("Stage 2A v1.4: Feature universe = ", uniq_count, " unique (feature, tf) pairs.");
   //================================================================
   // Step 1b: Pre-build snapshot lookup for divergence features
   //================================================================
   int snap_lookup[];
   ArrayResize(snap_lookup, g_risklab_count);
   ArrayInitialize(snap_lookup, -1);
   for(int rr = 0; rr < g_risklab_count; rr++)
   {
      int si = RL_FindSnapshotBySetupId_ForRL(g_risklab_records[rr].setup_id);
      snap_lookup[rr] = si;
   }
   int div_matched = 0;
   for(int rr = 0; rr < g_risklab_count; rr++)
      if(snap_lookup[rr] >= 0) div_matched++;
   Print("Stage 2A: Snapshot-RiskLab join matched=", div_matched, "/", g_risklab_count);
   if(div_matched < g_risklab_count / 2)
      Print("WARNING: Less than 50% matched — divergence features may stay insufficient.");
   //================================================================
   // Step 2: Analyze each feature row-level
   //================================================================
   for(int u = 0; u < uniq_count && g_feature_importance_count < FI_MAX_ROWS; u++)
   {
      string fn    = uniq_feat[u];
      string tn    = uniq_tf[u];
      int    tf_ix = uniq_tf_idx[u];
      double dev_x[];
      int    dev_stop_y[];
      int    dev_step4_y[];
      int    dev_deep_y[];
      ArrayResize(dev_x,       g_risklab_count);
      ArrayResize(dev_stop_y,  g_risklab_count);
      ArrayResize(dev_step4_y, g_risklab_count);
      ArrayResize(dev_deep_y,  g_risklab_count);
      int dev_n = 0;
      double oos_x[];
      int    oos_stop_y[];
      int    oos_step4_y[];
      int    oos_deep_y[];
      ArrayResize(oos_x,       g_risklab_count);
      ArrayResize(oos_stop_y,  g_risklab_count);
      ArrayResize(oos_step4_y, g_risklab_count);
      ArrayResize(oos_deep_y,  g_risklab_count);
      int oos_n = 0;
      int stop_pos_dev = 0, stop_neg_dev = 0;
      int step4_pos_dev = 0, step4_neg_dev = 0;
      int deep_pos_dev = 0, deep_neg_dev = 0;
      int stop_pos_oos = 0, stop_neg_oos = 0;
      int step4_pos_oos = 0, step4_neg_oos = 0;
      int deep_pos_oos = 0, deep_neg_oos = 0;
      for(int r = 0; r < g_risklab_count; r++)
      {
         SRiskLabRecord rec = g_risklab_records[r];
         double fval = 0.0;
         bool got_val = false;
         // 1) Try regular RiskLab fields
         got_val = RL_GetSensFeatureValue(rec, fn, tf_ix, fval);
         // 2) If not found in RiskLab, try snapshot join (for divergence fields)
         if(!got_val && snap_lookup[r] >= 0)
         {
            int si = snap_lookup[r];
            double sv = 0.0;
            bool ok = false;
            if(fn == "Price_Div_Strength")
            {
               sv = g_snapshots[si].price_div_strength;
               ok = MathIsValidNumber(sv);
            }
            else if(fn == "RSI_Div_Strength")
            {
               sv = g_snapshots[si].rsi_div_strength;
               ok = MathIsValidNumber(sv);
            }
            else if(fn == "Div_Price_Slope")
            {
               sv = g_snapshots[si].div_price_slope;
               ok = MathIsValidNumber(sv);
            }
            else if(fn == "Div_RSI_Slope")
            {
               sv = g_snapshots[si].div_rsi_slope;
               ok = MathIsValidNumber(sv);
            }
            else if(fn == "Div_Span_Bars")
            {
               sv = (double)g_snapshots[si].div_span_bars;
               ok = (g_snapshots[si].div_span_bars > 0);
            }
            else if(fn == "Pivot_Symmetry")
            {
               sv = g_snapshots[si].pivot_symmetry;
               ok = (sv >= 0.0 && sv <= 1.0);
            }
            else if(fn == "Time_Since_P3")
            {
               sv = (double)g_snapshots[si].time_since_p3;
               ok = (g_snapshots[si].time_since_p3 >= 0);
            }
            else if(fn == "Pivot_RSI_P1")
            {
               sv = g_snapshots[si].pivot_rsi_p1;
               ok = (sv > 0.0 && sv <= 100.0);
            }
            else if(fn == "Pivot_RSI_P2")
            {
               sv = g_snapshots[si].pivot_rsi_p2;
               ok = (sv > 0.0 && sv <= 100.0);
            }
            else if(fn == "Pivot_RSI_P3")
            {
               sv = g_snapshots[si].pivot_rsi_p3;
               ok = (sv > 0.0 && sv <= 100.0);
            }
            else if(fn == "Price_Leg_Ratio")
            {
               sv = g_snapshots[si].price_leg_ratio;
               ok = (sv >= 0.0);
            }
            else if(fn == "RSI_Acceleration")
            {
               sv = g_snapshots[si].rsi_acceleration;
               ok = MathIsValidNumber(sv);
            }
            else if(fn == "Divergence_Angle")
            {
               sv = g_snapshots[si].divergence_angle;
               ok = MathIsValidNumber(sv);
            }
            if(ok)
            {
               fval = sv;
               got_val = true;
            }
         }
         if(!got_val)
            continue;
         int stop_y  = rec.stop_flag ? 1 : 0;
         int step4_y = rec.hit_step4_plus ? 1 : 0;
         int deep_y  = (rec.stop_flag && rec.max_step_reached >= 4) ? 1 : 0;
         if(!rec.is_oos)
         {
            dev_x[dev_n]       = fval;
            dev_stop_y[dev_n]  = stop_y;
            dev_step4_y[dev_n] = step4_y;
            dev_deep_y[dev_n]  = deep_y;
            dev_n++;
            if(stop_y == 1)  stop_pos_dev++;  else stop_neg_dev++;
            if(step4_y == 1) step4_pos_dev++; else step4_neg_dev++;
            if(deep_y == 1)  deep_pos_dev++;  else deep_neg_dev++;
         }
         else
         {
            oos_x[oos_n]       = fval;
            oos_stop_y[oos_n]  = stop_y;
            oos_step4_y[oos_n] = step4_y;
            oos_deep_y[oos_n]  = deep_y;
            oos_n++;
            if(stop_y == 1)  stop_pos_oos++;  else stop_neg_oos++;
            if(step4_y == 1) step4_pos_oos++; else step4_neg_oos++;
            if(deep_y == 1)  deep_pos_oos++;  else deep_neg_oos++;
         }
      }
      ArrayResize(dev_x,       dev_n);
      ArrayResize(dev_stop_y,  dev_n);
      ArrayResize(dev_step4_y, dev_n);
      ArrayResize(dev_deep_y,  dev_n);
      ArrayResize(oos_x,       oos_n);
      ArrayResize(oos_stop_y,  oos_n);
      ArrayResize(oos_step4_y, oos_n);
      ArrayResize(oos_deep_y,  oos_n);
      int total_n = dev_n + oos_n;
      SFeatureImportanceRow row;
      row.Reset();
      row.feature_name  = fn;
      row.tf_name       = (tn != "" ? tn : "GLOBAL");
      row.feature_group = FI_GetFeatureGroup(fn);
      //==============================================================
      // StopFlag
      //==============================================================
      row.stop_n          = total_n;
      row.stop_positive_n = stop_pos_dev + stop_pos_oos;
      row.stop_negative_n = stop_neg_dev + stop_neg_oos;
      row.stop_status     = FI_GetTargetStatus(row.stop_positive_n);
      if(row.stop_status != "INSUFFICIENT" &&
         dev_n >= FI_MIN_TOTAL_FOR_AUC &&
         stop_pos_dev >= FI_MIN_POSITIVE_FOR_AUC)
      {
         row.stop_dev_auc = RL_CalcAUC(dev_x, dev_stop_y, dev_n);
         row.stop_auc     = row.stop_dev_auc;
         double mp = 0.0, mn = 0.0, sp = 0.0, sn = 0.0;
         int np = 0, nn = 0;
         for(int i = 0; i < dev_n; i++)
         {
            if(dev_stop_y[i] == 1) { mp += dev_x[i]; np++; }
            else                   { mn += dev_x[i]; nn++; }
         }
         if(np > 1 && nn > 1)
         {
            mp /= np;
            mn /= nn;
            for(int i = 0; i < dev_n; i++)
            {
               if(dev_stop_y[i] == 1) sp += (dev_x[i] - mp) * (dev_x[i] - mp);
               else                   sn += (dev_x[i] - mn) * (dev_x[i] - mn);
            }
            double pool = MathSqrt(((np - 1) * sp / np + (nn - 1) * sn / nn) / (np + nn - 2));
            if(pool > 0.0001)
               row.stop_cohen_d = (mp - mn) / pool;
         }
         if(oos_n >= FI_MIN_TOTAL_FOR_AUC && stop_pos_oos >= 3)
         {
            row.stop_oos_auc = RL_CalcAUC(oos_x, oos_stop_y, oos_n);
            row.stop_auc_decay_pct = FI_CalcDecayAbs(row.stop_dev_auc, row.stop_oos_auc);
         }
         if(stop_pos_dev >= FI_MIN_POSITIVE_FOR_CI && dev_n >= 30)
         {
            RL_BootstrapAUC_CI(dev_x, dev_stop_y, dev_n,
                               row.stop_auc_ci_lo, row.stop_auc_ci_hi, 200);
         }
      }
      //==============================================================
      // HitStep4Plus
      //==============================================================
      row.step4_n          = total_n;
      row.step4_positive_n = step4_pos_dev + step4_pos_oos;
      row.step4_negative_n = step4_neg_dev + step4_neg_oos;
      row.step4_status     = FI_GetTargetStatus(row.step4_positive_n);
      if(row.step4_status != "INSUFFICIENT" &&
         dev_n >= FI_MIN_TOTAL_FOR_AUC &&
         step4_pos_dev >= FI_MIN_POSITIVE_FOR_AUC)
      {
         row.step4_dev_auc = RL_CalcAUC(dev_x, dev_step4_y, dev_n);
         row.step4_auc     = row.step4_dev_auc;
         double mp = 0.0, mn = 0.0, sp = 0.0, sn = 0.0;
         int np = 0, nn = 0;
         for(int i = 0; i < dev_n; i++)
         {
            if(dev_step4_y[i] == 1) { mp += dev_x[i]; np++; }
            else                    { mn += dev_x[i]; nn++; }
         }
         if(np > 1 && nn > 1)
         {
            mp /= np;
            mn /= nn;
            for(int i = 0; i < dev_n; i++)
            {
               if(dev_step4_y[i] == 1) sp += (dev_x[i] - mp) * (dev_x[i] - mp);
               else                    sn += (dev_x[i] - mn) * (dev_x[i] - mn);
            }
            double pool = MathSqrt(((np - 1) * sp / np + (nn - 1) * sn / nn) / (np + nn - 2));
            if(pool > 0.0001)
               row.step4_cohen_d = (mp - mn) / pool;
         }
         if(oos_n >= FI_MIN_TOTAL_FOR_AUC && step4_pos_oos >= 3)
         {
            row.step4_oos_auc = RL_CalcAUC(oos_x, oos_step4_y, oos_n);
            row.step4_auc_decay_pct = FI_CalcDecayAbs(row.step4_dev_auc, row.step4_oos_auc);
         }
         if(step4_pos_dev >= FI_MIN_POSITIVE_FOR_CI && dev_n >= 30)
         {
            RL_BootstrapAUC_CI(dev_x, dev_step4_y, dev_n,
                               row.step4_auc_ci_lo, row.step4_auc_ci_hi, 200);
         }
      }
      //==============================================================
      // DeepStop
      //==============================================================
      row.deepstop_n          = total_n;
      row.deepstop_positive_n = deep_pos_dev + deep_pos_oos;
      row.deepstop_negative_n = deep_neg_dev + deep_neg_oos;
      row.deepstop_status     = FI_GetTargetStatus(row.deepstop_positive_n);
      if(row.deepstop_status != "INSUFFICIENT" &&
         dev_n >= FI_MIN_TOTAL_FOR_AUC &&
         deep_pos_dev >= FI_MIN_POSITIVE_FOR_AUC)
      {
         row.deepstop_dev_auc = RL_CalcAUC(dev_x, dev_deep_y, dev_n);
         row.deepstop_auc     = row.deepstop_dev_auc;
         double mp = 0.0, mn = 0.0, sp = 0.0, sn = 0.0;
         int np = 0, nn = 0;
         for(int i = 0; i < dev_n; i++)
         {
            if(dev_deep_y[i] == 1) { mp += dev_x[i]; np++; }
            else                   { mn += dev_x[i]; nn++; }
         }
         if(np > 1 && nn > 1)
         {
            mp /= np;
            mn /= nn;
            for(int i = 0; i < dev_n; i++)
            {
               if(dev_deep_y[i] == 1) sp += (dev_x[i] - mp) * (dev_x[i] - mp);
               else                   sn += (dev_x[i] - mn) * (dev_x[i] - mn);
            }
            double pool = MathSqrt(((np - 1) * sp / np + (nn - 1) * sn / nn) / (np + nn - 2));
            if(pool > 0.0001)
               row.deepstop_cohen_d = (mp - mn) / pool;
         }
         if(oos_n >= FI_MIN_TOTAL_FOR_AUC && deep_pos_oos >= 3)
         {
            row.deepstop_oos_auc = RL_CalcAUC(oos_x, oos_deep_y, oos_n);
            row.deepstop_auc_decay_pct = FI_CalcDecayAbs(row.deepstop_dev_auc, row.deepstop_oos_auc);
         }
         if(deep_pos_dev >= FI_MIN_POSITIVE_FOR_CI && dev_n >= 30)
         {
            RL_BootstrapAUC_CI(dev_x, dev_deep_y, dev_n,
                               row.deepstop_auc_ci_lo, row.deepstop_auc_ci_hi, 200);
         }
      }
      //==============================================================
      // Composite / Verdict
      //==============================================================
      bool stop_ok  = (row.stop_status != "INSUFFICIENT" && row.stop_dev_auc > 0.0);
      bool step4_ok = (row.step4_status != "INSUFFICIENT" && row.step4_dev_auc > 0.0);
      bool deep_ok  = (row.deepstop_status != "INSUFFICIENT" && row.deepstop_dev_auc > 0.0);
      bool any_analyzable = (stop_ok || step4_ok || deep_ok);
      if(!any_analyzable)
      {
         row.best_target = "";
         row.direction = "NO_SIGNAL";
         row.oos_stability_label = "INSUFFICIENT_OOS";
         row.oos_stable = false;
         row.composite_score = 0.0;
         row.verdict = "INSUFFICIENT";
         g_feature_importance[g_feature_importance_count++] = row;
         ArrayFree(dev_x);
         ArrayFree(dev_stop_y);
         ArrayFree(dev_step4_y);
         ArrayFree(dev_deep_y);
         ArrayFree(oos_x);
         ArrayFree(oos_stop_y);
         ArrayFree(oos_step4_y);
         ArrayFree(oos_deep_y);
         continue;
      }
      double eff_stop_auc  = (row.stop_oos_auc  > 0.0 ? row.stop_oos_auc  : row.stop_dev_auc);
      double eff_step4_auc = (row.step4_oos_auc > 0.0 ? row.step4_oos_auc : row.step4_dev_auc);
      double eff_deep_auc  = (row.deepstop_oos_auc > 0.0 ? row.deepstop_oos_auc : row.deepstop_dev_auc);
      double auc_stop_norm  = stop_ok  ? MathMax(0.0, (eff_stop_auc  - 0.5) / 0.5) : 0.0;
      double auc_step4_norm = step4_ok ? MathMax(0.0, (eff_step4_auc - 0.5) / 0.5) : 0.0;
      double auc_deep_norm  = deep_ok  ? MathMax(0.0, (eff_deep_auc  - 0.5) / 0.5) : 0.0;
      double best_auc_norm = MathMax(auc_stop_norm, MathMax(auc_step4_norm, auc_deep_norm));
      double d_stop_norm  = MathMin(MathAbs(row.stop_cohen_d)     / 0.8, 1.0);
      double d_step4_norm = MathMin(MathAbs(row.step4_cohen_d)    / 0.8, 1.0);
      double d_deep_norm  = MathMin(MathAbs(row.deepstop_cohen_d) / 0.8, 1.0);
      double best_d_norm = MathMax(d_stop_norm, MathMax(d_step4_norm, d_deep_norm));
      if(auc_stop_norm >= auc_step4_norm && auc_stop_norm >= auc_deep_norm)
         row.best_target = "StopFlag";
      else if(auc_step4_norm >= auc_deep_norm)
         row.best_target = "HitStep4Plus";
      else
         row.best_target = "DeepStop";
      double best_d = 0.0;
      double primary_decay = 0.0;
      bool   has_primary_oos = false;
      if(row.best_target == "StopFlag")
      {
         best_d = row.stop_cohen_d;
         primary_decay = row.stop_auc_decay_pct;
         has_primary_oos = (row.stop_oos_auc > 0.0);
      }
      else if(row.best_target == "HitStep4Plus")
      {
         best_d = row.step4_cohen_d;
         primary_decay = row.step4_auc_decay_pct;
         has_primary_oos = (row.step4_oos_auc > 0.0);
      }
      else
      {
         best_d = row.deepstop_cohen_d;
         primary_decay = row.deepstop_auc_decay_pct;
         has_primary_oos = (row.deepstop_oos_auc > 0.0);
      }
      if(MathAbs(best_d) < 0.10) row.direction = "NO_SIGNAL";
      else if(best_d > 0.0)      row.direction = "HIGH_RISK";
      else                       row.direction = "LOW_RISK";
      double stability_score = 0.0;
      if(has_primary_oos)
      {
         double abs_decay = MathAbs(primary_decay);
         if(abs_decay <= FI_DECAY_STABLE)      stability_score = 1.0;
         else if(abs_decay <= FI_DECAY_MILD)   stability_score = 0.6;
         else                                  stability_score = 0.2;
         row.oos_stability_label = FI_GetDecayLabel(primary_decay);
         row.oos_stable = (row.oos_stability_label == "STABLE" ||
                           row.oos_stability_label == "MILD_DEGRADATION" ||
                           row.oos_stability_label == "IMPROVING");
         if(row.oos_stability_label == "IMPROVING")
            stability_score = MathMax(stability_score, 0.9);
      }
      else
      {
         row.oos_stability_label = "INSUFFICIENT_OOS";
         row.oos_stable = false;
         stability_score = 0.1;
      }
      int total_pos = row.stop_positive_n + row.step4_positive_n + row.deepstop_positive_n;
      double sample_score = MathMin((double)total_pos / 200.0, 1.0);
      row.composite_score =
         0.40 * best_auc_norm +
         0.35 * best_d_norm +
         0.15 * stability_score +
         0.10 * sample_score;
      double best_eff_auc = 0.5;
      double best_eff_d_abs = 0.0;
      if(stop_ok && eff_stop_auc > best_eff_auc)
      {
         best_eff_auc = eff_stop_auc;
         best_eff_d_abs = MathAbs(row.stop_cohen_d);
      }
      if(step4_ok && eff_step4_auc > best_eff_auc)
      {
         best_eff_auc = eff_step4_auc;
         best_eff_d_abs = MathAbs(row.step4_cohen_d);
      }
      if(deep_ok && eff_deep_auc > best_eff_auc)
      {
         best_eff_auc = eff_deep_auc;
         best_eff_d_abs = MathAbs(row.deepstop_cohen_d);
      }
            // Check for direction reversal between DEV and OOS
      bool direction_reversed = false;
      if(row.best_target == "StopFlag" &&
         row.stop_dev_auc > 0.0 && row.stop_oos_auc > 0.0)
      {
         // DEV < 0.5 but OOS > 0.5 OR DEV > 0.5 but OOS < 0.5
         bool dev_positive = (row.stop_dev_auc > 0.505);
         bool oos_positive = (row.stop_oos_auc > 0.505);
         if(dev_positive != oos_positive)
            direction_reversed = true;
      }
      else if(row.best_target == "HitStep4Plus" &&
              row.step4_dev_auc > 0.0 && row.step4_oos_auc > 0.0)
      {
         bool dev_positive = (row.step4_dev_auc > 0.505);
         bool oos_positive = (row.step4_oos_auc > 0.505);
         if(dev_positive != oos_positive)
            direction_reversed = true;
      }
      else if(row.best_target == "DeepStop" &&
              row.deepstop_dev_auc > 0.0 && row.deepstop_oos_auc > 0.0)
      {
         bool dev_positive = (row.deepstop_dev_auc > 0.505);
         bool oos_positive = (row.deepstop_oos_auc > 0.505);
         if(dev_positive != oos_positive)
            direction_reversed = true;
      }
      if(direction_reversed)
      {
         row.oos_stability_label = "DIRECTION_REVERSED";
         row.oos_stable = false;
         row.verdict = "NOISE";
      }
      else if(best_eff_auc >= FI_AUC_STRONG &&
              best_eff_d_abs >= FI_COHEN_STRONG &&
              row.oos_stable)
      {
         row.verdict = "STRONG";
      }
      else if(best_eff_auc >= FI_AUC_MODERATE &&
              best_eff_d_abs >= FI_COHEN_MODERATE &&
              !direction_reversed)
      {
         row.verdict = "MODERATE";
      }
      else if(row.oos_stability_label == "IMPROVING" &&
              best_eff_auc >= 0.55 &&
              !direction_reversed)
      {
         row.verdict = "PROMISING";
      }
      else if(best_eff_auc >= FI_AUC_WEAK)
      {
         row.verdict = "WEAK";
      }
      else
      {
         row.verdict = "NOISE";
      }
      g_feature_importance[g_feature_importance_count++] = row;
      ArrayFree(dev_x);
      ArrayFree(dev_stop_y);
      ArrayFree(dev_step4_y);
      ArrayFree(dev_deep_y);
      ArrayFree(oos_x);
      ArrayFree(oos_stop_y);
      ArrayFree(oos_step4_y);
      ArrayFree(oos_deep_y);
   }
   ArrayFree(snap_lookup);
   //================================================================
   // Step 3: Sort descending by composite score
   //================================================================
   int gap = g_feature_importance_count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < g_feature_importance_count; i++)
      {
         SFeatureImportanceRow temp = g_feature_importance[i];
         int j = i;
         while(j >= gap &&
               g_feature_importance[j - gap].composite_score < temp.composite_score)
         {
            g_feature_importance[j] = g_feature_importance[j - gap];
            j -= gap;
         }
         g_feature_importance[j] = temp;
      }
      gap /= 2;
   }
   //================================================================
   // Diagnostics
   //================================================================
   Print("=== Stage 2A OOS Split Diagnostic ===");
   int dev_stop = 0, oos_stop = 0;
   int dev_step4 = 0, oos_step4 = 0;
   int dev_n_total = 0, oos_n_total = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos)
      {
         dev_n_total++;
         if(g_risklab_records[r].stop_flag)      dev_stop++;
         if(g_risklab_records[r].hit_step4_plus) dev_step4++;
      }
      else
      {
         oos_n_total++;
         if(g_risklab_records[r].stop_flag)      oos_stop++;
         if(g_risklab_records[r].hit_step4_plus) oos_step4++;
      }
   }
   Print("  DEV: N=", dev_n_total, " | Stop=", dev_stop, " | Step4=", dev_step4);
   Print("  OOS: N=", oos_n_total, " | Stop=", oos_stop, " | Step4=", oos_step4);
   if(oos_stop == 0)
      Print("  CRITICAL: OOS has 0 StopFlag positives — StopFlag analysis invalid.");
   if(oos_step4 < 5)
      Print("  WARNING: OOS has only ", oos_step4, " HitStep4Plus positives — AUC unreliable.");
   if(oos_step4 == 0)
      Print("  CRITICAL: OOS has 0 HitStep4Plus positives — all positives clustered in DEV.");
   Print("======================================");
   int cnt_strong = 0, cnt_mod = 0, cnt_weak = 0, cnt_noise = 0, cnt_insuf = 0, cnt_prom = 0;
   for(int i = 0; i < g_feature_importance_count; i++)
   {
      string v = g_feature_importance[i].verdict;
      if(v == "STRONG")         cnt_strong++;
      else if(v == "MODERATE")  cnt_mod++;
      else if(v == "PROMISING") cnt_prom++;
      else if(v == "WEAK")      cnt_weak++;
      else if(v == "NOISE")     cnt_noise++;
      else                      cnt_insuf++;
   }
   Print("Stage 2A v1.4 Matrix built:",
         " Total=", g_feature_importance_count,
         " STRONG=", cnt_strong,
         " MODERATE=", cnt_mod,
         " PROMISING=", cnt_prom,
         " WEAK=", cnt_weak,
         " NOISE=", cnt_noise,
         " INSUFFICIENT=", cnt_insuf);
}
void RL_ExportFeatureImportanceResults()
{
   if(g_feature_importance_count <= 0)
   {
      Print("RL_ExportFeatureImportanceResults: No data.");
      return;
   }
   //================================================================
   // CSV
   //================================================================
   string csv_fn = "FeatureImportance_" + _Symbol + ".csv";
   int hc = SafeOpenCSV(csv_fn);
   if(hc == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create FeatureImportance CSV");
      return;
   }
   string hdr = "Feature,Group,TF,";
   hdr += "Stop_AUC,Stop_DEV_AUC,Stop_OOS_AUC,Stop_Decay,Stop_CI_Lo,Stop_CI_Hi,Stop_CohensD,Stop_N,Stop_Positive_N,Stop_Negative_N,Stop_Status,";
   hdr += "Step4_AUC,Step4_DEV_AUC,Step4_OOS_AUC,Step4_Decay,Step4_CI_Lo,Step4_CI_Hi,Step4_CohensD,Step4_N,Step4_Positive_N,Step4_Negative_N,Step4_Status,";
   hdr += "DeepStop_AUC,DeepStop_DEV_AUC,DeepStop_OOS_AUC,DeepStop_Decay,DeepStop_CI_Lo,DeepStop_CI_Hi,DeepStop_CohensD,DeepStop_N,DeepStop_Positive_N,DeepStop_Negative_N,DeepStop_Status,";
   hdr += "Composite_Score,Verdict,Best_Target,Direction,OOS_Stable,OOS_Stability_Label,Note";
   FileWriteString(hc, hdr + "\r\n");
   for(int i = 0; i < g_feature_importance_count; i++)
   {
      SFeatureImportanceRow r = g_feature_importance[i];
      string row = "";
      row += EscapeCSV(r.feature_name)  + ",";
      row += EscapeCSV(r.feature_group) + ",";
      row += EscapeCSV(r.tf_name)       + ",";
      row += DoubleToString(r.stop_auc,          4) + ",";
      row += DoubleToString(r.stop_dev_auc,      4) + ",";
      row += DoubleToString(r.stop_oos_auc,      4) + ",";
      row += DoubleToString(r.stop_auc_decay_pct,4) + ",";
      row += DoubleToString(r.stop_auc_ci_lo,    4) + ",";
      row += DoubleToString(r.stop_auc_ci_hi,    4) + ",";
      row += DoubleToString(r.stop_cohen_d,      4) + ",";
      row += IntegerToString(r.stop_n)               + ",";
      row += IntegerToString(r.stop_positive_n)      + ",";
      row += IntegerToString(r.stop_negative_n)      + ",";
      row += EscapeCSV(r.stop_status)                + ",";
      row += DoubleToString(r.step4_auc,          4) + ",";
      row += DoubleToString(r.step4_dev_auc,      4) + ",";
      row += DoubleToString(r.step4_oos_auc,      4) + ",";
      row += DoubleToString(r.step4_auc_decay_pct,4) + ",";
      row += DoubleToString(r.step4_auc_ci_lo,    4) + ",";
      row += DoubleToString(r.step4_auc_ci_hi,    4) + ",";
      row += DoubleToString(r.step4_cohen_d,      4) + ",";
      row += IntegerToString(r.step4_n)               + ",";
      row += IntegerToString(r.step4_positive_n)      + ",";
      row += IntegerToString(r.step4_negative_n)      + ",";
      row += EscapeCSV(r.step4_status)                + ",";
      row += DoubleToString(r.deepstop_auc,          4) + ",";
      row += DoubleToString(r.deepstop_dev_auc,      4) + ",";
      row += DoubleToString(r.deepstop_oos_auc,      4) + ",";
      row += DoubleToString(r.deepstop_auc_decay_pct,4) + ",";
      row += DoubleToString(r.deepstop_auc_ci_lo,    4) + ",";
      row += DoubleToString(r.deepstop_auc_ci_hi,    4) + ",";
      row += DoubleToString(r.deepstop_cohen_d,      4) + ",";
      row += IntegerToString(r.deepstop_n)               + ",";
      row += IntegerToString(r.deepstop_positive_n)      + ",";
      row += IntegerToString(r.deepstop_negative_n)      + ",";
      row += EscapeCSV(r.deepstop_status)                + ",";
      row += DoubleToString(r.composite_score, 4) + ",";
      row += EscapeCSV(r.verdict)                + ",";
      row += EscapeCSV(r.best_target)            + ",";
      row += EscapeCSV(r.direction)              + ",";
      row += (r.oos_stable ? "YES" : "NO")       + ",";
      row += EscapeCSV(r.oos_stability_label)    + ",";
      row += "Decay=DEV-OOS(absolute)";
      FileWriteString(hc, row + "\r\n");
   }
   FileFlush(hc);
   FileClose(hc);
   Print("FeatureImportance v1.3 CSV exported: ", csv_fn);
   //================================================================
   // TXT Summary
   //================================================================
   string txt_fn = "FeatureImportance_Summary_" + _Symbol + ".txt";
   if(FileIsExist(txt_fn, FILE_COMMON))
      FileDelete(txt_fn, FILE_COMMON);
   int ht = FileOpen(txt_fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(ht == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create FeatureImportance Summary TXT");
      return;
   }
   string line = "================================================================\r\n";
   string sep  = "----------------------------------------------------------------\r\n";
   FileWriteString(ht, line);
   FileWriteString(ht, "STAGE 2A v1.3: FEATURE IMPORTANCE SUMMARY\r\n");
   FileWriteString(ht, "Symbol=" + _Symbol + " | Snapshots=" + IntegerToString(g_snapshot_count) + "\r\n");
   FileWriteString(ht, "GeneratedAt=" + TimeToString(TimeCurrent(), TIME_DATE | TIME_MINUTES) + "\r\n");
   FileWriteString(ht, "Targets: StopFlag / HitStep4Plus / DeepStop\r\n");
   FileWriteString(ht, "AUC thresholds: STRONG>=" + DoubleToString(FI_AUC_STRONG, 2) +
                       " MODERATE>=" + DoubleToString(FI_AUC_MODERATE, 2) +
                       " WEAK>=" + DoubleToString(FI_AUC_WEAK, 2) + "\r\n");
   FileWriteString(ht, line);
   //==============================================================
   // Target Quality
   //==============================================================
   int stop_pos_total = 0, step4_pos_total = 0, deep_pos_total = 0;
   for(int i = 0; i < g_feature_importance_count; i++)
   {
      if(g_feature_importance[i].stop_positive_n > stop_pos_total)
         stop_pos_total = g_feature_importance[i].stop_positive_n;
      if(g_feature_importance[i].step4_positive_n > step4_pos_total)
         step4_pos_total = g_feature_importance[i].step4_positive_n;
      if(g_feature_importance[i].deepstop_positive_n > deep_pos_total)
         deep_pos_total = g_feature_importance[i].deepstop_positive_n;
   }
   FileWriteString(ht, "\r\n[TARGET QUALITY]\r\n");
   FileWriteString(ht, sep);
   FileWriteString(ht, "StopFlag:      Positive_N=" + IntegerToString(stop_pos_total) +
                       " | Status=" + FI_GetTargetStatus(stop_pos_total) + "\r\n");
   FileWriteString(ht, "HitStep4Plus:  Positive_N=" + IntegerToString(step4_pos_total) +
                       " | Status=" + FI_GetTargetStatus(step4_pos_total) + "\r\n");
   FileWriteString(ht, "DeepStop:      Positive_N=" + IntegerToString(deep_pos_total) +
                       " | Status=" + FI_GetTargetStatus(deep_pos_total) + "\r\n");
   //==============================================================
   // Overall Stats
   //==============================================================
   int cnt_strong = 0, cnt_mod = 0, cnt_weak = 0, cnt_noise = 0, cnt_insuf = 0, cnt_prom = 0;
   int cnt_oos_stable = 0;
   int cnt_by_group[9];
   ArrayInitialize(cnt_by_group, 0);
   string group_names[9] = {"TREND","MOMENTUM","VOLATILITY","STRENGTH","PIVOT","DIVERGENCE","OB","MTF","OTHER"};
   for(int i = 0; i < g_feature_importance_count; i++)
   {
      string v = g_feature_importance[i].verdict;
      if(v == "STRONG")         cnt_strong++;
      else if(v == "MODERATE")  cnt_mod++;
      else if(v == "PROMISING") cnt_prom++;
      else if(v == "WEAK")      cnt_weak++;
      else if(v == "NOISE")     cnt_noise++;
      else                      cnt_insuf++;
      if(g_feature_importance[i].oos_stable) cnt_oos_stable++;
      string grp = g_feature_importance[i].feature_group;
      for(int g = 0; g < 9; g++)
      {
         if(grp == group_names[g])
         {
            cnt_by_group[g]++;
            break;
         }
      }
   }
   FileWriteString(ht, "\r\n[OVERALL STATS]\r\n");
   FileWriteString(ht, sep);
   FileWriteString(ht, "Total Features Analyzed = " + IntegerToString(g_feature_importance_count) + "\r\n");
   FileWriteString(ht, "STRONG       = " + IntegerToString(cnt_strong)    + "\r\n");
   FileWriteString(ht, "MODERATE     = " + IntegerToString(cnt_mod)        + "\r\n");
   FileWriteString(ht, "PROMISING    = " + IntegerToString(cnt_prom)       + "\r\n");
   FileWriteString(ht, "WEAK         = " + IntegerToString(cnt_weak)       + "\r\n");
   FileWriteString(ht, "NOISE        = " + IntegerToString(cnt_noise)      + "\r\n");
   FileWriteString(ht, "INSUFFICIENT = " + IntegerToString(cnt_insuf)      + "\r\n");
   FileWriteString(ht, "OOS_Stable   = " + IntegerToString(cnt_oos_stable) + "\r\n");
   FileWriteString(ht, "\r\n[BY FEATURE GROUP]\r\n");
   FileWriteString(ht, sep);
   for(int g = 0; g < 9; g++)
   {
      if(cnt_by_group[g] > 0)
         FileWriteString(ht, group_names[g] + "=" + IntegerToString(cnt_by_group[g]) + "\r\n");
   }
   //==============================================================
   // Top Features per target
   //==============================================================
   string targets_list[3]  = {"StopFlag", "HitStep4Plus", "DeepStop"};
   string targets_title[3] = {"STOP REDUCTION", "STEP4+ DETECTION", "DEEP STOP DETECTION"};
   for(int t = 0; t < 3; t++)
   {
      FileWriteString(ht, "\r\n[TOP FEATURES — " + targets_title[t] + "]\r\n");
      FileWriteString(ht, sep);
      FileWriteString(ht, StringFormat("%-5s | %-30s | %-10s | %8s | %8s | %8s | %8s | %10s | %10s\r\n",
                                       "Rank","Feature (TF)","Group","DEV_AUC","OOS_AUC","Decay","Cohen_d","Verdict","OOS_Label"));
      FileWriteString(ht, sep);
      int rank = 1;
      for(int i = 0; i < g_feature_importance_count && rank <= 20; i++)
      {
         SFeatureImportanceRow r = g_feature_importance[i];
         if(r.best_target != targets_list[t]) continue;
         if(r.verdict == "NOISE" || r.verdict == "INSUFFICIENT") continue;
         double dev_auc = 0.0, oos_auc = 0.0, decay = 0.0, d = 0.0;
         string status = "";
         if(targets_list[t] == "StopFlag")
         {
            status = r.stop_status;
            dev_auc = r.stop_dev_auc;
            oos_auc = r.stop_oos_auc;
            decay   = r.stop_auc_decay_pct;
            d       = r.stop_cohen_d;
         }
         else if(targets_list[t] == "HitStep4Plus")
         {
            status = r.step4_status;
            dev_auc = r.step4_dev_auc;
            oos_auc = r.step4_oos_auc;
            decay   = r.step4_auc_decay_pct;
            d       = r.step4_cohen_d;
         }
         else
         {
            status = r.deepstop_status;
            dev_auc = r.deepstop_dev_auc;
            oos_auc = r.deepstop_oos_auc;
            decay   = r.deepstop_auc_decay_pct;
            d       = r.deepstop_cohen_d;
         }
         if(status == "INSUFFICIENT") continue;
         string feat_tf = r.feature_name + (r.tf_name != "GLOBAL" ? " (" + r.tf_name + ")" : "");
         FileWriteString(ht, StringFormat("%-5d | %-30s | %-10s | %8.4f | %8.4f | %8.4f | %8.4f | %10s | %10s\r\n",
                                          rank, feat_tf, r.feature_group,
                                          dev_auc, oos_auc, decay, d, r.verdict,
                                          r.oos_stability_label));
         rank++;
      }
      if(rank == 1)
         FileWriteString(ht, "  No qualifying features for this target.\r\n");
   }
   //==============================================================
   // Recommended
   //==============================================================
   FileWriteString(ht, "\r\n[RECOMMENDED FOR STAGE 2B — OOS STABLE/IMPROVING]\r\n");
   FileWriteString(ht, sep);
   int rec_count = 0;
   for(int i = 0; i < g_feature_importance_count && rec_count < 20; i++)
   {
      if((g_feature_importance[i].verdict == "STRONG" ||
          g_feature_importance[i].verdict == "MODERATE" ||
          g_feature_importance[i].verdict == "PROMISING") &&
          g_feature_importance[i].oos_stable &&
          g_feature_importance[i].oos_stability_label != "DIRECTION_REVERSED")
      {
         string feat_tf = g_feature_importance[i].feature_name +
                          (g_feature_importance[i].tf_name != "GLOBAL" ?
                           " (" + g_feature_importance[i].tf_name + ")" : "");
         double dev_auc = 0.0;
         double oos_auc = 0.0;
         if(g_feature_importance[i].best_target == "StopFlag")
         {
            dev_auc = g_feature_importance[i].stop_dev_auc;
            oos_auc = g_feature_importance[i].stop_oos_auc;
         }
         else if(g_feature_importance[i].best_target == "HitStep4Plus")
         {
            dev_auc = g_feature_importance[i].step4_dev_auc;
            oos_auc = g_feature_importance[i].step4_oos_auc;
         }
         else
         {
            dev_auc = g_feature_importance[i].deepstop_dev_auc;
            oos_auc = g_feature_importance[i].deepstop_oos_auc;
         }
         FileWriteString(ht, "  " + feat_tf +
                         " | " + g_feature_importance[i].verdict +
                         " | " + g_feature_importance[i].direction +
                         " | OOS=" + g_feature_importance[i].oos_stability_label +
                         " | DEV_AUC=" + DoubleToString(dev_auc, 4) +
                         " | OOS_AUC=" + DoubleToString(oos_auc, 4) + "\r\n");
         rec_count++;
      }
   }
   if(rec_count == 0)
      FileWriteString(ht, "  None found.\r\n");
   FileWriteString(ht, "\r\n" + line);
   FileFlush(ht);
   FileClose(ht);
   Print("FeatureImportance v1.3 Summary exported: ", txt_fn);
}
string RL_BuildDistributionTable(string label, bool buy_only, bool filter_oos, bool want_oos = false)
{
   int n = 0, safe = 0, warn = 0, danger = 0;
   int stop_cnt = 0, hit_s3 = 0, hit_s4 = 0;
   double sum_pnl = 0.0;
   // توزیع MaxStep
   int step_dist[6] = {0,0,0,0,0,0};
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(StringFind(label, "BUY")  >= 0 && g_risklab_records[i].signal != "BUY")  continue;
      if(StringFind(label, "SELL") >= 0 && g_risklab_records[i].signal != "SELL") continue;
      if(filter_oos && g_risklab_records[i].is_oos != want_oos) continue;
      n++;
      if(g_risklab_records[i].group3 == "SAFE")    safe++;
      if(g_risklab_records[i].group3 == "WARNING") warn++;
      if(g_risklab_records[i].group3 == "DANGER")  danger++;
      if(g_risklab_records[i].stop_flag)            stop_cnt++;
      if(g_risklab_records[i].hit_step3_plus)       hit_s3++;
      if(g_risklab_records[i].hit_step4_plus)       hit_s4++;
      sum_pnl += g_risklab_records[i].pnl;
      int ms = g_risklab_records[i].max_step_reached;
      if(ms >= 1 && ms <= 5)
         step_dist[ms]++;
   }
   if(n == 0) return label + " — No data\r\n";
   string out = label + "\r\n";
   // خط ۱: توزیع group3
   out += "N,SAFE,SAFE%,WARNING,WARNING%,DANGER,DANGER%,Stop%,HitStep3%,HitStep4%,AvgPnL\r\n";
   out += IntegerToString(n) + ",";
   out += IntegerToString(safe)   + "," + DoubleToString(safe   * 100.0 / n, 1) + ",";
   out += IntegerToString(warn)   + "," + DoubleToString(warn   * 100.0 / n, 1) + ",";
   out += IntegerToString(danger) + "," + DoubleToString(danger * 100.0 / n, 1) + ",";
   out += DoubleToString(stop_cnt * 100.0 / n, 1) + ",";
   out += DoubleToString(hit_s3   * 100.0 / n, 1) + ",";
   out += DoubleToString(hit_s4   * 100.0 / n, 1) + ",";
   out += DoubleToString(sum_pnl / n, 2) + "\r\n";
   // خط ۲: توزیع MaxStep
   out += "Step1,Step2,Step3,Step4,Step5\r\n";
   out += IntegerToString(step_dist[1]) + "," +
          IntegerToString(step_dist[2]) + "," +
          IntegerToString(step_dist[3]) + "," +
          IntegerToString(step_dist[4]) + "," +
          IntegerToString(step_dist[5]) + "\r\n";
   return out;
}
string RL_BuildScoreDistTable(string side)
{
   const int MAX_SCORE = 9;
   int    cnt_dev[9];
   int    safe_dev[9];
   int    warn_dev[9];
   int    dang_dev[9];
   int    stop_dev[9];
   int    s3_dev[9];
   int    s4_dev[9];
   double pnl_dev[9];
   int    cnt_oos[9];
   int    safe_oos[9];
   int    warn_oos[9];
   int    dang_oos[9];
   int    stop_oos[9];
   int    s3_oos[9];
   int    s4_oos[9];
   double pnl_oos[9];
   for(int x = 0; x < 9; x++)
   {
      cnt_dev[x]  = 0; safe_dev[x]  = 0; warn_dev[x]  = 0;
      dang_dev[x] = 0; stop_dev[x]  = 0; s3_dev[x]    = 0;
      s4_dev[x]   = 0; pnl_dev[x]   = 0.0;
      cnt_oos[x]  = 0; safe_oos[x]  = 0; warn_oos[x]  = 0;
      dang_oos[x] = 0; stop_oos[x]  = 0; s3_oos[x]    = 0;
      s4_oos[x]   = 0; pnl_oos[x]   = 0.0;
   }
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].signal != side) continue;
      int sc = g_risklab_records[i].total_score;
      if(sc < 0) sc = 0;
      if(sc > 8) sc = 8;
      bool is_oos = g_risklab_records[i].is_oos;
      if(!is_oos)
      {
         cnt_dev[sc]++;
         if(g_risklab_records[i].group3 == "SAFE")    safe_dev[sc]++;
         if(g_risklab_records[i].group3 == "WARNING") warn_dev[sc]++;
         if(g_risklab_records[i].group3 == "DANGER")  dang_dev[sc]++;
         if(g_risklab_records[i].stop_flag)            stop_dev[sc]++;
         if(g_risklab_records[i].hit_step3_plus)       s3_dev[sc]++;
         if(g_risklab_records[i].hit_step4_plus)       s4_dev[sc]++;
         pnl_dev[sc] += g_risklab_records[i].pnl;
      }
      else
      {
         cnt_oos[sc]++;
         if(g_risklab_records[i].group3 == "SAFE")    safe_oos[sc]++;
         if(g_risklab_records[i].group3 == "WARNING") warn_oos[sc]++;
         if(g_risklab_records[i].group3 == "DANGER")  dang_oos[sc]++;
         if(g_risklab_records[i].stop_flag)            stop_oos[sc]++;
         if(g_risklab_records[i].hit_step3_plus)       s3_oos[sc]++;
         if(g_risklab_records[i].hit_step4_plus)       s4_oos[sc]++;
         pnl_oos[sc] += g_risklab_records[i].pnl;
      }
   }
   string out = "Score Distribution (DEV vs OOS) — " + side + "\r\n";
   out += "Score,";
   out += "DEV_Count,DEV_SAFE%,DEV_WARNING%,DEV_DANGER%,DEV_Stop%,DEV_HitS3%,DEV_HitS4%,DEV_AvgPnL,";
   out += "OOS_Count,OOS_SAFE%,OOS_WARNING%,OOS_DANGER%,OOS_Stop%,OOS_HitS3%,OOS_HitS4%,OOS_AvgPnL,";
   out += "DANGER_Stability(OOS-DEV)\r\n";
   for(int s = 0; s < 9; s++)
   {
      if(cnt_dev[s] == 0 && cnt_oos[s] == 0) continue;
      out += IntegerToString(s) + ",";
      if(cnt_dev[s] > 0)
      {
         out += IntegerToString(cnt_dev[s]) + ",";
         out += DoubleToString(safe_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(warn_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(dang_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(stop_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s3_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s4_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(pnl_dev[s]  / cnt_dev[s], 2) + ",";
      }
      else
         out += "0,-,-,-,-,-,-,-,";
      if(cnt_oos[s] > 0)
      {
         out += IntegerToString(cnt_oos[s]) + ",";
         out += DoubleToString(safe_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(warn_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(dang_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(stop_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s3_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s4_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(pnl_oos[s]  / cnt_oos[s], 2) + ",";
      }
      else
         out += "0,-,-,-,-,-,-,-,";
      if(cnt_dev[s] > 0 && cnt_oos[s] > 0)
      {
         double diff = (dang_oos[s] * 100.0 / cnt_oos[s]) -
                       (dang_dev[s] * 100.0 / cnt_dev[s]);
         out += DoubleToString(diff, 1);
      }
      else
         out += "-";
      out += "\r\n";
   }
   return out;
}
string RL_BuildBlockDistTable(string side, int block_idx, string block_name)
{
   // جداگانه برای DEV و OOS
   int cnt_dev[3], safe_dev[3], warn_dev[3], dang_dev[3], stop_dev[3];
   int s3_dev[3], s4_dev[3];
   double pnl_dev[3];
   int cnt_oos[3], safe_oos[3], warn_oos[3], dang_oos[3], stop_oos[3];
   int s3_oos[3], s4_oos[3];
   double pnl_oos[3];
   ArrayInitialize(cnt_dev,  0); ArrayInitialize(safe_dev,  0);
   ArrayInitialize(warn_dev, 0); ArrayInitialize(dang_dev,  0);
   ArrayInitialize(stop_dev, 0); ArrayInitialize(s3_dev,    0);
   ArrayInitialize(s4_dev,   0); ArrayInitialize(pnl_dev,   0.0);
   ArrayInitialize(cnt_oos,  0); ArrayInitialize(safe_oos,  0);
   ArrayInitialize(warn_oos, 0); ArrayInitialize(dang_oos,  0);
   ArrayInitialize(stop_oos, 0); ArrayInitialize(s3_oos,    0);
   ArrayInitialize(s4_oos,   0); ArrayInitialize(pnl_oos,   0.0);
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].signal != side) continue;
      int sc = 0;
      if(block_idx == 0) sc = g_risklab_records[i].block_direction;
      if(block_idx == 1) sc = g_risklab_records[i].block_strength;
      if(block_idx == 2) sc = g_risklab_records[i].block_signal_quality;
      if(block_idx == 3) sc = g_risklab_records[i].block_location;
      sc = MathMin(sc, 2);
      bool is_oos = g_risklab_records[i].is_oos;
      if(!is_oos)
      {
         cnt_dev[sc]++;
         if(g_risklab_records[i].group3 == "SAFE")    safe_dev[sc]++;
         if(g_risklab_records[i].group3 == "WARNING") warn_dev[sc]++;
         if(g_risklab_records[i].group3 == "DANGER")  dang_dev[sc]++;
         if(g_risklab_records[i].stop_flag)            stop_dev[sc]++;
         if(g_risklab_records[i].hit_step3_plus)       s3_dev[sc]++;
         if(g_risklab_records[i].hit_step4_plus)       s4_dev[sc]++;
         pnl_dev[sc] += g_risklab_records[i].pnl;
      }
      else
      {
         cnt_oos[sc]++;
         if(g_risklab_records[i].group3 == "SAFE")    safe_oos[sc]++;
         if(g_risklab_records[i].group3 == "WARNING") warn_oos[sc]++;
         if(g_risklab_records[i].group3 == "DANGER")  dang_oos[sc]++;
         if(g_risklab_records[i].stop_flag)            stop_oos[sc]++;
         if(g_risklab_records[i].hit_step3_plus)       s3_oos[sc]++;
         if(g_risklab_records[i].hit_step4_plus)       s4_oos[sc]++;
         pnl_oos[sc] += g_risklab_records[i].pnl;
      }
   }
   string out = "Block [" + block_name + "] — " + side + "\r\n";
   out += "Score,";
   out += "DEV_Count,DEV_SAFE%,DEV_WARN%,DEV_DANGER%,DEV_Stop%,DEV_HitS3%,DEV_HitS4%,DEV_AvgPnL,";
   out += "OOS_Count,OOS_SAFE%,OOS_WARN%,OOS_DANGER%,OOS_Stop%,OOS_HitS3%,OOS_HitS4%,OOS_AvgPnL\r\n";
   for(int s = 0; s <= 2; s++)
   {
      out += IntegerToString(s) + ",";
      if(cnt_dev[s] > 0)
      {
         out += IntegerToString(cnt_dev[s]) + ",";
         out += DoubleToString(safe_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(warn_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(dang_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(stop_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s3_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s4_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(pnl_dev[s] / cnt_dev[s], 2) + ",";
      }
      else
         out += "0,-,-,-,-,-,-,-,";
      if(cnt_oos[s] > 0)
      {
         out += IntegerToString(cnt_oos[s]) + ",";
         out += DoubleToString(safe_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(warn_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(dang_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(stop_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s3_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s4_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(pnl_oos[s] / cnt_oos[s], 2) + "\r\n";
      }
      else
         out += "0,-,-,-,-,-,-,-\r\n";
   }
   return out;
}
string RL_BuildAblationTable(string side)
{
   // Ablation واقعی:
   // برای هر مدل (ترکیبی از Blockها)، score را محاسبه کن
   // سپس رکوردهایی که score <= threshold دارند را "رد" کن
   // و فقط رکوردهایی که score > threshold دارند را "قبول" کن
   // threshold = 0 یعنی همه قبول (baseline)
   // threshold = 1 یعنی فقط score >= 2 قبول
   // threshold = 2 یعنی فقط score >= 3 قبول
   string model_names[9] = {
      "Dir_Only","Str_Only","Sig_Only","Loc_Only",
      "Dir+Str","Dir+Sig","Str+Sig","Dir+Str+Sig","All4"
   };
   int model_masks[9] = {1,2,4,8,3,5,6,7,15};
   string out = "Ablation (Real) — " + side + "\r\n";
   out += "Model,Threshold,";
   out += "Accepted,Rejected,Coverage%,";
   out += "Accepted_SAFE%,Accepted_WARNING%,Accepted_DANGER%,";
   out += "Accepted_Stop%,Accepted_HitStep3%,Accepted_HitStep4%,";
   out += "Rejected_DANGER%,Rejected_Stop%,";
   out += "Accepted_AvgPnL,Rejected_AvgPnL,";
   out += "DANGER_Reduction%\r\n";
   // baseline: همه رکوردها
   int base_n = 0;
   int base_danger = 0, base_stop = 0, base_s3 = 0, base_s4 = 0;
   double base_pnl = 0.0;
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].signal != side) continue;
      base_n++;
      if(g_risklab_records[i].group3 == "DANGER") base_danger++;
      if(g_risklab_records[i].stop_flag) base_stop++;
      if(g_risklab_records[i].hit_step3_plus) base_s3++;
      if(g_risklab_records[i].hit_step4_plus) base_s4++;
      base_pnl += g_risklab_records[i].pnl;
   }
   if(base_n == 0) return out + side + " — No data\r\n";
   double base_danger_pct = base_danger * 100.0 / base_n;
   for(int m = 0; m < 9; m++)
   {
      int mask = model_masks[m];
      // سه threshold امتحان کن: قبول score>=1، score>=2، score>=3
      for(int thr = 1; thr <= 3; thr++)
      {
         int acc = 0, rej = 0;
         int acc_safe = 0, acc_warn = 0, acc_dang = 0;
         int acc_stop = 0, acc_s3 = 0, acc_s4 = 0;
         int rej_dang = 0, rej_stop = 0;
         double acc_pnl = 0.0, rej_pnl = 0.0;
         for(int i = 0; i < g_risklab_count; i++)
         {
            if(g_risklab_records[i].signal != side) continue;
            // score محاسبه شده با این مدل
            int sc = 0;
            if((mask & 1) != 0) sc += g_risklab_records[i].block_direction;
            if((mask & 2) != 0) sc += g_risklab_records[i].block_strength;
            if((mask & 4) != 0) sc += g_risklab_records[i].block_signal_quality;
            if((mask & 8) != 0) sc += g_risklab_records[i].block_location;
            // قبول: score >= thr (سیگنال خوب)
            // رد: score < thr (سیگنال بد — اینها باید DANGER بیشتری داشته باشند)
            bool accepted = (sc >= thr);
            if(accepted)
            {
               acc++;
               if(g_risklab_records[i].group3 == "SAFE")    acc_safe++;
               if(g_risklab_records[i].group3 == "WARNING") acc_warn++;
               if(g_risklab_records[i].group3 == "DANGER")  acc_dang++;
               if(g_risklab_records[i].stop_flag)            acc_stop++;
               if(g_risklab_records[i].hit_step3_plus)       acc_s3++;
               if(g_risklab_records[i].hit_step4_plus)       acc_s4++;
               acc_pnl += g_risklab_records[i].pnl;
            }
            else
            {
               rej++;
               if(g_risklab_records[i].group3 == "DANGER") rej_dang++;
               if(g_risklab_records[i].stop_flag)           rej_stop++;
               rej_pnl += g_risklab_records[i].pnl;
            }
         }
         if(acc == 0) continue;
         double acc_danger_pct = acc_dang * 100.0 / acc;
         double danger_reduction = base_danger_pct - acc_danger_pct;
         out += model_names[m] + ",";
         out += "sc>=" + IntegerToString(thr) + ",";
         out += IntegerToString(acc) + ",";
         out += IntegerToString(rej) + ",";
         out += DoubleToString(acc * 100.0 / base_n, 1) + ",";
         out += DoubleToString(acc_safe * 100.0 / acc, 1) + ",";
         out += DoubleToString(acc_warn * 100.0 / acc, 1) + ",";
         out += DoubleToString(acc_danger_pct, 1) + ",";
         out += DoubleToString(acc_stop * 100.0 / acc, 1) + ",";
         out += DoubleToString(acc_s3 * 100.0 / acc, 1) + ",";
         out += DoubleToString(acc_s4 * 100.0 / acc, 1) + ",";
         out += (rej > 0 ? DoubleToString(rej_dang * 100.0 / rej, 1) : "0.0") + ",";
         out += (rej > 0 ? DoubleToString(rej_stop * 100.0 / rej, 1) : "0.0") + ",";
         out += DoubleToString(acc_pnl / acc, 2) + ",";
         out += (rej > 0 ? DoubleToString(rej_pnl / rej, 2) : "0.00") + ",";
         out += DoubleToString(danger_reduction, 1) + "\r\n";
      }
   }
   return out;
}
string RL_BuildStepBreakdownTable(string side)
{
   int    cnt_dev[6];
   int    stop_dev[6];
   int    s3_dev[6];
   int    s4_dev[6];
   double pnl_dev[6];
   double avg_dir_dev[6];
   double avg_tot_dev[6];
   int    cnt_oos[6];
   int    stop_oos[6];
   int    s3_oos[6];
   int    s4_oos[6];
   double pnl_oos[6];
   double avg_dir_oos[6];
   double avg_tot_oos[6];
   for(int x = 0; x < 6; x++)
   {
      cnt_dev[x]     = 0; stop_dev[x]    = 0;
      s3_dev[x]      = 0; s4_dev[x]      = 0;
      pnl_dev[x]     = 0.0; avg_dir_dev[x] = 0.0;
      avg_tot_dev[x] = 0.0;
      cnt_oos[x]     = 0; stop_oos[x]    = 0;
      s3_oos[x]      = 0; s4_oos[x]      = 0;
      pnl_oos[x]     = 0.0; avg_dir_oos[x] = 0.0;
      avg_tot_oos[x] = 0.0;
   }
   for(int i = 0; i < g_risklab_count; i++)
   {
      if(g_risklab_records[i].signal != side) continue;
      int s = g_risklab_records[i].max_step_reached;
      if(s < 1) s = 1;
      if(s > 5) s = 5;
      bool is_oos = g_risklab_records[i].is_oos;
      if(!is_oos)
      {
         cnt_dev[s]++;
         if(g_risklab_records[i].stop_flag)      stop_dev[s]++;
         if(g_risklab_records[i].hit_step3_plus) s3_dev[s]++;
         if(g_risklab_records[i].hit_step4_plus) s4_dev[s]++;
         pnl_dev[s]     += g_risklab_records[i].pnl;
         avg_dir_dev[s] += g_risklab_records[i].block_direction;
         avg_tot_dev[s] += g_risklab_records[i].total_score;
      }
      else
      {
         cnt_oos[s]++;
         if(g_risklab_records[i].stop_flag)      stop_oos[s]++;
         if(g_risklab_records[i].hit_step3_plus) s3_oos[s]++;
         if(g_risklab_records[i].hit_step4_plus) s4_oos[s]++;
         pnl_oos[s]     += g_risklab_records[i].pnl;
         avg_dir_oos[s] += g_risklab_records[i].block_direction;
         avg_tot_oos[s] += g_risklab_records[i].total_score;
      }
   }
   string out = "Step Breakdown — " + side + "\r\n";
   out += "Step,";
   out += "DEV_Count,DEV_Stop%,DEV_HitS3%,DEV_HitS4%,DEV_AvgPnL,DEV_AvgDir,DEV_AvgTotal,";
   out += "OOS_Count,OOS_Stop%,OOS_HitS3%,OOS_HitS4%,OOS_AvgPnL,OOS_AvgDir,OOS_AvgTotal,";
   out += "Stop_Stability(OOS-DEV)\r\n";
   for(int s = 1; s <= 5; s++)
   {
      if(cnt_dev[s] == 0 && cnt_oos[s] == 0) continue;
      out += IntegerToString(s) + ",";
      if(cnt_dev[s] > 0)
      {
         out += IntegerToString(cnt_dev[s]) + ",";
         out += DoubleToString(stop_dev[s] * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s3_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(s4_dev[s]   * 100.0 / cnt_dev[s], 1) + ",";
         out += DoubleToString(pnl_dev[s]  / cnt_dev[s], 2) + ",";
         out += DoubleToString(avg_dir_dev[s] / cnt_dev[s], 2) + ",";
         out += DoubleToString(avg_tot_dev[s] / cnt_dev[s], 2) + ",";
      }
      else
         out += "0,-,-,-,-,-,-,";
      if(cnt_oos[s] > 0)
      {
         out += IntegerToString(cnt_oos[s]) + ",";
         out += DoubleToString(stop_oos[s] * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s3_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(s4_oos[s]   * 100.0 / cnt_oos[s], 1) + ",";
         out += DoubleToString(pnl_oos[s]  / cnt_oos[s], 2) + ",";
         out += DoubleToString(avg_dir_oos[s] / cnt_oos[s], 2) + ",";
         out += DoubleToString(avg_tot_oos[s] / cnt_oos[s], 2) + ",";
      }
      else
         out += "0,-,-,-,-,-,-,";
      if(cnt_dev[s] > 0 && cnt_oos[s] > 0)
      {
         double diff = (stop_oos[s] * 100.0 / cnt_oos[s]) -
                       (stop_dev[s] * 100.0 / cnt_dev[s]);
         out += DoubleToString(diff, 1);
      }
      else
         out += "-";
      out += "\r\n";
   }
   return out;
}
string RL_BuildSummaryContent()
{
   string out = "";
   out += "=== SECTION 1: Overall Distribution (3 Targets) ===\r\n";
   out += "Target1=HitStep3Plus, Target2=HitStep4Plus, Target3=FinalStop\r\n\r\n";
   out += RL_BuildDistributionTable("ALL",  false, false) + "\r\n";
   out += RL_BuildDistributionTable("BUY",  true,  false) + "\r\n";
   out += RL_BuildDistributionTable("SELL", false, false) + "\r\n";
   out += "=== SECTION 1b: DEV Distribution ===\r\n";
   out += RL_BuildDistributionTable("BUY_DEV",  true,  true, false) + "\r\n";
   out += RL_BuildDistributionTable("SELL_DEV", false, true, false) + "\r\n";
   out += "=== SECTION 1c: OOS Distribution ===\r\n";
   out += RL_BuildDistributionTable("BUY_OOS",  true,  true, true) + "\r\n";
   out += RL_BuildDistributionTable("SELL_OOS", false, true, true) + "\r\n";
   out += "=== SECTION 2: TotalScore Distribution (DEV vs OOS) ===\r\n";
   out += "Note: Check DANGER_Stability column — if large positive, score overfits DEV\r\n\r\n";
   out += RL_BuildScoreDistTable("BUY")  + "\r\n";
   out += RL_BuildScoreDistTable("SELL") + "\r\n";
   out += "=== SECTION 3: Per-Block Distribution ===\r\n";
   string blocks[4] = {"Direction","Strength","SignalQuality","Location"};
   for(int b = 0; b < 4; b++)
   {
      out += RL_BuildBlockDistTable("BUY",  b, blocks[b]) + "\r\n";
      out += RL_BuildBlockDistTable("SELL", b, blocks[b]) + "\r\n";
   }
   out += "=== SECTION 4: Ablation Analysis (Real — with Threshold) ===\r\n";
   out += "Logic: Accept trades with sc>=threshold; measure DANGER reduction\r\n";
   out += "Good model: Accepted_DANGER% < Baseline_DANGER% AND Coverage still reasonable\r\n\r\n";
   out += RL_BuildAblationTable("BUY")  + "\r\n";
   out += RL_BuildAblationTable("SELL") + "\r\n";
   out += "=== SECTION 5: Step-level Breakdown ===\r\n";
   out += RL_BuildStepBreakdownTable("BUY")  + "\r\n";
   out += RL_BuildStepBreakdownTable("SELL") + "\r\n";
   return out;
}
string RL_BuildSignalRegistryPeekSection()
{
   string out = "";
   out += "\r\n=== SECTION 6: SIGNALREGISTRY QUICK PEEK ===\r\n";
   out += "SnapshotCount=" + IntegerToString(g_snapshot_count) + "\r\n";
   out += "SignalRegistryDataRows=" + IntegerToString(g_snapshot_count) + "\r\n";
   if(g_snapshot_count <= 0)
   {
      out += "SignalRegistryPeek=NOT_AVAILABLE\r\n";
      return out;
   }
   int peek_n = 3;
   if(g_snapshot_count < peek_n)
      peek_n = g_snapshot_count;
   out += "\r\n[FIRST RECORDS]\r\n";
   for(int i = 0; i < peek_n; i++)
   {
      string side = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      string final_event = NormalizeEventString(g_snapshots[i].close_event);
      string exit_reason = OS_GetFinalToken(g_snapshots[i].close_event);
      out += "EventID=" + IntegerToString(g_snapshots[i].setup_id)
          + " | EventTime=" + TimeToString(g_snapshots[i].entry_time, TIME_DATE | TIME_MINUTES)
          + " | Side=" + side
          + " | FinalEvent=" + final_event
          + " | ExitReason=" + exit_reason
          + " | MaxStep=" + IntegerToString(g_snapshots[i].actual_max_step)
          + " | FinalProfit=" + DoubleToString(g_snapshots[i].final_profit, 2)
          + "\r\n";
   }
   out += "\r\n[LAST RECORDS]\r\n";
   for(int i = g_snapshot_count - peek_n; i < g_snapshot_count; i++)
   {
      if(i < 0) continue;
      string side = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      string final_event = NormalizeEventString(g_snapshots[i].close_event);
      string exit_reason = OS_GetFinalToken(g_snapshots[i].close_event);
      out += "EventID=" + IntegerToString(g_snapshots[i].setup_id)
          + " | EventTime=" + TimeToString(g_snapshots[i].entry_time, TIME_DATE | TIME_MINUTES)
          + " | Side=" + side
          + " | FinalEvent=" + final_event
          + " | ExitReason=" + exit_reason
          + " | MaxStep=" + IntegerToString(g_snapshots[i].actual_max_step)
          + " | FinalProfit=" + DoubleToString(g_snapshots[i].final_profit, 2)
          + "\r\n";
   }
   return out;
}
int DHC_GetExpectedFeatureCount()
{
   int meta           = 15;
   int identification = 3;
   int qc             = 13;
   int time_ctx       = 13;
   int price_action   = 24;
   // Base 25
   // + Cycle 3A = 9
   // + Cycle 3B = 4
   // + Cycle 3C = 7
   // + Cycle 3D = 5
   // + Cycle 3E = 6
   // Total = 56
   int pivot_div      = 56;
   int order_block    = 2;
   int mtf_consensus  = 14;
   int regime         = 8;
   int distance       = 13;
   int labels         = 21;
   int step_timing    = 10;
   int fixed_total =
      meta + identification + qc + time_ctx + price_action +
      pivot_div + order_block + mtf_consensus + regime +
      distance + labels + step_timing;
   // Per-TF block unchanged
   int per_tf = 41;
   return fixed_total + (TF_COUNT * per_tf);
}
#define S2B_PROTOCOL_VERSION        "S2B_PROTOCOL_C2R_v1"
#define S2B_EVALUATOR_VERSION       "S2B_EVAL_ALIGN_v2"
#define S2B_VALID_ROW_POLICY_POOL8  "COMMON_POOL_8_STATIC|TIME_WINDOW|MAXSTEP_1_5|TARGET_STEP4"
#define S2B_VALID_ROW_POLICY_STOP8  "COMMON_POOL_STOP_8|TIME_WINDOW|VALID_STOP_LABEL"
#define S2B_MAX_FOLDS               8
#define S2B_COMPACT_POOL_SIZE       8
// ---------------------------------------------------------------
// Hash helpers (local to Stage2B, independent from Stage2D)
// ---------------------------------------------------------------
// ================================================================
// Stage 2B - StopFlag Phase B (DEV-only OOF Threshold / Trade-off)
// All gate constants are FROZEN before any Phase B result is observed.
// ================================================================
#define S2B_STOP_D2024_FREEZE_VERSION        "S2B_STOP_D2024_FREEZE_MANIFEST_v1"
#define S2B_STOP_D2024_HOLDOUT_VERSION       "S2B_STOP_D2024_HOLDOUT_ONCE_v1"
#define S2B_STOP_D2024_LOCKED_NORM_HASH      "3692507727"
#define S2B_STOP_D2024_LOCKED_MODEL_HASH     "2302396259"
#define S2B_STOP_D2024_LOCKED_CUTOFF          0.277847225155
#define S2B_STOP_D2024_TIE_POLICY            "REJECT_IF_SCORE_GREATER_THAN_OR_EQUAL_TO_CUTOFF"
#define S2B_STOP_D2024_TRAINING_ROWS          5328
#define S2B_STOP_D2024_NUMERIC_VERSION       "S2B_STOP_D2024_NUMERIC_CUTOFF_v1"
#define S2B_STOP_D2024_LOCKED_REJECTION      10.0
#define S2B_STOP_D2024_NUMERIC_PERCENTILE    0.90
#define S2B_STOP_D2024_PHASEB_VERSION        "S2B_STOP_D2024_PHASEB_3F_v1"
#define S2B_STOP_D2024_LOCK_VERSION          "S2B_STOP_D2024_CANDIDATE_LOCK_v1"
#define S2B_STOP_D2024_EXPECT_DATASET_HASH   "1898185219"
#define S2B_STOP_D2024_EXPECT_FEATURE_HASH   "3861065281"
#define S2B_STOP_D2024_EXPECT_ROWMASK_HASH   "4128086467"
#define S2B_STOP_D2024_EXPECT_FOLD_HASH      "1810087639"
#define S2B_STOP_D2024_EXPECT_PROTOCOL_HASH  "984612805"
#define S2B_STOP_D2024_EXPECT_CONTEXT_HASH   "2376562022"
#define S2B_STOP_D2024_EXPECT_ELIGIBLE       5328
#define S2B_STOP_D2024_EXPECT_STOP_POS       63
