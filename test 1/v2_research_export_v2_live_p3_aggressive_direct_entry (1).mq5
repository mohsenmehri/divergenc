// Feature Rank Stability per fold
struct SFeatureRankStability
{
   string feature_name;
   double weight_abs[3];   // |weight| per fold
   int    rank[3];         // rank per fold (1=strongest)
   double mean_weight_abs;
   double std_weight_abs;
   double mean_rank;
   double std_rank;
   string stability;       // VERY_STABLE / STABLE / MODERATE / UNSTABLE
};
struct SCompactResult
{
   int    n_feat;
   int    feat_idx[8];
   string feat_names;
   // ---- Audit identity ----
   string protocol_hash;
   string fold_hash;
   string row_mask_hash;
   string dataset_hash;
   string evaluator_version;
   string valid_row_policy;
   string feature_hash;
   // Stop-specific metadata / context hashes
   string evaluation_context_hash;
   string target_hash;
   string pool_hash;
   string row_policy_hash;
   int    valid_primary_folds;
   int    eligible_count;
   int    excluded_count;
   int    snapshot_count;
   int    risklab_count;
   datetime first_entry_time;
   datetime last_entry_time;
   // ---- Fold details ----
   int      fold_count;
   string   fold_name[S2B_MAX_FOLDS];
   int      fold_is_primary[S2B_MAX_FOLDS];
   int      fold_valid[S2B_MAX_FOLDS];
   datetime fold_train_from[S2B_MAX_FOLDS];
   datetime fold_train_to[S2B_MAX_FOLDS];
   datetime fold_val_from[S2B_MAX_FOLDS];
   datetime fold_val_to[S2B_MAX_FOLDS];
   int      fold_train_n[S2B_MAX_FOLDS];
   int      fold_train_pos[S2B_MAX_FOLDS];
   int      fold_train_neg[S2B_MAX_FOLDS];
   int      fold_val_n[S2B_MAX_FOLDS];
   int      fold_val_pos[S2B_MAX_FOLDS];
   int      fold_val_neg[S2B_MAX_FOLDS];
   double   fold_train_auc[S2B_MAX_FOLDS];
   double   fold_auc[S2B_MAX_FOLDS];
   double   fold_auc_gap[S2B_MAX_FOLDS];
   double   fold_prauc[S2B_MAX_FOLDS];
   double   fold_pr_lift[S2B_MAX_FOLDS];
   double   fold_precision[S2B_MAX_FOLDS];
   double   fold_mcc[S2B_MAX_FOLDS];
   double   fold_recall[S2B_MAX_FOLDS];
   double   fold_f2[S2B_MAX_FOLDS];
   double   fold_val_prevalence[S2B_MAX_FOLDS];
   int      fold_low_positive_sample[S2B_MAX_FOLDS];
   double   fold_train_mean_score_pos[S2B_MAX_FOLDS];
   double   fold_train_mean_score_neg[S2B_MAX_FOLDS];
   double   fold_val_mean_score_pos[S2B_MAX_FOLDS];
   double   fold_val_mean_score_neg[S2B_MAX_FOLDS];
   string   fold_coeff_signs[S2B_MAX_FOLDS];
   // ---- Internal WF metrics ----
   double wf_mean_auc;
   double wf_worst_auc;
   double wf_std_auc;
   double wf_mean_prauc;
   double wf_mean_pr_lift;
   double wf_mean_mcc;
   double wf_mean_recall;
   double wf_mean_f2;
   // ---- Development fit only (for reporting) ----
   double dev_auc;
   // ---- OOS reserved (NOT used in search stage) ----
   double oos_auc;
   double oos_gap;
   // ---- Stability / diagnostics ----
   int    sign_flip_count;
   int    large_drift_count;
   // ---- Absolute gate ----
   bool   abs_gate_pass;
   string abs_gate_reason;
   // ---- Relative gate / selection state ----
   bool   relative_gate_pass;
   string reject_reason;
   // ---- Selection lock info ----
   bool   selected_by_policy;
   int    selection_rank;
   string selection_reason;
   double composite_score;
   bool   accepted;
   void Reset()
   {
      n_feat = 0;
      feat_names = "";
      for(int i = 0; i < 8; i++)
         feat_idx[i] = -1;
      protocol_hash = "";
      fold_hash = "";
      row_mask_hash = "";
      dataset_hash = "";
      evaluator_version = "";
      valid_row_policy = "";
      feature_hash = "";
      evaluation_context_hash = "";
      target_hash = "";
      pool_hash = "";
      row_policy_hash = "";
      valid_primary_folds = 0;
      eligible_count = 0;
      excluded_count = 0;
      snapshot_count = 0;
      risklab_count = 0;
      first_entry_time = 0;
      last_entry_time  = 0;
      fold_count = 0;
      for(int i = 0; i < S2B_MAX_FOLDS; i++)
      {
         fold_name[i] = "";
         fold_is_primary[i] = 0;
         fold_valid[i] = 0;
         fold_train_from[i] = 0;
         fold_train_to[i]   = 0;
         fold_val_from[i]   = 0;
         fold_val_to[i]     = 0;
         fold_train_n[i]   = 0;
         fold_train_pos[i] = 0;
         fold_train_neg[i] = 0;
         fold_val_n[i]   = 0;
         fold_val_pos[i] = 0;
         fold_val_neg[i] = 0;
         fold_train_auc[i] = 0.0;
         fold_auc[i]    = 0.0;
         fold_auc_gap[i]= 0.0;
         fold_prauc[i]  = 0.0;
         fold_pr_lift[i]= 0.0;
         fold_precision[i] = 0.0;
         fold_mcc[i]    = 0.0;
         fold_recall[i] = 0.0;
         fold_f2[i]     = 0.0;
         fold_val_prevalence[i] = 0.0;
         fold_low_positive_sample[i] = 0;
         fold_train_mean_score_pos[i] = 0.0;
         fold_train_mean_score_neg[i] = 0.0;
         fold_val_mean_score_pos[i]   = 0.0;
         fold_val_mean_score_neg[i]   = 0.0;
         fold_coeff_signs[i] = "";
      }
      wf_mean_auc = 0.0;
      wf_worst_auc = 0.0;
      wf_std_auc = 0.0;
      wf_mean_prauc = 0.0;
      wf_mean_pr_lift = 0.0;
      wf_mean_mcc = 0.0;
      wf_mean_recall = 0.0;
      wf_mean_f2 = 0.0;
      dev_auc = 0.0;
      oos_auc = 0.0;
      oos_gap = 0.0;
      sign_flip_count = 0;
      large_drift_count = 0;
      abs_gate_pass = false;
      abs_gate_reason = "";
      relative_gate_pass = false;
      reject_reason = "";
      selected_by_policy = false;
      selection_rank = 0;
      selection_reason = "";
      composite_score = -999999.0;
      accepted = false;
   }
};
bool S2B_PassAbsoluteGate(SCompactResult &res, string &fail_reason)
{
   fail_reason = "";
   if(res.wf_mean_auc < 0.55)
   {
      fail_reason = "WF_MEAN_AUC_BELOW_0.55";
      return false;
   }
   if(res.wf_worst_auc < 0.52)
   {
      fail_reason = "WF_WORST_AUC_BELOW_0.52";
      return false;
   }
   if(res.wf_std_auc > 0.04)
   {
      fail_reason = "WF_STD_AUC_ABOVE_0.04";
      return false;
   }
   if(res.valid_primary_folds < 2)
   {
      fail_reason = "VALID_PRIMARY_FOLDS_BELOW_2";
      return false;
   }
   if(res.sign_flip_count > 0)
   {
      fail_reason = "SIGN_FLIPS_DETECTED";
      return false;
   }
   if(res.large_drift_count > 1)
   {
      fail_reason = "LARGE_DRIFT_ABOVE_1";
      return false;
   }
   return true;
}
