};
//-------------------- Globals --------------------
SShadowSignal   g_shadow_signals[];
int             g_shadow_count = 0;
int             g_next_shadow_id = 1;
int             g_next_research_protocol_id = 1;
int             g_active_shadow_indices[];
int             g_active_shadow_count = 0;
int             g_reject_filter_counts[RJF_COUNT];
int             g_total_shadow_accepted = 0;
int             g_total_shadow_rejected = 0;
SRejectComboStat g_reject_combo_stats[MAX_REJECT_COMBOS];
int              g_reject_combo_count = 0;
//-------------------- Helpers --------------------
string RejectFilterName(int id)
{
   switch(id)
   {
      case RJF_TREND_PULLBACK:         return "TREND_PULLBACK";
      case RJF_ATR_REGIME_M1:          return "ATR_REGIME_M1";
      case RJF_SELL_ATR_M1:            return "SELL_ATR_M1";
      case RJF_BUY_H4_ADX:             return "BUY_H4_ADX";
      case RJF_BUY_SIGNAL_BODY:        return "BUY_SIGNAL_BODY";
      case RJF_BUY_M5_EMA_COMP:        return "BUY_M5_EMA_COMP";
      case RJF_SELL_M15_ATR_REGIME:    return "SELL_M15_ATR_REGIME";
      case RJF_SELL_H4_CCI:            return "SELL_H4_CCI";
      case RJF_SELL_M30_ATR_STEP4:     return "SELL_M30_ATR_STEP4";
      case RJF_SELL_M1_EMA200_STEP4:   return "SELL_M1_EMA200_STEP4";
      case RJF_SELL_M1_ADX_STEP4:      return "SELL_M1_ADX_STEP4";
      case RJF_SELL_H4_ADX_STEP4:      return "SELL_H4_ADX_STEP4";
      case RJF_PREDICTION_SKIP:        return "PREDICTION_SKIP";
      case RJF_STABILITY_GATE:         return "STABILITY_GATE";
      case RJF_SELL_SIGNAL_CLV:        return "SELL_SIGNAL_CLV";
      case RJF_SELL_ATR_REGIME_H1:     return "SELL_ATR_REGIME_H1";
   }
   return "UNKNOWN";
}
void RegisterRejectCombo(string mask)
{
   if(mask == "") return;
   for(int i = 0; i < g_reject_combo_count; i++)
   {
      if(g_reject_combo_stats[i].mask == mask)
      {
         g_reject_combo_stats[i].count++;
         return;
      }
   }
   if(g_reject_combo_count < MAX_REJECT_COMBOS)
   {
      g_reject_combo_stats[g_reject_combo_count].mask = mask;
      g_reject_combo_stats[g_reject_combo_count].count = 1;
      g_reject_combo_count++;
   }
}
void RegisterRejectStats(SRejectInfo &ri, bool accepted)
{
   if(accepted)
   {
      g_total_shadow_accepted++;
      return;
   }
   g_total_shadow_rejected++;
   for(int i = 0; i < RJF_COUNT; i++)
   {
      if(ri.flags[i])
         g_reject_filter_counts[i]++;
   }
   string mask = ri.BuildMaskString();
   RegisterRejectCombo(mask);
}
void ShadowUpdateEventPath(SShadowSignal &ss, string new_event)
{
   new_event = NormalizeEventString(new_event);
   string path = NormalizeEventString(ss.event_path);
   string last_event = "";
   int path_len = StringLen(path);
   if(path_len > 0)
   {
      int last_arrow = -1;
      for(int i = path_len - 2; i >= 0; i--)
      {
         if(StringSubstr(path, i, 2) == "->")
         {
            last_arrow = i;
            break;
         }
      }
      if(last_arrow >= 0) last_event = StringSubstr(path, last_arrow + 2);
      else                last_event = path;
      last_event = NormalizeEventString(last_event);
   }
   if(last_event == new_event) return;
   if(path == "") path = new_event;
   else           path += "->" + new_event;
   ss.event_path = NormalizeEventString(path);
}
double ShadowCalcFloatingProfit(SShadowSignal &ss, double current_price)
{
   if(ss.current_step < 1) return 0.0;
   if(ss.tick_size <= 0.0 || ss.tick_value == 0.0) return 0.0;
   double profit = 0.0;
   for(int s = 1; s <= ss.current_step && s <= 5; s++)
   {
      double lot = ss.base_lot * s;
      if(lot <= 0.0) continue;
      double diff = ss.is_bullish
         ? (current_price - ss.entry_levels[s - 1])
         : (ss.entry_levels[s - 1] - current_price);
      profit += (diff / ss.tick_size) * ss.tick_value * lot;
   }
   return profit;
}
void ShadowUpdateLifecycle(SShadowSignal &ss, double current_price)
{
   ss.lifecycle.ticks_alive++;
   datetime cur_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(cur_bar != 0 && cur_bar != ss.last_bar_time)
   {
      ss.last_bar_time = cur_bar;
      ss.lifecycle.bars_alive++;
   }
   double cur_profit = ShadowCalcFloatingProfit(ss, current_price);
   if(cur_profit > ss.lifecycle.max_profit_money)
      ss.lifecycle.max_profit_money = cur_profit;
   if(cur_profit < ss.lifecycle.max_loss_money)
      ss.lifecycle.max_loss_money = cur_profit;
   double fav_pts = ss.is_bullish
      ? ((current_price - ss.entry_levels[0]) / _Point)
      : ((ss.entry_levels[0] - current_price) / _Point);
   double adv_pts = ss.is_bullish
      ? ((ss.entry_levels[0] - current_price) / _Point)
      : ((current_price - ss.entry_levels[0]) / _Point);
   if(fav_pts > ss.lifecycle.mfe_points)
      ss.lifecycle.mfe_points = fav_pts;
   if(adv_pts > ss.lifecycle.mae_points)
      ss.lifecycle.mae_points = adv_pts;
}
void ShadowUpdateTPTouches(SShadowSignal &ss, double hi0, double lo0)
{
   bool is_bull = ss.is_bullish;
   bool tp1_touch = is_bull ? (hi0 >= ss.target_levels[0]) : (lo0 <= ss.target_levels[0]);
   bool tp2_touch = is_bull ? (hi0 >= ss.target_levels[1]) : (lo0 <= ss.target_levels[1]);
   bool tp3_touch = is_bull ? (hi0 >= ss.target_levels[2]) : (lo0 <= ss.target_levels[2]);
   bool tp4_touch = is_bull ? (hi0 >= ss.target_levels[3]) : (lo0 <= ss.target_levels[3]);
   bool tp5_touch = is_bull ? (hi0 >= ss.target_levels[4]) : (lo0 <= ss.target_levels[4]);
   if(tp1_touch && !ss.hit_tp1) { ss.hit_tp1 = true; ShadowUpdateEventPath(ss, "TP1"); }
   if(tp2_touch && !ss.hit_tp2) { ss.hit_tp2 = true; ShadowUpdateEventPath(ss, "TP2"); }
   if(tp3_touch && !ss.hit_tp3) { ss.hit_tp3 = true; ShadowUpdateEventPath(ss, "TP3"); }
   if(tp4_touch && !ss.hit_tp4) { ss.hit_tp4 = true; ShadowUpdateEventPath(ss, "TP4"); }
   if(tp5_touch && !ss.hit_tp5) { ss.hit_tp5 = true; ShadowUpdateEventPath(ss, "TP5"); }
   if(ss.ema200_at_signal > 0.0)
   {
      bool ema_touch = is_bull ? (hi0 >= ss.ema200_at_signal) : (lo0 <= ss.ema200_at_signal);
      if(ema_touch && !ss.hit_ema200)
      {
         ss.hit_ema200 = true;
         ShadowUpdateEventPath(ss, "EMA");
      }
   }
}
void ShadowGetCurrentTarget(SShadowSignal &ss, double &target, string &target_name)
{
   target = 0.0;
   target_name = "";
   if(ss.use_ema200_target && ss.max_step_reached <= 2 && ss.ema200_at_signal > 0.0)
   {
      target = ss.ema200_at_signal;
      target_name = "EMA";
      return;
   }
   int idx = ss.current_step - 1;
   if(idx < 0) idx = 0;
   if(idx > 4) idx = 4;
   target = ss.target_levels[idx];
   target_name = "TP" + IntegerToString(idx + 1);
}
void UpdateShadowSignalsOnBar()
{
   if(g_shadow_count <= 0) return;
   double hi1 = iHigh(_Symbol, PERIOD_CURRENT, 1);
   double lo1 = iLow(_Symbol, PERIOD_CURRENT, 1);
   double cl1 = iClose(_Symbol, PERIOD_CURRENT, 1);
   datetime bar1_time = iTime(_Symbol, PERIOD_CURRENT, 1);
   if(hi1 <= 0 || lo1 <= 0 || cl1 <= 0 || bar1_time == 0)
      return;
   for(int ai=g_active_shadow_count-1;ai>=0;ai--)
   {
      int i=g_active_shadow_indices[ai];
      if(i<0 || i>=g_shadow_count || !g_shadow_signals[i].is_active) continue;
      // --- lifecycle by closed bar only ---
      g_shadow_signals[i].lifecycle.bars_alive++;
      g_shadow_signals[i].lifecycle.ticks_alive++;
      double cur_profit = ShadowCalcFloatingProfit(g_shadow_signals[i], cl1);
      if(cur_profit > g_shadow_signals[i].lifecycle.max_profit_money)
         g_shadow_signals[i].lifecycle.max_profit_money = cur_profit;
      if(cur_profit < g_shadow_signals[i].lifecycle.max_loss_money)
         g_shadow_signals[i].lifecycle.max_loss_money = cur_profit;
      double fav_pts = g_shadow_signals[i].is_bullish
         ? ((hi1 - g_shadow_signals[i].entry_levels[0]) / _Point)
         : ((g_shadow_signals[i].entry_levels[0] - lo1) / _Point);
      double adv_pts = g_shadow_signals[i].is_bullish
         ? ((g_shadow_signals[i].entry_levels[0] - lo1) / _Point)
         : ((hi1 - g_shadow_signals[i].entry_levels[0]) / _Point);
      if(fav_pts > g_shadow_signals[i].lifecycle.mfe_points)
         g_shadow_signals[i].lifecycle.mfe_points = fav_pts;
      if(adv_pts > g_shadow_signals[i].lifecycle.mae_points)
         g_shadow_signals[i].lifecycle.mae_points = adv_pts;
      // --- dollar stop check using adverse extreme ---
      double worst_profit = ShadowCalcFloatingProfit(
         g_shadow_signals[i],
         g_shadow_signals[i].is_bullish ? lo1 : hi1
      );
      if(inp_max_loss_dollars > 0 && worst_profit <= -inp_max_loss_dollars)
      {
         FinalizeShadowSignal(i, "SL_DOLLAR", g_shadow_signals[i].is_bullish ? lo1 : hi1);
         continue;
      }
      // --- martingale progression by bar extremes ---
      bool progressed = true;
      while(progressed)
      {
         progressed = false;
         int next = g_shadow_signals[i].current_step + 1;
         if(next <= 5)
         {
            double next_entry = g_shadow_signals[i].entry_levels[next - 1];
            bool should_enter = g_shadow_signals[i].is_bullish
               ? (lo1 <= next_entry)
               : (hi1 >= next_entry);
            if(should_enter)
            {
               g_shadow_signals[i].current_step = next;
               if(next > g_shadow_signals[i].max_step_reached)
                  g_shadow_signals[i].max_step_reached = next;
               if(next >= 3)
                  g_shadow_signals[i].use_ema200_target = false;
               progressed = true;
            }
         }
      }
      // --- TP / EMA touches ---
      ShadowUpdateTPTouches(g_shadow_signals[i], hi1, lo1);
      // --- final target hit on this closed bar ---
      double target = 0.0;
      string target_name = "";
      ShadowGetCurrentTarget(g_shadow_signals[i], target, target_name);
      if(target > 0.0)
      {
         bool hit_target = g_shadow_signals[i].is_bullish
            ? (hi1 >= target)
            : (lo1 <= target);
         if(hit_target)
         {
            FinalizeShadowSignal(i, target_name, target);
            continue;
         }
      }
      g_shadow_signals[i].last_bar_time = bar1_time;
   }
}
void ShadowActiveAdd(int idx)
{
   if(ArrayResize(g_active_shadow_indices,g_active_shadow_count+1)<0) return;
   g_active_shadow_indices[g_active_shadow_count++]=idx;
}
void ShadowActiveRemove(int idx)
{
   for(int i=0;i<g_active_shadow_count;i++)
   {
      if(g_active_shadow_indices[i]!=idx) continue;
      for(int j=i;j<g_active_shadow_count-1;j++)
         g_active_shadow_indices[j]=g_active_shadow_indices[j+1];
      g_active_shadow_count--;
      ArrayResize(g_active_shadow_indices,g_active_shadow_count);
      return;
   }
}
int CreateShadowSignal(datetime sig_time,
                       bool is_bull,
                       double &ent[],
                       double &be[],
                       double &tp[],
                       double atr_dist,
                       double ema200_signal,
                       bool use_ema_target,
                       bool accepted,
                       SRejectInfo &reject_info,
                       SEntrySnapshot &snap,
                       bool register_reject_stats = true)
{
   if(g_shadow_count >= ArraySize(g_shadow_signals))
   {
      int new_size = ArraySize(g_shadow_signals) + 500;
      if(ArrayResize(g_shadow_signals, new_size) < 0)
      {
         Print("ERROR: Cannot resize shadow array");
         return -1;
      }
   }
   int idx = g_shadow_count;
   g_shadow_signals[idx].Reset();
   g_shadow_signals[idx].shadow_id = g_next_shadow_id++;
   g_shadow_signals[idx].candidate_setup_id = g_next_setup_id;
   g_shadow_signals[idx].signal_time = sig_time;
   g_shadow_signals[idx].is_bullish = is_bull;
   g_shadow_signals[idx].was_accepted = accepted;
   g_shadow_signals[idx].is_active = true;
   g_shadow_signals[idx].last_bar_time = iTime(_Symbol, PERIOD_CURRENT, 0);
   g_shadow_signals[idx].base_lot = GetLotSize();
   g_shadow_signals[idx].tick_value = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   g_shadow_signals[idx].tick_size  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   g_shadow_signals[idx].atr_distance = atr_dist;
   g_shadow_signals[idx].ema200_at_signal = ema200_signal;
   g_shadow_signals[idx].use_ema200_target = use_ema_target;
   ArrayCopy(g_shadow_signals[idx].entry_levels, ent);
   ArrayCopy(g_shadow_signals[idx].break_even_levels, be);
   ArrayCopy(g_shadow_signals[idx].target_levels, tp);
   g_shadow_signals[idx].current_step = 1;
   g_shadow_signals[idx].max_step_reached = 1;
   g_shadow_signals[idx].snapshot = snap;
   g_shadow_signals[idx].reject_info = reject_info;
   if(register_reject_stats)
      RegisterRejectStats(reject_info, accepted);
   ShadowActiveAdd(idx);
   g_shadow_count++;
   return idx;
}
void FinalizeShadowSignal(int idx, string reason, double exit_price)
{
   if(idx < 0 || idx >= g_shadow_count) return;
   if(!g_shadow_signals[idx].is_active) return;
   g_shadow_signals[idx].close_time = TimeCurrent();
   g_shadow_signals[idx].final_profit_est = ShadowCalcFloatingProfit(g_shadow_signals[idx], exit_price);
   g_shadow_signals[idx].final_event = AppendFinalReasonToPath(g_shadow_signals[idx].event_path, reason);
   g_shadow_signals[idx].is_active = false;
   ShadowActiveRemove(idx);
}
void UpdateShadowSignalsOnTick()
{
   if(g_shadow_count <= 0) return;
   if(!IsMarketOpen()) return;
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return;
   double hi0 = iHigh(_Symbol, PERIOD_CURRENT, 0);
   double lo0 = iLow(_Symbol, PERIOD_CURRENT, 0);
   for(int ai=g_active_shadow_count-1;ai>=0;ai--)
   {
      int i=g_active_shadow_indices[ai];
      if(i<0 || i>=g_shadow_count || !g_shadow_signals[i].is_active) continue;
      double px = g_shadow_signals[i].is_bullish ? tk.bid : tk.ask;
      ShadowUpdateLifecycle(g_shadow_signals[i], px);
      ShadowUpdateTPTouches(g_shadow_signals[i], hi0, lo0);
      double cur_profit = ShadowCalcFloatingProfit(g_shadow_signals[i], px);
      // Money stop
      if(inp_max_loss_dollars > 0 && cur_profit <= -inp_max_loss_dollars)
      {
         FinalizeShadowSignal(i, "SL_DOLLAR", px);
         continue;
      }
      // Current target
      double target = 0.0;
      string target_name = "";
      ShadowGetCurrentTarget(g_shadow_signals[i], target, target_name);
      if(target > 0.0)
      {
         bool hit_target = g_shadow_signals[i].is_bullish
            ? (tk.bid >= target || hi0 >= target)
            : (tk.ask <= target || lo0 <= target);
         if(hit_target)
         {
            FinalizeShadowSignal(i, target_name, target);
            continue;
         }
      }
      // Next martingale step entry (same spirit as real setup: one step per tick max)
      int next = g_shadow_signals[i].current_step + 1;
      if(next <= 5)
      {
         double next_entry = g_shadow_signals[i].entry_levels[next - 1];
         bool should_enter = g_shadow_signals[i].is_bullish
            ? (tk.bid <= next_entry)
            : (tk.ask >= next_entry);
         if(should_enter)
         {
            g_shadow_signals[i].current_step = next;
            if(next > g_shadow_signals[i].max_step_reached)
               g_shadow_signals[i].max_step_reached = next;
            if(next >= 3)
               g_shadow_signals[i].use_ema200_target = false;
         }
      }
   }
}
void FinalizeAllActiveShadows()
{
   MqlTick tk;
   if(!SymbolInfoTick(_Symbol, tk)) return;
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(!g_shadow_signals[i].is_active) continue;
      double px = g_shadow_signals[i].is_bullish ? tk.bid : tk.ask;
      FinalizeShadowSignal(i, "SHADOW_OPEN", px);
   }
}
void ExportRejectStatsCSV()
{
   string fn = "RejectStats_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE) return;
   FileWriteString(h, "Metric,Value\r\n");
   FileWriteString(h, "TotalShadowSignals," + IntegerToString(g_shadow_count) + "\r\n");
   FileWriteString(h, "AcceptedSignals," + IntegerToString(g_total_shadow_accepted) + "\r\n");
   FileWriteString(h, "RejectedSignals," + IntegerToString(g_total_shadow_rejected) + "\r\n");
   FileWriteString(h, "\r\n");
   FileWriteString(h, "RejectFilter,RejectedCount\r\n");
   for(int i = 0; i < RJF_COUNT; i++)
   {
      FileWriteString(h,
         EscapeCSV(RejectFilterName(i)) + "," +
         IntegerToString(g_reject_filter_counts[i]) + "\r\n");
   }
   FileWriteString(h, "\r\nRejectCombo,Count\r\n");
   for(int i = 0; i < g_reject_combo_count; i++)
   {
      FileWriteString(h,
         EscapeCSV(g_reject_combo_stats[i].mask) + "," +
         IntegerToString(g_reject_combo_stats[i].count) + "\r\n");
   }
   FileFlush(h);
   FileClose(h);
}
void ExportShadowSignalsCSV()
{
   string fn = "ShadowSignals_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE) return;
   string hdr = "ShadowID,CandidateSetupID,SignalTime,Side,Accepted,RejectMask,RejectVerbose,";
   hdr += "FinalEvent,FinalProfitEst,MaxStepReached,CurrentStep,";
   hdr += "HitTP1,HitTP2,HitTP3,HitTP4,HitTP5,HitEMA200,";
   hdr += "BarsAlive,TicksAlive,MaxProfitMoney,MaxLossMoney,MFE_Points,MAE_Points,";
   hdr += "EntryHour,EntryDay,Stability,HTFConflict,DIAgree,EMABullCount,";
   hdr += "Pivot1Dist,Pivot2Dist,";
   hdr += "RSI_M1,ADX_M1,CCI_M1,ATR_M1,";
   hdr += "RSI_H1,ADX_H1,CCI_H1,ATR_H1,";
   hdr += "RSI_H4,ADX_H4,CCI_H4,ATR_H4,";
   hdr += "ATRReg_M1,ADXSlope_M1,EMAComp_M1,SignalCLV,SignalBody,OBAge,OBWidthATR\r\n";
   FileWriteString(h, hdr);
   for(int i = 0; i < g_shadow_count; i++)
   {
      string row = "";
      row += IntegerToString(g_shadow_signals[i].shadow_id) + ",";
      row += IntegerToString(g_shadow_signals[i].candidate_setup_id) + ",";
      row += TimeToString(g_shadow_signals[i].signal_time, TIME_DATE|TIME_MINUTES) + ",";
      row += (g_shadow_signals[i].is_bullish ? "BUY" : "SELL") + ",";
      row += (g_shadow_signals[i].was_accepted ? "1" : "0") + ",";
      row += EscapeCSV(g_shadow_signals[i].reject_info.BuildMaskString()) + ",";
      row += EscapeCSV(g_shadow_signals[i].reject_info.BuildVerboseString()) + ",";
      row += EscapeCSV(g_shadow_signals[i].final_event) + ",";
      row += DoubleToString(g_shadow_signals[i].final_profit_est, 2) + ",";
      row += IntegerToString(g_shadow_signals[i].max_step_reached) + ",";
      row += IntegerToString(g_shadow_signals[i].current_step) + ",";
      row += (g_shadow_signals[i].hit_tp1 ? "1" : "0") + ",";
      row += (g_shadow_signals[i].hit_tp2 ? "1" : "0") + ",";
      row += (g_shadow_signals[i].hit_tp3 ? "1" : "0") + ",";
      row += (g_shadow_signals[i].hit_tp4 ? "1" : "0") + ",";
      row += (g_shadow_signals[i].hit_tp5 ? "1" : "0") + ",";
      row += (g_shadow_signals[i].hit_ema200 ? "1" : "0") + ",";
      row += IntegerToString(g_shadow_signals[i].lifecycle.bars_alive) + ",";
      row += IntegerToString(g_shadow_signals[i].lifecycle.ticks_alive) + ",";
      row += DoubleToString(g_shadow_signals[i].lifecycle.max_profit_money, 2) + ",";
      row += DoubleToString(g_shadow_signals[i].lifecycle.max_loss_money, 2) + ",";
      row += DoubleToString(g_shadow_signals[i].lifecycle.mfe_points, 1) + ",";
      row += DoubleToString(g_shadow_signals[i].lifecycle.mae_points, 1) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.entry_hour) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.entry_day_of_week) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.stability_score) + ",";
      row += (g_shadow_signals[i].snapshot.has_htf_conflict ? "1" : "0") + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.di_agreement_count) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.ema_bullish_count) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.pivot1_dist) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.pivot2_dist) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.rsi[TF_IDX_MAIN], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.adx[TF_IDX_MAIN], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.cci[TF_IDX_MAIN], 1) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.atr[TF_IDX_MAIN], _Digits) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.rsi[TF_IDX_H1], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.adx[TF_IDX_H1], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.cci[TF_IDX_H1], 1) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.atr[TF_IDX_H1], _Digits) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.rsi[TF_IDX_H4], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.adx[TF_IDX_H4], 2) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.cci[TF_IDX_H4], 1) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.atr[TF_IDX_H4], _Digits) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.atr_regime[TF_IDX_MAIN], 3) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.adx_slope[TF_IDX_MAIN], 3) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.ema_compression[TF_IDX_MAIN], 3) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.signal_clv, 3) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.signal_body_ratio, 3) + ",";
      row += IntegerToString(g_shadow_signals[i].snapshot.ob_age_bars) + ",";
      row += DoubleToString(g_shadow_signals[i].snapshot.ob_width_atr, 3) + "\r\n";
      FileWriteString(h, row);
   }
   FileFlush(h);
   FileClose(h);
}
//====================================================================
// v9.23 Passive Market Edge Collector
// Price contract: BID_OHLC. The T0 bar is excluded; only T0+1..T0+12
// complete bars are observed. No function in this block sends trade requests.
//====================================================================
void ME_Initialize()
{
   g_market_edge_count=0;
   g_next_market_signal_id=1;
   ArrayFree(g_market_edge_records);
   if(inp_enable_market_edge_collector)
      ArrayResize(g_market_edge_records,500);
}
string ME_Time(datetime value)
{
   if(value<=0) return "";
   return TimeToString(value,TIME_DATE|TIME_MINUTES|TIME_SECONDS);
}
string ME_BuildSignalKey(bool is_bull,datetime p1,datetime p2,datetime p3,
                         datetime t0_bar_time)
{
   return _Symbol+"|"+EnumToString((ENUM_TIMEFRAMES)_Period)+"|"+
      (is_bull ? "BUY" : "SELL")+"|"+
      StringFormat("%I64d|%I64d|%I64d|%I64d|",(long)p1,(long)p2,(long)p3,
                   (long)t0_bar_time)+inp_market_edge_version;
}
int ME_FindByKey(const string key)
{
   for(int i=g_market_edge_count-1;i>=0;i--)
      if(g_market_edge_records[i].market_signal_key==key) return i;
   return -1;
}
string MEV2_TFLabel(const int tf)
{
   if(tf==TF_IDX_MAIN) return "M1";
   if(tf==TF_IDX_M5) return "M5";
   if(tf==TF_IDX_M15) return "M15";
   if(tf==TF_IDX_M30) return "M30";
   if(tf==TF_IDX_H1) return "H1";
   if(tf==TF_IDX_H4) return "H4";
   return "TF"+IntegerToString(tf);
}
bool MEV2_NumberValid(const double value)
{
   return (MathIsValidNumber(value) && value!=EMPTY_VALUE);
}
void MEV2_AddMissing(string &mask,const string token)
{
   if(mask!="") mask+="|";
   mask+=token;
}
string MEV2_EMAOrder(const double e20,const double e50,const double e100,const double e200)
{
   if(e20>e50 && e50>e100 && e100>e200) return "E20>E50>E100>E200";
   if(e20<e50 && e50<e100 && e100<e200) return "E200>E100>E50>E20";
   return "MIXED";
}
string MEV2_TrendRegime(const double e20,const double e50,const double e100,const double e200)
{
   if(e20>e50 && e50>e100 && e100>e200) return "UP";
   if(e20<e50 && e50<e100 && e100<e200) return "DOWN";
   return "RANGE";
}
string MEV2_Session(const int hour)
{
   if(hour>=23 || hour<7) return "ASIA";
   if(hour<12) return "LONDON";
   if(hour<17) return "OVERLAP";
   if(hour<22) return "NEWYORK";
   return "LATE";
}
void MEV2_Capture(SMarketEdgeRecord &rec,
                   const double p1_price,const double p2_price,const double p3_price,
                   const double p1_rsi,const double p2_rsi,const double p3_rsi,
                   const int gap12_bars,const int gap23_bars,const int span_bars)
{
   SMarketEdgeFeatureSnapshotV2 f;
   f.Reset();
   f.captured_at=rec.detector_evaluation_time;
   MqlDateTime td;
   if(TimeToStruct(rec.t0_bar_time,td))
   {
      f.t0_year=td.year;
      f.t0_month=td.mon;
      f.t0_day_of_week=td.day_of_week;
      f.t0_hour=td.hour;
      f.t0_minute=td.min;
      f.t0_session=MEV2_Session(td.hour);
   }
   else
   {
      f.capture_error="INVALID_T0_TIME";
      MEV2_AddMissing(f.missing_mask,"TIME");
   }
   f.gap12_bars=gap12_bars;
   f.gap23_bars=gap23_bars;
   f.pivot_span_bars=span_bars;
   f.gap12_minutes=(int)((rec.p2_time-rec.p1_time)/60);
   f.gap23_minutes=(int)((rec.p3_time-rec.p2_time)/60);
   f.pivot_span_minutes=(int)((rec.p3_time-rec.p1_time)/60);
   f.gap_ratio_valid=(gap12_bars>0);
   if(f.gap_ratio_valid)
      f.gap_ratio_23_to_12=(double)gap23_bars/(double)gap12_bars;
   f.p1_price=p1_price;
   f.p2_price=p2_price;
   f.p3_price=p3_price;
   f.pivot_price_valid=(p1_price>0.0 && p2_price>0.0 && p3_price>0.0 &&
                        MEV2_NumberValid(p1_price) && MEV2_NumberValid(p2_price) &&
                        MEV2_NumberValid(p3_price));
   if(f.pivot_price_valid)
   {
      f.price_leg_12=p2_price-p1_price;
      f.price_leg_23=p3_price-p2_price;
      f.price_span=MathAbs(p3_price-p1_price);
      f.p3_to_t0_close=rec.t0_close-p3_price;
      if(rec.t0_atr_valid)
      {
         f.price_span_atr=f.price_span/rec.t0_atr;
         f.p3_to_t0_close_atr=f.p3_to_t0_close/rec.t0_atr;
      }
      f.price_leg_ratio_valid=(MathAbs(f.price_leg_12)>0.0000000001);
      if(f.price_leg_ratio_valid)
         f.price_leg_ratio_23_to_12=f.price_leg_23/f.price_leg_12;
   }
   else MEV2_AddMissing(f.missing_mask,"PIVOT_PRICE");
   f.p1_rsi=p1_rsi;
   f.p2_rsi=p2_rsi;
   f.p3_rsi=p3_rsi;
   f.pivot_rsi_valid=(p1_rsi>=0.0 && p1_rsi<=100.0 &&
                      p2_rsi>=0.0 && p2_rsi<=100.0 &&
                      p3_rsi>=0.0 && p3_rsi<=100.0 &&
                      MEV2_NumberValid(p1_rsi) && MEV2_NumberValid(p2_rsi) &&
                      MEV2_NumberValid(p3_rsi));
   if(f.pivot_rsi_valid)
   {
      f.rsi_leg_12=p2_rsi-p1_rsi;
      f.rsi_leg_23=p3_rsi-p2_rsi;
      f.rsi_span=MathAbs(p3_rsi-p1_rsi);
      f.rsi_leg_ratio_valid=(MathAbs(f.rsi_leg_12)>0.0000000001);
      if(f.rsi_leg_ratio_valid)
         f.rsi_leg_ratio_23_to_12=f.rsi_leg_23/f.rsi_leg_12;
      if(gap12_bars>0) f.rsi_slope_12_per_bar=f.rsi_leg_12/(double)gap12_bars;
      if(gap23_bars>0) f.rsi_slope_23_per_bar=f.rsi_leg_23/(double)gap23_bars;
   }
   else MEV2_AddMissing(f.missing_mask,"PIVOT_RSI");
   const int shift=1;
   f.t0_open=iOpen(_Symbol,PERIOD_CURRENT,shift);
   f.t0_high=iHigh(_Symbol,PERIOD_CURRENT,shift);
   f.t0_low=iLow(_Symbol,PERIOD_CURRENT,shift);
   f.t0_close=iClose(_Symbol,PERIOD_CURRENT,shift);
   f.t0_range=f.t0_high-f.t0_low;
   f.t0_body=MathAbs(f.t0_close-f.t0_open);
   f.t0_candle_valid=(f.t0_open>0.0 && f.t0_high>=f.t0_low && f.t0_low>0.0 &&
                      f.t0_close>0.0 && f.t0_range>0.0 &&
                      MEV2_NumberValid(f.t0_open) && MEV2_NumberValid(f.t0_high) &&
                      MEV2_NumberValid(f.t0_low) && MEV2_NumberValid(f.t0_close));
   if(f.t0_candle_valid)
   {
      f.t0_body_to_range=f.t0_body/f.t0_range;
      f.t0_clv=(f.t0_close-f.t0_low)/f.t0_range;
      f.t0_upper_wick_to_range=(f.t0_high-MathMax(f.t0_open,f.t0_close))/f.t0_range;
      f.t0_lower_wick_to_range=(MathMin(f.t0_open,f.t0_close)-f.t0_low)/f.t0_range;
   }
   else MEV2_AddMissing(f.missing_mask,"T0_CANDLE");
   f.t0_atr=rec.t0_atr;
   if(rec.t0_atr_valid && rec.t0_close>0.0)
      f.t0_atr_percent_close=100.0*rec.t0_atr/rec.t0_close;
   MqlTick tick;
   f.t0_tick_available=SymbolInfoTick(_Symbol,tick);
   if(f.t0_tick_available && tick.ask>0.0 && tick.bid>0.0 && tick.ask>=tick.bid)
   {
      f.t0_spread_price=tick.ask-tick.bid;
      f.t0_spread_points=(int)MathRound(f.t0_spread_price/_Point);
      if(rec.t0_atr_valid) f.t0_spread_to_atr=f.t0_spread_price/rec.t0_atr;
   }
   else
   {
      f.t0_tick_available=false;
      MEV2_AddMissing(f.missing_mask,"T0_TICK");
   }
   f.volatility_spread_valid=(rec.t0_atr_valid && f.t0_tick_available);
   for(int tf=0;tf<TF_COUNT;tf++)
   {
      f.feature_shift[tf]=1;
      f.feature_bar_time[tf]=iTime(_Symbol,g_tf[tf].timeframe,1);
      double close_tf=iClose(_Symbol,g_tf[tf].timeframe,1);
      double varsi=g_tf[tf].GetBufferValue(g_tf[tf].buffer_varsi,1);
      double raw_rsi=g_tf[tf].GetBufferValue(g_tf[tf].buffer_rsi,1);
      f.rsi[tf]=(varsi>0.0 && varsi<=100.0) ? varsi : raw_rsi;
      f.atr[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_atr,1);
      f.adx[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_adx,1);
      f.di_plus[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_plus_di,1);
      f.di_minus[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_minus_di,1);
      f.cci[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_cci,1);
      f.ema20[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_ema_20,1);
      f.ema50[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_ema_50,1);
      f.ema100[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_ema_100,1);
      f.ema200[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_ema_200,1);
      f.macd_main[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_macd_main,1);
      f.macd_signal[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_macd_signal,1);
      f.macd_histogram[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_macd_hist,1);
      f.stochastic_k[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_stoch_k,1);
      f.stochastic_d[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_stoch_d,1);
      f.wpr[tf]=g_tf[tf].GetBufferValue(g_tf[tf].buffer_wpr,1);
      double bb_upper=g_tf[tf].GetBufferValue(g_tf[tf].buffer_bb_upper,1);
      double bb_lower=g_tf[tf].GetBufferValue(g_tf[tf].buffer_bb_lower,1);
      bool time_ok=(f.feature_bar_time[tf]>0 && f.feature_bar_time[tf]<f.captured_at);
      bool optional_ok=(ArraySize(g_tf[tf].buffer_macd_main)>1 &&
                        ArraySize(g_tf[tf].buffer_macd_signal)>1 &&
                        ArraySize(g_tf[tf].buffer_macd_hist)>1 &&
                        ArraySize(g_tf[tf].buffer_stoch_k)>1 &&
                        ArraySize(g_tf[tf].buffer_stoch_d)>1 &&
                        ArraySize(g_tf[tf].buffer_wpr)>1 &&
                        ArraySize(g_tf[tf].buffer_bb_upper)>1 &&
                        ArraySize(g_tf[tf].buffer_bb_lower)>1 &&
                        MEV2_NumberValid(f.macd_main[tf]) &&
                        MEV2_NumberValid(f.macd_signal[tf]) &&
                        MEV2_NumberValid(f.macd_histogram[tf]) &&
                        MEV2_NumberValid(f.stochastic_k[tf]) &&
                        MEV2_NumberValid(f.stochastic_d[tf]) &&
                        MEV2_NumberValid(f.wpr[tf]) &&
                        MEV2_NumberValid(bb_upper) && MEV2_NumberValid(bb_lower) &&
                        f.stochastic_k[tf]>=0.0 && f.stochastic_k[tf]<=100.0 &&
                        f.stochastic_d[tf]>=0.0 && f.stochastic_d[tf]<=100.0 &&
                        f.wpr[tf]>=-100.0 && f.wpr[tf]<=0.0 && bb_upper>bb_lower);
      bool core_ok=(time_ok && optional_ok && close_tf>0.0 && f.atr[tf]>0.0 &&
                    f.rsi[tf]>=0.0 && f.rsi[tf]<=100.0 && f.adx[tf]>=0.0 &&
                    f.ema20[tf]>0.0 && f.ema50[tf]>0.0 &&
                    f.ema100[tf]>0.0 && f.ema200[tf]>0.0 &&
                    MEV2_NumberValid(f.atr[tf]) && MEV2_NumberValid(f.rsi[tf]) &&
                    MEV2_NumberValid(f.adx[tf]) && MEV2_NumberValid(f.cci[tf]) &&
                    MEV2_NumberValid(f.di_plus[tf]) && MEV2_NumberValid(f.di_minus[tf]) &&
                    MEV2_NumberValid(f.ema20[tf]) && MEV2_NumberValid(f.ema50[tf]) &&
                    MEV2_NumberValid(f.ema100[tf]) && MEV2_NumberValid(f.ema200[tf]));
      f.feature_valid[tf]=core_ok;
      if(!core_ok)
      {
         MEV2_AddMissing(f.missing_mask,MEV2_TFLabel(tf));
         continue;
      }
      f.mtf_valid_count++;
      f.atr_percent_close[tf]=100.0*f.atr[tf]/close_tf;
      f.di_gap[tf]=MathAbs(f.di_plus[tf]-f.di_minus[tf]);
      f.close_to_ema20_atr[tf]=(close_tf-f.ema20[tf])/f.atr[tf];
      f.close_to_ema50_atr[tf]=(close_tf-f.ema50[tf])/f.atr[tf];
      f.close_to_ema200_atr[tf]=(close_tf-f.ema200[tf])/f.atr[tf];
      f.ema_gap_20_50_atr[tf]=(f.ema20[tf]-f.ema50[tf])/f.atr[tf];
      f.ema_gap_50_200_atr[tf]=(f.ema50[tf]-f.ema200[tf])/f.atr[tf];
      f.ema_order[tf]=MEV2_EMAOrder(f.ema20[tf],f.ema50[tf],f.ema100[tf],f.ema200[tf]);
      f.trend_regime[tf]=MEV2_TrendRegime(f.ema20[tf],f.ema50[tf],f.ema100[tf],f.ema200[tf]);
      if(f.trend_regime[tf]=="UP") f.mtf_bull_trend_count++;
      else if(f.trend_regime[tf]=="DOWN") f.mtf_bear_trend_count++;
      bool ema_align=rec.is_bullish ? (close_tf>f.ema200[tf]) : (close_tf<f.ema200[tf]);
      bool di_align=rec.is_bullish ? (f.di_plus[tf]>f.di_minus[tf]) : (f.di_minus[tf]>f.di_plus[tf]);
      if(ema_align) f.mtf_ema200_align++;
      if(di_align) f.mtf_di_align++;
      if((rec.is_bullish && f.trend_regime[tf]=="DOWN") ||
         (!rec.is_bullish && f.trend_regime[tf]=="UP")) f.mtf_conflict_count++;
      if(bb_upper>bb_lower)
      {
         double width=bb_upper-bb_lower;
         f.bb_width_atr[tf]=width/f.atr[tf];
         f.bb_position[tf]=(close_tf-bb_lower)/width;
         f.bb_squeeze[tf]=(width<2.0*f.atr[tf]);
         if(f.bb_squeeze[tf]) f.mtf_squeeze_count++;
      }
   }
   f.mtf_aggregate_valid=(f.mtf_valid_count>0);
   f.complete=(f.capture_error=="" && f.pivot_price_valid && f.pivot_rsi_valid &&
               f.t0_candle_valid && f.volatility_spread_valid &&
               f.mtf_valid_count==TF_COUNT);
   rec.feature_v2=f;
}
void ME_RegisterConfirmedDivergence(bool is_bull,datetime p1_time,
                                    datetime p2_time,datetime p3_time,
                                    datetime p3_confirmation_time,
                                    double p1_price,double p2_price,double p3_price,
                                    double p1_rsi,double p2_rsi,double p3_rsi,
                                    int gap12_bars,int gap23_bars,int span_bars)
{
   if(!inp_enable_market_edge_collector) return;
   const int t0_shift=1;
   datetime t0_time=iTime(_Symbol,PERIOD_CURRENT,t0_shift);
   if(t0_time<=0) return;
   string key=ME_BuildSignalKey(is_bull,p1_time,p2_time,p3_time,t0_time);
   if(ME_FindByKey(key)>=0) return;
   if(g_market_edge_count>=ArraySize(g_market_edge_records))
   {
      int old_size=ArraySize(g_market_edge_records);
      int new_size=old_size+500;
      if(ArrayResize(g_market_edge_records,new_size)<0)
      {
         Print("MARKET_EDGE|ERROR|REGISTRY_RESIZE_FAILED");
         return;
      }
      for(int z=old_size;z<new_size;z++) g_market_edge_records[z].Reset();
   }
   SMarketEdgeRecord rec; rec.Reset();
   rec.market_signal_id=g_next_market_signal_id++;
   rec.market_signal_key=key;
   rec.is_bullish=is_bull;
   rec.p1_time=p1_time;
   rec.p2_time=p2_time;
   rec.p3_time=p3_time;
   rec.confirmation_time=p3_confirmation_time;
   rec.signal_time=t0_time;
   rec.detector_evaluation_time=TimeCurrent();
   rec.t0_bar_time=t0_time;
   rec.t0_close=iClose(_Symbol,PERIOD_CURRENT,t0_shift);
   rec.t0_atr=g_tf[TF_IDX_MAIN].GetBufferValue(g_tf[TF_IDX_MAIN].buffer_atr,t0_shift);
   rec.t0_atr_period=inp_atr_period;
   rec.t0_atr_shift=t0_shift;
   rec.t0_atr_valid=(rec.t0_atr>0.0 && rec.t0_atr!=EMPTY_VALUE &&
                     MathIsValidNumber(rec.t0_atr));
   rec.last_future_bar_time=t0_time;
   rec.active=true;
   if(rec.t0_close<=0.0 || !MathIsValidNumber(rec.t0_close))
   {
      rec.active=false;
      rec.censor_reason="INVALID_T0_CLOSE";
   }
   // Immutable predictor snapshot: capture exactly once at T0 registration.
   MEV2_Capture(rec,p1_price,p2_price,p3_price,p1_rsi,p2_rsi,p3_rsi,
                gap12_bars,gap23_bars,span_bars);
   g_market_edge_records[g_market_edge_count++]=rec;
}
void ME_UpdateOnNewClosedBar()
{
   if(!inp_enable_market_edge_collector || g_market_edge_count<=0) return;
   datetime bar_time=iTime(_Symbol,PERIOD_CURRENT,1);
   double bar_high=iHigh(_Symbol,PERIOD_CURRENT,1);
   double bar_low=iLow(_Symbol,PERIOD_CURRENT,1);
   if(bar_time<=0 || bar_high<=0.0 || bar_low<=0.0 ||
      !MathIsValidNumber(bar_high) || !MathIsValidNumber(bar_low)) return;
   for(int i=0;i<g_market_edge_count;i++)
   {
      if(!g_market_edge_records[i].active) continue;
      SMarketEdgeRecord rec=g_market_edge_records[i];
      // Registration occurs after the T0 bar closes. This strict test excludes
      // T0 and makes the first subsequently closed bar exactly T0+1.
      if(bar_time<=rec.t0_bar_time || bar_time==rec.last_future_bar_time) continue;
      int gap_seconds=(int)(bar_time-rec.last_future_bar_time);
      if(gap_seconds>rec.max_interbar_gap_seconds)
         rec.max_interbar_gap_seconds=gap_seconds;
      // V1 deliberately does not classify weekend/holiday/session closures as
      // missing data. MaxInterBarGapSeconds is exported for offline audit.
      rec.data_gap_detected=false;
      rec.last_future_bar_time=bar_time;
      rec.completed_future_bars++;
      if(bar_high>rec.running_max_high) rec.running_max_high=bar_high;
      if(bar_low<rec.running_min_low) rec.running_min_low=bar_low;
      if(rec.t0_atr_valid && !rec.target_touched)
      {
         double target=rec.is_bullish
            ? rec.t0_close+V923_TARGET_ATR_MULTIPLE*rec.t0_atr
            : rec.t0_close-V923_TARGET_ATR_MULTIPLE*rec.t0_atr;
         bool touched=rec.is_bullish ? (bar_high>=target) : (bar_low<=target);
         if(touched)
         {
            rec.target_touched=true;
            rec.bars_to_target=rec.completed_future_bars;
         }
      }
      if(rec.completed_future_bars>=V923_MARKET_HORIZON_BARS)
      {
         if(rec.is_bullish)
         {
            rec.future_mfe=MathMax(0.0,rec.running_max_high-rec.t0_close);
            rec.future_mae=MathMax(0.0,rec.t0_close-rec.running_min_low);
         }
         else
         {
            rec.future_mfe=MathMax(0.0,rec.t0_close-rec.running_min_low);
            rec.future_mae=MathMax(0.0,rec.running_max_high-rec.t0_close);
         }
         if(rec.t0_atr_valid)
         {
            rec.future_mfe_atr=rec.future_mfe/rec.t0_atr;
            rec.future_mae_atr=rec.future_mae/rec.t0_atr;
         }
         rec.horizon_complete=true;
         rec.active=false;
      }
      g_market_edge_records[i]=rec;
   }
}
void ME_MarkExecuted(int setup_id,bool is_bull,datetime p3_time)
{
   if(!inp_enable_market_edge_collector || setup_id<=0) return;
   for(int i=g_market_edge_count-1;i>=0;i--)
   {
      if(g_market_edge_records[i].is_bullish!=is_bull) continue;
      if(p3_time>0 && g_market_edge_records[i].p3_time!=p3_time) continue;
      if(g_market_edge_records[i].was_executed) continue;
      g_market_edge_records[i].was_executed=true;
      g_market_edge_records[i].executed_setup_id=setup_id;
      return;
   }
}
void ME_CensorActiveOnDeinit()
{
   if(!inp_enable_market_edge_collector) return;
   for(int i=0;i<g_market_edge_count;i++)
   {
      if(!g_market_edge_records[i].active) continue;
      g_market_edge_records[i].active=false;
      g_market_edge_records[i].horizon_complete=false;
      g_market_edge_records[i].censor_reason="EA_DEINIT";
   }
}
void ME_ResolveStrategyOutcome(const SMarketEdgeRecord &rec,string &join_status,
                               bool &strategy_complete,bool &step4_plus,
                               bool &stop_flag,double &final_pnl)
{
   join_status=rec.was_executed ? "MISSING_POSITION_OPEN_DATASET" :
                                  "NOT_APPLICABLE_NON_EXECUTED";
   strategy_complete=false;
   step4_plus=false;
   stop_flag=false;
   final_pnl=0.0;
   if(!rec.was_executed || rec.executed_setup_id<=0) return;
   bool found=false;
   bool have_reference=false;
   string ref_event="";
   int ref_step=0;
   double ref_pnl=0.0;
   bool ref_stop=false;
   bool consistent=true;
   for(int i=0;i<g_position_open_count;i++)
   {
      if(g_position_open_records[i].setup_id!=rec.executed_setup_id) continue;
      found=true;
      SPositionOpenRecord pos=g_position_open_records[i];
      if(!have_reference)
      {
         have_reference=true;
         ref_event=pos.setup_final_event;
         ref_step=pos.setup_max_step;
         ref_pnl=pos.setup_final_profit;
         ref_stop=pos.setup_final_stop;
      }
      else if(ref_event!=pos.setup_final_event || ref_step!=pos.setup_max_step ||
              MathAbs(ref_pnl-pos.setup_final_profit)>0.0000001 ||
              ref_stop!=pos.setup_final_stop)
         consistent=false;
      if(!pos.finalized) consistent=false;
   }
   if(!found) return;
   if(!consistent)
   {
      join_status="MATCHED_INCONSISTENT_OR_OPEN";
      return;
   }
   string final_token=OS_GetFinalToken(ref_event);
   if(ref_event=="" || final_token=="EOT_OPEN" || final_token=="EA_STOPPED_OPEN")
   {
      join_status="MATCHED_OPEN_CENSORED";
      return;
   }
   join_status="MATCHED_FINALIZED";
   strategy_complete=true;
   step4_plus=(ref_step>=4);
   stop_flag=ref_stop;
   final_pnl=ref_pnl;
}
string MEV2_Num(const double value,const int digits)
{
   if(!MEV2_NumberValid(value)) return "";
   return DoubleToString(value,digits);
}
string MEV2_FamilyNum(const bool valid,const double value,const int digits)
{
   if(!valid || !MEV2_NumberValid(value)) return "";
   return DoubleToString(value,digits);
}
string MEV2_Header()
{
   string h="FeatureSnapshotVersion,FeatureSnapshotCapturedAt,FeatureSnapshotComplete,FeatureMissingMask,FeatureCaptureError,";
   h+="T0Year,T0Month,T0DayOfWeek,T0Hour,T0Minute,T0Session,";
   h+="Gap12Bars,Gap23Bars,PivotSpanBars,Gap12Minutes,Gap23Minutes,PivotSpanMinutes,GapRatio23To12,GapRatioValid,";
   h+="P1Price,P2Price,P3Price,PriceLeg12,PriceLeg23,PriceLegRatio23To12,PriceSpan,PriceSpanATR,P3ToT0Close,P3ToT0CloseATR,PivotPriceGeometryValid,PriceLegRatioValid,";
   h+="P1RSI,P2RSI,P3RSI,RSILeg12,RSILeg23,RSILegRatio23To12,RSISpan,RSISlope12PerBar,RSISlope23PerBar,PivotRSIGeometryValid,RSILegRatioValid,";
   h+="T0Open,T0High,T0Low,T0CloseFeature,T0Range,T0Body,T0BodyToRange,T0CloseLocationValue,T0UpperWickToRange,T0LowerWickToRange,T0CandleValid,";
   h+="T0ATRFeature,T0ATRPercentOfClose,T0SpreadPoints,T0SpreadPrice,T0SpreadToATR,T0TickAvailable,T0VolatilitySpreadValid,";
   for(int tf=0;tf<TF_COUNT;tf++)
   {
      string n=MEV2_TFLabel(tf);
      h+="FeatureBarTime_"+n+",FeatureShift_"+n+",FeatureValid_"+n+",";
      h+="RSI_"+n+",ATR_"+n+",ATRPercentOfClose_"+n+",ADX_"+n+",DIPlus_"+n+",DIMinus_"+n+",DIGap_"+n+",CCI_"+n+",";
      h+="EMA20_"+n+",EMA50_"+n+",EMA100_"+n+",EMA200_"+n+",";
      h+="CloseToEMA20ATR_"+n+",CloseToEMA50ATR_"+n+",CloseToEMA200ATR_"+n+",";
      h+="EMAGap20To50ATR_"+n+",EMAGap50To200ATR_"+n+",EMAOrder_"+n+",TrendRegime_"+n+",";
      h+="MACDMain_"+n+",MACDSignal_"+n+",MACDHistogram_"+n+",";
      h+="StochasticK_"+n+",StochasticD_"+n+",WPR_"+n+",BBWidthATR_"+n+",BBPosition_"+n+",BBSqueeze_"+n+",";
   }
   h+="MTFValidCount,MTFEMA200Align,MTFDIAlign,MTFSqueezeCount,MTFBullTrendCount,MTFBearTrendCount,MTFConflictCount,MTFAggregateValid";
   return h;
}
string MEV2_Row(SMarketEdgeRecord &rec)
{
   SMarketEdgeFeatureSnapshotV2 f=rec.feature_v2;
   string row=EscapeCSV(f.version)+","+ME_Time(f.captured_at)+","+
      (f.complete ? "1" : "0")+","+EscapeCSV(f.missing_mask)+","+EscapeCSV(f.capture_error)+","+
      IntegerToString(f.t0_year)+","+IntegerToString(f.t0_month)+","+
      IntegerToString(f.t0_day_of_week)+","+IntegerToString(f.t0_hour)+","+
      IntegerToString(f.t0_minute)+","+EscapeCSV(f.t0_session)+","+
      IntegerToString(f.gap12_bars)+","+IntegerToString(f.gap23_bars)+","+
      IntegerToString(f.pivot_span_bars)+","+IntegerToString(f.gap12_minutes)+","+
      IntegerToString(f.gap23_minutes)+","+IntegerToString(f.pivot_span_minutes)+","+
      (f.gap_ratio_valid ? MEV2_Num(f.gap_ratio_23_to_12,8) : "")+","+
      (f.gap_ratio_valid ? "1" : "0")+",";
   row+=MEV2_FamilyNum(f.pivot_price_valid,f.p1_price,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.p2_price,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.p3_price,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.price_leg_12,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.price_leg_23,_Digits)+","+
      (f.price_leg_ratio_valid ? MEV2_Num(f.price_leg_ratio_23_to_12,8) : "")+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.price_span,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid && rec.t0_atr_valid,f.price_span_atr,8)+","+
      MEV2_FamilyNum(f.pivot_price_valid,f.p3_to_t0_close,_Digits)+","+
      MEV2_FamilyNum(f.pivot_price_valid && rec.t0_atr_valid,f.p3_to_t0_close_atr,8)+","+
      (f.pivot_price_valid ? "1" : "0")+","+(f.price_leg_ratio_valid ? "1" : "0")+",";
   row+=MEV2_FamilyNum(f.pivot_rsi_valid,f.p1_rsi,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid,f.p2_rsi,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid,f.p3_rsi,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid,f.rsi_leg_12,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid,f.rsi_leg_23,8)+","+
      (f.rsi_leg_ratio_valid ? MEV2_Num(f.rsi_leg_ratio_23_to_12,8) : "")+","+
      MEV2_FamilyNum(f.pivot_rsi_valid,f.rsi_span,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid && f.gap12_bars>0,f.rsi_slope_12_per_bar,8)+","+
      MEV2_FamilyNum(f.pivot_rsi_valid && f.gap23_bars>0,f.rsi_slope_23_per_bar,8)+","+
      (f.pivot_rsi_valid ? "1" : "0")+","+(f.rsi_leg_ratio_valid ? "1" : "0")+",";
   row+=MEV2_FamilyNum(f.t0_candle_valid,f.t0_open,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_high,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_low,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_close,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_range,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_body,_Digits)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_body_to_range,8)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_clv,8)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_upper_wick_to_range,8)+","+
      MEV2_FamilyNum(f.t0_candle_valid,f.t0_lower_wick_to_range,8)+","+
      (f.t0_candle_valid ? "1" : "0")+",";
   row+=MEV2_FamilyNum(rec.t0_atr_valid,f.t0_atr,_Digits)+","+
      MEV2_FamilyNum(rec.t0_atr_valid && rec.t0_close>0.0,f.t0_atr_percent_close,8)+","+
      (f.t0_tick_available ? IntegerToString(f.t0_spread_points) : "")+","+
      MEV2_FamilyNum(f.t0_tick_available,f.t0_spread_price,_Digits)+","+
      MEV2_FamilyNum(f.volatility_spread_valid,f.t0_spread_to_atr,8)+","+
      (f.t0_tick_available ? "1" : "0")+","+(f.volatility_spread_valid ? "1" : "0")+",";
   for(int tf=0;tf<TF_COUNT;tf++)
   {
      bool ok=f.feature_valid[tf];
      row+=ME_Time(f.feature_bar_time[tf])+","+IntegerToString(f.feature_shift[tf])+","+(ok ? "1" : "0")+",";
      row+=MEV2_FamilyNum(ok,f.rsi[tf],8)+","+MEV2_FamilyNum(ok,f.atr[tf],_Digits)+","+
         MEV2_FamilyNum(ok,f.atr_percent_close[tf],8)+","+MEV2_FamilyNum(ok,f.adx[tf],8)+","+
         MEV2_FamilyNum(ok,f.di_plus[tf],8)+","+MEV2_FamilyNum(ok,f.di_minus[tf],8)+","+
         MEV2_FamilyNum(ok,f.di_gap[tf],8)+","+MEV2_FamilyNum(ok,f.cci[tf],8)+",";
      row+=MEV2_FamilyNum(ok,f.ema20[tf],_Digits)+","+MEV2_FamilyNum(ok,f.ema50[tf],_Digits)+","+
         MEV2_FamilyNum(ok,f.ema100[tf],_Digits)+","+MEV2_FamilyNum(ok,f.ema200[tf],_Digits)+","+
         MEV2_FamilyNum(ok,f.close_to_ema20_atr[tf],8)+","+
         MEV2_FamilyNum(ok,f.close_to_ema50_atr[tf],8)+","+
         MEV2_FamilyNum(ok,f.close_to_ema200_atr[tf],8)+","+
         MEV2_FamilyNum(ok,f.ema_gap_20_50_atr[tf],8)+","+
         MEV2_FamilyNum(ok,f.ema_gap_50_200_atr[tf],8)+","+
         (ok ? EscapeCSV(f.ema_order[tf]) : "")+","+(ok ? EscapeCSV(f.trend_regime[tf]) : "")+",";
      row+=MEV2_FamilyNum(ok,f.macd_main[tf],8)+","+MEV2_FamilyNum(ok,f.macd_signal[tf],8)+","+
         MEV2_FamilyNum(ok,f.macd_histogram[tf],8)+","+MEV2_FamilyNum(ok,f.stochastic_k[tf],8)+","+
         MEV2_FamilyNum(ok,f.stochastic_d[tf],8)+","+MEV2_FamilyNum(ok,f.wpr[tf],8)+","+
         MEV2_FamilyNum(ok,f.bb_width_atr[tf],8)+","+MEV2_FamilyNum(ok,f.bb_position[tf],8)+","+
         (ok ? (f.bb_squeeze[tf] ? "1" : "0") : "")+",";
   }
   row+=IntegerToString(f.mtf_valid_count)+","+IntegerToString(f.mtf_ema200_align)+","+
      IntegerToString(f.mtf_di_align)+","+IntegerToString(f.mtf_squeeze_count)+","+
      IntegerToString(f.mtf_bull_trend_count)+","+IntegerToString(f.mtf_bear_trend_count)+","+
      IntegerToString(f.mtf_conflict_count)+","+(f.mtf_aggregate_valid ? "1" : "0");
   return row;
}
void ME_ExportCSV()
{
   if(!inp_enable_market_edge_collector) return;
   string fn="MarketEdge_"+inp_market_edge_version+"_"+_Symbol+".csv";
   int h=SafeOpenCSV(fn); if(h==INVALID_HANDLE) return;
   string hdr="MarketSignalID,MarketSignalKey,Symbol,Timeframe,Direction,PriceSource,"
      "P1Time,P2Time,P3Time,SignalTime,ConfirmationTime,DetectorEvaluationTime,"
      "T0BarTime,T0Close,T0ATR,T0ATRPeriod,T0ATRTimeframe,T0ATRShift,T0ATRValid,"
      "HorizonBars,CompletedFutureBars,HorizonComplete,FutureMFE,FutureMAE,FutureMFE_ATR,FutureMAE_ATR,"
      "TargetVersion,TargetATRMultiple,TargetHit,BarsToTarget,DataGapDetected,MaxInterBarGapSeconds,CensorReason,"
      "ExecutionQCAvailableAtT0,ExecutionQCPassAtT0,EventualProfileStatus,EventualWasExecuted,EventualExecutedSetupID,"
      "WasExecuted,ExecutedSetupID,ActualOutcomeJoinStatus,StrategyOutcomeComplete,StrategyStep4Plus,StrategyStopFlag,StrategyFinalPnL,"
      "BaselineCommit,BaselineSHA256,ResearchProtocolVersion,SchemaVersion,"+MEV2_Header()+"\r\n";
   FileWriteString(h,hdr);
   for(int i=0;i<g_market_edge_count;i++)
   {
      SMarketEdgeRecord rec=g_market_edge_records[i];
      string join_status=""; bool strategy_complete=false,step4=false,stop=false;
      double pnl=0.0;
      ME_ResolveStrategyOutcome(rec,join_status,strategy_complete,step4,stop,pnl);
      bool market_label_available=(rec.horizon_complete && rec.t0_atr_valid);
      string future_mfe=rec.horizon_complete ? DoubleToString(rec.future_mfe,_Digits) : "";
      string future_mae=rec.horizon_complete ? DoubleToString(rec.future_mae,_Digits) : "";
      string future_mfe_atr=market_label_available ? DoubleToString(rec.future_mfe_atr,8) : "";
      string future_mae_atr=market_label_available ? DoubleToString(rec.future_mae_atr,8) : "";
      string target_hit=market_label_available ? (rec.target_touched ? "1" : "0") : "";
      string bars_to_target=(market_label_available && rec.target_touched)
         ? IntegerToString(rec.bars_to_target) : "";
      string strategy_step4=strategy_complete ? (step4 ? "1" : "0") : "";
      string strategy_stop=strategy_complete ? (stop ? "1" : "0") : "";
      string strategy_pnl=strategy_complete ? DoubleToString(pnl,2) : "";
      string row=IntegerToString(rec.market_signal_id)+","+EscapeCSV(rec.market_signal_key)+","+
         EscapeCSV(_Symbol)+","+EscapeCSV(EnumToString((ENUM_TIMEFRAMES)_Period))+","+
         (rec.is_bullish ? "BUY" : "SELL")+",BID_OHLC,"+
         ME_Time(rec.p1_time)+","+ME_Time(rec.p2_time)+","+ME_Time(rec.p3_time)+","+
         ME_Time(rec.signal_time)+","+ME_Time(rec.confirmation_time)+","+
         ME_Time(rec.detector_evaluation_time)+","+ME_Time(rec.t0_bar_time)+","+
         DoubleToString(rec.t0_close,_Digits)+","+
         (rec.t0_atr_valid ? DoubleToString(rec.t0_atr,_Digits) : "")+","+
         IntegerToString(rec.t0_atr_period)+","+
         EscapeCSV(EnumToString((ENUM_TIMEFRAMES)_Period))+","+
         IntegerToString(rec.t0_atr_shift)+","+(rec.t0_atr_valid ? "1" : "0")+","+
         IntegerToString(V923_MARKET_HORIZON_BARS)+","+
         IntegerToString(rec.completed_future_bars)+","+(rec.horizon_complete ? "1" : "0")+","+
         future_mfe+","+future_mae+","+future_mfe_atr+","+future_mae_atr+","+
         EscapeCSV(inp_market_edge_version)+","+DoubleToString(V923_TARGET_ATR_MULTIPLE,1)+","+
         target_hit+","+bars_to_target+","+(rec.data_gap_detected ? "1" : "0")+","+
         IntegerToString(rec.max_interbar_gap_seconds)+","+EscapeCSV(rec.censor_reason)+","+
         "0,,"+EscapeCSV(rec.was_executed ? "EXECUTED" : "NOT_EXECUTED_OR_UNRESOLVED")+","+
         (rec.was_executed ? "1" : "0")+","+
         (rec.was_executed ? IntegerToString(rec.executed_setup_id) : "")+","+
         (rec.was_executed ? "1" : "0")+","+
         (rec.was_executed ? IntegerToString(rec.executed_setup_id) : "")+","+
         EscapeCSV(join_status)+","+(strategy_complete ? "1" : "0")+","+
         strategy_step4+","+strategy_stop+","+strategy_pnl+","+
         V923_BASELINE_COMMIT+","+V923_BASELINE_SHA256+","+
         V923_RESEARCH_PROTOCOL_VERSION+","+V923_FEATURE_SCHEMA_VERSION+","+MEV2_Row(rec)+"\r\n";
      FileWriteString(h,row);
   }
   FileFlush(h); FileClose(h);
   Print("Market Edge dataset exported: ",fn," | Rows=",g_market_edge_count,
         " | Target=",inp_market_edge_version," | PriceSource=BID_OHLC",
         " | FeatureSnapshot=",V924_FEATURE_SNAPSHOT_VERSION);
}
string RP_TimeSplit(datetime t)
{
   MqlDateTime d;TimeToStruct(t,d);
   return d.year<=2021 ? "DEV_2015_2021" : "OOS_2022_2026";
}
string RP_WFAFold(datetime t)
{
   MqlDateTime d;TimeToStruct(t,d);
   if(d.year<=2018) return "WF1_2015_2018";
   if(d.year<=2021) return "WF2_2019_2021";
   if(d.year<=2024) return "WF3_2022_2024";
   return "WF4_2025_2026";
}
void ExportResearchProtocolCSV()
{
   if(!inp_enable_research_protocol) return;
   string fn="ResearchProtocol_"+inp_research_protocol_tag+"_"+_Symbol+".csv";
   int h=SafeOpenCSV(fn);if(h==INVALID_HANDLE)return;
   string hdr="ResearchID,Population,Cohort,WasExecuted,ExecutedSetupID,ActualOutcomeJoinKey,ActualOutcomeDataset,ActualOutcomeJoinStatus,ActualOutcomeAuthority,"
      "OutcomeSource,ShadowUsePolicy,ProfileDecisionStatus,ProfileDecisionTime,RejectedByProfile,RejectStage,RejectReason,WasArmedByProfile,"
      "ObservedActiveSetupGate,ObservedSessionGate,ObservedCooldownGate,SignalTime,P3Time,ShadowCloseTime,Split,WFAFold,Side,"
      "P1Dist,P2Dist,DivGap12,DivGap23,DivSpan,DivGapRatio,DivPriceStrength,DivRSIStrength,DivPriceSlope,DivRSISlope,"
      "P1RSI,P2RSI,P3RSI,DivRSISpread,DivPriceLegRatio,DivAngle,"
      "M5TrendRegime,M5ATR,M5ATRPercentile,M5ADX,M5DIPlus,M5DIMinus,M5DIGap,"
      "SweptPriorHigh,SweptPriorLow,SweepDepthATR,CloseBackInside,SweepRejectWick,"
      "BOS,CHOCH,BarsSinceBOS,BarsSinceCHOCH,BOSDistanceATR,CHOCHDistanceATR,StructureDirectionMatch,"
      "ATR_Main,ATRPercentile_Main,ATRRegime_Main,SpreadPoints,SpreadATRRatio,Session,EntryHour,EntryDay,"
      "ShadowMFEPoints,ShadowMAEPoints,ShadowMFEMoney,ShadowMAEMoney,ShadowMaxStep,ShadowStopFlag,ShadowFinalEvent,ShadowFinalPnL,ShadowBarsAlive\r\n";
   FileWriteString(h,hdr);
   for(int i=0;i<g_shadow_count;i++)
   {
      SShadowSignal s=g_shadow_signals[i];if(!s.research_protocol)continue;
      SEntrySnapshot q=s.snapshot;
      string ft=OS_GetFinalToken(s.final_event);
      bool stop=OS_IsStopToken(ft);
      string cohort=s.research_executed?"EXECUTED":"ALL_CONFIRMED_ONLY";
      string status=s.research_profile_status;
      string stage=s.research_reject_stage;
      string reason=s.research_reject_reason;
      if(!s.research_executed && reason=="")
      {
         status="NOT_EXECUTED";
         if(s.research_profile_armed)
         {
            stage="PIPELINE_EOT";
            reason="EOT_WHILE_ARMED_OR_WAITING_PROFILE_D_PIPELINE";
         }
         else
         {
            stage="PRE_ARM_PROFILE_D";
            reason="NOT_ARMED_BY_PROFILE_D_DETECTOR_OR_PRECONDITIONS";
            if(s.research_seen_active_setup_gate) reason+="|OBSERVED_ACTIVE_SETUP_GATE";
            if(s.research_seen_session_gate) reason+="|OBSERVED_SESSION_GATE";
            if(s.research_seen_cooldown_gate) reason+="|OBSERVED_COOLDOWN_GATE";
         }
      }
      bool rejected=(status=="REJECTED");
      bool actual_match=false;
      if(s.research_executed && s.research_setup_id>0)
      {
         for(int pr=0;pr<g_position_open_count;pr++)
         {
            if(g_position_open_records[pr].setup_id==s.research_setup_id &&
               g_position_open_records[pr].research_signal_id==s.research_record_id)
            { actual_match=true; break; }
         }
      }
      string join_status=!s.research_executed ? "NOT_APPLICABLE_NON_EXECUTED" :
                         (actual_match ? "MATCHED_POSITION_OPEN_DATASET" : "MISSING_POSITION_OPEN_DATASET_ROW");
      string authority=s.research_executed ? "POSITION_OPEN_DATASET_ONLY" : "NONE_NO_ACTUAL_OUTCOME";
      string row=IntegerToString(s.research_record_id)+",ALL_CONFIRMED,"+cohort+","+
         IntegerToString(s.research_executed?1:0)+","+IntegerToString(s.research_setup_id)+","+
         IntegerToString(s.research_setup_id)+",PositionOpenDataset_"+_Symbol+".csv,"+join_status+","+authority+","+
         "SHADOW_PROXY_UNVALIDATED,EXCLUDE_FROM_FEATURE_SELECTION_EXPECTANCY_DEEP_REDUCTION_CANDIDATE_ACCEPTANCE,"+
         EscapeCSV(status)+","+TimeToString(s.research_decision_time,TIME_DATE|TIME_MINUTES|TIME_SECONDS)+","+
         IntegerToString(rejected?1:0)+","+EscapeCSV(stage)+","+EscapeCSV(reason)+","+
         IntegerToString(s.research_profile_armed?1:0)+","+
         IntegerToString(s.research_seen_active_setup_gate?1:0)+","+
         IntegerToString(s.research_seen_session_gate?1:0)+","+
         IntegerToString(s.research_seen_cooldown_gate?1:0)+","+
         TimeToString(s.signal_time,TIME_DATE|TIME_MINUTES|TIME_SECONDS)+","+
         TimeToString(s.research_p3_time,TIME_DATE|TIME_MINUTES|TIME_SECONDS)+","+
         TimeToString(s.close_time,TIME_DATE|TIME_MINUTES|TIME_SECONDS)+","+RP_TimeSplit(s.signal_time)+","+RP_WFAFold(s.signal_time)+","+
         (s.is_bullish?"BUY":"SELL")+","+
         IntegerToString(q.pivot1_dist)+","+IntegerToString(q.pivot2_dist)+","+
         IntegerToString(q.pivot_gap_12)+","+IntegerToString(q.pivot_gap_23)+","+IntegerToString(q.div_span_bars)+","+
         DoubleToString(q.pivot_gap_ratio,8)+","+DoubleToString(q.price_div_strength,8)+","+DoubleToString(q.rsi_div_strength,8)+","+
         DoubleToString(q.div_price_slope,8)+","+DoubleToString(q.div_rsi_slope,8)+","+
         DoubleToString(q.pivot_rsi_p1,6)+","+DoubleToString(q.pivot_rsi_p2,6)+","+DoubleToString(q.pivot_rsi_p3,6)+","+
         DoubleToString(MathAbs(q.pivot_rsi_p3-q.pivot_rsi_p1),6)+","+DoubleToString(q.price_leg_ratio,8)+","+DoubleToString(q.divergence_angle,8)+","+
         EscapeCSV(PO_TrendFromEMAOrder(q.ema_order[TF_IDX_M5]))+","+DoubleToString(q.atr[TF_IDX_M5],_Digits)+","+
         DoubleToString(s.research_atr_percentile[TF_IDX_M5],4)+","+DoubleToString(q.adx[TF_IDX_M5],6)+","+
         DoubleToString(q.plus_di[TF_IDX_M5],6)+","+DoubleToString(q.minus_di[TF_IDX_M5],6)+","+DoubleToString(q.di_gap[TF_IDX_M5],6)+","+
         IntegerToString(q.swept_prior_high?1:0)+","+IntegerToString(q.swept_prior_low?1:0)+","+
         DoubleToString(q.sweep_depth_atr,8)+","+IntegerToString(q.close_back_inside_prior_range?1:0)+","+
         DoubleToString(q.sweep_rejection_wick_ratio,8)+","+IntegerToString(q.break_of_structure_flag?1:0)+","+
         IntegerToString(q.change_of_character_flag?1:0)+","+IntegerToString(q.bars_since_bos)+","+IntegerToString(q.bars_since_choch)+","+
         DoubleToString(q.bos_break_distance_atr,8)+","+DoubleToString(q.choch_break_distance_atr,8)+","+
         IntegerToString(q.structure_event_direction_match?1:0)+","+
         DoubleToString(q.atr[TF_IDX_MAIN],_Digits)+","+DoubleToString(s.research_atr_percentile[TF_IDX_MAIN],4)+","+
         DoubleToString(q.atr_regime[TF_IDX_MAIN],8)+","+IntegerToString(q.spread_entry)+","+DoubleToString(q.spread_atr_ratio,8)+","+
         EscapeCSV(q.session)+","+IntegerToString(q.entry_hour)+","+IntegerToString(q.entry_day_of_week)+","+
         DoubleToString(s.lifecycle.mfe_points,2)+","+DoubleToString(s.lifecycle.mae_points,2)+","+
         DoubleToString(s.lifecycle.max_profit_money,2)+","+DoubleToString(-s.lifecycle.max_loss_money,2)+","+
         IntegerToString(s.max_step_reached)+","+IntegerToString(stop?1:0)+","+EscapeCSV(s.final_event)+","+
         DoubleToString(s.final_profit_est,2)+","+IntegerToString(s.lifecycle.bars_alive)+"\r\n";
      FileWriteString(h,row);
   }
   FileFlush(h);FileClose(h);
   Print("Research protocol exported: ",fn,
         " | ShadowOutcomeSource=SHADOW_PROXY_UNVALIDATED",
         " | ActualOutcomeAuthority=PositionOpenDataset");
}
#define UR_MAX_ROWS 200000
#define FD_MAX_AGG  6000
struct SUnifiedRegistryRow
{
   int      signal_id;
   int      setup_id;
   datetime signal_time;
   datetime close_time;
   string   symbol;
   string   side;
   bool     accepted;
   string   reject_mask;
   string   reject_verbose;
   string   outcome_source;   // REAL / SHADOW
   string   final_event;
   string   final_token;
   double   final_profit;
   int      max_step;
   bool     stop_flag;
   bool     target_flag;
   bool     hit_tp1;
   bool     hit_tp2;
   bool     hit_ema200;
   int      bars_alive;
   int      ticks_alive;
   double   mfe_points;
   double   mae_points;
   double   max_profit_money;
   double   max_loss_money;
   SEntrySnapshot snap;
   void Reset()
   {
      signal_id = 0;
      setup_id = 0;
      signal_time = 0;
      close_time = 0;
      symbol = "";
      side = "";
      accepted = false;
      reject_mask = "";
      reject_verbose = "";
      outcome_source = "";
      final_event = "";
      final_token = "";
      final_profit = 0.0;
      max_step = 0;
      stop_flag = false;
      target_flag = false;
      hit_tp1 = false;
      hit_tp2 = false;
      hit_ema200 = false;
      bars_alive = 0;
      ticks_alive = 0;
      mfe_points = 0.0;
      mae_points = 0.0;
      max_profit_money = 0.0;
      max_loss_money = 0.0;
      snap.Reset();
   }
};
string UR_GetFinalToken(string evt)
{
   evt = NormalizeEventString(evt);
   if(evt == "") return "";
   int last_arrow = -1;
   int len = StringLen(evt);
   for(int i = len - 2; i >= 0; i--)
   {
      if(StringSubstr(evt, i, 2) == "->")
      {
         last_arrow = i;
         break;
      }
   }
   string last = (last_arrow >= 0) ? StringSubstr(evt, last_arrow + 2) : evt;
   return NormalizeEventToken(last);
}
bool UR_IsStopToken(string tok)
{
   tok = NormalizeEventToken(tok);
   return (tok == "SL" || tok == "SL$" || tok == "STOP");
}
bool UR_IsTargetToken(string tok)
{
   tok = NormalizeEventToken(tok);
   if(tok == "EMA") return true;
   if(tok == "TP") return true;
   if(StringFind(tok, "TP") == 0) return true;
   return false;
}
int BuildUnifiedRegistryRows(SUnifiedRegistryRow &rows[])
{
   ArrayResize(rows, 0);
   int rc = 0;
   //================ ACCEPTED / REAL =================
   for(int i = 0; i < g_snapshot_count; i++)
   {
      ArrayResize(rows, rc + 1);
      rows[rc].Reset();
      rows[rc].signal_id = rc + 1;
      rows[rc].setup_id = g_snapshots[i].setup_id;
      rows[rc].signal_time = g_snapshots[i].entry_time;
      rows[rc].close_time = 0;
      rows[rc].symbol = _Symbol;
      rows[rc].side = g_snapshots[i].is_bullish ? "BUY" : "SELL";
      rows[rc].accepted = true;
      rows[rc].reject_mask = "";
      rows[rc].reject_verbose = "";
      rows[rc].outcome_source = "REAL";
      rows[rc].final_event = NormalizeEventString(g_snapshots[i].close_event);
      rows[rc].final_token = UR_GetFinalToken(rows[rc].final_event);
      rows[rc].final_profit = g_snapshots[i].final_profit;
      rows[rc].max_step = g_snapshots[i].actual_max_step;
      rows[rc].stop_flag   = UR_IsStopToken(rows[rc].final_token);
      rows[rc].target_flag = UR_IsTargetToken(rows[rc].final_token);
      rows[rc].hit_tp1 = g_snapshots[i].hit_tp1;
      rows[rc].hit_tp2 = g_snapshots[i].hit_tp2;
      rows[rc].hit_ema200 = g_snapshots[i].hit_ema200;
      rows[rc].bars_alive = 0;
      rows[rc].ticks_alive = 0;
      rows[rc].mfe_points = 0.0;
      rows[rc].mae_points = 0.0;
      rows[rc].max_profit_money = 0.0;
      rows[rc].max_loss_money = 0.0;
      rows[rc].snap = g_snapshots[i];
      rc++;
   }
   //================ REJECTED / SHADOW =================
   for(int i = 0; i < g_shadow_count; i++)
   {
      // فقط reject های واقعی برای registry پژوهشی
      if(g_shadow_signals[i].was_accepted)
         continue;
      ArrayResize(rows, rc + 1);
      rows[rc].Reset();
      rows[rc].signal_id = rc + 1;
      rows[rc].setup_id = g_shadow_signals[i].candidate_setup_id;
      rows[rc].signal_time = g_shadow_signals[i].signal_time;
      rows[rc].close_time = g_shadow_signals[i].close_time;
      rows[rc].symbol = _Symbol;
      rows[rc].side = g_shadow_signals[i].is_bullish ? "BUY" : "SELL";
      rows[rc].accepted = false;
      rows[rc].reject_mask = g_shadow_signals[i].reject_info.BuildMaskString();
      rows[rc].reject_verbose = g_shadow_signals[i].reject_info.BuildVerboseString();
      rows[rc].outcome_source = "SHADOW";
      rows[rc].final_event = NormalizeEventString(g_shadow_signals[i].final_event);
      if(rows[rc].final_event == "")
         rows[rc].final_event = NormalizeEventString(g_shadow_signals[i].event_path);
      rows[rc].final_token = UR_GetFinalToken(rows[rc].final_event);
      rows[rc].final_profit = g_shadow_signals[i].final_profit_est;
      rows[rc].max_step = g_shadow_signals[i].max_step_reached;
      rows[rc].stop_flag   = UR_IsStopToken(rows[rc].final_token);
      rows[rc].target_flag = UR_IsTargetToken(rows[rc].final_token);
      rows[rc].hit_tp1 = g_shadow_signals[i].hit_tp1;
      rows[rc].hit_tp2 = g_shadow_signals[i].hit_tp2;
      rows[rc].hit_ema200 = g_shadow_signals[i].hit_ema200;
      rows[rc].bars_alive = g_shadow_signals[i].lifecycle.bars_alive;
      rows[rc].ticks_alive = g_shadow_signals[i].lifecycle.ticks_alive;
      rows[rc].mfe_points = g_shadow_signals[i].lifecycle.mfe_points;
      rows[rc].mae_points = g_shadow_signals[i].lifecycle.mae_points;
      rows[rc].max_profit_money = g_shadow_signals[i].lifecycle.max_profit_money;
      rows[rc].max_loss_money = g_shadow_signals[i].lifecycle.max_loss_money;
      rows[rc].snap = g_shadow_signals[i].snapshot;
      rows[rc].snap.actual_max_step = g_shadow_signals[i].max_step_reached;
      rows[rc].snap.final_profit = g_shadow_signals[i].final_profit_est;
      rows[rc].snap.hit_tp1 = g_shadow_signals[i].hit_tp1;
      rows[rc].snap.hit_tp2 = g_shadow_signals[i].hit_tp2;
      rows[rc].snap.hit_ema200 = g_shadow_signals[i].hit_ema200;
      rows[rc].snap.close_event = rows[rc].final_event;
      rc++;
   }
   return rc;
}
// ================================================================
// FILTER IMPACT ANALYZER
// برای هر Feature یک threshold امتحان می‌کند و این‌ها را می‌دهد:
//
// DEV (سال‌های اول): Baseline / Pass / Reject / Coverage / ΔStop / ΔStep4 / ΔPF / ΔExpectancy
// OOS (سال‌های آخر): همان معیارها
// OOS Stable: آیا در OOS هم کار می‌کند؟
// ================================================================
// ----------------------------------------------------------------
// ساختار داخلی یک بازه آماری
// ----------------------------------------------------------------
struct SFIAGroup
{
   int    n;
   int    n_stop;
   int    n_step4;
   int    n_win;
   double sum_profit;
   double gross_profit;
   double gross_loss;
   void Reset()
   {
      n = 0; n_stop = 0; n_step4 = 0; n_win = 0;
      sum_profit = 0.0; gross_profit = 0.0; gross_loss = 0.0;
   }
   void Add(bool is_stop, bool is_step4, double profit)
   {
      n++;
      if(is_stop)  n_stop++;
      if(is_step4) n_step4++;
      sum_profit += profit;
      if(profit > 0) { n_win++; gross_profit += profit; }
      else           { gross_loss += MathAbs(profit); }
   }
   double StopPct()   { return (n > 0) ? (n_stop  * 100.0 / n) : 0.0; }
   double Step4Pct()  { return (n > 0) ? (n_step4 * 100.0 / n) : 0.0; }
   double WinRate()   { return (n > 0) ? (n_win   * 100.0 / n) : 0.0; }
   double AvgProfit() { return (n > 0) ? (sum_profit / n)        : 0.0; }
   double PF()
   {
      if(gross_loss < 0.0001) return (gross_profit > 0 ? 99.0 : 0.0);
      return gross_profit / gross_loss;
   }
};
// ----------------------------------------------------------------
// یک ردیف نتیجه
// ----------------------------------------------------------------
struct SFIAResult
{
   string feature;
   string side;
   string direction;   // GE / LE
   double threshold;
   // DEV
   SFIAGroup dev_base;
   SFIAGroup dev_pass;
   SFIAGroup dev_reject;
   // OOS
   SFIAGroup oos_base;
   SFIAGroup oos_pass;
   SFIAGroup oos_reject;
   void Reset()
   {
      feature = ""; side = ""; direction = ""; threshold = 0.0;
      dev_base.Reset(); dev_pass.Reset(); dev_reject.Reset();
      oos_base.Reset(); oos_pass.Reset(); oos_reject.Reset();
   }
};
datetime FIA_GetDevCutoff()
{
   // از g_risklab_dev_cutoff اگر موجود بود استفاده می‌کنیم
   if(g_risklab_dev_cutoff > 0) return g_risklab_dev_cutoff;
   // وگرنه از Snapshot time محاسبه می‌کنیم
   if(g_snapshot_count < 10) return 0;
   datetime times[];
   ArrayResize(times, g_snapshot_count);
   for(int i = 0; i < g_snapshot_count; i++)
      times[i] = g_snapshots[i].entry_time;
   ArraySort(times);
   int cutoff_idx = (int)(g_snapshot_count * 0.70);
   if(cutoff_idx >= g_snapshot_count) cutoff_idx = g_snapshot_count - 1;
   return times[cutoff_idx];
}
// ----------------------------------------------------------------
// تابع اصلی
// ----------------------------------------------------------------
bool FIA_GetValueFromSnapshot(SEntrySnapshot &sn, string feature, double &out)
{
   out = 0.0;
   if(feature == "ATR_Regime_M1")    { out = sn.atr_regime[TF_IDX_MAIN];  return (out > 0.0); }
   if(feature == "ATR_Regime_M5")    { out = sn.atr_regime[TF_IDX_M5];    return (out > 0.0); }
   if(feature == "ATR_Regime_H1")    { out = sn.atr_regime[TF_IDX_H1];    return (out > 0.0); }
   if(feature == "ATR_M1")           { out = sn.atr[TF_IDX_MAIN];         return (out > 0.0); }
   if(feature == "ATR_M5")           { out = sn.atr[TF_IDX_M5];           return (out > 0.0); }
   if(feature == "ATR_M30")          { out = sn.atr[TF_IDX_M30];          return (out > 0.0); }
   if(feature == "ADX_M1")           { out = sn.adx[TF_IDX_MAIN];         return (out > 0.0); }
   if(feature == "ADX_H1")           { out = sn.adx[TF_IDX_H1];           return (out > 0.0); }
   if(feature == "ADX_H4")           { out = sn.adx[TF_IDX_H4];           return (out > 0.0); }
   if(feature == "RSI_M1")           { out = sn.rsi[TF_IDX_MAIN];         return (out > 0.0 && out <= 100.0); }
   if(feature == "RSI_H1")           { out = sn.rsi[TF_IDX_H1];           return (out > 0.0 && out <= 100.0); }
   if(feature == "RSI_H4")           { out = sn.rsi[TF_IDX_H4];           return (out > 0.0 && out <= 100.0); }
   if(feature == "CCI_M1")           { out = sn.cci[TF_IDX_MAIN];         return MathIsValidNumber(out); }
   if(feature == "EMA_Comp_M1")      { out = sn.ema_compression[TF_IDX_MAIN]; return (out > 0.0); }
   if(feature == "EMA_Comp_M5")      { out = sn.ema_compression[TF_IDX_M5];   return (out > 0.0); }
   if(feature == "ADX_Slope_M1")     { out = sn.adx_slope[TF_IDX_MAIN];   return MathIsValidNumber(out); }
   if(feature == "ADX_Slope_H1")     { out = sn.adx_slope[TF_IDX_H1];     return MathIsValidNumber(out); }
   if(feature == "EMA200_Dist_M1")   { out = sn.ema200_dist[TF_IDX_MAIN]; return (out > 0.0); }
   if(feature == "Signal_BodyRatio") { out = sn.signal_body_ratio;        return (out >= 0.0); }
   if(feature == "Signal_CLV")       { out = sn.signal_clv;               return (out >= 0.0); }
   if(feature == "OB_AgeBars")       { out = sn.ob_age_bars;              return (out >= 0.0); }
   if(feature == "OB_Width_ATR")     { out = sn.ob_width_atr;             return (out >= 0.0); }
   if(feature == "Stability")        { out = sn.stability_score;          return (out >= 0.0); }
   if(feature == "Pivot1Dist")       { out = sn.pivot1_dist;              return (out > 0.0); }
   if(feature == "Pivot2Dist")       { out = sn.pivot2_dist;              return (out > 0.0); }
   return false;
}
void ExportFilterImpactCSV()
{
   if(g_snapshot_count < 50)
   {
      Print("FIA: Not enough snapshots");
      return;
   }
   // ================================================================
   // PRE-CHECK 1: Shadow coverage
   // ================================================================
   int closed_shadows = 0;
   int buy_shadows = 0;
   int sell_shadows = 0;
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(g_shadow_signals[i].was_accepted) continue;
      if(g_shadow_signals[i].close_time == 0) continue;
      closed_shadows++;
      if(g_shadow_signals[i].is_bullish) buy_shadows++;
      else sell_shadows++;
   }
   Print("FIA v2 pre-check:",
         " Snapshots=", g_snapshot_count,
         " | Total_Shadows=", g_shadow_count,
         " | Closed_Rejected_Shadows=", closed_shadows,
         " | BUY_shadows=", buy_shadows,
         " | SELL_shadows=", sell_shadows);
   if(closed_shadows < 50)
   {
      Print("FIA v2 WARNING: Shadow coverage is low. Results using REGISTRY_FULL may have reduced statistical confidence.");
   }
   // ================================================================
   // PRE-CHECK 2: Feature validity for ATR_Regime_M1
   // ================================================================
   int valid_atr_regime_buy = 0;
   int valid_atr_regime_sell = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_snapshots[i].atr_regime[TF_IDX_MAIN] > 0.0)
      {
         if(g_snapshots[i].is_bullish) valid_atr_regime_buy++;
         else valid_atr_regime_sell++;
      }
   }
   Print("FIA v2: ATR_Regime_M1 valid in snapshots:",
         " BUY=", valid_atr_regime_buy,
         " SELL=", valid_atr_regime_sell);
   int valid_atr_regime_shad_buy = 0;
   int valid_atr_regime_shad_sell = 0;
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(g_shadow_signals[i].was_accepted) continue;
      if(g_shadow_signals[i].close_time == 0) continue;
      if(g_shadow_signals[i].snapshot.atr_regime[TF_IDX_MAIN] > 0.0)
      {
         if(g_shadow_signals[i].is_bullish) valid_atr_regime_shad_buy++;
         else valid_atr_regime_shad_sell++;
      }
   }
   Print("FIA v2: ATR_Regime_M1 valid in closed shadows:",
         " BUY=", valid_atr_regime_shad_buy,
         " SELL=", valid_atr_regime_shad_sell);
   // ================================================================
   // YEAR-BASED WALK-FORWARD
   // ================================================================
   int min_year = 9999;
   int max_year = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      MqlDateTime dt;
      TimeToStruct(g_snapshots[i].entry_time, dt);
      if(dt.year < min_year) min_year = dt.year;
      if(dt.year > max_year) max_year = dt.year;
   }
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(g_shadow_signals[i].was_accepted) continue;
      if(g_shadow_signals[i].close_time == 0) continue;
      MqlDateTime dt;
      TimeToStruct(g_shadow_signals[i].signal_time, dt);
      if(dt.year < min_year) min_year = dt.year;
      if(dt.year > max_year) max_year = dt.year;
   }
   if(max_year <= min_year)
   {
      Print("FIA: Not enough years");
      return;
   }
   int oos_year = max_year;
   datetime dev_cutoff = 0;
   if(max_year - min_year >= 2)
   {
      MqlDateTime oos_dt;
      oos_dt.year = oos_year;
      oos_dt.mon  = 1;
      oos_dt.day  = 1;
      oos_dt.hour = 0;
      oos_dt.min  = 0;
      oos_dt.sec  = 0;
      dev_cutoff = StructToTime(oos_dt);
   }
   else
   {
      datetime times[];
      int tc = 0;
      ArrayResize(times, g_snapshot_count + g_shadow_count);
      for(int i = 0; i < g_snapshot_count; i++)
         times[tc++] = g_snapshots[i].entry_time;
      for(int i = 0; i < g_shadow_count; i++)
      {
         if(g_shadow_signals[i].was_accepted) continue;
         if(g_shadow_signals[i].close_time == 0) continue;
         times[tc++] = g_shadow_signals[i].signal_time;
      }
      ArrayResize(times, tc);
      ArraySort(times);
      dev_cutoff = times[(int)(tc * 0.70)];
      ArrayFree(times);
   }
   int snap_dev = 0, snap_oos = 0;
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(g_snapshots[i].entry_time < dev_cutoff) snap_dev++;
      else snap_oos++;
   }
   int shad_dev = 0, shad_oos = 0;
   for(int i = 0; i < g_shadow_count; i++)
   {
      if(g_shadow_signals[i].was_accepted) continue;
      if(g_shadow_signals[i].close_time == 0) continue;
      if(g_shadow_signals[i].signal_time < dev_cutoff) shad_dev++;
      else shad_oos++;
   }
   Print("FIA v2 Walk-Forward split:",
         " Snapshot DEV=", snap_dev,
         " OOS=", snap_oos,
         " | Shadow DEV=", shad_dev,
         " OOS=", shad_oos,
         " | Cutoff=", TimeToString(dev_cutoff, TIME_DATE));
   int n_years_dev = oos_year - min_year;
   int n_years_oos = 1;
   // ================================================================
   // Local structs
   // ================================================================
   struct SFIAGroup
   {
      int    n;
      int    n_stop;
      int    n_step4;
      int    n_win;
      double sum_profit;
      double gross_profit;
      double gross_loss;
      void Reset()
      {
         n = 0;
         n_stop = 0;
         n_step4 = 0;
         n_win = 0;
         sum_profit = 0.0;
         gross_profit = 0.0;
         gross_loss = 0.0;
      }
      void Add(bool is_stop, bool is_step4, double profit)
      {
         n++;
         if(is_stop)  n_stop++;
         if(is_step4) n_step4++;
         sum_profit += profit;
         if(profit > 0.0)
         {
            n_win++;
            gross_profit += profit;
         }
         else
         {
            gross_loss += MathAbs(profit);
         }
      }
      double StopPct()      { return (n > 0 ? n_stop  * 100.0 / n : 0.0); }
      double Step4Pct()     { return (n > 0 ? n_step4 * 100.0 / n : 0.0); }
      double WinRate()      { return (n > 0 ? n_win   * 100.0 / n : 0.0); }
      double AvgProfit()    { return (n > 0 ? sum_profit / n : 0.0); }
      double PF()
      {
         if(gross_loss < 0.0001)
            return (gross_profit > 0.0 ? 99.0 : 0.0);
         return gross_profit / gross_loss;
      }
      double Expectancy()
      {
         if(n <= 0) return 0.0;
         double wr = WinRate() / 100.0;
         double avg_win  = (n_win > 0) ? (gross_profit / n_win) : 0.0;
         double avg_loss = ((n - n_win) > 0) ? (gross_loss / (n - n_win)) : 0.0;
         return (wr * avg_win) - ((1.0 - wr) * avg_loss);
      }
   };
   struct SFIAResult
   {
      string feature;
      string side;
      string direction;
      double threshold;
      int    total_valid;
      string data_source;
      SFIAGroup dev_base;
      SFIAGroup dev_pass;
      SFIAGroup dev_reject;
      SFIAGroup oos_base;
      SFIAGroup oos_pass;
      SFIAGroup oos_reject;
      void Reset()
      {
         feature = "";
         side = "";
         direction = "";
         threshold = 0.0;
         total_valid = 0;
         data_source = "";
         dev_base.Reset();
         dev_pass.Reset();
         dev_reject.Reset();
         oos_base.Reset();
         oos_pass.Reset();
         oos_reject.Reset();
      }
   };
   struct SFIACand
   {
      string feature;
      string side;
      string dir;
      double thr;
      bool   use_shadow;
   };
   // ================================================================
   // Candidate list
   // ================================================================
   SFIACand cands[];
   int cc = 0;
   ArrayResize(cands, 300);
   // BUY ATR_Regime_M1
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.65; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.72; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.80; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.85; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.90; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.95; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=1.10; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=1.20; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=1.50; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // SELL ATR_Regime_M1
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.65; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.72; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.80; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.85; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.90; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.95; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.10; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.20; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // SELL ATR_M1
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.70; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.80; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.90; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.94; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.00; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.10; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_M1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // SELL ADX_H1
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=18.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=22.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=25.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=30.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=35.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H1"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=0.0;  cands[cc].use_shadow=true; cc++;
   // SELL ADX_H4
   cands[cc].feature="ADX_H4"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=18.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H4"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=22.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H4"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=25.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H4"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=30.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ADX_H4"; cands[cc].side="SELL"; cands[cc].dir="GE"; cands[cc].thr=0.0;  cands[cc].use_shadow=true; cc++;
   // BUY Signal_BodyRatio
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.30; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.35; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.40; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.50; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.60; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=0.70; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_BodyRatio"; cands[cc].side="BUY"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // SELL Signal_CLV
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.30; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.40; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.50; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.60; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.70; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="Signal_CLV"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // BUY EMA_Comp_M5
   cands[cc].feature="EMA_Comp_M5"; cands[cc].side="BUY"; cands[cc].dir="GE"; cands[cc].thr=3.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="EMA_Comp_M5"; cands[cc].side="BUY"; cands[cc].dir="GE"; cands[cc].thr=4.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="EMA_Comp_M5"; cands[cc].side="BUY"; cands[cc].dir="GE"; cands[cc].thr=5.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="EMA_Comp_M5"; cands[cc].side="BUY"; cands[cc].dir="GE"; cands[cc].thr=6.0; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="EMA_Comp_M5"; cands[cc].side="BUY"; cands[cc].dir="GE"; cands[cc].thr=0.0; cands[cc].use_shadow=true; cc++;
   // SELL ATR_Regime_H1
   cands[cc].feature="ATR_Regime_H1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.80; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_H1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.90; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_H1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.00; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_H1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.20; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_H1"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // Stability ALL
   cands[cc].feature="Stability"; cands[cc].side="ALL"; cands[cc].dir="GE"; cands[cc].thr=30.0; cands[cc].use_shadow=false; cc++;
   cands[cc].feature="Stability"; cands[cc].side="ALL"; cands[cc].dir="GE"; cands[cc].thr=40.0; cands[cc].use_shadow=false; cc++;
   cands[cc].feature="Stability"; cands[cc].side="ALL"; cands[cc].dir="GE"; cands[cc].thr=50.0; cands[cc].use_shadow=false; cc++;
   cands[cc].feature="Stability"; cands[cc].side="ALL"; cands[cc].dir="GE"; cands[cc].thr=0.0;  cands[cc].use_shadow=false; cc++;
   // SELL ATR_Regime_M5
   cands[cc].feature="ATR_Regime_M5"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.80; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M5"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=0.90; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M5"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=1.00; cands[cc].use_shadow=true; cc++;
   cands[cc].feature="ATR_Regime_M5"; cands[cc].side="SELL"; cands[cc].dir="LE"; cands[cc].thr=9.99; cands[cc].use_shadow=true; cc++;
   // ================================================================
   // Run analysis
   // ================================================================
   SFIAResult results[];
   ArrayResize(results, cc);
   for(int ci = 0; ci < cc; ci++)
   {
      results[ci].Reset();
      results[ci].feature = cands[ci].feature;
      results[ci].side = cands[ci].side;
      results[ci].direction = cands[ci].dir;
      results[ci].threshold = cands[ci].thr;
      results[ci].data_source = cands[ci].use_shadow ? "REGISTRY_FULL" : "SNAPSHOT_ONLY";
      // accepted snapshots
      for(int i = 0; i < g_snapshot_count; i++)
      {
         string snap_side = g_snapshots[i].is_bullish ? "BUY" : "SELL";
         if(cands[ci].side != "ALL" && snap_side != cands[ci].side)
            continue;
         SEntrySnapshot sn = g_snapshots[i];
         double fval = 0.0;
         if(!FIA_GetValueFromSnapshot(sn, cands[ci].feature, fval))
            continue;
         results[ci].total_valid++;
         string ft = OS_GetFinalToken(sn.close_event);
         bool is_stp = OS_IsStopToken(ft);
         bool is_4p  = (sn.actual_max_step >= 4);
         double pft  = sn.final_profit;
         bool pass = (cands[ci].dir == "GE") ? (fval >= cands[ci].thr) : (fval <= cands[ci].thr);
         bool is_oos = (sn.entry_time >= dev_cutoff);
         if(!is_oos)
         {
            results[ci].dev_base.Add(is_stp, is_4p, pft);
            if(pass) results[ci].dev_pass.Add(is_stp, is_4p, pft);
            else     results[ci].dev_reject.Add(is_stp, is_4p, pft);
         }
         else
         {
            results[ci].oos_base.Add(is_stp, is_4p, pft);
            if(pass) results[ci].oos_pass.Add(is_stp, is_4p, pft);
            else     results[ci].oos_reject.Add(is_stp, is_4p, pft);
         }
      }
      // rejected closed shadows
      if(cands[ci].use_shadow)
      {
         for(int i = 0; i < g_shadow_count; i++)
         {
            if(g_shadow_signals[i].was_accepted) continue;
            if(g_shadow_signals[i].close_time == 0) continue;
            string shad_side = g_shadow_signals[i].is_bullish ? "BUY" : "SELL";
            if(cands[ci].side != "ALL" && shad_side != cands[ci].side)
               continue;
            SEntrySnapshot sn = g_shadow_signals[i].snapshot;
            double fval = 0.0;
            if(!FIA_GetValueFromSnapshot(sn, cands[ci].feature, fval))
               continue;
            results[ci].total_valid++;
            string raw_evt = (g_shadow_signals[i].final_event != "")
                             ? g_shadow_signals[i].final_event
                             : g_shadow_signals[i].event_path;
            string ft = UR_GetFinalToken(NormalizeEventString(raw_evt));
            bool is_stp = UR_IsStopToken(ft);
            bool is_4p  = (g_shadow_signals[i].max_step_reached >= 4);
            double pft  = g_shadow_signals[i].final_profit_est;
            bool pass = (cands[ci].dir == "GE") ? (fval >= cands[ci].thr) : (fval <= cands[ci].thr);
            bool is_oos = (g_shadow_signals[i].signal_time >= dev_cutoff);
            if(!is_oos)
            {
               results[ci].dev_base.Add(is_stp, is_4p, pft);
               if(pass) results[ci].dev_pass.Add(is_stp, is_4p, pft);
               else     results[ci].dev_reject.Add(is_stp, is_4p, pft);
            }
            else
            {
               results[ci].oos_base.Add(is_stp, is_4p, pft);
               if(pass) results[ci].oos_pass.Add(is_stp, is_4p, pft);
               else     results[ci].oos_reject.Add(is_stp, is_4p, pft);
            }
         }
      }
   }
   // ================================================================
   // Export CSV
   // ================================================================
   string fn = "FilterImpact_" + _Symbol + ".csv";
   int h = SafeOpenCSV(fn);
   if(h == INVALID_HANDLE) return;
   string hdr =
      "Feature,Side,Direction,Threshold,Total_Valid_N,N_Years_DEV,N_Years_OOS,DataSource,"
      "DEV_Base_N,DEV_Base_Stop%,DEV_Base_Step4%,DEV_Base_AvgP,DEV_Base_PF,DEV_Base_WR%,DEV_Base_Expectancy,"
      "DEV_Pass_N,DEV_Pass_Stop%,DEV_Pass_Step4%,DEV_Pass_AvgP,DEV_Pass_PF,DEV_Pass_WR%,DEV_Pass_Expectancy,"
      "DEV_Reject_N,DEV_Reject_Stop%,DEV_Reject_Step4%,DEV_Reject_AvgP,DEV_Reject_PF,DEV_Reject_WR%,"
      "DEV_Coverage%,DEV_dStop,DEV_dStep4,DEV_dAvgP,DEV_dPF,DEV_dExpectancy,"
      "OOS_Base_N,OOS_Base_Stop%,OOS_Base_Step4%,OOS_Base_AvgP,OOS_Base_PF,OOS_Base_WR%,OOS_Base_Expectancy,"
      "OOS_Pass_N,OOS_Pass_Stop%,OOS_Pass_Step4%,OOS_Pass_AvgP,OOS_Pass_PF,OOS_Pass_WR%,OOS_Pass_Expectancy,"
      "OOS_Reject_N,OOS_Reject_Stop%,OOS_Reject_Step4%,OOS_Reject_AvgP,OOS_Reject_PF,OOS_Reject_WR%,"
      "OOS_Coverage%,OOS_dStop,OOS_dStep4,OOS_dAvgP,OOS_dPF,OOS_dExpectancy,"
      "OOS_Stable_Stop,OOS_Stable_PF,OOS_Stable_Expectancy,"
      "ImpactScore_DEV_EXPERIMENTAL,ImpactScore_OOS_EXPERIMENTAL,"
      "MinSampleOK,SampleQuality,Verdict_V1";
   FileWriteString(h, hdr + "\r\n");
   for(int i = 0; i < cc; i++)
   {
      double dev_cov   = (results[i].dev_base.n > 0) ? (results[i].dev_pass.n * 100.0 / results[i].dev_base.n) : 0.0;
      double dev_d_stp = results[i].dev_pass.StopPct()    - results[i].dev_base.StopPct();
      double dev_d_4p  = results[i].dev_pass.Step4Pct()   - results[i].dev_base.Step4Pct();
      double dev_d_avg = results[i].dev_pass.AvgProfit()  - results[i].dev_base.AvgProfit();
      double dev_d_pf  = results[i].dev_pass.PF()         - results[i].dev_base.PF();
      double dev_d_exp = results[i].dev_pass.Expectancy() - results[i].dev_base.Expectancy();
      double oos_cov   = (results[i].oos_base.n > 0) ? (results[i].oos_pass.n * 100.0 / results[i].oos_base.n) : 0.0;
      double oos_d_stp = results[i].oos_pass.StopPct()    - results[i].oos_base.StopPct();
      double oos_d_4p  = results[i].oos_pass.Step4Pct()   - results[i].oos_base.Step4Pct();
      double oos_d_avg = results[i].oos_pass.AvgProfit()  - results[i].oos_base.AvgProfit();
      double oos_d_pf  = results[i].oos_pass.PF()         - results[i].oos_base.PF();
      double oos_d_exp = results[i].oos_pass.Expectancy() - results[i].oos_base.Expectancy();
      bool oos_s_stop = (dev_d_stp < 0.0) && (oos_d_stp < 0.0) &&
                        (oos_d_stp <= dev_d_stp * 0.5);
      bool oos_s_pf   = (dev_d_pf  > 0.0) && (oos_d_pf  > 0.0) &&
                        (oos_d_pf  >= dev_d_pf  * 0.5);
      bool oos_s_exp  = (dev_d_exp > 0.0) && (oos_d_exp > 0.0) &&
                        (oos_d_exp >= dev_d_exp * 0.5);
      double norm_stop = MathMax(-1.0, MathMin(1.0, -dev_d_stp / 5.0));
      double norm_pf   = MathMax(-1.0, MathMin(1.0,  dev_d_pf  / 0.3));
      double norm_exp  = MathMax(-1.0, MathMin(1.0,  dev_d_exp / 5.0));
      double norm_cov  = MathMax( 0.0, MathMin(1.0,  dev_cov   / 50.0));
      double impact_dev = (0.35 * norm_pf) + (0.30 * norm_exp) + (0.20 * norm_stop) + (0.15 * norm_cov);
      double norm_stop_o = MathMax(-1.0, MathMin(1.0, -oos_d_stp / 5.0));
      double norm_pf_o   = MathMax(-1.0, MathMin(1.0,  oos_d_pf  / 0.3));
      double norm_exp_o  = MathMax(-1.0, MathMin(1.0,  oos_d_exp / 5.0));
      double norm_cov_o  = MathMax( 0.0, MathMin(1.0,  oos_cov   / 50.0));
      double impact_oos = (0.35 * norm_pf_o) + (0.30 * norm_exp_o) + (0.20 * norm_stop_o) + (0.15 * norm_cov_o);
      int min_n = MathMin(results[i].dev_pass.n, results[i].oos_pass.n);
      bool min_sample_ok = (min_n >= 30);
      string sq = "INSUFFICIENT";
      if(results[i].oos_pass.n >= 300)      sq = "STRONG";
      else if(results[i].oos_pass.n >= 150) sq = "GOOD";
      else if(results[i].oos_pass.n >= 80)  sq = "OK";
      else if(results[i].oos_pass.n >= 30)  sq = "WEAK";
      string verdict = "SKIP";
      if(results[i].threshold > 9.0)
         verdict = "BASELINE";
      else if(results[i].oos_pass.n < 30)
         verdict = "LOW_SAMPLE";
      else if(oos_cov < 10.0)
         verdict = "TOO_RESTRICTIVE";
      else if(impact_oos >= 0.15 && (oos_s_stop || oos_s_pf || oos_s_exp) && min_sample_ok)
         verdict = "KEEP_STRONG";
      else if(impact_oos >= 0.05 && min_sample_ok)
         verdict = "KEEP_WEAK";
      else if(impact_dev >= 0.10 && impact_oos < 0.05)
         verdict = "WATCHLIST_OOS_WEAK";
      else if(impact_oos < 0.0)
         verdict = "NO_EDGE";
      else
         verdict = "WATCHLIST";
      string row = "";
      row += results[i].feature + ",";
      row += results[i].side + ",";
      row += results[i].direction + ",";
      row += DoubleToString(results[i].threshold, 3) + ",";
      row += IntegerToString(results[i].total_valid) + ",";
      row += IntegerToString(n_years_dev) + ",";
      row += IntegerToString(n_years_oos) + ",";
      row += results[i].data_source + ",";
      row += IntegerToString(results[i].dev_base.n) + ",";
      row += DoubleToString(results[i].dev_base.StopPct(),    2) + ",";
      row += DoubleToString(results[i].dev_base.Step4Pct(),   2) + ",";
      row += DoubleToString(results[i].dev_base.AvgProfit(),  2) + ",";
      row += DoubleToString(results[i].dev_base.PF(),         3) + ",";
      row += DoubleToString(results[i].dev_base.WinRate(),    2) + ",";
      row += DoubleToString(results[i].dev_base.Expectancy(), 2) + ",";
      row += IntegerToString(results[i].dev_pass.n) + ",";
      row += DoubleToString(results[i].dev_pass.StopPct(),    2) + ",";
      row += DoubleToString(results[i].dev_pass.Step4Pct(),   2) + ",";
      row += DoubleToString(results[i].dev_pass.AvgProfit(),  2) + ",";
      row += DoubleToString(results[i].dev_pass.PF(),         3) + ",";
      row += DoubleToString(results[i].dev_pass.WinRate(),    2) + ",";
      row += DoubleToString(results[i].dev_pass.Expectancy(), 2) + ",";
      row += IntegerToString(results[i].dev_reject.n) + ",";
      row += DoubleToString(results[i].dev_reject.StopPct(),  2) + ",";
      row += DoubleToString(results[i].dev_reject.Step4Pct(), 2) + ",";
      row += DoubleToString(results[i].dev_reject.AvgProfit(),2) + ",";
      row += DoubleToString(results[i].dev_reject.PF(),       3) + ",";
      row += DoubleToString(results[i].dev_reject.WinRate(),  2) + ",";
      row += DoubleToString(dev_cov,   2) + ",";
      row += DoubleToString(dev_d_stp, 2) + ",";
      row += DoubleToString(dev_d_4p,  2) + ",";
      row += DoubleToString(dev_d_avg, 2) + ",";
      row += DoubleToString(dev_d_pf,  3) + ",";
      row += DoubleToString(dev_d_exp, 2) + ",";
      row += IntegerToString(results[i].oos_base.n) + ",";
      row += DoubleToString(results[i].oos_base.StopPct(),    2) + ",";
      row += DoubleToString(results[i].oos_base.Step4Pct(),   2) + ",";
      row += DoubleToString(results[i].oos_base.AvgProfit(),  2) + ",";
      row += DoubleToString(results[i].oos_base.PF(),         3) + ",";
      row += DoubleToString(results[i].oos_base.WinRate(),    2) + ",";
      row += DoubleToString(results[i].oos_base.Expectancy(), 2) + ",";
      row += IntegerToString(results[i].oos_pass.n) + ",";
      row += DoubleToString(results[i].oos_pass.StopPct(),    2) + ",";
      row += DoubleToString(results[i].oos_pass.Step4Pct(),   2) + ",";
      row += DoubleToString(results[i].oos_pass.AvgProfit(),  2) + ",";
      row += DoubleToString(results[i].oos_pass.PF(),         3) + ",";
      row += DoubleToString(results[i].oos_pass.WinRate(),    2) + ",";
      row += DoubleToString(results[i].oos_pass.Expectancy(), 2) + ",";
      row += IntegerToString(results[i].oos_reject.n) + ",";
      row += DoubleToString(results[i].oos_reject.StopPct(),  2) + ",";
      row += DoubleToString(results[i].oos_reject.Step4Pct(), 2) + ",";
      row += DoubleToString(results[i].oos_reject.AvgProfit(),2) + ",";
      row += DoubleToString(results[i].oos_reject.PF(),       3) + ",";
      row += DoubleToString(results[i].oos_reject.WinRate(),  2) + ",";
      row += DoubleToString(oos_cov,   2) + ",";
      row += DoubleToString(oos_d_stp, 2) + ",";
      row += DoubleToString(oos_d_4p,  2) + ",";
      row += DoubleToString(oos_d_avg, 2) + ",";
      row += DoubleToString(oos_d_pf,  3) + ",";
      row += DoubleToString(oos_d_exp, 2) + ",";
      row += (oos_s_stop ? "YES" : "NO") + ",";
      row += (oos_s_pf   ? "YES" : "NO") + ",";
      row += (oos_s_exp  ? "YES" : "NO") + ",";
      row += DoubleToString(impact_dev, 4) + ",";
      row += DoubleToString(impact_oos, 4) + ",";
      row += (min_sample_ok ? "YES" : "NO") + ",";
      row += sq + ",";
      row += verdict + "\r\n";
      FileWriteString(h, row);
   }
   FileFlush(h);
   FileClose(h);
   Print("FilterImpact v2 exported: FilterImpact_", _Symbol,
         ".csv | Candidates=", cc);
}
void ExportSignalRegistryCSV()
{
   string fn = inp_recovery50_final_handoff_enabled
      ? "SignalRegistry_RECOVERY50_FINAL_HANDOFF_"+DIV3_AuditSafeToken(_Symbol)+"_"+EnumToString((ENUM_TIMEFRAMES)_Period)+".csv"
      : "SignalRegistry_" + _Symbol + ".csv";
   if(FileIsExist(fn, FILE_COMMON))
      FileDelete(fn, FILE_COMMON);
   int h = FileOpen(fn, FILE_WRITE | FILE_BIN | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      LogError("SignalRegistry: Cannot create file");
      return;
   }
   uchar bom[] = {0xEF, 0xBB, 0xBF};
   FileWriteArray(h, bom, 0, 3);
   FileClose(h);
   h = OpenTextUTF8(fn, FILE_READ | FILE_WRITE | FILE_TXT | FILE_SHARE_READ | FILE_COMMON );
   if(h == INVALID_HANDLE)
   {
      LogError("SignalRegistry: Cannot reopen file");
      return;
   }
   FileSeek(h, 0, SEEK_END);
   string hdr = "";
   hdr += "DatasetVersion,EAVersion,FeatureSetVersion,";
   hdr += "BuildDate,BuildTime,Broker,Symbol,Digits,Point,FeatureCount,";
   hdr += "BacktestStart,BacktestEnd,ModelMode,MainTF,SpreadMode,";
   hdr += "EventID,EventTime,Side,";
   hdr += "QC_Valid,QC_AllTF_Valid,QC_SpreadNormal,QC_IndicatorsOK,QC_NoFutureLeak,";
   hdr += "HasEMAData,HasRSIData,HasADXData,HasCCIData,";
   hdr += "HasMACDData,HasBBData,HasStochData,HasWilliamsData,";
   hdr += "EntryHour,EntryDay,EntryMonth,EntryWeekOfMonth,";
   hdr += "Session,Session_ID,IsLondon,IsNewYork,IsAsia,IsOverlap,";
   hdr += "MinFromSessionOpen,BarsSinceSignal,MinutesSinceSignal,";
   hdr += "Candle_Open,Candle_High,Candle_Low,Candle_Close,";
   hdr += "Candle_Range,Candle_Body,Candle_UpperWick,Candle_LowerWick,";
   hdr += "Signal_CLV,Signal_BodyRatio,Candle_ATR_Norm,";
   hdr += "Spread_Entry,Spread_ATR_Ratio,TickVolume,";
   hdr += "IsBullCandle,IsBearCandle,IsPinBar,IsLongBody,IsInsideBar,IsOutsideBar,";
   hdr += "Prev3_Bull_Count,Last5_Body_Avg,Last5_Range_Avg,Last5_ATR_Expansion,";
   hdr += "Pivot1_Dist,Pivot2_Dist,Pivot1_RSI,Pivot2_RSI,";
   hdr += "PivotGap_Min,PivotGap_Max,OB_DistPct,OB_InTol,";
   hdr += "Price_Div_Strength,RSI_Div_Strength,";
   hdr += "Div_Price_Slope,Div_RSI_Slope,Div_Span_Bars,";
   hdr += "Pivot_Symmetry,Time_Since_P3,";
   hdr += "Pivot_RSI_P1,Pivot_RSI_P2,Pivot_RSI_P3,";
   hdr += "Price_P1_P2_Chg,Price_P2_P3_Chg,Price_Leg_Ratio,";
   hdr += "RSI_P1_P2_Delta,RSI_P2_P3_Delta,RSI_Acceleration,Divergence_Angle,";
   hdr += "PivotGap12,PivotGap23,PivotGapRatio,";
   hdr += "PriceLeg12_ATR,PriceLeg23_ATR,";
   hdr += "ConfirmationAfterP3,RSIReclaimAfterP3,";
   hdr += "TickVolumeRatio20,TickVolumeZScore20,";
   hdr += "BarsSinceSwingHigh,BarsSinceSwingLow,";
   hdr += "DistanceToSwingHighATR,DistanceToSwingLowATR,";
   hdr += "SweptPriorHigh,SweptPriorLow,SweepDepthATR,CloseBackInsidePriorRange,SweepRejectionWickRatio,";
   hdr += "DistanceToPriorDayHighATR,DistanceToPriorDayLowATR,";
   hdr += "BreakOfStructureFlag,ChangeOfCharacterFlag,BarsSinceBOS,BarsSinceCHOCH,RangePositionLastN,";
   hdr += "BOSBreakDistanceATR,BarsBetweenSwingAndBOS,LastStructureEventType,StructureEventDirectionMatch,RangePositionSinceBOS,CHOCHBreakDistanceATR,";
   hdr += "OB_AgeBars,OB_Width_ATR,";
   string tfs[6] = {"M1","M5","M15","M30","H1","H4"};
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      string t = tfs[tf];
      hdr += "EMA20_" + t + ",";
      hdr += "EMA50_" + t + ",";
      hdr += "EMA100_" + t + ",";
      hdr += "EMA200_" + t + ",";
      hdr += "EMA200Dist_" + t + ",";
      hdr += "EMA200DistATR_" + t + ",";
