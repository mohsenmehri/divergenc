// --- UTF-8 text output ---------------------------------------------------
// MQL5 has no UTF-8 flag for text files. FILE_UNICODE (64) writes UTF-16LE and
// the old "#define FILE_UTF8 8" was in fact FILE_CSV, which produced files with
// a UTF-8 BOM and a UTF-16LE body. FILE_ANSI combined with the CP_UTF8 code
// page makes FileWriteString emit real UTF-8 bytes.
int OpenTextUTF8(const string filename,const int flags)
{
   return FileOpen(filename,flags|FILE_ANSI,0,CP_UTF8);
}
// Minimum depth every indicator-buffer refresh must request. CopyBuffer
// resizes the shared dynamic buffers, so a shallow refresh (10/20) silently
// truncates them and makes lookback reads (slopes, ATR regime) return nothing.
