void S2B_WriteStopFoldDiagnostics(int h, SCompactResult &res, string title)
{
   string sep = "----------------------------------------------------------------\n";
   FileWriteString(h, "\n[" + title + " — FOLD DIAGNOSTICS]\n" + sep);
   for(int f = 0; f < res.fold_count && f < S2B_MAX_FOLDS; f++)
   {
      FileWriteString(h, "Fold: " + res.fold_name[f] +
                         " | Primary=" + string(res.fold_is_primary[f] == 1 ? "YES" : "NO") +
                         " | Valid=" + string(res.fold_valid[f] == 1 ? "YES" : "NO") + "\n");
      FileWriteString(h, "  Train Window       : [" +
                         TimeToString(res.fold_train_from[f], TIME_DATE) + "," +
                         TimeToString(res.fold_train_to[f], TIME_DATE) + ")\n");
      FileWriteString(h, "  Validation Window  : [" +
                         TimeToString(res.fold_val_from[f], TIME_DATE) + "," +
                         TimeToString(res.fold_val_to[f], TIME_DATE) + ")\n");
      FileWriteString(h, StringFormat(
         "  Train N/Pos/Neg    : %d / %d / %d\n",
         res.fold_train_n[f], res.fold_train_pos[f], res.fold_train_neg[f]));
      FileWriteString(h, StringFormat(
         "  Validation N/Pos/Neg: %d / %d / %d\n",
         res.fold_val_n[f], res.fold_val_pos[f], res.fold_val_neg[f]));
      FileWriteString(h, StringFormat(
         "  Validation Prevalence: %.6f\n", res.fold_val_prevalence[f]));
      FileWriteString(h, "  LOW_POSITIVE_SAMPLE: " +
                         string(res.fold_low_positive_sample[f] == 1 ? "YES" : "NO") +
                         " (flag if TrainPos<10 or ValidationPos<5)\n");
      if(res.fold_valid[f] == 1)
      {
         FileWriteString(h, StringFormat("  Train AUC          : %.6f\n", res.fold_train_auc[f]));
         FileWriteString(h, StringFormat("  Validation AUC     : %.6f\n", res.fold_auc[f]));
         FileWriteString(h, StringFormat("  AUC Gap Train-Val  : %.6f\n", res.fold_auc_gap[f]));
         FileWriteString(h, StringFormat("  Validation PR-AUC  : %.6f\n", res.fold_prauc[f]));
         FileWriteString(h, StringFormat("  Validation PR Lift : %.6f\n", res.fold_pr_lift[f]));
         FileWriteString(h, StringFormat("  Precision          : %.6f\n", res.fold_precision[f]));
         FileWriteString(h, StringFormat("  Recall             : %.6f\n", res.fold_recall[f]));
         FileWriteString(h, StringFormat("  MCC                : %.6f\n", res.fold_mcc[f]));
         FileWriteString(h, StringFormat("  F2                 : %.6f\n", res.fold_f2[f]));
         FileWriteString(h, "  Coefficient Signs  : " + res.fold_coeff_signs[f] + "\n");
      }
      else
      {
         FileWriteString(h, "  Metrics            : INVALID_FOLD_INSUFFICIENT_SAMPLE_OR_TRAINING_FAILURE\n");
      }
      FileWriteString(h, sep);
   }
}
void S2B_ExportStopCandidateLock()
{
   string fn = "StopCandidateLock_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   FileWriteString(h, line);
   FileWriteString(h, "STOPFLAG PHASE A — DETERMINISTIC CANDIDATE LOCK\n");
   FileWriteString(h, "Symbol: " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "EvaluationContextHash: " + g_s2b_stop_context.evaluation_context_hash + "\n");
   FileWriteString(h, "TargetHash           : " + g_s2b_stop_context.target_hash + "\n");
   FileWriteString(h, "PoolHash             : " + g_s2b_stop_context.pool_hash + "\n");
   FileWriteString(h, "RowPolicyHash        : " + g_s2b_stop_context.row_policy_hash + "\n");
   FileWriteString(h, "RowMaskHash          : " + g_s2b_stop_context.row_mask_hash + "\n");
   FileWriteString(h, "SelectionPolicy      : AbsoluteGate > MaxWorstAUC > MinStdAUC > MaxMeanPRLift > FewerFeatures > MaxMeanAUC > FeatureHashAscending\n");
   FileWriteString(h, "DiagnosticMetricThreshold : 0.5\n");
   FileWriteString(h, "OperationalThresholdSelected : NO\n");
   if(g_s2b_stop_candidate_selected &&
      g_s2b_stop_selected_result_index >= 0 &&
      g_s2b_stop_selected_result_index < g_compact_stop_result_count)
   {
      SCompactResult selected = g_compact_stop_results[g_s2b_stop_selected_result_index];
      FileWriteString(h, "CandidateLock         : PASS\n");
      FileWriteString(h, "SelectedFeatureHash   : " + selected.feature_hash + "\n");
      FileWriteString(h, "SelectedFeatures      : " + selected.feat_names + "\n");
      FileWriteString(h, StringFormat("WorstFoldAUC         : %.6f\n", selected.wf_worst_auc));
      FileWriteString(h, StringFormat("WFStdAUC             : %.6f\n", selected.wf_std_auc));
      FileWriteString(h, StringFormat("MeanPRLift           : %.6f\n", selected.wf_mean_pr_lift));
      FileWriteString(h, "NFeatures             : " + IntegerToString(selected.n_feat) + "\n");
      FileWriteString(h, StringFormat("MeanAUC              : %.6f\n", selected.wf_mean_auc));
      FileWriteString(h, "AbsoluteGate          : PASS\n");
      FileWriteString(h, "RelativeGate          : PASS\n");
      FileWriteString(h, "RejectReason          : NONE\n");
      S2B_WriteStopFoldDiagnostics(h, selected, "SELECTED CANDIDATE");
   }
   else
   {
      FileWriteString(h, "CandidateLock         : FAIL\n");
      FileWriteString(h, "SelectedFeatureHash   : NONE\n");
      FileWriteString(h, "BlockReason           : " + g_s2b_stop_block_reason + "\n");
   }
   FileWriteString(h, "\n[PHASE A GUARDS]\n");
   FileWriteString(h, "2023 Status            : Historical Confirmation — Selection-aware validation, not blind OOS — NOT ACCESSED IN PHASE A\n");
   FileWriteString(h, "2024+ Status           : Reserved / Untouched true holdout\n");
   FileWriteString(h, "Threshold Selected     : NO\n");
   FileWriteString(h, "Winner Confirmation    : BLOCKED\n");
   FileWriteString(h, "Frozen Export          : BLOCKED\n");
   FileWriteString(h, "Stage 2C               : BLOCKED\n");
   FileWriteString(h, "Stage 2D               : BLOCKED\n");
   FileWriteString(h, line);
   FileFlush(h);
   FileClose(h);
   Print("STOP_CANDIDATE_LOCK_REPORT|", fn);
}
// ================================================================
// Cycle-aware baseline metrics (shared across Stage2B components)
// ================================================================
bool   g_s2b_baseline_wf_valid = false;
double g_s2b_baseline_wf_mean_auc = 0.0;
double g_s2b_baseline_wf_worst_auc = 0.0;
double g_s2b_baseline_wf_std_auc = 0.0;
double g_s2b_baseline_wf_mean_prauc = 0.0;
double g_s2b_baseline_wf_mean_mcc = 0.0;
double g_s2b_baseline_wf_mean_recall = 0.0;
double g_s2b_baseline_wf_mean_f2 = 0.0;
datetime S2B_YearStart(int year)
{
   return StringToTime(IntegerToString(year) + ".01.01");
}
int S2B_CollectUniqueYears(int &years[])
{
   ArrayResize(years, 0);
   for(int i = 0; i < g_risklab_count; i++)
   {
      MqlDateTime dt;
      TimeToStruct(g_risklab_records[i].entry_time, dt);
      bool found = false;
      for(int j = 0; j < ArraySize(years); j++)
      {
         if(years[j] == dt.year)
         {
            found = true;
            break;
         }
      }
      if(!found)
      {
         int n = ArraySize(years);
         ArrayResize(years, n + 1);
         years[n] = dt.year;
      }
   }
   // sort ascending
   int n = ArraySize(years);
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp = years[i];
         int j = i;
         while(j >= gap && years[j-gap] > tmp)
         {
            years[j] = years[j-gap];
            j -= gap;
         }
         years[j] = tmp;
      }
      gap /= 2;
   }
   return ArraySize(years);
}
void S2B_ExportFeatureRankStability()
{
   Print("=== Feature Rank Stability START ===");
   int core_feats[8] = {
      S2B_F_EMA200_DIST_M1, S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,   S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15,  S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,    S2B_F_OB_DIST_PCT
   };
   datetime train_from[3] = {
      StringToTime("2018.01.01"),
      StringToTime("2018.01.01"),
      StringToTime("2018.01.01")
   };
   datetime train_to[3] = {
      StringToTime("2019.01.01"),
      StringToTime("2020.01.01"),
      StringToTime("2020.07.01")
   };
   double fold_weights[3][8];
   bool   fold_valid[3];
   for(int f = 0; f < 3; f++)
   {
      fold_valid[f] = false;
      for(int k = 0; k < 8; k++)
         fold_weights[f][k] = 0.0;
      SStage2B_ModelParams fm = S2B_TrainOnSubset(
         "Step4", core_feats, 8,
         train_from[f], train_to[f],
         4000, 0.05, 0.01);
      if(!fm.trained) continue;
      fold_valid[f] = true;
      for(int k = 0; k < 8; k++)
         fold_weights[f][k] = fm.weights[k];
   }
   ArrayResize(g_feat_rank_stability, 8);
   for(int k = 0; k < 8; k++)
   {
      g_feat_rank_stability[k].feature_name = S2B_FeatureName(core_feats[k]);
      double sum_abs = 0.0, sum_sq = 0.0;
      int vcnt = 0;
      for(int f = 0; f < 3; f++)
      {
         if(!fold_valid[f])
         {
            g_feat_rank_stability[k].weight_abs[f] = 0.0;
            g_feat_rank_stability[k].rank[f] = -1;
            continue;
         }
         double wa = MathAbs(fold_weights[f][k]);
         g_feat_rank_stability[k].weight_abs[f] = wa;
         sum_abs += wa;
         sum_sq  += wa * wa;
         vcnt++;
      }
      g_feat_rank_stability[k].mean_weight_abs = (vcnt > 0) ? (sum_abs / vcnt) : 0.0;
      double var = (vcnt > 1) ? (sum_sq / vcnt - MathPow(g_feat_rank_stability[k].mean_weight_abs, 2)) : 0.0;
      g_feat_rank_stability[k].std_weight_abs = (var > 1e-12) ? MathSqrt(var) : 0.0;
   }
   // ranks per fold
   for(int f = 0; f < 3; f++)
   {
      if(!fold_valid[f]) continue;
      int order[8];
      for(int k = 0; k < 8; k++) order[k] = k;
      int gap = 8 / 2;
      while(gap > 0)
      {
         for(int i = gap; i < 8; i++)
         {
            int tmp = order[i];
            int j = i;
            while(j >= gap &&
                  g_feat_rank_stability[order[j-gap]].weight_abs[f] < g_feat_rank_stability[tmp].weight_abs[f])
            {
               order[j] = order[j-gap];
               j -= gap;
            }
            order[j] = tmp;
         }
         gap /= 2;
      }
      for(int r = 0; r < 8; r++)
         g_feat_rank_stability[order[r]].rank[f] = r + 1;
   }
   for(int k = 0; k < 8; k++)
   {
      double rsum = 0.0, rsq = 0.0;
      int rcnt = 0;
      for(int f = 0; f < 3; f++)
      {
         if(g_feat_rank_stability[k].rank[f] < 0) continue;
         rsum += g_feat_rank_stability[k].rank[f];
         rsq  += MathPow(g_feat_rank_stability[k].rank[f], 2);
         rcnt++;
      }
      g_feat_rank_stability[k].mean_rank = (rcnt > 0) ? (rsum / rcnt) : 9.0;
      double rv = (rcnt > 1) ? (rsq / rcnt - MathPow(g_feat_rank_stability[k].mean_rank, 2)) : 0.0;
      g_feat_rank_stability[k].std_rank = (rv > 1e-12) ? MathSqrt(rv) : 0.0;
      double mean_abs = g_feat_rank_stability[k].mean_weight_abs;
      double std_abs  = g_feat_rank_stability[k].std_weight_abs;
      double cv = (mean_abs > 0.02) ? (std_abs / mean_abs) : -1.0;
      bool sign_stable = true;
      bool first_set = false;
      bool first_positive = false;
      for(int f = 0; f < 3; f++)
      {
         if(!fold_valid[f]) continue;
         bool is_pos = (fold_weights[f][k] >= 0.0);
         if(!first_set)
         {
            first_positive = is_pos;
            first_set = true;
         }
         else if(is_pos != first_positive)
         {
            sign_stable = false;
            break;
         }
      }
      if(!sign_stable) g_feat_rank_stability[k].stability = "SIGN_FLIP";
      else if(mean_abs < 0.02) g_feat_rank_stability[k].stability = "NEAR_ZERO";
      else if(cv < 0.25) g_feat_rank_stability[k].stability = "VERY_STABLE";
      else if(cv < 0.50) g_feat_rank_stability[k].stability = "STABLE";
      else if(cv < 1.00) g_feat_rank_stability[k].stability = "MODERATE";
      else g_feat_rank_stability[k].stability = "UNSTABLE";
   }
   int idx_sort[8];
   for(int k = 0; k < 8; k++) idx_sort[k] = k;
   int gap2 = 8 / 2;
   while(gap2 > 0)
   {
      for(int i = gap2; i < 8; i++)
      {
         int tmp = idx_sort[i];
         int j = i;
         while(j >= gap2 &&
               g_feat_rank_stability[idx_sort[j-gap2]].mean_rank > g_feat_rank_stability[tmp].mean_rank)
         {
            idx_sort[j] = idx_sort[j-gap2];
            j -= gap2;
         }
         idx_sort[j] = tmp;
      }
      gap2 /= 2;
   }
   string fn = "Stage2B_FeatureRankStability_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("ERROR: Cannot create rank stability report");
      return;
   }
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "FEATURE RANK STABILITY — Step4 Baseline\n");
   FileWriteString(h, "Symbol: " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, StringFormat(
      "\n  %-25s  %8s  %8s  %8s  %8s  %8s  %10s  %8s  %12s\n",
      "Feature", "Fold1|W|", "Fold2|W|", "Fold3|W|", "Mean|W|", "Std|W|", "MeanRank", "StdRank", "Stability"));
   FileWriteString(h, sep);
   for(int i = 0; i < 8; i++)
   {
      int k = idx_sort[i];
      FileWriteString(h, StringFormat(
         "  %-25s  %8.4f  %8.4f  %8.4f  %8.4f  %8.4f  %10.2f  %8.2f  %12s\n",
         g_feat_rank_stability[k].feature_name,
         g_feat_rank_stability[k].weight_abs[0],
         g_feat_rank_stability[k].weight_abs[1],
         g_feat_rank_stability[k].weight_abs[2],
         g_feat_rank_stability[k].mean_weight_abs,
         g_feat_rank_stability[k].std_weight_abs,
         g_feat_rank_stability[k].mean_rank,
         g_feat_rank_stability[k].std_rank,
         g_feat_rank_stability[k].stability));
   }
   FileWriteString(h, "\n[RANK TABLE]\n" + sep);
   FileWriteString(h, StringFormat(
      "  %-25s  %6s  %6s  %6s  %10s  %8s\n",
      "Feature", "Fold1", "Fold2", "Fold3", "MeanRank", "StdRank"));
   FileWriteString(h, sep);
   for(int i = 0; i < 8; i++)
   {
      int k = idx_sort[i];
      string r1 = (g_feat_rank_stability[k].rank[0] > 0) ? IntegerToString(g_feat_rank_stability[k].rank[0]) : "N/A";
      string r2 = (g_feat_rank_stability[k].rank[1] > 0) ? IntegerToString(g_feat_rank_stability[k].rank[1]) : "N/A";
      string r3 = (g_feat_rank_stability[k].rank[2] > 0) ? IntegerToString(g_feat_rank_stability[k].rank[2]) : "N/A";
      FileWriteString(h, StringFormat(
         "  %-25s  %6s  %6s  %6s  %10.2f  %8.2f\n",
         g_feat_rank_stability[k].feature_name,
         r1, r2, r3,
         g_feat_rank_stability[k].mean_rank,
         g_feat_rank_stability[k].std_rank));
   }
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Feature Rank Stability: ", fn);
   Print("=== Feature Rank Stability DONE ===");
}
//================================================================
// Stage 2B Alignment Status — Formal
//================================================================
#define S2B_ALIGN_PROTOCOL_FOLD   "PASS"
#define S2B_ALIGN_BASELINE_EVAL   "PASS"
#define S2B_ALIGN_CROSS_COMPONENT "NOT_YET_VERIFIED"
struct SS2BExclusionBreakdown
{
   int outside_protocol;
   int invalid_maxstep;
   int missing_feature[S2B_COMPACT_POOL_SIZE];
   int missing_feature_total;
   int no_entry_time;
   int total_excluded;
   int total_eligible;
   int eligible_dev;
   int eligible_oos;
   string scope;
   void Reset()
   {
      outside_protocol = 0;
      invalid_maxstep = 0;
      missing_feature_total = 0;
      no_entry_time = 0;
      total_excluded = 0;
      total_eligible = 0;
      eligible_dev = 0;
      eligible_oos = 0;
      scope = "DEV+OOS";
      for(int i = 0; i < S2B_COMPACT_POOL_SIZE; i++)
         missing_feature[i] = 0;
   }
};
SS2BExclusionBreakdown g_s2b_exclusion;
bool S2B_IsCompactPoolFeature(int feat_idx)
{
   for(int i = 0; i < S2B_COMPACT_POOL_SIZE; i++)
   {
      if(g_s2b_protocol.compact_pool_feature_idx[i] == feat_idx)
         return true;
   }
   return false;
}
void S2B_FillStopCompactPoolFeatures(int &pool_feats[])
{
   ArrayResize(pool_feats, 8);
   pool_feats[0] = S2B_F_ATR_M5;
   pool_feats[1] = S2B_F_DIV_PRICE_SLOPE;
   pool_feats[2] = S2B_F_ATR_REGIME_M5;
   pool_feats[3] = S2B_F_PRICE_DIV_STRENGTH;
   pool_feats[4] = S2B_F_TICKVOL_RATIO20;
   pool_feats[5] = S2B_F_TICKVOL_Z20;
   pool_feats[6] = S2B_F_DIST_PRIOR_DAY_HIGH_ATR;
   pool_feats[7] = S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE;
}
bool S2B_IsStopCompactPoolFeature(int feat_idx)
{
   int pf[];
   S2B_FillStopCompactPoolFeatures(pf);
   for(int i = 0; i < ArraySize(pf); i++)
   {
      if(pf[i] == feat_idx)
      {
         ArrayFree(pf);
         return true;
      }
   }
   ArrayFree(pf);
   return false;
}
string S2B_BuildStopPoolHash(int &pool_feats[], int n_feat)
{
   string key = "STOP_POOL|N=" + IntegerToString(n_feat) + "|";
   for(int i = 0; i < n_feat; i++)
      key += IntegerToString(i) + "=" + S2B_FeatureName(pool_feats[i]) + "|";
   return S2B_HashToString(S2B_HashString32(key));
}
string S2B_BuildStopRowMaskHash(int &eligible_rows[], int n)
{
   string key = "STOP_ROWMASK_DEV_ONLY|N=" + IntegerToString(n) + "|";
   for(int i = 0; i < n; i++)
   {
      int ri = eligible_rows[i];
      if(ri < 0 || ri >= g_risklab_count) continue;
      key += IntegerToString(g_risklab_records[ri].setup_id) + "@";
      key += S2B_TimeKey(g_risklab_records[ri].entry_time) + "@";
      key += IntegerToString(g_risklab_records[ri].stop_flag ? 1 : 0) + "|";
   }
   return S2B_HashToString(S2B_HashString32(key));
}
bool S2B_IsStopOutcomeComplete(int rec_idx, string &why)
{
   why = "";
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
   {
      why = "REC_IDX_OOB";
      return false;
   }
   SRiskLabRecord rec = g_risklab_records[rec_idx];
   if(rec.entry_time <= 0)
   {
      why = "NO_ENTRY_TIME";
      return false;
   }
   if(rec.max_step_reached < 1 || rec.max_step_reached > 5)
   {
      why = "MAXSTEP_OUT_OF_RANGE";
      return false;
   }
   if(StringLen(rec.final_event) <= 0)
   {
      why = "OUTCOME_NOT_FINALIZED";
      return false;
   }
   return true;
}
bool S2B_RowEligible_StopPool(int rec_idx, string &why)
{
   why = "";
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
   {
      why = "REC_IDX_OOB";
      return false;
   }
   SRiskLabRecord rec = g_risklab_records[rec_idx];
   if(rec.entry_time <= 0)
   {
      why = "NO_ENTRY_TIME";
      g_s2b_stop_context.excluded_no_entry_time++;
      return false;
   }
   if(!S2B_IsInRange(rec.entry_time,
                     g_s2b_stop_context.development_from,
                     g_s2b_stop_context.development_to))
   {
      why = "OUTSIDE_STOP_DEV_WINDOW";
      g_s2b_stop_context.excluded_outside_dev++;
      return false;
   }
   string outcome_why = "";
   if(!S2B_IsStopOutcomeComplete(rec_idx, outcome_why))
   {
      why = outcome_why;
      if(outcome_why == "MAXSTEP_OUT_OF_RANGE")
         g_s2b_stop_context.excluded_invalid_maxstep++;
      else
         g_s2b_stop_context.excluded_incomplete_outcome++;
      return false;
   }
   for(int k = 0; k < g_s2b_stop_context.pool_feature_count; k++)
   {
      double v = 0.0;
      int feat_idx = g_s2b_stop_context.pool_feature_idx[k];
      if(!S2B_GetFeatureValue(rec_idx, feat_idx, v))
      {
         why = "MISSING_" + S2B_FeatureName(feat_idx);
         g_s2b_stop_context.excluded_missing_feature[k]++;
         g_s2b_stop_context.excluded_missing_feature_total++;
         return false;
      }
   }
   return true;
}
bool S2B_InitStopEvaluationContext()
{
   g_s2b_stop_context.Reset();
   g_s2b_stop_selected_result_index = -1;
   if(!S2B_EnsureProtocolAndFoldsReady())
   {
      g_s2b_stop_context.invalid_reason = "SHARED_PROTOCOL_OR_FOLDS_NOT_READY";
      return false;
   }
   g_s2b_stop_context.development_from = g_s2b_protocol.development_from;
   g_s2b_stop_context.development_to = g_s2b_protocol.development_to;
   g_s2b_stop_context.historical_confirmation_from = g_s2b_protocol.oos_from;
   g_s2b_stop_context.historical_confirmation_to = g_s2b_protocol.oos_to;
   g_s2b_stop_context.shared_protocol_hash = g_s2b_protocol.protocol_hash;
   g_s2b_stop_context.fold_hash = g_s2b_protocol.fold_hash;
   g_s2b_stop_context.dataset_hash = g_s2b_protocol.dataset_hash;
   int pool_feats[];
   S2B_FillStopCompactPoolFeatures(pool_feats);
   g_s2b_stop_context.pool_feature_count = ArraySize(pool_feats);
   for(int k = 0; k < g_s2b_stop_context.pool_feature_count && k < S2B_COMPACT_POOL_SIZE; k++)
      g_s2b_stop_context.pool_feature_idx[k] = pool_feats[k];
   g_s2b_stop_context.target_hash = S2B_HashToString(S2B_HashString32(
      "TARGET|NAME=StopFlag|DEF=rec.stop_flag == true|POSITIVE=1"));
   g_s2b_stop_context.pool_hash = S2B_BuildStopPoolHash(
      pool_feats, g_s2b_stop_context.pool_feature_count);
   g_s2b_stop_context.row_policy_hash = S2B_HashToString(S2B_HashString32(
      "ROW_POLICY|" + g_s2b_stop_context.valid_row_policy +
      "|OUTCOME=final_event_nonempty|max_step_1_5" +
      "|WINDOW=DEV_ONLY"));
   ArrayResize(g_s2b_stop_context.row_mask_flags, g_risklab_count);
   ArrayInitialize(g_s2b_stop_context.row_mask_flags, 0);
   ArrayResize(g_s2b_stop_context.eligible_record_indices, g_risklab_count);
   int eligible = 0;
   int excluded_in_dev = 0;
   int positive = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      datetime t = g_risklab_records[r].entry_time;
      if(!S2B_IsInRange(t,
                        g_s2b_stop_context.development_from,
                        g_s2b_stop_context.development_to))
      {
         g_s2b_stop_context.excluded_outside_dev++;
         continue;
      }
      string why = "";
      if(S2B_RowEligible_StopPool(r, why))
      {
         g_s2b_stop_context.row_mask_flags[r] = 1;
         g_s2b_stop_context.eligible_record_indices[eligible++] = r;
         if(g_risklab_records[r].stop_flag) positive++;
      }
      else
      {
         excluded_in_dev++;
      }
   }
   ArrayResize(g_s2b_stop_context.eligible_record_indices, eligible);
   g_s2b_stop_context.eligible_count = eligible;
   g_s2b_stop_context.excluded_count = excluded_in_dev;
   g_s2b_stop_context.positive_count = positive;
   g_s2b_stop_context.negative_count = eligible - positive;
   g_s2b_stop_context.row_mask_hash = S2B_BuildStopRowMaskHash(
      g_s2b_stop_context.eligible_record_indices, eligible);
   string context_key = "STOP_EVAL_CONTEXT|";
   context_key += "EVAL=" + g_s2b_stop_context.evaluator_version + "|";
   context_key += "SHARED_PROTOCOL=" + g_s2b_stop_context.shared_protocol_hash + "|";
   context_key += "FOLD=" + g_s2b_stop_context.fold_hash + "|";
   context_key += "DATASET=" + g_s2b_stop_context.dataset_hash + "|";
   context_key += "DEV_FROM=" + S2B_TimeKey(g_s2b_stop_context.development_from) + "|";
   context_key += "DEV_TO=" + S2B_TimeKey(g_s2b_stop_context.development_to) + "|";
   context_key += "TARGET=" + g_s2b_stop_context.target_hash + "|";
   context_key += "POOL=" + g_s2b_stop_context.pool_hash + "|";
   context_key += "ROW_POLICY=" + g_s2b_stop_context.row_policy_hash + "|";
   context_key += "ROW_MASK=" + g_s2b_stop_context.row_mask_hash + "|";
   context_key += "ELIGIBLE=" + IntegerToString(eligible) + "|";
   context_key += "EXCLUDED=" + IntegerToString(excluded_in_dev);
   g_s2b_stop_context.evaluation_context_hash =
      S2B_HashToString(S2B_HashString32(context_key));
   ArrayFree(pool_feats);
   if(eligible < g_s2b_protocol.min_train_n)
   {
      g_s2b_stop_context.invalid_reason = "TOO_FEW_STOP_DEV_ROWS";
      return false;
   }
   if(positive < 5 || g_s2b_stop_context.negative_count < 5)
   {
      g_s2b_stop_context.invalid_reason = "INSUFFICIENT_STOP_TARGET_CLASSES";
      return false;
   }
   g_s2b_stop_context.valid = true;
   g_s2b_stop_context.invalid_reason = "";
   Print("STOP_CONTEXT|PASS",
         "|EvaluationContextHash=", g_s2b_stop_context.evaluation_context_hash,
         "|TargetHash=", g_s2b_stop_context.target_hash,
         "|PoolHash=", g_s2b_stop_context.pool_hash,
         "|RowPolicyHash=", g_s2b_stop_context.row_policy_hash,
         "|RowMaskHash=", g_s2b_stop_context.row_mask_hash,
         "|Eligible=", g_s2b_stop_context.eligible_count,
         "|Excluded=", g_s2b_stop_context.excluded_count,
         "|Pos=", g_s2b_stop_context.positive_count,
         "|HistoricalConfirmationUsed=NO",
         "|ThresholdSelected=NO");
   return true;
}
int S2B_CollectStopMaskedRows(datetime from_t, datetime to_t, int &out_rows[])
{
   ArrayResize(out_rows, 0);
   if(!g_s2b_stop_context.valid)
      return 0;
   if(ArraySize(g_s2b_stop_context.row_mask_flags) != g_risklab_count)
      return 0;
   ArrayResize(out_rows, g_s2b_stop_context.eligible_count);
   int count = 0;
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_s2b_stop_context.row_mask_flags[r] != 1) continue;
      datetime t = g_risklab_records[r].entry_time;
      if(t < from_t || t >= to_t) continue;
      out_rows[count++] = r;
   }
   ArrayResize(out_rows, count);
   return count;
}
int S2B_GetStopTargetAligned(int rec_idx)
{
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
      return 0;
   return (g_risklab_records[rec_idx].stop_flag ? 1 : 0);
}
bool S2B_EnsureProtocolAndFoldsReady()
{
   bool need_protocol = false;
   if(ArraySize(g_s2b_protocol.row_mask_flags) != g_risklab_count)
      need_protocol = true;
   if(g_s2b_protocol.eligible_count <= 0)
      need_protocol = true;
   if(g_s2b_protocol.dev_from <= 0 || g_s2b_protocol.dev_to <= 0 ||
      g_s2b_protocol.oos_from <= 0 || g_s2b_protocol.oos_to <= 0)
      need_protocol = true;
   if(need_protocol)
   {
      if(!S2B_InitProtocol())
         return false;
   }
   if(g_s2b_fold_count <= 0)
   {
      if(!S2B_BuildFolds(g_s2b_protocol))
         return false;
   }
   return true;
}
int S2B_GetStep4TargetAligned(int rec_idx)
{
   if(rec_idx < 0 || rec_idx >= g_risklab_count)
      return 0;
   // Target definition fixed by protocol:
   // Positive = actual_max_step >= 4
   return (g_risklab_records[rec_idx].max_step_reached >= 4 ? 1 : 0);
}
int S2B_CollectProtocolMaskedRows(datetime from_t, datetime to_t, int &out_rows[])
{
   ArrayResize(out_rows, 0);
   if(ArraySize(g_s2b_protocol.row_mask_flags) != g_risklab_count)
      return 0;
   int cnt = 0;
   ArrayResize(out_rows, g_risklab_count);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(g_s2b_protocol.row_mask_flags[r] != 1)
         continue;
      datetime t = g_risklab_records[r].entry_time;
      if(t < from_t || t >= to_t)
         continue;
      out_rows[cnt++] = r;
   }
   ArrayResize(out_rows, cnt);
   return cnt;
}
double S2B_CalcPRAUCFromPreds(double &preds[], int &targets[], int n)
{
   if(n < 10) return 0.0;
   int total_pos = 0;
   for(int i = 0; i < n; i++)
      if(targets[i] == 1) total_pos++;
   if(total_pos <= 0) return 0.0;
   int idx[];
   ArrayResize(idx, n);
   for(int i = 0; i < n; i++) idx[i] = i;
   // sort descending by prediction
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         int tmp = idx[i];
         int j = i;
         while(j >= gap && preds[idx[j-gap]] < preds[tmp])
         {
            idx[j] = idx[j-gap];
            j -= gap;
         }
         idx[j] = tmp;
      }
      gap /= 2;
   }
   double ap = 0.0;
   int tp_so_far = 0;
   double prev_recall = 0.0;
   for(int i = 0; i < n; i++)
   {
      if(targets[idx[i]] == 1)
      {
         tp_so_far++;
         double precision_i = (double)tp_so_far / (i + 1);
         double recall_i    = (double)tp_so_far / total_pos;
         ap += precision_i * (recall_i - prev_recall);
         prev_recall = recall_i;
      }
   }
   ArrayFree(idx);
   return ap;
}
bool S2B_TrainLogistic_OnRows(int &feat_indices[], int n_feat,
                              int &train_rows[], int train_count,
                              SStage2B_ModelParams &mdl,
                              int epochs = 4000,
                              double lr = 0.05,
                              double lambda = 0.01)
{
   mdl.Reset();
   mdl.model_name  = "S2B_ROWSET_TEMP";
   mdl.target_name = "Step4";
   mdl.n_features  = n_feat;
   for(int k = 0; k < n_feat; k++)
      mdl.feature_idx[k] = feat_indices[k];
   if(train_count < 20)
      return false;
   double rawX[];
   int Y[];
   ArrayResize(rawX, train_count * n_feat);
   ArrayResize(Y, train_count);
   double sums[];
   double sumsq[];
   ArrayResize(sums, n_feat);
   ArrayResize(sumsq, n_feat);
   ArrayInitialize(sums, 0.0);
   ArrayInitialize(sumsq, 0.0);
   int pos_cnt = 0;
   int neg_cnt = 0;
   for(int i = 0; i < train_count; i++)
   {
      int rec_idx = train_rows[i];
      if(rec_idx < 0 || rec_idx >= g_risklab_count)
      {
         ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
         return false;
      }
      for(int k = 0; k < n_feat; k++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
         {
            // This should never happen because row mask is common-pool strict
            ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
            Print("S2B_TrainLogistic_OnRows: row mask violation on rec=", rec_idx,
                  " feat=", S2B_FeatureName(feat_indices[k]));
            return false;
         }
         rawX[i * n_feat + k] = v;
         sums[k] += v;
         sumsq[k] += v * v;
      }
      int y = S2B_GetStep4TargetAligned(rec_idx);
      Y[i] = y;
      if(y == 1) pos_cnt++;
      else       neg_cnt++;
   }
   mdl.n_dev = train_count;
   mdl.n_pos_dev = pos_cnt;
   if(pos_cnt < 5 || neg_cnt < 5)
   {
      ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
      return false;
   }
   for(int k = 0; k < n_feat; k++)
   {
      double mean = sums[k] / train_count;
      double var  = sumsq[k] / train_count - mean * mean;
      mdl.feat_mean[k] = mean;
      mdl.feat_std[k]  = (var > 1e-12 ? MathSqrt(var) : 1.0);
   }
   ArrayFree(sums);
   ArrayFree(sumsq);
   double X[];
   ArrayResize(X, train_count * n_feat);
   for(int i = 0; i < train_count; i++)
   {
      for(int k = 0; k < n_feat; k++)
      {
         double s = mdl.feat_std[k];
         if(s < 1e-10) s = 1.0;
         X[i * n_feat + k] = (rawX[i * n_feat + k] - mdl.feat_mean[k]) / s;
      }
   }
   double w_pos = MathMin(20.0, (double)neg_cnt / MathMax(1, pos_cnt));
   double w_neg = 1.0;
   mdl.intercept = 0.0;
   for(int k = 0; k < n_feat; k++)
      mdl.weights[k] = 0.0;
   double cur_lr = lr;
   for(int ep = 0; ep < epochs; ep++)
   {
      double g0 = 0.0;
      double gw[];
      ArrayResize(gw, n_feat);
      ArrayInitialize(gw, 0.0);
      for(int i = 0; i < train_count; i++)
      {
         double z = mdl.intercept;
         for(int k = 0; k < n_feat; k++)
            z += mdl.weights[k] * X[i * n_feat + k];
         double pred = S2B_Sigmoid(z);
         double err  = pred - Y[i];
         double cw   = (Y[i] == 1 ? w_pos : w_neg);
         err *= cw;
         g0 += err;
         for(int k = 0; k < n_feat; k++)
            gw[k] += err * X[i * n_feat + k];
      }
      double inv_n = cur_lr / train_count;
      mdl.intercept -= inv_n * g0;
      for(int k = 0; k < n_feat; k++)
         mdl.weights[k] -= inv_n * (gw[k] + lambda * mdl.weights[k]);
      if(ep > 0 && ep % 1000 == 0)
         cur_lr *= 0.7;
      ArrayFree(gw);
   }
   double preds_tr[];
   int tgts_tr[];
   ArrayResize(preds_tr, train_count);
   ArrayResize(tgts_tr, train_count);
   for(int i = 0; i < train_count; i++)
   {
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
         z += mdl.weights[k] * X[i * n_feat + k];
      preds_tr[i] = S2B_Sigmoid(z);
      tgts_tr[i]  = Y[i];
   }
   mdl.dev_auc   = S2B_AUCFromPreds(preds_tr, tgts_tr, train_count);
   mdl.dev_brier = S2B_BrierScore(preds_tr, tgts_tr, train_count);
   mdl.best_threshold = S2B_BestThreshold(preds_tr, tgts_tr, train_count);
   mdl.trained = true;
   ArrayFree(rawX);
   ArrayFree(X);
   ArrayFree(Y);
   ArrayFree(preds_tr);
   ArrayFree(tgts_tr);
   return true;
}
string S2B_BuildCoeffSignString(SStage2B_ModelParams &mdl)
{
   string s = "";
   for(int k = 0; k < mdl.n_features; k++)
   {
      if(k > 0) s += "|";
      if(mdl.weights[k] > 0.0)      s += "+";
      else if(mdl.weights[k] < 0.0) s += "-";
      else                          s += "0";
      s += S2B_FeatureName(mdl.feature_idx[k]);
   }
   return s;
}
bool S2B_EvalModel_OnRows(SStage2B_ModelParams &mdl,
                          int &eval_rows[], int eval_count,
                          double &out_auc,
                          double &out_prauc,
                          double &out_mcc,
                          double &out_prec,
                          double &out_rec,
                          double &out_f2,
                          int &out_n,
                          int &out_n_pos,
                          double &out_mean_score_pos,
                          double &out_mean_score_neg)
{
   out_auc   = 0.5;
   out_prauc = 0.0;
   out_mcc   = 0.0;
   out_prec  = 0.0;
   out_rec   = 0.0;
   out_f2    = 0.0;
   out_n     = 0;
   out_n_pos = 0;
   out_mean_score_pos = 0.0;
   out_mean_score_neg = 0.0;
   if(!mdl.trained || eval_count < 10)
      return false;
   int n_feat = mdl.n_features;
   double preds[];
   int tgts[];
   ArrayResize(preds, eval_count);
   ArrayResize(tgts,  eval_count);
   double sum_pos = 0.0, sum_neg = 0.0;
   int cnt_pos = 0, cnt_neg = 0;
   for(int i = 0; i < eval_count; i++)
   {
      int rec_idx = eval_rows[i];
      if(rec_idx < 0 || rec_idx >= g_risklab_count)
      {
         ArrayFree(preds); ArrayFree(tgts);
         return false;
      }
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(rec_idx, mdl.feature_idx[k], v))
         {
            ArrayFree(preds); ArrayFree(tgts);
            Print("S2B_EvalModel_OnRows: row mask violation on rec=", rec_idx,
                  " feat=", S2B_FeatureName(mdl.feature_idx[k]));
            return false;
         }
         double s = mdl.feat_std[k];
         if(s < 1e-10) s = 1.0;
         double vn = (v - mdl.feat_mean[k]) / s;
         z += mdl.weights[k] * vn;
      }
      preds[out_n] = S2B_Sigmoid(z);
      tgts[out_n]  = S2B_GetStep4TargetAligned(rec_idx);
      if(tgts[out_n] == 1)
      {
         out_n_pos++;
         sum_pos += preds[out_n];
         cnt_pos++;
      }
      else
      {
         sum_neg += preds[out_n];
         cnt_neg++;
      }
      out_n++;
   }
   if(out_n < 10 || out_n_pos < 3)
   {
      ArrayFree(preds); ArrayFree(tgts);
      return false;
   }
   ArrayResize(preds, out_n);
   ArrayResize(tgts,  out_n);
   out_auc   = S2B_AUCFromPreds(preds, tgts, out_n);
   out_prauc = S2B_CalcPRAUCFromPreds(preds, tgts, out_n);
   out_mean_score_pos = (cnt_pos > 0 ? sum_pos / cnt_pos : 0.0);
   out_mean_score_neg = (cnt_neg > 0 ? sum_neg / cnt_neg : 0.0);
   double thr = mdl.best_threshold;
   int tp = 0, fp = 0, fn = 0, tn = 0;
   for(int i = 0; i < out_n; i++)
   {
      bool pred_pos = (preds[i] >= thr);
      bool act_pos  = (tgts[i] == 1);
      if(pred_pos && act_pos)  tp++;
      if(pred_pos && !act_pos) fp++;
      if(!pred_pos && act_pos) fn++;
      if(!pred_pos && !act_pos) tn++;
   }
   out_prec = (tp + fp > 0) ? (double)tp / (tp + fp) : 0.0;
   out_rec  = (tp + fn > 0) ? (double)tp / (tp + fn) : 0.0;
   out_f2   = (out_prec + out_rec > 0.0)
            ? (5.0 * out_prec * out_rec) / (4.0 * out_prec + out_rec)
            : 0.0;
   double mcc_den = MathSqrt((double)(tp + fp) * (tp + fn) * (tn + fp) * (tn + fn));
   out_mcc = (mcc_den > 1e-10) ? ((double)(tp * tn - fp * fn) / mcc_den) : 0.0;
   ArrayFree(preds);
   ArrayFree(tgts);
   return true;
}
bool S2B_TrainLogistic_OnRows_Stop(int &feat_indices[], int n_feat,
                                   int &train_rows[], int train_count,
                                   SStage2B_ModelParams &mdl,
                                   int epochs = 4000,
                                   double lr = 0.05,
                                   double lambda = 0.01)
{
   mdl.Reset();
   mdl.model_name  = "S2B_STOP_ROWSET_TEMP";
   mdl.target_name = "Stop";
   mdl.n_features  = n_feat;
   for(int k = 0; k < n_feat; k++)
      mdl.feature_idx[k] = feat_indices[k];
   if(train_count < 20)
      return false;
   double rawX[];
   int Y[];
   ArrayResize(rawX, train_count * n_feat);
   ArrayResize(Y, train_count);
   double sums[];
   double sumsq[];
   ArrayResize(sums, n_feat);
   ArrayResize(sumsq, n_feat);
   ArrayInitialize(sums, 0.0);
   ArrayInitialize(sumsq, 0.0);
   int pos_cnt = 0, neg_cnt = 0;
   for(int i = 0; i < train_count; i++)
   {
      int rec_idx = train_rows[i];
      if(rec_idx < 0 || rec_idx >= g_risklab_count)
      {
         ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
         return false;
      }
      for(int k = 0; k < n_feat; k++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
         {
            ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
            Print("S2B_TrainLogistic_OnRows_Stop: row mask violation on rec=", rec_idx,
                  " feat=", S2B_FeatureName(feat_indices[k]));
            return false;
         }
         rawX[i * n_feat + k] = v;
         sums[k] += v;
         sumsq[k] += v * v;
      }
      int y = S2B_GetStopTargetAligned(rec_idx);
      Y[i] = y;
      if(y == 1) pos_cnt++;
      else       neg_cnt++;
   }
   mdl.n_dev = train_count;
   mdl.n_pos_dev = pos_cnt;
   if(pos_cnt < 5 || neg_cnt < 5)
   {
      ArrayFree(rawX); ArrayFree(Y); ArrayFree(sums); ArrayFree(sumsq);
      return false;
   }
   for(int k = 0; k < n_feat; k++)
   {
      double mean = sums[k] / train_count;
      double var  = sumsq[k] / train_count - mean * mean;
      mdl.feat_mean[k] = mean;
      mdl.feat_std[k]  = (var > 1e-12 ? MathSqrt(var) : 1.0);
   }
   ArrayFree(sums);
   ArrayFree(sumsq);
   double X[];
   ArrayResize(X, train_count * n_feat);
   for(int i = 0; i < train_count; i++)
   {
      for(int k = 0; k < n_feat; k++)
      {
         double s = mdl.feat_std[k];
         if(s < 1e-10) s = 1.0;
         X[i * n_feat + k] = (rawX[i * n_feat + k] - mdl.feat_mean[k]) / s;
      }
   }
   double w_pos = MathMin(20.0, (double)neg_cnt / MathMax(1, pos_cnt));
   double w_neg = 1.0;
   mdl.intercept = 0.0;
   for(int k = 0; k < n_feat; k++)
      mdl.weights[k] = 0.0;
   double cur_lr = lr;
   for(int ep = 0; ep < epochs; ep++)
   {
      double g0 = 0.0;
      double gw[];
      ArrayResize(gw, n_feat);
      ArrayInitialize(gw, 0.0);
      for(int i = 0; i < train_count; i++)
      {
         double z = mdl.intercept;
         for(int k = 0; k < n_feat; k++)
            z += mdl.weights[k] * X[i * n_feat + k];
         double pred = S2B_Sigmoid(z);
         double err  = pred - Y[i];
         double cw   = (Y[i] == 1 ? w_pos : w_neg);
         err *= cw;
         g0 += err;
         for(int k = 0; k < n_feat; k++)
            gw[k] += err * X[i * n_feat + k];
      }
      double inv_n = cur_lr / train_count;
      mdl.intercept -= inv_n * g0;
      for(int k = 0; k < n_feat; k++)
         mdl.weights[k] -= inv_n * (gw[k] + lambda * mdl.weights[k]);
      if(ep > 0 && ep % 1000 == 0)
         cur_lr *= 0.7;
      ArrayFree(gw);
   }
   double preds_tr[];
   int tgts_tr[];
   ArrayResize(preds_tr, train_count);
   ArrayResize(tgts_tr, train_count);
   for(int i = 0; i < train_count; i++)
   {
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
         z += mdl.weights[k] * X[i * n_feat + k];
      preds_tr[i] = S2B_Sigmoid(z);
      tgts_tr[i]  = Y[i];
   }
   mdl.dev_auc   = S2B_AUCFromPreds(preds_tr, tgts_tr, train_count);
   mdl.dev_brier = S2B_BrierScore(preds_tr, tgts_tr, train_count);
   mdl.best_threshold = S2B_BestThreshold(preds_tr, tgts_tr, train_count);
   mdl.trained = true;
   ArrayFree(rawX);
   ArrayFree(X);
   ArrayFree(Y);
   ArrayFree(preds_tr);
   ArrayFree(tgts_tr);
   return true;
}
bool S2B_EvalModel_OnRows_Stop(SStage2B_ModelParams &mdl,
                               int &eval_rows[], int eval_count,
                               double &out_auc,
                               double &out_prauc,
                               double &out_mcc,
                               double &out_prec,
                               double &out_rec,
                               double &out_f2,
                               int &out_n,
                               int &out_n_pos,
                               double &out_mean_score_pos,
                               double &out_mean_score_neg)
{
   out_auc   = 0.5;
   out_prauc = 0.0;
   out_mcc   = 0.0;
   out_prec  = 0.0;
   out_rec   = 0.0;
   out_f2    = 0.0;
   out_n     = 0;
   out_n_pos = 0;
   out_mean_score_pos = 0.0;
   out_mean_score_neg = 0.0;
   if(!mdl.trained || eval_count < 10)
      return false;
   int n_feat = mdl.n_features;
   double preds[];
   int tgts[];
   ArrayResize(preds, eval_count);
   ArrayResize(tgts,  eval_count);
   double sum_pos = 0.0, sum_neg = 0.0;
   int cnt_pos = 0, cnt_neg = 0;
   for(int i = 0; i < eval_count; i++)
   {
      int rec_idx = eval_rows[i];
      if(rec_idx < 0 || rec_idx >= g_risklab_count)
      {
         ArrayFree(preds); ArrayFree(tgts);
         return false;
      }
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(rec_idx, mdl.feature_idx[k], v))
         {
            ArrayFree(preds); ArrayFree(tgts);
            Print("S2B_EvalModel_OnRows_Stop: row mask violation on rec=", rec_idx,
                  " feat=", S2B_FeatureName(mdl.feature_idx[k]));
            return false;
         }
         double s = mdl.feat_std[k];
         if(s < 1e-10) s = 1.0;
         double vn = (v - mdl.feat_mean[k]) / s;
         z += mdl.weights[k] * vn;
      }
      preds[out_n] = S2B_Sigmoid(z);
      tgts[out_n]  = S2B_GetStopTargetAligned(rec_idx);
      if(tgts[out_n] == 1)
      {
         out_n_pos++;
         sum_pos += preds[out_n];
         cnt_pos++;
      }
      else
      {
         sum_neg += preds[out_n];
         cnt_neg++;
      }
      out_n++;
   }
   if(out_n < 10 || out_n_pos < 3)
   {
      ArrayFree(preds); ArrayFree(tgts);
      return false;
   }
   ArrayResize(preds, out_n);
   ArrayResize(tgts,  out_n);
   out_auc   = S2B_AUCFromPreds(preds, tgts, out_n);
   out_prauc = S2B_CalcPRAUCFromPreds(preds, tgts, out_n);
   out_mean_score_pos = (cnt_pos > 0 ? sum_pos / cnt_pos : 0.0);
   out_mean_score_neg = (cnt_neg > 0 ? sum_neg / cnt_neg : 0.0);
   double thr = mdl.best_threshold;
   int tp = 0, fp = 0, fn = 0, tn = 0;
   for(int i = 0; i < out_n; i++)
   {
      bool pred_pos = (preds[i] >= thr);
      bool act_pos  = (tgts[i] == 1);
      if(pred_pos && act_pos)  tp++;
      if(pred_pos && !act_pos) fp++;
      if(!pred_pos && act_pos) fn++;
      if(!pred_pos && !act_pos) tn++;
   }
   out_prec = (tp + fp > 0) ? (double)tp / (tp + fp) : 0.0;
   out_rec  = (tp + fn > 0) ? (double)tp / (tp + fn) : 0.0;
   out_f2   = (out_prec + out_rec > 0.0)
            ? (5.0 * out_prec * out_rec) / (4.0 * out_prec + out_rec)
            : 0.0;
   double mcc_den = MathSqrt((double)(tp + fp) * (tp + fn) * (tn + fp) * (tn + fn));
   out_mcc = (mcc_den > 1e-10) ? ((double)(tp * tn - fp * fn) / mcc_den) : 0.0;
   ArrayFree(preds);
   ArrayFree(tgts);
   return true;
}
// ================================================================
// ================================================================
//  STAGE 2B - STOPFLAG PHASE B
//  DEV-only Out-of-Fold Threshold + Trade-off Analysis
//  Version: S2B_STOP_PHASEB_v1
//  Gate    : S2B_STOP_THRESHOLD_GATE_v1 (frozen before results)
//
//  Threshold scale decision (user-approved):
//    - Per-fold percentile rank  = PRIMARY basis for Gate + Selection
//    - Global pooled probability = INFORMATIONAL / sensitivity only
//    - Numeric probability threshold on full DEV is DEFERRED to a
//      separate later step, AFTER the rejection rate is locked.
//  Target Lost denominator decision (user-approved):
//    - TargetLost% = rejected target_flag / total target_flag in OOF
//    - Neutral rows excluded from denominator, reported as NeutralOutcomeN
//  Bootstrap decision (user-approved):
//    - Stratified per fold (Stop / Non-Stop resampled separately)
//    - Seed 20260808, 1000 iterations, 95% CI
// ================================================================
// ================================================================
void S2B_PhaseBSeedRng(uint s)
{
   if(s == 0) s = 1u;
   g_s2b_phaseb_rng_state = s;
}
uint S2B_PhaseBNextRng()
{
   g_s2b_phaseb_rng_state = g_s2b_phaseb_rng_state * 1664525u + 1013904223u;
   return g_s2b_phaseb_rng_state;
}
int S2B_PhaseBRandIndex(int n)
{
   if(n <= 0) return 0;
   return (int)(S2B_PhaseBNextRng() % (uint)n);
}
void S2B_PhaseBSortAsc(double &arr[], int n)
{
   for(int i = 1; i < n; i++)
   {
      double key = arr[i];
      int j = i - 1;
      while(j >= 0 && arr[j] > key)
      {
         arr[j + 1] = arr[j];
         j--;
      }
      arr[j + 1] = key;
   }
}
double S2B_PhaseBPercentile(double &sorted_arr[], int n, double p)
{
   if(n <= 0) return 0.0;
   if(n == 1) return sorted_arr[0];
   double pos = p * (double)(n - 1);
   int lo = (int)MathFloor(pos);
   int hi = (int)MathCeil(pos);
   if(lo < 0) lo = 0;
   if(hi > n - 1) hi = n - 1;
   double w = pos - (double)lo;
   return sorted_arr[lo] * (1.0 - w) + sorted_arr[hi] * w;
}
// Project-wide Profit Factor convention (identical to the existing
// convention used elsewhere in this EA), plus an explicit "defined" flag
// so the Phase B gate can FAIL on an undefined PF instead of silently
// comparing the sentinel value 99.0.
double S2B_PhaseBProfitFactor(double gross_profit, double gross_loss, int &out_defined)
{
   if(gross_loss < 0.0001)
   {
      out_defined = 0;
      return (gross_profit > 0.0 ? 99.0 : 0.0);
   }
   out_defined = 1;
   return gross_profit / gross_loss;
}
// ================================================================
// Locked Phase A candidate feature set.
// Order is enum-index ascending, which is exactly the order that
// produced FeatureHash 163854326 in the Phase A compact search.
// ================================================================
int S2B_ResolveLockedStopFeatures(int &feat_idx[])
{
   ArrayResize(feat_idx, S2B_STOP_LOCKED_FEATURE_COUNT);
   feat_idx[0] = S2B_F_ATR_M5;
   feat_idx[1] = S2B_F_DIV_PRICE_SLOPE;
   feat_idx[2] = S2B_F_PRICE_DIV_STRENGTH;
   feat_idx[3] = S2B_F_TICKVOL_Z20;
   feat_idx[4] = S2B_F_CLOSE_BACK_INSIDE_PRIOR_RANGE;
   return S2B_STOP_LOCKED_FEATURE_COUNT;
}
string S2B_PhaseBMatchText(bool matched)
{
   return (matched ? "MATCH" : "MISMATCH");
}
void S2B_PhaseBAddMismatch(string field_name)
{
   if(g_s2b_phaseb_guard_mismatches != "")
      g_s2b_phaseb_guard_mismatches += "|";
   g_s2b_phaseb_guard_mismatches += field_name;
}
// Stage 1 of the canonical lock guard. This executes before any OOF
// model is trained or scored. It validates context identity and the
// exact locked candidate hash, feature count and ordered feature list.
bool S2B_PhaseBPreOOFContextLockGuard()
{
   g_s2b_phaseb_pre_oof_guard_pass = false;
   g_s2b_phaseb_post_oof_guard_pass = false;
   g_s2b_phaseb_context_lock_pass = false;
   g_s2b_phaseb_threshold_engine_executed = false;
   g_s2b_phaseb_guard_mismatches = "";
   g_s2b_phaseb_actual_oof_n = 0;
   g_s2b_phaseb_actual_oof_stop_n = 0;
   int feat_idx[];
   g_s2b_phaseb_actual_feature_count = S2B_ResolveLockedStopFeatures(feat_idx);
   g_s2b_phaseb_actual_feature_list = S2B_BuildFeatureListString(feat_idx, g_s2b_phaseb_actual_feature_count);
   g_s2b_phaseb_actual_candidate_hash = S2B_BuildFeatureHash(feat_idx, g_s2b_phaseb_actual_feature_count);
   if(g_s2b_stop_context.shared_protocol_hash != S2B_PHASEB_EXPECT_PROTOCOL_HASH) S2B_PhaseBAddMismatch("SharedProtocolHash");
   if(g_s2b_stop_context.fold_hash != S2B_PHASEB_EXPECT_FOLD_HASH) S2B_PhaseBAddMismatch("FoldHash");
   if(g_s2b_stop_context.dataset_hash != S2B_PHASEB_EXPECT_DATASET_HASH) S2B_PhaseBAddMismatch("DatasetHash");
   if(g_s2b_stop_context.row_mask_hash != S2B_PHASEB_EXPECT_ROWMASK_HASH) S2B_PhaseBAddMismatch("RowMaskHash");
   if(g_s2b_stop_context.evaluation_context_hash != S2B_PHASEB_EXPECT_CONTEXT_HASH) S2B_PhaseBAddMismatch("EvaluationContextHash");
   if(g_s2b_stop_context.eligible_count != S2B_PHASEB_EXPECT_ELIGIBLE) S2B_PhaseBAddMismatch("EligibleCount");
   if(g_s2b_stop_context.positive_count != S2B_PHASEB_EXPECT_STOP_POS) S2B_PhaseBAddMismatch("StopPositives");
   if(g_s2b_phaseb_actual_candidate_hash != S2B_STOP_LOCKED_FEATURE_HASH) S2B_PhaseBAddMismatch("CandidateHash");
   if(g_s2b_phaseb_actual_feature_count != S2B_STOP_LOCKED_FEATURE_COUNT) S2B_PhaseBAddMismatch("CandidateFeatureCount");
   if(g_s2b_phaseb_actual_feature_list != S2B_STOP_LOCKED_FEATURE_LIST) S2B_PhaseBAddMismatch("CandidateFeatureList");
   g_s2b_phaseb_pre_oof_guard_pass = (g_s2b_phaseb_guard_mismatches == "");
   Print("STOP_PHASEB_CONTEXT_GUARD_PRE|", (g_s2b_phaseb_pre_oof_guard_pass ? "PASS" : "FAIL"),
         "|ExpectedProtocol=", S2B_PHASEB_EXPECT_PROTOCOL_HASH, "|ActualProtocol=", g_s2b_stop_context.shared_protocol_hash,
         "|ExpectedFold=", S2B_PHASEB_EXPECT_FOLD_HASH, "|ActualFold=", g_s2b_stop_context.fold_hash,
         "|ExpectedDataset=", S2B_PHASEB_EXPECT_DATASET_HASH, "|ActualDataset=", g_s2b_stop_context.dataset_hash,
         "|ExpectedRowMask=", S2B_PHASEB_EXPECT_ROWMASK_HASH, "|ActualRowMask=", g_s2b_stop_context.row_mask_hash,
         "|ExpectedContext=", S2B_PHASEB_EXPECT_CONTEXT_HASH, "|ActualContext=", g_s2b_stop_context.evaluation_context_hash,
         "|ExpectedEligible=", S2B_PHASEB_EXPECT_ELIGIBLE, "|ActualEligible=", g_s2b_stop_context.eligible_count,
         "|ExpectedStopPos=", S2B_PHASEB_EXPECT_STOP_POS, "|ActualStopPos=", g_s2b_stop_context.positive_count,
         "|ExpectedCandidate=", S2B_STOP_LOCKED_FEATURE_HASH, "|ActualCandidate=", g_s2b_phaseb_actual_candidate_hash,
         "|ExpectedNFeat=", S2B_STOP_LOCKED_FEATURE_COUNT, "|ActualNFeat=", g_s2b_phaseb_actual_feature_count,
         "|Mismatches=", g_s2b_phaseb_guard_mismatches);
   return g_s2b_phaseb_pre_oof_guard_pass;
}
// Stage 2 of the canonical lock guard. OOF rows must first be built to
// know their cardinality, but this executes before the threshold engine.
bool S2B_PhaseBPostOOFContextLockGuard()
{
   g_s2b_phaseb_actual_oof_n = g_s2b_stop_oof_count;
   g_s2b_phaseb_actual_oof_stop_n = 0;
   for(int i = 0; i < g_s2b_stop_oof_count; i++)
      if(g_s2b_stop_oof[i].stop_label == 1)
         g_s2b_phaseb_actual_oof_stop_n++;
   if(g_s2b_phaseb_actual_oof_n != S2B_PHASEB_EXPECT_OOF_N) S2B_PhaseBAddMismatch("OOF_N");
   if(g_s2b_phaseb_actual_oof_stop_n != S2B_PHASEB_EXPECT_OOF_STOP_N) S2B_PhaseBAddMismatch("OOF_Stop_N");
   g_s2b_phaseb_post_oof_guard_pass = (g_s2b_phaseb_guard_mismatches == "");
   g_s2b_phaseb_context_lock_pass = (g_s2b_phaseb_pre_oof_guard_pass && g_s2b_phaseb_post_oof_guard_pass);
   Print("STOP_PHASEB_CONTEXT_GUARD_POST|", (g_s2b_phaseb_post_oof_guard_pass ? "PASS" : "FAIL"),
         "|ExpectedOOF_N=", S2B_PHASEB_EXPECT_OOF_N, "|ActualOOF_N=", g_s2b_phaseb_actual_oof_n,
         "|ExpectedOOF_Stop_N=", S2B_PHASEB_EXPECT_OOF_STOP_N, "|ActualOOF_Stop_N=", g_s2b_phaseb_actual_oof_stop_n,
         "|ThresholdEngineExecuted=NO",
         "|Mismatches=", g_s2b_phaseb_guard_mismatches);
   return g_s2b_phaseb_context_lock_pass;
}
// ================================================================
// Score a trained fold model on a row set and RETURN the per-row
// probabilities together with their record indices.
// This is a NEW function. No existing signature changes.
// Normalization uses ONLY the mean/std stored in the model, which
// S2B_TrainLogistic_OnRows_Stop() computed from that fold's TRAIN rows.
// ================================================================
bool S2B_ScoreModel_OnRows_Stop(SStage2B_ModelParams &mdl,
                               int &eval_rows[], int eval_count,
                               double &out_probs[], int &out_recs[], int &out_n)
{
   out_n = 0;
   ArrayResize(out_probs, 0);
   ArrayResize(out_recs, 0);
   if(!mdl.trained || eval_count <= 0)
      return false;
   int n_feat = mdl.n_features;
   if(n_feat <= 0)
      return false;
   ArrayResize(out_probs, eval_count);
   ArrayResize(out_recs, eval_count);
   for(int i = 0; i < eval_count; i++)
   {
      int rec_idx = eval_rows[i];
      if(rec_idx < 0 || rec_idx >= g_risklab_count)
      {
         ArrayResize(out_probs, 0);
         ArrayResize(out_recs, 0);
         out_n = 0;
         return false;
      }
      double z = mdl.intercept;
      for(int k = 0; k < n_feat; k++)
      {
         double v = 0.0;
         if(!S2B_GetFeatureValue(rec_idx, mdl.feature_idx[k], v))
         {
            Print("S2B_ScoreModel_OnRows_Stop: row mask violation on rec=", rec_idx,
                  " feat=", S2B_FeatureName(mdl.feature_idx[k]));
            ArrayResize(out_probs, 0);
            ArrayResize(out_recs, 0);
            out_n = 0;
            return false;
         }
         double s = mdl.feat_std[k];
         if(s < 1e-12) s = 1.0;
         double vn = (v - mdl.feat_mean[k]) / s;
         z += mdl.weights[k] * vn;
      }
      out_probs[i] = S2B_Sigmoid(z);
      out_recs[i]  = rec_idx;
   }
   out_n = eval_count;
   return true;
}
// Deterministic sort of OOF row indices by (prob ASC, rec_idx ASC).
void S2B_PhaseBSortIdxByProbThenRec(int &idx[], int n)
{
   for(int i = 1; i < n; i++)
   {
      int key = idx[i];
      double kp = g_s2b_stop_oof[key].prob;
      int    kr = g_s2b_stop_oof[key].rec_idx;
      int j = i - 1;
      while(j >= 0)
      {
         double jp = g_s2b_stop_oof[idx[j]].prob;
         int    jr = g_s2b_stop_oof[idx[j]].rec_idx;
         bool greater = (jp > kp) || (jp == kp && jr > kr);
         if(!greater) break;
         idx[j + 1] = idx[j];
         j--;
      }
      idx[j + 1] = key;
   }
}
// ================================================================
// Build the DEV-only out-of-fold prediction set.
//   Fold 1: Train 2018-2020 -> Validation 2021
//   Fold 2: Train 2018-2021 -> Validation 2022
// Only validation-year rows receive an OOF prediction.
// 2023 and later are never touched here.
// ================================================================
bool S2B_BuildStopOOF()
{
   g_s2b_stop_oof_valid = false;
   g_s2b_stop_oof_block_reason = "";
   g_s2b_stop_oof_count = 0;
   g_s2b_stop_oof_fold_count = 0;
   ArrayResize(g_s2b_stop_oof, 0);
   if(!g_s2b_stop_context.valid)
   {
      g_s2b_stop_oof_block_reason = "STOP_CONTEXT_INVALID";
      return false;
   }
   if(g_s2b_fold_count < 2)
   {
      g_s2b_stop_oof_block_reason = "FOLD_COUNT_LT_2";
      return false;
   }
   int feat_idx[];
   int n_feat = S2B_ResolveLockedStopFeatures(feat_idx);
   string fhash = S2B_BuildFeatureHash(feat_idx, n_feat);
   if(fhash != S2B_STOP_LOCKED_FEATURE_HASH)
   {
      g_s2b_stop_oof_block_reason = "LOCKED_FEATURE_HASH_MISMATCH|computed=" + fhash +
                                    "|expected=" + S2B_STOP_LOCKED_FEATURE_HASH;
      return false;
   }
   datetime dev_hard_limit = StringToTime("2023.01.01");
   for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(!g_s2b_folds[f].is_primary)
         continue;
      if(g_s2b_folds[f].train_to > dev_hard_limit || g_s2b_folds[f].val_to > dev_hard_limit)
      {
         g_s2b_stop_oof_block_reason = "FOLD_WINDOW_EXCEEDS_DEV|" + g_s2b_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      int train_rows[];
      int val_rows[];
      int n_tr = S2B_CollectStopMaskedRows(g_s2b_folds[f].train_from, g_s2b_folds[f].train_to, train_rows);
      int n_va = S2B_CollectStopMaskedRows(g_s2b_folds[f].val_from,   g_s2b_folds[f].val_to,   val_rows);
      if(n_tr < 50 || n_va < 20)
      {
         g_s2b_stop_oof_block_reason = StringFormat("FOLD_ROWCOUNT_TOO_SMALL|%s|train=%d|val=%d",
                                                    g_s2b_folds[f].name, n_tr, n_va);
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      SStage2B_ModelParams mdl;
      if(!S2B_TrainLogistic_OnRows_Stop(feat_idx, n_feat, train_rows, n_tr, mdl))
      {
         g_s2b_stop_oof_block_reason = "FOLD_TRAIN_FAILED|" + g_s2b_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      double probs[];
      int recs[];
      int n_scored = 0;
      if(!S2B_ScoreModel_OnRows_Stop(mdl, val_rows, n_va, probs, recs, n_scored))
      {
         g_s2b_stop_oof_block_reason = "FOLD_SCORE_FAILED|" + g_s2b_folds[f].name;
         ArrayResize(g_s2b_stop_oof, 0);
         g_s2b_stop_oof_count = 0;
         return false;
      }
      int base = g_s2b_stop_oof_count;
      ArrayResize(g_s2b_stop_oof, base + n_scored);
      for(int i = 0; i < n_scored; i++)
      {
         int rec_idx = recs[i];
         SS2BStopOOFRow r;
         r.Reset();
         r.rec_idx    = rec_idx;
         r.fold_idx   = f;
         r.entry_time = g_risklab_records[rec_idx].entry_time;
         r.prob       = probs[i];
         r.stop_label = S2B_GetStopTargetAligned(rec_idx);
         r.step4plus  = (g_risklab_records[rec_idx].hit_step4_plus ? 1 : 0);
         r.target_flag= (g_risklab_records[rec_idx].target_flag ? 1 : 0);
         r.neutral_outcome = ((r.stop_label == 0 && r.target_flag == 0) ? 1 : 0);
         r.pnl        = g_risklab_records[rec_idx].pnl;
         g_s2b_stop_oof[base + i] = r;
      }
      g_s2b_stop_oof_count = base + n_scored;
      g_s2b_stop_oof_fold_count++;
   }
   if(g_s2b_stop_oof_count < 100 || g_s2b_stop_oof_fold_count < 2)
   {
      g_s2b_stop_oof_block_reason = StringFormat("OOF_TOO_SMALL|rows=%d|folds=%d",
                                                 g_s2b_stop_oof_count, g_s2b_stop_oof_fold_count);
      return false;
   }
   // Invariant 1: OOF disjointness - a record may be scored at most once.
   for(int a = 0; a < g_s2b_stop_oof_count; a++)
   {
      for(int b = a + 1; b < g_s2b_stop_oof_count; b++)
      {
         if(g_s2b_stop_oof[a].rec_idx == g_s2b_stop_oof[b].rec_idx)
         {
            g_s2b_stop_oof_block_reason = StringFormat("OOF_OVERLAP_VIOLATION|rec=%d",
                                                       g_s2b_stop_oof[a].rec_idx);
            return false;
         }
      }
   }
   // Invariant 2: no OOF row may fall on or after 2023.01.01.
   for(int c = 0; c < g_s2b_stop_oof_count; c++)
   {
      if(g_s2b_stop_oof[c].entry_time >= dev_hard_limit)
      {
         g_s2b_stop_oof_block_reason = StringFormat("OOF_WINDOW_VIOLATION|rec=%d|time=%s",
                                                    g_s2b_stop_oof[c].rec_idx,
                                                    TimeToString(g_s2b_stop_oof[c].entry_time, TIME_DATE));
         return false;
      }
   }
   // Per-fold percentile ranks (PRIMARY basis for Gate + Selection).
   for(int f2 = 0; f2 < S2B_MAX_FOLDS; f2++)
   {
      int fidx[];
      int fn = 0;
      ArrayResize(fidx, g_s2b_stop_oof_count);
      for(int i = 0; i < g_s2b_stop_oof_count; i++)
      {
         if(g_s2b_stop_oof[i].fold_idx == f2)
         {
            fidx[fn] = i;
            fn++;
         }
      }
      if(fn <= 0) continue;
      ArrayResize(fidx, fn);
      S2B_PhaseBSortIdxByProbThenRec(fidx, fn);
      for(int p = 0; p < fn; p++)
         g_s2b_stop_oof[fidx[p]].pct_rank = (double)(p + 1) / (double)fn;
   }
   // Pooled ranks (INFORMATIONAL only).
   int pidx[];
   ArrayResize(pidx, g_s2b_stop_oof_count);
   for(int i2 = 0; i2 < g_s2b_stop_oof_count; i2++)
      pidx[i2] = i2;
   S2B_PhaseBSortIdxByProbThenRec(pidx, g_s2b_stop_oof_count);
   for(int p2 = 0; p2 < g_s2b_stop_oof_count; p2++)
      g_s2b_stop_oof[pidx[p2]].pooled_rank = (double)(p2 + 1) / (double)g_s2b_stop_oof_count;
   g_s2b_stop_oof_valid = true;
   int tot_stop = 0, tot_s4 = 0, tot_tg = 0, tot_neu = 0;
   for(int i3 = 0; i3 < g_s2b_stop_oof_count; i3++)
   {
      if(g_s2b_stop_oof[i3].stop_label == 1) tot_stop++;
      if(g_s2b_stop_oof[i3].step4plus == 1) tot_s4++;
      if(g_s2b_stop_oof[i3].target_flag == 1) tot_tg++;
      if(g_s2b_stop_oof[i3].neutral_outcome == 1) tot_neu++;
   }
   Print("STOP_PHASEB_OOF|PASS",
         "|FeatureHash=", fhash,
         "|Folds=", g_s2b_stop_oof_fold_count,
         "|OOF_N=", g_s2b_stop_oof_count,
         "|StopN=", tot_stop,
         "|Step4PlusN=", tot_s4,
         "|TargetN=", tot_tg,
         "|NeutralN=", tot_neu,
         "|WindowMax=2022.12.31");
   return true;
}
// ================================================================
// Evaluate ONE threshold candidate using per-fold percentile ranks.
// reject if pct_rank > (1 - reject_frac).
// Pooled probability threshold is informational only.
// ================================================================
void S2B_EvaluateStopThresholdRow(double reject_frac, SS2BStopThresholdRow &row)
{
   row.Reset();
   row.target_rejection_pct = reject_frac * 100.0;
   row.fold_count = g_s2b_stop_oof_fold_count;
   if(!g_s2b_stop_oof_valid || g_s2b_stop_oof_count <= 0)
   {
      row.gate_fail_reason = "OOF_NOT_AVAILABLE";
      return;
   }
   int n = g_s2b_stop_oof_count;
   double cut = 1.0 - reject_frac;
   double gp_before = 0.0, gl_before = 0.0;
   double gp_after  = 0.0, gl_after  = 0.0;
   double fold_pnl_before[S2B_MAX_FOLDS];
   double fold_pnl_after[S2B_MAX_FOLDS];
   int fold_accepted_n[S2B_MAX_FOLDS];
   for(int f0 = 0; f0 < S2B_MAX_FOLDS; f0++)
   {
      fold_pnl_before[f0] = 0.0;
      fold_pnl_after[f0] = 0.0;
      fold_accepted_n[f0] = 0;
      row.fold_cut_prob[f0] = -1.0;
   }
   for(int i = 0; i < n; i++)
   {
      int f = g_s2b_stop_oof[i].fold_idx;
      if(f < 0 || f >= S2B_MAX_FOLDS) continue;
      bool rejected = (g_s2b_stop_oof[i].pct_rank > cut + 1e-12);
      int is_stop = g_s2b_stop_oof[i].stop_label;
      int is_s4 = g_s2b_stop_oof[i].step4plus;
      int is_tg = g_s2b_stop_oof[i].target_flag;
      double pnl = g_s2b_stop_oof[i].pnl;
      row.oof_n++;
      row.fold_oof_n[f]++;
      if(is_stop == 1) { row.oof_stop_n++; row.fold_stop_n[f]++; }
      if(is_s4 == 1) { row.step4_total_n++; row.fold_step4_total_n[f]++; }
      if(is_tg == 1) { row.target_total_n++; row.fold_target_total_n[f]++; }
      if(g_s2b_stop_oof[i].neutral_outcome == 1) row.neutral_outcome_n++;
      row.pnl_before += pnl;
      fold_pnl_before[f] += pnl;
      if(pnl >= 0.0) gp_before += pnl; else gl_before += -pnl;
      if(rejected)
      {
         row.rejected_n++;
         row.fold_rejected_n[f]++;
         if(row.fold_cut_prob[f] < 0.0 || g_s2b_stop_oof[i].prob < row.fold_cut_prob[f])
            row.fold_cut_prob[f] = g_s2b_stop_oof[i].prob;
         if(is_stop == 1) { row.stop_captured_n++; row.fold_stop_captured_n[f]++; }
         if(is_s4 == 1) { row.step4_rejected_n++; row.fold_step4_rejected_n[f]++; }
         if(is_tg == 1) { row.target_rejected_n++; row.fold_target_rejected_n[f]++; }
         if(is_stop == 1) row.tp++; else row.fp++;
      }
      else
      {
         row.accepted_n++;
         fold_accepted_n[f]++;
         row.pnl_after += pnl;
         fold_pnl_after[f] += pnl;
         if(pnl >= 0.0) gp_after += pnl; else gl_after += -pnl;
         if(is_stop == 1) row.fn_cnt++; else row.tn++;
      }
   }
   row.oof_prevalence = (row.oof_n > 0 ? (double)row.oof_stop_n / (double)row.oof_n : 0.0);
   row.rejection_rate_pct = (row.oof_n > 0 ? 100.0 * row.rejected_n / row.oof_n : 0.0);
   row.coverage_pct = (row.oof_n > 0 ? 100.0 * row.accepted_n / row.oof_n : 0.0);
   row.stop_remaining_n = row.oof_stop_n - row.stop_captured_n;
   row.stop_captured_pct = (row.oof_stop_n > 0 ? 100.0 * row.stop_captured_n / row.oof_stop_n : 0.0);
   row.stop_remaining_rate_pct = (row.accepted_n > 0 ? 100.0 * row.stop_remaining_n / row.accepted_n : 0.0);
   row.step4_lost_pct = (row.step4_total_n > 0 ? 100.0 * row.step4_rejected_n / row.step4_total_n : 0.0);
   row.target_lost_pct = (row.target_total_n > 0 ? 100.0 * row.target_rejected_n / row.target_total_n : 0.0);
   row.precision = ((row.tp + row.fp) > 0 ? (double)row.tp / (row.tp + row.fp) : 0.0);
   row.recall = ((row.tp + row.fn_cnt) > 0 ? (double)row.tp / (row.tp + row.fn_cnt) : 0.0);
   if((row.precision + row.recall) > 1e-12)
   {
      row.f1 = 2.0 * row.precision * row.recall / (row.precision + row.recall);
      row.f2 = 5.0 * row.precision * row.recall / (4.0 * row.precision + row.recall);
   }
   double mcc_num = (double)row.tp * row.tn - (double)row.fp * row.fn_cnt;
   double mcc_den = MathSqrt((double)(row.tp + row.fp) * (row.tp + row.fn_cnt) *
                             (row.tn + row.fp) * (row.tn + row.fn_cnt));
   row.mcc = (mcc_den > 1e-12 ? mcc_num / mcc_den : 0.0);
   row.expectancy_before = (row.oof_n > 0 ? row.pnl_before / row.oof_n : 0.0);
   row.expectancy_after = (row.accepted_n > 0 ? row.pnl_after / row.accepted_n : 0.0);
   row.expectancy_delta = row.expectancy_after - row.expectancy_before;
   row.pf_before = S2B_PhaseBProfitFactor(gp_before, gl_before, row.pf_before_defined);
   row.pf_after = S2B_PhaseBProfitFactor(gp_after, gl_after, row.pf_after_defined);
   for(int f1 = 0; f1 < S2B_MAX_FOLDS; f1++)
   {
      if(row.fold_oof_n[f1] <= 0) continue;
      row.fold_rejection_rate_pct[f1] = 100.0 * row.fold_rejected_n[f1] / row.fold_oof_n[f1];
      row.fold_stop_captured_pct[f1] = (row.fold_stop_n[f1] > 0 ? 100.0 * row.fold_stop_captured_n[f1] / row.fold_stop_n[f1] : 0.0);
      row.fold_expectancy_before[f1] = fold_pnl_before[f1] / row.fold_oof_n[f1];
      row.fold_expectancy_after[f1] = (fold_accepted_n[f1] > 0 ? fold_pnl_after[f1] / fold_accepted_n[f1] : 0.0);
      if(row.fold_cut_prob[f1] < 0.0) row.fold_cut_prob[f1] = 1.0;
   }
   double all_probs[];
   ArrayResize(all_probs, n);
   for(int i2 = 0; i2 < n; i2++) all_probs[i2] = g_s2b_stop_oof[i2].prob;
   S2B_PhaseBSortAsc(all_probs, n);
   row.pooled_cut_prob = S2B_PhaseBPercentile(all_probs, n, cut);
   for(int i3 = 0; i3 < n; i3++)
   {
      if(g_s2b_stop_oof[i3].prob >= row.pooled_cut_prob)
      {
         row.pooled_rejected_n++;
         if(g_s2b_stop_oof[i3].stop_label == 1) row.pooled_stop_captured_n++;
      }
   }
   row.pooled_rejection_rate_pct = (n > 0 ? 100.0 * row.pooled_rejected_n / n : 0.0);
   row.pooled_stop_captured_pct = (row.oof_stop_n > 0 ? 100.0 * row.pooled_stop_captured_n / row.oof_stop_n : 0.0);
   row.low_positive_sample = (row.oof_stop_n < S2B_PHASEB_LOWPOS_LIMIT ? 1 : 0);
}
// Frozen gate S2B_STOP_THRESHOLD_GATE_v1.
bool S2B_PhaseBApplyGate(SS2BStopThresholdRow &row, string &reason)
{
   reason = "NONE";
   if(row.oof_n <= 0) { reason = "NO_OOF_ROWS"; return false; }
   if(row.coverage_pct + 1e-9 < S2B_PHASEB_GATE_MIN_COVERAGE) { reason = "COVERAGE_BELOW_70"; return false; }
   if(row.rejection_rate_pct - 1e-9 > S2B_PHASEB_GATE_MAX_REJECTION) { reason = "REJECTION_ABOVE_30"; return false; }
   if(row.stop_captured_pct + 1e-9 < S2B_PHASEB_GATE_MIN_STOPCAPTURE) { reason = "STOP_CAPTURE_BELOW_20"; return false; }
   if(row.step4_total_n <= 0) { reason = "STEP4_DENOMINATOR_ZERO"; return false; }
   if(row.step4_lost_pct - 1e-9 > S2B_PHASEB_GATE_MAX_STEP4LOST) { reason = "STEP4_LOST_ABOVE_15"; return false; }
   if(row.target_total_n <= 0) { reason = "TARGET_DENOMINATOR_ZERO"; return false; }
   if(row.target_lost_pct - 1e-9 > S2B_PHASEB_GATE_MAX_TARGETLOST) { reason = "TARGET_LOST_ABOVE_15"; return false; }
   if(row.expectancy_after + 1e-12 < row.expectancy_before) { reason = "EXPECTANCY_DECREASED"; return false; }
   if(row.pf_before_defined == 0 || row.pf_after_defined == 0) { reason = "PF_UNDEFINED"; return false; }
   if(row.pf_after + 1e-12 < row.pf_before) { reason = "PF_DECREASED"; return false; }
   return true;
}
// Selection: Max Stop Capture; Min Step4 Lost; Min Target Lost;
// Max expectancy improvement; Max coverage; Higher percentile cutoff.
bool S2B_PhaseBThresholdBetter(SS2BStopThresholdRow &a, SS2BStopThresholdRow &b)
{
   double eps = 1e-10;
   if(a.stop_captured_pct > b.stop_captured_pct + eps) return true;
   if(a.stop_captured_pct < b.stop_captured_pct - eps) return false;
   if(a.step4_lost_pct < b.step4_lost_pct - eps) return true;
   if(a.step4_lost_pct > b.step4_lost_pct + eps) return false;
   if(a.target_lost_pct < b.target_lost_pct - eps) return true;
   if(a.target_lost_pct > b.target_lost_pct + eps) return false;
   if(a.expectancy_delta > b.expectancy_delta + eps) return true;
   if(a.expectancy_delta < b.expectancy_delta - eps) return false;
   if(a.coverage_pct > b.coverage_pct + eps) return true;
   if(a.coverage_pct < b.coverage_pct - eps) return false;
   // Higher percentile threshold == lower rejection quantile.
   return (a.target_rejection_pct < b.target_rejection_pct);
}
// ================================================================
// Stratified bootstrap per fold and per Stop/Non-Stop stratum.
// Percentile ranks and threshold are held fixed; rows are resampled.
// ================================================================
void S2B_PhaseBBootstrap(SS2BStopThresholdRow &row)
{
   row.ci_valid = 0;
   row.ci_iterations = 0;
   if(!g_s2b_stop_oof_valid || g_s2b_stop_oof_count <= 0) return;
   int B = S2B_PHASEB_BOOTSTRAP_ITERS;
   double v_stop[], v_s4[], v_target[], v_reject[], v_exp[];
   ArrayResize(v_stop, B); ArrayResize(v_s4, B); ArrayResize(v_target, B);
   ArrayResize(v_reject, B); ArrayResize(v_exp, B);
   double cut = 1.0 - row.target_rejection_pct / 100.0;
   uint seed = (uint)S2B_PHASEB_BOOTSTRAP_SEED + (uint)MathRound(row.target_rejection_pct * 100.0);
   S2B_PhaseBSeedRng(seed);
   for(int b = 0; b < B; b++)
   {
      int n_all = 0, n_rej = 0, n_stop = 0, n_stop_rej = 0;
      int n_s4 = 0, n_s4_rej = 0, n_tg = 0, n_tg_rej = 0;
      int n_acc = 0;
      double pnl_acc = 0.0;
      for(int f = 0; f < S2B_MAX_FOLDS; f++)
      {
         int stop_idx[], non_idx[];
         int ns = 0, nn = 0;
         ArrayResize(stop_idx, g_s2b_stop_oof_count);
         ArrayResize(non_idx, g_s2b_stop_oof_count);
         for(int i = 0; i < g_s2b_stop_oof_count; i++)
         {
            if(g_s2b_stop_oof[i].fold_idx != f) continue;
            if(g_s2b_stop_oof[i].stop_label == 1) stop_idx[ns++] = i;
            else non_idx[nn++] = i;
         }
         ArrayResize(stop_idx, ns);
         ArrayResize(non_idx, nn);
         for(int s = 0; s < ns; s++)
         {
            int ix = stop_idx[S2B_PhaseBRandIndex(ns)];
            bool rejected = (g_s2b_stop_oof[ix].pct_rank > cut + 1e-12);
            n_all++; n_stop++;
            if(g_s2b_stop_oof[ix].step4plus == 1) n_s4++;
            if(g_s2b_stop_oof[ix].target_flag == 1) n_tg++;
            if(rejected)
            {
               n_rej++; n_stop_rej++;
               if(g_s2b_stop_oof[ix].step4plus == 1) n_s4_rej++;
               if(g_s2b_stop_oof[ix].target_flag == 1) n_tg_rej++;
            }
            else { n_acc++; pnl_acc += g_s2b_stop_oof[ix].pnl; }
         }
         for(int q = 0; q < nn; q++)
         {
            int ix2 = non_idx[S2B_PhaseBRandIndex(nn)];
            bool rejected2 = (g_s2b_stop_oof[ix2].pct_rank > cut + 1e-12);
            n_all++;
            if(g_s2b_stop_oof[ix2].step4plus == 1) n_s4++;
            if(g_s2b_stop_oof[ix2].target_flag == 1) n_tg++;
            if(rejected2)
            {
               n_rej++;
               if(g_s2b_stop_oof[ix2].step4plus == 1) n_s4_rej++;
               if(g_s2b_stop_oof[ix2].target_flag == 1) n_tg_rej++;
            }
            else { n_acc++; pnl_acc += g_s2b_stop_oof[ix2].pnl; }
         }
      }
      v_stop[b] = (n_stop > 0 ? 100.0 * n_stop_rej / n_stop : 0.0);
      v_s4[b] = (n_s4 > 0 ? 100.0 * n_s4_rej / n_s4 : 0.0);
      v_target[b] = (n_tg > 0 ? 100.0 * n_tg_rej / n_tg : 0.0);
      v_reject[b] = (n_all > 0 ? 100.0 * n_rej / n_all : 0.0);
      v_exp[b] = (n_acc > 0 ? pnl_acc / n_acc : 0.0);
   }
   S2B_PhaseBSortAsc(v_stop, B); S2B_PhaseBSortAsc(v_s4, B);
   S2B_PhaseBSortAsc(v_target, B); S2B_PhaseBSortAsc(v_reject, B);
   S2B_PhaseBSortAsc(v_exp, B);
   row.ci_stop_capture_lo = S2B_PhaseBPercentile(v_stop, B, 0.025);
   row.ci_stop_capture_hi = S2B_PhaseBPercentile(v_stop, B, 0.975);
   row.ci_step4_lost_lo = S2B_PhaseBPercentile(v_s4, B, 0.025);
   row.ci_step4_lost_hi = S2B_PhaseBPercentile(v_s4, B, 0.975);
   row.ci_target_lost_lo = S2B_PhaseBPercentile(v_target, B, 0.025);
   row.ci_target_lost_hi = S2B_PhaseBPercentile(v_target, B, 0.975);
   row.ci_rejection_lo = S2B_PhaseBPercentile(v_reject, B, 0.025);
   row.ci_rejection_hi = S2B_PhaseBPercentile(v_reject, B, 0.975);
   row.ci_expectancy_after_lo = S2B_PhaseBPercentile(v_exp, B, 0.025);
   row.ci_expectancy_after_hi = S2B_PhaseBPercentile(v_exp, B, 0.975);
   row.ci_iterations = B;
   row.ci_valid = 1;
}
string S2B_PhaseBCsvDouble(double v, int digits = 8)
{
   return DoubleToString(v, digits);
}
void S2B_ExportStopThresholdTradeoff()
{
   string fn = "Stage2B_Stop_ThresholdTradeoff_v2_" + _Symbol + ".csv";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("STOP_PHASEB_EXPORT|FAIL|File=", fn); return; }
   string header = "PhaseBVersion,CandidateLockVersion,GateVersion,FeatureHash,CurrentCycleStatus,CurrentResultStatus,ScaleBasis,TargetRejectionPct,PercentileCut,";
   header += "OOF_N,OOF_Stop_N,OOF_Prevalence,Rejected_N,Accepted_N,RejectionRatePct,CoveragePct,";
   header += "StopCaptured_N,StopCapturedPct,StopRemaining_N,StopRemainingRatePct,";
   header += "Step4Total_N,Step4Rejected_N,Step4LostPct,TargetTotal_N,TargetRejected_N,TargetLostPct,NeutralOutcomeN,";
   header += "Precision,Recall,MCC,F1,F2,PnLBefore,PnLAfter,ExpectancyBefore,ExpectancyAfter,ExpectancyDelta,";
   header += "PFBefore,PFBeforeDefined,PFAfter,PFAfterDefined,LowPositiveSample,GatePass,GateFailReason,PolicyRank,";
   header += "PooledCutProbability_InfoOnly,PooledRejected_N,PooledRejectionRatePct,PooledStopCaptured_N,PooledStopCapturedPct,";
   header += "CIValid,CIIterations,CI_StopCapture_Lo,CI_StopCapture_Hi,CI_Step4Lost_Lo,CI_Step4Lost_Hi,";
   header += "CI_TargetLost_Lo,CI_TargetLost_Hi,CI_Rejection_Lo,CI_Rejection_Hi,CI_ExpectancyAfter_Lo,CI_ExpectancyAfter_Hi,";
   header += "Fold1CutProb,Fold1N,Fold1StopN,Fold1RejectedN,Fold1RejectionPct,Fold1StopCapturedN,Fold1StopCapturedPct,Fold1Step4Total,Fold1Step4Rejected,Fold1TargetTotal,Fold1TargetRejected,Fold1ExpBefore,Fold1ExpAfter,";
   header += "Fold2CutProb,Fold2N,Fold2StopN,Fold2RejectedN,Fold2RejectionPct,Fold2StopCapturedN,Fold2StopCapturedPct,Fold2Step4Total,Fold2Step4Rejected,Fold2TargetTotal,Fold2TargetRejected,Fold2ExpBefore,Fold2ExpAfter\n";
   FileWriteString(h, header);
   for(int i = 0; i < g_s2b_stop_thr_row_count; i++)
   {
      SS2BStopThresholdRow r = g_s2b_stop_thr_rows[i];
      string s = S2B_STOP_PHASEB_VERSION + "," + S2B_STOP_CANDIDATE_LOCK_VERSION + "," +
                 S2B_STOP_THRESHOLD_GATE_VERSION + "," + S2B_STOP_LOCKED_FEATURE_HASH +
                 ",RESET_ON_CANONICAL_CURRENT_SYSTEM,PROVISIONAL_DEVELOPMENT_AWARE,PER_FOLD_PERCENTILE_PRIMARY,";
      s += S2B_PhaseBCsvDouble(r.target_rejection_pct,2) + "," + S2B_PhaseBCsvDouble(100.0-r.target_rejection_pct,2) + ",";
      s += IntegerToString(r.oof_n)+","+IntegerToString(r.oof_stop_n)+","+S2B_PhaseBCsvDouble(r.oof_prevalence,8)+","+IntegerToString(r.rejected_n)+","+IntegerToString(r.accepted_n)+","+S2B_PhaseBCsvDouble(r.rejection_rate_pct,6)+","+S2B_PhaseBCsvDouble(r.coverage_pct,6)+",";
      s += IntegerToString(r.stop_captured_n)+","+S2B_PhaseBCsvDouble(r.stop_captured_pct,6)+","+IntegerToString(r.stop_remaining_n)+","+S2B_PhaseBCsvDouble(r.stop_remaining_rate_pct,6)+",";
      s += IntegerToString(r.step4_total_n)+","+IntegerToString(r.step4_rejected_n)+","+S2B_PhaseBCsvDouble(r.step4_lost_pct,6)+","+IntegerToString(r.target_total_n)+","+IntegerToString(r.target_rejected_n)+","+S2B_PhaseBCsvDouble(r.target_lost_pct,6)+","+IntegerToString(r.neutral_outcome_n)+",";
      s += S2B_PhaseBCsvDouble(r.precision,8)+","+S2B_PhaseBCsvDouble(r.recall,8)+","+S2B_PhaseBCsvDouble(r.mcc,8)+","+S2B_PhaseBCsvDouble(r.f1,8)+","+S2B_PhaseBCsvDouble(r.f2,8)+",";
      s += S2B_PhaseBCsvDouble(r.pnl_before,8)+","+S2B_PhaseBCsvDouble(r.pnl_after,8)+","+S2B_PhaseBCsvDouble(r.expectancy_before,8)+","+S2B_PhaseBCsvDouble(r.expectancy_after,8)+","+S2B_PhaseBCsvDouble(r.expectancy_delta,8)+",";
      s += S2B_PhaseBCsvDouble(r.pf_before,8)+","+IntegerToString(r.pf_before_defined)+","+S2B_PhaseBCsvDouble(r.pf_after,8)+","+IntegerToString(r.pf_after_defined)+","+(r.low_positive_sample==1?"YES":"NO")+","+(r.gate_pass==1?"PASS":"FAIL")+","+r.gate_fail_reason+","+IntegerToString(r.policy_rank)+",";
      s += S2B_PhaseBCsvDouble(r.pooled_cut_prob,10)+","+IntegerToString(r.pooled_rejected_n)+","+S2B_PhaseBCsvDouble(r.pooled_rejection_rate_pct,6)+","+IntegerToString(r.pooled_stop_captured_n)+","+S2B_PhaseBCsvDouble(r.pooled_stop_captured_pct,6)+",";
      s += IntegerToString(r.ci_valid)+","+IntegerToString(r.ci_iterations)+","+S2B_PhaseBCsvDouble(r.ci_stop_capture_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_stop_capture_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_step4_lost_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_step4_lost_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_target_lost_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_target_lost_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_rejection_lo,6)+","+S2B_PhaseBCsvDouble(r.ci_rejection_hi,6)+","+S2B_PhaseBCsvDouble(r.ci_expectancy_after_lo,8)+","+S2B_PhaseBCsvDouble(r.ci_expectancy_after_hi,8)+",";
      for(int f = 0; f < 2; f++)
      {
         s += S2B_PhaseBCsvDouble(r.fold_cut_prob[f],10)+","+IntegerToString(r.fold_oof_n[f])+","+IntegerToString(r.fold_stop_n[f])+","+IntegerToString(r.fold_rejected_n[f])+","+S2B_PhaseBCsvDouble(r.fold_rejection_rate_pct[f],6)+","+IntegerToString(r.fold_stop_captured_n[f])+","+S2B_PhaseBCsvDouble(r.fold_stop_captured_pct[f],6)+","+IntegerToString(r.fold_step4_total_n[f])+","+IntegerToString(r.fold_step4_rejected_n[f])+","+IntegerToString(r.fold_target_total_n[f])+","+IntegerToString(r.fold_target_rejected_n[f])+","+S2B_PhaseBCsvDouble(r.fold_expectancy_before[f],8)+","+S2B_PhaseBCsvDouble(r.fold_expectancy_after[f],8);
         if(f == 0) s += ",";
      }
      FileWriteString(h, s + "\n");
   }
   FileFlush(h); FileClose(h);
   Print("STOP_PHASEB_TRADEOFF_REPORT|", fn);
}
void S2B_ExportStopThresholdLock()
{
   string fn = "Stage2B_Stop_ThresholdLock_v2_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) { Print("STOP_PHASEB_LOCK_EXPORT|FAIL|File=", fn); return; }
   string line = "================================================================\n";
   FileWriteString(h, line);
   FileWriteString(h, "STAGE 2B STOPFLAG PHASE B v2 - CANONICAL CURRENT-SYSTEM RESET\n");
   FileWriteString(h, "Symbol: " + _Symbol + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "PhaseBVersion              : " + S2B_STOP_PHASEB_VERSION + "\n");
   FileWriteString(h, "CandidateLockVersion       : " + S2B_STOP_CANDIDATE_LOCK_VERSION + "\n");
   FileWriteString(h, "GateVersion                : " + S2B_STOP_THRESHOLD_GATE_VERSION + "\n");
   FileWriteString(h, "Current Cycle Status       : RESET_ON_CANONICAL_CURRENT_SYSTEM\n");
   FileWriteString(h, "Current Result Status      : PROVISIONAL / DEVELOPMENT-AWARE\n");
   FileWriteString(h, "\n[PREVIOUS CYCLE — PRESERVED INFORMATIONAL RESULT]\n");
   FileWriteString(h, "PreviousCandidateHash      : " + S2B_STOP_PREVIOUS_FEATURE_HASH + "\n");
   FileWriteString(h, "PreviousCandidateStatus    : SUPERSEDED_BY_CANONICAL_PHASE_A_RERUN\n");
   FileWriteString(h, "PreviousResult             : NO_VIABLE_THRESHOLD\n");
   FileWriteString(h, "PreviousResultStatus       : INFORMATIONAL / SUPERSEDED CONTEXT\n");
   FileWriteString(h, "\n[CURRENT CANONICAL CANDIDATE LOCK]\n");
   FileWriteString(h, "CandidateLocked            : YES\n");
   FileWriteString(h, "SelectedByPolicy           : YES\n");
   FileWriteString(h, "AbsoluteGate               : PASS\n");
   FileWriteString(h, "CandidateStatus            : LOCKED / PROVISIONAL\n");
   FileWriteString(h, "FeatureHash                : " + S2B_STOP_LOCKED_FEATURE_HASH + "\n");
   FileWriteString(h, "CandidateFeatureCount      : " + IntegerToString(S2B_STOP_LOCKED_FEATURE_COUNT) + "\n");
   FileWriteString(h, "Features                   : " + S2B_STOP_LOCKED_FEATURE_LIST + "\n");
   FileWriteString(h, "SelectionPolicy            : AbsoluteGate > MaxWorstAUC > MinStdAUC > MaxMeanPRLift > FewerFeatures > MaxMeanAUC > FeatureHashAscending\n");
   FileWriteString(h, "WF Mean AUC                : 0.699516\n");
   FileWriteString(h, "WF Worst AUC               : 0.691839\n");
   FileWriteString(h, "WF Std AUC                 : 0.007676\n");
   FileWriteString(h, "Mean PR-AUC                : 0.023466\n");
   FileWriteString(h, "Mean PR Lift               : 2.150792\n");
   FileWriteString(h, "Mean MCC                   : 0.026289\n");
   FileWriteString(h, "DiagnosticMetricThreshold  : 0.5\n");
   FileWriteString(h, "\n[CANONICAL CONTEXT LOCK GUARD — EXPECTED VS ACTUAL]\n");
   FileWriteString(h, "PreOOFGuardPass            : " + string(g_s2b_phaseb_pre_oof_guard_pass ? "YES" : "NO") + "\n");
   FileWriteString(h, "PostOOFGuardPass           : " + string(g_s2b_phaseb_post_oof_guard_pass ? "YES" : "NO") + "\n");
   FileWriteString(h, "ContextLockPass            : " + string(g_s2b_phaseb_context_lock_pass ? "YES" : "NO") + "\n");
   FileWriteString(h, "MismatchFields             : " + g_s2b_phaseb_guard_mismatches + "\n");
   FileWriteString(h, "SharedProtocolHash Expected: " + S2B_PHASEB_EXPECT_PROTOCOL_HASH + " | Actual: " + g_s2b_stop_context.shared_protocol_hash + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.shared_protocol_hash == S2B_PHASEB_EXPECT_PROTOCOL_HASH) + "\n");
   FileWriteString(h, "FoldHash Expected          : " + S2B_PHASEB_EXPECT_FOLD_HASH + " | Actual: " + g_s2b_stop_context.fold_hash + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.fold_hash == S2B_PHASEB_EXPECT_FOLD_HASH) + "\n");
   FileWriteString(h, "DatasetHash Expected       : " + S2B_PHASEB_EXPECT_DATASET_HASH + " | Actual: " + g_s2b_stop_context.dataset_hash + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.dataset_hash == S2B_PHASEB_EXPECT_DATASET_HASH) + "\n");
   FileWriteString(h, "RowMaskHash Expected       : " + S2B_PHASEB_EXPECT_ROWMASK_HASH + " | Actual: " + g_s2b_stop_context.row_mask_hash + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.row_mask_hash == S2B_PHASEB_EXPECT_ROWMASK_HASH) + "\n");
   FileWriteString(h, "EvaluationContext Expected : " + S2B_PHASEB_EXPECT_CONTEXT_HASH + " | Actual: " + g_s2b_stop_context.evaluation_context_hash + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.evaluation_context_hash == S2B_PHASEB_EXPECT_CONTEXT_HASH) + "\n");
   FileWriteString(h, "EligibleCount Expected     : " + IntegerToString(S2B_PHASEB_EXPECT_ELIGIBLE) + " | Actual: " + IntegerToString(g_s2b_stop_context.eligible_count) + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.eligible_count == S2B_PHASEB_EXPECT_ELIGIBLE) + "\n");
   FileWriteString(h, "StopPositives Expected     : " + IntegerToString(S2B_PHASEB_EXPECT_STOP_POS) + " | Actual: " + IntegerToString(g_s2b_stop_context.positive_count) + " | " + S2B_PhaseBMatchText(g_s2b_stop_context.positive_count == S2B_PHASEB_EXPECT_STOP_POS) + "\n");
   FileWriteString(h, "OOF_N Expected             : " + IntegerToString(S2B_PHASEB_EXPECT_OOF_N) + " | Actual: " + IntegerToString(g_s2b_phaseb_actual_oof_n) + " | " + S2B_PhaseBMatchText(g_s2b_phaseb_actual_oof_n == S2B_PHASEB_EXPECT_OOF_N) + "\n");
   FileWriteString(h, "OOF_Stop_N Expected        : " + IntegerToString(S2B_PHASEB_EXPECT_OOF_STOP_N) + " | Actual: " + IntegerToString(g_s2b_phaseb_actual_oof_stop_n) + " | " + S2B_PhaseBMatchText(g_s2b_phaseb_actual_oof_stop_n == S2B_PHASEB_EXPECT_OOF_STOP_N) + "\n");
   FileWriteString(h, "CandidateHash Expected     : " + S2B_STOP_LOCKED_FEATURE_HASH + " | Actual: " + g_s2b_phaseb_actual_candidate_hash + " | " + S2B_PhaseBMatchText(g_s2b_phaseb_actual_candidate_hash == S2B_STOP_LOCKED_FEATURE_HASH) + "\n");
   FileWriteString(h, "CandidateFeatureCount Exp  : " + IntegerToString(S2B_STOP_LOCKED_FEATURE_COUNT) + " | Actual: " + IntegerToString(g_s2b_phaseb_actual_feature_count) + " | " + S2B_PhaseBMatchText(g_s2b_phaseb_actual_feature_count == S2B_STOP_LOCKED_FEATURE_COUNT) + "\n");
   FileWriteString(h, "CandidateFeatureList Exp   : " + S2B_STOP_LOCKED_FEATURE_LIST + "\n");
   FileWriteString(h, "CandidateFeatureList Actual: " + g_s2b_phaseb_actual_feature_list + " | " + S2B_PhaseBMatchText(g_s2b_phaseb_actual_feature_list == S2B_STOP_LOCKED_FEATURE_LIST) + "\n");
   FileWriteString(h, "\n[FIXED PHASE B PROTOCOL]\n");
   FileWriteString(h, "RejectionQuantiles         : 5%|10%|15%|20%|25%|30%\n");
   FileWriteString(h, "ScalePrimary               : PER_FOLD_PERCENTILE_RANK\n");
   FileWriteString(h, "ScaleInformational         : GLOBAL_POOLED_PROBABILITY_QUANTILE / INFO ONLY\n");
   FileWriteString(h, "Bootstrap                  : STRATIFIED_PER_FOLD_STOP_NONSTOP\n");
   FileWriteString(h, "BootstrapSeed              : 20260808\n");
   FileWriteString(h, "BootstrapIterations        : 1000\n");
   FileWriteString(h, "TargetLostDenominator      : OOF target_flag rows only; neutral rows excluded\n");
   FileWriteString(h, "CoveragePct                : >= 70\n");
   FileWriteString(h, "RejectionRatePct           : <= 30\n");
   FileWriteString(h, "StopCapturePct             : >= 20\n");
   FileWriteString(h, "Step4PlusLostPct           : <= 15\n");
   FileWriteString(h, "TargetLostPct              : <= 15\n");
   FileWriteString(h, "ExpectancyAfter            : >= ExpectancyBefore\n");
   FileWriteString(h, "PFAfter                    : >= PFBefore and both defined\n");
   FileWriteString(h, "\n[EXECUTION STATE]\n");
   FileWriteString(h, "PhaseBVerdict              : " + g_s2b_stop_phaseb_verdict + "\n");
   FileWriteString(h, "ThresholdEngineExecuted    : " + string(g_s2b_phaseb_threshold_engine_executed ? "YES" : "NO") + "\n");
   FileWriteString(h, "OperationalThresholdSelected: " + string(g_s2b_stop_operational_threshold_selected ? "YES" : "NO") + "\n");
   FileWriteString(h, "NumericProbabilityThresholdSelected: NO\n");
   FileWriteString(h, "\n[CANDIDATE GATE RESULTS]\n");
   if(!g_s2b_phaseb_threshold_engine_executed)
      FileWriteString(h, "NOT EXECUTED — canonical context/candidate lock did not fully pass or OOF build failed.\n");
   for(int i = 0; i < g_s2b_stop_thr_row_count; i++)
   {
      SS2BStopThresholdRow r = g_s2b_stop_thr_rows[i];
      FileWriteString(h, StringFormat("Reject=%.0f%% | ActualReject=%.4f%% | Coverage=%.4f%% | StopCaptured=%d/%d (%.4f%%) | Step4Lost=%.4f%% | TargetLost=%.4f%% | ExpDelta=%.8f | PF=%.6f->%.6f | Gate=%s | Reason=%s\n",
                                      r.target_rejection_pct, r.rejection_rate_pct, r.coverage_pct,
                                      r.stop_captured_n, r.oof_stop_n, r.stop_captured_pct,
                                      r.step4_lost_pct, r.target_lost_pct, r.expectancy_delta,
                                      r.pf_before, r.pf_after, (r.gate_pass==1?"PASS":"FAIL"), r.gate_fail_reason));
   }
   FileWriteString(h, "\n[THRESHOLD LOCK]\n");
   if(g_s2b_stop_operational_threshold_selected && g_s2b_stop_thr_selected_index >= 0 && g_s2b_stop_thr_selected_index < g_s2b_stop_thr_row_count)
   {
      SS2BStopThresholdRow w = g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index];
      FileWriteString(h, "LockedRejectionRateTarget  : " + DoubleToString(w.target_rejection_pct,2) + "%\n");
      FileWriteString(h, "LockedPercentileThreshold  : " + DoubleToString(100.0-w.target_rejection_pct,2) + "th percentile per fold\n");
      FileWriteString(h, "StopCaptured               : " + IntegerToString(w.stop_captured_n) + "/" + IntegerToString(w.oof_stop_n) + "\n");
      FileWriteString(h, StringFormat("StopCapture95CI           : [%.4f, %.4f]\n", w.ci_stop_capture_lo, w.ci_stop_capture_hi));
      FileWriteString(h, StringFormat("Step4Lost95CI             : [%.4f, %.4f]\n", w.ci_step4_lost_lo, w.ci_step4_lost_hi));
      FileWriteString(h, StringFormat("TargetLost95CI            : [%.4f, %.4f]\n", w.ci_target_lost_lo, w.ci_target_lost_hi));
      FileWriteString(h, StringFormat("RejectionRate95CI         : [%.4f, %.4f]\n", w.ci_rejection_lo, w.ci_rejection_hi));
      FileWriteString(h, StringFormat("ExpectancyAfter95CI       : [%.8f, %.8f]\n", w.ci_expectancy_after_lo, w.ci_expectancy_after_hi));
      FileWriteString(h, "\n[THRESHOLD-NEIGHBOUR SENSITIVITY]\n");
      int lo = g_s2b_stop_thr_selected_index - 1;
      int hi = g_s2b_stop_thr_selected_index + 1;
      if(lo >= 0)
      {
         SS2BStopThresholdRow n1 = g_s2b_stop_thr_rows[lo];
         FileWriteString(h, StringFormat("LowerArrayNeighbour Reject=%.0f%% StopCaptured=%d Step4Lost=%.4f TargetLost=%.4f ExpDelta=%.8f Gate=%s\n",n1.target_rejection_pct,n1.stop_captured_n,n1.step4_lost_pct,n1.target_lost_pct,n1.expectancy_delta,(n1.gate_pass==1?"PASS":"FAIL")));
      }
      if(hi < g_s2b_stop_thr_row_count)
      {
         SS2BStopThresholdRow n2 = g_s2b_stop_thr_rows[hi];
         FileWriteString(h, StringFormat("UpperArrayNeighbour Reject=%.0f%% StopCaptured=%d Step4Lost=%.4f TargetLost=%.4f ExpDelta=%.8f Gate=%s\n",n2.target_rejection_pct,n2.stop_captured_n,n2.step4_lost_pct,n2.target_lost_pct,n2.expectancy_delta,(n2.gate_pass==1?"PASS":"FAIL")));
      }
   }
   else
      FileWriteString(h, "LockedRejectionRateTarget  : NONE\n");
   FileWriteString(h, "\n[DOWNSTREAM GUARDS]\n");
   FileWriteString(h, "2023                        : Historical Confirmation / selection-aware, not blind - NOT ACCESSED\n");
   FileWriteString(h, "2024-2026                   : Reserved / untouched true holdout\n");
   FileWriteString(h, "Historical Confirmation     : BLOCKED\n");
   FileWriteString(h, "Winner Confirmation         : BLOCKED\n");
   FileWriteString(h, "Frozen Export               : BLOCKED\n");
   FileWriteString(h, "Stage 2C                    : BLOCKED\n");
   FileWriteString(h, "Stage 2D                    : BLOCKED\n");
   FileWriteString(h, line);
   FileFlush(h); FileClose(h);
   Print("STOP_PHASEB_THRESHOLD_LOCK_REPORT|", fn);
}
void S2B_RunStopPhaseB()
{
   g_s2b_stop_phaseb_ran = true;
   g_s2b_stop_phaseb_verdict = "RUNNING";
   g_s2b_stop_phaseb_block_reason = "";
   g_s2b_stop_operational_threshold_selected = false;
   g_s2b_stop_locked_rejection_pct = 0.0;
   g_s2b_stop_thr_selected_index = -1;
   g_s2b_stop_thr_row_count = 0;
   g_s2b_stop_context.threshold_selected = false;
   g_s2b_phaseb_threshold_engine_executed = false;
   // Guard stage 1: no OOF model/scoring is allowed before this passes.
   if(!S2B_PhaseBPreOOFContextLockGuard())
   {
      g_s2b_stop_phaseb_verdict = "CONTEXT_MISMATCH";
      g_s2b_stop_phaseb_block_reason = g_s2b_phaseb_guard_mismatches;
      S2B_ExportStopThresholdTradeoff();
      S2B_ExportStopThresholdLock();
      Print("STOP_PHASEB|CONTEXT_MISMATCH|Stage=PRE_OOF|ThresholdEngineExecuted=NO|Mismatches=", g_s2b_phaseb_guard_mismatches);
      return;
   }
   if(!S2B_BuildStopOOF())
   {
      g_s2b_stop_phaseb_verdict = "BLOCKED_OOF_BUILD_FAILED";
      g_s2b_stop_phaseb_block_reason = g_s2b_stop_oof_block_reason;
      S2B_ExportStopThresholdTradeoff();
      S2B_ExportStopThresholdLock();
      Print("STOP_PHASEB|BLOCKED|Reason=", g_s2b_stop_phaseb_block_reason, "|ThresholdEngineExecuted=NO");
      return;
   }
   // Guard stage 2: OOF cardinalities are checked before thresholding.
   if(!S2B_PhaseBPostOOFContextLockGuard())
   {
      g_s2b_stop_phaseb_verdict = "CONTEXT_MISMATCH";
      g_s2b_stop_phaseb_block_reason = g_s2b_phaseb_guard_mismatches;
      g_s2b_stop_operational_threshold_selected = false;
      g_s2b_stop_context.threshold_selected = false;
      S2B_ExportStopThresholdTradeoff();
      S2B_ExportStopThresholdLock();
      Print("STOP_PHASEB|CONTEXT_MISMATCH|Stage=POST_OOF_PRE_THRESHOLD|ThresholdEngineExecuted=NO|Mismatches=", g_s2b_phaseb_guard_mismatches);
      return;
   }
   g_s2b_phaseb_threshold_engine_executed = true;
   double q[S2B_PHASEB_QUANTILE_COUNT] = {0.05,0.10,0.15,0.20,0.25,0.30};
   g_s2b_stop_thr_row_count = S2B_PHASEB_QUANTILE_COUNT;
   int pass_count = 0;
   for(int i = 0; i < g_s2b_stop_thr_row_count; i++)
   {
      g_s2b_stop_thr_rows[i].Reset();
      S2B_EvaluateStopThresholdRow(q[i], g_s2b_stop_thr_rows[i]);
      S2B_PhaseBBootstrap(g_s2b_stop_thr_rows[i]);
      string reason = "NONE";
      bool pass = S2B_PhaseBApplyGate(g_s2b_stop_thr_rows[i], reason);
      g_s2b_stop_thr_rows[i].gate_pass = (pass ? 1 : 0);
      g_s2b_stop_thr_rows[i].gate_fail_reason = reason;
      if(pass)
      {
         pass_count++;
         if(g_s2b_stop_thr_selected_index < 0 || S2B_PhaseBThresholdBetter(g_s2b_stop_thr_rows[i], g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index]))
            g_s2b_stop_thr_selected_index = i;
      }
   }
   if(pass_count <= 0 || g_s2b_stop_thr_selected_index < 0)
   {
      g_s2b_stop_phaseb_verdict = "NO_VIABLE_THRESHOLD";
      g_s2b_stop_operational_threshold_selected = false;
      g_s2b_stop_context.threshold_selected = false;
   }
   else
   {
      g_s2b_stop_phaseb_verdict = "VIABLE_REJECTION_RATE_LOCKED";
      g_s2b_stop_operational_threshold_selected = true;
      g_s2b_stop_locked_rejection_pct = g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index].target_rejection_pct;
      g_s2b_stop_context.threshold_selected = true;
      g_s2b_stop_thr_rows[g_s2b_stop_thr_selected_index].policy_rank = 1;
   }
   S2B_ExportStopThresholdTradeoff();
   S2B_ExportStopThresholdLock();
   Print("STOP_PHASEB_SUMMARY|Version=", S2B_STOP_PHASEB_VERSION,
         "|CandidateLockVersion=", S2B_STOP_CANDIDATE_LOCK_VERSION,
         "|CandidateHash=", S2B_STOP_LOCKED_FEATURE_HASH,
         "|Verdict=", g_s2b_stop_phaseb_verdict,
         "|ContextLock=PASS",
         "|ThresholdEngineExecuted=YES",
         "|GatePassCount=", pass_count,
         "|OperationalThresholdSelected=", (g_s2b_stop_operational_threshold_selected?"YES":"NO"),
         "|LockedRejectionPct=", DoubleToString(g_s2b_stop_locked_rejection_pct,2),
         "|NumericProbabilityThresholdSelected=NO",
         "|HistoricalConfirmation=BLOCKED");
}
bool S2B_EvaluateSubset_WF(int &feat_indices[], int n_feat,
                           SCompactResult &out)
{
   out.Reset();
   out.n_feat = n_feat;
   for(int k = 0; k < n_feat; k++)
      out.feat_idx[k] = feat_indices[k];
   out.feat_names = S2B_BuildFeatureListString(feat_indices, n_feat);
   if(n_feat <= 0 || n_feat > S2B_COMPACT_POOL_SIZE)
      return false;
   for(int k = 0; k < n_feat; k++)
   {
      if(!S2B_IsCompactPoolFeature(feat_indices[k]))
      {
         Print("S2B_EvaluateSubset_WF: feature outside compact pool: ",
               S2B_FeatureName(feat_indices[k]));
         return false;
      }
   }
   if(!S2B_EnsureProtocolAndFoldsReady())
   {
      Print("S2B_EvaluateSubset_WF: protocol/folds not ready.");
      return false;
   }
   if(g_s2b_fold_count <= 0)
      return false;
   out.protocol_hash     = g_s2b_protocol.protocol_hash;
   out.fold_hash         = g_s2b_protocol.fold_hash;
   out.row_mask_hash     = g_s2b_protocol.row_mask_hash;
   out.dataset_hash      = g_s2b_protocol.dataset_hash;
   out.evaluator_version = S2B_EVALUATOR_VERSION;
   out.valid_row_policy  = g_s2b_protocol.valid_row_policy;
   out.feature_hash      = S2B_BuildFeatureHash(feat_indices, n_feat);
   out.eligible_count    = g_s2b_protocol.eligible_count;
   out.excluded_count    = g_s2b_protocol.excluded_count;
   out.snapshot_count    = g_s2b_protocol.snapshot_count;
   out.risklab_count     = g_s2b_protocol.risklab_count;
   out.first_entry_time  = g_s2b_protocol.first_entry_time;
   out.last_entry_time   = g_s2b_protocol.last_entry_time;
   out.fold_count = g_s2b_fold_count;
   double fold_auc[S2B_MAX_FOLDS];
   double fold_prauc[S2B_MAX_FOLDS];
   double fold_mcc[S2B_MAX_FOLDS];
   double fold_rec[S2B_MAX_FOLDS];
   double fold_f2[S2B_MAX_FOLDS];
   bool   fold_valid_local[S2B_MAX_FOLDS];
   double fold_weights[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_std[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_val_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   for(int f = 0; f < S2B_MAX_FOLDS; f++)
   {
      fold_auc[f] = 0.0;
      fold_prauc[f] = 0.0;
      fold_mcc[f] = 0.0;
      fold_rec[f] = 0.0;
      fold_f2[f] = 0.0;
      fold_valid_local[f] = false;
      for(int k = 0; k < S2B_COMPACT_POOL_SIZE; k++)
      {
         fold_weights[f][k] = 0.0;
         fold_train_mean[f][k] = 0.0;
         fold_train_std[f][k]  = 1.0;
         fold_val_mean[f][k]   = 0.0;
      }
   }
   int valid_primary = 0;
   double auc_sum = 0.0;
   double pr_sum  = 0.0;
   double mcc_sum = 0.0;
   double rec_sum = 0.0;
   double f2_sum  = 0.0;
   double auc_min = 9999.0;
   for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      out.fold_name[f]       = g_s2b_folds[f].name;
      out.fold_is_primary[f] = (g_s2b_folds[f].is_primary ? 1 : 0);
      out.fold_train_from[f] = g_s2b_folds[f].train_from;
      out.fold_train_to[f]   = g_s2b_folds[f].train_to;
      out.fold_val_from[f]   = g_s2b_folds[f].val_from;
      out.fold_val_to[f]     = g_s2b_folds[f].val_to;
      int train_rows[];
      int val_rows[];
      int n_tr = S2B_CollectProtocolMaskedRows(
         g_s2b_folds[f].train_from,
         g_s2b_folds[f].train_to,
         train_rows);
      int n_va = S2B_CollectProtocolMaskedRows(
         g_s2b_folds[f].val_from,
         g_s2b_folds[f].val_to,
         val_rows);
      int pos_tr = 0, pos_va = 0;
      double tr_sum[S2B_COMPACT_POOL_SIZE];
      double tr_sumsq[S2B_COMPACT_POOL_SIZE];
      double va_sum[S2B_COMPACT_POOL_SIZE];
      for(int k = 0; k < S2B_COMPACT_POOL_SIZE; k++)
      {
         tr_sum[k]   = 0.0;
         tr_sumsq[k] = 0.0;
         va_sum[k]   = 0.0;
      }
      for(int i = 0; i < n_tr; i++)
      {
         int rec_idx = train_rows[i];
         if(S2B_GetStep4TargetAligned(rec_idx) == 1) pos_tr++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("S2B_EvaluateSubset_WF: train row failed under common mask. rec=", rec_idx);
               return false;
            }
            tr_sum[k]   += v;
            tr_sumsq[k] += v * v;
         }
      }
      for(int i = 0; i < n_va; i++)
      {
         int rec_idx = val_rows[i];
         if(S2B_GetStep4TargetAligned(rec_idx) == 1) pos_va++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("S2B_EvaluateSubset_WF: val row failed under common mask. rec=", rec_idx);
               return false;
            }
            va_sum[k] += v;
         }
      }
      out.fold_train_n[f]   = n_tr;
      out.fold_train_pos[f] = pos_tr;
      out.fold_train_neg[f] = n_tr - pos_tr;
      out.fold_val_n[f]   = n_va;
      out.fold_val_pos[f] = pos_va;
      out.fold_val_neg[f] = n_va - pos_va;
      for(int k = 0; k < n_feat; k++)
      {
        fold_train_mean[f][k] = (n_tr > 0 ? tr_sum[k] / n_tr : 0.0);
        double var = (n_tr > 1 ? (tr_sumsq[k] / n_tr - fold_train_mean[f][k] * fold_train_mean[f][k]) : 1.0);
        fold_train_std[f][k] = (var > 1e-12 ? MathSqrt(var) : 1.0);
        fold_val_mean[f][k]  = (n_va > 0 ? va_sum[k] / n_va : 0.0);
      }
      if(n_tr < 50 || pos_tr < 10 || n_va < 20 || pos_va < 3)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      SStage2B_ModelParams fold_mdl;
      bool trained = S2B_TrainLogistic_OnRows(
         feat_indices, n_feat,
         train_rows, n_tr,
         fold_mdl,
         4000, 0.05, 0.01);
      if(!trained || !fold_mdl.trained)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      for(int k = 0; k < n_feat; k++)
         fold_weights[f][k] = fold_mdl.weights[k];
      out.fold_coeff_signs[f] = S2B_BuildCoeffSignString(fold_mdl);
      double tr_auc=0.5, tr_prauc=0.0, tr_mcc=0.0, tr_prec=0.0, tr_rec=0.0, tr_f2=0.0;
      int tr_n=0, tr_pos_eval=0;
      double tr_mean_pos=0.0, tr_mean_neg=0.0;
      bool train_eval_ok = S2B_EvalModel_OnRows(
         fold_mdl,
         train_rows, n_tr,
         tr_auc, tr_prauc, tr_mcc, tr_prec, tr_rec, tr_f2, tr_n, tr_pos_eval,
         tr_mean_pos, tr_mean_neg);
      double va_auc=0.5, va_prauc=0.0, va_mcc=0.0, va_prec=0.0, va_rec=0.0, va_f2=0.0;
      int va_n=0, va_pos_eval=0;
      double va_mean_pos=0.0, va_mean_neg=0.0;
      bool eval_ok = S2B_EvalModel_OnRows(
         fold_mdl,
         val_rows, n_va,
         va_auc, va_prauc, va_mcc, va_prec, va_rec, va_f2, va_n, va_pos_eval,
         va_mean_pos, va_mean_neg);
      ArrayFree(train_rows);
      ArrayFree(val_rows);
      if(!eval_ok || va_n < 20 || va_pos_eval < 3)
      {
         out.fold_valid[f] = 0;
         continue;
      }
      out.fold_train_auc[f] = (train_eval_ok ? tr_auc : 0.0);
      out.fold_train_mean_score_pos[f] = tr_mean_pos;
      out.fold_train_mean_score_neg[f] = tr_mean_neg;
      out.fold_val_mean_score_pos[f]   = va_mean_pos;
      out.fold_val_mean_score_neg[f]   = va_mean_neg;
      fold_auc[f]   = va_auc;
      fold_prauc[f] = va_prauc;
      fold_mcc[f]   = va_mcc;
      fold_rec[f]   = va_rec;
      fold_f2[f]    = va_f2;
      fold_valid_local[f] = true;
      out.fold_valid[f]   = 1;
      out.fold_auc[f]    = va_auc;
      out.fold_prauc[f]  = va_prauc;
      out.fold_mcc[f]    = va_mcc;
      out.fold_recall[f] = va_rec;
      out.fold_f2[f]     = va_f2;
      if(g_s2b_folds[f].is_primary)
      {
         valid_primary++;
         auc_sum += va_auc;
         pr_sum  += va_prauc;
         mcc_sum += va_mcc;
         rec_sum += va_rec;
         f2_sum  += va_f2;
         if(va_auc < auc_min) auc_min = va_auc;
      }
   }
   out.valid_primary_folds = valid_primary;
   if(valid_primary < 1)
      return false;
   out.wf_mean_auc    = auc_sum / valid_primary;
   out.wf_mean_prauc  = pr_sum  / valid_primary;
   out.wf_mean_mcc    = mcc_sum / valid_primary;
   out.wf_mean_recall = rec_sum / valid_primary;
   out.wf_mean_f2     = f2_sum  / valid_primary;
   out.wf_worst_auc   = auc_min;
   double auc_var = 0.0;
   for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(!fold_valid_local[f]) continue;
      if(!g_s2b_folds[f].is_primary) continue;
      auc_var += MathPow(fold_auc[f] - out.wf_mean_auc, 2);
   }
   out.wf_std_auc = (valid_primary > 1) ? MathSqrt(auc_var / valid_primary) : 0.0;
   out.sign_flip_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      bool first_set = false;
      bool first_pos = false;
      bool flip = false;
      for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f]) continue;
         if(!g_s2b_folds[f].is_primary) continue;
         bool is_pos = (fold_weights[f][k] >= 0.0);
         if(!first_set)
         {
            first_pos = is_pos;
            first_set = true;
         }
         else if(is_pos != first_pos)
         {
            flip = true;
            break;
         }
      }
      if(flip) out.sign_flip_count++;
   }
   out.large_drift_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      int drift_hits = 0;
      for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f]) continue;
         if(!g_s2b_folds[f].is_primary) continue;
         double std_tr = fold_train_std[f][k];
         if(std_tr < 1e-10) std_tr = 1.0;
         double drift_abs = MathAbs((fold_val_mean[f][k] - fold_train_mean[f][k]) / std_tr);
         if(drift_abs > 0.8)
            drift_hits++;
      }
      if(drift_hits > 0)
         out.large_drift_count++;
   }
   int dev_rows[];
   int n_dev = S2B_CollectProtocolMaskedRows(
      g_s2b_protocol.dev_from,
      g_s2b_protocol.dev_to,
      dev_rows);
   SStage2B_ModelParams dev_mdl;
   bool dev_fit_ok = false;
   if(n_dev >= 20)
   {
      dev_fit_ok = S2B_TrainLogistic_OnRows(
         feat_indices, n_feat,
         dev_rows, n_dev,
         dev_mdl,
         5000, 0.05, 0.01);
   }
   ArrayFree(dev_rows);
   if(dev_fit_ok && dev_mdl.trained)
      out.dev_auc = dev_mdl.dev_auc;
   else
      out.dev_auc = 0.0;
   out.oos_auc = 0.0;
   out.oos_gap = 0.0;
   string abs_reason = "";
   out.abs_gate_pass = S2B_PassAbsoluteGate(out, abs_reason);
   out.abs_gate_reason = abs_reason;
   bool pass_rel = true;
   if(g_s2b_baseline_wf_valid)
      pass_rel = (out.wf_mean_auc >= g_s2b_baseline_wf_mean_auc + 0.005);
   out.accepted = (out.abs_gate_pass && pass_rel);
   double rel_base = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_mean_auc : 0.55;
   out.composite_score =
      100.0 * out.wf_mean_auc
      - 20.0 * out.wf_std_auc
      - 10.0 * out.sign_flip_count
      -  5.0 * out.large_drift_count
      -  0.7 * n_feat
      + 40.0 * (out.wf_mean_auc - rel_base);
   return true;
}
bool S2B_EvaluateSubset_WF_Stop(int &feat_indices[], int n_feat,
                                SCompactResult &out)
{
   out.Reset();
   out.n_feat = n_feat;
   if(n_feat <= 0 || n_feat > S2B_COMPACT_POOL_SIZE)
      return false;
   for(int k = 0; k < n_feat; k++)
   {
      out.feat_idx[k] = feat_indices[k];
      if(!S2B_IsStopCompactPoolFeature(feat_indices[k]))
      {
         Print("S2B_EvaluateSubset_WF_Stop: feature outside Stop pool: ",
               S2B_FeatureName(feat_indices[k]));
         return false;
      }
   }
   out.feat_names = S2B_BuildFeatureListString(feat_indices, n_feat);
   if(!g_s2b_stop_context.valid)
   {
      if(!S2B_InitStopEvaluationContext())
         return false;
   }
   out.protocol_hash = g_s2b_stop_context.shared_protocol_hash;
   out.fold_hash = g_s2b_stop_context.fold_hash;
   out.row_mask_hash = g_s2b_stop_context.row_mask_hash;
   out.dataset_hash = g_s2b_stop_context.dataset_hash;
   out.evaluator_version = g_s2b_stop_context.evaluator_version;
   out.valid_row_policy = g_s2b_stop_context.valid_row_policy;
   out.feature_hash = S2B_BuildFeatureHash(feat_indices, n_feat);
   out.evaluation_context_hash = g_s2b_stop_context.evaluation_context_hash;
   out.target_hash = g_s2b_stop_context.target_hash;
   out.pool_hash = g_s2b_stop_context.pool_hash;
   out.row_policy_hash = g_s2b_stop_context.row_policy_hash;
   out.eligible_count = g_s2b_stop_context.eligible_count;
   out.excluded_count = g_s2b_stop_context.excluded_count;
   out.snapshot_count = g_s2b_protocol.snapshot_count;
   out.risklab_count = g_s2b_protocol.risklab_count;
   out.first_entry_time = g_s2b_protocol.first_entry_time;
   out.last_entry_time = g_s2b_protocol.last_entry_time;
   out.fold_count = g_s2b_fold_count;
   double fold_auc[S2B_MAX_FOLDS];
   bool fold_valid_local[S2B_MAX_FOLDS];
   double fold_weights[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_train_std[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   double fold_val_mean[S2B_MAX_FOLDS][S2B_COMPACT_POOL_SIZE];
   for(int f = 0; f < S2B_MAX_FOLDS; f++)
   {
      fold_auc[f] = 0.0;
      fold_valid_local[f] = false;
      for(int k = 0; k < S2B_COMPACT_POOL_SIZE; k++)
      {
         fold_weights[f][k] = 0.0;
         fold_train_mean[f][k] = 0.0;
         fold_train_std[f][k] = 1.0;
         fold_val_mean[f][k] = 0.0;
      }
   }
   int valid_primary = 0;
   double auc_sum = 0.0;
   double pr_sum = 0.0;
   double pr_lift_sum = 0.0;
   double mcc_sum = 0.0;
   double rec_sum = 0.0;
   double f2_sum = 0.0;
   double auc_min = 9999.0;
   for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      out.fold_name[f] = g_s2b_folds[f].name;
      out.fold_is_primary[f] = (g_s2b_folds[f].is_primary ? 1 : 0);
      out.fold_train_from[f] = g_s2b_folds[f].train_from;
      out.fold_train_to[f] = g_s2b_folds[f].train_to;
      out.fold_val_from[f] = g_s2b_folds[f].val_from;
      out.fold_val_to[f] = g_s2b_folds[f].val_to;
      int train_rows[];
      int val_rows[];
      int n_tr = S2B_CollectStopMaskedRows(
         g_s2b_folds[f].train_from, g_s2b_folds[f].train_to, train_rows);
      int n_va = S2B_CollectStopMaskedRows(
         g_s2b_folds[f].val_from, g_s2b_folds[f].val_to, val_rows);
      int pos_tr = 0;
      int pos_va = 0;
      double tr_sum[S2B_COMPACT_POOL_SIZE];
      double tr_sumsq[S2B_COMPACT_POOL_SIZE];
      double va_sum[S2B_COMPACT_POOL_SIZE];
      ArrayInitialize(tr_sum, 0.0);
      ArrayInitialize(tr_sumsq, 0.0);
      ArrayInitialize(va_sum, 0.0);
      for(int i = 0; i < n_tr; i++)
      {
         int rec_idx = train_rows[i];
         if(S2B_GetStopTargetAligned(rec_idx) == 1) pos_tr++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("STOP_CONTEXT invariant failure in train row=", rec_idx);
               return false;
            }
            tr_sum[k] += v;
            tr_sumsq[k] += v * v;
         }
      }
      for(int i = 0; i < n_va; i++)
      {
         int rec_idx = val_rows[i];
         if(S2B_GetStopTargetAligned(rec_idx) == 1) pos_va++;
         for(int k = 0; k < n_feat; k++)
         {
            double v = 0.0;
            if(!S2B_GetFeatureValue(rec_idx, feat_indices[k], v))
            {
               ArrayFree(train_rows);
               ArrayFree(val_rows);
               Print("STOP_CONTEXT invariant failure in validation row=", rec_idx);
               return false;
            }
            va_sum[k] += v;
         }
      }
      out.fold_train_n[f] = n_tr;
      out.fold_train_pos[f] = pos_tr;
      out.fold_train_neg[f] = n_tr - pos_tr;
      out.fold_val_n[f] = n_va;
      out.fold_val_pos[f] = pos_va;
      out.fold_val_neg[f] = n_va - pos_va;
      out.fold_val_prevalence[f] = (n_va > 0 ? (double)pos_va / n_va : 0.0);
      out.fold_low_positive_sample[f] = ((pos_tr < 10 || pos_va < 5) ? 1 : 0);
      for(int k = 0; k < n_feat; k++)
      {
         fold_train_mean[f][k] = (n_tr > 0 ? tr_sum[k] / n_tr : 0.0);
         double var = (n_tr > 1
                       ? tr_sumsq[k] / n_tr - fold_train_mean[f][k] * fold_train_mean[f][k]
                       : 1.0);
         fold_train_std[f][k] = (var > 1e-12 ? MathSqrt(var) : 1.0);
         fold_val_mean[f][k] = (n_va > 0 ? va_sum[k] / n_va : 0.0);
      }
      if(n_tr < 50 || pos_tr < 5 || n_va < 20 || pos_va < 3)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      SStage2B_ModelParams fold_mdl;
      bool trained = S2B_TrainLogistic_OnRows_Stop(
         feat_indices, n_feat, train_rows, n_tr, fold_mdl, 4000, 0.05, 0.01);
      if(!trained || !fold_mdl.trained)
      {
         out.fold_valid[f] = 0;
         ArrayFree(train_rows);
         ArrayFree(val_rows);
         continue;
      }
      for(int k = 0; k < n_feat; k++)
         fold_weights[f][k] = fold_mdl.weights[k];
      out.fold_coeff_signs[f] = S2B_BuildCoeffSignString(fold_mdl);
      double tr_auc=0.5, tr_prauc=0.0, tr_mcc=0.0, tr_prec=0.0, tr_rec=0.0, tr_f2=0.0;
      int tr_n=0, tr_pos_eval=0;
      double tr_mean_pos=0.0, tr_mean_neg=0.0;
      bool train_eval_ok = S2B_EvalModel_OnRows_Stop(
         fold_mdl, train_rows, n_tr,
         tr_auc, tr_prauc, tr_mcc, tr_prec, tr_rec, tr_f2,
         tr_n, tr_pos_eval, tr_mean_pos, tr_mean_neg);
      double va_auc=0.5, va_prauc=0.0, va_mcc=0.0, va_prec=0.0, va_rec=0.0, va_f2=0.0;
      int va_n=0, va_pos_eval=0;
      double va_mean_pos=0.0, va_mean_neg=0.0;
      bool eval_ok = S2B_EvalModel_OnRows_Stop(
         fold_mdl, val_rows, n_va,
         va_auc, va_prauc, va_mcc, va_prec, va_rec, va_f2,
         va_n, va_pos_eval, va_mean_pos, va_mean_neg);
      ArrayFree(train_rows);
      ArrayFree(val_rows);
      if(!train_eval_ok || !eval_ok || va_n < 20 || va_pos_eval < 3)
      {
         out.fold_valid[f] = 0;
         continue;
      }
      double prevalence = (va_n > 0 ? (double)va_pos_eval / va_n : 0.0);
      double pr_lift = (prevalence > 0.0 ? va_prauc / prevalence : 0.0);
      out.fold_train_auc[f] = tr_auc;
      out.fold_auc[f] = va_auc;
      out.fold_auc_gap[f] = tr_auc - va_auc;
      out.fold_prauc[f] = va_prauc;
      out.fold_pr_lift[f] = pr_lift;
      out.fold_precision[f] = va_prec;
      out.fold_mcc[f] = va_mcc;
      out.fold_recall[f] = va_rec;
      out.fold_f2[f] = va_f2;
      out.fold_val_prevalence[f] = prevalence;
      out.fold_train_mean_score_pos[f] = tr_mean_pos;
      out.fold_train_mean_score_neg[f] = tr_mean_neg;
      out.fold_val_mean_score_pos[f] = va_mean_pos;
      out.fold_val_mean_score_neg[f] = va_mean_neg;
      fold_auc[f] = va_auc;
      fold_valid_local[f] = true;
      out.fold_valid[f] = 1;
      if(g_s2b_folds[f].is_primary)
      {
         valid_primary++;
         auc_sum += va_auc;
         pr_sum += va_prauc;
         pr_lift_sum += pr_lift;
         mcc_sum += va_mcc;
         rec_sum += va_rec;
         f2_sum += va_f2;
         if(va_auc < auc_min) auc_min = va_auc;
      }
   }
   out.valid_primary_folds = valid_primary;
   if(valid_primary < 1)
      return false;
   out.wf_mean_auc = auc_sum / valid_primary;
   out.wf_worst_auc = auc_min;
   out.wf_mean_prauc = pr_sum / valid_primary;
   out.wf_mean_pr_lift = pr_lift_sum / valid_primary;
   out.wf_mean_mcc = mcc_sum / valid_primary;
   out.wf_mean_recall = rec_sum / valid_primary;
   out.wf_mean_f2 = f2_sum / valid_primary;
   double auc_var = 0.0;
   for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
   {
      if(!fold_valid_local[f] || !g_s2b_folds[f].is_primary) continue;
      auc_var += MathPow(fold_auc[f] - out.wf_mean_auc, 2);
   }
   out.wf_std_auc = (valid_primary > 1 ? MathSqrt(auc_var / valid_primary) : 0.0);
   out.sign_flip_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      bool first_set = false;
      bool first_pos = false;
      bool flip = false;
      for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f] || !g_s2b_folds[f].is_primary) continue;
         bool is_pos = (fold_weights[f][k] >= 0.0);
         if(!first_set)
         {
            first_set = true;
            first_pos = is_pos;
         }
         else if(is_pos != first_pos)
         {
            flip = true;
            break;
         }
      }
      if(flip) out.sign_flip_count++;
   }
   out.large_drift_count = 0;
   for(int k = 0; k < n_feat; k++)
   {
      int drift_hits = 0;
      for(int f = 0; f < g_s2b_fold_count && f < S2B_MAX_FOLDS; f++)
      {
         if(!fold_valid_local[f] || !g_s2b_folds[f].is_primary) continue;
         double std_tr = fold_train_std[f][k];
         if(std_tr < 1e-10) std_tr = 1.0;
         double drift_abs = MathAbs((fold_val_mean[f][k] - fold_train_mean[f][k]) / std_tr);
         if(drift_abs > 0.8) drift_hits++;
      }
      if(drift_hits > 0) out.large_drift_count++;
   }
   int dev_rows[];
   int n_dev = S2B_CollectStopMaskedRows(
      g_s2b_stop_context.development_from,
      g_s2b_stop_context.development_to,
      dev_rows);
   SStage2B_ModelParams dev_mdl;
   bool dev_fit_ok = false;
   if(n_dev >= 20)
      dev_fit_ok = S2B_TrainLogistic_OnRows_Stop(
         feat_indices, n_feat, dev_rows, n_dev, dev_mdl, 5000, 0.05, 0.01);
   ArrayFree(dev_rows);
   out.dev_auc = (dev_fit_ok && dev_mdl.trained ? dev_mdl.dev_auc : 0.0);
   out.oos_auc = 0.0;
   out.oos_gap = 0.0;
   string abs_reason = "";
   out.abs_gate_pass = S2B_PassAbsoluteGate(out, abs_reason);
   out.abs_gate_reason = (out.abs_gate_pass ? "PASS" : abs_reason);
   // Selection policy is applied only after all candidates are evaluated.
   out.relative_gate_pass = false;
   out.reject_reason = (out.abs_gate_pass
                        ? "PENDING_DETERMINISTIC_SELECTION_POLICY"
                        : "ABSOLUTE_GATE_FAILED|" + abs_reason);
   out.selected_by_policy = false;
   out.selection_rank = 0;
   out.selection_reason = "";
   out.accepted = false;
   // Informational only; never used for candidate ordering or locking.
   out.composite_score =
      100.0 * out.wf_mean_auc
      - 20.0 * out.wf_std_auc
      - 10.0 * out.sign_flip_count
      - 5.0 * out.large_drift_count
      - 0.7 * n_feat;
   return true;
}
void S2B_CopyCompactResultToWFMetrics(SCompactResult &src, SS2BWFMetrics &dst)
{
   dst.Reset();
   dst.valid = (src.valid_primary_folds > 0);
   dst.invalid_reason = (dst.valid ? "" : "NO_VALID_PRIMARY_FOLDS");
   dst.protocol_hash = src.protocol_hash;
   dst.fold_hash     = src.fold_hash;
   dst.feature_hash  = src.feature_hash;
   dst.dataset_hash  = src.dataset_hash;
   dst.row_mask_hash = src.row_mask_hash;
   dst.evaluator_version = src.evaluator_version;
   dst.target_name       = "HitStep4Plus";
   dst.target_definition = "actual_max_step >= 4";
   dst.higher_score_higher_positive = true;
   dst.valid_row_policy  = src.valid_row_policy;
   dst.snapshot_count    = src.snapshot_count;
   dst.risklab_count     = src.risklab_count;
   dst.first_entry_time  = src.first_entry_time;
   dst.last_entry_time   = src.last_entry_time;
   dst.feature_list      = src.feat_names;
   dst.n_features        = src.n_feat;
   dst.eligible_count    = src.eligible_count;
   dst.excluded_count    = src.excluded_count;
   dst.fold_count           = src.fold_count;
   dst.valid_primary_folds  = src.valid_primary_folds;
   dst.mean_auc    = src.wf_mean_auc;
   dst.worst_auc   = src.wf_worst_auc;
   dst.std_auc     = src.wf_std_auc;
   dst.mean_prauc  = src.wf_mean_prauc;
   dst.mean_mcc    = src.wf_mean_mcc;
   dst.mean_recall = src.wf_mean_recall;
   dst.mean_f2     = src.wf_mean_f2;
   dst.sign_flips  = src.sign_flip_count;
   dst.large_drift = src.large_drift_count;
   for(int i = 0; i < S2B_MAX_FOLDS; i++)
   {
      dst.fold_name[i]       = src.fold_name[i];
      dst.fold_valid[i]      = src.fold_valid[i];
      dst.fold_primary[i]    = src.fold_is_primary[i];
      dst.fold_train_from[i] = src.fold_train_from[i];
      dst.fold_train_to[i]   = src.fold_train_to[i];
      dst.fold_val_from[i]   = src.fold_val_from[i];
      dst.fold_val_to[i]     = src.fold_val_to[i];
      dst.fold_train_n[i]    = src.fold_train_n[i];
      dst.fold_train_pos[i]  = src.fold_train_pos[i];
      dst.fold_train_neg[i]  = src.fold_train_neg[i];
      dst.fold_val_n[i]      = src.fold_val_n[i];
      dst.fold_val_pos[i]    = src.fold_val_pos[i];
      dst.fold_val_neg[i]    = src.fold_val_neg[i];
      dst.fold_auc[i]        = src.fold_auc[i];
      dst.fold_prauc[i]      = src.fold_prauc[i];
      dst.fold_mcc[i]        = src.fold_mcc[i];
      dst.fold_recall[i]     = src.fold_recall[i];
      dst.fold_f2[i]         = src.fold_f2[i];
   }
   // OOS not evaluated in Stage 2B search/baseline path yet
   dst.normalization_hash = "DEV_ONLY_BASELINE";
   dst.model_hash         = "WF_ONLY_BASELINE";
   dst.threshold_source   = "DEV_ONLY_BASELINE";
   dst.oos_auc    = 0.0;
   dst.oos_prauc  = 0.0;
   dst.oos_mcc    = 0.0;
   dst.oos_recall = 0.0;
   dst.oos_f2     = 0.0;
   dst.oos_n      = 0;
   dst.oos_pos    = 0;
   dst.oos_neg    = 0;
}
void S2B_CopyCompactResultToWFMetrics_CustomTarget(SCompactResult &src,
                                                   SS2BWFMetrics &dst,
                                                   string target_name,
                                                   string target_definition)
{
   dst.Reset();
   dst.valid = (src.valid_primary_folds > 0);
   dst.invalid_reason = (dst.valid ? "" : "NO_VALID_PRIMARY_FOLDS");
   dst.protocol_hash = src.protocol_hash;
   dst.fold_hash     = src.fold_hash;
   dst.feature_hash  = src.feature_hash;
   dst.dataset_hash  = src.dataset_hash;
   dst.row_mask_hash = src.row_mask_hash;
   dst.evaluator_version = src.evaluator_version;
   dst.target_name       = target_name;
   dst.target_definition = target_definition;
   dst.higher_score_higher_positive = true;
   dst.valid_row_policy  = src.valid_row_policy;
   dst.snapshot_count    = src.snapshot_count;
   dst.risklab_count     = src.risklab_count;
   dst.first_entry_time  = src.first_entry_time;
   dst.last_entry_time   = src.last_entry_time;
   dst.feature_list      = src.feat_names;
   dst.n_features        = src.n_feat;
   dst.eligible_count    = src.eligible_count;
   dst.excluded_count    = src.excluded_count;
   dst.fold_count          = src.fold_count;
   dst.valid_primary_folds = src.valid_primary_folds;
   dst.mean_auc    = src.wf_mean_auc;
   dst.worst_auc   = src.wf_worst_auc;
   dst.std_auc     = src.wf_std_auc;
   dst.mean_prauc  = src.wf_mean_prauc;
   dst.mean_mcc    = src.wf_mean_mcc;
   dst.mean_recall = src.wf_mean_recall;
   dst.mean_f2     = src.wf_mean_f2;
   dst.sign_flips  = src.sign_flip_count;
   dst.large_drift = src.large_drift_count;
   for(int i = 0; i < S2B_MAX_FOLDS; i++)
   {
      dst.fold_name[i]       = src.fold_name[i];
      dst.fold_valid[i]      = src.fold_valid[i];
      dst.fold_primary[i]    = src.fold_is_primary[i];
      dst.fold_train_from[i] = src.fold_train_from[i];
      dst.fold_train_to[i]   = src.fold_train_to[i];
      dst.fold_val_from[i]   = src.fold_val_from[i];
      dst.fold_val_to[i]     = src.fold_val_to[i];
      dst.fold_train_n[i]    = src.fold_train_n[i];
      dst.fold_train_pos[i]  = src.fold_train_pos[i];
      dst.fold_train_neg[i]  = src.fold_train_neg[i];
      dst.fold_val_n[i]      = src.fold_val_n[i];
      dst.fold_val_pos[i]    = src.fold_val_pos[i];
      dst.fold_val_neg[i]    = src.fold_val_neg[i];
      dst.fold_auc[i]        = src.fold_auc[i];
      dst.fold_prauc[i]      = src.fold_prauc[i];
      dst.fold_mcc[i]        = src.fold_mcc[i];
      dst.fold_recall[i]     = src.fold_recall[i];
      dst.fold_f2[i]         = src.fold_f2[i];
   }
   dst.normalization_hash = "DEV_ONLY_BASELINE";
   dst.model_hash         = "WF_ONLY_BASELINE";
   dst.threshold_source   = "DEV_ONLY_BASELINE";
   dst.oos_auc    = 0.0;
   dst.oos_prauc  = 0.0;
   dst.oos_mcc    = 0.0;
   dst.oos_recall = 0.0;
   dst.oos_f2     = 0.0;
   dst.oos_n      = 0;
   dst.oos_pos    = 0;
   dst.oos_neg    = 0;
}
int S2B_GenerateSubsets(int min_feat, int max_feat,
                        int &subsets[][8],
                        int &subset_sizes[],
                        int max_subsets)
{
   int cnt = 0;
   int n = 8;
   for(int sz = min_feat; sz <= max_feat; sz++)
   {
      for(int mask = 0; mask < (1 << n); mask++)
      {
         if(cnt >= max_subsets) break;
         int bits = 0;
         for(int b = 0; b < n; b++)
         {
            if(((mask >> b) & 1) != 0)
               bits++;
         }
         if(bits != sz) continue;
         subset_sizes[cnt] = sz;
         int ki = 0;
         for(int b = 0; b < n; b++)
         {
            if(((mask >> b) & 1) != 0)
               subsets[cnt][ki++] = b;
         }
         cnt++;
      }
   }
   return cnt;
}
void S2B_RunSystematicCompactSearch(int min_feat = 4, int max_feat = 6)
{
   Print("=== Systematic Compact Search START ===");
   Print("  Feature pool size: 8");
   Print("  Subset sizes: ", min_feat, " to ", max_feat);
   if(!g_s2b_baseline_wf_valid)
   {
      Print("ERROR: baseline WF metrics are not valid. Run S2B_RunWalkForward_Step4_v2 first.");
      g_compact_result_count = 0;
      return;
   }
   if(!g_s2b_selftest_passed)
   {
      Print("ALIGNMENT_ERROR");
      Print("Compact Search BLOCKED — baseline self-test failed.");
      g_compact_result_count = 0;
      S2B_BlockPipeline("SEARCH_BLOCKED_SELFTEST_FAIL");
      return;
   }
   int core_feats[8] = {
      S2B_F_EMA200_DIST_M1, S2B_F_DI_GAP_M5,
      S2B_F_ADX_SLOPE_H1,   S2B_F_ADX_M30,
      S2B_F_ADX_SLOPE_M15,  S2B_F_SIGNAL_CLV,
      S2B_F_EMA_COMP_H4,    S2B_F_OB_DIST_PCT
   };
   int MAX_SS = 256;
   int ss_idx[][8];
   int ss_sizes[];
   ArrayResize(ss_idx,   MAX_SS);
   ArrayResize(ss_sizes, MAX_SS);
   for(int i = 0; i < MAX_SS; i++)
      for(int k = 0; k < 8; k++)
         ss_idx[i][k] = -1;
   ArrayInitialize(ss_sizes, 0);
   int total_ss = S2B_GenerateSubsets(min_feat, max_feat, ss_idx, ss_sizes, MAX_SS);
   Print("  Total subsets to evaluate: ", total_ss);
   ArrayResize(g_compact_results, total_ss + 1);
   g_compact_result_count = 0;
   for(int s = 0; s < total_ss; s++)
   {
      int actual_feats[8];
      int n = ss_sizes[s];
      for(int k = 0; k < n; k++)
         actual_feats[k] = core_feats[ss_idx[s][k]];
      SCompactResult res;
      bool ok = S2B_EvaluateSubset_WF(actual_feats, n, res);
      if(!ok)
         res.Reset();
      g_compact_results[g_compact_result_count++] = res;
      if(ok && !res.abs_gate_pass)
      {
         Print("Compact Search Candidate rejected by Absolute Gate | Features=",
               res.feat_names, " | Reason=", res.abs_gate_reason);
      }
      if((s + 1) % 25 == 0 || s == total_ss - 1)
         Print("  Progress: ", (s + 1), "/", total_ss);
   }
   int gap = g_compact_result_count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < g_compact_result_count; i++)
      {
         SCompactResult tmp = g_compact_results[i];
         int j = i;
         while(j >= gap && g_compact_results[j-gap].composite_score < tmp.composite_score)
         {
            g_compact_results[j] = g_compact_results[j-gap];
            j -= gap;
         }
         g_compact_results[j] = tmp;
      }
      gap /= 2;
   }
   int acc = 0;
   for(int i = 0; i < g_compact_result_count; i++)
      if(g_compact_results[i].accepted) acc++;
   Print("  Evaluated: ", g_compact_result_count, " subsets");
   Print("  Accepted: ", acc);
   if(g_compact_result_count > 0)
      Print("  Top composite score: ", DoubleToString(g_compact_results[0].composite_score, 2));
   Print("=== Systematic Compact Search DONE ===");
}
bool S2B_StopCandidateBetter(SCompactResult &a, SCompactResult &b)
{
   if(a.abs_gate_pass != b.abs_gate_pass)
      return a.abs_gate_pass;
   double eps = 1e-12;
   if(MathAbs(a.wf_worst_auc - b.wf_worst_auc) > eps)
      return (a.wf_worst_auc > b.wf_worst_auc);
   if(MathAbs(a.wf_std_auc - b.wf_std_auc) > eps)
      return (a.wf_std_auc < b.wf_std_auc);
   if(MathAbs(a.wf_mean_pr_lift - b.wf_mean_pr_lift) > eps)
      return (a.wf_mean_pr_lift > b.wf_mean_pr_lift);
   if(a.n_feat != b.n_feat)
      return (a.n_feat < b.n_feat);
   if(MathAbs(a.wf_mean_auc - b.wf_mean_auc) > eps)
      return (a.wf_mean_auc > b.wf_mean_auc);
   return (StringCompare(a.feature_hash, b.feature_hash) < 0);
}
void S2B_ApplyStopSelectionPolicy()
{
   g_s2b_stop_selected_result_index = -1;
   g_s2b_stop_candidate_selected = false;
   g_s2b_stop_selected_candidate_wf.Reset();
   for(int i = 0; i < g_compact_stop_result_count; i++)
   {
      g_compact_stop_results[i].selected_by_policy = false;
      g_compact_stop_results[i].selection_rank = 0;
      g_compact_stop_results[i].selection_reason = "";
      g_compact_stop_results[i].relative_gate_pass = false;
      g_compact_stop_results[i].accepted = false;
      if(g_compact_stop_results[i].abs_gate_pass)
         g_compact_stop_results[i].reject_reason = "NOT_SELECTED_BY_DETERMINISTIC_POLICY";
      else
         g_compact_stop_results[i].reject_reason =
            "ABSOLUTE_GATE_FAILED|" + g_compact_stop_results[i].abs_gate_reason;
   }
   int eligible_rank = 0;
   for(int i = 0; i < g_compact_stop_result_count; i++)
   {
      if(!g_compact_stop_results[i].abs_gate_pass) continue;
      eligible_rank++;
      g_compact_stop_results[i].selection_rank = eligible_rank;
   }
   if(g_compact_stop_result_count <= 0 ||
      !g_compact_stop_results[0].abs_gate_pass)
   {
      g_s2b_stop_block_reason = "NO_CANDIDATE_PASSED_ABSOLUTE_GATE";
      Print("STOP_SELECTION_POLICY|NO_LOCK|Reason=", g_s2b_stop_block_reason,
            "|HistoricalConfirmationUsed=NO|ThresholdSelected=NO");
      return;
   }
   g_s2b_stop_selected_result_index = 0;
   SCompactResult selected = g_compact_stop_results[0];
   selected.selected_by_policy = true;
   selected.selection_rank = 1;
   selected.selection_reason =
      "ABS_GATE>WORST_AUC>STD_AUC>MEAN_PR_LIFT>FEWER_FEATURES>MEAN_AUC>FEATURE_HASH";
   selected.relative_gate_pass = true;
   selected.reject_reason = "NONE_SELECTED_BY_POLICY";
   selected.accepted = true;
   g_compact_stop_results[0] = selected;
   g_s2b_stop_candidate_selected = true;
   g_s2b_stop_block_reason = "PHASE_A_LOCKED_PHASE_B_NOT_AUTHORIZED";
   S2B_CopyCompactResultToWFMetrics_CustomTarget(
      g_compact_stop_results[0],
      g_s2b_stop_selected_candidate_wf,
      "StopFlag",
      "rec.stop_flag == true");
   Print("STOP_SELECTION_POLICY|LOCKED",
         "|Rank=1",
         "|FeatureHash=", g_compact_stop_results[0].feature_hash,
         "|Features=", g_compact_stop_results[0].feat_names,
         "|WorstAUC=", DoubleToString(g_compact_stop_results[0].wf_worst_auc, 6),
         "|StdAUC=", DoubleToString(g_compact_stop_results[0].wf_std_auc, 6),
         "|MeanPRLift=", DoubleToString(g_compact_stop_results[0].wf_mean_pr_lift, 6),
         "|NFeat=", g_compact_stop_results[0].n_feat,
         "|MeanAUC=", DoubleToString(g_compact_stop_results[0].wf_mean_auc, 6),
         "|HistoricalConfirmationUsed=NO",
         "|ThresholdSelected=NO");
}
void S2B_RunSystematicCompactSearch_Stop(int min_feat = 4, int max_feat = 6)
{
   Print("=== StopFlag Compact Search Phase A START ===");
   g_s2b_stop_candidate_selected = false;
   g_s2b_stop_selected_result_index = -1;
   if(!g_s2b_stop_search_allowed || !g_s2b_stop_context.valid)
   {
      Print("StopFlag Compact Search blocked: Stop context/search not ready.");
      g_compact_stop_result_count = 0;
      return;
   }
   int stop_feats[];
   S2B_FillStopCompactPoolFeatures(stop_feats);
   int MAX_SS = 256;
   int ss_idx[][8];
   int ss_sizes[];
   ArrayResize(ss_idx, MAX_SS);
   ArrayResize(ss_sizes, MAX_SS);
   for(int i = 0; i < MAX_SS; i++)
      for(int k = 0; k < 8; k++)
         ss_idx[i][k] = -1;
   ArrayInitialize(ss_sizes, 0);
   int total_ss = S2B_GenerateSubsets(min_feat, max_feat, ss_idx, ss_sizes, MAX_SS);
   ArrayResize(g_compact_stop_results, total_ss);
   g_compact_stop_result_count = 0;
   for(int subset = 0; subset < total_ss; subset++)
   {
      int actual_feats[8];
      int n = ss_sizes[subset];
      for(int k = 0; k < n; k++)
         actual_feats[k] = stop_feats[ss_idx[subset][k]];
      SCompactResult res;
      bool ok = S2B_EvaluateSubset_WF_Stop(actual_feats, n, res);
      if(!ok)
      {
         res.Reset();
         res.n_feat = n;
         res.reject_reason = "EVALUATION_FAILED";
      }
      g_compact_stop_results[g_compact_stop_result_count++] = res;
      if((subset + 1) % 25 == 0 || subset == total_ss - 1)
         Print("  Stop Search Progress: ", subset + 1, "/", total_ss);
   }
   // Deterministic policy sort. composite_score is intentionally ignored.
   int gap = g_compact_stop_result_count / 2;
   while(gap > 0)
   {
      for(int i = gap; i < g_compact_stop_result_count; i++)
      {
         SCompactResult tmp = g_compact_stop_results[i];
         int j = i;
         while(j >= gap && S2B_StopCandidateBetter(tmp, g_compact_stop_results[j-gap]))
         {
            g_compact_stop_results[j] = g_compact_stop_results[j-gap];
            j -= gap;
         }
         g_compact_stop_results[j] = tmp;
      }
      gap /= 2;
   }
   S2B_ApplyStopSelectionPolicy();
   ArrayFree(stop_feats);
   int abs_pass_count = 0;
   for(int i = 0; i < g_compact_stop_result_count; i++)
      if(g_compact_stop_results[i].abs_gate_pass) abs_pass_count++;
   Print("=== StopFlag Compact Search Phase A DONE ===");
   Print("STOP_SEARCH_SUMMARY|Evaluated=", g_compact_stop_result_count,
         "|AbsoluteGatePass=", abs_pass_count,
         "|CandidateLocked=", (g_s2b_stop_candidate_selected ? "YES" : "NO"),
         "|HistoricalConfirmationUsed=NO",
         "|ThresholdSelected=NO");
}
void S2B_ExportCompactSearchReport()
{
   if(g_compact_result_count <= 0) return;
   Print("=== Exporting Compact Search Report ===");
   // ---- Baseline canonical metrics ----
   double baseline_wf_mean = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_mean_auc : 0.0;
   double baseline_wf_worst = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_worst_auc : 0.0;
   double baseline_wf_std = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_std_auc : 0.0;
   string baseline_gate_reason = "";
   bool baseline_gate = false;
   if(g_s2b_baseline_wf_valid)
   {
      // Build a temporary SCompactResult for baseline gate check
      SCompactResult base_tmp;
      base_tmp.Reset();
      base_tmp.wf_mean_auc = baseline_wf_mean;
      base_tmp.wf_worst_auc = baseline_wf_worst;
      base_tmp.wf_std_auc = baseline_wf_std;
      base_tmp.valid_primary_folds = g_s2b_baseline_wf.valid_primary_folds;
      base_tmp.sign_flip_count = g_s2b_baseline_wf.sign_flips;
      base_tmp.large_drift_count = g_s2b_baseline_wf.large_drift;
      baseline_gate = S2B_PassAbsoluteGate(base_tmp, baseline_gate_reason);
   }
   // ---- CSV ----
   string fn_csv = "Stage2B_CompactSearch_" + _Symbol + ".csv";
   int hc = SafeOpenCSV(fn_csv);
   if(hc != INVALID_HANDLE)
   {
      FileWriteString(hc,
         "Rank,N_Features,Features,FeatureHash,"
         "WF_Mean_AUC,WF_Worst_AUC,WF_Std_AUC,"
         "WF_PR_AUC,WF_MCC,WF_Recall,WF_F2,"
         "Sign_Flip,Large_Drift,"
         "AbsGatePass,AbsGateReason,"
         "Composite_Score,Accepted,"
         "ProtocolHash,FoldHash,RowMaskHash,ValidPrimaryFolds\r\n");
      for(int i = 0; i < g_compact_result_count; i++)
      {
         FileWriteString(hc,
            IntegerToString(i + 1) + "," +
            IntegerToString(g_compact_results[i].n_feat) + "," +
            EscapeCSV(g_compact_results[i].feat_names) + "," +
            g_compact_results[i].feature_hash + "," +
            DoubleToString(g_compact_results[i].wf_mean_auc, 4) + "," +
            DoubleToString(g_compact_results[i].wf_worst_auc, 4) + "," +
            DoubleToString(g_compact_results[i].wf_std_auc, 4) + "," +
            DoubleToString(g_compact_results[i].wf_mean_prauc, 4) + "," +
            DoubleToString(g_compact_results[i].wf_mean_mcc, 4) + "," +
            DoubleToString(g_compact_results[i].wf_mean_recall, 4) + "," +
            DoubleToString(g_compact_results[i].wf_mean_f2, 4) + "," +
            IntegerToString(g_compact_results[i].sign_flip_count) + "," +
            IntegerToString(g_compact_results[i].large_drift_count) + "," +
            (g_compact_results[i].abs_gate_pass ? "YES" : "NO") + "," +
            EscapeCSV(g_compact_results[i].abs_gate_reason) + "," +
            DoubleToString(g_compact_results[i].composite_score, 4) + "," +
            (g_compact_results[i].accepted ? "YES" : "NO") + "," +
            g_compact_results[i].protocol_hash + "," +
            g_compact_results[i].fold_hash + "," +
            g_compact_results[i].row_mask_hash + "," +
            IntegerToString(g_compact_results[i].valid_primary_folds) + "\r\n");
      }
      FileFlush(hc);
      FileClose(hc);
      Print("  CSV: ", fn_csv);
   }
   // ---- TXT ----
   string fn_txt = "Stage2B_CompactSearch_Top10_" + _Symbol + ".txt";
   int ht = FileOpen(fn_txt, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(ht == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(ht, line);
   FileWriteString(ht, "COMPACT SEARCH — ANALYSIS\n");
   FileWriteString(ht, "Symbol : " + _Symbol + "\n");
   FileWriteString(ht, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(ht, line);
   // ---- Metadata ----
   FileWriteString(ht, "\n[SEARCH METADATA]\n" + sep);
   FileWriteString(ht, "EvaluatorVersion    : " + S2B_EVALUATOR_VERSION + "\n");
   FileWriteString(ht, "ProtocolHash        : " + g_s2b_protocol.protocol_hash + "\n");
   FileWriteString(ht, "FoldHash            : " + g_s2b_protocol.fold_hash + "\n");
   FileWriteString(ht, "DatasetHash         : " + g_s2b_protocol.dataset_hash + "\n");
   FileWriteString(ht, "RowMaskHash         : " + g_s2b_protocol.row_mask_hash + "\n");
   FileWriteString(ht, "BaselineFeatureHash : " + g_s2b_baseline_wf.feature_hash + "\n");
   FileWriteString(ht, "ValidRowPolicy      : " + g_s2b_protocol.valid_row_policy + "\n");
   FileWriteString(ht, "TargetName          : " + g_s2b_protocol.target_name + "\n");
   FileWriteString(ht, "ValidPrimaryFolds   : " + IntegerToString(g_s2b_baseline_wf.valid_primary_folds) + "\n");
   // ---- Baseline from canonical ----
   FileWriteString(ht, "\n[BASELINE — from Unified Evaluator]\n" + sep);
   FileWriteString(ht, "Features    : " + g_s2b_baseline_wf.feature_list + "\n");
   FileWriteString(ht, "FeatureHash : " + g_s2b_baseline_wf.feature_hash + "\n");
   FileWriteString(ht, "N           : " + IntegerToString(g_s2b_baseline_wf.n_features) + "\n");
   FileWriteString(ht, StringFormat("WF Mean AUC : %.4f\n", baseline_wf_mean));
   FileWriteString(ht, StringFormat("WF Worst AUC: %.4f\n", baseline_wf_worst));
   FileWriteString(ht, StringFormat("WF Std AUC  : %.4f\n", baseline_wf_std));
   FileWriteString(ht, StringFormat("WF PR-AUC   : %.4f\n", g_s2b_baseline_wf.mean_prauc));
   FileWriteString(ht, StringFormat("WF MCC      : %.4f\n", g_s2b_baseline_wf.mean_mcc));
   FileWriteString(ht, StringFormat("Sign Flips  : %d\n", g_s2b_baseline_wf.sign_flips));
   FileWriteString(ht, StringFormat("Large Drift : %d\n", g_s2b_baseline_wf.large_drift));
   FileWriteString(ht, "AbsoluteGate: " + string(baseline_gate ? "PASS" : "FAIL") + "\n");
   if(!baseline_gate)
      FileWriteString(ht, "GateReason  : " + baseline_gate_reason + "\n");
   // ---- Accepted subsets ----
   FileWriteString(ht, "\n[TOP ACCEPTED SUBSETS]\n" + sep);
   int shown_accepted = 0;
   for(int i = 0; i < g_compact_result_count && shown_accepted < 10; i++)
   {
      if(!g_compact_results[i].accepted) continue;
      FileWriteString(ht, "\n#" + IntegerToString(shown_accepted + 1) + "\n");
      FileWriteString(ht, "  Features   : " + g_compact_results[i].feat_names + "\n");
      FileWriteString(ht, "  FeatureHash: " + g_compact_results[i].feature_hash + "\n");
      FileWriteString(ht, "  N_Features : " + IntegerToString(g_compact_results[i].n_feat) + "\n");
      FileWriteString(ht, StringFormat("  WF Mean AUC: %.4f  (Baseline: %.4f  Delta: %+.4f)\n",
         g_compact_results[i].wf_mean_auc,
         baseline_wf_mean,
         g_compact_results[i].wf_mean_auc - baseline_wf_mean));
      FileWriteString(ht, StringFormat("  Worst Fold : %.4f\n", g_compact_results[i].wf_worst_auc));
      FileWriteString(ht, StringFormat("  Std AUC    : %.4f\n", g_compact_results[i].wf_std_auc));
      FileWriteString(ht, StringFormat("  PR-AUC     : %.4f\n", g_compact_results[i].wf_mean_prauc));
      FileWriteString(ht, StringFormat("  MCC        : %.4f\n", g_compact_results[i].wf_mean_mcc));
      FileWriteString(ht, "  SignFlips  : " + IntegerToString(g_compact_results[i].sign_flip_count) + "\n");
      FileWriteString(ht, "  LargeDrift : " + IntegerToString(g_compact_results[i].large_drift_count) + "\n");
      FileWriteString(ht, "  AbsGate   : " + (g_compact_results[i].abs_gate_pass ? "PASS" : "FAIL") + "\n");
      if(!g_compact_results[i].abs_gate_pass)
         FileWriteString(ht, "  GateReason: " + g_compact_results[i].abs_gate_reason + "\n");
      FileWriteString(ht, StringFormat("  CompScore  : %.2f\n", g_compact_results[i].composite_score));
      FileWriteString(ht, "  ProtHash   : " + g_compact_results[i].protocol_hash + "\n");
      FileWriteString(ht, "  FoldHash   : " + g_compact_results[i].fold_hash + "\n");
      FileWriteString(ht, "  RowMaskHash: " + g_compact_results[i].row_mask_hash + "\n");
      shown_accepted++;
   }
   if(shown_accepted == 0)
      FileWriteString(ht, "  No accepted subsets found.\n");
   // ---- Top rejected subsets for audit ----
   FileWriteString(ht, "\n[TOP REJECTED SUBSETS — for Audit]\n" + sep);
   int shown_rejected = 0;
   for(int i = 0; i < g_compact_result_count && shown_rejected < 10; i++)
   {
      if(g_compact_results[i].accepted) continue;
      if(g_compact_results[i].wf_mean_auc < 0.001) continue;
      FileWriteString(ht, "\nRejected #" + IntegerToString(shown_rejected + 1) + "\n");
      FileWriteString(ht, "  Features   : " + g_compact_results[i].feat_names + "\n");
      FileWriteString(ht, "  FeatureHash: " + g_compact_results[i].feature_hash + "\n");
      FileWriteString(ht, "  N_Features : " + IntegerToString(g_compact_results[i].n_feat) + "\n");
      FileWriteString(ht, StringFormat("  WF Mean AUC: %.4f\n", g_compact_results[i].wf_mean_auc));
      FileWriteString(ht, StringFormat("  WF Worst   : %.4f\n", g_compact_results[i].wf_worst_auc));
      FileWriteString(ht, StringFormat("  WF Std     : %.4f\n", g_compact_results[i].wf_std_auc));
      FileWriteString(ht, StringFormat("  PR-AUC     : %.4f\n", g_compact_results[i].wf_mean_prauc));
      FileWriteString(ht, StringFormat("  MCC        : %.4f\n", g_compact_results[i].wf_mean_mcc));
      FileWriteString(ht, "  SignFlips  : " + IntegerToString(g_compact_results[i].sign_flip_count) + "\n");
      FileWriteString(ht, "  LargeDrift : " + IntegerToString(g_compact_results[i].large_drift_count) + "\n");
      FileWriteString(ht, "  AbsGate   : " + (g_compact_results[i].abs_gate_pass ? "PASS" : "FAIL") + "\n");
      if(!g_compact_results[i].abs_gate_pass)
         FileWriteString(ht, "  GateReason: " + g_compact_results[i].abs_gate_reason + "\n");
      FileWriteString(ht, StringFormat("  CompScore  : %.2f\n", g_compact_results[i].composite_score));
      FileWriteString(ht, "  ValidFolds : " + IntegerToString(g_compact_results[i].valid_primary_folds) + "\n");
      shown_rejected++;
   }
   if(shown_rejected == 0)
      FileWriteString(ht, "  No rejected subsets with valid evaluation found.\n");
   // ---- Recommendation ----
   FileWriteString(ht, "\n[RECOMMENDATION]\n" + sep);
   if(shown_accepted >= 1)
   {
      FileWriteString(ht, "  Accepted candidates found. Proceed to Winner Confirmation after Absolute Gate.\n");
   }
   else
   {
      FileWriteString(ht, "  No deployable candidate passed the absolute gate.\n");
      if(!baseline_gate)
         FileWriteString(ht, "  Baseline also failed the absolute gate.\n");
      FileWriteString(ht, "  OOS/Winner/Freeze remain blocked.\n");
   }
   // ---- Pipeline status ----
   FileWriteString(ht, "\n[PIPELINE STATUS]\n" + sep);
   FileWriteString(ht, "COMPACT SEARCH ON DEV/WF = EXECUTED\n");
   FileWriteString(ht, "OOS EVALUATION           = SKIPPED\n");
   FileWriteString(ht, "WINNER CONFIRMATION      = SKIPPED\n");
   FileWriteString(ht, "DOWNSTREAM BLOCKED       = YES\n");
   FileWriteString(ht, "FROZEN GENERATED THIS RUN= NO\n");
   FileWriteString(ht, "STAGE2C                  = SKIPPED\n");
   FileWriteString(ht, "STAGE2D                  = SKIPPED\n");
   FileWriteString(ht, "\n" + line);
   FileFlush(ht);
   FileClose(ht);
   Print("  TXT: ", fn_txt);
}
void S2B_ExportCompactSearchReport_Stop()
{
   if(g_compact_stop_result_count <= 0) return;
   string fn_txt = "Stage2B_CompactSearch_Stop_Top10_" + _Symbol + ".txt";
   int ht = FileOpen(fn_txt, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(ht == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep = "----------------------------------------------------------------\n";
   FileWriteString(ht, line);
   FileWriteString(ht, "COMPACT SEARCH — StopFlag — PHASE A DEV-ONLY SELECTION\n");
   FileWriteString(ht, "Symbol : " + _Symbol + "\n");
   FileWriteString(ht, "Time   : " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES) + "\n");
   FileWriteString(ht, line);
   FileWriteString(ht, "\n[STOP-SPECIFIC METADATA]\n" + sep);
   FileWriteString(ht, "EvaluatorVersion      : " + g_s2b_stop_context.evaluator_version + "\n");
   FileWriteString(ht, "SharedProtocolHash    : " + g_s2b_stop_context.shared_protocol_hash + "\n");
   FileWriteString(ht, "FoldHash              : " + g_s2b_stop_context.fold_hash + "\n");
   FileWriteString(ht, "DatasetHash           : " + g_s2b_stop_context.dataset_hash + "\n");
   FileWriteString(ht, "TargetName            : " + g_s2b_stop_context.target_name + "\n");
   FileWriteString(ht, "TargetDefinition      : " + g_s2b_stop_context.target_definition + "\n");
   FileWriteString(ht, "ValidRowPolicy        : " + g_s2b_stop_context.valid_row_policy + "\n");
   FileWriteString(ht, "TargetHash            : " + g_s2b_stop_context.target_hash + "\n");
   FileWriteString(ht, "PoolHash              : " + g_s2b_stop_context.pool_hash + "\n");
   FileWriteString(ht, "RowPolicyHash         : " + g_s2b_stop_context.row_policy_hash + "\n");
   FileWriteString(ht, "RowMaskHash           : " + g_s2b_stop_context.row_mask_hash + "\n");
   FileWriteString(ht, "EvaluationContextHash : " + g_s2b_stop_context.evaluation_context_hash + "\n");
   FileWriteString(ht, "EligibleCount         : " + IntegerToString(g_s2b_stop_context.eligible_count) + "\n");
   FileWriteString(ht, "ExcludedCount         : " + IntegerToString(g_s2b_stop_context.excluded_count) + "\n");
   FileWriteString(ht, "\n[DETERMINISTIC SELECTION POLICY]\n" + sep);
   FileWriteString(ht, "1. Absolute Gate pass\n");
   FileWriteString(ht, "2. Maximize Worst-Fold AUC\n");
   FileWriteString(ht, "3. Minimize WF Std AUC\n");
   FileWriteString(ht, "4. Maximize Mean PR Lift\n");
   FileWriteString(ht, "5. Prefer fewer features\n");
   FileWriteString(ht, "6. Maximize Mean AUC\n");
   FileWriteString(ht, "7. FeatureHash ascending final tie-break\n");
   FileWriteString(ht, "CompositeScore is informational only and is not used for lock/rank.\n");
   FileWriteString(ht, "\n[BASELINE — StopFlag]\n" + sep);
   FileWriteString(ht, "Features      : " + g_s2b_stop_baseline_wf.feature_list + "\n");
   FileWriteString(ht, "FeatureHash   : " + g_s2b_stop_baseline_wf.feature_hash + "\n");
   FileWriteString(ht, StringFormat("WF Mean AUC   : %.6f\n", g_s2b_stop_baseline_wf.mean_auc));
   FileWriteString(ht, StringFormat("WF Worst AUC  : %.6f\n", g_s2b_stop_baseline_wf.worst_auc));
   FileWriteString(ht, StringFormat("WF Std AUC    : %.6f\n", g_s2b_stop_baseline_wf.std_auc));
   if(g_s2b_stop_candidate_selected && g_s2b_stop_selected_result_index >= 0)
   {
      SCompactResult selected = g_compact_stop_results[g_s2b_stop_selected_result_index];
      FileWriteString(ht, "\n[LOCKED CANDIDATE]\n" + sep);
      FileWriteString(ht, "SelectionRank : 1\n");
      FileWriteString(ht, "Features      : " + selected.feat_names + "\n");
      FileWriteString(ht, "FeatureHash   : " + selected.feature_hash + "\n");
      FileWriteString(ht, StringFormat("WF Mean AUC   : %.6f\n", selected.wf_mean_auc));
      FileWriteString(ht, StringFormat("WF Worst AUC  : %.6f\n", selected.wf_worst_auc));
      FileWriteString(ht, StringFormat("WF Std AUC    : %.6f\n", selected.wf_std_auc));
      FileWriteString(ht, StringFormat("Mean PR-AUC   : %.6f\n", selected.wf_mean_prauc));
      FileWriteString(ht, StringFormat("Mean PR Lift  : %.6f\n", selected.wf_mean_pr_lift));
      FileWriteString(ht, StringFormat("Mean MCC      : %.6f\n", selected.wf_mean_mcc));
      FileWriteString(ht, "AbsoluteGate  : PASS\n");
      FileWriteString(ht, "RelativeGate  : PASS\n");
      FileWriteString(ht, "RejectReason  : NONE_SELECTED_BY_POLICY\n");
      FileWriteString(ht, "SelectionReason: " + selected.selection_reason + "\n");
      S2B_WriteStopFoldDiagnostics(ht, selected, "LOCKED CANDIDATE");
   }
   else
   {
      FileWriteString(ht, "\n[LOCKED CANDIDATE]\n" + sep);
      FileWriteString(ht, "CandidateLock : FAIL\n");
      FileWriteString(ht, "Reason        : " + g_s2b_stop_block_reason + "\n");
   }
   FileWriteString(ht, "\n[TOP REJECTED CANDIDATES — POLICY ORDER]\n" + sep);
   int shown = 0;
   for(int i = 0; i < g_compact_stop_result_count && shown < 10; i++)
   {
      if(g_compact_stop_results[i].selected_by_policy) continue;
      if(g_compact_stop_results[i].wf_mean_auc < 0.001) continue;
      SCompactResult rejected = g_compact_stop_results[i];
      shown++;
      FileWriteString(ht, "\nRejected #" + IntegerToString(shown) + "\n");
      FileWriteString(ht, "Features       : " + rejected.feat_names + "\n");
      FileWriteString(ht, "FeatureHash    : " + rejected.feature_hash + "\n");
      FileWriteString(ht, "PolicyRank     : " + IntegerToString(rejected.selection_rank) + "\n");
      FileWriteString(ht, StringFormat("WF Mean AUC    : %.6f\n", rejected.wf_mean_auc));
      FileWriteString(ht, StringFormat("WF Worst AUC   : %.6f\n", rejected.wf_worst_auc));
      FileWriteString(ht, StringFormat("WF Std AUC     : %.6f\n", rejected.wf_std_auc));
      FileWriteString(ht, StringFormat("Mean PR-AUC    : %.6f\n", rejected.wf_mean_prauc));
      FileWriteString(ht, StringFormat("Mean PR Lift   : %.6f\n", rejected.wf_mean_pr_lift));
      FileWriteString(ht, StringFormat("Mean MCC       : %.6f\n", rejected.wf_mean_mcc));
      FileWriteString(ht, "AbsoluteGate   : " + string(rejected.abs_gate_pass ? "PASS" : "FAIL") + "\n");
      FileWriteString(ht, "RelativeGate   : " + string(rejected.relative_gate_pass ? "PASS" : "FAIL") + "\n");
      FileWriteString(ht, "RejectReason   : " + rejected.reject_reason + "\n");
      FileWriteString(ht, "AbsGateReason  : " + rejected.abs_gate_reason + "\n");
      S2B_WriteStopFoldDiagnostics(ht, rejected, "REJECTED " + IntegerToString(shown));
   }
   if(shown == 0)
      FileWriteString(ht, "No rejected candidate with a valid evaluation.\n");
   FileWriteString(ht, "\n[PHASE A STATUS GUARD]\n" + sep);
   FileWriteString(ht, "2023 Status             : Historical Confirmation — Selection-aware validation, not blind OOS — NOT ACCESSED IN PHASE A\n");
   FileWriteString(ht, "2024+ Status            : Reserved / Untouched true holdout\n");
   FileWriteString(ht, "Threshold Selected      : NO\n");
   FileWriteString(ht, "Winner Confirmation     : BLOCKED\n");
   FileWriteString(ht, "Frozen Export           : BLOCKED\n");
   FileWriteString(ht, "Stage 2C                : BLOCKED\n");
   FileWriteString(ht, "Stage 2D                : BLOCKED\n");
   FileWriteString(ht, "\n" + line);
   FileFlush(ht);
   FileClose(ht);
   Print("STOP_COMPACT_REPORT|", fn_txt);
}
void S2B_CompareTopCompactVsBaseline()
{
   if(g_compact_result_count <= 0) return;
   string fn = "Stage2B_CompactVsBaseline_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   double baseline_wf_mean  = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_mean_auc    : 0.0;
   double baseline_wf_worst = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_worst_auc   : 0.0;
   double baseline_wf_std   = g_s2b_baseline_wf_valid ? g_s2b_baseline_wf_std_auc     : 0.0;
   FileWriteString(h, line);
   FileWriteString(h, "TOP COMPACT MODELS vs BASELINE COMPARISON\n");
   FileWriteString(h, "Symbol: " + _Symbol + "\n");
   FileWriteString(h, "Evaluator: " + S2B_EVALUATOR_VERSION + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[METADATA]\n" + sep);
   FileWriteString(h, "ProtocolHash     : " + g_s2b_protocol.protocol_hash + "\n");
   FileWriteString(h, "FoldHash         : " + g_s2b_protocol.fold_hash + "\n");
   FileWriteString(h, "DatasetHash      : " + g_s2b_protocol.dataset_hash + "\n");
   FileWriteString(h, "RowMaskHash      : " + g_s2b_protocol.row_mask_hash + "\n");
   FileWriteString(h, "BaselineFeatures : " + g_s2b_baseline_wf.feature_list + "\n");
   FileWriteString(h, "BaselineHash     : " + g_s2b_baseline_wf.feature_hash + "\n");
   FileWriteString(h, "\n[BASELINE — from Unified Evaluator]\n" + sep);
   FileWriteString(h, StringFormat("  N: %d\n", g_s2b_baseline_wf.n_features));
   FileWriteString(h, StringFormat("  WF Mean AUC : %.4f\n", baseline_wf_mean));
   FileWriteString(h, StringFormat("  WF Worst AUC: %.4f\n", baseline_wf_worst));
   FileWriteString(h, StringFormat("  WF Std AUC  : %.4f\n", baseline_wf_std));
   FileWriteString(h, StringFormat("  WF PR-AUC   : %.4f\n", g_s2b_baseline_wf.mean_prauc));
   FileWriteString(h, StringFormat("  WF MCC      : %.4f\n", g_s2b_baseline_wf.mean_mcc));
   FileWriteString(h, StringFormat("  Sign Flips  : %d\n", g_s2b_baseline_wf.sign_flips));
   FileWriteString(h, StringFormat("  Large Drift : %d\n", g_s2b_baseline_wf.large_drift));
   FileWriteString(h, "\n[TOP 5 COMPACT MODELS]\n" + sep);
   FileWriteString(h, StringFormat(
      "  %-4s  %-5s  %-10s  %-10s  %-10s  %-10s  %-10s  %-8s  %-8s  %-10s  %-10s\n",
      "Rank", "N", "WF Mean", "WF Worst", "WF Std", "PR-AUC", "MCC",
      "SignFlip", "Drift", "AbsGate", "CompScore"));
   FileWriteString(h, sep);
   int shown = 0;
   for(int i = 0; i < g_compact_result_count && shown < 5; i++)
   {
      if(g_compact_results[i].wf_mean_auc < 0.001) continue;
      string gate_str = g_compact_results[i].abs_gate_pass ? "PASS" : "FAIL";
      FileWriteString(h, StringFormat(
         "  %-4d  %-5d  %10.4f  %10.4f  %10.4f  %10.4f  %10.4f  %8d  %8d  %10s  %10.2f\n",
         shown + 1,
         g_compact_results[i].n_feat,
         g_compact_results[i].wf_mean_auc,
         g_compact_results[i].wf_worst_auc,
         g_compact_results[i].wf_std_auc,
         g_compact_results[i].wf_mean_prauc,
         g_compact_results[i].wf_mean_mcc,
         g_compact_results[i].sign_flip_count,
         g_compact_results[i].large_drift_count,
         gate_str,
         g_compact_results[i].composite_score));
      FileWriteString(h, "         Features: " + g_compact_results[i].feat_names + "\n");
      if(!g_compact_results[i].abs_gate_pass)
         FileWriteString(h, "         GateReason: " + g_compact_results[i].abs_gate_reason + "\n");
      FileWriteString(h, "\n");
      shown++;
   }
   if(shown == 0)
      FileWriteString(h, "  No subsets with valid evaluation found.\n");
   FileWriteString(h, "\n[FINAL SELECTION]\n" + sep);
   bool any_accepted = false;
   for(int i = 0; i < g_compact_result_count; i++)
   {
      if(g_compact_results[i].accepted)
      {
         any_accepted = true;
         FileWriteString(h, "  SELECTED: " + g_compact_results[i].feat_names + "\n");
         FileWriteString(h, "  FeatureHash: " + g_compact_results[i].feature_hash + "\n");
         FileWriteString(h, StringFormat("  WF Mean AUC: %.4f  (Baseline: %.4f)\n",
            g_compact_results[i].wf_mean_auc, baseline_wf_mean));
         FileWriteString(h, "  AbsGate: " + (g_compact_results[i].abs_gate_pass ? "PASS" : "FAIL") + "\n");
         break;
      }
   }
   if(!any_accepted)
   {
      FileWriteString(h, "  No deployable candidate passed the absolute gate.\n");
      string base_gate_reason = "";
      SCompactResult base_tmp;
      base_tmp.Reset();
      base_tmp.wf_mean_auc = baseline_wf_mean;
      base_tmp.wf_worst_auc = baseline_wf_worst;
      base_tmp.wf_std_auc = baseline_wf_std;
      base_tmp.valid_primary_folds = g_s2b_baseline_wf.valid_primary_folds;
      base_tmp.sign_flip_count = g_s2b_baseline_wf.sign_flips;
      base_tmp.large_drift_count = g_s2b_baseline_wf.large_drift;
      bool base_gate = S2B_PassAbsoluteGate(base_tmp, base_gate_reason);
      if(!base_gate)
         FileWriteString(h, "  Baseline also failed the absolute gate (" + base_gate_reason + ").\n");
      FileWriteString(h, "  OOS/Winner/Freeze remain blocked.\n");
   }
   FileWriteString(h, "\n[PIPELINE STATUS]\n" + sep);
   FileWriteString(h, "COMPACT SEARCH ON DEV/WF = EXECUTED\n");
   FileWriteString(h, "OOS EVALUATION           = SKIPPED\n");
   FileWriteString(h, "WINNER CONFIRMATION      = SKIPPED\n");
   FileWriteString(h, "DOWNSTREAM BLOCKED       = YES\n");
   FileWriteString(h, "FROZEN GENERATED THIS RUN= NO\n");
   FileWriteString(h, "STAGE2C                  = SKIPPED\n");
   FileWriteString(h, "STAGE2D                  = SKIPPED\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("  Comparison: ", fn);
}
void S2B_RunPhase5()
{
   Print("=== Stage 2B Phase 5 START ===");
   if(!g_s2b_search_allowed)
   {
      Print("S2B_RunPhase5: Search not allowed. Alignment or selftest failed.");
      Print("COMPACT SEARCH ON DEV/WF = SKIPPED");
      return;
   }
   S2B_ExportFeatureRankStability();
   S2B_RunSystematicCompactSearch(4, 6);
   S2B_ExportCompactSearchReport();
   S2B_CompareTopCompactVsBaseline();
   bool any_accepted = false;
   for(int i = 0; i < g_compact_result_count; i++)
   {
      if(g_compact_results[i].accepted && g_compact_results[i].abs_gate_pass)
      {
         any_accepted = true;
         g_s2b_candidate_selected = true;
         S2B_CopyCompactResultToWFMetrics(g_compact_results[i], g_s2b_selected_candidate_wf);
         g_s2b_selected_candidate_valid = true;
         g_s2b_alignment_cross_component_status = "PASS";
         Print("Candidate selected: ", g_compact_results[i].feat_names,
               " | WF Mean=", DoubleToString(g_compact_results[i].wf_mean_auc, 4));
         break;
      }
   }
   if(!any_accepted)
   {
      g_s2b_candidate_selected = false;
      g_s2b_oos_allowed = false;
      g_s2b_winner_confirmed = false;
      g_s2b_freeze_allowed = false;
      Print("No candidate passed absolute gate.");
      Print("OOS EVALUATION           = SKIPPED");
      Print("WINNER CONFIRMATION      = SKIPPED");
      Print("DOWNSTREAM BLOCKED       = YES");
      Print("FROZEN GENERATED THIS RUN= NO");
   }
   Print("=== Stage 2B Phase 5 DONE ===");
}
// Global winner model
SStage2B_ModelParams g_s2b_compact_winner;
void S2B_TrainCompactWinner_Step4()
{
   Print("=== Training Compact Winner START ===");
   int best_idx = -1;
   for(int i = 0; i < g_compact_result_count; i++)
   {
      if(g_compact_results[i].accepted)
      {
         // only choose compact candidate if it beats baseline internally
         if(g_compact_results[i].wf_mean_auc > g_s2b_baseline_wf_mean_auc + 0.01 &&
            g_compact_results[i].oos_auc >= g_s2b_step4.oos_auc - 0.01)
         {
            best_idx = i;
            break;
         }
      }
   }
   if(best_idx < 0)
   {
      g_s2b_compact_winner.Reset();
      Print("  No valid compact winner candidate from this run.");
      Print("=== Training Compact Winner ABORTED ===");
      return;
   }
   g_s2b_compact_winner.Reset();
   g_s2b_compact_winner.model_name  = "Step4_CompactWinner";
   g_s2b_compact_winner.target_name = "Step4";
   g_s2b_compact_winner.n_features  = g_compact_results[best_idx].n_feat;
   int feat_idx_arr[8];
   for(int k = 0; k < g_compact_results[best_idx].n_feat; k++)
   {
      feat_idx_arr[k] = g_compact_results[best_idx].feat_idx[k];
      g_s2b_compact_winner.feature_idx[k] = feat_idx_arr[k];
   }
   S2B_TrainLogistic(g_s2b_compact_winner, 5000, 0.05, 0.01);
   if(g_s2b_compact_winner.trained)
   {
      Print("  Compact Winner trained successfully.");
      Print("  Features: ", g_compact_results[best_idx].feat_names);
      Print("  DEV AUC = ", DoubleToString(g_s2b_compact_winner.dev_auc, 4));
      Print("  OOS AUC = ", DoubleToString(g_s2b_compact_winner.oos_auc, 4));
   }
   else
   {
      Print("  ERROR: Compact Winner training failed.");
   }
   Print("=== Training Compact Winner DONE ===");
}
// Full report: performance + coefficients + comparison
// ================================================================
// Bootstrap 95% CI for OOS AUC
// ================================================================
// False Positive / False Negative analysis
// ================================================================
// Check model quality at multiple thresholds
// ================================================================
// ================================================================
// S2B_BuildScoreBands_Step4
// Convert raw scores to usable bands
// ================================================================
void S2B_BuildScoreBands_Step4()
{
   if(!g_s2b_compact_winner.trained) return;
   Print("=== Score Bands START ===");
   int n_feat = g_s2b_compact_winner.n_features;
   // Collect all OOS predictions
   double preds[];
   int    tgts[];
   ArrayResize(preds, g_risklab_count);
   ArrayResize(tgts,  g_risklab_count);
   int n = 0;
   double fvec[], fvec_norm[];
   ArrayResize(fvec,      n_feat);
   ArrayResize(fvec_norm, n_feat);
   for(int r = 0; r < g_risklab_count; r++)
   {
      if(!g_risklab_records[r].is_oos) continue;
      if(!S2B_BuildFeatureVector(r, g_s2b_compact_winner, fvec)) continue;
      S2B_NormalizeVector(fvec, g_s2b_compact_winner, fvec_norm);
      double z = g_s2b_compact_winner.intercept;
      for(int k = 0; k < n_feat; k++)
         z += g_s2b_compact_winner.weights[k] * fvec_norm[k];
      preds[n] = S2B_Sigmoid(z);
      tgts[n]  = S2B_GetTargetValue(r, "Step4");
      n++;
   }
   ArrayResize(preds, n);
   ArrayResize(tgts,  n);
   ArrayFree(fvec);
   ArrayFree(fvec_norm);
   if(n < 20)
   {
      Print("  Not enough OOS samples for score bands.");
      ArrayFree(preds);
      ArrayFree(tgts);
      return;
   }
   // Sort predictions to find quintile boundaries
   double sorted_preds[];
   ArrayResize(sorted_preds, n);
   for(int i = 0; i < n; i++) sorted_preds[i] = preds[i];
   ArraySort(sorted_preds);
   // 5 bands (quintiles)
   double band_boundaries[4];
   band_boundaries[0] = sorted_preds[(int)(n * 0.20)];
   band_boundaries[1] = sorted_preds[(int)(n * 0.40)];
   band_boundaries[2] = sorted_preds[(int)(n * 0.60)];
   band_boundaries[3] = sorted_preds[(int)(n * 0.80)];
   string band_names[5] = { "E_Reject", "D_Low", "C_Medium", "B_High", "A_VeryHigh" };
   int    band_n[5], band_pos[5];
   double band_pred_sum[5];
   ArrayInitialize(band_n, 0);
   ArrayInitialize(band_pos, 0);
   ArrayInitialize(band_pred_sum, 0.0);
   for(int i = 0; i < n; i++)
   {
      int b = 4; // default: highest band
      if(preds[i] < band_boundaries[0]) b = 0;
      else if(preds[i] < band_boundaries[1]) b = 1;
      else if(preds[i] < band_boundaries[2]) b = 2;
      else if(preds[i] < band_boundaries[3]) b = 3;
      band_n[b]++;
      band_pred_sum[b] += preds[i];
      if(tgts[i] == 1) band_pos[b]++;
   }
   ArrayFree(sorted_preds);
   ArrayFree(preds);
   ArrayFree(tgts);
   // Export
   string fn = "Stage2B_ScoreBands_" + _Symbol + ".txt";
   int h = FileOpen(fn, FILE_WRITE | FILE_TXT | FILE_COMMON);
   if(h == INVALID_HANDLE) return;
   string line = "================================================================\n";
   string sep  = "----------------------------------------------------------------\n";
   FileWriteString(h, line);
   FileWriteString(h, "SCORE BANDS — Compact Winner Step4\n");
   FileWriteString(h, "Symbol : " + _Symbol + "\n");
   FileWriteString(h, "Method : Quintile-based (5 bands)\n");
   FileWriteString(h, "OOS N  : " + IntegerToString(n) + "\n");
   FileWriteString(h, line);
   FileWriteString(h, "\n[BAND BOUNDARIES]\n" + sep);
   FileWriteString(h, StringFormat("  Q20 = %.4f\n", band_boundaries[0]));
   FileWriteString(h, StringFormat("  Q40 = %.4f\n", band_boundaries[1]));
   FileWriteString(h, StringFormat("  Q60 = %.4f\n", band_boundaries[2]));
   FileWriteString(h, StringFormat("  Q80 = %.4f\n", band_boundaries[3]));
   FileWriteString(h, "\n[BAND PERFORMANCE]\n" + sep);
   FileWriteString(h, StringFormat("  %-15s  %8s  %8s  %10s  %10s\n",
      "Band", "N", "Pos", "HitRate%", "MeanPred"));
   FileWriteString(h, sep);
   for(int b = 0; b < 5; b++)
   {
      double hr = (band_n[b] > 0) ? (band_pos[b] * 100.0 / band_n[b]) : 0.0;
      double mp = (band_n[b] > 0) ? (band_pred_sum[b] / band_n[b]) : 0.0;
      FileWriteString(h, StringFormat("  %-15s  %8d  %8d  %10.1f  %10.4f\n",
         band_names[b], band_n[b], band_pos[b], hr, mp));
   }
   // Interpretation
   FileWriteString(h, "\n[INTERPRETATION]\n" + sep);
   double top_rate = (band_n[4] > 0) ? (band_pos[4] * 100.0 / band_n[4]) : 0.0;
   double bot_rate = (band_n[0] > 0) ? (band_pos[0] * 100.0 / band_n[0]) : 0.0;
   FileWriteString(h, StringFormat("  Top band Step4 rate: %.1f%%\n", top_rate));
   FileWriteString(h, StringFormat("  Bottom band Step4 rate: %.1f%%\n", bot_rate));
   FileWriteString(h, StringFormat("  Lift (Top/Bottom): %.2fx\n",
      (bot_rate > 0.1) ? (top_rate / bot_rate) : 0.0));
   if(top_rate > bot_rate * 2.0)
      FileWriteString(h, "  → Strong separation between bands. Score bands are useful.\n");
   else if(top_rate > bot_rate * 1.3)
      FileWriteString(h, "  → Moderate separation. Bands provide some value.\n");
   else
      FileWriteString(h, "  → Weak separation. Bands have limited practical value.\n");
   FileWriteString(h, "\n[USAGE GUIDE FOR EA]\n" + sep);
   FileWriteString(h, "  Band A (VeryHigh): Confident entry. Full position.\n");
   FileWriteString(h, "  Band B (High)    : Good entry. Normal position.\n");
   FileWriteString(h, "  Band C (Medium)  : Acceptable. Monitor closely.\n");
   FileWriteString(h, "  Band D (Low)     : Marginal. Reduce size or skip.\n");
   FileWriteString(h, "  Band E (Reject)  : Do not enter.\n");
   FileWriteString(h, "\n" + line);
   FileFlush(h);
   FileClose(h);
   Print("Score Bands: ", fn);
   Print("=== Score Bands DONE ===");
}
void S2B_RunPhase6()
{
   Print("=== Stage 2B Phase 6: Winner Confirmation START ===");
   if(!g_s2b_candidate_selected || !g_s2b_selected_candidate_valid)
   {
      Print("Phase 6: No valid candidate selected. SKIPPED.");
      Print("WINNER CONFIRMATION = SKIPPED");
      Print("FROZEN GENERATED THIS RUN = NO");
