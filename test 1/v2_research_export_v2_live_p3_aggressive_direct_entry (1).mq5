uint S2B_HashString32(string s)
{
   uint h = 2166136261u;
   int len = StringLen(s);
   for(int i = 0; i < len; i++)
   {
      ushort ch = (ushort)StringGetCharacter(s, i);
      h ^= (uint)ch;
      h *= 16777619u;
   }
   return h;
}
string S2B_HashToString(uint h)
{
   return StringFormat("%u", h);
}
string S2B_TimeKey(datetime t)
{
   return StringFormat("%I64d", (long)t);
}
// ---------------------------------------------------------------
// Stage2B Fold
// ---------------------------------------------------------------
struct SS2BFold
{
   string   name;
   datetime train_from;
   datetime train_to;     // [from,to)
   datetime val_from;
   datetime val_to;       // [from,to)
   bool     is_primary;
   bool     is_warmup;
   void Reset()
   {
      name = "";
      train_from = 0;
      train_to   = 0;
      val_from   = 0;
      val_to     = 0;
      is_primary = false;
      is_warmup  = false;
   }
};
struct SS2BProtocol
{
   bool     valid;
   string   invalid_reason;
   string   protocol_version;
   string   symbol_name;
   string   target_name;
   string   target_definition;
   bool     higher_score_higher_positive;
   // Canonical names
   datetime development_from;  // inclusive
   datetime development_to;    // exclusive
   // Compatibility aliases
   datetime dev_from;          // inclusive
   datetime dev_to;            // exclusive
   datetime oos_from;          // inclusive
   datetime oos_to;            // exclusive
   string   valid_row_policy;
   int      compact_pool_feature_idx[S2B_COMPACT_POOL_SIZE];
   int      compact_pool_count;
   // Dataset identity
   string   dataset_hash;
   int      snapshot_count;
   int      risklab_count;
   datetime first_entry_time;
   datetime last_entry_time;
   // Protocol universe counts
   int      protocol_record_count;
   int      development_record_count;
   int      oos_record_count;
   // Common row mask
   string   row_mask_hash;
   int      eligible_count;
   int      excluded_count;
   int      eligible_dev_count;
   int      eligible_oos_count;
   int      eligible_record_indices[];
   int      row_mask_flags[];
   // Fold identity
   string   fold_hash;
   // Sample requirements for fold validity
   int      min_train_n;
   int      min_train_pos;
   int      min_val_n;
   int      min_val_pos;
   // Search/OOS behavior flags
   bool     allow_oos_for_selection;
   bool     evaluate_oos_after_final_selection_only;
   // Identity hash
   string   protocol_hash;
   void Reset()
   {
      valid = false;
      invalid_reason = "";
      protocol_version = S2B_PROTOCOL_VERSION;
      symbol_name = "";
      target_name = "";
      target_definition = "";
      higher_score_higher_positive = true;
      development_from = 0;
      development_to   = 0;
      dev_from = 0;
      dev_to   = 0;
      oos_from = 0;
      oos_to   = 0;
      valid_row_policy = S2B_VALID_ROW_POLICY_POOL8;
      compact_pool_count = 0;
      for(int i = 0; i < S2B_COMPACT_POOL_SIZE; i++)
         compact_pool_feature_idx[i] = -1;
      dataset_hash = "";
      snapshot_count = 0;
      risklab_count = 0;
      first_entry_time = 0;
      last_entry_time  = 0;
      protocol_record_count = 0;
      development_record_count = 0;
      oos_record_count = 0;
      row_mask_hash = "";
      eligible_count = 0;
      excluded_count = 0;
      eligible_dev_count = 0;
      eligible_oos_count = 0;
      ArrayResize(eligible_record_indices, 0);
      ArrayResize(row_mask_flags, 0);
      fold_hash = "";
      min_train_n   = 50;
      min_train_pos = 10;
      min_val_n     = 20;
      min_val_pos   = 3;
      allow_oos_for_selection = false;
      evaluate_oos_after_final_selection_only = true;
      protocol_hash = "";
   }
};
// ================================================================
// Stage 2B Phase A — target-specific StopFlag evaluation context
// Independent from g_s2b_protocol; DEV-only row mask for selection.
// ================================================================
struct SS2BStopEvaluationContext
{
   bool     valid;
   string   invalid_reason;
   string   evaluator_version;
   string   target_name;
   string   target_definition;
   string   valid_row_policy;
   datetime development_from;
   datetime development_to;
   datetime historical_confirmation_from;
   datetime historical_confirmation_to;
   string   shared_protocol_hash;
   string   fold_hash;
   string   dataset_hash;
   string   row_mask_hash;
   string   target_hash;
   string   pool_hash;
   string   row_policy_hash;
   string   evaluation_context_hash;
   int      eligible_count;
   int      excluded_count;
   int      positive_count;
   int      negative_count;
   int      excluded_no_entry_time;
   int      excluded_outside_dev;
   int      excluded_incomplete_outcome;
   int      excluded_invalid_maxstep;
   int      excluded_missing_feature[S2B_COMPACT_POOL_SIZE];
   int      excluded_missing_feature_total;
   int      pool_feature_idx[S2B_COMPACT_POOL_SIZE];
   int      pool_feature_count;
   int      eligible_record_indices[];
   int      row_mask_flags[];
   bool     historical_confirmation_used;
   bool     threshold_selected;
   void Reset()
   {
      valid = false;
      invalid_reason = "";
      evaluator_version = S2B_EVALUATOR_VERSION;
      target_name = "StopFlag";
      target_definition = "rec.stop_flag == true";
      valid_row_policy = S2B_VALID_ROW_POLICY_STOP8;
      development_from = 0;
      development_to = 0;
      historical_confirmation_from = 0;
      historical_confirmation_to = 0;
      shared_protocol_hash = "";
      fold_hash = "";
      dataset_hash = "";
      row_mask_hash = "";
      target_hash = "";
      pool_hash = "";
      row_policy_hash = "";
      evaluation_context_hash = "";
      eligible_count = 0;
      excluded_count = 0;
      positive_count = 0;
      negative_count = 0;
      excluded_no_entry_time = 0;
      excluded_outside_dev = 0;
      excluded_incomplete_outcome = 0;
      excluded_invalid_maxstep = 0;
      excluded_missing_feature_total = 0;
      pool_feature_count = 0;
      for(int i = 0; i < S2B_COMPACT_POOL_SIZE; i++)
      {
         excluded_missing_feature[i] = 0;
         pool_feature_idx[i] = -1;
      }
      ArrayResize(eligible_record_indices, 0);
      ArrayResize(row_mask_flags, 0);
      historical_confirmation_used = false;
      threshold_selected = false;
   }
};
// ================================================================
// Phase B - one out-of-fold scored row (DEV validation years only)
// ================================================================
struct SS2BStopOOFRow
{
   int      rec_idx;
   int      fold_idx;
   datetime entry_time;
   double   prob;
   double   pct_rank;
   double   pooled_rank;
   int      stop_label;
   int      step4plus;
   int      target_flag;
   int      neutral_outcome;
   double   pnl;
   void Reset()
   {
      rec_idx = -1;
      fold_idx = -1;
      entry_time = 0;
      prob = 0.0;
      pct_rank = 0.0;
      pooled_rank = 0.0;
      stop_label = 0;
      step4plus = 0;
      target_flag = 0;
      neutral_outcome = 0;
      pnl = 0.0;
   }
};
// ================================================================
// Phase B - one threshold candidate (rejection quantile) result
// ================================================================
