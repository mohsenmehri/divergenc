//|Get Deinit Reason String - NEW HELPER|
string GetDeinitReasonString(int reason)
{
   switch(reason)
   {
      case REASON_PROGRAM:     return "Program ended";
      case REASON_REMOVE:      return "EA Removed";
      case REASON_RECOMPILE:   return "Recompiled";
      case REASON_CHARTCLOSE:  return "Chart closed";
      case REASON_PARAMETERS:  return "Parameters changed";
      case REASON_ACCOUNT:     return "Account changed";
      case REASON_TEMPLATE:    return "Template applied";
      case REASON_INITFAILED:  return "Init failed";
      case REASON_CLOSE:       return "Terminal closed";
      default: return "Unknown (" + IntegerToString(reason) + ")";
   }
}
void OnTick()
{
   static datetime last_bar = 0;
   datetime cur_bar = iTime(_Symbol, PERIOD_CURRENT, 0);
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only)
   {
      static datetime audit_last_bar=0;
      if(cur_bar<inp_div3_span_shadow_dev_start) return;
      if(cur_bar>=inp_div3_span_shadow_dev_end_exclusive)
      {
         if(!g_div3_span_shadow_dev_sealed)
         {
            if(audit_last_bar!=0) DIV3_SpanShadowUpdateOnBar();
            DIV3_SpanShadowFinalizeAll();
            g_div3_span_shadow_dev_sealed=true;
            Print("DIV3_SPAN_SHADOW|DEVELOPMENT_SEALED|At=",TimeToString(cur_bar,TIME_DATE|TIME_MINUTES),"|HoldoutOutcomeAccess=BLOCKED");
         }
         return;
      }
      if(cur_bar!=audit_last_bar)
      {
         if(audit_last_bar!=0) DIV3_SpanShadowUpdateOnBar();
         audit_last_bar=cur_bar;
         ProcessNewBar();
      }
      return;
   }
   bool shadow_update_enabled = (inp_enable_shadow_tracking || inp_enable_lifecycle_tracking ||
                                 inp_enable_research_protocol);
   // --- فقط روی کندل جدید ---
   if(cur_bar != last_bar)
   {
      // اول shadowهای مربوط به کندل بسته‌شده قبلی را آپدیت کن
      if(last_bar != 0 && shadow_update_enabled)
         UpdateShadowSignalsOnBar();
      if(last_bar != 0 && inp_div3_span_shadow_enabled)
         DIV3_SpanShadowUpdateOnBar();
      if(last_bar != 0 && inp_enable_market_edge_collector)
         ME_UpdateOnNewClosedBar();
      last_bar = cur_bar;
      ProcessNewBar();
   }
   if(g_processing)
      return;
   // DUAL/LIVE_P3 stream runs intrabar. Confirmed detection remains in
   // ProcessNewBar(), so both signal classes are observable independently.
   CheckLiveThreePivotDivergence();
   EvaluateArmedDivergencePipeline();
   bool market_open = IsMarketOpen();
   static bool was_market_closed = true;
   if(was_market_closed && market_open)
      CheckPendingEntries();
   was_market_closed = !market_open;
   int active_count = CountActiveSetups();
   if(active_count > 0)
      ManageSetups();
   if(g_pending_state_save && inp_enable_state_persistence)
   {
      if(g_fast_mode_active)
      {
         static int fast_save_counter = 0;
         fast_save_counter++;
         if(fast_save_counter >= 500)
         {
            SavePersistentState();
            g_pending_state_save = false;
            fast_save_counter = 0;
         }
      }
      else
      {
         SavePersistentState();
         g_pending_state_save = false;
      }
   }
   if(!g_fast_mode_active)
   {
      if(++g_tick_cnt % 100 == 0)
      {
         if(!g_testing || g_visual)
            DisplayStats();
      }
   }
}
void OnTimer()
{
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only)
      return;
   if(g_fast_mode_active)
      return;
   SaveAllSetups();
   if(inp_enable_state_persistence && inp_autosave_state_on_timer)
      SavePersistentState();
   if(inp_s2b_stop_d2024_run_mode != STOP_D2024_DISABLED)
   {
      static bool d2024_guard_logged = false;
      if(!d2024_guard_logged)
      {
         Print("STOP_D2024_TIMER_GUARD|THRESHOLD=BLOCKED|HOLDOUT=BLOCKED|FROZEN=BLOCKED|STAGE2C=BLOCKED|STAGE2D=BLOCKED");
         d2024_guard_logged = true;
      }
      return;
   }
   if(inp_s2d_run_mode == MODE_TRUE_FORWARD)
      S2D_RunForwardValidationIfReady(50);
   else
   {
      static bool guard_logged = false;
      if(!guard_logged)
      {
         Print("STOP_PHASE_A_TIMER_GUARD|STAGE2D=BLOCKED|Reason=NOT_TRUE_FORWARD_MODE");
         guard_logged = true;
      }
   }
}
void OnTrade()
{
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only) return;
   static datetime last_process_time = 0;
   datetime now = TimeCurrent();
   if(now - last_process_time < 2)
      return;
   last_process_time = now;
   if(!HistorySelect(now - 3600, now))
   {
      LogWarning("HistorySelect failed in OnTrade");
      return;
   }
   ProcessTradeEventsImproved();
}
bool WasPositionClosedInHistory(int setup_id, datetime from_time)
{
   string comment_filter = BuildComment(setup_id);
   if(!HistorySelect(from_time - 86400, TimeCurrent() + 60))
      return false;
   int deals_total = HistoryDealsTotal();
   // مرحله ۱: پیدا کردن POSITION_IDها از روی comment
   ulong pos_ids[];
   int pos_count = 0;
   for(int i = 0; i < deals_total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      if(StringFind(HistoryDealGetString(ticket, DEAL_COMMENT), comment_filter) >= 0)
      {
         ulong pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
         if(pid == 0) continue;
         bool found = false;
         for(int p = 0; p < pos_count; p++)
            if(pos_ids[p] == pid) { found = true; break; }
         if(!found)
         {
            ArrayResize(pos_ids, pos_count + 1);
            pos_ids[pos_count++] = pid;
         }
      }
   }
   if(pos_count == 0)
   {
      ArrayFree(pos_ids);
      return false;
   }
   // مرحله ۲: آیا close deal برای این positionها وجود دارد؟
   for(int i = 0; i < deals_total; i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      ENUM_DEAL_ENTRY entry = (ENUM_DEAL_ENTRY)HistoryDealGetInteger(ticket, DEAL_ENTRY);
      if(entry != DEAL_ENTRY_OUT && entry != DEAL_ENTRY_OUT_BY)
         continue;
      ulong deal_pid = (ulong)HistoryDealGetInteger(ticket, DEAL_POSITION_ID);
      for(int p = 0; p < pos_count; p++)
      {
         if(pos_ids[p] == deal_pid)
         {
            ArrayFree(pos_ids);
            return true;
         }
      }
   }
   ArrayFree(pos_ids);
   return false;
}
//|Process Trade Events - IMPROVED VERSION|
void ProcessTradeEventsImproved()
{
   for(int i = 0; i < g_setup_cnt; i++)
   {
      if(!g_setups[i].is_active)
         continue;
      if(g_setups[i].external_close_handled)
         continue;
      // A partial manual/basket close is not a completed setup. Never finalize
      // while even one matching position remains open.
      if(CountPositions(g_setups[i].setup_id) > 0)
         continue;
      // ✅ فقط اگر در گذشته واقعاً Deal Close داریم
      if(WasPositionClosedInHistory(g_setups[i].setup_id,
                                     g_setups[i].created_time))
      {
         HandleExternalClose(i);
      }
   }
}
//|Check if Setup exists in History - NEW HELPER|
bool IsSetupInHistory(int setup_id, datetime from_time)
{
   string comment_filter = BuildComment(setup_id);
   if(!HistorySelect(from_time, TimeCurrent()))
      return false;
   for(int i = 0; i < HistoryDealsTotal(); i++)
   {
      ulong ticket = HistoryDealGetTicket(i);
      if(ticket == 0) continue;
      string deal_comment = HistoryDealGetString(ticket, DEAL_COMMENT);
      if(StringFind(deal_comment, comment_filter) >= 0)
         return true;
   }
   return false;
}
void HandleExternalClose(int idx)
{
   if(idx < 0 || idx >= g_setup_cnt || !g_setups[idx].is_active) return;
   if(CountPositions(g_setups[idx].setup_id) > 0) return;
   g_setups[idx].external_close_handled = true;
   g_current_setup_id = g_setups[idx].setup_id;
   string reason  = GetCloseReason(g_setups[idx].setup_id,
                                   g_setups[idx].created_time);
   double profit  = CalcHistProfit(g_setups[idx].setup_id,
                                   g_setups[idx].created_time);
   if(MathAbs(profit) < 0.0000001)
   {
      Sleep(500);
      profit = CalcHistProfit(g_setups[idx].setup_id, g_setups[idx].created_time);
   }
   string final_path = BuildEventPath(idx);
   string evt_str = AppendFinalReasonToPath(final_path, reason);
   Print("! Setup #", g_setups[idx].setup_id,
         " closed externally| Reason: ", reason,
         "| Path: ", evt_str,
         "| Profit: $", DoubleToString(profit, 2));
   g_profile_stats[(int)TestProfile].completed++;
   g_profile_stats[(int)TestProfile].total_pnl+=profit;
   if(OS_IsStopToken(OS_GetFinalToken(evt_str))) g_profile_stats[(int)TestProfile].stops++;
   if(g_setups[idx].max_step_reached>=4) g_profile_stats[(int)TestProfile].deep4plus++;
   g_stats[1]++;
   int step = g_setups[idx].current_step;
   if(step >= 1 && step <= 5) g_stats[step + 1]++;
   FinalizeSnapshot(idx, profit, evt_str);
   RecordAnalysis(g_setups[idx].max_step_reached,
                  g_setups[idx].is_bullish,
                  evt_str, profit);
   // RX final label is written only after EXTERNAL_CLOSE core finalization.
   RX_FinalizeSetup(idx, profit, evt_str, false, "", true);
   if(inp_export_on_close)
      ExportToExcel(g_setups[idx].is_bullish, evt_str, profit, step,
                    g_setups[idx].max_drawdown_money,
                    g_setups[idx].max_drawdown_percent);
   SaveStats();
   // ============================
   // Stage 2D — collect forward record
   // For true-forward mode later
   // ============================
   if(g_s2b_compact_winner.trained)
      S2D_CollectForwardRecord(idx, profit, evt_str);
   DeleteBackups(g_setups[idx].setup_id);
   g_setups[idx].is_active = false;
}
void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only) return;
   if(id == CHARTEVENT_KEYDOWN)
   {
      switch((int)lparam)
      {
         case 69: //'E'
            Print("Exporting all analysis files...");
            ExportAllAnalysis();
            Alert("All files exported!");
            break;
         case 80: //'P'
            PrintEMAStats();
            break;
         case 68: //'D'
            Print("Exporting Dashboard...");
            ExportUnifiedDashboard();
            Alert("Dashboard exported!");
            break;
         case 71: //'G'
            Print("Calculating Group Statistics...");
            CalculateGroupStats();
            CompareGroupsDetailed(true);
            Print("Group stats calculated.");
            break;
         default:
            break;
      }
   }
}
//|PROCESS NEW BAR|
void ProcessNewBar()
{
   int bars = Bars(_Symbol, PERIOD_CURRENT);
   if(bars < MIN_BARS_REQUIRED) return;
   int copy_cnt = MathMin(bars - BUFFER_MARGIN, BUFFER_COPY_SIZE);
   if(!g_tf[0].CopyIndicatorBuffers(copy_cnt))
   {
      static datetime last_err = 0;
      if(TimeCurrent() - last_err > ERROR_COOLDOWN_SECONDS)
      { LogWarning("Failed to copy indicator buffers"); last_err = TimeCurrent(); }
      return;
   }
   // VA-RSI برای TF اصلی
   CalculateVARSI(g_tf[0], copy_cnt);
   // Higher TF refresh is only needed by dynamic stability sizing.
   bool need_mtf=(!inp_div3_span_shadow_audit_only || (inp_use_dynamic_step_sizing && inp_use_stability_based_sizing));
   for(int i = 1; i < TF_COUNT && need_mtf; i++)
   {
      int tf_bars = Bars(_Symbol, g_tf[i].timeframe);
      if(tf_bars < 50) continue;
      int tf_copy = MathMin(tf_bars - BUFFER_MARGIN, 100);
      if(tf_copy < 20) tf_copy = 20;
      g_tf[i].CopyIndicatorBuffers(tf_copy);
      CalculateVARSI(g_tf[i], tf_copy);
   }
   static int bar_cnt = 0;
   int cleanup_interval = g_fast_mode_active ? 5000 : 2000;
   if(++bar_cnt % cleanup_interval == 0) CleanupOldData();
   DetectPivots();
   if(inp_div3_span_shadow_enabled && inp_div3_span_shadow_audit_only)
   {
      CheckDivergence();
      return;
   }
   DetectOrderBlocks();
   CheckDivergence();
}
void ExportUnexportedSetups()
{
   // This function is reached only from OnDeinit(). Any setup still marked
   // active at this point is censored at end-of-test/end-of-run. The terminal
   // may have physically closed its position already, but that close is not a
   // strategy exit and must never enter realized research/statistics paths.
   for(int i = 0; i < g_setup_cnt; i++)
   {
      if(!g_setups[i].is_active) continue;
      g_current_setup_id = g_setups[i].setup_id;
      string eot_event = AppendFinalReasonToPath(g_setups[i].event_path, "EOT_OPEN");
      Print("EOT_CENSOR|Setup=", g_setups[i].setup_id,
            "|MaxStep=", g_setups[i].max_step_reached,
            "|RuntimePositionCount=", CountPositions(g_setups[i].setup_id),
            "|ResearchEvent=", eot_event,
            "|RealizedPnLIgnored=YES");
      // PositionOpen and RX records have already been finalized as EOT_OPEN in
      // OnDeinit. Deliberately do NOT call CalcHistProfit(), FinalizeSnapshot(),
      // RecordAnalysis(), ExportToExcel(), or S2D_CollectForwardRecord().
      // Those paths would treat a tester-forced close as a genuine strategy exit.
      DeleteBackups(g_setups[i].setup_id);
      g_setups[i].is_active = false;
   }
}
void PrintEMAStats()
{
   Print("===============================================================");
   Print("              EMA ORDER ANALYSIS - ", _Symbol);
   Print("===============================================================");
   bool has_data = false;
   //BUY
   Print("========================= BUY =================================");
   for(int step = 0; step < 5; step++)
   {
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(g_ema_buy[tf][step].total_trades == 0) continue;
         has_data = true;
         g_ema_buy[tf][step].SortDesc();
         Print("---------------------------------------------------------------");
         Print("BUY| STEP ", step + 1, "| ", g_tf[tf].name, "| Total: ", g_ema_buy[tf][step].total_trades,
               "| WinRate: ", DoubleToString(g_ema_buy[tf][step].GetWinRate(), 1), "%",
               "| Profit: $", DoubleToString(g_ema_buy[tf][step].total_profit, 2));
         for(int p = 0; p < g_ema_buy[tf][step].pattern_count && p < 5; p++)
         {
            double pct = g_ema_buy[tf][step].patterns[p].count * 100.0 / g_ema_buy[tf][step].total_trades;
            double wr = g_ema_buy[tf][step].patterns[p].GetWinRate();
            Print("  ", p + 1, ". ", g_ema_buy[tf][step].patterns[p].pattern, "| ",
                  g_ema_buy[tf][step].patterns[p].count, " (", DoubleToString(pct, 1), "%)| WR:", DoubleToString(wr, 0), "%");
         }
      }
   }
   //SELL
   Print("========================= SELL ================================");
   for(int step = 0; step < 5; step++)
   {
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(g_ema_sell[tf][step].total_trades == 0) continue;
         has_data = true;
         g_ema_sell[tf][step].SortDesc();
         Print("---------------------------------------------------------------");
         Print("SELL| STEP ", step + 1, "| ", g_tf[tf].name, "| Total: ", g_ema_sell[tf][step].total_trades,
               "| WinRate: ", DoubleToString(g_ema_sell[tf][step].GetWinRate(), 1), "%",
               "| Profit: $", DoubleToString(g_ema_sell[tf][step].total_profit, 2));
         for(int p = 0; p < g_ema_sell[tf][step].pattern_count && p < 5; p++)
         {
            double pct = g_ema_sell[tf][step].patterns[p].count * 100.0 / g_ema_sell[tf][step].total_trades;
            double wr = g_ema_sell[tf][step].patterns[p].GetWinRate();
            Print("  ", p + 1, ". ", g_ema_sell[tf][step].patterns[p].pattern, "| ",
                  g_ema_sell[tf][step].patterns[p].count, " (", DoubleToString(pct, 1), "%)| WR:", DoubleToString(wr, 0), "%");
         }
      }
   }
   if(!has_data) Print("NO DATA YET! Data recorded when trades CLOSE.");
   Print("===============================================================");
}
//|DISPLAY FUNCTIONS|
void BuildStatsComment()
{
   int pos_cnt = 0;
   double vol = 0, profit = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      ulong t = PositionGetTicket(i);
      if(t > 0 && PositionSelectByTicket(t))
      {
         if(PositionGetString(POSITION_SYMBOL) == _Symbol && (ulong)PositionGetInteger(POSITION_MAGIC) == inp_magic_number)
         { pos_cnt++; vol += PositionGetDouble(POSITION_VOLUME); profit += PositionGetDouble(POSITION_PROFIT); }
      }
   }
   double bal = AccountInfoDouble(ACCOUNT_BALANCE);
   double eq = AccountInfoDouble(ACCOUNT_EQUITY);
   double lot = GetLotSize();
   int closed = g_stats[1];
   double p1 = (closed > 0) ? (g_stats[2] * 100.0 / closed) : 0;
   double p2 = (closed > 0) ? (g_stats[3] * 100.0 / closed) : 0;
   double p3 = (closed > 0) ? (g_stats[4] * 100.0 / closed) : 0;
   double p4 = (closed > 0) ? (g_stats[5] * 100.0 / closed) : 0;
   double p5 = (closed > 0) ? (g_stats[6] * 100.0 / closed) : 0;
   string s = "\n";
   s += StringFormat("| Balance: $%.2f| Equity: $%.2f| Lot: %.2f\n", bal, eq, lot);
   s += "+-----------------------------------------------------------------------------------+\n";
   s += StringFormat("| Opened: %d| Positions: %d| Volume: %.2f| Profit: $%.2f\n", g_stats[0], pos_cnt, vol, profit);
   s += "+-----------------------------------------------------------------------------------+\n";
   s += StringFormat("| S1: %d (%.1f%%)| S2: %d (%.1f%%)| S3: %d (%.1f%%)| S4: %d (%.1f%%)| S5: %d (%.1f%%)\n",
                     g_stats[2], p1, g_stats[3], p2, g_stats[4], p3, g_stats[5], p4, g_stats[6], p5);
   //Main TF Table
   s += "+------------------------------- " + g_tf[0].name + " (Main) -------------------------------+\n";
   s += "|Step|  RSI| ADX|  CCI|  ATR| DI|      Time|    Day| Position| EMA Order| TP|\n";
   s += "+------------------------------------------------------------------------------------------------+\n";
   for(int i = 0; i < 5; i++)
   {
      if(g_step[i].is_valid[0])
      {
         string tp = (g_step[i].tp_status != "") ? g_step[i].tp_status : "--";
         s += StringFormat("| %d|%5.1f|%5.1f|%6.0f|%7.*f| %s| %s| %s| %s| %s| %s|\n",
               i + 1, g_step[i].rsi_value[0], g_step[i].adx_value[0], g_step[i].cci_value[0],
               _Digits, g_step[i].atr_value[0], g_step[i].di_status[0],
               TimeToString(g_step[i].step_time, TIME_DATE|TIME_MINUTES), g_step[i].day_name,
               g_step[i].position_status[0], g_step[i].ema_order[0], tp);
      }
      else s += StringFormat("| %d|  --|  --|  --|   --| --|       --|    --|    --|    --| --|\n", i + 1);
   }
   s += "+------------------------------------------------------------------------------------------------+\n\n";
   //MTF Tables
   for(int tf = 1; tf < TF_COUNT; tf++)
   {
      s += "+----------------------- " + g_tf[tf].name + " -----------------------+\n";
      s += "|Step| RSI| ADX|  CCI| ATR| DI| Position| EMA Order|\n";
      s += "+------------------------------------------------------------+\n";
      for(int i = 0; i < 5; i++)
      {
         if(g_step[i].is_valid[tf])
         {
            s += StringFormat("| %d|%5.1f|%5.1f|%5.0f|%5.*f| %s| %s| %s|\n",
                  i + 1, g_step[i].rsi_value[tf], g_step[i].adx_value[tf], g_step[i].cci_value[tf],
                  _Digits, g_step[i].atr_value[tf], g_step[i].di_status[tf],
                  g_step[i].position_status[tf], g_step[i].ema_order[tf]);
         }
         else s += StringFormat("| %d|  --|  --|  --|  --| --|    --|    --|\n", i + 1);
      }
      s += "+------------------------------------------------------------+\n\n";
   }
   g_stats_comment = s;
}
void DisplayStats()
{
   if(MQLInfoInteger(MQL_OPTIMIZATION)) return;
   if(!inp_show_stats_table) { Comment(""); return; }
   if(g_testing && !g_visual) { Comment(""); return; }
   if(TimeCurrent() - g_last_stats_update < inp_stats_update_seconds)
   { if(g_stats_comment != "") Comment(g_stats_comment); return; }
   g_last_stats_update = TimeCurrent();
   BuildStatsComment();
   Comment(g_stats_comment);
}
//|DRAWING FUNCTIONS|
void DrawDivLines(bool is_bull, CPivotPoint &old_piv, CPivotPoint &new_piv)
{
   datetime t_old = old_piv.pivot_time, t_new = new_piv.pivot_time;
   datetime t_cur = iTime(_Symbol, PERIOD_CURRENT, 1);
   if(t_old == 0|| t_new == 0|| t_cur == 0) return;
   double p_cur = is_bull ? iLow(_Symbol, PERIOD_CURRENT, 1) : iHigh(_Symbol, PERIOD_CURRENT, 1);
   string base = "DIV_" + TimeToString(t_cur, TIME_DATE|TIME_MINUTES) + "_";
   color clr = is_bull ? clrLime : clrRed;
   ObjectDelete(0, base + "L1");
   ObjectCreate(0, base + "L1", OBJ_TREND, 0, t_old, old_piv.price_level, t_new, new_piv.price_level);
   ObjectSetInteger(0, base + "L1", OBJPROP_COLOR, clrAqua);
   ObjectSetInteger(0, base + "L1", OBJPROP_WIDTH, inp_divergence_line_width);
   ObjectSetInteger(0, base + "L1", OBJPROP_RAY_RIGHT, false);
   ObjectDelete(0, base + "L2");
   ObjectCreate(0, base + "L2", OBJ_TREND, 0, t_new, new_piv.price_level, t_cur, p_cur);
   ObjectSetInteger(0, base + "L2", OBJPROP_COLOR, clr);
   ObjectSetInteger(0, base + "L2", OBJPROP_WIDTH, inp_divergence_line_width);
   ObjectSetInteger(0, base + "L2", OBJPROP_RAY_RIGHT, false);
   ObjectDelete(0, base + "Lbl");
   ObjectCreate(0, base + "Lbl", OBJ_TEXT, 0, t_cur, p_cur);
   ObjectSetString(0, base + "Lbl", OBJPROP_TEXT, is_bull ? ">> BUY" : ">> SELL");
   ObjectSetInteger(0, base + "Lbl", OBJPROP_COLOR, clr);
   ObjectSetInteger(0, base + "Lbl", OBJPROP_FONTSIZE, 10);
}
void DrawAllSignals()
{
   ObjectsDeleteAll(0, "LVL_"); ObjectsDeleteAll(0, "TGT_"); ObjectsDeleteAll(0, "BE_");
   int start = MathMax(0, g_signal_cnt - inp_signals_to_display);
   for(int i = start; i < g_signal_cnt; i++) DrawSignalLevels(i);
}
void DrawSignalLevels(int idx)
{
   if(idx < 0|| idx >= g_signal_cnt) return;
   if(g_signals[idx].GetCurrentBarShift() < 0) return;
   datetime st = g_signals[idx].signal_time;
   datetime et = st + PeriodSeconds() * inp_line_length_bars;
   color lc = g_signals[idx].is_bullish ? inp_bullish_color : inp_bearish_color;
   string pf = "LVL_" + IntegerToString(idx) + "_";
   for(int i = 0; i < 5; i++)
   {
      DrawLine(pf + IntegerToString(i), st, g_signals[idx].entry_levels[i], et, g_signals[idx].entry_levels[i], lc, inp_level_line_width);
      if(inp_show_level_labels) DrawLabel(pf + "L" + IntegerToString(i), st, g_signals[idx].entry_levels[i], IntegerToString(i + 1) + "x", lc);
   }
   pf = "TGT_" + IntegerToString(idx) + "_";
   for(int i = 0; i < 5; i++)
   {
      DrawLine(pf + IntegerToString(i), st, g_signals[idx].target_levels[i], et, g_signals[idx].target_levels[i], inp_target_color, 1, STYLE_DOT);
      if(inp_show_target_labels) DrawLabel(pf + "T" + IntegerToString(i), st, g_signals[idx].target_levels[i], "TP" + IntegerToString(i + 1), inp_target_color);
   }
   if(inp_show_breakeven_levels)
   {
      pf = "BE_" + IntegerToString(idx) + "_";
      for(int i = 0; i < 4; i++)
      {
         DrawLine(pf + IntegerToString(i), st, g_signals[idx].break_even_levels[i], et, g_signals[idx].break_even_levels[i], inp_breakeven_color, 1, STYLE_DOT);
         DrawLabel(pf + "L" + IntegerToString(i), st, g_signals[idx].break_even_levels[i], "BE" + IntegerToString(i + 2), inp_breakeven_color);
      }
   }
}
void DrawLine(string name, datetime t1, double p1, datetime t2, double p2, color clr, int w, ENUM_LINE_STYLE st = STYLE_SOLID)
{
   ObjectDelete(0, name);
   ObjectCreate(0, name, OBJ_TREND, 0, t1, p1, t2, p2);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, w);
   ObjectSetInteger(0, name, OBJPROP_STYLE, st);
   ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(0, name, OBJPROP_BACK, true);
}
void DrawLabel(string name, datetime t, double p, string txt, color clr)
{
   ObjectDelete(0, name);
   ObjectCreate(0, name, OBJ_TEXT, 0, t, p);
   ObjectSetString(0, name, OBJPROP_TEXT, txt);
   ObjectSetInteger(0, name, OBJPROP_COLOR, clr);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 8);
}
void ExportToExcel(bool is_bull, string evt, double profit, int steps,
                   double max_dd, double max_dd_pct)
{
   if(!inp_enable_export || !inp_enable_excel_export) return;
   if(StringFind(evt, "ENTRY_") >= 0) return;
   string fn = inp_export_file_name + "_" + g_symbol_name + ".csv";
   bool file_exists = FileIsExist(fn, FILE_COMMON);
   int h = INVALID_HANDLE;
   if(!file_exists)
   {
      h = SafeOpenCSV(fn);
      if(h == INVALID_HANDLE)
      {
         LogError("ExportToExcel: Cannot create CSV file: " + fn);
         return;
      }
      string header =
         "Row,TotalOpened,EntryDate,EntryTime,ExitDate,ExitTime,Duration,Day,MGStep,Step,"
         "Event,Signal,Symbol,TF,Pivot1Dist(dc),Pivot2Dist(span),RSI,ADX,CCI,ATR,DI,Position,EMAOrder,TPStatus,"
         "Profit,Status,MaxDD,DDPct,Step1,Step2,Step3,Step4,Step5,"
         "PivotGapMin,PivotGapMax,OB_DistPct,OB_InTol,"
         "ATR_Regime,ADX_Slope,EMA_Compression,Signal_CLV,Signal_BodyRatio,OB_AgeBars,OB_Width_ATR,"
         "PivotGap12,PivotGap23,PivotGapRatio,PriceLeg12_ATR,PriceLeg23_ATR,"
         "ConfirmationAfterP3,RSIReclaimAfterP3,TickVolRatio20,TickVolZ20,"
         "BarsSinceSwingHigh,BarsSinceSwingLow,DistanceToSwingHighATR,DistanceToSwingLowATR,"
         "SweptPriorHigh,SweptPriorLow,SweepDepthATR,CloseBackInsidePriorRange,SweepRejectionWickRatio,"
         "DistanceToPriorDayHighATR,DistanceToPriorDayLowATR,"
         "BreakOfStructureFlag,ChangeOfCharacterFlag,BarsSinceBOS,BarsSinceCHOCH,RangePositionLastN,"
         "BOSBreakDistanceATR,BarsBetweenSwingAndBOS,LastStructureEventType,StructureEventDirectionMatch,RangePositionSinceBOS,CHOCHBreakDistanceATR\r\n";
      if(FileWriteString(h, header) <= 0)
      {
         LogError("ExportToExcel: Cannot write CSV header");
         FileFlush(h);
         FileClose(h);
         return;
      }
   }
   else
   {
      h = SafeOpenAppend(fn);
      if(h == INVALID_HANDLE)
      {
         LogError("ExportToExcel: Cannot open CSV file for append: " + fn);
         return;
      }
   }
   g_export_path = TerminalInfoString(TERMINAL_COMMONDATA_PATH) + "\\Files\\" + fn;
   int closed = g_stats[1];
   double p1 = (closed > 0) ? (g_stats[2] * 100.0 / closed) : 0;
   double p2 = (closed > 0) ? (g_stats[3] * 100.0 / closed) : 0;
   double p3 = (closed > 0) ? (g_stats[4] * 100.0 / closed) : 0;
   double p4 = (closed > 0) ? (g_stats[5] * 100.0 / closed) : 0;
   double p5 = (closed > 0) ? (g_stats[6] * 100.0 / closed) : 0;
   string s1 = (g_stats[2] == 0) ? "---" : StringFormat("%d (%.1f%%)", g_stats[2], p1);
   string s2 = (g_stats[3] == 0) ? "---" : StringFormat("%d (%.1f%%)", g_stats[3], p2);
   string s3 = (g_stats[4] == 0) ? "---" : StringFormat("%d (%.1f%%)", g_stats[4], p3);
   string s4 = (g_stats[5] == 0) ? "---" : StringFormat("%d (%.1f%%)", g_stats[5], p4);
   string s5 = (g_stats[6] == 0) ? "---" : StringFormat("%d (%.1f%%)", g_stats[6], p5);
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   string exit_date = StringFormat("%04d/%02d/%02d", dt.year, dt.mon, dt.day);
   string exit_time = TimeToString(TimeCurrent(), TIME_MINUTES);
   string sig    = is_bull ? "BUY" : "SELL";
   string status = (StringFind(evt, "SL") >= 0 ||
                    StringFind(evt, "STOP") >= 0 ||
                    profit < 0) ? "STOP" : "--";
   int snap_idx = FindSnapshotIndexBySetupId(g_current_setup_id);
   SEntrySnapshot snap;
   bool snap_ok = false;
   if(snap_idx >= 0)
   {
      snap = g_snapshots[snap_idx];
      snap_ok = true;
   }
   else if(g_current_snapshot.setup_id == g_current_setup_id)
   {
      snap = g_current_snapshot;
      snap_ok = true;
   }
   bool wrote_any = false;
   for(int s = 0; s < steps; s++)
   {
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(!g_step[s].is_valid[tf]) continue;
         g_row_cnt++;
         string dur = (g_step[s].step_time > 0)
                      ? GetDuration(g_step[s].step_time, TimeCurrent()) : "--";
         string tp  = (s < 2 && g_step[s].tp_status != "") ? g_step[s].tp_status : "--";
         string pv1 = (tf == 0) ? IntegerToString(g_piv1_dist) : "--";
         string pv2 = (tf == 0) ? IntegerToString(g_piv2_dist) : "--";
         string gapMin = (tf == 0) ? IntegerToString(g_piv_gap_min) : "--";
         string gapMax = (tf == 0) ? IntegerToString(g_piv_gap_max) : "--";
         string obPct  = (tf == 0 && g_ob_dist_pct >= 0) ? DoubleToString(g_ob_dist_pct, 4) : "--";
         string obTol  = (tf == 0) ? IntegerToString(g_ob_in_tol) : "--";
         string atrReg   = "--";
         string adxSlope = "--";
         string emaComp  = "--";
         string sigCLV   = "--";
         string sigBody  = "--";
         string obAge    = "--";
         string obWatr   = "--";
         string pg12     = "--";
         string pg23     = "--";
         string pgr      = "--";
         string pl12atr  = "--";
         string pl23atr  = "--";
         string confp3   = "--";
         string rsirecl  = "--";
         string tvr20    = "--";
         string tvz20    = "--";
         string bssh     = "--";
         string bssl     = "--";
         string dsha     = "--";
         string dsla     = "--";
         string swph     = "--";
         string swpl     = "--";
         string swd      = "--";
         string cbir     = "--";
         string swrr     = "--";
         string dpdh     = "--";
         string dpdl     = "--";
         string bosf     = "--";
         string chochf   = "--";
         string bsb      = "--";
         string bschoch  = "--";
         string rpln     = "--";
         string bosdist  = "--";
         string bswingbos= "--";
         string lset     = "--";
         string sedm     = "--";
         string rpsb     = "--";
         string chochdist= "--";
         if(snap_ok)
         {
            atrReg   = DoubleToString(snap.atr_regime[tf], 3);
            adxSlope = DoubleToString(snap.adx_slope[tf], 3);
            emaComp  = DoubleToString(snap.ema_compression[tf], 3);
            if(tf == 0)
            {
               sigCLV  = DoubleToString(snap.signal_clv, 3);
               sigBody = DoubleToString(snap.signal_body_ratio, 3);
               obAge   = IntegerToString(snap.ob_age_bars);
               obWatr  = DoubleToString(snap.ob_width_atr, 3);
               pg12    = IntegerToString(snap.pivot_gap_12);
               pg23    = IntegerToString(snap.pivot_gap_23);
               pgr     = DoubleToString(snap.pivot_gap_ratio, 4);
               pl12atr = DoubleToString(snap.price_leg_12_atr, 4);
               pl23atr = DoubleToString(snap.price_leg_23_atr, 4);
               confp3  = (snap.confirmation_after_p3 ? "1" : "0");
               rsirecl = (snap.rsi_reclaim_after_p3 ? "1" : "0");
               tvr20   = DoubleToString(snap.tick_volume_ratio_20, 4);
               tvz20   = DoubleToString(snap.tick_volume_zscore_20, 4);
               bssh    = IntegerToString(snap.bars_since_swing_high);
               bssl    = IntegerToString(snap.bars_since_swing_low);
               dsha    = DoubleToString(snap.distance_to_swing_high_atr, 4);
               dsla    = DoubleToString(snap.distance_to_swing_low_atr, 4);
               swph    = (snap.swept_prior_high ? "1" : "0");
               swpl    = (snap.swept_prior_low ? "1" : "0");
               swd     = DoubleToString(snap.sweep_depth_atr, 4);
               cbir    = (snap.close_back_inside_prior_range ? "1" : "0");
               swrr    = DoubleToString(snap.sweep_rejection_wick_ratio, 4);
               dpdh    = DoubleToString(snap.distance_to_prior_day_high_atr, 4);
               dpdl    = DoubleToString(snap.distance_to_prior_day_low_atr, 4);
               bosf     = (snap.break_of_structure_flag ? "1" : "0");
               chochf   = (snap.change_of_character_flag ? "1" : "0");
               bsb      = IntegerToString(snap.bars_since_bos);
               bschoch  = IntegerToString(snap.bars_since_choch);
               rpln     = DoubleToString(snap.range_position_last_n, 4);
               bosdist   = DoubleToString(snap.bos_break_distance_atr, 4);
               bswingbos = IntegerToString(snap.bars_between_swing_and_bos);
               lset      = IntegerToString(snap.last_structure_event_type);
               sedm      = (snap.structure_event_direction_match ? "1" : "0");
               rpsb      = DoubleToString(snap.range_position_since_bos, 4);
               chochdist = DoubleToString(snap.choch_break_distance_atr, 4);
            }
         }
         string row =
            IntegerToString(g_row_cnt) + "," +
            IntegerToString(g_stats[0]) + "," +
            g_step[s].step_date_str + "," +
            g_step[s].step_time_str + "," +
            exit_date + "," +
            exit_time + "," +
            dur + "," +
            EscapeCSV(g_step[s].day_name) + "," +
            IntegerToString(steps) + "," +
            IntegerToString(s + 1) + "," +
            evt + "," +
            sig + "," +
            _Symbol + "," +
            g_tf[tf].name + "," +
            pv1 + "," +
            pv2 + "," +
            DoubleToString(g_step[s].rsi_value[tf], 2) + "," +
            DoubleToString(g_step[s].adx_value[tf], 2) + "," +
            DoubleToString(g_step[s].cci_value[tf], 1) + "," +
            DoubleToString(g_step[s].atr_value[tf], _Digits) + "," +
            g_step[s].di_status[tf] + "," +
            EscapeCSV(g_step[s].position_status[tf]) + "," +
            EscapeCSV(g_step[s].ema_order[tf]) + "," +
            tp + "," +
            DoubleToString(profit, 2) + "," +
            status + "," +
            DoubleToString(max_dd, 2) + "," +
            DoubleToString(max_dd_pct, 2) + "," +
            s1 + "," + s2 + "," + s3 + "," + s4 + "," + s5 + "," +
            gapMin + "," + gapMax + "," +
            obPct + "," + obTol + "," +
            atrReg + "," + adxSlope + "," +
            emaComp + "," + sigCLV + "," +
            sigBody + "," + obAge + "," +
            obWatr + "," +
            pg12 + "," + pg23 + "," + pgr + "," +
            pl12atr + "," + pl23atr + "," +
            confp3 + "," + rsirecl + "," +
            tvr20 + "," + tvz20 + "," +
            bssh + "," + bssl + "," +
            dsha + "," + dsla + "," +
            swph + "," + swpl + "," + swd + "," +
            cbir + "," + swrr + "," +
            dpdh + "," + dpdl + "," +
            bosf + "," + chochf + "," + bsb + "," + bschoch + "," + rpln + "," +
            bosdist + "," + bswingbos + "," + lset + "," + sedm + "," + rpsb + "," + chochdist + "\r\n";
         if(FileWriteString(h, row) <= 0)
         {
            LogError("ExportToExcel: Write failed at row " + IntegerToString(g_row_cnt));
            FileFlush(h);
            FileClose(h);
            return;
         }
         wrote_any = true;
      }
   }
   if(wrote_any)
   {
      if(FileWriteString(h, BuildCSVSeparatorLine(75)) <= 0)
         LogError("ExportToExcel: Cannot write separator line");
   }
   g_pos_open_time = 0;
   SaveStats();
   FileFlush(h);
   FileClose(h);
   if(inp_enable_state_persistence && inp_autosave_state_on_close)
      g_pending_state_save = true;
   if(!g_fast_mode_active && inp_enable_export)
   {
      static datetime last_full_export = 0;
      if(TimeCurrent() - last_full_export >= DAILY_STATS_EXPORT_INTERVAL)
      {
         ExportAllAnalysis();
         last_full_export = TimeCurrent();
      }
   }
}
//==================== CSV PRO DASHBOARD + COMBINED FILTER MINING (STOP + STEP4+) ====================
string CPD_Trim(string s)
{
   StringTrimLeft(s);
   StringTrimRight(s);
   return s;
}
string CPD_ToUpperASCII(string s)
{
   int len = StringLen(s);
   for(int i=0; i<len; i++)
   {
      ushort ch = (ushort)StringGetCharacter(s, i);
      if(ch >= 97 && ch <= 122) StringSetCharacter(s, i, (ushort)(ch - 32));
   }
   return s;
}
string CPD_StripQuotes(string s)
{
   s = CPD_Trim(s);
   int len = StringLen(s);
   if(len >= 2)
   {
      if(StringGetCharacter(s,0) == '\"' && StringGetCharacter(s,len-1) == '\"')
         s = StringSubstr(s, 1, len-2);
   }
   StringReplace(s, "\"", "");
   return CPD_Trim(s);
}
bool CPD_IsHeaderLine(string line)
{
   line = CPD_Trim(line);
   if(StringFind(line, "sep=") == 0) return true;
   if(StringFind(line, "Row,TotalOpened,EntryDate") == 0) return true;
   return false;
}
bool CPD_IsSeparatorLine(string line)
{
   line = CPD_Trim(line);
   return (StringFind(line, "---,---,---") == 0);
}
int CPD_ParseHour(string hhmm)
{
   hhmm = CPD_Trim(hhmm);
   string a[];
   int n = StringSplit(hhmm, ':', a);
   if(n < 1) return -1;
   int h = (int)StringToInteger(a[0]);
   if(h < 0 || h > 23) return -1;
   return h;
}
int CPD_DayIndex(string day)
{
   day = CPD_ToUpperASCII(CPD_Trim(day));
   if(day == "SUNDAY")    return 0;
   if(day == "MONDAY")    return 1;
   if(day == "TUESDAY")   return 2;
   if(day == "WEDNESDAY") return 3;
   if(day == "THURSDAY")  return 4;
   if(day == "FRIDAY")    return 5;
   if(day == "SATURDAY")  return 6;
   return -1;
}
long CPD_ParseDurationSec(string dur)
{
   dur = CPD_Trim(dur);
   if(dur == "" || dur == "--") return 0;
   string p[];
   int n1 = StringSplit(dur, '/', p);
   if(n1 != 2) return 0;
   int days = (int)StringToInteger(p[0]);
   string t[];
   int n2 = StringSplit(p[1], ':', t);
   if(n2 < 3) return 0;
   int hh = (int)StringToInteger(t[0]);
   int mm = (int)StringToInteger(t[1]);
   int ss = (int)StringToInteger(t[2]);
   if(days < 0) days = 0;
   if(hh < 0) hh = 0;
   if(mm < 0) mm = 0;
   if(ss < 0) ss = 0;
   return (long)days*86400L + (long)hh*3600L + (long)mm*60L + (long)ss;
}
// Normalize a token: TP1..TP5, EMA, SL, SL$, STOP
string CPD_NormTok(string t)
{
   t = CPD_ToUpperASCII(CPD_Trim(t));
   if(t == "") return "";
   if(StringFind(t, "SL_DOLLAR") >= 0 || StringFind(t, "SL$") >= 0 || StringFind(t, "SL_$") >= 0) return "SL$";
   if(StringFind(t, "STOP") >= 0 || StringFind(t, "MARGIN") >= 0) return "STOP";
   if(StringFind(t, "SL") >= 0) return "SL";
   if(StringFind(t, "EMA") >= 0) return "EMA";
   if(StringFind(t, "TP1") >= 0) return "TP1";
   if(StringFind(t, "TP2") >= 0) return "TP2";
   if(StringFind(t, "TP3") >= 0) return "TP3";
   if(StringFind(t, "TP4") >= 0) return "TP4";
   if(StringFind(t, "TP5") >= 0) return "TP5";
   // Generic target/profit (external close)
   if(StringFind(t, "TAKE_PROFIT") >= 0) return "TP";
   if(StringFind(t, "TARGET") >= 0)      return "TP";
   if(StringFind(t, "PROFIT") >= 0)      return "TP";
   return t;
}
string CPD_GetFinalToken(string evt)
{
   evt = CPD_Trim(evt);
   if(evt == "") return "";
   // normalize arrows
   StringReplace(evt, "->", "|");
   string parts[];
   int n = StringSplit(evt, '|', parts);
   if(n <= 0) return CPD_NormTok(evt);
   string last = parts[n-1];
   return CPD_NormTok(last);
}
bool CPD_PathHasToken(string path, string tok)
{
   path = NormalizeEventString(path);
   tok  = NormalizeEventToken(tok);
   if(path == "" || tok == "")
      return false;
   return (StringFind(path, tok) >= 0);
}
datetime CPD_ParseDateTime(string d, string t)
{
   string s = d + " " + t;
   StringReplace(s, "/", ".");
   return StringToTime(s);
}
bool CPD_IsStopToken(string tok)
{
   tok = CPD_NormTok(tok);
   return (tok == "SL" || tok == "SL$" || tok == "STOP");
}
bool CPD_IsTargetToken(string tok)
{
   tok = CPD_NormTok(tok);
   if(tok == "EMA") return true;
   if(StringFind(tok, "TP") == 0) return true;
   return false;
}
int CPD_TFIndexByName(string tfName)
{
   tfName = CPD_StripQuotes(tfName);
   for(int i=0; i<TF_COUNT; i++)
      if(g_tf[i].name == tfName)
         return i;
   return -1;
}
struct CPD_Trade
{
   bool   inited;
   bool   is_buy;
   // Meta
   string entry_date;
   string entry_time;
   string day_name;
   int    entry_hour;
   int    day_index;
   long   duration_sec;
   // Outcome
   int    mg_step;
   double profit;
   string event;
   bool   is_stop;
   bool   is_target;
   // Deep definition = Step4+ (your chosen)
   bool   is_step4p;
   bool   is_step4p_stop;
   bool   is_step4p_nostop;
   // Pivots (Main TF only)
   int pivot1_dist;
   int pivot2_dist;
   // NEW: Pivot gaps & OB precision (Main TF only)
   int    piv_gap_min;
   int    piv_gap_max;
   double ob_dist_pct;     // -1 if no OB found
   int    ob_in_tol;       // 1 if ob_dist_pct <= inp_ob_touch_precision_pct
   // Step1 features per TF
   bool   has_tf[TF_COUNT];
   double rsi[TF_COUNT];
   double adx[TF_COUNT];
   double cci[TF_COUNT];
   double atr[TF_COUNT];
   string di[TF_COUNT];
   string ema_order[TF_COUNT];
   string position[TF_COUNT];
   // New research features per TF
   double atr_regime[TF_COUNT];
   double adx_slope[TF_COUNT];
   double ema_compression[TF_COUNT];
   // New research features (main signal)
   double signal_clv;
   double signal_body_ratio;
   int    ob_age_bars;
   double ob_width_atr;
   // TP path / outcome reconstruction
   string tp_status_path;
   bool   hit_tp1;
   bool   hit_tp2;
   bool   hit_ema200;
   void Reset()
   {
      inited = false;
      is_buy = true;
      entry_date = "";
      entry_time = "";
      day_name = "";
      entry_hour = -1;
      day_index = -1;
      duration_sec = 0;
      mg_step = 0;
      profit = 0;
      event = "";
      is_stop = false;
      is_target = false;
      is_step4p = false;
      is_step4p_stop = false;
      is_step4p_nostop = false;
      pivot1_dist = 0;
      pivot2_dist = 0;
      piv_gap_min = 0;
      piv_gap_max = 0;
      ob_dist_pct = -1;
      ob_in_tol = 0;
      signal_clv = 0.0;
      signal_body_ratio = 0.0;
      ob_age_bars = -1;
      ob_width_atr = 0.0;
      tp_status_path = "";
      hit_tp1 = false;
      hit_tp2 = false;
      hit_ema200 = false;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         has_tf[tf] = false;
         rsi[tf] = 0.0;
         adx[tf] = 0.0;
         cci[tf] = 0.0;
         atr[tf] = 0.0;
         di[tf] = "";
         ema_order[tf] = "";
         position[tf] = "";
         atr_regime[tf] = 0.0;
         adx_slope[tf] = 0.0;
         ema_compression[tf] = 0.0;
      }
   }
};
int CPD_LoadTradesFromCSV(CPD_Trade &outTrades[])
{
   ArrayResize(outTrades, 0);
   string fn = inp_export_file_name + "_" + g_symbol_name + ".csv";
   int h = FileOpen(fn, FILE_READ|FILE_TXT|FILE_SHARE_READ|FILE_COMMON);
   if(h == INVALID_HANDLE)
   {
      Print("CPD: Cannot open CSV: ", fn);
      return 0;
   }
   CPD_Trade cur;
   cur.Reset();
   bool has_any_row = false;
   while(!FileIsEnding(h))
   {
      string line = FileReadString(h);
      if(StringLen(line) < 3) continue;
      if(CPD_IsHeaderLine(line)) continue;
      if(CPD_IsSeparatorLine(line))
      {
         if(has_any_row && cur.inited)
         {
            string ft = CPD_GetFinalToken(cur.event);
            cur.is_stop   = CPD_IsStopToken(ft);
            cur.is_target = CPD_IsTargetToken(ft);
            cur.is_step4p        = (cur.mg_step >= 4);
            cur.is_step4p_stop   = (cur.is_step4p && cur.is_stop);
            cur.is_step4p_nostop = (cur.is_step4p && !cur.is_stop);
            int sz = ArraySize(outTrades);
            ArrayResize(outTrades, sz+1);
            outTrades[sz] = cur;
         }
         cur.Reset();
         has_any_row = false;
         continue;
      }
      string parts[];
      int cnt = StringSplit(line, ',', parts);
      if(cnt < 25) continue;
      string entryDate = CPD_StripQuotes(parts[2]);
      string entryTime = CPD_StripQuotes(parts[3]);
      string durStr    = CPD_StripQuotes(parts[6]);
      string dayStr    = CPD_StripQuotes(parts[7]);
      int mg_step = (int)StringToInteger(parts[8]);
      int step    = (int)StringToInteger(parts[9]);
      string evt  = CPD_StripQuotes(parts[10]);
      string sig  = CPD_StripQuotes(parts[11]);
      string tfN  = CPD_StripQuotes(parts[13]);
      int piv1 = 0, piv2 = 0;
      if(cnt > 15)
      {
         if(StringFind(parts[14], "-") < 0) piv1 = (int)StringToInteger(parts[14]);
         if(StringFind(parts[15], "-") < 0) piv2 = (int)StringToInteger(parts[15]);
      }
      double rsi  = (cnt > 16) ? StringToDouble(parts[16]) : 0;
      double adx  = (cnt > 17) ? StringToDouble(parts[17]) : 0;
      double cci  = (cnt > 18) ? StringToDouble(parts[18]) : 0;
      double atr  = (cnt > 19) ? StringToDouble(parts[19]) : 0;
      string di   = (cnt > 20) ? CPD_StripQuotes(parts[20]) : "";
      string pos  = (cnt > 21) ? CPD_StripQuotes(parts[21]) : "";
      string ema  = (cnt > 22) ? CPD_StripQuotes(parts[22]) : "";
      string tpst = (cnt > 23) ? CPD_StripQuotes(parts[23]) : "";
      double profit = StringToDouble(parts[24]);
      int    gapMin = 0, gapMax = 0, obTol = 0;
      double obPct  = -1;
      if(cnt >= 37)
      {
         if(StringFind(parts[33], "-") < 0) gapMin = (int)StringToInteger(parts[33]);
         if(StringFind(parts[34], "-") < 0) gapMax = (int)StringToInteger(parts[34]);
         if(StringFind(parts[35], "-") < 0) obPct  = StringToDouble(parts[35]);
         if(StringFind(parts[36], "-") < 0) obTol  = (int)StringToInteger(parts[36]);
      }
      double atrReg = 0, adxSlope = 0, emaComp = 0;
      double sigCLV = 0, sigBody = 0, obWatr = 0;
      int obAge = -1;
      if(cnt >= 44)
      {
         if(StringFind(parts[37], "-") < 0) atrReg   = StringToDouble(parts[37]);
         if(StringFind(parts[38], "-") < 0) adxSlope = StringToDouble(parts[38]);
         if(StringFind(parts[39], "-") < 0) emaComp  = StringToDouble(parts[39]);
         if(StringFind(parts[40], "-") < 0) sigCLV   = StringToDouble(parts[40]);
         if(StringFind(parts[41], "-") < 0) sigBody  = StringToDouble(parts[41]);
         if(StringFind(parts[42], "-") < 0) obAge    = (int)StringToInteger(parts[42]);
         if(StringFind(parts[43], "-") < 0) obWatr   = StringToDouble(parts[43]);
      }
      if(!cur.inited)
      {
         cur.inited = true;
         cur.is_buy = (sig == "BUY");
         cur.mg_step = mg_step;
         cur.profit  = profit;
         cur.event   = NormalizeEventString(evt);
         cur.entry_date = entryDate;
         cur.entry_time = entryTime;
         cur.day_name   = dayStr;
         cur.entry_hour = CPD_ParseHour(entryTime);
         cur.day_index  = CPD_DayIndex(dayStr);
         cur.duration_sec = CPD_ParseDurationSec(durStr);
         cur.pivot1_dist = 0;
         cur.pivot2_dist = 0;
         cur.piv_gap_min = 0;
         cur.piv_gap_max = 0;
         cur.ob_dist_pct = -1;
         cur.ob_in_tol   = 0;
         cur.signal_clv = sigCLV;
         cur.signal_body_ratio = sigBody;
         cur.ob_age_bars = obAge;
         cur.ob_width_atr = obWatr;
         cur.tp_status_path = "";
         cur.hit_tp1 = false;
         cur.hit_tp2 = false;
         cur.hit_ema200 = false;
      }
      has_any_row = true;
      if(tpst != "" && tpst != "--")
      {
         cur.tp_status_path = NormalizeEventString(tpst);
         cur.hit_tp1 = CPD_PathHasToken(cur.tp_status_path, "TP1");
         cur.hit_tp2 = CPD_PathHasToken(cur.tp_status_path, "TP2");
         cur.hit_ema200 = CPD_PathHasToken(cur.tp_status_path, "EMA");
      }
      if(step != 1) continue;
      int tf = CPD_TFIndexByName(tfN);
      if(tf < 0 || tf >= TF_COUNT) continue;
      if(tf == 0)
      {
         if(piv1 > 0) cur.pivot1_dist = piv1;
         if(piv2 > 0) cur.pivot2_dist = piv2;
         if(gapMin > 0) cur.piv_gap_min = gapMin;
         if(gapMax > 0) cur.piv_gap_max = gapMax;
         if(obPct >= 0) cur.ob_dist_pct = obPct;
         cur.ob_in_tol = obTol;
         cur.signal_clv = sigCLV;
         cur.signal_body_ratio = sigBody;
         cur.ob_age_bars = obAge;
         cur.ob_width_atr = obWatr;
      }
      di = CPD_Trim(di);
      if(di != "+" && di != "-") di = "";
      cur.has_tf[tf]    = true;
      cur.rsi[tf]       = rsi;
      cur.adx[tf]       = adx;
      cur.cci[tf]       = cci;
      cur.atr[tf]       = atr;
      cur.di[tf]        = di;
      cur.position[tf]  = pos;
      cur.ema_order[tf] = ema;
      cur.atr_regime[tf] = atrReg;
      cur.adx_slope[tf] = adxSlope;
      cur.ema_compression[tf] = emaComp;
   }
   if(has_any_row && cur.inited)
   {
      string ft = CPD_GetFinalToken(cur.event);
      cur.is_stop   = CPD_IsStopToken(ft);
      cur.is_target = CPD_IsTargetToken(ft);
      cur.is_step4p        = (cur.mg_step >= 4);
      cur.is_step4p_stop   = (cur.is_step4p && cur.is_stop);
      cur.is_step4p_nostop = (cur.is_step4p && !cur.is_stop);
      int sz = ArraySize(outTrades);
      ArrayResize(outTrades, sz+1);
      outTrades[sz] = cur;
   }
   FileClose(h);
   return ArraySize(outTrades);
}
bool RebuildAllAnalysisFromCSV()
{
   if(g_rebuild_mode)
      Print("RebuildAllAnalysisFromCSV: running in rebuild mode (Research disabled)");
   CPD_Trade trades[];
   int n = CPD_LoadTradesFromCSV(trades);
   if(n <= 0)
   {
      ArrayFree(trades);
      return false;
   }
   InitAllAnalysis();
   if(ArraySize(g_snapshots) < n + 50)
      ArrayResize(g_snapshots, n + 50);
   if(ArraySize(g_risklab_records) < n + 50)
      ArrayResize(g_risklab_records, n + 50);
   for(int i = 0; i < n; i++)
   {
      if(!trades[i].inited) continue;
      if(trades[i].mg_step < 1 || trades[i].mg_step > 5) continue;
      int synthetic_id = 1000000 + i;
      string final_evt = NormalizeEventString(trades[i].event);
      if(trades[i].tp_status_path != "" && trades[i].tp_status_path != "--")
         final_evt = AppendFinalReasonToPath(trades[i].tp_status_path, trades[i].event);
      int max_step = trades[i].mg_step;
      int si       = max_step - 1;
      bool is_win  = (trades[i].profit > 0);
      for(int s = 0; s < max_step; s++)
      {
         g_step_reach_count[s]++;
         g_step_cumulative_profit[s] += trades[i].profit;
         if(is_win) g_step_cumulative_wins[s]++;
         g_step_entries[s]++;
         if(s < max_step - 1) g_step_survivals[s]++;
      }
      g_step_close_count[si]++;
      g_step_close_profit[si] += trades[i].profit;
      if(is_win) g_step_close_wins[si]++;
      g_step_profits[si] += trades[i].profit;
      if(is_win) g_step_wins[si]++;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(!trades[i].has_tf[tf]) continue;
         if(trades[i].is_buy)
         {
            g_ema_buy[tf][si].AddPattern(trades[i].ema_order[tf], trades[i].profit);
            g_ema_buy[tf][si].AddPosition(trades[i].position[tf], trades[i].profit);
            g_ema_buy[tf][si].AddEvent(final_evt, trades[i].profit);
            g_rsi_buy[tf][si].AddValue(trades[i].rsi[tf], trades[i].profit);
            g_rsi_buy[tf][si].AddEvent(final_evt, trades[i].profit);
            g_adx_buy[tf][si].AddADX(trades[i].adx[tf], trades[i].profit);
            g_adx_buy[tf][si].AddDI(trades[i].di[tf], trades[i].profit);
            g_adx_buy[tf][si].AddEvent(final_evt, trades[i].profit);
            g_cci_buy[tf][si].AddValue(trades[i].cci[tf], trades[i].profit);
            g_cci_buy[tf][si].AddEvent(final_evt, trades[i].profit);
            g_atr_buy[tf][si].AddValue(trades[i].atr[tf], _Digits, trades[i].profit);
            g_atr_buy[tf][si].AddEvent(final_evt, trades[i].profit);
         }
         else
         {
            g_ema_sell[tf][si].AddPattern(trades[i].ema_order[tf], trades[i].profit);
            g_ema_sell[tf][si].AddPosition(trades[i].position[tf], trades[i].profit);
            g_ema_sell[tf][si].AddEvent(final_evt, trades[i].profit);
            g_rsi_sell[tf][si].AddValue(trades[i].rsi[tf], trades[i].profit);
            g_rsi_sell[tf][si].AddEvent(final_evt, trades[i].profit);
            g_adx_sell[tf][si].AddADX(trades[i].adx[tf], trades[i].profit);
            g_adx_sell[tf][si].AddDI(trades[i].di[tf], trades[i].profit);
            g_adx_sell[tf][si].AddEvent(final_evt, trades[i].profit);
            g_cci_sell[tf][si].AddValue(trades[i].cci[tf], trades[i].profit);
            g_cci_sell[tf][si].AddEvent(final_evt, trades[i].profit);
            g_atr_sell[tf][si].AddValue(trades[i].atr[tf], _Digits, trades[i].profit);
            g_atr_sell[tf][si].AddEvent(final_evt, trades[i].profit);
         }
      }
      if(trades[i].is_buy)
         g_pivdist_buy[si].AddTrade(trades[i].pivot1_dist, trades[i].pivot2_dist,
                                    trades[i].profit, final_evt);
      else
         g_pivdist_sell[si].AddTrade(trades[i].pivot1_dist, trades[i].pivot2_dist,
                                     trades[i].profit, final_evt);
      SEntrySnapshot sn;
      sn.Reset();
      sn.setup_id          = synthetic_id;
      sn.entry_time        = CPD_ParseDateTime(trades[i].entry_date, trades[i].entry_time);
      sn.entry_hour        = trades[i].entry_hour;
      sn.entry_day_of_week = trades[i].day_index;
      sn.is_bullish        = trades[i].is_buy;
      sn.pivot1_dist       = trades[i].pivot1_dist;
      sn.pivot2_dist       = trades[i].pivot2_dist;
      sn.piv_gap_min       = trades[i].piv_gap_min;
      sn.piv_gap_max       = trades[i].piv_gap_max;
      sn.ob_dist_pct       = trades[i].ob_dist_pct;
      sn.ob_in_tol         = trades[i].ob_in_tol;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(!trades[i].has_tf[tf]) continue;
         sn.rsi[tf]             = trades[i].rsi[tf];
         sn.adx[tf]             = trades[i].adx[tf];
         sn.cci[tf]             = trades[i].cci[tf];
         sn.atr[tf]             = trades[i].atr[tf];
         sn.di[tf]              = trades[i].di[tf];
         sn.position[tf]        = trades[i].position[tf];
         sn.ema_order[tf]       = trades[i].ema_order[tf];
         sn.atr_regime[tf]      = trades[i].atr_regime[tf];
         sn.adx_slope[tf]       = trades[i].adx_slope[tf];
         sn.ema_compression[tf] = trades[i].ema_compression[tf];
         sn.ema200_dist[tf]     = 0.0;
         sn.plus_di[tf]         = 0.0;
         sn.minus_di[tf]        = 0.0;
         // LEGACY APPROXIMATION: di_gap not in legacy CSV
         sn.di_gap[tf] = (sn.di[tf] == "+" || sn.di[tf] == "-") ? 5.0 : 0.0;
      }
      sn.signal_clv        = trades[i].signal_clv;
      sn.signal_body_ratio = trades[i].signal_body_ratio;
      sn.ob_age_bars       = trades[i].ob_age_bars;
      sn.ob_width_atr      = trades[i].ob_width_atr;
      sn.actual_max_step = trades[i].mg_step;
      sn.final_profit    = trades[i].profit;
      sn.hit_tp1         = trades[i].hit_tp1;
      sn.hit_tp2         = trades[i].hit_tp2;
      sn.hit_ema200      = trades[i].hit_ema200;
      sn.close_event     = final_evt;
      // LEGACY APPROXIMATION: lifecycle fields not in CSV
      sn.mfe_money    = (trades[i].profit > 0) ? trades[i].profit : 0.0;
      sn.mae_money    = (trades[i].profit < 0) ? -trades[i].profit : 0.0;
      sn.max_dd_money = (trades[i].profit < 0) ? -trades[i].profit : 0.0;
      sn.mfe_points   = 0.0;
      sn.mae_points   = 0.0;
      sn.max_dd_pct   = 0.0;
      // Divergence quality features not available in legacy CSV
      sn.price_div_strength  = 0.0;
      sn.rsi_div_strength    = 0.0;
      sn.div_price_slope     = 0.0;
      sn.div_rsi_slope       = 0.0;
      sn.div_span_bars       = 0;
      sn.pivot_symmetry      = 0.0;
      sn.time_since_p3       = 0;
      sn.pivot_rsi_p1        = 0.0;
      sn.pivot_rsi_p2        = 0.0;
      sn.pivot_rsi_p3        = 0.0;
      sn.price_p1_to_p2_chg  = 0.0;
      sn.price_p2_to_p3_chg  = 0.0;
      sn.price_leg_ratio     = 0.0;
      sn.rsi_p1_to_p2_delta  = 0.0;
      sn.rsi_p2_to_p3_delta  = 0.0;
      sn.rsi_acceleration    = 0.0;
      sn.divergence_angle    = 0.0;
      ArrayInitialize(sn.step_entry_times,  0);
      ArrayInitialize(sn.step_entry_prices, 0.0);
      sn.CalculateDIAgreement();
      sn.CalculateEMACount();
      sn.CheckHTFConflict();
      SMTFPattern tmp;
      tmp.Reset();
      tmp.is_bullish = sn.is_bullish;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         if(sn.rsi[tf] > 0 && sn.rsi[tf] <= 100)
            tmp.rsi_range[tf] = ((int)MathFloor(sn.rsi[tf] / 5.0)) * 5;
         if(sn.adx[tf] > 0)
            tmp.adx_range[tf] = ((int)MathFloor(sn.adx[tf] / 5.0)) * 5;
         tmp.di_status[tf]  = sn.di[tf];
         tmp.ema_order[tf]  = sn.ema_order[tf];
      }
      SEnhancedStability stab = CalculateEnhancedStability(tmp);
      sn.stability_score = stab.GetTotal();
      sn.path_class      = ClassifyPath(sn);
      if(g_snapshot_count >= ArraySize(g_snapshots))
         ArrayResize(g_snapshots, g_snapshot_count + 100);
      g_snapshots[g_snapshot_count++] = sn;
      g_piv_gap_min = trades[i].piv_gap_min;
      g_piv_gap_max = trades[i].piv_gap_max;
      g_ob_dist_pct = trades[i].ob_dist_pct;
      g_ob_in_tol   = trades[i].ob_in_tol;
      SRiskLabRecord rl_rec = RL_BuildRecord(
         sn,
         sn.actual_max_step,
         sn.final_profit,
         sn.close_event,
         sn.max_dd_money,
         0.0
      );
      RL_AddRecord(rl_rec);
      double rr[TF_COUNT], aa[TF_COUNT], ccv[TF_COUNT], atv[TF_COUNT];
      string dd[TF_COUNT], ee[TF_COUNT], pp[TF_COUNT];
      bool   vv[TF_COUNT];
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         rr[tf]  = trades[i].rsi[tf];
         aa[tf]  = trades[i].adx[tf];
         ccv[tf] = trades[i].cci[tf];
         atv[tf] = trades[i].atr[tf];
         dd[tf]  = trades[i].di[tf];
         ee[tf]  = trades[i].ema_order[tf];
         pp[tf]  = trades[i].position[tf];
         vv[tf]  = trades[i].has_tf[tf];
      }
      BuildMTFPatternFromCSV(
         synthetic_id,
         trades[i].mg_step,
         trades[i].is_buy,
         trades[i].profit,
         final_evt,
         trades[i].pivot1_dist,
         trades[i].pivot2_dist,
         rr, aa, ccv, atv, dd, ee, pp, vv
      );
   }
   CalculateGroupStats();
   SortAllAnalysisData();
   // Rebuild lookup map — map was invalidated by InitAllAnalysis
   SnapMap_Rebuild();
   g_snap_map_dirty = false;
   ArrayFree(trades);
   Print("RebuildAllAnalysisFromCSV: done | snapshots=", g_snapshot_count,
         " | risklab=", g_risklab_count);
   return true;
}
#define CPD_MAX_KEYS 12
struct CPD_StrDist
{
   string keys[CPD_MAX_KEYS];
   int    cnt[CPD_MAX_KEYS];
   int    n;
   void Reset()
   {
      for(int i=0;i<CPD_MAX_KEYS;i++){ keys[i]=""; cnt[i]=0; }
      n=0;
      keys[CPD_MAX_KEYS-1]="OTHER";
   }
   void Add(string v)
   {
      if(v=="" || v=="N/A") v="N/A";
      for(int i=0;i<CPD_MAX_KEYS-1;i++)
         if(keys[i]==v){ cnt[i]++; n++; return; }
      for(int i=0;i<CPD_MAX_KEYS-1;i++)
         if(keys[i]==""){ keys[i]=v; cnt[i]=1; n++; return; }
      cnt[CPD_MAX_KEYS-1]++; n++;
   }
   string Top1(double &pct) const
   {
      pct = 0;
      if(n<=0) return "N/A";
      int bi=0, bc=-1;
      for(int i=0;i<CPD_MAX_KEYS;i++)
         if(cnt[i]>bc){ bc=cnt[i]; bi=i; }
      pct = bc*100.0/n;
      return (keys[bi]!="" ? keys[bi] : "N/A");
   }
};
struct CPD_Agg
{
   int count, win;
   int stop_cnt, step4_cnt;
   double profit_sum;
   int hour_hist[24];
   int day_hist[7];
   int mg_hist[5];
   double piv1_sum, piv2_sum;
   int tf_valid[TF_COUNT];
   double rsi_sum[TF_COUNT], adx_sum[TF_COUNT], cci_sum[TF_COUNT], atr_sum[TF_COUNT];
   int di_valid[TF_COUNT], di_aligned[TF_COUNT];
   CPD_StrDist pos_dist[TF_COUNT];
   CPD_StrDist ema_dist[TF_COUNT];
   void Reset()
   {
      count=win=0;
      stop_cnt=step4_cnt=0;
      profit_sum=0;
      ArrayInitialize(hour_hist, 0);
      ArrayInitialize(day_hist, 0);
      ArrayInitialize(mg_hist, 0);
      piv1_sum=piv2_sum=0;
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         tf_valid[tf]=0;
         rsi_sum[tf]=adx_sum[tf]=cci_sum[tf]=atr_sum[tf]=0;
         di_valid[tf]=di_aligned[tf]=0;
         pos_dist[tf].Reset();
         ema_dist[tf].Reset();
      }
   }
   void Add(const CPD_Trade &t)
   {
      count++;
      profit_sum += t.profit;
      if(t.profit > 0) win++;
      if(t.is_stop) stop_cnt++;
      if(t.is_step4p) step4_cnt++;
      if(t.entry_hour>=0 && t.entry_hour<24) hour_hist[t.entry_hour]++;
      if(t.day_index>=0 && t.day_index<7) day_hist[t.day_index]++;
      if(t.mg_step>=1 && t.mg_step<=5) mg_hist[t.mg_step-1]++;
      piv1_sum += t.pivot1_dist;
      piv2_sum += t.pivot2_dist;
      string exp = t.is_buy ? "+" : "-";
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         if(!t.has_tf[tf]) continue;
         tf_valid[tf]++;
         rsi_sum[tf] += t.rsi[tf];
         adx_sum[tf] += t.adx[tf];
         cci_sum[tf] += t.cci[tf];
         atr_sum[tf] += t.atr[tf];
         pos_dist[tf].Add(t.position[tf]);
         ema_dist[tf].Add(t.ema_order[tf]);
         if(t.di[tf] == "+" || t.di[tf] == "-")
         {
            di_valid[tf]++;
            if(t.di[tf] == exp) di_aligned[tf]++;
         }
      }
   }
   double StopPct() const { return (count>0 ? stop_cnt*100.0/count : 0); }
   double Step4Pct() const { return (count>0 ? step4_cnt*100.0/count : 0); }
   double WinRate() const { return (count>0 ? win*100.0/count : 0); }
   double AvgProfit() const { return (count>0 ? profit_sum/count : 0); }
   double AvgPiv1() const { return (count>0 ? piv1_sum/count : 0); }
   double AvgPiv2() const { return (count>0 ? piv2_sum/count : 0); }
   double AvgRSI(int tf) const { return (tf_valid[tf]>0 ? rsi_sum[tf]/tf_valid[tf] : 0); }
   double AvgADX(int tf) const { return (tf_valid[tf]>0 ? adx_sum[tf]/tf_valid[tf] : 0); }
   double AvgCCI(int tf) const { return (tf_valid[tf]>0 ? cci_sum[tf]/tf_valid[tf] : 0); }
   double AvgATR(int tf) const { return (tf_valid[tf]>0 ? atr_sum[tf]/tf_valid[tf] : 0); }
   double DIAlignedPct(int tf) const { return (di_valid[tf]>0 ? di_aligned[tf]*100.0/di_valid[tf] : 0); }
};
enum ENUM_CPD_KIND
{
   CPD_POS_EQ,
   CPD_EMA_EQ,
   CPD_DI_MISMATCH,
   CPD_ADX_LT,
   CPD_RSI_GT,
   CPD_RSI_LT,
   // existing pivots
   CPD_PIV1_GT,
   CPD_PIV2_GT,
   // NEW: pivot gap & OB precision
   CPD_PIV_GAPMIN_LE,   // PivotGapMin <= thr
   CPD_OBDIST_GT,       // OB_DistPct  > thr (far from OB => risk)
   CPD_HOUR_RANGE,
   CPD_DAY_EQ
};
struct CPD_Filter
{
   int tf; // -1 global, else TF
   ENUM_CPD_KIND kind;
   string sval;
   double thr;
   int h1, h2;
   void Reset()
   {
      tf=0; kind=CPD_POS_EQ; sval=""; thr=0; h1=0; h2=0;
   }
   string Name() const
   {
      string tfName = (tf>=0 && tf<TF_COUNT) ? g_tf[tf].name : "GLOBAL";
      switch(kind)
      {
         case CPD_POS_EQ:        return tfName + " Position==" + sval;
         case CPD_EMA_EQ:        return tfName + " EMAOrder==" + sval;
         case CPD_DI_MISMATCH:   return tfName + " DI mismatch";
         case CPD_ADX_LT:        return tfName + " ADX<" + DoubleToString(thr,0);
         case CPD_RSI_GT:        return tfName + " RSI>" + DoubleToString(thr,0);
         case CPD_RSI_LT:        return tfName + " RSI<" + DoubleToString(thr,0);
         case CPD_PIV1_GT:       return "Pivot1Dist>" + DoubleToString(thr,0);
         case CPD_PIV2_GT:       return "PivotSpan>" + DoubleToString(thr,0); // pivot2_dist = span
         case CPD_PIV_GAPMIN_LE: return "PivotGapMin<=" + DoubleToString(thr,0);
         case CPD_OBDIST_GT:     return "OB_DistPct>" + DoubleToString(thr,2) + "%";
         case CPD_HOUR_RANGE:    return "EntryHour[" + IntegerToString(h1) + "-" + IntegerToString(h2) + "]";
         case CPD_DAY_EQ:        return "Day==" + sval;
      }
      return "UNKNOWN";
   }
   bool Match(const CPD_Trade &t) const
   {
      // Global-only conditions (MAIN TF derived metrics)
      if(kind == CPD_PIV1_GT)       return (t.pivot1_dist > 0 && (double)t.pivot1_dist > thr);
      if(kind == CPD_PIV2_GT)       return (t.pivot2_dist > 0 && (double)t.pivot2_dist > thr);
      if(kind == CPD_PIV_GAPMIN_LE) return (t.piv_gap_min > 0 && (double)t.piv_gap_min <= thr);
      if(kind == CPD_OBDIST_GT)     return (t.ob_dist_pct >= 0 && t.ob_dist_pct > thr);
      if(kind == CPD_HOUR_RANGE) return (t.entry_hour >= h1 && t.entry_hour <= h2);
      if(kind == CPD_DAY_EQ)     return (CPD_ToUpperASCII(t.day_name) == CPD_ToUpperASCII(sval));
      // TF conditions
      if(tf < 0 || tf >= TF_COUNT) return false;
      if(!t.has_tf[tf]) return false;
      string exp = t.is_buy ? "+" : "-";
      switch(kind)
      {
         case CPD_POS_EQ: return (t.position[tf] == sval);
         case CPD_EMA_EQ: return (t.ema_order[tf] == sval);
         case CPD_DI_MISMATCH:
            return (t.di[tf] == "+" || t.di[tf] == "-") ? (t.di[tf] != exp) : false;
         case CPD_ADX_LT:
            return (t.adx[tf] > 0 && t.adx[tf] < thr);
         case CPD_RSI_GT:
            return (t.rsi[tf] > thr);
         case CPD_RSI_LT:
            return (t.rsi[tf] > 0 && t.rsi[tf] < thr);
         default: break;
      }
      return false;
   }
};
struct CPD_FilterEval
{
   string name;
   int total, in_cnt, out_cnt;
   // STOP (final)
   int in_stop, out_stop;
   // DEEP (Step4+)
   int in_s4, out_s4;
   // DEEP split:
   int in_s4_nostop, out_s4_nostop;
   int in_s4_stop,   out_s4_stop;
   double in_profit, out_profit;
   double cov;
   double in_stop_pct, out_stop_pct, d_stop;
   double in_s4_pct, out_s4_pct, d_s4;
   double in_s4_nostop_pct, out_s4_nostop_pct, d_s4_nostop;
   double in_s4_stop_pct,   out_s4_stop_pct,   d_s4_stop;
   double in_avgp, out_avgp, dmg_profit;
   // Separate scores
   double score_stop;
   double score_deep; // deep = Step4+ NoStop emphasis
   void Reset()
   {
      name="";
      total=in_cnt=out_cnt=0;
      in_stop=out_stop=0;
      in_s4=out_s4=0;
      in_s4_nostop=out_s4_nostop=0;
      in_s4_stop=out_s4_stop=0;
      in_profit=out_profit=0;
      cov=0;
      in_stop_pct=out_stop_pct=d_stop=0;
      in_s4_pct=out_s4_pct=d_s4=0;
      in_s4_nostop_pct=out_s4_nostop_pct=d_s4_nostop=0;
      in_s4_stop_pct=out_s4_stop_pct=d_s4_stop=0;
      in_avgp=out_avgp=dmg_profit=0;
      score_stop = -999999;
      score_deep = -999999;
   }
};
void CPD_EvalFilter(const CPD_Trade &trades[], int n, bool is_buy, const CPD_Filter &f, CPD_FilterEval &ev)
{
   ev.Reset();
   ev.name = f.Name();
   for(int i=0;i<n;i++)
   {
      if(!trades[i].inited) continue;
      if(trades[i].is_buy != is_buy) continue;
      ev.total++;
      bool inside = f.Match(trades[i]);
      if(inside)
      {
         ev.in_cnt++;
         if(trades[i].is_stop) ev.in_stop++;
         if(trades[i].is_step4p) ev.in_s4++;
         if(trades[i].is_step4p_nostop) ev.in_s4_nostop++;
         if(trades[i].is_step4p_stop)   ev.in_s4_stop++;
         ev.in_profit += trades[i].profit;
      }
      else
      {
         ev.out_cnt++;
         if(trades[i].is_stop) ev.out_stop++;
         if(trades[i].is_step4p) ev.out_s4++;
         if(trades[i].is_step4p_nostop) ev.out_s4_nostop++;
         if(trades[i].is_step4p_stop)   ev.out_s4_stop++;
         ev.out_profit += trades[i].profit;
      }
   }
   if(ev.total <= 0) return;
   // sample guard
   if(ev.in_cnt < 30 || ev.out_cnt < 30)
   {
      ev.score_stop = -999999;
      ev.score_deep = -999999;
      return;
   }
   ev.cov = ev.in_cnt * 100.0 / ev.total;
   // STOP stats
   ev.in_stop_pct  = ev.in_stop  * 100.0 / ev.in_cnt;
   ev.out_stop_pct = ev.out_stop * 100.0 / ev.out_cnt;
   ev.d_stop       = ev.in_stop_pct - ev.out_stop_pct;
   // STEP4+ stats
   ev.in_s4_pct  = ev.in_s4  * 100.0 / ev.in_cnt;
   ev.out_s4_pct = ev.out_s4 * 100.0 / ev.out_cnt;
   ev.d_s4       = ev.in_s4_pct - ev.out_s4_pct;
   // STEP4+ NoStop stats
   ev.in_s4_nostop_pct  = ev.in_s4_nostop  * 100.0 / ev.in_cnt;
   ev.out_s4_nostop_pct = ev.out_s4_nostop * 100.0 / ev.out_cnt;
   ev.d_s4_nostop       = ev.in_s4_nostop_pct - ev.out_s4_nostop_pct;
   // STEP4+ Stop stats
   ev.in_s4_stop_pct  = ev.in_s4_stop  * 100.0 / ev.in_cnt;
   ev.out_s4_stop_pct = ev.out_s4_stop * 100.0 / ev.out_cnt;
   ev.d_s4_stop       = ev.in_s4_stop_pct - ev.out_s4_stop_pct;
   // Profit damage
   ev.in_avgp  = ev.in_profit  / ev.in_cnt;
   ev.out_avgp = ev.out_profit / ev.out_cnt;
   ev.dmg_profit = ev.out_avgp - ev.in_avgp; // positive => inside worse
   // Coverage penalty
   double cov_pen = 1.0;
   if(ev.cov < 3) cov_pen = 0.1;
   else if(ev.cov < 7) cov_pen = 0.4;
   else if(ev.cov < 12) cov_pen = 0.7;
   else if(ev.cov > 75) cov_pen = 0.35;
   // ---- STOP SCORE ----
   double base_stop = (ev.d_stop * 3.0) + (MathMax(0.0, ev.dmg_profit) * 0.6);
   base_stop += MathSqrt((double)ev.in_cnt) * 0.15;
   if(ev.d_stop < 0.5) base_stop *= 0.2;
   ev.score_stop = base_stop * cov_pen;
   // ---- DEEP SCORE (Step4+ NoStop) ----
   double base_deep = (ev.d_s4_nostop * 2.8) + (MathMax(0.0, ev.dmg_profit) * 0.4);
   base_deep += MathSqrt((double)ev.in_cnt) * 0.15;
   if(ev.d_s4_nostop < 0.8) base_deep *= 0.2;
   ev.score_deep = base_deep * cov_pen;
}
void CPD_SortEvals(CPD_FilterEval &arr[], int n)
{
   // Shell Sort
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         CPD_FilterEval temp = arr[i];
         int j = i;
         while(j >= gap && arr[j - gap].score_stop < temp.score_stop)
         {
            arr[j] = arr[j - gap];
            j -= gap;
         }
         arr[j] = temp;
      }
      gap /= 2;
   }
}
void CPD_SortEvalsByStopScore(CPD_FilterEval &arr[], int n)
{
   if(n < 2) return;
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         CPD_FilterEval temp = arr[i];
         int j = i;
         while(j >= gap && arr[j - gap].score_stop < temp.score_stop)
         {
            arr[j] = arr[j - gap];
            j -= gap;
         }
         arr[j] = temp;
      }
      gap /= 2;
   }
}
void CPD_SortEvalsByDeepScore(CPD_FilterEval &arr[], int n)
{
   if(n < 2) return;
   int gap = n / 2;
   while(gap > 0)
   {
      for(int i = gap; i < n; i++)
      {
         CPD_FilterEval temp = arr[i];
         int j = i;
         while(j >= gap && arr[j - gap].score_deep < temp.score_deep)
         {
            arr[j] = arr[j - gap];
            j -= gap;
         }
         arr[j] = temp;
      }
      gap /= 2;
   }
}
string CPD_GapColor(double v)
{
   double a = MathAbs(v);
   if(a >= 10) return "#00ff88";
   if(a >= 5)  return "#ffff00";
   if(a >= 2)  return "#ffa500";
   return "#888";
}
string CPD_T(string en, string fa)
{
   return (inp_use_persian_language ? fa : en);
}
string CPD_TR(string en, string fa)
{
   return (inp_use_persian_language ? fa : en);
}
//==================== PIVOT DIAGNOSTICS (MAIN TF ONLY) ====================
struct CPD_DiagAgg
{
   int n;
   int stop_cnt;        // Final STOP (SL/SL$/STOP)
   int deep_nostop_cnt; // MGStep>=4 AND Final!=STOP
   int deep_stop_cnt;   // MGStep>=4 AND Final=STOP
   double profit_sum;
   void Reset()
   {
      n = stop_cnt = deep_nostop_cnt = deep_stop_cnt = 0;
      profit_sum = 0;
   }
   void Add(const CPD_Trade &t)
   {
      n++;
      if(t.is_stop) stop_cnt++;
      if(t.is_step4p_nostop) deep_nostop_cnt++;
      if(t.is_step4p_stop) deep_stop_cnt++;
      profit_sum += t.profit;
   }
   double StopPct() const { return (n>0 ? stop_cnt*100.0/n : 0); }
   double DeepNoStopPct() const { return (n>0 ? deep_nostop_cnt*100.0/n : 0); }
   double DeepStopPct() const { return (n>0 ? deep_stop_cnt*100.0/n : 0); }
   double AvgProfit() const { return (n>0 ? profit_sum/n : 0); }
};
int CPD_Bin_GapMin(int gap)
{
   if(gap <= 0) return 5;      // NA
   if(gap <= 3) return 0;      // <=3
   if(gap <= 5) return 1;      // 4-5
   if(gap <= 7) return 2;      // 6-7
   if(gap <= 9) return 3;      // 8-9
   return 4;                   // >=10
}
int CPD_Bin_Span(int span)
{
   if(span <= 0) return 5;     // NA
   if(span <= 15) return 0;    // <=15
   if(span <= 25) return 1;    // 16-25
   if(span <= 35) return 2;    // 26-35
   if(span <= 50) return 3;    // 36-50
   return 4;                   // >=51
}
int CPD_Bin_OB(double pct)
{
   if(pct < 0)  return 5;      // NA (no OB found)
   if(pct <= 0.30) return 0;   // <=0.30%
   if(pct <= 0.50) return 1;   // 0.30-0.50%
   if(pct <= 1.00) return 2;   // 0.50-1.00%
   if(pct <= 2.00) return 3;   // 1.00-2.00%
   return 4;                   // >2.00%
}
string CPD_ColorByStop(double stopPct)
{
   if(stopPct >= 3.0) return "#ff4444";
   if(stopPct >= 1.5) return "#ffa500";
   if(stopPct >= 0.8) return "#ffff00";
   return "#00ff88";
}
string CPD_ColorByDeep(double deepPct)
{
   if(deepPct >= 7.0) return "#ff4444";
   if(deepPct >= 5.0) return "#ffa500";
   if(deepPct >= 3.5) return "#ffff00";
   return "#00ff88";
}
void CPD_WriteDiagTable(int h, string title, const string &labels[], CPD_DiagAgg &agg[])
{
   FileWriteString(h, "<h4 style=\"margin:12px 0 8px;color:#00d4ff;\">" + title + "</h4>\r\n");
   FileWriteString(h, "<div style=\"overflow:auto;\"><table>\r\n");
   FileWriteString(h,
      "<tr>"
      "<th>Bin</th><th>Count</th>"
      "<th>Stop%</th><th>DeepNoStop%</th><th>DeepStop%</th>"
      "<th>AvgProfit</th>"
      "</tr>\r\n"
   );
   for(int i=0;i<6;i++)
   {
      string cStop = CPD_ColorByStop(agg[i].StopPct());
      string cDeep = CPD_ColorByDeep(agg[i].DeepNoStopPct());
      string pClr  = (agg[i].AvgProfit() >= 0 ? "#00ff88" : "#ff4444");
      string row = "<tr>";
      row += "<td class=\"mono\">" + labels[i] + "</td>";
      row += "<td>" + IntegerToString(agg[i].n) + "</td>";
      row += "<td style=\"color:" + cStop + ";font-weight:bold;\">" + DoubleToString(agg[i].StopPct(),1) + "%</td>";
      row += "<td style=\"color:" + cDeep + ";font-weight:bold;\">" + DoubleToString(agg[i].DeepNoStopPct(),1) + "%</td>";
      row += "<td style=\"color:#ff9999;\">" + DoubleToString(agg[i].DeepStopPct(),1) + "%</td>";
      row += "<td style=\"color:" + pClr + ";\">$" + DoubleToString(agg[i].AvgProfit(),2) + "</td>";
      row += "</tr>\r\n";
      FileWriteString(h, row);
   }
   FileWriteString(h, "</table></div>\r\n");
}
void CPD_WritePivotDiagnosticsSection(int h, const CPD_Trade &trades[], int n, bool is_buy)
{
   string sideName  = is_buy ? CPD_TR("BUY","خرید") : CPD_TR("SELL","فروش");
   string sideColor = is_buy ? "#00ff88" : "#ff4444";
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<h3 style=\"color:" + sideColor + ";margin:0 0 8px 0;\">" +
                      CPD_TR("Pivot Diagnostics (Main TF / Step1)", "Pivot Diagnostics (تایم اصلی / مرحله ۱)") +
                      " (" + sideName + ")</h3>\r\n");
   FileWriteString(h,
      "<div class=\"hint\">" +
      CPD_TR(
         "These tables show how PivotGapMin / PivotSpan / OB_DistPct relate to STOP and Step4+ outcomes.",
         "این جدول‌ها نشان می‌دهند PivotGapMin / PivotSpan / OB_DistPct چه ارتباطی با استاپ و رفتن به پله۴+ دارند."
      )
      + "<br>" +
      CPD_TR("Current inputs: ", "تنظیمات فعلی: ") +
      "min_pivot_gap_between=" + IntegerToString(inp_min_pivot_gap_between) + " | " +
      "max_pivot_span_p1_p3=" + IntegerToString(inp_max_pivot_span_p1_p3) + " | " +
      "ob_touch_precision_pct=" + DoubleToString(inp_ob_touch_precision_pct,2) + "%"
      + "</div>\r\n"
   );
   // --- GAP MIN ---
   CPD_DiagAgg gapAgg[6];
   for(int i=0;i<6;i++) gapAgg[i].Reset();
   // --- SPAN (pivot2_dist) ---
   CPD_DiagAgg spanAgg[6];
   for(int i=0;i<6;i++) spanAgg[i].Reset();
   // --- OB DIST PCT ---
   CPD_DiagAgg obAgg[6];
   for(int i=0;i<6;i++) obAgg[i].Reset();
   for(int i=0;i<n;i++)
   {
      if(!trades[i].inited) continue;
      if(trades[i].is_buy != is_buy) continue;
      int biGap  = CPD_Bin_GapMin(trades[i].piv_gap_min);
      int biSpan = CPD_Bin_Span(trades[i].pivot2_dist);     // span
      int biOB   = CPD_Bin_OB(trades[i].ob_dist_pct);
      gapAgg[biGap].Add(trades[i]);
      spanAgg[biSpan].Add(trades[i]);
      obAgg[biOB].Add(trades[i]);
   }
   const string gapLabels[6]  = {"<=3","4-5","6-7","8-9",">=10","NA"};
   const string spanLabels[6] = {"<=15","16-25","26-35","36-50",">=51","NA"};
   const string obLabels[6]   = {"<=0.30%","0.30-0.50%","0.50-1.00%","1.00-2.00%"," >2.00%","NA"};
   CPD_WriteDiagTable(h, CPD_TR("PivotGapMin bins", "بازه‌های PivotGapMin"), gapLabels, gapAgg);
   CPD_WriteDiagTable(h, CPD_TR("PivotSpan (p1->p3) bins", "بازه‌های PivotSpan (قدیمی تا جدید)"), spanLabels, spanAgg);
   CPD_WriteDiagTable(h, CPD_TR("OB_DistPct bins (distance from nearest OB)", "بازه‌های OB_DistPct (فاصله تا OB)"), obLabels, obAgg);
   FileWriteString(h, "</div>\r\n");
}
void WriteFlatFullSection(int h, int step, bool is_buy, int tf)
{
   int total = is_buy ? g_ema_buy[tf][step].total_trades
                      : g_ema_sell[tf][step].total_trades;
   string sig     = is_buy ? "BUY" : "SELL";
   string sig_cls = is_buy ? "buy" : "sell";
   string section_title = is_buy ? g_lang.buy_signals : g_lang.sell_signals;
   // برچسب‌های پیوت — همان تعریف Dashboard
   string piv1_label = inp_use_persian_language ? "Dist(P3→Bar)" : "Dist(P3→Bar)";
   string piv2_label = inp_use_persian_language ? "Span(P1→P3)" : "Span(P1→P3)";
   string html = "<div class=\"section\">\r\n";
   html += "<h3 class=\"" + sig_cls + "\">" + section_title +
           " | " + g_tf[tf].name +
           " | " + g_lang.step + " " + IntegerToString(step + 1) +
           " | " + g_lang.trades + ": " + IntegerToString(total) + "</h3>\r\n";
   if(total == 0)
   {
      html += "<p class=\"empty\">" + g_lang.no_data + "</p>\r\n</div>\r\n";
      FileWriteString(h, html);
      return;
   }
   // Table header
   html += "<table>\r\n<tr>\r\n";
   html += "<th>#</th>";
   html += "<th>" + g_lang.rsi + "</th><th>%</th>";
   html += "<th>" + g_lang.adx + "</th><th>%</th>";
   html += "<th>" + g_lang.di  + "</th><th>%</th>";
   html += "<th>" + g_lang.cci + "</th><th>%</th>";
   html += "<th>" + g_lang.atr + "</th><th>%</th>";
   if(tf == 0)
   {
      // توضیح در title attribute
      string piv1_tooltip = inp_use_persian_language ?
         "فاصله جدیدترین پیوت (P3) تا کندل ورود — بر حسب تعداد کندل" :
         "Distance from newest pivot (P3) to entry candle — in bars";
      string piv2_tooltip = inp_use_persian_language ?
         "فاصله قدیمی‌ترین پیوت (P1) تا جدیدترین پیوت (P3) — Span واگرایی سه‌پیوته" :
         "Distance from oldest pivot (P1) to newest pivot (P3) — 3-pivot divergence span in bars";
      html += "<th title=\"" + EscapeHTMLAttr(piv1_tooltip) + "\">" + piv1_label + "</th><th>%</th>";
      html += "<th title=\"" + EscapeHTMLAttr(piv2_tooltip) + "\">" + piv2_label + "</th><th>%</th>";
   }
   html += "<th>" + g_lang.ema_order + "</th><th>%</th>";
   html += "<th>" + g_lang.position  + "</th><th>%</th>";
   html += "<th>" + g_lang.event     + "</th><th>%</th>";
   html += "</tr>\r\n";
   FileWriteString(h, html);
   int max_rows = CalculateMaxRows(step, is_buy, tf);
   max_rows = MathMin(max_rows, 20);
   for(int rank = 0; rank < max_rows; rank++)
   {
      string row = "<tr><td>" + IntegerToString(rank + 1) + "</td>";
      row += WriteFlatCell_RSI(is_buy, tf, step, rank);
      row += WriteFlatCell_ADX(is_buy, tf, step, rank);
      row += WriteFlatCell_DI(is_buy, tf, step, rank);
      row += WriteFlatCell_CCI(is_buy, tf, step, rank);
      row += WriteFlatCell_ATR(is_buy, tf, step, rank);
      if(tf == 0)
      {
         row += WriteFlatCell_Pivot(is_buy, step, rank, true);   // Dist P3→Bar
         row += WriteFlatCell_Pivot(is_buy, step, rank, false);  // Span P1→P3
      }
      row += WriteFlatCell_EMA(is_buy, tf, step, rank);
      row += WriteFlatCell_Position(is_buy, tf, step, rank);
      row += WriteFlatCell_Event(is_buy, tf, step, rank);
      row += "</tr>\r\n";
      FileWriteString(h, row);
   }
   FileWriteString(h, "</table>\r\n</div>\r\n");
}
string WriteFlatCell_RSI(bool is_buy, int tf, int step, int rank)
{
   int total = 0;
   int range_count = 0;
   int rs = 0;
   int cnt = 0;
   if(is_buy)
   {
      total = g_rsi_buy[tf][step].total_trades;
      range_count = g_rsi_buy[tf][step].range_count;
      if(total <= 0 || rank >= range_count)
         return "<td>-</td><td>-</td>";
      rs = g_rsi_buy[tf][step].ranges[rank].range_start;
      cnt = g_rsi_buy[tf][step].ranges[rank].count;
   }
   else
   {
      total = g_rsi_sell[tf][step].total_trades;
      range_count = g_rsi_sell[tf][step].range_count;
      if(total <= 0 || rank >= range_count)
         return "<td>-</td><td>-</td>";
      rs = g_rsi_sell[tf][step].ranges[rank].range_start;
      cnt = g_rsi_sell[tf][step].ranges[rank].count;
   }
   double pct = cnt * 100.0 / total;
   return "<td>[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]</td><td>" + DoubleToString(pct, 1) + "%</td>";
}
