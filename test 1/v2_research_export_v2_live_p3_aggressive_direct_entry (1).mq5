      else
      {
         count_n = g_pivdist_sell[step].p2_count;
         if(rank >= count_n) return "<td>-</td><td>-</td>";
         rs = g_pivdist_sell[step].pivot2[rank].dist;
         cnt = g_pivdist_sell[step].pivot2[rank].count;
      }
   }
   double pct = cnt * 100.0 / total;
   return "<td>[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]</td><td>" + DoubleToString(pct, 1) + "%</td>";
}
