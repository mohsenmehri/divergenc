         cci_slope_5[tf] = adx_slope_5[tf] = 0.0;
         atr_slope_5[tf] = atr_regime[tf] = 0.0;
         ema20_slope_5[tf] = ema50_slope_5[tf] = ema200_slope_5[tf] = 0.0;
         ema_gap_20_50[tf] = ema_gap_50_200[tf] = 0.0;
         ema_compression[tf] = 0.0;
         ema20_dist_atr[tf] = ema50_dist_atr[tf] = 0.0;
         has_macd[tf] = has_stoch[tf] = has_bb[tf] = has_wpr[tf] = false;
      }
      div_p1_price = div_p2_price = div_p3_price = 0.0;
      div_p1_rsi = div_p2_rsi = div_p3_rsi = 0.0;
      div_p1_shift = div_p2_shift = div_p3_shift = -1;
