enum ENUM_PIVOT_CONFIG { PIVOT_IN_OVER_ZONE, PIVOT_OUT_OVER_ZONE, PIVOT_DONT_CARE };
//=========== v9.2 research enums ===========
// Pivot anchor A/B: PRICE_FIRST = current engine (price fractal, RSI aligned
// in tolerance window). BOTH_CONFIRMED = additionally require RSI itself to be
// an independently confirmed local pivot over +/- inp_pivot_right_bars bars.
enum ENUM_PIVOT_ANCHOR_MODE { PIVOT_ANCHOR_PRICE_FIRST, PIVOT_ANCHOR_BOTH_CONFIRMED };
// Step entry trigger: TOUCH = enter the moment price touches the level
// (current). BAR_RECLAIM = enter only after a closed bar wicked through the
// level and closed back on the setup side (confirmation), with ATR failsafe.
enum ENUM_STEP_CONFIRM_MODE { STEP_CONFIRM_TOUCH, STEP_CONFIRM_BAR_RECLAIM };
// Exit engine: LEGACY = fixed TP/BE ladder targets (current).
// TP1_ATR_TRAIL = once TP1 is touched, replace the fixed target with an ATR
// chandelier trailing stop (optionally locked to break-even).
enum ENUM_EXIT_MODE { EXIT_LEGACY, EXIT_TP1_ATR_TRAIL };
enum ENUM_PIVOT_TYPE   { PIVOT_MAJOR, PIVOT_MID_MAJOR, PIVOT_MINOR, PIVOT_SUPER_MINOR, PIVOT_CUSTOM };
enum ENUM_PIVOT_SOURCE { PIVOT_WICK, PIVOT_CLOSE, PIVOT_HL2, PIVOT_HLC3, PIVOT_OHLC4 };
enum ENUM_DIV3_PIVOT_ENGINE { DIV3_LEGACY_FRACTAL=0, DIV3_PRECISION_HYBRID=1 };
enum ENUM_DIV3_RSI_ALIGNMENT { DIV3_RSI_SAME_BAR=0, DIV3_RSI_LOCAL_EXTREME=1 };
// CONFIRMED keeps the stable historical engine. LIVE_P3 uses two confirmed
// pivots plus the forming current-bar P3. DUAL evaluates both streams.
enum ENUM_DIV3_SIGNAL_MODE { DIV3_CONFIRMED_ONLY=0, DIV3_LIVE_P3_ONLY=1, DIV3_DUAL_MODE=2 };
