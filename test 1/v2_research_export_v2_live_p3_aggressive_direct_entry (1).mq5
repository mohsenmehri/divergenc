{
   string fn=S2B_StopD2024_File("CandidateLock")+".txt";int h=FileOpen(fn,FILE_WRITE|FILE_TXT|FILE_COMMON);if(h==INVALID_HANDLE)return;FileWriteString(h,"STOPFLAG D2024 PHASE A CANDIDATE LOCK\nCycleId="+S2B_STOP_D2024_CYCLE_ID+"\nProtocolHash="+g_s2b_stop_d2024_protocol.protocol_hash+"\nDatasetHash="+g_s2b_stop_d2024_protocol.dataset_hash+"\nFeatureMatrixHash="+g_s2b_stop_d2024_protocol.feature_matrix_hash+"\nRowMaskHash="+g_s2b_stop_d2024_protocol.row_mask_hash+"\nFoldHash="+g_s2b_stop_d2024_protocol.fold_hash+"\nContextHash="+g_s2b_stop_d2024_context.evaluation_context_hash+"\nCandidateLocked="+string(g_s2b_stop_d2024_candidate_locked?"YES":"NO")+"\nSelectedByPolicy="+string(g_s2b_stop_d2024_candidate_locked?"YES":"NO")+"\n");if(g_s2b_stop_d2024_candidate_locked){SCompactResult r=g_s2b_stop_d2024_candidates[g_s2b_stop_d2024_selected_index];FileWriteString(h,"AbsoluteGate=PASS\nCandidateHash="+r.feature_hash+"\nCandidateFeatureCount="+IntegerToString(r.n_feat)+"\nFeatures="+r.feat_names+StringFormat("\nMeanAUC=%.6f\nWorstAUC=%.6f\nStdAUC=%.6f\nMeanPRAUC=%.6f\nMeanPRLift=%.6f\nMeanMCC=%.6f\n",r.wf_mean_auc,r.wf_worst_auc,r.wf_std_auc,r.wf_mean_prauc,r.wf_mean_pr_lift,r.wf_mean_mcc));S2B_StopD2024_WriteFoldDiagnostics(h,r);}else FileWriteString(h,"AbsoluteGate=FAIL\nCandidateHash=NONE\nBlockReason="+g_s2b_stop_d2024_block_reason+"\n");FileWriteString(h,"ThresholdEngine=BLOCKED\nHoldout=BLOCKED\nFrozen=BLOCKED\nStage2C=BLOCKED\nStage2D=BLOCKED\n");FileClose(h);Print("STOP_D2024_CANDIDATE_LOCK_REPORT|",fn);
}
