   }
   SSortedView sv;
   if(is_buy) sv.BuildFromEvents(g_ema_buy[tf][step].events, event_count);
   else sv.BuildFromEvents(g_ema_sell[tf][step].events, event_count);
   int idx1 = sv.Get(0);
   int idx2 = sv.Get(1);
   if(idx1 < 0) return result;
   string ev1 = is_buy ? g_ema_buy[tf][step].events[idx1].event : g_ema_sell[tf][step].events[idx1].event;
   int cnt1 = is_buy ? g_ema_buy[tf][step].events[idx1].count : g_ema_sell[tf][step].events[idx1].count;
   string ev2 = "";
   int cnt2 = 0;
   if(idx2 >= 0)
   {
      ev2 = is_buy ? g_ema_buy[tf][step].events[idx2].event : g_ema_sell[tf][step].events[idx2].event;
      cnt2 = is_buy ? g_ema_buy[tf][step].events[idx2].count : g_ema_sell[tf][step].events[idx2].count;
   }
   result.Analyze(cnt1, cnt2, total, ev1, ev2);
   return result;
}
void SortFeatureDiffs()
{
   for(int i = 0; i < g_feature_diff_count - 1; i++)
   {
      for(int j = i + 1; j < g_feature_diff_count; j++)
      {
         if(g_feature_diffs[j].predictive_power > g_feature_diffs[i].predictive_power)
         {
            SFeatureDiff temp = g_feature_diffs[i];
            g_feature_diffs[i] = g_feature_diffs[j];
            g_feature_diffs[j] = temp;
         }
      }
   }
}
//Helper structure for cell data
struct SDashCell
{
   string value;
   string pct_str;
   string cell_class;
   string pct_class;
   bool has_data;
   void Reset() { value = "-"; pct_str = "-"; cell_class = "empty"; pct_class = "empty"; has_data = false; }
   void Set(string v, double pct, string cls)
   {
      value = v;
      pct_str = DoubleToString(pct, 1) + "%";
      cell_class = cls;
      pct_class = GetPctClassStatic(pct);
      has_data = true;
   }
};
string GetPctClassStatic(double pct)
{
   if(pct >= 30) return "pct-high";
   if(pct >= 15) return "pct-mid";
   return "pct-low";
}
string GetEventClassStatic(string evt)
{
   string path = NormalizeEventString(evt);
   if(path == "")
      return "event-warn";
   string last = path;
   int len = StringLen(path);
   for(int i = len - 2; i >= 0; i--)
   {
      if(StringSubstr(path, i, 2) == "->")
      {
         last = StringSubstr(path, i + 2);
         break;
      }
   }
   last = NormalizeEventToken(last);
   string u = ToUpperASCII(last);
   if(StringFind(u, "SL$") >= 0)    return "event-bad";
   if(StringFind(u, "SL") >= 0)     return "event-bad";
   if(StringFind(u, "STOP") >= 0)   return "event-bad";
   if(StringFind(u, "MARGIN") >= 0) return "event-bad";
   if(StringFind(u, "EMA") >= 0)      return "event-good";
   if(StringFind(u, "TP") >= 0)       return "event-good";
   if(StringFind(u, "TARGET") >= 0)   return "event-good";
   if(StringFind(u, "TAKE") >= 0)     return "event-good";
   if(StringFind(u, "PROFIT") >= 0)   return "event-good";
   return "event-warn";
}
void ExportUnifiedDashboard()
{
   string fn = inp_export_file_name + "_" + g_symbol_name + "_Dashboard.html";
   int h = SafeOpenHTML(fn);
   if(h == INVALID_HANDLE) return;
   Print("Generating Dashboard V3...");
   if(!SortAllAnalysisData())
   {
      LogWarning("Some analysis data may be incomplete");
   }
   if(!WriteDashboardHeaderV3(h)) { FileClose(h); return; }
   if(!WriteDashboardBodyV3(h)) { FileClose(h); return; }
   WriteDashboardFooterV3(h);
   FileFlush(h);
   FileClose(h);
   Print("Dashboard V3 saved successfully: ", fn);
}
struct SAnalysisCacheFlags
{
   datetime last_update;
   void Reset()
   {
      last_update = 0;
   }
   bool NeedsUpdate(datetime current_time, int update_interval = 60)
   {
      return (current_time - last_update > update_interval);
   }
};
SAnalysisCacheFlags g_analysis_cache;
bool HasAnyUnsortedAnalysisData()
{
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      for(int s = 0; s < 5; s++)
      {
         if(g_ema_buy[tf][s].total_trades  > 0 && !g_ema_buy[tf][s].is_sorted)  return true;
         if(g_ema_sell[tf][s].total_trades > 0 && !g_ema_sell[tf][s].is_sorted) return true;
         if(g_rsi_buy[tf][s].total_trades  > 0 && !g_rsi_buy[tf][s].is_sorted)  return true;
         if(g_rsi_sell[tf][s].total_trades > 0 && !g_rsi_sell[tf][s].is_sorted) return true;
         if(g_adx_buy[tf][s].total_trades  > 0 && !g_adx_buy[tf][s].is_sorted)  return true;
         if(g_adx_sell[tf][s].total_trades > 0 && !g_adx_sell[tf][s].is_sorted) return true;
         if(g_cci_buy[tf][s].total_trades  > 0 && !g_cci_buy[tf][s].is_sorted)  return true;
         if(g_cci_sell[tf][s].total_trades > 0 && !g_cci_sell[tf][s].is_sorted) return true;
         if(g_atr_buy[tf][s].total_trades  > 0 && !g_atr_buy[tf][s].is_sorted)  return true;
         if(g_atr_sell[tf][s].total_trades > 0 && !g_atr_sell[tf][s].is_sorted) return true;
      }
   }
   for(int s = 0; s < 5; s++)
   {
      if(g_pivdist_buy[s].total_trades  > 0 && !g_pivdist_buy[s].is_sorted)  return true;
      if(g_pivdist_sell[s].total_trades > 0 && !g_pivdist_sell[s].is_sorted) return true;
   }
   return false;
}
bool SortAllAnalysisData()
{
   datetime now = TimeCurrent();
   if(!g_analysis_cache.NeedsUpdate(now, 30))
   {
      if(!HasAnyUnsortedAnalysisData())
         return true;
   }
   int sorted_count = 0;
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      for(int s = 0; s < 5; s++)
      {
         if(g_ema_buy[tf][s].total_trades > 0 && !g_ema_buy[tf][s].is_sorted) { g_ema_buy[tf][s].SortDesc(); sorted_count++; }
         if(g_rsi_buy[tf][s].total_trades > 0 && !g_rsi_buy[tf][s].is_sorted) { g_rsi_buy[tf][s].SortDesc(); sorted_count++; }
         if(g_adx_buy[tf][s].total_trades > 0 && !g_adx_buy[tf][s].is_sorted) { g_adx_buy[tf][s].SortDesc(); sorted_count++; }
         if(g_cci_buy[tf][s].total_trades > 0 && !g_cci_buy[tf][s].is_sorted) { g_cci_buy[tf][s].SortDesc(); sorted_count++; }
         if(g_atr_buy[tf][s].total_trades > 0 && !g_atr_buy[tf][s].is_sorted) { g_atr_buy[tf][s].SortDesc(); sorted_count++; }
         if(g_ema_sell[tf][s].total_trades > 0 && !g_ema_sell[tf][s].is_sorted) { g_ema_sell[tf][s].SortDesc(); sorted_count++; }
         if(g_rsi_sell[tf][s].total_trades > 0 && !g_rsi_sell[tf][s].is_sorted) { g_rsi_sell[tf][s].SortDesc(); sorted_count++; }
         if(g_adx_sell[tf][s].total_trades > 0 && !g_adx_sell[tf][s].is_sorted) { g_adx_sell[tf][s].SortDesc(); sorted_count++; }
         if(g_cci_sell[tf][s].total_trades > 0 && !g_cci_sell[tf][s].is_sorted) { g_cci_sell[tf][s].SortDesc(); sorted_count++; }
         if(g_atr_sell[tf][s].total_trades > 0 && !g_atr_sell[tf][s].is_sorted) { g_atr_sell[tf][s].SortDesc(); sorted_count++; }
      }
   }
   for(int s = 0; s < 5; s++)
   {
      if(g_pivdist_buy[s].total_trades > 0 && !g_pivdist_buy[s].is_sorted)
      {
         g_pivdist_buy[s].SortDesc();
         sorted_count++;
      }
      if(g_pivdist_sell[s].total_trades > 0 && !g_pivdist_sell[s].is_sorted)
      {
         g_pivdist_sell[s].SortDesc();
         sorted_count++;
      }
   }
   g_analysis_cache.last_update = now;
   if(sorted_count > 0 && (!g_testing|| g_visual))
      Print("SortAllAnalysisData: ", sorted_count, " blocks sorted");
   return true;
}
bool WriteDashboardHeaderV3(int h)
{
   string dir = inp_use_persian_language ? "rtl" : "ltr";
   string font = inp_use_persian_language ?
   "'B Nazanin', 'Tahoma', 'Segoe UI', 'Arial', sans-serif" :
   "'Segoe UI', Arial, sans-serif";
   string html = "<!DOCTYPE html><html><head><meta charset=\"UTF-8\">\r\n";
   html += "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n";
   html += "<title>" + g_lang.dashboard_title + " - " + _Symbol + "</title>\r\n";
   html += "<style>\r\n";
   //========== BASE STYLES ==========
   html += "* { box-sizing: border-box; margin: 0; padding: 0; }\r\n";
   html += "body { font-family: " + font + "; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); color: #fff; padding: 20px; min-height: 100vh; direction: " + dir + "; }\r\n";
   html += "h1 { text-align: center; color: #00d4ff; font-size: 28px; margin-bottom: 10px; text-shadow: 0 0 20px rgba(0,212,255,0.5); }\r\n";
   html += "h2 { text-align: center; color: #888; font-size: 14px; margin-bottom: 30px; }\r\n";
   //========== TABS ==========
   html += ".tabs { display: flex; justify-content: center; gap: 5px; margin-bottom: 20px; flex-wrap: wrap; }\r\n";
   html += ".tab { padding: 12px 24px; background: #2a2a4a; border: none; color: #888; cursor: pointer; border-radius: 8px 8px 0 0; font-size: 14px; font-weight: bold; transition: all 0.3s; }\r\n";
   html += ".tab:hover { background: #3a3a5a; color: #fff; }\r\n";
   html += ".tab.active { background: #00d4ff; color: #000; }\r\n";
   html += ".tab-content { display: none; animation: fadeIn 0.3s; }\r\n";
   html += ".tab-content.active { display: block; }\r\n";
   html += "@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\r\n";
   //========== TF SELECTOR ==========
   html += ".tf-selector { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; align-items: center; }\r\n";
   html += ".tf-btn { padding: 8px 16px; background: #2a2a4a; border: 2px solid #444; color: #888; cursor: pointer; border-radius: 20px; font-size: 12px; transition: all 0.3s; }\r\n";
   html += ".tf-btn:hover { border-color: #00d4ff; color: #00d4ff; }\r\n";
   html += ".tf-btn.active { background: #00d4ff; color: #000; border-color: #00d4ff; }\r\n";
   //========== SECTIONS ==========
   html += ".section { background: rgba(0,0,0,0.3); border-radius: 12px; padding: 20px; margin-bottom: 20px; border: 1px solid #333; }\r\n";
   html += ".section-title { font-size: 18px; font-weight: bold; margin-bottom: 15px; padding-bottom: 10px; border-bottom: 2px solid; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }\r\n";
   html += ".buy-section .section-title { color: #00ff88; border-color: #00ff88; }\r\n";
   html += ".sell-section .section-title { color: #ff4444; border-color: #ff4444; }\r\n";
   //========== TABLES - RESPONSIVE FIX ==========
   html += ".table-wrapper { max-height: 600px; overflow: auto; border-radius: 8px; position: relative; -webkit-overflow-scrolling: touch; }\r\n";
   html += "table { width: 100%; border-collapse: collapse; font-size: 11px; table-layout: auto; }\r\n";
   html += "th { background: #2a2a4a; color: #00d4ff; padding: 10px 6px; text-align: center; font-weight: bold; border: 1px solid #444; white-space: nowrap; position: sticky; top: 0; z-index: 10; min-width: 60px; }\r\n";
   html += "td { padding: 8px 6px; text-align: center; border: 1px solid #333; vertical-align: middle; word-wrap: break-word; max-width: 200px; }\r\n";
   html += "tr:nth-child(even) { background: rgba(255,255,255,0.02); }\r\n";
   html += "tr:hover td { background: rgba(0,212,255,0.1); }\r\n";
   //========== SUMMARY TABLE FIX ==========
   html += ".summary-table { font-size: 10px; width: 100%; table-layout: auto; }\r\n";
   html += ".summary-table th { font-size: 9px; padding: 6px 4px; white-space: normal; line-height: 1.2; }\r\n";
   html += ".summary-table td { font-size: 10px; padding: 6px 4px; word-break: break-word; }\r\n";
   html += ".col-step { min-width: 40px; max-width: 50px; }\r\n";
   html += ".col-signal { min-width: 50px; max-width: 60px; }\r\n";
   html += ".col-trades { min-width: 60px; max-width: 80px; }\r\n";
   html += ".col-indicator { min-width: 80px; max-width: 150px; overflow: hidden; text-overflow: ellipsis; }\r\n";
   html += ".col-value { min-width: 100px; max-width: 200px; word-wrap: break-word; white-space: normal; }\r\n";
   //========== TABLE CELLS ==========
   html += ".rank { background: #2a2a4a; color: #00d4ff; font-weight: bold; width: 40px; }\r\n";
   html += ".value { font-weight: bold; font-size: 12px; }\r\n";
   html += ".pct-high { color: #00ff88; font-weight: bold; background: rgba(0,255,136,0.15); }\r\n";
   html += ".pct-mid { color: #ffeb9c; background: rgba(255,235,156,0.1); }\r\n";
   html += ".pct-low { color: #ff9999; }\r\n";
   html += ".di-plus { color: #00ff88; font-weight: bold; font-size: 16px; }\r\n";
   html += ".di-minus { color: #ff4444; font-weight: bold; font-size: 16px; }\r\n";
   html += ".rsi-cell { background: rgba(100,149,237,0.2); }\r\n";
   html += ".adx-cell { background: rgba(255,165,0,0.15); }\r\n";
   html += ".cci-cell { background: rgba(138,43,226,0.15); }\r\n";
   html += ".atr-cell { background: rgba(255,215,0,0.15); font-family: 'Courier New', monospace; }\r\n";
   html += ".pivot-cell { background: rgba(0,255,255,0.1); }\r\n";
   //========== EMA CELL WITH HOVER FIX ==========
   html += ".ema-cell { background: rgba(144,238,144,0.1); font-family: 'Courier New', monospace; font-size: 8px; max-width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: help; position: relative; }\r\n";
   html += ".ema-cell:hover { white-space: normal; overflow: visible; background: rgba(144,238,144,0.3); z-index: 999; box-shadow: 0 0 10px rgba(0,255,0,0.5); }\r\n";
   html += ".event-good { background: rgba(0,255,136,0.2); color: #00ff88; }\r\n";
   html += ".event-bad { background: rgba(255,68,68,0.2); color: #ff4444; }\r\n";
   html += ".event-warn { background: rgba(255,165,0,0.2); color: #ffa500; }\r\n";
   html += ".empty { color: #444; background: rgba(50,50,50,0.3); }\r\n";
   //========== FILTER BOX ==========
   html += ".filter-box { background: linear-gradient(135deg, #1e3a5f 0%, #2a4a6f 100%); border-radius: 8px; padding: 15px; margin-top: 15px; border-left: 4px solid #00d4ff; }\r\n";
   html += ".filter-title { color: #00d4ff; font-weight: bold; margin-bottom: 8px; }\r\n";
   html += ".filter-buy { color: #00ff88; font-family: 'Courier New', monospace; font-size: 11px; margin: 5px 0; padding: 8px; background: rgba(0,255,136,0.1); border-radius: 4px; word-break: break-word; line-height: 1.6; }\r\n";
   html += ".filter-sell { color: #ff4444; font-family: 'Courier New', monospace; font-size: 11px; margin: 5px 0; padding: 8px; background: rgba(255,68,68,0.1); border-radius: 4px; word-break: break-word; line-height: 1.6; }\r\n";
   //========== SUMMARY GRID ==========
   html += ".summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }\r\n";
   html += ".summary-card { background: rgba(0,0,0,0.4); border-radius: 10px; padding: 15px; border: 1px solid #444; }\r\n";
   html += ".summary-card h4 { color: #00d4ff; margin-bottom: 10px; font-size: 14px; border-bottom: 1px solid #333; padding-bottom: 8px; }\r\n";
   html += ".stat-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid #333; gap: 10px; }\r\n";
   html += ".stat-row:last-child { border-bottom: none; }\r\n";
   html += ".stat-label { color: #888; flex-shrink: 0; }\r\n";
   html += ".stat-value { color: #fff; font-weight: bold; text-align: right; word-break: break-all; }\r\n";
   html += ".no-data { text-align: center; color: #666; padding: 40px; font-style: italic; background: rgba(0,0,0,0.2); border-radius: 8px; }\r\n";
   html += ".tf-badge { background: #00d4ff; color: #000; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; }\r\n";
   html += ".total-badge { background: #2a2a4a; color: #888; padding: 2px 8px; border-radius: 4px; font-size: 11px; }\r\n";
   //========== STEP COLORS ==========
   html += ".step-1 { background: rgba(0,255,136,0.3); color: #00ff88; font-weight: bold; }\r\n";
   html += ".step-2 { background: rgba(255,255,0,0.3); color: #ffff00; font-weight: bold; }\r\n";
   html += ".step-3 { background: rgba(255,153,0,0.3); color: #ff9900; font-weight: bold; }\r\n";
   html += ".step-4 { background: rgba(255,102,0,0.3); color: #ff6600; font-weight: bold; }\r\n";
   html += ".step-5 { background: rgba(255,0,0,0.3); color: #ff0000; font-weight: bold; }\r\n";
   //========== PAGINATION ==========
   html += ".pagination { display: flex; justify-content: center; align-items: center; gap: 5px; margin-top: 15px; flex-wrap: wrap; }\r\n";
   html += ".page-btn { padding: 8px 12px; background: #2a2a4a; border: 1px solid #444; color: #888; cursor: pointer; border-radius: 6px; font-size: 12px; transition: all 0.2s; }\r\n";
   html += ".page-btn:hover { background: #3a3a5a; color: #fff; border-color: #00d4ff; }\r\n";
   html += ".page-btn.active { background: #00d4ff; color: #000; border-color: #00d4ff; font-weight: bold; }\r\n";
   html += ".page-btn:disabled { opacity: 0.5; cursor: not-allowed; }\r\n";
   html += ".page-info { color: #888; font-size: 12px; margin: 10px 0; text-align: center; }\r\n";
   //========== SIGNIFICANCE STYLES ==========
   html += ".sig-insufficient { color: #ff4444; font-weight: bold; }\r\n";
   html += ".sig-weak { color: #ffa500; }\r\n";
   html += ".sig-moderate { color: #ffff00; }\r\n";
   html += ".sig-good { color: #90EE90; }\r\n";
   html += ".sig-strong { color: #00ff88; font-weight: bold; }\r\n";
   //========== DOMINANCE & MTF STYLES ==========
   html += ".dominant-reliable { background: rgba(0,255,136,0.25); color: #00ff88; font-weight: bold; padding: 2px 6px; border-radius: 4px; }\r\n";
   html += ".dominant-weak { background: rgba(0,255,136,0.1); color: #00ff88; border: 1px dashed #00ff88; padding: 2px 6px; border-radius: 4px; }\r\n";
   html += ".polarized { background: rgba(255,215,0,0.2); color: #ffd700; padding: 2px 6px; border-radius: 4px; }\r\n";
   html += ".mixed { background: rgba(128,128,128,0.2); color: #888; font-style: italic; padding: 2px 6px; border-radius: 4px; }\r\n";
   html += ".low-sample { background: rgba(255,165,0,0.2); color: #ffa500; padding: 2px 6px; border-radius: 4px; }\r\n";
   html += ".mtf-strong-agree { background: rgba(0,255,136,0.2); color: #00ff88; padding: 5px; border-radius: 6px; border-left: 3px solid #00ff88; }\r\n";
   html += ".mtf-partial-agree { background: rgba(255,255,0,0.15); color: #ffff00; padding: 5px; border-radius: 6px; border-left: 3px solid #ffff00; }\r\n";
   html += ".mtf-neutral { background: rgba(128,128,128,0.15); color: #aaa; padding: 5px; border-radius: 6px; border-left: 3px solid #888; }\r\n";
   html += ".mtf-partial-conflict { background: rgba(255,165,0,0.2); color: #ffa500; padding: 5px; border-radius: 6px; border-left: 3px solid #ffa500; }\r\n";
   html += ".mtf-strong-conflict { background: rgba(255,0,0,0.2); color: #ff4444; padding: 5px; border-radius: 6px; border-left: 3px solid #ff4444; font-weight: bold; }\r\n";
   html += ".mtf-no-data { color: #666; font-style: italic; }\r\n";
   html += ".sample-badge { font-size: 10px; padding: 2px 4px; border-radius: 3px; margin-left: 5px; }\r\n";
   html += ".sample-good { background: #00ff88; color: #000; }\r\n";
   html += ".sample-moderate { background: #ffff00; color: #000; }\r\n";
   html += ".sample-low { background: #ffa500; color: #000; }\r\n";
   html += ".sample-insufficient { background: #ff4444; color: #fff; }\r\n";
   //========== TOOLTIP & HELP ICON STYLES - v8.1 ==========
   html += "[title] { position: relative; cursor: help; }\r\n";
   html += ".has-tooltip { border-bottom: 1px dotted #00d4ff; transition: all 0.2s; }\r\n";
   html += ".has-tooltip:hover { color: #00d4ff; border-bottom-style: solid; }\r\n";
   html += ".help-icon { display: inline-block; width: 16px; height: 16px; background: linear-gradient(135deg, #00d4ff 0%, #0099cc 100%); color: #000; border-radius: 50%; font-size: 11px; font-weight: bold; text-align: center; line-height: 16px; margin-left: 6px; cursor: help; transition: all 0.3s; box-shadow: 0 2px 4px rgba(0,212,255,0.3); }\r\n";
   html += ".help-icon:hover { background: linear-gradient(135deg, #fff 0%, #00d4ff 100%); transform: scale(1.15) rotate(15deg); box-shadow: 0 4px 8px rgba(0,212,255,0.6); }\r\n";
   html += "th .help-icon { background: rgba(0,212,255,0.3); border: 1px solid #00d4ff; }\r\n";
   html += "th .help-icon:hover { background: #00d4ff; border-color: #fff; }\r\n";
   html += "h4 .help-icon { width: 18px; height: 18px; line-height: 18px; font-size: 12px; }\r\n";
   //========== ZOOM CONTROL BUTTON STYLES ==========
   html += ".zoom-control { text-align: center; margin-bottom: 15px; }\r\n";
   html += ".zoom-btn { padding: 6px 12px; margin: 0 3px; background: #2a2a4a; color: #888; border: 1px solid #444; border-radius: 4px; cursor: pointer; font-size: 11px; transition: all 0.2s; }\r\n";
   html += ".zoom-btn:hover { background: #3a3a5a; color: #fff; border-color: #00d4ff; }\r\n";
   html += ".zoom-btn.active { background: #00d4ff; color: #000; border-color: #00d4ff; font-weight: bold; }\r\n";
   //========== RESPONSIVE ZOOM FIX ==========
   html += "@media (min-width: 1920px) { table { font-size: 12px; } th { padding: 12px 8px; } td { padding: 10px 8px; } }\r\n";
   html += "@media (max-width: 1600px) { table { font-size: 10px; } th { padding: 8px 4px; } td { padding: 6px 4px; } .ema-cell { font-size: 7px; max-width: 100px; } }\r\n";
   html += "@media (max-width: 1366px) { table { font-size: 9px; } th { padding: 6px 3px; font-size: 8px; } td { padding: 5px 3px; } .ema-cell { font-size: 7px; max-width: 80px; } }\r\n";
   html += "@media (max-width: 768px) { body { padding: 10px; } .tabs { gap: 3px; } .tab { padding: 8px 12px; font-size: 12px; } .summary-grid { grid-template-columns: 1fr; } h1 { font-size: 20px; } .section { padding: 10px; } .filter-box { padding: 10px; } table { font-size: 8px; } th { padding: 5px 2px; font-size: 7px; } td { padding: 4px 2px; } .ema-cell { max-width: 60px; font-size: 6px; } .page-btn { padding: 6px 10px; font-size: 11px; } .help-icon { width: 14px; height: 14px; line-height: 14px; font-size: 10px; } }\r\n";
   html += "</style>\r\n";
   //========== JAVASCRIPT ==========
   html += "<script>\r\n";
   html += "var currentPage = {};\r\n";
   html += "var ROWS_PER_PAGE = 16;\r\n";
   html += "\r\n";
   html += "function showTab(tabId, evt) { document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); }); document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); }); var tabEl = document.getElementById(tabId); if(tabEl) tabEl.classList.add('active'); if(evt && evt.target) evt.target.classList.add('active'); }\r\n";
   html += "function showTF(tf, evt) { document.querySelectorAll('.tf-section').forEach(function(s) { s.style.display = 'none'; }); document.querySelectorAll('.tf-btn').forEach(function(b) { b.classList.remove('active'); }); document.querySelectorAll('.tf-' + tf).forEach(function(s) { s.style.display = 'block'; }); if(evt && evt.target) evt.target.classList.add('active'); }\r\n";
   html += "function showPage(tableId, page) { var table = document.getElementById(tableId); if(!table) return; var rows = table.querySelectorAll('tbody tr'); var totalRows = rows.length; var totalPages = Math.ceil(totalRows / ROWS_PER_PAGE); if(totalPages < 1) totalPages = 1; page = Math.max(1, Math.min(page, totalPages)); currentPage[tableId] = page; var start = (page - 1) * ROWS_PER_PAGE; var end = start + ROWS_PER_PAGE; rows.forEach(function(row, idx) { row.style.display = (idx >= start && idx < end) ? '' : 'none'; }); updatePagination(tableId, page, totalPages, totalRows); }\r\n";
   html += "function updatePagination(tableId, currentPg, totalPages, totalRows) { var container = document.getElementById('pag-' + tableId); if(!container) return; var html = ''; if(totalPages > 1) { html += '<button class=\"page-btn\" onclick=\"showPage(\\'' + tableId + '\\', 1)\" ' + (currentPg==1?'disabled':'') + '>«</button>'; html += '<button class=\"page-btn\" onclick=\"showPage(\\'' + tableId + '\\', ' + (currentPg-1) + ')\" ' + (currentPg==1?'disabled':'') + '>‹</button>'; var startPg = Math.max(1, currentPg - 2); var endPg = Math.min(totalPages, startPg + 4); if(endPg - startPg < 4) startPg = Math.max(1, endPg - 4); for(var i = startPg; i <= endPg; i++) { html += '<button class=\"page-btn' + (i==currentPg?' active':'') + '\" onclick=\"showPage(\\'' + tableId + '\\', ' + i + ')\">' + i + '</button>'; } html += '<button class=\"page-btn\" onclick=\"showPage(\\'' + tableId + '\\', ' + (currentPg+1) + ')\" ' + (currentPg==totalPages?'disabled':'') + '>›</button>'; html += '<button class=\"page-btn\" onclick=\"showPage(\\'' + tableId + '\\', ' + totalPages + ')\" ' + (currentPg==totalPages?'disabled':'') + '>»</button>'; } container.innerHTML = html; var infoEl = document.getElementById('info-' + tableId); if(infoEl) { var from = (currentPg - 1) * ROWS_PER_PAGE + 1; var to = Math.min(currentPg * ROWS_PER_PAGE, totalRows); infoEl.innerHTML = '" + g_lang.showing + " ' + from + '-' + to + ' " + g_lang.of + " ' + totalRows + ' (" + g_lang.page + " ' + currentPg + '/' + totalPages + ')'; } }\r\n";
   html += "function setZoom(level, btn) { document.body.style.zoom = level; document.querySelectorAll('.zoom-btn').forEach(function(b) { b.classList.remove('active'); }); if(btn) btn.classList.add('active'); }\r\n";
   html += "document.addEventListener('DOMContentLoaded', function() { document.querySelectorAll('.paginated-table').forEach(function(table) { var rows = table.querySelectorAll('tbody tr').length; if(rows > ROWS_PER_PAGE) { showPage(table.id, 1); } }); });\r\n";
   html += "</script>\r\n";
   html += "</head><body>\r\n";
   html += "<h1>" + g_lang.dashboard_title + "</h1>\r\n";
   html += "<h2>" + _Symbol + "| " + g_lang.generated + ": " + TimeToString(TimeCurrent(), TIME_DATE|TIME_MINUTES);
   html += "| " + g_lang.opened + ": " + IntegerToString(g_stats[0]) + "| " + g_lang.closed + ": " + IntegerToString(g_stats[1]) + "</h2>\r\n";
   //========== ZOOM CONTROL BUTTONS ==========
   html += "<div class=\"zoom-control\">\r\n";
   html += "<button class=\"zoom-btn\" onclick=\"setZoom('0.8', this)\">80%</button>\r\n";
   html += "<button class=\"zoom-btn\" onclick=\"setZoom('0.9', this)\">90%</button>\r\n";
   html += "<button class=\"zoom-btn active\" onclick=\"setZoom('1.0', this)\">100%</button>\r\n";
   html += "<button class=\"zoom-btn\" onclick=\"setZoom('1.1', this)\">110%</button>\r\n";
   html += "<button class=\"zoom-btn\" onclick=\"setZoom('1.25', this)\">125%</button>\r\n";
   html += "</div>\r\n";
   return FileWriteString(h, html) > 0;
}
//|WriteDashboardSectionV3 - COMPLETE WITH RESPONSIVE FIX v8.1|
void WriteDashboardSectionV3(int h, int step, bool is_buy, int tf)
{
   string sig = is_buy ? g_lang.buy_word : g_lang.sell_word;
   string cls = is_buy ? "buy-section" : "sell-section";
   string table_id = (is_buy ? "buy" : "sell") + "_s" + IntegerToString(step) + "_tf" + IntegerToString(tf);
   int total_trades = 0;
   if(is_buy)
      total_trades = g_ema_buy[tf][step].total_trades;
   else
      total_trades = g_ema_sell[tf][step].total_trades;
   int max_rows = CalculateMaxRows(step, is_buy, tf);
   string section_title = is_buy ? g_lang.buy_signals : g_lang.sell_signals;
   // توضیح پیوت‌ها
   string piv1_label = inp_use_persian_language ? "فاصله‌پیوت(P3→کندل)" : "Dist(P3→Bar)";
   string piv2_label = inp_use_persian_language ? "Span(P1→P3)"         : "Span(P1→P3)";
   string html = "<div class=\"section " + cls + "\">\r\n";
   html += "<div class=\"section-title\">";
   html += section_title;
   html += " <span class=\"tf-badge\">" + g_tf[tf].name + "</span>";
   html += " <span class=\"total-badge\">" + g_lang.trades + ": " + IntegerToString(total_trades);
   html += " | " + g_lang.rows + ": " + IntegerToString(max_rows) + "</span>";
   html += "</div>\r\n";
   if(total_trades == 0 || max_rows == 0)
   {
      html += "<div class=\"no-data\">" + g_lang.no_data + " - " + g_lang.step + " " +
              IntegerToString(step + 1) + " " + sig + " - " + g_tf[tf].name + "</div>\r\n";
      html += "</div>\r\n";
      FileWriteString(h, html);
      return;
   }
   // Responsive wrapper
   html += "<div class=\"table-wrapper\" style=\"overflow-x:auto;-webkit-overflow-scrolling:touch;\">\r\n";
   html += "<table id=\"" + table_id + "\" class=\"paginated-table\" style=\"min-width:1000px;\">\r\n";
   html += "<thead><tr>\r\n";
   // Headers
   html += "<th>" + g_lang.rank + "</th>";
   html += BuildTableHeader(g_lang.rsi, "RSI");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.adx, "ADX");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.di, "DI");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.cci, "CCI");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.atr, "ATR");
   html += "<th>%</th>";
   // پیوت‌ها فقط روی Main TF
   if(tf == 0)
   {
      // Piv1 = فاصله جدیدترین پیوت تا کندل جاری
      string piv1_tooltip = inp_use_persian_language ?
         "فاصله جدیدترین پیوت (P3) تا کندل ورود — بر حسب تعداد کندل" :
         "Distance from newest pivot (P3) to entry candle — in bars";
      // Piv2 = Span از قدیمی‌ترین تا جدیدترین پیوت
      string piv2_tooltip = inp_use_persian_language ?
         "فاصله قدیمی‌ترین پیوت (P1) تا جدیدترین پیوت (P3) — Span واگرایی سه‌پیوته" :
         "Distance from oldest pivot (P1) to newest pivot (P3) — 3-pivot divergence span in bars";
      string safe_tt1 = EscapeHTMLAttr(piv1_tooltip);
      string safe_tt2 = EscapeHTMLAttr(piv2_tooltip);
      html += "<th class=\"has-tooltip\" title=\"" + safe_tt1 + "\">" +
              piv1_label + BuildHelpIcon(piv1_tooltip) + "</th><th>%</th>";
      html += "<th class=\"has-tooltip\" title=\"" + safe_tt2 + "\">" +
              piv2_label + BuildHelpIcon(piv2_tooltip) + "</th><th>%</th>";
   }
   html += BuildTableHeader(g_lang.ema_order, "EMA");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.position, "");
   html += "<th>%</th>";
   html += BuildTableHeader(g_lang.event, "");
   html += "<th>%</th>";
   html += "</tr></thead>\r\n<tbody>\r\n";
   FileWriteString(h, html);
   for(int rank = 0; rank < max_rows; rank++)
   {
      WriteDashboardRowV3(h, step, is_buy, rank, tf);
   }
   html = "</tbody></table>\r\n</div>\r\n";
   html += "<div id=\"pag-" + table_id + "\" class=\"pagination\"></div>\r\n";
   html += "<div id=\"info-" + table_id + "\" class=\"page-info\"></div>\r\n";
   html += "</div>\r\n";
   FileWriteString(h, html);
}
string OS_ContextName(ENUM_OS_CONTEXT c)
{
   if(inp_use_persian_language)
   {
      if(c==OS_ALL)  return "ALL (خرید+فروش)";
      if(c==OS_BUY)  return "BUY (خرید)";
      return "SELL (فروش)";
   }
   else
   {
      if(c==OS_ALL) return "ALL";
      if(c==OS_BUY) return "BUY";
      return "SELL";
   }
}
bool OS_ContextMatch(SEntrySnapshot &sn, ENUM_OS_CONTEXT c)
{
   if(c == OS_ALL)  return true;
   if(c == OS_BUY)  return sn.is_bullish;
   return !sn.is_bullish;
}
string OS_GetFinalToken(string evt)
{
   evt = NormalizeEventString(evt);
   if(evt == "") return "";
   int last_arrow = -1;
   int len = StringLen(evt);
   for(int i = len - 2; i >= 0; i--)
   {
      if(StringSubstr(evt, i, 2) == "->")
      {
         last_arrow = i;
         break;
      }
   }
   string last = (last_arrow >= 0) ? StringSubstr(evt, last_arrow + 2) : evt;
   return NormalizeEventToken(last);
}
bool OS_IsStopToken(string tok)
{
   tok = NormalizeEventToken(tok);
   return (tok == "SL" || tok == "SL$" || tok == "STOP");
}
bool OS_IsTargetToken(string tok)
{
   tok = NormalizeEventToken(tok);
   if(tok == "EMA") return true;
   if(tok == "TP")  return true;
   if(StringFind(tok, "TP") == 0) return true;
   return false;
}
int OS_GetTPIndex(string tok)
{
   tok = NormalizeEventToken(tok);
   if(tok == "EMA") return 0;
   // اگر generic TP بود (مثلاً TAKE_PROFIT)، حداقل به عنوان TP1 بشمار
   if(tok == "TP")  return 1;
   if(tok == "TP1") return 1;
   if(tok == "TP2") return 2;
   if(tok == "TP3") return 3;
   if(tok == "TP4") return 4;
   if(tok == "TP5") return 5;
   return -1;
}
string OS_Num(double v, int d=1) { return DoubleToString(v, d); }
struct SOutcomeBucket
{
   string title;
   SGroupStats st;
   int    exit_cnt[6]; //0=EMA, 1..5=TP1..TP5
   int    n;
   // Pivot averages
   double sum_pivot1;
   double sum_pivot2;
   // Dominant strings
   string ema_keys[TF_COUNT][OS_STR_SLOTS];
   int    ema_counts[TF_COUNT][OS_STR_SLOTS];
   string pos_keys[TF_COUNT][OS_STR_SLOTS];
   int    pos_counts[TF_COUNT][OS_STR_SLOTS];
   string dom_ema[TF_COUNT];
   double dom_ema_pct[TF_COUNT];
   string dom_pos[TF_COUNT];
   double dom_pos_pct[TF_COUNT];
   void Reset(string t)
   {
      title = t;
      st.Reset();
      ArrayInitialize(exit_cnt, 0);
      n = 0;
      sum_pivot1 = 0;
      sum_pivot2 = 0;
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         for(int i=0;i<OS_STR_SLOTS;i++)
         {
            ema_keys[tf][i]   = "";
            ema_counts[tf][i] = 0;
            pos_keys[tf][i]   = "";
            pos_counts[tf][i] = 0;
         }
         ema_keys[tf][OS_STR_SLOTS-1] = "OTHER";
         pos_keys[tf][OS_STR_SLOTS-1] = "OTHER";
         dom_ema[tf] = "N/A";
         dom_pos[tf] = "N/A";
         dom_ema_pct[tf] = 0;
         dom_pos_pct[tf] = 0;
      }
   }
   double GetAvgPivot1() { return (n>0) ? sum_pivot1/n : 0; }
   double GetAvgPivot2() { return (n>0) ? sum_pivot2/n : 0; }
   void AddEMAKey(int tf, string key)
   {
      if(key=="" || key=="N/A") key = "N/A";
      for(int i=0;i<OS_STR_SLOTS-1;i++)
      {
         if(ema_keys[tf][i] == key)
         {
            ema_counts[tf][i]++;
            return;
         }
      }
      for(int i=0;i<OS_STR_SLOTS-1;i++)
      {
         if(ema_keys[tf][i] == "")
         {
            ema_keys[tf][i] = key;
            ema_counts[tf][i] = 1;
            return;
         }
      }
      ema_counts[tf][OS_STR_SLOTS-1]++; // OTHER
   }
   void AddPosKey(int tf, string key)
   {
      if(key=="" || key=="N/A") key = "N/A";
      for(int i=0;i<OS_STR_SLOTS-1;i++)
      {
         if(pos_keys[tf][i] == key)
         {
            pos_counts[tf][i]++;
            return;
         }
      }
      for(int i=0;i<OS_STR_SLOTS-1;i++)
      {
         if(pos_keys[tf][i] == "")
         {
            pos_keys[tf][i] = key;
            pos_counts[tf][i] = 1;
            return;
         }
      }
      pos_counts[tf][OS_STR_SLOTS-1]++; // OTHER
   }
   void FinalizeDominant(int tf)
   {
      // EMA
      int totalE = 0, bestE = 0, bestEc = -1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         totalE += ema_counts[tf][i];
         if(ema_counts[tf][i] > bestEc)
         {
            bestEc = ema_counts[tf][i];
            bestE = i;
         }
      }
      if(totalE > 0)
      {
         dom_ema[tf] = (ema_keys[tf][bestE] != "" ? ema_keys[tf][bestE] : "N/A");
         dom_ema_pct[tf] = bestEc * 100.0 / totalE;
      }
      // Position
      int totalP = 0, bestP = 0, bestPc = -1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         totalP += pos_counts[tf][i];
         if(pos_counts[tf][i] > bestPc)
         {
            bestPc = pos_counts[tf][i];
            bestP = i;
         }
      }
      if(totalP > 0)
      {
         dom_pos[tf] = (pos_keys[tf][bestP] != "" ? pos_keys[tf][bestP] : "N/A");
         dom_pos_pct[tf] = bestPc * 100.0 / totalP;
      }
   }
   void Add(SEntrySnapshot &sn)
   {
      n++;
      st.AddTrade(sn);
      string ft = OS_GetFinalToken(sn.close_event);
      int tp = OS_GetTPIndex(ft);
      if(tp >= 0 && tp <= 5) exit_cnt[tp]++;
      sum_pivot1 += sn.pivot1_dist;
      sum_pivot2 += sn.pivot2_dist;
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         AddEMAKey(tf, sn.ema_order[tf]);
         AddPosKey(tf, sn.position[tf]);
      }
   }
   void Finalize()
   {
      st.Finalize();
      for(int tf=0; tf<TF_COUNT; tf++)
         FinalizeDominant(tf);
   }
};
void OS_InitBuckets(SOutcomeBucket &b[])
{
   ArrayResize(b, OS_BUCKETS);
   b[0].Reset(inp_use_persian_language ? "Target Hit | MaxStep=1" : "Target Hit | MaxStep=1");
   b[1].Reset(inp_use_persian_language ? "Target Hit | MaxStep=2" : "Target Hit | MaxStep=2");
   b[2].Reset(inp_use_persian_language ? "Target Hit | MaxStep=3" : "Target Hit | MaxStep=3");
   b[3].Reset(inp_use_persian_language ? "Target Hit | MaxStep=4" : "Target Hit | MaxStep=4");
   b[4].Reset(inp_use_persian_language ? "Target Hit | MaxStep=5" : "Target Hit | MaxStep=5");
   b[5].Reset(inp_use_persian_language ? "STOP (SL/STOP)" : "STOP (SL/STOP)");
}
int OS_BucketIndexForSnapshot(SEntrySnapshot &sn)
{
   if(sn.actual_max_step < 1 || sn.actual_max_step > 5) return -1;
   string ft = OS_GetFinalToken(sn.close_event);
   if(OS_IsStopToken(ft)) return 5;
   if(OS_IsTargetToken(ft)) return (sn.actual_max_step - 1);
   return -1;
}
void OS_BuildBucketsFromSnapshots(ENUM_OS_CONTEXT ctx, SOutcomeBucket &out_buckets[], int &ignored)
{
   ignored = 0;
   OS_InitBuckets(out_buckets);
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!OS_ContextMatch(g_snapshots[i], ctx))
         continue;
      int bi = OS_BucketIndexForSnapshot(g_snapshots[i]);
      if(bi < 0) { ignored++; continue; }
      out_buckets[bi].Add(g_snapshots[i]);
   }
   for(int k = 0; k < OS_BUCKETS; k++)
      out_buckets[k].Finalize();
}
void OS_WriteExitDistribution(int h, SOutcomeBucket &b)
{
   int total = b.n;
   if(total <= 0) return;
   string html = "<div style=\"margin-top:8px;color:#aaa;font-size:11px;\">";
   html += (inp_use_persian_language ? "خروجی نهایی: " : "Final Exit: ");
   string parts = "";
   const string names[6] = {"EMA","TP1","TP2","TP3","TP4","TP5"};
   for(int i=0;i<6;i++)
   {
      if(b.exit_cnt[i] <= 0) continue;
      double pct = b.exit_cnt[i] * 100.0 / total;
      if(parts != "") parts += " | ";
      parts += names[i] + "=" + IntegerToString(b.exit_cnt[i]) + " (" + DoubleToString(pct,1) + "%)";
   }
   if(parts=="") parts = "-";
   html += parts + "</div>\r\n";
   FileWriteString(h, html);
}
void OS_WriteFullIndicatorTable(int h, SOutcomeBucket &b)
{
   if(b.n <= 0) return;
   string html = "<div style=\"overflow:auto;margin-top:10px;\">\r\n";
   html += "<table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>TF</th><th>Pivot1Avg</th><th>Pivot2Avg</th><th>RSI</th><th>ADX</th><th>CCI</th><th>ATR</th>";
   html += "<th>DI+%</th><th>DI_Gap</th><th>EMAOrder (Top)</th><th>Position (Top)</th><th>EMA200Dist</th>";
   html += "</tr>\r\n";
   for(int tf=0; tf<TF_COUNT; tf++)
   {
      double di_plus = b.st.GetDIPlusPct(tf);
      string ema_top = b.dom_ema[tf] + " (" + DoubleToString(b.dom_ema_pct[tf],1) + "%)";
      string pos_top = b.dom_pos[tf] + " (" + DoubleToString(b.dom_pos_pct[tf],1) + "%)";
      html += "<tr>";
      html += "<td style=\"background:rgba(0,0,0,0.25);color:#00d4ff;font-weight:bold;\">" + g_tf[tf].name + "</td>";
      html += "<td>" + OS_Num(b.GetAvgPivot1(), 1) + "</td>";
      html += "<td>" + OS_Num(b.GetAvgPivot2(), 1) + "</td>";
      html += "<td>" + OS_Num(b.st.avg_rsi[tf], 1) + "</td>";
      html += "<td>" + OS_Num(b.st.avg_adx[tf], 1) + "</td>";
      html += "<td>" + OS_Num(b.st.avg_cci[tf], 0) + "</td>";
      html += "<td>" + OS_Num(b.st.avg_atr[tf], _Digits) + "</td>";
      html += "<td>" + OS_Num(di_plus, 1) + "%</td>";
      html += "<td>" + OS_Num(b.st.avg_di_gap[tf], 1) + "</td>";
      html += "<td style=\"font-size:9px;\">" + ema_top + "</td>";
      html += "<td style=\"font-size:9px;\">" + pos_top + "</td>";
      html += "<td>" + OS_Num(b.st.avg_ema200_dist[tf], 1) + "</td>";
      html += "</tr>\r\n";
   }
   html += "</table></div>\r\n";
   FileWriteString(h, html);
}
struct SOSReportGroup
{
   string name;
   int n;
   int target_cnt;
   int stop_cnt;
   SGroupStats st;
   // pivots numeric
   double sum_piv1;
   double sum_piv2;
   // pivot distributions
   int piv1_bins[OS_PIV_BINS];
   int piv2_bins[OS_PIV_BINS];
   // DI match per TF (direction-aware)
   int di_match_cnt[TF_COUNT];
   int di_valid_cnt[TF_COUNT];
   // +DI / -DI counts (for sign distribution)
   int di_plus_cnt[TF_COUNT];
   int di_minus_cnt[TF_COUNT];
   // --- distributions per TF ---
   int rsi_valid_cnt[TF_COUNT];
   int adx_valid_cnt[TF_COUNT];
   int cci_valid_cnt[TF_COUNT];
   int atr_valid_cnt[TF_COUNT];
   int rsi_bins[TF_COUNT][OS_RSI_BINS];
   int adx_bins[TF_COUNT][OS_ADX_BINS];
   int cci_bins[TF_COUNT][OS_CCI_BINS];
   int atr_bins[TF_COUNT][OS_ATR_BINS];
   double atr_min[TF_COUNT];
   double atr_max[TF_COUNT];
   // Dominant strings per TF
   string ema_keys[TF_COUNT][OS_STR_SLOTS];
   int    ema_cnt[TF_COUNT][OS_STR_SLOTS];
   string pos_keys[TF_COUNT][OS_STR_SLOTS];
   int    pos_cnt[TF_COUNT][OS_STR_SLOTS];
   string dom_ema[TF_COUNT];
   double dom_ema_pct[TF_COUNT];
   string dom_pos[TF_COUNT];
   double dom_pos_pct[TF_COUNT];
   // ---------------- basics ----------------
   void Reset(string nm)
   {
      name = nm;
      n = 0;
      target_cnt = 0;
      stop_cnt = 0;
      st.Reset();
      sum_piv1 = 0;
      sum_piv2 = 0;
      ArrayInitialize(piv1_bins, 0);
      ArrayInitialize(piv2_bins, 0);
      ArrayInitialize(di_match_cnt, 0);
      ArrayInitialize(di_valid_cnt, 0);
      ArrayInitialize(di_plus_cnt, 0);
      ArrayInitialize(di_minus_cnt, 0);
      ArrayInitialize(rsi_valid_cnt, 0);
      ArrayInitialize(adx_valid_cnt, 0);
      ArrayInitialize(cci_valid_cnt, 0);
      ArrayInitialize(atr_valid_cnt, 0);
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         for(int i=0;i<OS_RSI_BINS;i++) rsi_bins[tf][i]=0;
         for(int i=0;i<OS_ADX_BINS;i++) adx_bins[tf][i]=0;
         for(int i=0;i<OS_CCI_BINS;i++) cci_bins[tf][i]=0;
         for(int i=0;i<OS_ATR_BINS;i++) atr_bins[tf][i]=0;
         atr_min[tf] = 0;
         atr_max[tf] = 0;
         for(int i=0;i<OS_STR_SLOTS;i++)
         {
            ema_keys[tf][i] = ""; ema_cnt[tf][i] = 0;
            pos_keys[tf][i] = ""; pos_cnt[tf][i] = 0;
         }
         ema_keys[tf][OS_STR_SLOTS-1] = "OTHER";
         pos_keys[tf][OS_STR_SLOTS-1] = "OTHER";
         dom_ema[tf] = "N/A"; dom_ema_pct[tf] = 0;
         dom_pos[tf] = "N/A"; dom_pos_pct[tf] = 0;
      }
   }
   double AvgPiv1() { return (n>0 ? sum_piv1/n : 0); }
   double AvgPiv2() { return (n>0 ? sum_piv2/n : 0); }
   double TargetPct(){ return (n>0 ? target_cnt*100.0/n : 0); }
   double StopPct(){ return (n>0 ? stop_cnt*100.0/n : 0); }
   double DIMatchPct(int tf){ return (di_valid_cnt[tf]>0 ? di_match_cnt[tf]*100.0/di_valid_cnt[tf] : 0); }
   double DIPlusPctRaw(int tf)
   {
      int tot = di_plus_cnt[tf] + di_minus_cnt[tf];
      return (tot>0 ? di_plus_cnt[tf]*100.0/tot : 0);
   }
   // ---------------- dominant strings ----------------
   void AddEMAKey(int tf, string key)
   {
      if(key=="" || key=="N/A") key = "N/A";
      for(int i=0;i<OS_STR_SLOTS-1;i++)
         if(ema_keys[tf][i] == key) { ema_cnt[tf][i]++; return; }
      for(int i=0;i<OS_STR_SLOTS-1;i++)
         if(ema_keys[tf][i] == "")  { ema_keys[tf][i]=key; ema_cnt[tf][i]=1; return; }
      ema_cnt[tf][OS_STR_SLOTS-1]++;
   }
   void AddPosKey(int tf, string key)
   {
      if(key=="" || key=="N/A") key = "N/A";
      for(int i=0;i<OS_STR_SLOTS-1;i++)
         if(pos_keys[tf][i] == key) { pos_cnt[tf][i]++; return; }
      for(int i=0;i<OS_STR_SLOTS-1;i++)
         if(pos_keys[tf][i] == "")  { pos_keys[tf][i]=key; pos_cnt[tf][i]=1; return; }
      pos_cnt[tf][OS_STR_SLOTS-1]++;
   }
   void FinalizeDominantForTF(int tf)
   {
      int totalE=0, bestE=-1, bestEc=-1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         totalE += ema_cnt[tf][i];
         if(ema_cnt[tf][i] > bestEc) { bestEc=ema_cnt[tf][i]; bestE=i; }
      }
      if(totalE>0 && bestE>=0)
      {
         dom_ema[tf] = (ema_keys[tf][bestE]!="" ? ema_keys[tf][bestE] : "N/A");
         dom_ema_pct[tf] = bestEc*100.0/totalE;
      }
      int totalP=0, bestP=-1, bestPc=-1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         totalP += pos_cnt[tf][i];
         if(pos_cnt[tf][i] > bestPc) { bestPc=pos_cnt[tf][i]; bestP=i; }
      }
      if(totalP>0 && bestP>=0)
      {
         dom_pos[tf] = (pos_keys[tf][bestP]!="" ? pos_keys[tf][bestP] : "N/A");
         dom_pos_pct[tf] = bestPc*100.0/totalP;
      }
   }
   int TotalEMA(int tf)
   {
      int tot = 0;
      for(int i=0;i<OS_STR_SLOTS;i++) tot += ema_cnt[tf][i];
      return tot;
   }
   int TotalPOS(int tf)
   {
      int tot = 0;
      for(int i=0;i<OS_STR_SLOTS;i++) tot += pos_cnt[tf][i];
      return tot;
   }
   string TopEMAOrdersToString(int tf, int topN=2)
   {
      int total = TotalEMA(tf);
      if(total <= 0) return "-";
      int best1=-1, best2=-1, c1=-1, c2=-1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         int c = ema_cnt[tf][i];
         if(c <= 0) continue;
         if(c > c1) { c2=c1; best2=best1; c1=c; best1=i; }
         else if(c > c2) { c2=c; best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0 ? best1 : best2);
         int cc = (k==0 ? c1 : c2);
         if(bi < 0 || cc <= 0) continue;
         string key = ema_keys[tf][bi];
         if(key == "") key = "N/A";
         double pct = cc * 100.0 / total;
         if(out != "") out += " | ";
         out += key + " " + DoubleToString(pct,1) + "%";
      }
      return out;
   }
   string TopPositionsToString(int tf, int topN=2)
   {
      int total = TotalPOS(tf);
      if(total <= 0) return "-";
      int best1=-1, best2=-1, c1=-1, c2=-1;
      for(int i=0;i<OS_STR_SLOTS;i++)
      {
         int c = pos_cnt[tf][i];
         if(c <= 0) continue;
         if(c > c1) { c2=c1; best2=best1; c1=c; best1=i; }
         else if(c > c2) { c2=c; best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0 ? best1 : best2);
         int cc = (k==0 ? c1 : c2);
         if(bi < 0 || cc <= 0) continue;
         string key = pos_keys[tf][bi];
         if(key == "") key = "N/A";
         double pct = cc * 100.0 / total;
         if(out != "") out += " | ";
         out += key + " " + DoubleToString(pct,1) + "%";
      }
      return out;
   }
   // ---------------- bins helpers ----------------
   int ClampI(int v,int lo,int hi){ return (v<lo?lo:(v>hi?hi:v)); }
   void AddPivotBins(int piv1, int piv2)
   {
      int i1 = ClampI(piv1/OS_PIV_BIN, 0, OS_PIV_BINS-1);
      int i2 = ClampI(piv2/OS_PIV_BIN, 0, OS_PIV_BINS-1);
      piv1_bins[i1]++;
      piv2_bins[i2]++;
   }
   void AddRSI(int tf, double r)
   {
      if(r<=0 || r>100) return;
      int bi = ClampI((int)MathFloor(r/OS_RSI_BIN), 0, OS_RSI_BINS-1);
      rsi_bins[tf][bi]++; rsi_valid_cnt[tf]++;
   }
   void AddADX(int tf, double a)
   {
      if(a<=0 || a>100) return;
      int bi = ClampI((int)MathFloor(a/OS_ADX_BIN), 0, OS_ADX_BINS-1);
      adx_bins[tf][bi]++; adx_valid_cnt[tf]++;
   }
   void AddCCI(int tf, double c)
   {
      // clamp to avoid extreme bins
      int cs = (int)MathFloor(c/OS_CCI_BIN)*OS_CCI_BIN;
      if(cs < OS_CCI_MIN) cs = OS_CCI_MIN;
      if(cs > OS_CCI_MAX) cs = OS_CCI_MAX;
      int bi = ClampI((cs - OS_CCI_MIN)/OS_CCI_BIN, 0, OS_CCI_BINS-1);
      cci_bins[tf][bi]++; cci_valid_cnt[tf]++;
   }
   void AddATR(int tf, double atr)
   {
      if(atr <= 0) return;
      double pts = atr / _Point;
      int bi = ClampI((int)MathFloor(pts / OS_ATR_BIN_POINTS), 0, OS_ATR_BINS-1);
      atr_bins[tf][bi]++; atr_valid_cnt[tf]++;
      if(atr_min[tf]==0 || atr < atr_min[tf]) atr_min[tf] = atr;
      if(atr_max[tf]==0 || atr > atr_max[tf]) atr_max[tf] = atr;
   }
   // top range string builders
   string TopBinsToString_RSI(int tf, int topN=2)
   {
      int total = rsi_valid_cnt[tf];
      if(total<=0) return "-";
      int best1=-1,best2=-1,c1=-1,c2=-1;
      for(int i=0;i<OS_RSI_BINS;i++)
      {
         int c = rsi_bins[tf][i];
         if(c>c1){ c2=c1;best2=best1; c1=c;best1=i; }
         else if(c>c2){ c2=c;best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0?best1:best2);
         int cc = (k==0?c1:c2);
         if(bi<0 || cc<=0) continue;
         int rs = bi*OS_RSI_BIN;
         int re = rs+OS_RSI_BIN;
         double pct = cc*100.0/total;
         if(out!="") out += " | ";
         out += "["+IntegerToString(rs)+"-"+IntegerToString(re)+"] "+DoubleToString(pct,1)+"%";
      }
      return out;
   }
   string TopBinsToString_ADX(int tf, int topN=2)
   {
      int total = adx_valid_cnt[tf];
      if(total<=0) return "-";
      int best1=-1,best2=-1,c1=-1,c2=-1;
      for(int i=0;i<OS_ADX_BINS;i++)
      {
         int c = adx_bins[tf][i];
         if(c>c1){ c2=c1;best2=best1; c1=c;best1=i; }
         else if(c>c2){ c2=c;best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0?best1:best2);
         int cc = (k==0?c1:c2);
         if(bi<0 || cc<=0) continue;
         int rs = bi*OS_ADX_BIN;
         int re = rs+OS_ADX_BIN;
         double pct = cc*100.0/total;
         if(out!="") out += " | ";
         out += "["+IntegerToString(rs)+"-"+IntegerToString(re)+"] "+DoubleToString(pct,1)+"%";
      }
      return out;
   }
   string TopBinsToString_CCI(int tf, int topN=2)
   {
      int total = cci_valid_cnt[tf];
      if(total<=0) return "-";
      int best1=-1,best2=-1,c1=-1,c2=-1;
      for(int i=0;i<OS_CCI_BINS;i++)
      {
         int c = cci_bins[tf][i];
         if(c>c1){ c2=c1;best2=best1; c1=c;best1=i; }
         else if(c>c2){ c2=c;best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0?best1:best2);
         int cc = (k==0?c1:c2);
         if(bi<0 || cc<=0) continue;
         int rs = OS_CCI_MIN + bi*OS_CCI_BIN;
         int re = rs+OS_CCI_BIN;
         double pct = cc*100.0/total;
         if(out!="") out += " | ";
         out += "["+IntegerToString(rs)+".."+IntegerToString(re)+"] "+DoubleToString(pct,1)+"%";
      }
      return out;
   }
   string TopBinsToString_ATR(int tf, int topN=2)
   {
      int total = atr_valid_cnt[tf];
      if(total<=0) return "-";
      int best1=-1,best2=-1,c1=-1,c2=-1;
      for(int i=0;i<OS_ATR_BINS;i++)
      {
         int c = atr_bins[tf][i];
         if(c>c1){ c2=c1;best2=best1; c1=c;best1=i; }
         else if(c>c2){ c2=c;best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0?best1:best2);
         int cc = (k==0?c1:c2);
         if(bi<0 || cc<=0) continue;
         double loPts = bi*OS_ATR_BIN_POINTS;
         double hiPts = loPts+OS_ATR_BIN_POINTS;
         double pct = cc*100.0/total;
         if(out!="") out += " | ";
         out += "["+DoubleToString(loPts,0)+"-"+DoubleToString(hiPts,0)+"pt] "+DoubleToString(pct,1)+"%";
      }
      return out;
   }
   string TopBinsToString_Pivot(bool piv1, int topN=2)
   {
      int total = n;
      if(total<=0) return "-";
      int best1=-1,best2=-1,c1=-1,c2=-1;
      for(int i=0;i<OS_PIV_BINS;i++)
      {
         int c = piv1 ? piv1_bins[i] : piv2_bins[i];
         if(c>c1){ c2=c1;best2=best1; c1=c;best1=i; }
         else if(c>c2){ c2=c;best2=i; }
      }
      string out = "";
      for(int k=0;k<topN;k++)
      {
         int bi = (k==0?best1:best2);
         int cc = (k==0?c1:c2);
         if(bi<0 || cc<=0) continue;
         int rs = bi*OS_PIV_BIN;
         int re = rs+OS_PIV_BIN;
         double pct = cc*100.0/total;
         if(out!="") out += " | ";
         out += "["+IntegerToString(rs)+"-"+IntegerToString(re)+"] "+DoubleToString(pct,1)+"%";
      }
      return out;
   }
   // ---------------- add & finalize ----------------
   void Add(SEntrySnapshot &sn)
   {
      n++;
      st.AddTrade(sn);
      sum_piv1 += sn.pivot1_dist;
      sum_piv2 += sn.pivot2_dist;
      AddPivotBins(sn.pivot1_dist, sn.pivot2_dist);
      string ft = OS_GetFinalToken(sn.close_event);
      if(OS_IsStopToken(ft)) stop_cnt++;
      else if(OS_IsTargetToken(ft)) target_cnt++;
      for(int tf=0; tf<TF_COUNT; tf++)
      {
         // numeric bins
         AddRSI(tf, sn.rsi[tf]);
         AddADX(tf, sn.adx[tf]);
         AddCCI(tf, sn.cci[tf]);
         AddATR(tf, sn.atr[tf]);
         // DI stats
         string d = sn.di[tf];
         if(d=="+" || d=="-")
         {
            if(d=="+") di_plus_cnt[tf]++; else di_minus_cnt[tf]++;
            di_valid_cnt[tf]++;
            string exp = sn.is_bullish ? "+" : "-";
            if(d == exp) di_match_cnt[tf]++;
         }
         // strings
         AddEMAKey(tf, sn.ema_order[tf]);
         AddPosKey(tf, sn.position[tf]);
      }
   }
   void Finalize()
   {
      st.Finalize();
      for(int tf=0; tf<TF_COUNT; tf++)
         FinalizeDominantForTF(tf);
   }
};
//==================== DIAGNOSTIC HELPERS (ADD ONCE) ====================
struct SPathRiskExtra
{
   int n;
   double sum_atr_regime[TF_COUNT];
   double sum_adx_slope[TF_COUNT];
   double sum_ema_comp[TF_COUNT];
   double sum_signal_clv;
   double sum_signal_body;
   double sum_ob_age;
   double sum_ob_width;
   int    ob_age_cnt;
   void Reset()
   {
      n = 0;
      ArrayInitialize(sum_atr_regime, 0.0);
      ArrayInitialize(sum_adx_slope, 0.0);
      ArrayInitialize(sum_ema_comp, 0.0);
      sum_signal_clv = 0.0;
      sum_signal_body = 0.0;
      sum_ob_age = 0.0;
      sum_ob_width = 0.0;
      ob_age_cnt = 0;
   }
   void Add(SEntrySnapshot &sn)
   {
      n++;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         sum_atr_regime[tf] += sn.atr_regime[tf];
         sum_adx_slope[tf] += sn.adx_slope[tf];
         sum_ema_comp[tf] += sn.ema_compression[tf];
      }
      sum_signal_clv += sn.signal_clv;
      sum_signal_body += sn.signal_body_ratio;
      sum_ob_width += sn.ob_width_atr;
      if(sn.ob_age_bars >= 0)
      {
         sum_ob_age += sn.ob_age_bars;
         ob_age_cnt++;
      }
   }
   double AvgATRRegime(int tf) { return (n > 0 ? sum_atr_regime[tf] / n : 0.0); }
   double AvgADXSlope(int tf)  { return (n > 0 ? sum_adx_slope[tf] / n : 0.0); }
   double AvgEMAComp(int tf)   { return (n > 0 ? sum_ema_comp[tf] / n : 0.0); }
   double AvgCLV()       { return (n > 0 ? sum_signal_clv / n : 0.0); }
   double AvgBody()      { return (n > 0 ? sum_signal_body / n : 0.0); }
   double AvgOBAge()     { return (ob_age_cnt > 0 ? sum_ob_age / ob_age_cnt : 0.0); }
   double AvgOBWidth()   { return (n > 0 ? sum_ob_width / n : 0.0); }
};
bool PR_PathMatch(SEntrySnapshot &sn, ENUM_PATH_CLASS want)
{
   return (sn.path_class == want);
}
void PR_BuildGroup(ENUM_OS_CONTEXT ctx, ENUM_PATH_CLASS pc, SOSReportGroup &g, SPathRiskExtra &x, string name)
{
   g.Reset(name);
   x.Reset();
   for(int i = 0; i < g_snapshot_count; i++)
   {
      if(!OS_ContextMatch(g_snapshots[i], ctx)) continue;
      if(!PR_PathMatch(g_snapshots[i], pc)) continue;
      g.Add(g_snapshots[i]);
      x.Add(g_snapshots[i]);
   }
   g.Finalize();
}
void WritePathRiskExtraTable(int h, string title,
                             SPathRiskExtra &A, SPathRiskExtra &B)
{
   string html = "<h4 style=\"color:#00d4ff;margin-top:10px;\">" + title + " — New Features</h4>\r\n";
   if(A.n < 10 || B.n < 10)
   {
      html += "<div style=\"color:#666;\">" + g_lang.insufficient_samples_groups + "</div>\r\n";
      FileWriteString(h, html);
      return;
   }
   html += "<div style=\"overflow:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>TF</th>";
   html += "<th>ATR_Regime (A)</th><th>ATR_Regime (B)</th><th>Diff</th>";
   html += "<th>ADX_Slope (A)</th><th>ADX_Slope (B)</th><th>Diff</th>";
   html += "<th>EMA_Comp (A)</th><th>EMA_Comp (B)</th><th>Diff</th>";
   html += "</tr>\r\n";
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      double d1 = A.AvgATRRegime(tf) - B.AvgATRRegime(tf);
      double d2 = A.AvgADXSlope(tf)  - B.AvgADXSlope(tf);
      double d3 = A.AvgEMAComp(tf)   - B.AvgEMAComp(tf);
      html += "<tr>";
      html += "<td style=\"color:#00d4ff;font-weight:bold;\">" + g_tf[tf].name + "</td>";
      html += "<td>" + DoubleToString(A.AvgATRRegime(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(B.AvgATRRegime(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(d1, 3) + "</td>";
      html += "<td>" + DoubleToString(A.AvgADXSlope(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(B.AvgADXSlope(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(d2, 3) + "</td>";
      html += "<td>" + DoubleToString(A.AvgEMAComp(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(B.AvgEMAComp(tf), 3) + "</td>";
      html += "<td>" + DoubleToString(d3, 3) + "</td>";
      html += "</tr>\r\n";
   }
   html += "</table></div>\r\n";
   html += "<div style=\"overflow:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:10px;margin-top:8px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>Signal_CLV (A)</th><th>Signal_CLV (B)</th><th>Diff</th>";
   html += "<th>Signal_BodyRatio (A)</th><th>Signal_BodyRatio (B)</th><th>Diff</th>";
   html += "<th>OB_Age (A)</th><th>OB_Age (B)</th><th>Diff</th>";
   html += "<th>OB_Width_ATR (A)</th><th>OB_Width_ATR (B)</th><th>Diff</th>";
   html += "</tr>\r\n";
   html += "<tr>";
   html += "<td>" + DoubleToString(A.AvgCLV(), 3) + "</td>";
   html += "<td>" + DoubleToString(B.AvgCLV(), 3) + "</td>";
   html += "<td>" + DoubleToString(A.AvgCLV() - B.AvgCLV(), 3) + "</td>";
   html += "<td>" + DoubleToString(A.AvgBody(), 3) + "</td>";
   html += "<td>" + DoubleToString(B.AvgBody(), 3) + "</td>";
   html += "<td>" + DoubleToString(A.AvgBody() - B.AvgBody(), 3) + "</td>";
   html += "<td>" + DoubleToString(A.AvgOBAge(), 1) + "</td>";
   html += "<td>" + DoubleToString(B.AvgOBAge(), 1) + "</td>";
   html += "<td>" + DoubleToString(A.AvgOBAge() - B.AvgOBAge(), 1) + "</td>";
   html += "<td>" + DoubleToString(A.AvgOBWidth(), 3) + "</td>";
   html += "<td>" + DoubleToString(B.AvgOBWidth(), 3) + "</td>";
   html += "<td>" + DoubleToString(A.AvgOBWidth() - B.AvgOBWidth(), 3) + "</td>";
   html += "</tr>\r\n";
   html += "</table></div>\r\n";
   FileWriteString(h, html);
}
void DX_WriteSuggestedFiltersEx(int h, string title,
                                SOSReportGroup &Good, SOSReportGroup &Bad,
                                SPathRiskExtra &GoodEx, SPathRiskExtra &BadEx,
                                bool directional, bool is_buy_ctx)
{
   if(Good.n < 10 || Bad.n < 10)
      return;
   string expDI = is_buy_ctx ? "+" : "-";
   double thr_stab   = (Good.st.avg_stability + Bad.st.avg_stability) / 2.0;
   double thr_piv2   = (Good.AvgPiv2() + Bad.AvgPiv2()) / 2.0;
   double thr_h1_adx = (Good.st.avg_adx[TF_IDX_H1] + Bad.st.avg_adx[TF_IDX_H1]) / 2.0;
   double thr_h4_adx = (Good.st.avg_adx[TF_IDX_H4] + Bad.st.avg_adx[TF_IDX_H4]) / 2.0;
   double thr_m1_atr_reg = (GoodEx.AvgATRRegime(TF_IDX_MAIN) + BadEx.AvgATRRegime(TF_IDX_MAIN)) / 2.0;
   double thr_h1_atr_reg = (GoodEx.AvgATRRegime(TF_IDX_H1) + BadEx.AvgATRRegime(TF_IDX_H1)) / 2.0;
   double thr_m5_adx_slope = (GoodEx.AvgADXSlope(TF_IDX_M5) + BadEx.AvgADXSlope(TF_IDX_M5)) / 2.0;
   double thr_h1_adx_slope = (GoodEx.AvgADXSlope(TF_IDX_H1) + BadEx.AvgADXSlope(TF_IDX_H1)) / 2.0;
   double thr_m1_ema_comp  = (GoodEx.AvgEMAComp(TF_IDX_MAIN) + BadEx.AvgEMAComp(TF_IDX_MAIN)) / 2.0;
   double thr_m5_ema_comp  = (GoodEx.AvgEMAComp(TF_IDX_M5) + BadEx.AvgEMAComp(TF_IDX_M5)) / 2.0;
   double thr_clv      = (GoodEx.AvgCLV() + BadEx.AvgCLV()) / 2.0;
   double thr_body     = (GoodEx.AvgBody() + BadEx.AvgBody()) / 2.0;
   double thr_ob_age   = (GoodEx.AvgOBAge() + BadEx.AvgOBAge()) / 2.0;
   double thr_ob_width = (GoodEx.AvgOBWidth() + BadEx.AvgOBWidth()) / 2.0;
   string html = "<div style=\"margin-top:10px;padding:12px;background:rgba(0,212,255,0.08);border:1px solid #00d4ff;border-radius:10px;\">";
   html += "<div style=\"color:#00d4ff;font-weight:bold;margin-bottom:6px;\">" + title + "</div>";
   html += "<div style=\"color:#aaa;font-size:11px;line-height:1.9;\">";
   html += "Classic risk filters:<br>";
   html += "• IF Stability &lt; <b>" + DoubleToString(thr_stab, 0) + "</b> ⇒ SKIP<br>";
   html += "• IF Pivot2Dist &gt; <b>" + DoubleToString(thr_piv2, 0) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX(H1) &lt; <b>" + DoubleToString(thr_h1_adx, 1) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX(H4) &lt; <b>" + DoubleToString(thr_h4_adx, 1) + "</b> ⇒ SKIP<br>";
   if(directional)
   {
      html += "• IF DI(H1) != <b>" + expDI + "</b> ⇒ SKIP<br>";
      html += "• IF DI(H4) != <b>" + expDI + "</b> ⇒ SKIP<br>";
   }
   html += "<br>New feature filters:<br>";
   html += "• IF ATR_Regime(M1) " + string(GoodEx.AvgATRRegime(TF_IDX_MAIN) > BadEx.AvgATRRegime(TF_IDX_MAIN) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_m1_atr_reg, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF ATR_Regime(H1) " + string(GoodEx.AvgATRRegime(TF_IDX_H1) > BadEx.AvgATRRegime(TF_IDX_H1) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_h1_atr_reg, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX_Slope(M5) " + string(GoodEx.AvgADXSlope(TF_IDX_M5) > BadEx.AvgADXSlope(TF_IDX_M5) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_m5_adx_slope, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX_Slope(H1) " + string(GoodEx.AvgADXSlope(TF_IDX_H1) > BadEx.AvgADXSlope(TF_IDX_H1) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_h1_adx_slope, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF EMA_Compression(M1) " + string(GoodEx.AvgEMAComp(TF_IDX_MAIN) > BadEx.AvgEMAComp(TF_IDX_MAIN) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_m1_ema_comp, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF EMA_Compression(M5) " + string(GoodEx.AvgEMAComp(TF_IDX_M5) > BadEx.AvgEMAComp(TF_IDX_M5) ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_m5_ema_comp, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF Signal_CLV " + string(GoodEx.AvgCLV() > BadEx.AvgCLV() ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_clv, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF Signal_BodyRatio " + string(GoodEx.AvgBody() > BadEx.AvgBody() ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_body, 3) + "</b> ⇒ SKIP<br>";
   html += "• IF OB_AgeBars " + string(GoodEx.AvgOBAge() > BadEx.AvgOBAge() ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_ob_age, 1) + "</b> ⇒ SKIP<br>";
   html += "• IF OB_Width_ATR " + string(GoodEx.AvgOBWidth() > BadEx.AvgOBWidth() ? "&lt;" : "&gt;") +
           " <b>" + DoubleToString(thr_ob_width, 3) + "</b> ⇒ SKIP<br>";
   html += "</div></div>\r\n";
   FileWriteString(h, html);
}
void WritePathRiskClassificationSection(int h)
{
   if(g_snapshot_count < 50)
   {
      FileWriteString(h,
         "<div class=\"section\"><div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">🧭 Path Risk Classification</div>"
         "<div class=\"no-data\">Need at least 50 snapshots. Current: " + IntegerToString(g_snapshot_count) + "</div></div>\r\n");
      return;
   }
   FileWriteString(h, "<div class=\"section\">\r\n");
   FileWriteString(h, "<div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">🧭 Path Risk Classification</div>\r\n");
   FileWriteString(h, "<div style=\"color:#aaa;font-size:11px;line-height:1.8;\">");
   FileWriteString(h, "This section is focused on your real objective: what entry conditions push trades into Step4/5 and especially Deep Stop.");
   FileWriteString(h, "</div>\r\n");
   ENUM_OS_CONTEXT ctxs[3] = {OS_ALL, OS_BUY, OS_SELL};
   for(int k = 0; k < 3; k++)
   {
      ENUM_OS_CONTEXT ctx = ctxs[k];
      string ctxName = OS_ContextName(ctx);
      SOSReportGroup safeT, midT, deepT, deepS;
      SPathRiskExtra safeX, midX, deepTX, deepSX;
      PR_BuildGroup(ctx, PATH_SAFE_TARGET, safeT, safeX, "SAFE_TARGET");
      PR_BuildGroup(ctx, PATH_MID_TARGET,  midT,  midX,  "MID_TARGET");
      PR_BuildGroup(ctx, PATH_DEEP_TARGET, deepT, deepTX, "DEEP_TARGET");
      PR_BuildGroup(ctx, PATH_DEEP_STOP,   deepS, deepSX, "DEEP_STOP");
      string html = "<h3 style=\"color:#00d4ff;margin-top:18px;\">" + ctxName + "</h3>\r\n";
      FileWriteString(h, html);
      // A) SAFE_TARGET vs DEEP_STOP
      FileWriteString(h, "<h4>A) SAFE_TARGET vs DEEP_STOP</h4>\r\n");
      OS_WriteTwoGroupReport(h, "SAFE_TARGET vs DEEP_STOP", safeT, deepS);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: SAFE_TARGET vs DEEP_STOP", safeT, deepS);
      WritePathRiskExtraTable(h, "SAFE_TARGET vs DEEP_STOP", safeX, deepSX);
      DX_WriteSuggestedFiltersEx(h, "Hard Skip Candidates", safeT, deepS, safeX, deepSX,
                                 (ctx != OS_ALL), (ctx == OS_BUY));
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:14px 0;\">\r\n");
      // B) MID_TARGET vs DEEP_STOP
      FileWriteString(h, "<h4>B) MID_TARGET vs DEEP_STOP</h4>\r\n");
      OS_WriteTwoGroupReport(h, "MID_TARGET vs DEEP_STOP", midT, deepS);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: MID_TARGET vs DEEP_STOP", midT, deepS);
      WritePathRiskExtraTable(h, "MID_TARGET vs DEEP_STOP", midX, deepSX);
      DX_WriteSuggestedFiltersEx(h, "Step3 Survival Filters", midT, deepS, midX, deepSX,
                                 (ctx != OS_ALL), (ctx == OS_BUY));
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:14px 0;\">\r\n");
      // C) DEEP_TARGET vs DEEP_STOP
      FileWriteString(h, "<h4>C) DEEP_TARGET vs DEEP_STOP</h4>\r\n");
      OS_WriteTwoGroupReport(h, "DEEP_TARGET vs DEEP_STOP", deepT, deepS);
      OS_WriteTwoGroupDistributionReport(h, "Distributions: DEEP_TARGET vs DEEP_STOP", deepT, deepS);
      WritePathRiskExtraTable(h, "DEEP_TARGET vs DEEP_STOP", deepTX, deepSX);
      DX_WriteSuggestedFiltersEx(h, "Deep Recovery vs Deep Death", deepT, deepS, deepTX, deepSX,
                                 (ctx != OS_ALL), (ctx == OS_BUY));
      FileWriteString(h, "<hr style=\"border:0;border-top:2px solid #444;margin:18px 0;\">\r\n");
   }
   FileWriteString(h, "</div>\r\n");
}
bool DX_IsFinalStop(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsStopToken(ft); // SL / SL$ / STOP
}
bool DX_IsFinalTarget(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return OS_IsTargetToken(ft); // TP1..TP5 or EMA
}
bool DX_IsFinalEMA(SEntrySnapshot &sn)
{
   string ft = OS_GetFinalToken(sn.close_event);
   return (ft == "EMA");
}
bool DX_IsStep1(SEntrySnapshot &sn)  { return (sn.actual_max_step == 1); }
bool DX_IsStep45(SEntrySnapshot &sn) { return (sn.actual_max_step >= 4); }
// TP1/TP2 touched but NO EMA and went deep (>=3)
bool DX_IsDeepTPtouch_NoEMA(SEntrySnapshot &sn)
{
   if(sn.actual_max_step < 3) return false;
   if(sn.hit_ema200) return false;
   return (sn.hit_tp1 || sn.hit_tp2);
}
// --- mini bar (HTML) ---
string DX_BarPairHTML(string label, double a, double b, string a_name, string b_name,
                      string unit, string colorA, string colorB)
{
   double maxv = MathMax(MathAbs(a), MathAbs(b));
   double wa = (maxv > 0.0000001) ? (MathAbs(a) * 100.0 / maxv) : 0;
   double wb = (maxv > 0.0000001) ? (MathAbs(b) * 100.0 / maxv) : 0;
   string html = "<div style=\"margin:8px 0;\">";
   html += "<div style=\"color:#aaa;font-size:11px;margin-bottom:4px;\">" + label + "</div>";
   html += "<div style=\"display:flex;gap:12px;align-items:center;flex-wrap:wrap;\">";
   html += "<div style=\"min-width:320px;\">";
   html += "<div style=\"font-size:10px;color:#ccc;margin-bottom:2px;\">" + a_name + ": <b>" + DoubleToString(a, 2) + unit + "</b></div>";
   html += "<div style=\"background:#2a2a4a;border:1px solid #333;border-radius:6px;overflow:hidden;height:12px;\">";
   html += "<div style=\"width:" + DoubleToString(wa, 1) + "%;height:12px;background:" + colorA + ";\"></div>";
   html += "</div></div>";
   html += "<div style=\"min-width:320px;\">";
   html += "<div style=\"font-size:10px;color:#ccc;margin-bottom:2px;\">" + b_name + ": <b>" + DoubleToString(b, 2) + unit + "</b></div>";
   html += "<div style=\"background:#2a2a4a;border:1px solid #333;border-radius:6px;overflow:hidden;height:12px;\">";
   html += "<div style=\"width:" + DoubleToString(wb, 1) + "%;height:12px;background:" + colorB + ";\"></div>";
   html += "</div></div>";
   html += "</div></div>";
   return html;
}
// پیشنهاد فیلترها از روی اختلاف A/B
void DX_WriteSuggestedFilters(int h, string title,
                              SOSReportGroup &Good, SOSReportGroup &Bad,
                              bool directional, bool is_buy_ctx)
{
   if(Good.n < 10 || Bad.n < 10)
      return;
   double thr_stab = (Good.st.avg_stability + Bad.st.avg_stability) / 2.0;
   int tfH1 = TF_IDX_H1;
   int tfH4 = TF_IDX_H4;
   double thr_adx_h1 = (Good.st.avg_adx[tfH1] + Bad.st.avg_adx[tfH1]) / 2.0;
   double thr_adx_h4 = (Good.st.avg_adx[tfH4] + Bad.st.avg_adx[tfH4]) / 2.0;
   double thr_gap_h1 = (Good.st.avg_di_gap[tfH1] + Bad.st.avg_di_gap[tfH1]) / 2.0;
   double thr_gap_h4 = (Good.st.avg_di_gap[tfH4] + Bad.st.avg_di_gap[tfH4]) / 2.0;
   double thr_piv2 = (Good.AvgPiv2() + Bad.AvgPiv2()) / 2.0;
   string expDI = is_buy_ctx ? "+" : "-";
   string html = "<div style=\"margin-top:10px;padding:12px;background:rgba(0,212,255,0.08);border:1px solid #00d4ff;border-radius:10px;\">";
   html += "<div style=\"color:#00d4ff;font-weight:bold;margin-bottom:6px;\">" + title + "</div>";
   html += "<div style=\"color:#aaa;font-size:11px;line-height:1.9;\">";
   html += "Candidate filters (midpoint from 5Y stats):<br>";
   html += "• IF Stability &lt; <b>" + DoubleToString(thr_stab, 0) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX(H1) &lt; <b>" + DoubleToString(thr_adx_h1, 0) + "</b> ⇒ SKIP<br>";
   html += "• IF ADX(H4) &lt; <b>" + DoubleToString(thr_adx_h4, 0) + "</b> ⇒ SKIP<br>";
   html += "• IF DI_Gap(H1) &lt; <b>" + DoubleToString(thr_gap_h1, 1) + "</b> ⇒ SKIP<br>";
   html += "• IF DI_Gap(H4) &lt; <b>" + DoubleToString(thr_gap_h4, 1) + "</b> ⇒ SKIP<br>";
   html += "• IF Pivot2Dist &gt; <b>" + DoubleToString(thr_piv2, 0) + "</b> ⇒ SKIP<br>";
   if(directional)
   {
      html += "• IF DI(H1) != <b>" + expDI + "</b> ⇒ SKIP<br>";
      html += "• IF DI(H4) != <b>" + expDI + "</b> ⇒ SKIP<br>";
   }
   html += "</div></div>\r\n";
   FileWriteString(h, html);
}
string OS_ColorDiff(double diff, double strong, double medium)
{
   double a = MathAbs(diff);
   if(a >= strong) return "#00ff88";
   if(a >= medium) return "#ffff00";
   return "#888";
}
void OS_WriteTwoGroupReport(int h, string title, SOSReportGroup &A, SOSReportGroup &B)
{
   string html = "<h4 style=\"color:#00d4ff;margin-top:15px;\">" + title + "</h4>\r\n";
   html += "<div style=\"color:#aaa;font-size:11px;margin:6px 0;line-height:1.8;\">";
   html += g_lang.group_a + ": <b>" + A.name + "</b> | "
        + g_lang.group_count + ": <b>" + IntegerToString(A.n) + "</b>"
        + " | " + g_lang.group_target_pct + ": <b>" + DoubleToString(A.TargetPct(),1) + "%</b>"
        + " | " + g_lang.group_stop_pct + ": <b>" + DoubleToString(A.StopPct(),1) + "%</b>"
        + " | " + g_lang.group_pivot1_avg + ": <b>" + DoubleToString(A.AvgPiv1(),1) + "</b>"
        + " | " + g_lang.group_pivot2_avg + ": <b>" + DoubleToString(A.AvgPiv2(),1) + "</b>";
   html += "<br>";
   html += g_lang.group_b + ": <b>" + B.name + "</b> | "
        + g_lang.group_count + ": <b>" + IntegerToString(B.n) + "</b>"
        + " | " + g_lang.group_target_pct + ": <b>" + DoubleToString(B.TargetPct(),1) + "%</b>"
        + " | " + g_lang.group_stop_pct + ": <b>" + DoubleToString(B.StopPct(),1) + "%</b>"
        + " | " + g_lang.group_pivot1_avg + ": <b>" + DoubleToString(B.AvgPiv1(),1) + "</b>"
        + " | " + g_lang.group_pivot2_avg + ": <b>" + DoubleToString(B.AvgPiv2(),1) + "</b>";
   html += "</div>\r\n";
   if(A.n < 10 || B.n < 10)
   {
      html += "<div style=\"color:#666;\">" + g_lang.insufficient_samples_groups + "</div>\r\n";
      FileWriteString(h, html);
      return;
   }
   html += "<div style=\"overflow:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>" + g_lang.col_timeframe + "</th>";
   // FIX: Show Pivot avg for BOTH A and B (was showing A twice)
   html += "<th>" + g_lang.col_pivot1_avg + " A</th>";
   html += "<th>" + g_lang.col_pivot1_avg + " B</th>";
   html += "<th>" + g_lang.col_pivot2_avg + " A</th>";
   html += "<th>" + g_lang.col_pivot2_avg + " B</th>";
   html += "<th>" + g_lang.rsi + " (A)</th><th>" + g_lang.rsi + " (B)</th><th>" + g_lang.col_diff + " RSI</th>";
   html += "<th>" + g_lang.adx + " (A)</th><th>" + g_lang.adx + " (B)</th><th>" + g_lang.col_diff + " ADX</th>";
   html += "<th>" + g_lang.cci + " (A)</th><th>" + g_lang.cci + " (B)</th><th>" + g_lang.col_diff + " CCI</th>";
   html += "<th>" + g_lang.atr + " (A)</th><th>" + g_lang.atr + " (B)</th><th>" + g_lang.col_diff + " ATR</th>";
   html += "<th>" + g_lang.col_di_aligned_pct + " (A)</th><th>" + g_lang.col_di_aligned_pct + " (B)</th><th>" + g_lang.col_diff + "</th>";
   html += "<th>" + g_lang.col_di_plus_pct + " (A)</th><th>" + g_lang.col_di_plus_pct + " (B)</th>";
   html += "<th>" + g_lang.col_ema_dominant + " (A)</th><th>" + g_lang.col_ema_dominant + " (B)</th>";
   html += "<th>" + g_lang.col_pos_dominant + " (A)</th><th>" + g_lang.col_pos_dominant + " (B)</th>";
   html += "</tr>\r\n";
   for(int tf = 0; tf < TF_COUNT; tf++)
   {
      double d_rsi = A.st.avg_rsi[tf] - B.st.avg_rsi[tf];
      double d_adx = A.st.avg_adx[tf] - B.st.avg_adx[tf];
      double d_cci = A.st.avg_cci[tf] - B.st.avg_cci[tf];
      double d_atr = A.st.avg_atr[tf] - B.st.avg_atr[tf];
      double d_dim = A.DIMatchPct(tf)  - B.DIMatchPct(tf);
      string c_rsi = OS_ColorDiff(d_rsi, 6, 3);
      string c_adx = OS_ColorDiff(d_adx, 6, 3);
      string c_cci = OS_ColorDiff(d_cci, 80, 40);
      double baseAtr = MathMax(A.st.avg_atr[tf], 0.0000001);
      string c_atr = OS_ColorDiff(d_atr, baseAtr * 0.25, baseAtr * 0.12);
      string c_dim = OS_ColorDiff(d_dim, 20, 10);
      string emaA = A.dom_ema[tf] + " (" + DoubleToString(A.dom_ema_pct[tf],1) + "%)";
      string emaB = B.dom_ema[tf] + " (" + DoubleToString(B.dom_ema_pct[tf],1) + "%)";
      string posA = A.dom_pos[tf] + " (" + DoubleToString(A.dom_pos_pct[tf],1) + "%)";
      string posB = B.dom_pos[tf] + " (" + DoubleToString(B.dom_pos_pct[tf],1) + "%)";
      html += "<tr>";
      html += "<td style=\"color:#00d4ff;font-weight:bold;\">" + g_tf[tf].name + "</td>";
      // FIX: TF row shows pivot avg from A and B separately
      // Pivot1 and Pivot2 are global (not per-TF) — show only on first TF row
      if(tf == 0)
      {
         html += "<td>" + DoubleToString(A.AvgPiv1(),1) + "</td>";
         html += "<td>" + DoubleToString(B.AvgPiv1(),1) + "</td>";
         html += "<td>" + DoubleToString(A.AvgPiv2(),1) + "</td>";
         html += "<td>" + DoubleToString(B.AvgPiv2(),1) + "</td>";
      }
      else
      {
         html += "<td>-</td><td>-</td><td>-</td><td>-</td>";
      }
      html += "<td>" + DoubleToString(A.st.avg_rsi[tf],1) + "</td>";
      html += "<td>" + DoubleToString(B.st.avg_rsi[tf],1) + "</td>";
      html += "<td style=\"color:"+c_rsi+";font-weight:bold;\">" + DoubleToString(d_rsi,1) + "</td>";
      html += "<td>" + DoubleToString(A.st.avg_adx[tf],1) + "</td>";
      html += "<td>" + DoubleToString(B.st.avg_adx[tf],1) + "</td>";
      html += "<td style=\"color:"+c_adx+";font-weight:bold;\">" + DoubleToString(d_adx,1) + "</td>";
      html += "<td>" + DoubleToString(A.st.avg_cci[tf],0) + "</td>";
      html += "<td>" + DoubleToString(B.st.avg_cci[tf],0) + "</td>";
      html += "<td style=\"color:"+c_cci+";font-weight:bold;\">" + DoubleToString(d_cci,0) + "</td>";
      html += "<td>" + DoubleToString(A.st.avg_atr[tf],_Digits) + "</td>";
      html += "<td>" + DoubleToString(B.st.avg_atr[tf],_Digits) + "</td>";
      html += "<td style=\"color:"+c_atr+";font-weight:bold;\">" + DoubleToString(d_atr,_Digits) + "</td>";
      html += "<td>" + DoubleToString(A.DIMatchPct(tf),1) + "%</td>";
      html += "<td>" + DoubleToString(B.DIMatchPct(tf),1) + "%</td>";
      html += "<td style=\"color:"+c_dim+";font-weight:bold;\">" + DoubleToString(d_dim,1) + "%</td>";
      html += "<td>" + DoubleToString(A.DIPlusPctRaw(tf),1) + "%</td>";
      html += "<td>" + DoubleToString(B.DIPlusPctRaw(tf),1) + "%</td>";
      html += "<td style=\"font-size:9px;\">" + emaA + "</td>";
      html += "<td style=\"font-size:9px;\">" + emaB + "</td>";
      html += "<td style=\"font-size:9px;\">" + posA + "</td>";
      html += "<td style=\"font-size:9px;\">" + posB + "</td>";
      html += "</tr>\r\n";
   }
   html += "</table></div>\r\n";
   double thr_stab = (A.st.avg_stability + B.st.avg_stability) / 2.0;
   html += "<div style=\"margin-top:8px;color:#aaa;font-size:11px;line-height:1.8;\">";
   html += "<b>" + g_lang.quick_suggestion_title + ":</b><br>";
   html += "• " + g_lang.stability + " &ge; " + DoubleToString(thr_stab,0) + "<br>";
   html += "• روی H1/H4 به ستون‌های اختلاف " + g_lang.adx + " و " + g_lang.col_di_aligned_pct + " توجه کن.<br>";
   html += "</div>\r\n";
   FileWriteString(h, html);
}
void OS_WriteTwoGroupDistributionReport(int h, string title, SOSReportGroup &A, SOSReportGroup &B)
{
   string html = "<h4 style=\"color:#00d4ff;margin-top:10px;\">" + g_lang.top_ranges_title + " — " + title + "</h4>\r\n";
   if(A.n < 10 || B.n < 10)
   {
      html += "<div style=\"color:#666;\">" + g_lang.insufficient_samples_groups + "</div>\r\n";
      FileWriteString(h, html);
      return;
   }
   html += "<div style=\"color:#aaa;font-size:11px;margin:6px 0;line-height:1.8;\">";
   html += g_lang.piv_top_label + " | " + g_lang.group_a + ": <b>" + A.TopBinsToString_Pivot(true, 2) + "</b>"
        +  " — " + g_lang.group_b + ": <b>" + B.TopBinsToString_Pivot(true, 2) + "</b><br>";
   html += g_lang.piv_top_label + " (Pivot2) | " + g_lang.group_a + ": <b>" + A.TopBinsToString_Pivot(false, 2) + "</b>"
        +  " — " + g_lang.group_b + ": <b>" + B.TopBinsToString_Pivot(false, 2) + "</b>";
   html += "</div>\r\n";
   html += "<div style=\"overflow:auto;\"><table style=\"width:100%;border-collapse:collapse;font-size:10px;\">\r\n";
   html += "<tr style=\"background:#2a2a4a;color:#00d4ff;\">";
   html += "<th>" + g_lang.col_timeframe + "</th>";
   html += "<th>" + g_lang.col_rsi_top + " (A)</th><th>" + g_lang.col_rsi_top + " (B)</th>";
   html += "<th>" + g_lang.col_adx_top + " (A)</th><th>" + g_lang.col_adx_top + " (B)</th>";
   html += "<th>" + g_lang.col_cci_top + " (A)</th><th>" + g_lang.col_cci_top + " (B)</th>";
   html += "<th>" + g_lang.col_atr_top + " (A)</th><th>" + g_lang.col_atr_top + " (B)</th>";
   html += "<th>" + g_lang.col_di_aligned_pct + " (A)</th><th>" + g_lang.col_di_aligned_pct + " (B)</th>";
   html += "<th>" + g_lang.col_di_plus_pct + " (A)</th><th>" + g_lang.col_di_plus_pct + " (B)</th>";
   html += "<th>" + g_lang.col_ema_top2 + " (A)</th><th>" + g_lang.col_ema_top2 + " (B)</th>";
   html += "<th>" + g_lang.col_pos_top2 + " (A)</th><th>" + g_lang.col_pos_top2 + " (B)</th>";
   html += "</tr>\r\n";
   for(int tf=0; tf<TF_COUNT; tf++)
   {
      string rsiA = A.TopBinsToString_RSI(tf, 2);
      string rsiB = B.TopBinsToString_RSI(tf, 2);
      string adxA = A.TopBinsToString_ADX(tf, 2);
      string adxB = B.TopBinsToString_ADX(tf, 2);
      string cciA = A.TopBinsToString_CCI(tf, 2);
      string cciB = B.TopBinsToString_CCI(tf, 2);
      string atrA = A.TopBinsToString_ATR(tf, 2);
      string atrB = B.TopBinsToString_ATR(tf, 2);
      string emaA = A.TopEMAOrdersToString(tf, 2);
      string emaB = B.TopEMAOrdersToString(tf, 2);
      string posA = A.TopPositionsToString(tf, 2);
      string posB = B.TopPositionsToString(tf, 2);
      html += "<tr>";
      html += "<td style=\"color:#00d4ff;font-weight:bold;\">" + g_tf[tf].name + "</td>";
      html += "<td>" + rsiA + "</td><td>" + rsiB + "</td>";
      html += "<td>" + adxA + "</td><td>" + adxB + "</td>";
      html += "<td>" + cciA + "</td><td>" + cciB + "</td>";
      html += "<td>" + atrA + "</td><td>" + atrB + "</td>";
      html += "<td>" + DoubleToString(A.DIMatchPct(tf),1) + "%</td>";
      html += "<td>" + DoubleToString(B.DIMatchPct(tf),1) + "%</td>";
      html += "<td>" + DoubleToString(A.DIPlusPctRaw(tf),1) + "%</td>";
      html += "<td>" + DoubleToString(B.DIPlusPctRaw(tf),1) + "%</td>";
      html += "<td style=\"font-size:9px;\">" + emaA + "</td>";
      html += "<td style=\"font-size:9px;\">" + emaB + "</td>";
      html += "<td style=\"font-size:9px;\">" + posA + "</td>";
      html += "<td style=\"font-size:9px;\">" + posB + "</td>";
      html += "</tr>\r\n";
   }
   html += "</table></div>\r\n";
   FileWriteString(h, html);
}
void WriteDashboardOutcomesTabV1(int h)
{
   FileWriteString(h, "<div id=\"outcomes\" class=\"tab-content\">\r\n");
   if(g_snapshot_count < 20)
   {
      FileWriteString(h,
         "<div class=\"section\"><div class=\"no-data\">Need >= 20 snapshots for reliable comparison. Have: " +
         IntegerToString(g_snapshot_count) + "</div></div>\r\n</div>\r\n");
      return;
   }
   FileWriteString(h,
      "<div class=\"section\"><div class=\"section-title\" style=\"color:#00d4ff;border-color:#00d4ff;\">Outcome / Diagnostics</div>\r\n"
      "<div style=\"color:#aaa;font-size:11px;line-height:1.8;margin-bottom:10px;\">"
      "Target = TP1..TP5 OR EMA (FINAL token). Stop = SL / SL$ / STOP (FINAL token).<br>"
      "This tab compares (A) TARGET vs STOP, (B) Step4/5 vs Step1+Target, (C) EMA-final vs Deep TP-touch-no-EMA."
      "</div>\r\n"
   );
   for(int cx=0; cx<3; cx++)
   {
      ENUM_OS_CONTEXT ctx = (ENUM_OS_CONTEXT)cx;
      string ctxName = OS_ContextName(ctx);
      SOSReportGroup gStep1Target, gStep45, gStops, gTargets, gEMA_Final, gDeepTP_NoEMA;
      gStep1Target.Reset("STEP1 + Final=TARGET");
      gStep45.Reset("DEEP Step4/5 (>=4)");
      gStops.Reset("STOP (Final)");
      gTargets.Reset("TARGET (Final)");
      gEMA_Final.Reset("Final Exit = EMA");
      gDeepTP_NoEMA.Reset("Deep>=3 + TP1/TP2 touch + NO EMA");
      for(int i=0; i<g_snapshot_count; i++)
      {
         SEntrySnapshot sn = g_snapshots[i];
         if(!OS_ContextMatch(sn, ctx)) continue;
         // Step1 + final target
         if(DX_IsStep1(sn) && DX_IsFinalTarget(sn))
            gStep1Target.Add(sn);
         // Deep step4/5
         if(DX_IsStep45(sn))
            gStep45.Add(sn);
         // Stop vs Target
         if(DX_IsFinalStop(sn))   gStops.Add(sn);
         if(DX_IsFinalTarget(sn)) gTargets.Add(sn);
         // EMA final
         if(DX_IsFinalEMA(sn)) gEMA_Final.Add(sn);
         // Deep TP touch but no EMA
         if(DX_IsDeepTPtouch_NoEMA(sn)) gDeepTP_NoEMA.Add(sn);
      }
      gStep1Target.Finalize();
      gStep45.Finalize();
      gStops.Finalize();
      gTargets.Finalize();
      gEMA_Final.Finalize();
      gDeepTP_NoEMA.Finalize();
      FileWriteString(h, "<h3 style=\"color:#00d4ff;margin-top:18px;\">" + ctxName + "</h3>\r\n");
      // A) TARGET vs STOP
      FileWriteString(h, "<h4 style=\"color:#00d4ff;margin-top:10px;\">A) TARGET vs STOP (Final outcome)</h4>\r\n");
      OS_WriteTwoGroupReport(h,
         (inp_use_persian_language ? "مقایسه: TARGET(EMA/TP) در برابر STOP" : "Compare: TARGET(EMA/TP) vs STOP"),
         gTargets, gStops);
      OS_WriteTwoGroupDistributionReport(h,
         (inp_use_persian_language ? "توزیع/الگو: TARGET vs STOP" : "Distributions: TARGET vs STOP"),
         gTargets, gStops);
      if(gTargets.n >= 10 && gStops.n >= 10)
      {
         FileWriteString(h, DX_BarPairHTML("Avg Stability",
            gTargets.st.avg_stability, gStops.st.avg_stability, "TARGET", "STOP", "", "#00ff88", "#ff4444"));
         FileWriteString(h, DX_BarPairHTML("HTF Conflict %",
            gTargets.st.GetHTFConflictPct(), gStops.st.GetHTFConflictPct(), "TARGET", "STOP", "%", "#00ff88", "#ff4444"));
         FileWriteString(h, DX_BarPairHTML("ADX(H1)",
            gTargets.st.avg_adx[TF_IDX_H1], gStops.st.avg_adx[TF_IDX_H1], "TARGET", "STOP", "", "#00ff88", "#ff4444"));
         FileWriteString(h, DX_BarPairHTML("ADX(H4)",
            gTargets.st.avg_adx[TF_IDX_H4], gStops.st.avg_adx[TF_IDX_H4], "TARGET", "STOP", "", "#00ff88", "#ff4444"));
      }
      if(ctx == OS_BUY)
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce STOP (BUY)", gTargets, gStops, true, true);
      else if(ctx == OS_SELL)
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce STOP (SELL)", gTargets, gStops, true, false);
      else
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce STOP (ALL)", gTargets, gStops, false, true);
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:14px 0;\">\r\n");
      // B) Step4/5 vs Step1Target
      FileWriteString(h, "<h4 style=\"color:#00d4ff;margin-top:10px;\">B) Why Step4/5 happens? (Deep vs Shallow)</h4>\r\n");
      OS_WriteTwoGroupReport(h,
         (inp_use_persian_language ? "مقایسه: Step1+Target در برابر Step4/5" : "Compare: Step1+Target vs Step4/5"),
         gStep1Target, gStep45);
      OS_WriteTwoGroupDistributionReport(h,
         (inp_use_persian_language ? "توزیع/الگو: Step1Target vs Step4/5" : "Distributions: Step1Target vs Step4/5"),
         gStep1Target, gStep45);
      if(ctx == OS_BUY)
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce Step4/5 (BUY)", gStep1Target, gStep45, true, true);
      else if(ctx == OS_SELL)
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce Step4/5 (SELL)", gStep1Target, gStep45, true, false);
      else
         DX_WriteSuggestedFilters(h, "Suggested Entry Filters to reduce Step4/5 (ALL)", gStep1Target, gStep45, false, true);
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #333;margin:14px 0;\">\r\n");
      // C) EMA final vs Deep TP-touch-no-EMA
      FileWriteString(h, "<h4 style=\"color:#00d4ff;margin-top:10px;\">C) EMA-final vs Deep TP-touch-no-EMA</h4>\r\n");
      OS_WriteTwoGroupReport(h,
         (inp_use_persian_language ? "مقایسه: EMA-final در برابر Deep TP-touch-no-EMA" : "Compare: EMA-final vs Deep TP-touch-no-EMA"),
         gEMA_Final, gDeepTP_NoEMA);
      OS_WriteTwoGroupDistributionReport(h,
         (inp_use_persian_language ? "توزیع/الگو: EMA-final vs TP-touch-no-EMA" : "Distributions: EMA-final vs TP-touch-no-EMA"),
         gEMA_Final, gDeepTP_NoEMA);
      if(ctx == OS_BUY)
         DX_WriteSuggestedFilters(h, "If looks like TP-touch-no-EMA then avoid EMA target (BUY)", gEMA_Final, gDeepTP_NoEMA, true, true);
      else if(ctx == OS_SELL)
         DX_WriteSuggestedFilters(h, "If looks like TP-touch-no-EMA then avoid EMA target (SELL)", gEMA_Final, gDeepTP_NoEMA, true, false);
      else
         DX_WriteSuggestedFilters(h, "TP-touch-no-EMA patterns (ALL)", gEMA_Final, gDeepTP_NoEMA, false, true);
      FileWriteString(h, "<hr style=\"border:0;border-top:1px solid #444;margin:18px 0;\">\r\n");
   }
   FileWriteString(h, "</div>\r\n</div>\r\n");
}
//|WriteDashboardBodyV3 - LOCALIZED v8.0 + OUTCOMES TAB|
bool WriteDashboardBodyV3(int h)
{
   //Info box
   string info = "<div style=\"background:rgba(0,212,255,0.1);border:1px solid #00d4ff;border-radius:8px;padding:15px;margin-bottom:20px;\">\r\n";
   info += "<div style=\"color:#00d4ff;font-weight:bold;margin-bottom:8px;\">" + g_lang.understanding_steps + "</div>\r\n";
   info += "<div style=\"font-size:11px;color:#aaa;line-height:1.6;\">\r\n";
   info += g_lang.step_explanation;
   info += "</div>\r\n</div>\r\n";
   if(FileWriteString(h, info) <= 0) return false;
   //TF Selector
   string tf_sel = "<div class=\"tf-selector\">\r\n";
   tf_sel += "<span style=\"color:#888;margin-right:10px;\">" + g_lang.timeframe + ":</span>\r\n";
   for(int tf = 0; tf < TF_COUNT; tf++)
      tf_sel += "<button class=\"tf-btn" + (tf == 0 ? " active" : "") + "\" onclick=\"showTF(" + IntegerToString(tf) + ", event)\">" + g_tf[tf].name + "</button>\r\n";
   tf_sel += "</div>\r\n";
   if(FileWriteString(h, tf_sel) <= 0) return false;
   //Tabs (+ OUTCOMES)
   string tabs = "<div class=\"tabs\">\r\n";
   for(int s = 1; s <= 5; s++)
      tabs += "<button class=\"tab" + (s == 1 ? " active" : "") + "\" onclick=\"showTab('step" + IntegerToString(s) + "', event)\">" + g_lang.step + " " + IntegerToString(s) + "</button>\r\n";
   tabs += "<button class=\"tab\" onclick=\"showTab('summary', event)\">" + g_lang.summary + "</button>\r\n";
   tabs += "<button class=\"tab\" onclick=\"showTab('outcomes', event)\">" + (inp_use_persian_language ? "📌 نتایج" : "Outcome") + "</button>\r\n";
   tabs += "</div>\r\n";
   if(FileWriteString(h, tabs) <= 0) return false;
   //Step Contents
   for(int step = 0; step < 5; step++)
   {
      string content = "<div id=\"step" + IntegerToString(step + 1) + "\" class=\"tab-content" + (step == 0 ? " active" : "") + "\">\r\n";
      if(FileWriteString(h, content) <= 0) return false;
      for(int tf = 0; tf < TF_COUNT; tf++)
      {
         string tf_div = "<div class=\"tf-section tf-" + IntegerToString(tf) + "\" style=\"" + (tf == 0 ? "" : "display:none;") + "\">\r\n";
         if(FileWriteString(h, tf_div) <= 0) return false;
         WriteDashboardSectionV3(h, step, true, tf);
         WriteDashboardSectionV3(h, step, false, tf);
         WriteDashboardFiltersV3(h, step, tf);
         if(FileWriteString(h, "</div>\r\n") <= 0) return false;
      }
      if(FileWriteString(h, "</div>\r\n") <= 0) return false;
   }
   //Summary tab
   if(!WriteDashboardSummaryV3(h))
      return false;
   //Outcome tab (NEW)
   WriteDashboardOutcomesTabV1(h);
   return true;
}
int CalculateMaxRows(int step, bool is_buy, int tf)
{
   int max_rows = 0;
   #define UPDATE_MAX(candidate)  if((candidate) > max_rows) max_rows = (candidate)
   if(is_buy)
   {
      if(g_rsi_buy[tf][step].total_trades > 0)
         UPDATE_MAX(g_rsi_buy[tf][step].range_count);
      if(g_adx_buy[tf][step].total_trades > 0)
      {
         UPDATE_MAX(g_adx_buy[tf][step].adx_count);
         UPDATE_MAX(g_adx_buy[tf][step].di_count);
      }
      if(g_cci_buy[tf][step].total_trades > 0)
         UPDATE_MAX(g_cci_buy[tf][step].range_count);
      if(g_atr_buy[tf][step].total_trades > 0)
         UPDATE_MAX(g_atr_buy[tf][step].range_count);
      if(g_ema_buy[tf][step].total_trades > 0)
      {
         UPDATE_MAX(g_ema_buy[tf][step].pattern_count);
         UPDATE_MAX(g_ema_buy[tf][step].position_count);
         UPDATE_MAX(g_ema_buy[tf][step].event_count);
      }
      if(tf == 0 && g_pivdist_buy[step].total_trades > 0)
      {
         UPDATE_MAX(g_pivdist_buy[step].p1_count);
         UPDATE_MAX(g_pivdist_buy[step].p2_count);
      }
   }
   else
   {
      if(g_rsi_sell[tf][step].total_trades > 0)
         UPDATE_MAX(g_rsi_sell[tf][step].range_count);
      if(g_adx_sell[tf][step].total_trades > 0)
      {
         UPDATE_MAX(g_adx_sell[tf][step].adx_count);
         UPDATE_MAX(g_adx_sell[tf][step].di_count);
      }
      if(g_cci_sell[tf][step].total_trades > 0)
         UPDATE_MAX(g_cci_sell[tf][step].range_count);
      if(g_atr_sell[tf][step].total_trades > 0)
         UPDATE_MAX(g_atr_sell[tf][step].range_count);
      if(g_ema_sell[tf][step].total_trades > 0)
      {
         UPDATE_MAX(g_ema_sell[tf][step].pattern_count);
         UPDATE_MAX(g_ema_sell[tf][step].position_count);
         UPDATE_MAX(g_ema_sell[tf][step].event_count);
      }
      if(tf == 0 && g_pivdist_sell[step].total_trades > 0)
      {
         UPDATE_MAX(g_pivdist_sell[step].p1_count);
         UPDATE_MAX(g_pivdist_sell[step].p2_count);
      }
   }
   if(max_rows > MAX_DASH_ROWS)
      max_rows = MAX_DASH_ROWS;
   #undef UPDATE_MAX
   return max_rows;
}
void WriteDashboardRowV3(int h, int step, bool is_buy, int rank, int tf)
{
   string row = "<tr><td class=\"rank\">" + IntegerToString(rank + 1) + "</td>";
   int total = 0;
   string val = "";
   double pct = 0;
   //RSI
   if(is_buy)
   {
      total = g_rsi_buy[tf][step].total_trades;
      if(total > 0 && rank < g_rsi_buy[tf][step].range_count && g_rsi_buy[tf][step].range_count > 0)
      {
         int rs = g_rsi_buy[tf][step].ranges[rank].range_start;
         int cnt = g_rsi_buy[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
         row += BuildDashboardCell(val, pct, "rsi-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_rsi_sell[tf][step].total_trades;
      if(total > 0 && rank < g_rsi_sell[tf][step].range_count && g_rsi_sell[tf][step].range_count > 0)
      {
         int rs = g_rsi_sell[tf][step].ranges[rank].range_start;
         int cnt = g_rsi_sell[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
         row += BuildDashboardCell(val, pct, "rsi-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //ADX
   if(is_buy)
   {
      total = g_adx_buy[tf][step].total_trades;
      if(total > 0 && rank < g_adx_buy[tf][step].adx_count && g_adx_buy[tf][step].adx_count > 0)
      {
         int rs = g_adx_buy[tf][step].adx_ranges[rank].range_start;
         int cnt = g_adx_buy[tf][step].adx_ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
         row += BuildDashboardCell(val, pct, "adx-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_adx_sell[tf][step].total_trades;
      if(total > 0 && rank < g_adx_sell[tf][step].adx_count && g_adx_sell[tf][step].adx_count > 0)
      {
         int rs = g_adx_sell[tf][step].adx_ranges[rank].range_start;
         int cnt = g_adx_sell[tf][step].adx_ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
         row += BuildDashboardCell(val, pct, "adx-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //DI  (FIX: handle unknown properly)
   if(is_buy)
   {
      total = g_adx_buy[tf][step].total_trades;
      if(total > 0 && rank < g_adx_buy[tf][step].di_count && g_adx_buy[tf][step].di_count > 0)
      {
         string di = g_adx_buy[tf][step].di_status[rank].status;
         int cnt = g_adx_buy[tf][step].di_status[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string di_cls = "empty";
         string di_text = "❓";
         if(di == "+" || di == "-")
         {
            di_text = di;
            di_cls  = (di == "+") ? "di-plus" : "di-minus";
         }
         row += "<td class=\"" + di_cls + "\">" + di_text + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_adx_sell[tf][step].total_trades;
      if(total > 0 && rank < g_adx_sell[tf][step].di_count && g_adx_sell[tf][step].di_count > 0)
      {
         string di = g_adx_sell[tf][step].di_status[rank].status;
         int cnt = g_adx_sell[tf][step].di_status[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string di_cls = "empty";
         string di_text = "❓";
         if(di == "+" || di == "-")
         {
            di_text = di;
            di_cls  = (di == "+") ? "di-plus" : "di-minus";
         }
         row += "<td class=\"" + di_cls + "\">" + di_text + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //CCI
   if(is_buy)
   {
      total = g_cci_buy[tf][step].total_trades;
      if(total > 0 && rank < g_cci_buy[tf][step].range_count && g_cci_buy[tf][step].range_count > 0)
      {
         int rs = g_cci_buy[tf][step].ranges[rank].range_start;
         int cnt = g_cci_buy[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "," + IntegerToString(rs + 25) + "]";
         row += BuildDashboardCell(val, pct, "cci-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_cci_sell[tf][step].total_trades;
      if(total > 0 && rank < g_cci_sell[tf][step].range_count && g_cci_sell[tf][step].range_count > 0)
      {
         int rs = g_cci_sell[tf][step].ranges[rank].range_start;
         int cnt = g_cci_sell[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = "[" + IntegerToString(rs) + "," + IntegerToString(rs + 25) + "]";
         row += BuildDashboardCell(val, pct, "cci-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //ATR
   if(is_buy)
   {
      total = g_atr_buy[tf][step].total_trades;
      if(total > 0 && rank < g_atr_buy[tf][step].range_count && g_atr_buy[tf][step].range_count > 0)
      {
         double rs = g_atr_buy[tf][step].ranges[rank].range_start;
         int cnt = g_atr_buy[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = DoubleToString(rs, _Digits);
         row += BuildDashboardCell(val, pct, "atr-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_atr_sell[tf][step].total_trades;
      if(total > 0 && rank < g_atr_sell[tf][step].range_count && g_atr_sell[tf][step].range_count > 0)
      {
         double rs = g_atr_sell[tf][step].ranges[rank].range_start;
         int cnt = g_atr_sell[tf][step].ranges[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         val = DoubleToString(rs, _Digits);
         row += BuildDashboardCell(val, pct, "atr-cell", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //Pivot1 & Pivot2 (Only Main TF)
   if(tf == 0)
   {
      if(is_buy)
      {
         total = g_pivdist_buy[step].total_trades;
         if(total > 0 && rank < g_pivdist_buy[step].p1_count && g_pivdist_buy[step].p1_count > 0)
         {
            int rs = g_pivdist_buy[step].pivot1[rank].dist;
            int cnt = g_pivdist_buy[step].pivot1[rank].count;
            pct = (total > 0) ? (cnt * 100.0 / total) : 0;
            val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
            row += BuildDashboardCell(val, pct, "pivot-cell", true);
         }
         else row += BuildDashboardCell("", 0, "", false);
         if(total > 0 && rank < g_pivdist_buy[step].p2_count && g_pivdist_buy[step].p2_count > 0)
         {
            int rs = g_pivdist_buy[step].pivot2[rank].dist;
            int cnt = g_pivdist_buy[step].pivot2[rank].count;
            pct = (total > 0) ? (cnt * 100.0 / total) : 0;
            val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
            row += BuildDashboardCell(val, pct, "pivot-cell", true);
         }
         else row += BuildDashboardCell("", 0, "", false);
      }
      else
      {
         total = g_pivdist_sell[step].total_trades;
         if(total > 0 && rank < g_pivdist_sell[step].p1_count && g_pivdist_sell[step].p1_count > 0)
         {
            int rs = g_pivdist_sell[step].pivot1[rank].dist;
            int cnt = g_pivdist_sell[step].pivot1[rank].count;
            pct = (total > 0) ? (cnt * 100.0 / total) : 0;
            val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
            row += BuildDashboardCell(val, pct, "pivot-cell", true);
         }
         else row += BuildDashboardCell("", 0, "", false);
         if(total > 0 && rank < g_pivdist_sell[step].p2_count && g_pivdist_sell[step].p2_count > 0)
         {
            int rs = g_pivdist_sell[step].pivot2[rank].dist;
            int cnt = g_pivdist_sell[step].pivot2[rank].count;
            pct = (total > 0) ? (cnt * 100.0 / total) : 0;
            val = "[" + IntegerToString(rs) + "-" + IntegerToString(rs + 5) + "]";
            row += BuildDashboardCell(val, pct, "pivot-cell", true);
         }
         else row += BuildDashboardCell("", 0, "", false);
      }
   }
   //EMA Order (FIX: escape title attr)
   if(is_buy)
   {
      total = g_ema_buy[tf][step].total_trades;
      if(total > 0 && rank < g_ema_buy[tf][step].pattern_count && g_ema_buy[tf][step].pattern_count > 0)
      {
         string pat = g_ema_buy[tf][step].patterns[rank].pattern;
         int cnt = g_ema_buy[tf][step].patterns[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string safe_title = EscapeHTMLAttr(pat);
         row += "<td class=\"ema-cell\" title=\"" + safe_title + "\">" + pat + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_ema_sell[tf][step].total_trades;
      if(total > 0 && rank < g_ema_sell[tf][step].pattern_count && g_ema_sell[tf][step].pattern_count > 0)
      {
         string pat = g_ema_sell[tf][step].patterns[rank].pattern;
         int cnt = g_ema_sell[tf][step].patterns[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string safe_title = EscapeHTMLAttr(pat);
         row += "<td class=\"ema-cell\" title=\"" + safe_title + "\">" + pat + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //Position
   if(is_buy)
   {
      total = g_ema_buy[tf][step].total_trades;
      if(total > 0 && rank < g_ema_buy[tf][step].position_count && g_ema_buy[tf][step].position_count > 0)
      {
         string pos = g_ema_buy[tf][step].positions[rank].pattern;
         int cnt = g_ema_buy[tf][step].positions[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         row += BuildDashboardCell(pos, pct, "", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_ema_sell[tf][step].total_trades;
      if(total > 0 && rank < g_ema_sell[tf][step].position_count && g_ema_sell[tf][step].position_count > 0)
      {
         string pos = g_ema_sell[tf][step].positions[rank].pattern;
         int cnt = g_ema_sell[tf][step].positions[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         row += BuildDashboardCell(pos, pct, "", true);
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   //Event
   if(is_buy)
   {
      total = g_ema_buy[tf][step].total_trades;
      if(total > 0 && rank < g_ema_buy[tf][step].event_count && g_ema_buy[tf][step].event_count > 0)
      {
         string evt = g_ema_buy[tf][step].events[rank].event;
         int cnt = g_ema_buy[tf][step].events[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string evt_cls = GetEventClassStatic(evt);
         row += "<td class=\"" + evt_cls + "\">" + evt + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   else
   {
      total = g_ema_sell[tf][step].total_trades;
      if(total > 0 && rank < g_ema_sell[tf][step].event_count && g_ema_sell[tf][step].event_count > 0)
      {
         string evt = g_ema_sell[tf][step].events[rank].event;
         int cnt = g_ema_sell[tf][step].events[rank].count;
         pct = (total > 0) ? (cnt * 100.0 / total) : 0;
         string evt_cls = GetEventClassStatic(evt);
         row += "<td class=\"" + evt_cls + "\">" + evt + "</td>";
         row += "<td class=\"" + GetPctClassStatic(pct) + "\">" + DoubleToString(pct, 1) + "%</td>";
      }
      else row += BuildDashboardCell("", 0, "", false);
   }
   row += "</tr>\r\n";
   FileWriteString(h, row);
}
string BuildDashboardCell(string value, double pct, string cell_cls, bool has_data)
{
   if(!has_data || value == "")
      return "<td class=\"empty\">-</td><td class=\"empty\">-</td>";
   string pct_cls = GetPctClassStatic(pct);
   if(cell_cls == "")
      return "<td class=\"value\">" + value + "</td>" +
             "<td class=\"" + pct_cls + "\">" + DoubleToString(pct, 1) + "%</td>";
   return "<td class=\"" + cell_cls + " value\">" + value + "</td>" +
          "<td class=\"" + pct_cls + "\">" + DoubleToString(pct, 1) + "%</td>";
}
//|SMART FILTER FUNCTIONS - V2.0|
void SortFiltersByWeight(SFilterItem &filters[], int count)
{
   for(int i = 0; i < count - 1; i++)
   {
      for(int j = i + 1; j < count; j++)
      {
         if(filters[j].weight > filters[i].weight)
         {
            SFilterItem temp = filters[i];
            filters[i] = filters[j];
            filters[j] = temp;
         }
      }
   }
}
string BuildMergedRSIRange(int step, bool is_buy, int tf)
{
   int total = 0;
   int range_count = 0;
   if(is_buy)
   {
      total = g_rsi_buy[tf][step].total_trades;
      range_count = g_rsi_buy[tf][step].range_count;
   }
   else
   {
      total = g_rsi_sell[tf][step].total_trades;
      range_count = g_rsi_sell[tf][step].range_count;
   }
   if(total == 0|| range_count == 0) return "";
   int significant_ranges[20];
   int sig_count = 0;
   double coverage_threshold = TH_RSI_COVERAGE;
   for(int i = 0; i < range_count && i < 20; i++)
   {
      int cnt = 0;
      int rs = 0;
      if(is_buy)
      {
         cnt = g_rsi_buy[tf][step].ranges[i].count;
         rs = g_rsi_buy[tf][step].ranges[i].range_start;
      }
      else
      {
         cnt = g_rsi_sell[tf][step].ranges[i].count;
         rs = g_rsi_sell[tf][step].ranges[i].range_start;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= coverage_threshold)
      {
         significant_ranges[sig_count] = rs;
         sig_count++;
      }
   }
   if(sig_count == 0) return "";
   //Sort ascending
   for(int i = 0; i < sig_count - 1; i++)
   {
      for(int j = i + 1; j < sig_count; j++)
      {
         if(significant_ranges[j] < significant_ranges[i])
         {
            int temp = significant_ranges[i];
            significant_ranges[i] = significant_ranges[j];
            significant_ranges[j] = temp;
         }
      }
   }
   int min_rs = significant_ranges[0];
   int max_rs = significant_ranges[sig_count - 1];
   //Check if ranges are adjacent (max gap = TH_MERGE_GAP)
   bool is_adjacent = true;
   for(int i = 1; i < sig_count; i++)
   {
      if(significant_ranges[i] - significant_ranges[i-1] > TH_MERGE_GAP)
      {
         is_adjacent = false;
         break;
      }
   }
   //Only merge if adjacent AND span is reasonable
   if(is_adjacent && (max_rs - min_rs) <= TH_MERGE_MAX_SPAN)
   {
      return "[" + IntegerToString(min_rs) + "-" + IntegerToString(max_rs + 5) + "]";
   }
   else if(sig_count <= 3)
   {
      //Few ranges, show them separately
      string result = "";
      for(int i = 0; i < sig_count; i++)
      {
         if(result != "") result += "|";
         result += "[" + IntegerToString(significant_ranges[i]) + "-" + IntegerToString(significant_ranges[i] + 5) + "]";
      }
      return result;
   }
   else
   {
      //Too many non-adjacent ranges - show top 3 only
      string result = "";
      for(int i = 0; i < 3; i++)
      {
         if(result != "") result += "|";
         result += "[" + IntegerToString(significant_ranges[i]) + "-" + IntegerToString(significant_ranges[i] + 5) + "]";
      }
      return result;
   }
}
//|Calculate RSI Coverage and Win Rate|
void CalculateRSICoverage(int step, bool is_buy, int tf, double &coverage, double &win_rate, int &actual_sample)
{
   coverage = 0;
   win_rate = 0;
   actual_sample = 0;
   int total = 0;
   int range_count = 0;
   int sum_count = 0;
   int sum_wins = 0;
   double coverage_threshold = TH_RSI_COVERAGE;
   if(is_buy)
   {
      total = g_rsi_buy[tf][step].total_trades;
      range_count = g_rsi_buy[tf][step].range_count;
   }
   else
   {
      total = g_rsi_sell[tf][step].total_trades;
      range_count = g_rsi_sell[tf][step].range_count;
   }
   if(total == 0) return;
   for(int i = 0; i < range_count && i < 20; i++)
   {
      int cnt = 0;
      int wins = 0;
      if(is_buy)
      {
         cnt = g_rsi_buy[tf][step].ranges[i].count;
         wins = g_rsi_buy[tf][step].ranges[i].win_count;
      }
      else
      {
         cnt = g_rsi_sell[tf][step].ranges[i].count;
         wins = g_rsi_sell[tf][step].ranges[i].win_count;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= coverage_threshold)
      {
         sum_count += cnt;
         sum_wins += wins;
      }
   }
   coverage = (total > 0) ? (sum_count * 100.0 / total) : 0;
   win_rate = (sum_count > 0) ? (sum_wins * 100.0 / sum_count) : 0;
   actual_sample = sum_count;
}
string BuildMergedADXRange(int step, bool is_buy, int tf)
{
   int total = 0;
   int adx_count = 0;
   if(is_buy)
   {
      total = g_adx_buy[tf][step].total_trades;
      adx_count = g_adx_buy[tf][step].adx_count;
   }
   else
   {
      total = g_adx_sell[tf][step].total_trades;
      adx_count = g_adx_sell[tf][step].adx_count;
   }
   if(total == 0|| adx_count == 0) return "";
   int significant_ranges[20];
   int sig_count = 0;
   //FIX: ADX coverage threshold
   double coverage_threshold = TH_ADX_COVERAGE;
   for(int i = 0; i < adx_count && i < 20; i++)
   {
      int cnt = 0;
      int rs = 0;
      if(is_buy)
      {
         cnt = g_adx_buy[tf][step].adx_ranges[i].count;
         rs = g_adx_buy[tf][step].adx_ranges[i].range_start;
      }
      else
      {
         cnt = g_adx_sell[tf][step].adx_ranges[i].count;
         rs = g_adx_sell[tf][step].adx_ranges[i].range_start;
      }
      double pct = cnt * 100.0 / total;
      if(pct >= coverage_threshold && sig_count < 20)
      {
         significant_ranges[sig_count] = rs;
         sig_count++;
      }
   }
   if(sig_count == 0) return "";
   for(int i = 0; i < sig_count - 1; i++)
      for(int j = i + 1; j < sig_count; j++)
         if(significant_ranges[j] < significant_ranges[i])
         {
            int temp = significant_ranges[i];
            significant_ranges[i] = significant_ranges[j];
            significant_ranges[j] = temp;
         }
   int min_rs = significant_ranges[0];
   int max_rs = significant_ranges[sig_count - 1];
   bool is_adjacent = true;
   for(int i = 1; i < sig_count; i++)
   {
      if(significant_ranges[i] - significant_ranges[i-1] > TH_MERGE_GAP)
      {
         is_adjacent = false;
         break;
      }
   }
   if(is_adjacent && (max_rs - min_rs) <= TH_MERGE_MAX_SPAN)
      return ">=" + IntegerToString(min_rs);
   if(sig_count <= 2)
   {
      string result = "";
      for(int i = 0; i < sig_count; i++)
      {
         if(result != "") result += "|";
         result += "[" + IntegerToString(significant_ranges[i]) + "-" + IntegerToString(significant_ranges[i] + 5) + "]";
      }
      return result;
   }
   return "[" + IntegerToString(significant_ranges[0]) + "-" + IntegerToString(significant_ranges[0] + 5) + "]|" +
          "[" + IntegerToString(significant_ranges[1]) + "-" + IntegerToString(significant_ranges[1] + 5) + "]";
}
void CalculateADXCoverage(int step, bool is_buy, int tf, double &coverage, double &win_rate, int &actual_sample)
{
   coverage = 0;
   win_rate = 0;
   actual_sample = 0;
   int total = 0;
   int adx_count = 0;
   int sum_count = 0;
   int sum_wins = 0;
   //FIX: ADX threshold
   double coverage_threshold = TH_ADX_COVERAGE;
   if(is_buy)
   {
      total = g_adx_buy[tf][step].total_trades;
      adx_count = g_adx_buy[tf][step].adx_count;
   }
   else
   {
      total = g_adx_sell[tf][step].total_trades;
      adx_count = g_adx_sell[tf][step].adx_count;
   }
   if(total == 0) return;
   for(int i = 0; i < adx_count && i < 20; i++)
   {
      int cnt = 0;
      int wins = 0;
      if(is_buy)
      {
         cnt = g_adx_buy[tf][step].adx_ranges[i].count;
         wins = g_adx_buy[tf][step].adx_ranges[i].win_count;
      }
