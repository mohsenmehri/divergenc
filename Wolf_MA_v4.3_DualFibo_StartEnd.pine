fibo18Style = getLineStyle(input.string('─', '', group = 'Structure Fibonacci', options = ['─','┈','╌'], inline = 'Fibo18'))
fibo18Width = input.int(1, '', group = 'Structure Fibonacci', minval = 1, maxval = 5, inline = 'Fibo18')
fibo19Value = input.float(0.162, '', group = 'Structure Fibonacci', inline = 'Fibo19')
fibo19Color = input(#f6ff00,     '', group = 'Structure Fibonacci', inline = 'Fibo19')
fibo19Show  = input(true,        '', group = 'Structure Fibonacci', inline = 'Fibo19')
fibo19Style = getLineStyle(input.string('─', '', group = 'Structure Fibonacci', options = ['─','┈','╌'], inline = 'Fibo19'))
