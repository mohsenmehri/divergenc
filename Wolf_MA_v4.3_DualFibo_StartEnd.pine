//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  Wolf M-A  v4.3  |  Crypto & Gold        (Dual Fibonacci — Start & End Selectable)
// ───────────────────────────────────────────────────────────────────────────────
//  وضعیت نسخهٔ ۴.۱.۱ (نسبت به v4):
//   • ماکرو ستون‌های TF: هر ستون پرچم‌های ماکرو خودِ تایم‌فریم را دارد
//     (۲۸ درخواست مستقل + ۷ درخواست چارت + ۴ درخواست ساختار = ۳۹ ؛ زیر سقف ۴۰)
//   • dynamic_requests = false: خروجی درخواست‌ها به‌صورت مقدار منتقل می‌شود
//   • ری‌پینت: آفست [1] + lookahead_on در درخواست‌های TF؛ سیگنال فعلی با barstate.isconfirmed
//   • Transition: سقف اعتماد ~56.6 و آستانهٔ ستاپ ۵۵ (قبلاً سقف ۵۳ و کد مرده بود)
//   • Gold: DXY/US10Y/VIX در اسلات‌های slot1..3 ؛ قاعدهٔ ماکرو یک‌جا در f_macroAllowLong/Short
//   • OB: حذف واقعی لیبل و آرایه‌های اضافی؛ پول‌های بی‌استفاده پنهان می‌شوند
//   • سیگنال: آستانه‌ها ثابت‌های نام‌گذاری‌شده‌اند (NET_STRONG, NET_WEAK, SP_T1..4, CONF_*)
//   • جدول: f_bullBear برای همهٔ ردیف‌های Bull/Bear؛ فرمت اعشار Bias
//   • تشخیص BTC: فقط نمادهایی که با BTC/XBT شروع شوند (WBTC و BTC.D جدا)
//   • برچسب تایم‌فریم: مقادیر رایج دقیقه (2, 4, 6, 7, 8, 9, 20, 25, 90) اضافه شد
//  نسخهٔ ۴.۱.۲ (بهترین‌عمل‌ها): گیت Short طلا = دلار↑ + بازدهی↑ + بدون ترس؛ رژیم «TightUSD»
//   • گیت Short آلت در BTC.D↑ و TOTAL2 ضعیف؛ امتیاز BTCSeason برای آلت منفی
//   • شمارش هم‌راستایی بدون دوباره‌شماری ساختار
//   • هشدار AI شامل SL / TP1 (1R) / TP2 (2R) بر پایه‌ی ساختار ± ۰.۵ ATR
//  یادداشت: f_tfState و f_computeBias سری‌های OHLC کانتکست فعلی و ورودی‌های ثابت را می‌خوانند؛
//  هیچ متغیر mutable گلوبالی را نمی‌خوانند (شرط Pine برای درخواست‌های TF).

// ═══════════════════════════════════════════════════════════════════════════════
indicator('Wolf M-A v4.3 | Crypto & Gold — Dual Fibo (Start+End)', overlay = true, max_bars_back = 700,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     dynamic_requests = false)

// ═══════════════════════════════════════════════════════════════
//                    MARKET MODE SELECTOR
// ═══════════════════════════════════════════════════════════════
marketMode  = input.string('Gold/Forex', 'Market Mode', options = ['Crypto', 'Gold/Forex'], group = 'Market Selection')
isGoldMode  = marketMode == 'Gold/Forex'
displayMode = input.string('Mobile', 'Display Mode', options = ['Desktop', 'Mobile'], group = 'Market Selection')
isMobile    = displayMode == 'Mobile'

// ═══════════════════════════════════════════════════════════════
//                    INPUTS - TABLE
// ═══════════════════════════════════════════════════════════════
Stable1     = input.bool(true, 'Show Table Brief', group = 'Table Brief', inline = '0')
posInput1   = input.string('Bottom Right', 'Position', options = ['Bottom Left','Bottom Right','Top Left','Top Right'], group = 'Table Brief', inline = '1')
sizefont1   = input.string('size small',   'size text', options = ['size auto','size tiny','size small','size normal','size large','size huge'], group = 'Table Brief', inline = '1')

tblBg       = input.color(color.rgb(12,12,22),   'Table Background',        group = 'Table')
frameColor  = input.color(color.rgb(100,70,200), 'Table Frame',             group = 'Table')
borderColor = input.color(color.rgb(45,40,75),   'Table Border',            group = 'Table')
hdrBg       = input.color(color.rgb(30,20,60),   'Header Background',       group = 'Table')
hdrTxt      = input.color(color.rgb(255,215,0),  'Header Text',             group = 'Table')
nameBg      = input.color(color.rgb(25,15,50),   'Label Column Background', group = 'Table')
nameTxt     = input.color(color.rgb(180,160,255),'Label Column Text',       group = 'Table')
cellBg      = input.color(color.rgb(20,20,35),   'Cell Background',         group = 'Table')
sepColor    = input.color(color.rgb(80,80,100),  'Separator Color',         group = 'Table')
textColorl  = input.color(color.rgb(0,230,80),   'Long Color',              group = 'Table')
textColors  = input.color(color.rgb(255,65,65),  'Short Color',             group = 'Table')

// ═══════════════════════════════════════════════════════════════
//                    ORDER BLOCK INPUTS
// ═══════════════════════════════════════════════════════════════
ob_length     = input.int(5,   'Volume Pivot Length', minval = 1,                             group = 'Order Block')
bull_ext_last = input.int(3,   'Bullish OB',          minval = 1, inline = 'bull',            group = 'Order Block')
bg_bull_css   = input.color(color.new(#169400, 80),   '',         inline = 'bull',            group = 'Order Block')
bull_css      = input.color(#169400,                  '',         inline = 'bull',            group = 'Order Block')
bull_avg_css  = input.color(color.new(#9598a1, 37),   '',         inline = 'bull',            group = 'Order Block')
bear_ext_last = input.int(3,   'Bearish OB',          minval = 1, inline = 'bear',            group = 'Order Block')
bg_bear_css   = input.color(color.new(#ff1100, 80),   '',         inline = 'bear',            group = 'Order Block')
bear_css      = input.color(#ff1100,                  '',         inline = 'bear',            group = 'Order Block')
bear_avg_css  = input.color(color.new(#9598a1, 37),   '',         inline = 'bear',            group = 'Order Block')
ob_line_style = input.string('⎯⎯⎯', 'Average Line Style', options = ['⎯⎯⎯','----','····'], group = 'Order Block')
ob_line_width = input.int(1,   'Average Line Width',  minval = 1,                             group = 'Order Block')
ob_mitigation = input.string('Wick', 'Mitigation Method', options = ['Wick','Close'],         group = 'Order Block')

// ═══════════════════════════════════════════════════════════════
//                    PRICE INPUTS
// ═══════════════════════════════════════════════════════════════
price          = input(close,   'Price Source')
price1         = input(hlcc4,   'price fibo')
confirmOnClose = input.bool(true, '✅ تأیید روی بسته شدن کندل', group = 'Signal Settings', inline = 'confirm')

// ═══════════════════════════════════════════════════════════════
//                    CONSTANTS
// ═══════════════════════════════════════════════════════════════
MAX_HIST    = 500          // بیشینهٔ عمق تاریخ برای سطوح ساختار (کاهش حافظه)
MAX_FVG_CNT = 20

// ═══════════════════════════════════════════════════════════════
//   تابع کمکی سبک (باید قبل از ورودی‌های استایل تعریف شود)
// ═══════════════════════════════════════════════════════════════
getLineStyle(lineOption) =>
    lineOption == '┈' ? line.style_dotted : lineOption == '╌' ? line.style_dashed : line.style_solid

// ═══════════════════════════════════════════════════════════════
//                    TREND ENGINE INPUTS
// ═══════════════════════════════════════════════════════════════
emaFastLen     = input.int(20, 'EMA Fast',           group = 'Trend Engine', minval = 1)
emaSlowLen     = input.int(50, 'EMA Slow',           group = 'Trend Engine', minval = 1)
structLookback = input.int(10, 'Structure Lookback', group = 'Trend Engine', minval = 3)

// ═══════════════════════════════════════════════════════════════
//                    FVG INPUTS
// ═══════════════════════════════════════════════════════════════
isFvgToShow            = input(true,                       'Display FVG',          group = 'Fear Value Gap')
bullishFvgColor        = input(color.new(color.green, 50), 'Bullish FVG Color',    group = 'Fear Value Gap')
bearishFvgColor        = input(color.new(color.red,   50), 'Bearish FVG Color',    group = 'Fear Value Gap')
fvgHistoryNbr          = input.int(5,                      'Number of FVG',        minval = 1, maxval = 20, group = 'Fear Value Gap')
Len                    = input.int(25,                     'len FVG',              group = 'Fear Value Gap')
isMitigatedFvgToReduce = input(false,                      'Reduce mitigated FVG', group = 'Fear Value Gap')

// ═══════════════════════════════════════════════════════════════
//                    DISPLACEMENT / STRUCTURE INPUTS
// ═══════════════════════════════════════════════════════════════
useDisplacementFilter = input.bool(false, 'Use Displacement Filter', group = 'Structures', inline = 'disp')
displacementMult      = input.float(1.5,  'ATR Multiplier',          group = 'Structures', inline = 'disp', minval = 0.1, step = 0.1)
atrLen                = input.int(14,     'ATR Length',               group = 'Structures', inline = 'disp', minval = 1)
useBreakQuality       = input.bool(false, 'استفاده از Break Quality', group = 'Structures', inline = 'bq')
breakQualityThresh    = input.float(0.3,  'حداقل Break Strength',     group = 'Structures', inline = 'bq', minval = 0.0, step = 0.05)

isStructBodyCandleBreak = input(true, 'Break with candle body', group = 'Structures')
structChaseBars         = input.int(3, 'Structure Chase Bars',  group = 'Structures', minval = 1, maxval = 20,
     tooltip = 'سطح ساختار حداکثر تا این تعداد کندل پس از شروع ساق، «تعقیب» می‌شود (قبلاً هاردکد ۳ بود)')
isCurrentStructToShow   = input(true, 'Display current structure', group = 'Structures')
bullishBosColor         = input(color.silver, 'Bullish BOS Color',   group = 'Structures')
bearishBosColor         = input(color.silver, 'Bearish BOS Color',   group = 'Structures')
bosLineStyleOption      = input.string('─',   'BOS Style',           group = 'Structures', options = ['─','┈','╌'])
bosLineWidth            = input.int(1,        'BOS Width',           group = 'Structures', minval = 1, maxval = 5)
bullishChochColor       = input(color.yellow, 'Bullish CHoCH Color', group = 'Structures')
bearishChochColor       = input(color.yellow, 'Bearish CHoCH Color', group = 'Structures')
chochLineStyleOption    = input.string('─',   'CHoCH Style',         group = 'Structures', options = ['─','┈','╌'])
chochLineWidth          = input.int(1,        'CHoCH Width',         group = 'Structures', minval = 1, maxval = 5)
currentStructColor      = input(color.blue,   'Current Structure Color', group = 'Structures')
currentStructLineStyleOption = input.string('─', 'Current Structure Style', group = 'Structures', options = ['─','┈','╌'])
currentStructLineWidth  = input.int(1,        'Current Structure Width', group = 'Structures', minval = 1, maxval = 5)
structHistoryNbr        = input.int(5,        'Number of breaks to show', minval = 1, maxval = 20)

// تبدیل رشتهٔ استایل به مقدار line.style_* (پس از تعریف getLineStyle)
bosLineStyle           = getLineStyle(bosLineStyleOption)
chochLineStyle         = getLineStyle(chochLineStyleOption)
currentStructLineStyle = getLineStyle(currentStructLineStyleOption)

// ═══════════════════════════════════════════════════════════════
//                    LIQUIDITY INPUTS
// ═══════════════════════════════════════════════════════════════
showLiquidity   = input.bool(true,   'Show Liquidity Levels',      group = 'Liquidity')
eqHighTolerance = input.float(0.001, 'Equal High/Low Tolerance %', group = 'Liquidity', minval = 0.0, step = 0.001) / 100
eqLen           = input.int(10,      'Equal H/L Lookback',         group = 'Liquidity', minval = 2)
liqColor        = input.color(color.new(color.orange, 30), 'Liquidity Color', group = 'Liquidity')
liqMaxCount     = input.int(5,       'Max Liquidity Levels',       group = 'Liquidity', minval = 1, maxval = 15)

// ═══════════════════════════════════════════════════════════════
//                    FIBONACCI INPUTS
// ═══════════════════════════════════════════════════════════════
nn = input(3, 'fasele', group = 'Structure Fibonacci', inline = 'Fasele')

// ── ۴.۲ — انتخاب دو حالتهٔ لنگر فیبوناچی (درخواست کاربر: دو حالتش بزار و کاربر انتخاب کنه)
fibAnchorMode = input.string('Wick-to-Wick (کلاسیک)', 'حالت لنگر فیبوناچی', options = ['Wick-to-Wick (کلاسیک)', 'Pivot Locked (پیوت)'], group = 'Structure Fibonacci', tooltip = 'کلاسیک: ابتدا و انتهای فیبو همیشه روی نوک شدوی واقعی موج هستند و تا شکست مخالف با هر شدوی جدید به‌روز می‌شوند (دقیق‌ترین حالت پرایس‌اکشن) | پیوت: انتها پس از تشکیل پیوت تأییدشده یا پایان structChaseBars قفل می‌شود و نوسانات کوچک داخل پولبک را نادیده می‌گیرد')
fibPivotLen   = input.int(2, 'طول پیوت (فقط حالت پیوت)', minval = 1, maxval = 10, group = 'Structure Fibonacci', tooltip = 'تعداد کندل تأیید در هر طرف پیوت؛ مثلا ۲ یعنی سقف/کفی که ۲ کندل قبل و ۲ کندل بعد پایین‌تر/بالاتر باشد')
fibWickTrailClassic = input.bool(true, 'در حالت کلاسیک، دنبال‌کردن شدو بدون محدودیت میله', group = 'Structure Fibonacci', tooltip = 'روشن: حتی اگر ده‌ها کندل از شروع ساق گذشته باشد، هر شدوی بالاتر/پایین‌تر انتهای فیبو را جابجا می‌کند تا نوک واقعی موج | خاموش: مثل قبل فقط تا structChaseBars دنبال می‌کند')

// ── ۴.۳ — انتخاب دو حالتهٔ ابتدای فیبو (درخواست: هر دو)
fibStartMode = input.string('Len ثابت (فیکس فراکتال)', 'حالت ابتدای فیبو', options = ['Len ثابت (فیکس فراکتال)', 'بازهٔ پویا (100 کندله)'], group = 'Structure Fibonacci', tooltip = 'Len ثابت: شروع موج با جستجوی فراکتالِ ۳کندلیِ فیکس‌شده (سقف‌های دوقلو را هم می‌گیرد) در ۲۵ کندل آخر — مثل v4.1 ولی بدون باگ | بازهٔ پویا: شروع موج = پایین‌ترین low / بالاترین high بین لنگرِ مخالف تا کندل شکست، محدود به 100 کندل — برای لگ‌های بلند دقیق‌تر')

